---
/**
 * LocationSeoTemplate.astro
 * Premium layout template for high-intent Location Intelligence & SEO pages.
 * Handles rich amenity grids, property snapshots, sector comparison tables,
 * due diligence checklists, FAQ accordions, and JSON-LD structured data.
 */
import PageLayout from '@layouts/PageLayout.astro';
import PlaceImage from '@components/places/PlaceImage.astro';
import { SITE } from '@data/site';
import type { PlaceRecord } from '@data/places/index';

export interface StatPill {
  value: string;
  label: string;
}

export interface ComparisonRow {
  sector: string;
  amenities: string;
  popularSizes: string;
  priceRange: string;
  travelTime: string;
  recommendedFor: string;
}

export interface FaqItem {
  question: string;
  answer: string;
}

export interface RelatedLink {
  label: string;
  href: string;
  desc: string;
}

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  canonical: string;
  badge: string;
  headline: string;
  lead: string;
  statPills: StatPill[];
  editorialParagraphs: string[];
  placesTitle: string;
  placesSubtitle: string;
  places: PlaceRecord[];
  allPlacesCategoryUrl: string;
  allPlacesCategoryLabel: string;
  tableTitle: string;
  tableSubtitle: string;
  tableRows: ComparisonRow[];
  propertiesTitle: string;
  propertiesSubtitle: string;
  properties: any[];
  zameenSearchUrl: string;
  zameenSearchLabel: string;
  checklistTitle?: string;
  checklistBullets?: string[];
  faqs: FaqItem[];
  relatedLinks: RelatedLink[];
}

const {
  title,
  metaTitle,
  description,
  canonical,
  badge,
  headline,
  lead,
  statPills,
  editorialParagraphs,
  placesTitle,
  placesSubtitle,
  places,
  allPlacesCategoryUrl,
  allPlacesCategoryLabel,
  tableTitle,
  tableSubtitle,
  tableRows,
  propertiesTitle,
  propertiesSubtitle,
  properties,
  zameenSearchUrl,
  zameenSearchLabel,
  checklistTitle,
  checklistBullets,
  faqs,
  relatedLinks,
} = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description: description,
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Location Guides', item: `${SITE.url}/sectors/` },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#featured-places`,
      name: placesTitle,
      numberOfItems: places.length,
      itemListElement: places.map((place, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'LocalBusiness',
          '@id': `${SITE.url}/places/${place.category}/${place.slug}/`,
          name: place.name,
          url: `${SITE.url}/places/${place.category}/${place.slug}/`,
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
        },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<PageLayout title={metaTitle} description={description} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <!-- HERO SECTION -->
  <header class="seo-hero">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span>
        <a href="/sectors/">Sectors</a><span>/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <div class="hero-badge">{badge}</div>
      <h1>{headline}</h1>
      <p class="hero-lead">{lead}</p>

      {statPills && statPills.length > 0 && (
        <div class="stat-pills-row">
          {statPills.map((pill) => (
            <div class="stat-pill">
              <strong>{pill.value}</strong>
              <span>{pill.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </header>

  <!-- EDITORIAL OVERVIEW -->
  <section class="editorial-section">
    <div class="container">
      <div class="editorial-box">
        <p class="section-kicker"><span></span> Location Intelligence</p>
        <h2>Lifestyle &amp; Investment Assessment</h2>
        {editorialParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED PLACES GRID -->
  {places && places.length > 0 && (
    <section class="places-section">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker"><span></span> Verified Directory</p>
          <h2>{placesTitle}</h2>
          <p class="section-subtext">{placesSubtitle}</p>
        </div>

        <div class="places-grid">
          {places.map((place) => (
            <article class="place-card">
              <a href={`/places/${place.category}/${place.slug}/`} class="place-thumb-link">
                <PlaceImage place={place} />
                <span class="place-sector-tag">{place.sectorLabel}</span>
              </a>
              <div class="place-body">
                <div class="place-category-badge">{place.categoryLabel}</div>
                <h3>
                  <a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a>
                </h3>
                <div class="place-rating">
                  {place.rating ? (
                    <>
                      <span class="star">★</span>
                      <strong>{place.rating.toFixed(1)}</strong>
                      <small>({place.reviewCount} reviews)</small>
                    </>
                  ) : (
                    <small>Verified establishment</small>
                  )}
                </div>
                <p class="place-address">{place.address}</p>
                <div class="place-actions">
                  {place.phone ? (
                    <a href={`tel:${place.phone.replace(/\s+/g, '')}`} class="btn-phone">
                      Call
                    </a>
                  ) : (
                    <span class="btn-phone disabled">No Phone</span>
                  )}
                  <a href={place.googleMapsUrl} target="_blank" rel="noopener" class="btn-maps" aria-label={`Open ${place.name} in Google Maps`}>
                    Open in Google Maps
                  </a>
                  <a href={`/places/${place.category}/${place.slug}/`} class="btn-detail">
                    Details
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        {allPlacesCategoryUrl && (
          <div class="all-places-cta">
            <a href={allPlacesCategoryUrl} class="btn-gold">
              {allPlacesCategoryLabel} →
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- SECTOR COMPARISON TABLE -->
  {tableRows && tableRows.length > 0 && (
    <section class="table-section">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker"><span></span> Area Breakdown</p>
          <h2>{tableTitle}</h2>
          <p class="section-subtext">{tableSubtitle}</p>
        </div>

        <div class="table-responsive">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Sector</th>
                <th>Facilities / Proximity</th>
                <th>Common Plot/House Sizes</th>
                <th>Price Snapshot</th>
                <th>Walking / Drive Time</th>
                <th>Best For</th>
              </tr>
            </thead>
            <tbody>
              {tableRows.map((row) => (
                <tr>
                  <td>
                    <strong>{row.sector}</strong>
                  </td>
                  <td>{row.amenities}</td>
                  <td>{row.popularSizes}</td>
                  <td><span class="price-pill">{row.priceRange}</span></td>
                  <td>{row.travelTime}</td>
                  <td><span class="suitability-tag">{row.recommendedFor}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- PROPERTIES AVAILABLE -->
  <section class="properties-section">
    <div class="container">
      <div class="section-head">
        <p class="section-kicker"><span></span> Real Estate Market</p>
        <h2>{propertiesTitle}</h2>
        <p class="section-subtext">{propertiesSubtitle}</p>
      </div>

      <div class="properties-grid">
        {properties.map((prop) => (
          <article class="property-card">
            <div class="prop-media">
              <img src={prop.images?.[0]?.url || '/images/placeholders/property-placeholder.svg'} alt={prop.title} loading="lazy" />
              <span class="prop-badge">{prop.block}</span>
              <span class="prop-type">{prop.propertyType.replace('-', ' ')}</span>
            </div>
            <div class="prop-content">
              <div class="prop-price-line">
                <strong>PKR {(prop.price / 10000000).toFixed(2)} Cr</strong>
                <span>{prop.size} {prop.unit.toUpperCase()}</span>
              </div>
              <h3><a href={`/properties/${prop.slug}/`}>{prop.title}</a></h3>
              <p class="prop-addr">{prop.location?.address || `${prop.block}, DHA Phase 6`}</p>
              <div class="prop-btn-row">
                <a href={`/properties/${prop.slug}/`} class="btn-prop">View Snapshot →</a>
              </div>
            </div>
          </article>
        ))}

        <div class="cta-card">
          <div class="cta-tag">Direct Search</div>
          <h3>Find More Active Listings</h3>
          <p>Search active inventory, plot orientations, and builder houses directly on leading portals.</p>
          <div class="cta-buttons">
            <a href={zameenSearchUrl} target="_blank" rel="noopener noreferrer" class="btn-gold">
              {zameenSearchLabel}
            </a>
            <a href="/properties/" class="btn-outline">
              All Property Snapshots →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DUE DILIGENCE CHECKLIST -->
  {checklistBullets && checklistBullets.length > 0 && (
    <section class="checklist-section">
      <div class="container">
        <div class="checklist-box">
          <p class="section-kicker"><span></span> Buyer Advisory</p>
          <h2>{checklistTitle}</h2>
          <ul class="check-list">
            {checklistBullets.map((bullet) => (
              <li>
                <span class="check-icon">✓</span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ SECTION -->
  {faqs && faqs.length > 0 && (
    <section class="faq-section" id="faq">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker"><span></span> Common Inquiries</p>
          <h2>Frequently Asked Questions</h2>
        </div>

        <div class="faq-accordion">
          {faqs.map((faq, index) => (
            <details class="faq-card" id={`faq-${index + 1}`}>
              <summary>{faq.question}</summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- RELATED LINKS HUB -->
  {relatedLinks && relatedLinks.length > 0 && (
    <section class="links-hub-section">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker"><span></span> Internal Exploration</p>
          <h2>Explore DHA Phase 6 Lahore Resources</h2>
        </div>

        <div class="links-grid">
          {relatedLinks.map((link) => (
            <a href={link.href} class="link-card">
              <strong>{link.label}</strong>
              <p>{link.desc}</p>
              <span class="link-arrow">Explore Guide →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</PageLayout>

<style>
  /* Base & Hero */
  .seo-hero {
    padding: 72px 0 56px;
    background: linear-gradient(165deg, #090919 0%, #111128 55%, #0c0c1e 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    position: relative;
  }
  .breadcrumb-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #64647f;
    margin-bottom: 1.2rem;
  }
  .breadcrumb-nav a {
    color: #9292ad;
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-nav a:hover {
    color: #f0c857;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgba(212, 168, 68, 0.12);
    border: 1px solid rgba(212, 168, 68, 0.3);
    color: #f0c857;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .seo-hero h1 {
    font-size: clamp(2rem, 4.2vw, 2.9rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 860px;
    margin: 0 auto 0.8rem;
  }
  .hero-lead {
    font-size: 0.98rem;
    color: #9292ad;
    max-width: 660px;
    margin: 0 auto 1.75rem;
    line-height: 1.6;
  }
  .stat-pills-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .stat-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.65rem 1.2rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 100px;
  }
  .stat-pill strong {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f0c857;
    line-height: 1;
  }
  .stat-pill span {
    font-size: 0.6rem;
    color: #9292ad;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.3rem;
  }

  /* Section Headings */
  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #d4a844;
    margin-bottom: 0.5rem;
  }
  .section-kicker span {
    width: 22px;
    height: 2px;
    background: #d4a844;
    border-radius: 1px;
  }
  .section-head {
    margin-bottom: 2rem;
  }
  .section-head h2 {
    color: #ffffff;
    font-size: 1.65rem;
    font-weight: 800;
    margin: 0 0 0.4rem;
  }
  .section-subtext {
    color: #9292ad;
    font-size: 0.88rem;
    margin: 0;
  }

  /* Editorial */
  .editorial-section {
    padding: 64px 0;
    background: #080818;
  }
  .editorial-box {
    background: #111125;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2.2rem;
  }
  .editorial-box h2 {
    color: #ffffff;
    font-size: 1.45rem;
    font-weight: 800;
    margin: 0 0 1rem;
  }
  .editorial-box p {
    color: #a5a5c0;
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .editorial-box p:last-child {
    margin-bottom: 0;
  }

  /* Places Grid */
  .places-section {
    padding: 64px 0;
    background: #0d0d21;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .places-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  .place-card {
    background: #111125;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.25s, border-color 0.25s;
    display: flex;
    flex-direction: column;
  }
  .place-card:hover {
    transform: translateY(-2px);
    border-color: rgba(212, 168, 68, 0.35);
  }
  .place-thumb-link {
    position: relative;
    display: block;
    aspect-ratio: 16/10;
    background: #181830;
    overflow: hidden;
  }
  .place-thumb-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .place-card:hover .place-thumb-link img {
    transform: scale(1.04);
  }
  .place-sector-tag {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    background: rgba(8, 8, 24, 0.85);
    color: #f0c857;
    font-size: 0.55rem;
    font-weight: 800;
  }
  .place-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .place-category-badge {
    font-size: 0.55rem;
    color: #d4a844;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .place-body h3 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    line-height: 1.35;
  }
  .place-body h3 a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s;
  }
  .place-body h3 a:hover {
    color: #f0c857;
  }
  .place-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.68rem;
    margin-bottom: 0.4rem;
  }
  .place-rating .star {
    color: #d4a844;
  }
  .place-rating strong {
    color: #ffffff;
  }
  .place-rating small {
    color: #64647f;
  }
  .place-address {
    font-size: 0.7rem;
    color: #9292ad;
    line-height: 1.4;
    margin: 0 0 0.8rem;
    font-style: normal;
  .place-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .btn-maps {
    grid-column: span 2;
  }
  .btn-phone, .btn-maps, .btn-detail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.38rem 0.4rem;
    border-radius: 5px;
    font-size: 0.64rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .btn-phone {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.28);
    color: #34d399;
  }
  .btn-phone.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
    color: #64647f;
  }
  .btn-maps {
    background: rgba(52, 152, 219, 0.12);
    border: 1px solid rgba(52, 152, 219, 0.28);
    color: #60a5fa;
  }
  .btn-detail {
    background: linear-gradient(135deg, #d4a844, #f0c857);
    color: #080818;
  }
  .all-places-cta {
    text-align: center;
    margin-top: 2rem;
  }

  /* Comparison Table */
  .table-section {
    padding: 64px 0;
    background: #080818;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .table-responsive {
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background: #111125;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    text-align: left;
  }
  .comparison-table th {
    background: rgba(255, 255, 255, 0.03);
    color: #ffffff;
    font-weight: 700;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    white-space: nowrap;
  }
  .comparison-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #a5a5c0;
    vertical-align: middle;
  }
  .comparison-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }
  .price-pill {
    display: inline-block;
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
    background: rgba(212, 168, 68, 0.15);
    color: #f0c857;
    font-weight: 700;
    font-size: 0.72rem;
  }
  .suitability-tag {
    display: inline-block;
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    font-size: 0.7rem;
    font-weight: 600;
  }

  /* Properties Section */
  .properties-section {
    padding: 64px 0;
    background: #0f0f26;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .properties-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
  }
  .property-card {
    background: #111125;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s, border-color 0.25s;
  }
  .property-card:hover {
    transform: translateY(-2px);
    border-color: rgba(212, 168, 68, 0.35);
  }
  .prop-media {
    position: relative;
    aspect-ratio: 16/10;
    background: #181830;
    overflow: hidden;
  }
  .prop-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prop-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.18rem 0.45rem;
    border-radius: 4px;
    background: rgba(8, 8, 24, 0.85);
    color: #f0c857;
    font-size: 0.55rem;
    font-weight: 800;
  }
  .prop-type {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    padding: 0.18rem 0.45rem;
    border-radius: 4px;
    background: rgba(8, 8, 24, 0.85);
    color: #ffffff;
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: capitalize;
  }
  .prop-content {
    padding: 1rem;
