---
/**
 * PropertyDetails.astro — Full Property Detail View
 * Displays all property information in a structured layout.
 */

interface Props {
  title: string;
  propertyType: string;
  purpose: string;
  price: number;
  priceUnit?: string;
  size: string;
  sizeUnit?: string;
  block: string;
  location: { address: string };
  description: string;
  features: string[];
  verificationStatus?: string;
  source?: string;
}

const {
  title,
  propertyType,
  purpose,
  price,
  priceUnit = 'PKR',
  size,
  sizeUnit = 'marla',
  block,
  location,
  description,
  features,
  verificationStatus = 'unverified',
  source,
} = Astro.props;

const formattedPrice = new Intl.NumberFormat('en-PK').format(price);
---

<div class="property-details" id="property-details">
  <!-- Header -->
  <div class="property-details__header">
    <div class="property-details__badges">
      <span class="label">{propertyType}</span>
      <span class:list={['property-details__purpose', `property-details__purpose--${purpose}`]}>
        {purpose === 'sale' ? 'For Sale' : purpose === 'rent' ? 'For Rent' : 'For Lease'}
      </span>
    </div>
    <h1 class="property-details__title">{title}</h1>
    <p class="property-details__location">{location.address}</p>
    <p class="property-details__price price price-lg">
      {priceUnit} {formattedPrice}
    </p>
  </div>

  <!-- Key Facts -->
  <div class="property-details__facts">
    <div class="property-details__fact">
      <span class="property-details__fact-label">Size</span>
      <span class="property-details__fact-value">{size} {sizeUnit}</span>
    </div>
    <div class="property-details__fact">
      <span class="property-details__fact-label">Type</span>
      <span class="property-details__fact-value">{propertyType}</span>
    </div>
    <div class="property-details__fact">
      <span class="property-details__fact-label">Block</span>
      <span class="property-details__fact-value">{block}</span>
    </div>
    <div class="property-details__fact">
      <span class="property-details__fact-label">Status</span>
      <span class="property-details__fact-value" style={`text-transform: capitalize`}>
        {verificationStatus}
      </span>
    </div>
  </div>

  <!-- Description -->
  <div class="property-details__section">
    <h2>Description</h2>
    <div class="prose">
      <p>{description}</p>
    </div>
  </div>

  <!-- Features -->
  {
    features.length > 0 && (
      <div class="property-details__section">
        <h2>Features</h2>
        <ul class="property-details__features">
          {features.map((feature) => (
            <li class="property-details__feature">{feature}</li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Source -->
  {
    source && (
      <div class="property-details__source">
        <p class="caption">Source: {source}</p>
      </div>
    )
  }
</div>

<style>
  .property-details__header {
    margin-bottom: var(--space-8);
  }

  .property-details__badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .property-details__purpose {
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .property-details__purpose--sale {
    background-color: var(--color-accent-100);
    color: var(--color-accent-800);
  }

  .property-details__purpose--rent {
    background-color: var(--color-secondary-100);
    color: var(--color-secondary-800);
  }

  .property-details__title {
    margin-bottom: var(--space-2);
  }

  .property-details__location {
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
  }

  .property-details__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--bg-secondary);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .property-details__facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .property-details__fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .property-details__fact-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .property-details__fact-value {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
  }

  .property-details__section {
    margin-bottom: var(--space-8);
  }

  .property-details__section h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .property-details__features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .property-details__feature {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .property-details__feature::before {
    content: '✓';
    color: var(--color-accent-500);
    font-weight: var(--font-bold);
  }

  .property-details__source {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-neutral-200);
  }
</style>
