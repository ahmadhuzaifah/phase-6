---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from './PropertyCard.astro';
import { SITE } from '@data/site';
import properties from '@data/properties-import.json';
import { SECTORS_DIRECTORY } from '@data/places/index';
import { isPublishableProperty } from '@utils/propertyQualityScore';
import { getPropertyFreshness } from '@utils/propertyFreshness';
import { isActiveProperty } from '@utils/propertyLifecycle';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow: string;
  types: string[];
  canonicalPath: string;
}

const { title, description, heading, eyebrow, types, canonicalPath } = Astro.props;
const listings = properties.filter(
  (property) =>
    types.includes(property.propertyType) &&
    isPublishableProperty(property) &&
    isActiveProperty(property),
);
const sectorCount = new Set(listings.map((property) => property.block)).size;
const isPlotCollection = canonicalPath === '/plots';

const breadcrumbSchema = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: heading, item: `${SITE.url}${canonicalPath}` },
  ],
};
---

<PageLayout title={title} description={description} canonical={`${SITE.url}${canonicalPath}`}>
  <Schema type="BreadcrumbList" data={breadcrumbSchema} />
  <header class="collection-hero">
    <div class="container">
      <nav class="collection-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span aria-current="page"
          >{isPlotCollection ? 'Plots' : 'Properties'}</span
        >
      </nav>
      <p class="collection-eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <div class="collection-hero__intro">
        <p>{description}</p>
        <div class="collection-stats" aria-label="Collection summary">
          <span><strong>{listings.length}</strong> live records</span>
          <span><strong>{sectorCount}</strong> locations</span>
          <span><strong>100%</strong> source dated</span>
        </div>
      </div>
    </div>
  </header>

  <section class="source-notice">
    <div class="container">
      <span class="source-notice__mark">i</span>
      <strong>Market snapshot, not verified inventory</strong>
      <p>
        Cards summarize public source references. Confirm live availability, ownership, condition,
        dues and transfer requirements independently. Third-party content is used only when reuse
        permission is documented.
      </p>
    </div>
  </section>

  <section class="collection-section">
    <div class="container">
      <div class="collection-heading">
        <div>
          <p>Source-referenced records</p>
          <h2><span id="active-count">{listings.length}</span> Market Snapshots</h2>
        </div>
        <a href="/verification-and-transfer">Open verification checklist</a>
      </div>

      <!-- PREMIUM FILTER PANEL (Phase 10.17) -->
      <div class="filter-panel" id="property-filters">
        <div class="filter-panel__heading">
          <div>
            <span>Refine listings</span><strong>Find the right DHA Phase 6 property</strong>
          </div>
          <small>Filters update results instantly</small>
        </div>
        <div class="filter-group">
          <label for="filter-purpose">Purpose</label>
          <select id="filter-purpose">
            <option value="all">Sale &amp; Rent</option>
            <option value="sale">Buy</option>
            <option value="rent">Rent</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-category">Property Type</label>
          <select id="filter-category">
            <option value="all">All Categories</option>
            <option value="house">House / Villa</option>
            <option value="residential-plot">Residential Plot</option>
            <option value="commercial">Commercial</option>
            <option value="apartment">Flat / Apartment</option>
            <option value="portion-floor">Portion / Floor</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-size">Size</label>
          <select id="filter-size">
            <option value="all">All Sizes</option>
            <option value="3">3 Marla</option>
            <option value="5">5 Marla</option>
            <option value="8-marla">8 Marla</option>
            <option value="10">10 Marla</option>
            <option value="1-kanal">1 Kanal</option>
            <option value="2-kanal">2 Kanal</option>
            <option value="4-marla">4 Marla (Commercial)</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-sector">Sector</label>
          <select id="filter-sector">
            <option value="all">All Sectors (A–N)</option>
            <option value="Sector A">Sector A</option>
            <option value="Sector B">Sector B</option>
            <option value="Sector C">Sector C</option>
            <option value="Sector D">Sector D</option>
            <option value="Sector E">Sector E</option>
            <option value="Sector F">Sector F</option>
            <option value="Sector G">Sector G</option>
            <option value="Sector H">Sector H</option>
            <option value="Sector J">Sector J</option>
            <option value="Sector K">Sector K</option>
            <option value="Sector L">Sector L</option>
            <option value="Sector M">Sector M</option>
            <option value="Sector N">Sector N</option>
            <option value="CCA">CCA Commercial</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-price">Price Bracket</label>
          <select id="filter-price">
            <option value="all">Any Price</option>
            <option value="under-1cr">Under 1 Crore</option>
            <option value="1cr-3cr">1 – 3 Crore</option>
            <option value="3cr-5cr">3 – 5 Crore</option>
            <option value="5cr-plus">5+ Crore</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-status">Status</label>
          <select id="filter-status">
            <option value="all">All Statuses</option>
            <option value="available">Available</option>
            <option value="reserved">Reserved</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-bedrooms">Bedrooms</label>
          <select id="filter-bedrooms">
            <option value="all">Any Bedrooms</option>
            <option value="1">1+</option><option value="2">2+</option><option value="3">3+</option>
            <option value="4">4+</option><option value="5">5+</option><option value="6">6+</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-bathrooms">Bathrooms</label>
          <select id="filter-bathrooms">
            <option value="all">Any Bathrooms</option>
            <option value="1">1+</option><option value="2">2+</option><option value="3">3+</option>
            <option value="4">4+</option><option value="5">5+</option><option value="6">6+</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-freshness">Freshness</label>
          <select id="filter-freshness">
            <option value="all">Any Freshness</option>
            <option value="fresh">Fresh Listing (0-7 days)</option>
            <option value="recent">Recently Checked (8-30 days)</option>
            <option value="needs-verification">Needs Verification (31-59 days)</option>
            <option value="verification-required">Verification Required (60+ days)</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-verified">Verification</label>
          <select id="filter-verified">
            <option value="all">Any Verification</option>
            <option value="verified">Verified</option>
            <option value="unverified">Needs Verification</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-sort">Sort By</label>
          <select id="filter-sort">
            <option value="latest">Latest Updated</option>
            <option value="price-asc">Price Low</option>
            <option value="price-desc">Price High</option>
          </select>
        </div>

        <button type="button" id="reset-filters-btn" class="reset-btn">Reset</button>
      </div>

      {
        listings.length > 0 ? (
          <div class="collection-grid" id="property-grid">
            {listings.map((property) => (
              <div
                class="property-item"
                data-type={property.propertyType}
                data-purpose={property.purpose}
                data-size={property.size}
                data-unit={property.unit}
                data-sector={property.block}
                data-price={property.price}
                data-status={property.availabilityStatus}
                data-date={property.lastSeenAt || property.lastCheckedDate}
                data-bedrooms={property.bedrooms || 0}
                data-bathrooms={property.bathrooms || 0}
                data-freshness={
                  getPropertyFreshness(property.lastSeenAt || property.lastCheckedDate).key
                }
                data-verified={
                  property.verificationStatus === 'verified' ? 'verified' : 'unverified'
                }
              >
                <PropertyCard
                  title={property.title}
                  slug={property.slug}
                  propertyType={property.propertyType}
                  purpose={property.purpose}
                  price={property.price}
                  priceUnit={property.priceUnit}
                  size={property.size}
                  sizeUnit={property.unit}
                  block={property.block}
                  location={property.location.address}
                  image={property.images[0]}
                  verificationStatus={property.verificationStatus}
                  availabilityStatus={property.availabilityStatus}
                  lastVerifiedDate={property.lastVerifiedDate}
                  lastCheckedDate={property.lastSeenAt || property.lastCheckedDate}
                  sourceName={property.source}
                  sourceURL={property.sourceLinkAllowed === false ? undefined : property.sourceUrl}
                  isFeatured={property.isFeatured}
                  bedrooms={property.bedrooms}
                  bathrooms={property.bathrooms}
                />
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <>
              <h2>No source-referenced records yet</h2>
              <p>
                Use the contact page to submit owner-authorized inventory with clean, licensed
                images.
              </p>
            </>
          </div>
        )
      }
      <div id="no-filter-match" class="empty-state" style="display: none; margin-top: 2rem;">
        <h2>No properties match your current filters</h2>
        <p>Try broadening your price range, sector, or size criteria.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function initPropertyFilter() {
      const catSelect = document.getElementById('filter-category');
      const purposeSelect = document.getElementById('filter-purpose');
      const sizeSelect = document.getElementById('filter-size');
      const sectorSelect = document.getElementById('filter-sector');
      const priceSelect = document.getElementById('filter-price');
      const statusSelect = document.getElementById('filter-status');
      const bedroomsSelect = document.getElementById('filter-bedrooms');
      const bathroomsSelect = document.getElementById('filter-bathrooms');
      const freshnessSelect = document.getElementById('filter-freshness');
      const verifiedSelect = document.getElementById('filter-verified');
      const sortSelect = document.getElementById('filter-sort');
      const resetBtn = document.getElementById('reset-filters-btn');
      const grid = document.getElementById('property-grid');
      const counter = document.getElementById('active-count');
      const noMatch = document.getElementById('no-filter-match');

      if (!grid) return;
      const items = Array.from(grid.querySelectorAll('.property-item'));

      function applyFilters() {
        const cat = catSelect ? catSelect.value : 'all';
        const purpose = purposeSelect ? purposeSelect.value : 'all';
        const size = sizeSelect ? sizeSelect.value : 'all';
        const sector = sectorSelect ? sectorSelect.value : 'all';
        const price = priceSelect ? priceSelect.value : 'all';
        const status = statusSelect ? statusSelect.value : 'all';
        const bedrooms = bedroomsSelect ? bedroomsSelect.value : 'all';
        const bathrooms = bathroomsSelect ? bathroomsSelect.value : 'all';
        const freshness = freshnessSelect ? freshnessSelect.value : 'all';
        const verified = verifiedSelect ? verifiedSelect.value : 'all';
        const sort = sortSelect ? sortSelect.value : 'latest';

        let visibleCount = 0;

        items.forEach((item) => {
          const itemType = (item.dataset.type || '').toLowerCase();
          const itemPurpose = (item.dataset.purpose || '').toLowerCase();
          const itemSize = (item.dataset.size || '').toLowerCase();
          const itemUnit = (item.dataset.unit || '').toLowerCase();
          const itemSector = item.dataset.sector || '';
          const itemPrice = parseFloat(item.dataset.price || '0');
          const itemStatus = (item.dataset.status || 'available').toLowerCase();
          const itemBedrooms = Number(item.dataset.bedrooms || 0);
          const itemBathrooms = Number(item.dataset.bathrooms || 0);
          const itemFreshness = item.dataset.freshness || 'verification-required';
          const itemVerified = item.dataset.verified || 'unverified';

          // Category match
          let matchCat = cat === 'all';
          if (!matchCat) {
            if (cat === 'house' && (itemType.includes('house') || itemType.includes('villa')))
              matchCat = true;
            else if (
              cat === 'residential-plot' &&
              itemType.includes('plot') &&
              !itemType.includes('commercial')
            )
              matchCat = true;
            else if (
              cat === 'commercial' &&
              (itemType.includes('commercial') || itemType.includes('shop'))
            )
              matchCat = true;
            else if (
              cat === 'apartment' &&
              (itemType.includes('apartment') || itemType.includes('flat'))
            )
              matchCat = true;
            else if (cat === 'portion-floor' && itemType.includes('portion')) matchCat = true;
          }

          const matchPurpose = purpose === 'all' || itemPurpose === purpose;

          // Size match
          let matchSize = size === 'all';
          if (!matchSize) {
            if (size === '1-kanal' && itemSize === '1' && itemUnit === 'kanal') matchSize = true;
            else if (size === '2-kanal' && itemSize === '2' && itemUnit === 'kanal')
              matchSize = true;
            else if (size === '10' && itemSize === '10' && itemUnit === 'marla') matchSize = true;
            else if (size === '5' && itemSize === '5' && itemUnit === 'marla') matchSize = true;
            else if (size === '3' && itemSize === '3' && itemUnit === 'marla') matchSize = true;
            else if (size === '4-marla' && itemSize === '4' && itemUnit === 'marla')
              matchSize = true;
            else if (size === '8-marla' && itemSize === '8' && itemUnit === 'marla')
              matchSize = true;
          }

          // Sector match
          let matchSector = sector === 'all';
          if (!matchSector) {
            if (sector === 'CCA')
              matchSector = itemSector.includes('CCA') || itemSector.includes('Commercial');
            else matchSector = itemSector.includes(sector);
          }

          // Price match
          let matchPrice = price === 'all';
          if (!matchPrice) {
            if (price === 'under-1cr' && itemPrice < 10000000) matchPrice = true;
            else if (price === '1cr-3cr' && itemPrice >= 10000000 && itemPrice <= 30000000)
              matchPrice = true;
            else if (price === '3cr-5cr' && itemPrice > 30000000 && itemPrice <= 50000000)
              matchPrice = true;
            else if (price === '5cr-plus' && itemPrice > 50000000) matchPrice = true;
          }

          // Status match
          const matchStatus = status === 'all' || itemStatus === status;
          const matchBedrooms = bedrooms === 'all' || itemBedrooms >= Number(bedrooms);
          const matchBathrooms = bathrooms === 'all' || itemBathrooms >= Number(bathrooms);
          const matchFreshness = freshness === 'all' || itemFreshness === freshness;
          const matchVerified = verified === 'all' || itemVerified === verified;

          if (
            matchPurpose &&
            matchCat &&
            matchSize &&
            matchSector &&
            matchPrice &&
            matchStatus &&
            matchBedrooms &&
            matchBathrooms &&
            matchFreshness &&
            matchVerified
          ) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        // Sorting
        const visibleItems = items.filter((it) => it.style.display !== 'none');
        visibleItems.sort((a, b) => {
          const priceA = parseFloat(a.dataset.price || '0');
          const priceB = parseFloat(b.dataset.price || '0');
          const dateA = new Date(a.dataset.date || 0).getTime();
          const dateB = new Date(b.dataset.date || 0).getTime();

          if (sort === 'price-asc') return priceA - priceB;
          if (sort === 'price-desc') return priceB - priceA;
          if (sort === 'recent' || sort === 'latest') return dateB - dateA;
          return 0;
        });
        visibleItems.forEach((it) => grid.appendChild(it));

        if (counter) counter.textContent = visibleCount.toString();
        if (noMatch) noMatch.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      [
        purposeSelect,
        catSelect,
        sizeSelect,
        sectorSelect,
        priceSelect,
        statusSelect,
        bedroomsSelect,
        bathroomsSelect,
        freshnessSelect,
        verifiedSelect,
        sortSelect,
      ].forEach((sel) => {
        if (sel) sel.addEventListener('change', applyFilters);
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (catSelect) catSelect.value = 'all';
          if (purposeSelect) purposeSelect.value = 'all';
          if (sizeSelect) sizeSelect.value = 'all';
          if (sectorSelect) sectorSelect.value = 'all';
          if (priceSelect) priceSelect.value = 'all';
          if (statusSelect) statusSelect.value = 'all';
          if (bedroomsSelect) bedroomsSelect.value = 'all';
          if (bathroomsSelect) bathroomsSelect.value = 'all';
          if (freshnessSelect) freshnessSelect.value = 'all';
          if (verifiedSelect) verifiedSelect.value = 'all';
          if (sortSelect) sortSelect.value = 'latest';
          applyFilters();
        });
      }
    })();
  </script>

  <!-- SECTOR PROPERTY GUIDES (Phase 10.13) -->
  <section class="sector-guides-section">
    <div class="container">
      <div class="collection-heading">
        <div>
          <p>Sector-by-sector property intelligence</p>
          <h2>Explore Properties by Sector</h2>
        </div>
      </div>
      <div class="sector-nav-grid">
        {
          SECTORS_DIRECTORY.filter((s) => s.type === 'residential').map((sector) => (
            <a href={`/sectors/${sector.key}/properties/`} class="sector-nav-card">
              <strong>{sector.label}</strong>
              <span>Plot &amp; House Guide →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- LOCATION & LIFESTYLE PROPERTY GUIDES (Phase 10.13) -->
  <section class="location-seo-section">
    <div class="container">
      <div class="collection-heading">
        <div>
          <p>Lifestyle &amp; Proximity Search</p>
          <h2>Location Intelligence Guides</h2>
        </div>
      </div>
      <div class="location-nav-grid">
        <a href="/houses-near-schools-dha-phase-6-lahore/" class="location-nav-card">
          <span class="loc-badge">Education</span>
          <strong>Houses Near Schools</strong>
          <p>LGS, Beaconhouse &amp; Roots IVY school commute guide.</p>
        </a>
        <a href="/houses-near-hospitals-dha-phase-6-lahore/" class="location-nav-card">
          <span class="loc-badge">Healthcare</span>
          <strong>Houses Near Hospitals</strong>
          <p>DHA Medical Centre &amp; 24/7 clinic proximity analysis.</p>
        </a>
        <a href="/houses-near-mosques-dha-phase-6-lahore/" class="location-nav-card">
          <span class="loc-badge">Spiritual</span>
          <strong>Houses Near Mosques</strong>
          <p>Walking distance to Grand Jamia Masjids across sectors.</p>
        </a>
        <a href="/houses-near-parks-dha-phase-6-lahore/" class="location-nav-card">
          <span class="loc-badge">Greenery</span>
          <strong>Houses Near Parks</strong>
          <p>Park-facing properties, jogging tracks &amp; green living.</p>
        </a>
        <a href="/plots-near-schools-dha-phase-6-lahore/" class="location-nav-card">
          <span class="loc-badge">Land</span>
          <strong>Plots Near Schools</strong>
          <p>10 Marla &amp; 1 Kanal residential plots for home building.</p>
        </a>
        <a href="/plots-near-commercial-dha-phase-6-lahore/" class="location-nav-card">
          <span class="loc-badge">Commercial</span>
          <strong>Plots Near Commercial Areas</strong>
          <p>Walkable residential &amp; high-yield commercial land in CCA.</p>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .collection-hero,
  .collection-section,
  .sector-guides-section,
  .location-seo-section {
    --collection-bg: #080f12;
    --collection-panel: #101e21;
    --collection-border: rgba(185, 215, 202, 0.14);
    --collection-muted: #91a49e;
    --collection-accent: #30c487;
    --collection-gold: #e3b85a;
  }
  .collection-hero {
    position: relative;
    overflow: hidden;
    padding: 7.2rem 0 2.8rem;
    border-bottom: 1px solid var(--collection-border);
    background:
      linear-gradient(105deg, rgba(8, 19, 21, 0.96), rgba(9, 29, 27, 0.84)),
      repeating-linear-gradient(120deg, transparent 0 34px, rgba(48, 196, 135, 0.035) 34px 35px);
    color: #e8f0ed;
  }
  .collection-hero::after {
    position: absolute;
    right: -8rem;
    bottom: -15rem;
    width: 34rem;
    height: 34rem;
    border: 1px solid rgba(48, 196, 135, 0.16);
    border-radius: 50%;
    box-shadow:
      0 0 0 5rem rgba(48, 196, 135, 0.025),
      0 0 0 10rem rgba(48, 196, 135, 0.018);
    content: '';
    pointer-events: none;
  }
  .collection-hero .container {
    position: relative;
    z-index: 1;
  }
  .collection-breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: 1.35rem;
    color: #6f8580;
    font-size: 0.76rem;
  }
  .collection-breadcrumb a {
    color: #9db0aa;
    text-decoration: none;
  }
  .collection-breadcrumb a:hover {
    color: var(--collection-accent);
  }
  .collection-eyebrow,
  .collection-heading p {
    margin: 0 0 0.55rem;
    color: var(--collection-accent);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .collection-hero h1 {
    max-width: 900px;
    margin: 0;
    color: #fff;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 650;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .collection-hero__intro {
    display: grid;
    grid-template-columns: minmax(0, 680px) auto;
    gap: 2rem;
    align-items: end;
    margin-top: 1.15rem;
  }
  .collection-hero__intro > p {
    margin: 0;
    color: #9baca7;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .collection-stats {
    display: flex;
    gap: 1.4rem;
  }
  .collection-stats span {
    color: #71847e;
    font-size: 0.63rem;
    white-space: nowrap;
  }
  .collection-stats strong {
    display: block;
    margin-bottom: 0.12rem;
    color: #e9f1ee;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.05rem;
  }
  .source-notice {
    padding: 0.95rem 0;
    border-bottom: 1px solid rgba(48, 196, 135, 0.18);
    background: #0c191b;
    color: #a9b9b4;
  }
  .source-notice .container {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
  }
  .source-notice__mark {
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border: 1px solid rgba(48, 196, 135, 0.42);
    border-radius: 50%;
    color: #55dca4;
    font-family: Georgia, serif;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .source-notice strong {
    color: #dbe6e2;
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .source-notice p {
    margin: 0;
    color: #71847e;
    font-size: 0.66rem;
    line-height: 1.5;
  }
  .collection-section {
    padding: 3rem 0 5rem;
    background:
      radial-gradient(circle at 10% 10%, rgba(31, 140, 104, 0.07), transparent 28rem),
      var(--collection-bg);
    color: #e8f0ed;
  }
  .collection-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.4rem;
  }
