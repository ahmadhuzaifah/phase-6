---
import { CONTACTS } from '@data/contacts';

interface Props {
  title: string;
  slug: string;
  propertyType: string;
  purpose: string;
  price: number;
  priceUnit?: string;
  size: string;
  sizeUnit?: string;
  block: string;
  location?: string;
  image?: { url: string; alt: string };
  verificationStatus?: string;
  availabilityStatus?: string;
  lastVerifiedDate?: string;
  sourceName?: string;
  sourceURL?: string;
  isFeatured?: boolean;
}

const {
  title, slug, propertyType, purpose, price, size, block,
  sizeUnit = 'marla',
  location = 'DHA Phase 6, Lahore',
  image,
  verificationStatus = 'unverified',
  availabilityStatus = 'source-check-required',
  lastVerifiedDate,
  sourceName = 'Public listing source',
  sourceURL,
  isFeatured = false,
} = Astro.props;

const formatPKR = (value: number) => {
  if (value >= 10_000_000) return `${(value / 10_000_000).toFixed(2)} Crore`;
  if (value >= 100_000) return `${(value / 100_000).toFixed(2)} Lakh`;
  return new Intl.NumberFormat('en-PK').format(value);
};
const imageUrl = image?.url || '/images/placeholders/property-placeholder.svg';
const imageAlt = image?.alt || `${title}, DHA Phase 6 Lahore`;
const typeLabel = propertyType.replaceAll('-', ' ');
const dateLabel = lastVerifiedDate
  ? new Intl.DateTimeFormat('en-PK', { dateStyle: 'medium' }).format(new Date(lastVerifiedDate))
  : 'Not recorded';
const statusLabel = availabilityStatus === 'source-check-required'
  ? 'Check source'
  : availabilityStatus === 'sold'
    ? 'Sold'
    : availabilityStatus === 'reserved'
      ? 'Reserved'
      : 'Availability unconfirmed';
const whatsappUrl = `https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Please help me verify this DHA Phase 6 market record: ${title}.`)}`;
---

<article class:list={['market-card', { 'market-card--featured': isFeatured }]}>
  <a class="market-card__visual" href={`/properties/${slug}`} aria-label={`Read ${title}`}>
    <img src={imageUrl} alt={imageAlt} width="800" height="560" loading="lazy" />
    <span>{statusLabel}</span>
  </a>
  <div class="market-card__body">
    <div class="market-card__meta">
      <span>{block}</span>
      <span>{purpose === 'rent' ? 'For rent' : 'For sale'}</span>
    </div>
    <h3><a href={`/properties/${slug}`}>{title}</a></h3>
    <div class="market-card__facts">
      <span><strong>{size}</strong> {sizeUnit}</span>
      <span>{typeLabel}</span>
      <span>{location}</span>
    </div>
    <div class="market-card__source">
      <span>Source checked {dateLabel}</span>
      {sourceURL ? <a href={sourceURL} target="_blank" rel="noopener noreferrer">{sourceName}</a> : <span>{sourceName}</span>}
    </div>
    <footer>
      <div><small>Advertised demand</small><strong>PKR {formatPKR(price)}</strong></div>
      <div class="market-card__actions">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Verify</a>
        <a href={`/properties/${slug}`}>Details</a>
      </div>
    </footer>
    {verificationStatus !== 'verified' && <p class="market-card__caveat">Unverified third-party market snapshot. It is not confirmed inventory.</p>}
  </div>
</article>

<style>
  .market-card{display:flex;flex-direction:column;overflow:hidden;background:linear-gradient(145deg,#161635,#111128);border:1px solid rgba(255,255,255,.08);border-radius:1rem;box-shadow:0 16px 40px -24px #000;color:#f0f0f5}
  .market-card--featured{border-color:rgba(212,168,68,.58)}
  .market-card__visual{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:#0a0a1a}
  .market-card__visual img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
  .market-card:hover .market-card__visual img{transform:scale(1.025)}
  .market-card__visual>span{position:absolute;top:1rem;left:1rem;padding:.42rem .7rem;border-radius:999px;background:linear-gradient(135deg,#d4a844,#f0c95c);color:#0a0a1a;font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .market-card__body{display:flex;flex:1;flex-direction:column;padding:1.15rem}
  .market-card__meta{display:flex;justify-content:space-between;gap:1rem;color:#d4a844;font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  h3{margin:.7rem 0;font-family:var(--font-display);font-size:1.45rem;line-height:1.15}
  h3 a{color:#f0f0f5;text-decoration:none}
  .market-card__facts{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:1rem;color:#9a9ab5;font-size:.78rem}
  .market-card__facts span{padding:.35rem .55rem;background:rgba(255,255,255,.05);border-radius:.4rem;text-transform:capitalize}
  .market-card__source{display:flex;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:.85rem;border-top:1px solid rgba(255,255,255,.08);color:#6a6a85;font-size:.72rem}
  .market-card__source a{color:#d4a844;font-weight:800}
  footer{display:flex;justify-content:space-between;gap:1rem;align-items:end;margin-top:1rem}
  footer small{display:block;color:#6a6a85;font-size:.68rem;text-transform:uppercase}
  footer strong{display:block;margin-top:.18rem;font-size:1.15rem;color:#f0f0f5}
  .market-card__actions{display:flex;gap:.45rem}
  .market-card__actions a{padding:.55rem .7rem;border:1px solid rgba(212,168,68,.5);border-radius:.4rem;color:#f0c95c;font-size:.74rem;font-weight:900;text-decoration:none}
  .market-card__actions a:first-child{background:#d4a844;color:#0a0a1a}
  .market-card__caveat{margin:.8rem 0 0;color:#d4a844;font-size:.7rem;line-height:1.4}
  @media(max-width:400px){footer,.market-card__source{align-items:flex-start;flex-direction:column}}
</style>
