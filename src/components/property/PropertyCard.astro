---
import { CONTACTS } from '@data/contacts';
import { getPropertyFreshness } from '@utils/propertyFreshness';

interface Props {
  id?: string;
  title: string;
  slug: string;
  propertyType: string;
  purpose: string;
  price: number;
  priceUnit?: string;
  size: string;
  sizeUnit?: string;
  block: string;
  location?: string;
  image?: { url: string; alt: string; width?: number; height?: number };
  verificationStatus?: string;
  availabilityStatus?: string;
  lastVerifiedDate?: string;
  lastCheckedDate?: string;
  sourceName?: string;
  sourceURL?: string;
  isFeatured?: boolean;
  bedrooms?: number | null;
  bathrooms?: number | null;
}

const {
  id,
  title,
  slug,
  propertyType,
  purpose,
  price,
  size,
  block,
  sizeUnit = 'marla',
  location = 'DHA Phase 6, Lahore',
  image,
  availabilityStatus = 'available',
  lastVerifiedDate = '2026-09-02',
  lastCheckedDate,
  sourceName = 'Independent listing information',
  sourceURL,
  isFeatured = false,
  bedrooms,
  bathrooms,
} = Astro.props;

const formatPKR = (value: number) => {
  if (value >= 10_000_000) return `${(value / 10_000_000).toFixed(2)} Crore`;
  if (value >= 100_000) return `${(value / 100_000).toFixed(2)} Lakh`;
  return new Intl.NumberFormat('en-PK').format(value);
};

const cleanBlock = block || 'Phase 6';
const typeLabel = propertyType.replaceAll('-', ' ');
const imageUrl = image?.url || '/images/placeholders/property-placeholder.webp';
const seoImageAlt =
  image?.alt && !image.alt.includes('placeholder')
    ? image.alt
    : `${title} - ${size} ${sizeUnit} ${typeLabel} in ${cleanBlock}, DHA Phase 6 Lahore`;
const imageCaption = `${size} ${sizeUnit} in ${cleanBlock}, DHA Phase 6 Lahore`;
const propId = id || `DHA6-${slug.substring(0, 10).toUpperCase()}`;
const canonicalAvailability = availabilityStatus.toLowerCase();
const availabilityLabel =
  canonicalAvailability === 'removed' ? 'EXPIRED' : canonicalAvailability.toUpperCase();
const freshness = getPropertyFreshness(lastCheckedDate || lastVerifiedDate);
const detailUrl = `/properties/${slug}`;
const whatsappUrl = `https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`I am interested in DHA Phase 6 Lahore property ${propId}. Sector: ${cleanBlock}; Size: ${size} ${sizeUnit}; Type: ${typeLabel}.`)}`;
---

<article class:list={['listing-card', { 'listing-card--featured': isFeatured }]}>
  <a class="listing-card__visual" href={detailUrl} aria-label={`View ${title}`}>
    <figure>
      <img
        src={imageUrl}
        alt={seoImageAlt}
        width={image?.width || 800}
        height={image?.height || 560}
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null;this.src='/images/placeholders/property-placeholder.webp'"
      />
      <figcaption class="sr-only">{imageCaption}</figcaption>
    </figure>
    <span class="listing-card__sector">{cleanBlock}</span>
    <span class:list={['listing-card__availability', `status--${canonicalAvailability}`]}
      >{availabilityLabel}</span
    >
    <span class="listing-card__photo-count">1 photo</span>
  </a>

  <div class="listing-card__body">
    <div class="listing-card__price-row">
      <div>
        <small>Advertised demand / For {purpose}</small><strong>PKR {formatPKR(price)}</strong>
      </div>
      <span class:list={['listing-card__freshness', `freshness--${freshness.key}`]}
        >{freshness.label}</span
      >
    </div>
    <h3><a href={detailUrl}>{title}</a></h3>
    <p class="listing-card__location">{location}</p>
    <div class="listing-card__facts">
      <span><b>SZ</b><strong>{size} {sizeUnit}</strong></span>
      {
        bedrooms ? (
          <span>
            <>
              <b>BR</b>
              <strong>{bedrooms} beds</strong>
            </>
          </span>
        ) : null
      }
      {
        bathrooms ? (
          <span>
            <>
              <b>BA</b>
              <strong>{bathrooms} baths</strong>
            </>
          </span>
        ) : null
      }
      <span><b>PT</b><strong>{typeLabel}</strong></span>
    </div>
    <div class="listing-card__source">
      <div>
        <span>Source checked</span><small
          >{sourceName} / {lastCheckedDate || lastVerifiedDate}</small
        >
      </div>
      {
        sourceURL ? (
          <a href={sourceURL} target="_blank" rel="nofollow noopener noreferrer">
            Original source
          </a>
        ) : null
      }
    </div>
    <footer>
      <span>ID: {propId}</span>
      <div>
        <a class="inquiry-action" href={whatsappUrl} target="_blank" rel="noopener noreferrer"
          >Inquire</a
        ><a class="detail-action" href={detailUrl}>View details <span>&rarr;</span></a>
      </div>
    </footer>
  </div>
</article>

<style>
  .listing-card {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(185, 215, 202, 0.14);
    border-radius: 9px;
    background: linear-gradient(145deg, rgba(19, 35, 37, 0.96), rgba(11, 23, 26, 0.97));
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22);
    color: #e8f0ed;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .listing-card:hover {
    transform: translateY(-3px);
    border-color: rgba(48, 196, 135, 0.38);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }
  .listing-card--featured {
    border-color: rgba(227, 184, 90, 0.48);
  }
  .listing-card__visual {
    position: relative;
    display: block;
    aspect-ratio: 16/10;
    overflow: hidden;
    background: #101b1e;
  }
  .listing-card__visual figure,
  .listing-card__visual img {
    width: 100%;
    height: 100%;
  }
  .listing-card__visual img {
    object-fit: cover;
    transition: transform 360ms ease;
  }
  .listing-card:hover .listing-card__visual img {
    transform: scale(1.035);
  }
  .listing-card__sector,
  .listing-card__availability,
  .listing-card__photo-count {
    position: absolute;
    padding: 0.35rem 0.56rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    background: rgba(5, 13, 14, 0.82);
    color: #dfe9e5;
    backdrop-filter: blur(9px);
    font-size: 0.61rem;
    font-weight: 850;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }
  .listing-card__sector {
    top: 0.75rem;
    left: 0.75rem;
    color: #5ee0aa;
  }
  .listing-card__availability {
    top: 0.75rem;
    right: 0.75rem;
    color: #5ee0aa;
  }
  .listing-card__availability.status--reserved {
    color: #f0c665;
  }
  .listing-card__availability.status--sold,
  .listing-card__availability.status--removed {
    color: #f29b8f;
  }
  .listing-card__photo-count {
    right: 0.75rem;
    bottom: 0.75rem;
    color: #b8c7c2;
    letter-spacing: 0;
    text-transform: none;
  }
  .listing-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1rem;
  }
  .listing-card__price-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.7rem;
  }
  .listing-card__price-row small {
    display: block;
    margin-bottom: 0.18rem;
    color: #71847e;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .listing-card__price-row strong {
    color: #e3b85a;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.2rem;
  }
  .listing-card__freshness {
    flex: 0 0 auto;
    margin-top: 0.1rem;
    padding: 0.3rem 0.48rem;
    border: 1px solid rgba(48, 196, 135, 0.2);
    border-radius: 4px;
    color: #65dba9;
    font-size: 0.58rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .listing-card__freshness.freshness--recent {
    color: #79caea;
    border-color: rgba(121, 202, 234, 0.25);
  }
  .listing-card__freshness.freshness--needs-verification {
    color: #f0c665;
    border-color: rgba(240, 198, 101, 0.25);
  }
  .listing-card__freshness.freshness--verification-required {
    color: #f29b8f;
    border-color: rgba(242, 155, 143, 0.25);
  }
  h3 {
    min-height: 2.6em;
    margin: 0.75rem 0 0.35rem;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.03rem;
    line-height: 1.3;
  }
  h3 a {
    color: #edf4f1;
    text-decoration: none;
  }
  h3 a:hover {
    color: #5cdda7;
  }
  .listing-card__location {
    display: -webkit-box;
    min-height: 2.7em;
    margin: 0 0 0.8rem;
    overflow: hidden;
    color: #7d908a;
    font-size: 0.68rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .listing-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    padding: 0.72rem 0;
    border-top: 1px solid rgba(185, 215, 202, 0.12);
    border-bottom: 1px solid rgba(185, 215, 202, 0.12);
  }
  .listing-card__facts span {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.15rem 0.58rem;
    color: #a8b8b3;
    font-size: 0.65rem;
    text-transform: capitalize;
  }
  .listing-card__facts span:first-child {
    padding-left: 0;
  }
  .listing-card__facts span + span {
    border-left: 1px solid rgba(185, 215, 202, 0.13);
  }
  .listing-card__facts b {
    color: #39c58b;
    font-size: 0.52rem;
  }
  .listing-card__facts strong {
    overflow: hidden;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .listing-card__source {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 0.8rem 0;
  }
  .listing-card__source span,
  .listing-card__source small {
    display: block;
  }
  .listing-card__source span {
    color: #55d9a2;
    font-size: 0.62rem;
    font-weight: 800;
  }
  .listing-card__source small {
    max-width: 190px;
    margin-top: 0.15rem;
    overflow: hidden;
    color: #657871;
    font-size: 0.57rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .listing-card__source > a {
    flex: 0 0 auto;
    color: #8ca19a;
    font-size: 0.59rem;
    text-decoration: underline;
  }
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(185, 215, 202, 0.12);
  }
  footer > span {
    color: #667972;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.56rem;
  }
  footer > div {
    display: flex;
    gap: 0.45rem;
  }
  footer a {
    display: inline-flex;
    min-height: 2.15rem;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.62rem;
    border-radius: 4px;
    font-size: 0.64rem;
    font-weight: 850;
    text-decoration: none;
  }
  .inquiry-action {
    border: 1px solid #2cc182;
    color: #54dba3;
  }
  .detail-action {
    gap: 0.25rem;
    background: #28b579;
    color: #04150f;
  }
  .detail-action span {
    font-size: 0.8rem;
  }
  @media (max-width: 420px) {
    .listing-card__price-row,
    footer {
      align-items: flex-start;
      flex-direction: column;
    }
    footer > div {
      width: 100%;
    }
    footer a {
      flex: 1;
    }
  }
</style>
