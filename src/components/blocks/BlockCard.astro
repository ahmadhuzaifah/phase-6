---
/**
 * BlockCard.astro — Luxury Society Sector / Block Card
 * Highlights block name, live possession status, plot sizes, sector features,
 * and direct map / plot inventory connect.
 */

interface Props {
  name: string;
  slug: string;
  category?: 'executive' | 'residential' | 'luxury-villas' | 'commercial';
  status: 'developed' | 'under-development' | 'possession-ready' | 'planned';
  possessionPercentage?: number;
  description: string;
  plotTypes?: string[];
  plotSizes?: string[];
  features?: string[];
  locationHighlight?: string;
}

const {
  name,
  slug,
  category = 'residential',
  status,
  description,
  plotTypes = [],
  plotSizes = [],
  features = [],
  locationHighlight,
} = Astro.props;

const statusConfig: Record<string, { label: string; class: string; dotColor: string }> = {
  'possession-ready': {
    label: 'Established area - verify exact plot',
    class: 'block-card__status--ready',
    dotColor: '#10B981',
  },
  'developed': {
    label: 'Developed area - verify exact street',
    class: 'block-card__status--developed',
    dotColor: '#059669',
  },
  'under-development': {
    label: 'Current status requires checking',
    class: 'block-card__status--developing',
    dotColor: '#C59B27',
  },
  'planned': {
    label: 'Plan reference only',
    class: 'block-card__status--planned',
    dotColor: '#64748B',
  },
};

const currentStatus = statusConfig[status] || statusConfig['possession-ready'];
---

<article class="block-card" id={`block-${slug}`} data-category={category}>
  <!-- Card Header & Status -->
  <div class="block-card__header">
    <div class="block-card__title-group">
      <span class="block-card__eyebrow">DHA 6 • {category.replace('-', ' ')}</span>
      <h3 class="block-card__name">
        <a href={`/sectors/${slug}`}>{name}</a>
      </h3>
    </div>
    <div class:list={['block-card__status-pill', currentStatus.class]}>
      <span class="block-card__status-dot" style={`background-color: ${currentStatus.dotColor};`}></span>
      <span>{currentStatus.label}</span>
    </div>
  </div>

  <!-- Description -->
  <p class="block-card__description">{description}</p>

  <!-- Location Highlight -->
  {locationHighlight && (
    <div class="block-card__location">
      <span class="block-card__location-icon">📍</span>
      <span class="block-card__location-text">{locationHighlight}</span>
    </div>
  )}

  <!-- Available Plot Sizes Chips & Plot Types -->
  <div class="block-card__plot-sizes">
    <div class="block-card__plot-header">
      <span class="block-card__plot-sizes-label">Common property context:</span>
      {plotTypes.length > 0 && (
        <span class="block-card__types-text">{plotTypes.join(' • ')}</span>
      )}
    </div>
    {plotSizes.length > 0 && (
      <div class="block-card__chips">
        {plotSizes.map((size) => (
          <span class="block-card__chip">{size}</span>
        ))}
      </div>
    )}
  </div>

  <!-- Feature Highlights -->
  {features.length > 0 && (
    <ul class="block-card__features">
      {features.slice(0, 3).map((feat) => (
        <li class="block-card__feature-item">
          <span class="block-card__feature-check">✓</span>
          <span>{feat}</span>
        </li>
      ))}
    </ul>
  )}

  <!-- Card Action Footer -->
  <div class="block-card__footer">
    <a href={`/sectors/${slug}`} class="block-card__btn-explore">
      <span>View sector guide</span>
      <span class="block-card__btn-arrow">→</span>
    </a>
  </div>
</article>

<style>
  .block-card {
    background: linear-gradient(180deg, rgba(10, 17, 40, 0.96) 0%, rgba(8, 14, 30, 0.98) 100%);
    border: 1px solid rgba(243, 211, 117, 0.14);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.65);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
    position: relative;
    color: #FFFFFF;
  }

  .block-card:hover {
    box-shadow: 0 28px 54px -26px rgba(0, 0, 0, 0.72);
    border-color: rgba(243, 211, 117, 0.30);
    transform: translateY(-6px);
  }

  /* ── Header ─────────────────────────────────────────────────────── */
  .block-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 640px) {
    .block-card__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .block-card__eyebrow {
    display: block;
    font-size: 10.5px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #F3D375;
    margin-bottom: 2px;
  }

  .block-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .block-card__name a {
    color: #FFFFFF;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .block-card__name a:hover {
    color: #F3D375;
  }

  .block-card__status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: var(--font-bold);
    align-self: flex-start;
    border: 1px solid transparent;
  }

  .block-card__status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .block-card__status--ready {
    background-color: rgba(16, 185, 129, 0.12);
    color: #9CF3C8;
    border-color: rgba(167, 243, 208, 0.18);
  }

  .block-card__status--developed {
    background-color: rgba(5, 150, 105, 0.12);
    color: #A7F3D0;
    border-color: rgba(167, 243, 208, 0.16);
  }

  .block-card__status--developing {
    background-color: rgba(243, 211, 117, 0.12);
    color: #F3D375;
    border-color: rgba(243, 211, 117, 0.18);
  }

  .block-card__status--planned {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.76);
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* ── Content ────────────────────────────────────────────────────── */
  .block-card__description {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.76);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .block-card__location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.05);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .block-card__location-icon {
    font-size: 13px;
  }

  /* Plot Sizes Chips */
  .block-card__plot-sizes {
    margin-bottom: var(--space-4);
  }

  .block-card__plot-sizes-label {
    display: block;
    font-size: 11px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.56);
    margin-bottom: var(--space-1-5);
  }

  .block-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  .block-card__chip {
    padding: 3px 8px;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    background-color: rgba(197, 155, 39, 0.12);
    color: #F3D375;
    border: 1px solid rgba(243, 211, 117, 0.18);
    border-radius: var(--radius-sm);
  }

  /* Features List */
  .block-card__features {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .block-card__feature-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.74);
  }

  .block-card__feature-check {
    color: var(--color-accent-600);
    font-weight: var(--font-extrabold);
  }

  /* ── Footer ─────────────────────────────────────────────────────── */
  .block-card__footer {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .block-card__btn-explore {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: #FFFFFF;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .block-card__btn-explore:hover {
    color: #F3D375;
    padding-left: var(--space-1);
  }

  .block-card__btn-arrow {
    transition: transform var(--transition-fast);
  }

  .block-card__btn-explore:hover .block-card__btn-arrow {
    transform: translateX(4px);
  }
</style>
