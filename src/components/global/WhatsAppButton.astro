---
/**
 * WhatsAppButton.astro — Floating Real Estate Advisor CTA
 * Fixed-position conversion widget with live pulsing radar and advisory tooltip.
 */

import { CONTACTS } from '@data/contacts';
---

<div class="whatsapp-widget" id="whatsapp-widget">
  <!-- Interactive Tooltip Banner -->
  <a
    href={CONTACTS.whatsapp.url}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-widget__tooltip"
    aria-label="Direct WhatsApp Property Advisory"
  >
    <div class="whatsapp-widget__avatar">
      <span class="whatsapp-widget__avatar-dot"></span>
      <span>D6</span>
    </div>
    <div class="whatsapp-widget__message">
      <span class="whatsapp-widget__title">Independent Property Desk</span>
      <span class="whatsapp-widget__subtitle">Compare sources and request a viewing</span>
    </div>
  </a>

  <!-- Floating Action Button -->
  <a
    href={CONTACTS.whatsapp.url}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-btn"
    id="whatsapp-cta"
    aria-label="Chat on WhatsApp with Property Advisor"
    title="Chat on WhatsApp"
  >
    <span class="whatsapp-btn__pulse" aria-hidden="true"></span>
      <path d="M16 2.5a13.5 13.5 0 0 0-11.7 20.25L3 29l6.45-1.25A13.5 13.5 0 1 0 16 2.5Z" fill="none" stroke="currentColor" stroke-width="2.2" />
      <path d="M11.2 9.2c.3-.4.6-.4.9-.4h.7c.3 0 .5.1.7.6l1 2.4c.1.3.1.5-.1.8l-.6.8c-.2.2-.2.4 0 .7.5.8 1.2 1.5 2 2 .3.2.5.2.7 0l.8-.8c.2-.2.5-.3.8-.1l2.3 1.1c.3.2.4.4.3.8l-.3 1.2c-.1.4-.4.6-.8.8-1 .4-2.3.1-3.6-.5-1.1-.5-2.4-1.4-3.5-2.5-1-1-1.9-2.2-2.4-3.3-.6-1.3-.8-2.6-.4-3.6.1-.4.3-.7.5-.9Z" fill="currentColor" />
    </svg>
  </a>
</div>

<style>
  .whatsapp-widget {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    z-index: var(--z-fixed);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* ── Interactive Advisor Tooltip ────────────────────────────────── */
  .whatsapp-widget__tooltip {
    display: none;
    align-items: center;
    gap: var(--space-2-5);
    background: rgba(10, 17, 40, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 175, 55, 0.4);
    padding: var(--space-2) var(--space-3-5);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-xl);
    text-decoration: none;
    transition: all var(--transition-fast);
    animation: floatTooltip 4s ease-in-out infinite;
  }

  @keyframes floatTooltip {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  @media (min-width: 768px) {
    .whatsapp-widget__tooltip {
      display: inline-flex;
    }
  }

  .whatsapp-widget__tooltip:hover {
    background: #0A1128;
    border-color: #D4AF37;
    transform: scale(1.02);
  }

  .whatsapp-widget__avatar {
    position: relative;
    width: 28px;
    height: 28px;
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: var(--font-extrabold);
  }

  .whatsapp-widget__avatar-dot {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    background-color: #10B981;
    border: 1.5px solid #0A1128;
    border-radius: var(--radius-full);
  }

  .whatsapp-widget__message {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .whatsapp-widget__title {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: #FFFFFF;
  }

  .whatsapp-widget__subtitle {
    font-size: 9.5px;
    color: #F3D375;
  }

  /* ── Main FAB ───────────────────────────────────────────────────── */
  .whatsapp-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background-color: #25D366;
    color: #FFFFFF;
    border-radius: var(--radius-full);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    text-decoration: none;
    flex-shrink: 0;
  }

  .whatsapp-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
    color: #FFFFFF;
  }

  .whatsapp-btn__icon {
    width: 32px;
    height: 32px;
    display: block;
    flex: 0 0 32px;
    position: relative;
    z-index: 2;
  }

  .whatsapp-btn__pulse {
    position: absolute;
    inset: -3px;
    border-radius: var(--radius-full);
    background-color: #25D366;
    animation: whatsappRadar 2.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
    z-index: 1;
  }

  @keyframes whatsappRadar {
    0% {
      transform: scale(0.95);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-btn__pulse,
    .whatsapp-widget__tooltip {
      animation: none;
    }
  }
</style>
