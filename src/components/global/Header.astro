---
/**
 * Header.astro — Global Authority Real Estate Header
 * Features an informational top-bar, sticky glassmorphism navigation,
 * official logo branding, and high-conversion WhatsApp CTA.
 */

import { NAVIGATION, SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import MobileMenu from './MobileMenu.astro';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;
---

<!-- Top Announcement & Verification Bar -->
<div class="top-bar">
  <div class="container top-bar__inner">
    <div class="top-bar__left">
      <span class="top-bar__badge">INFORMATION PORTAL</span>
      <span class="top-bar__text">DHA Phase 6, Main Boulevard, Lahore</span>
    </div>
    <div class="top-bar__right">
      <a href={`tel:${CONTACTS.phone.primary}`} class="top-bar__link">
        <svg class="top-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Helpline: {CONTACTS.phone.display}</span>
      </a>
      <span class="top-bar__divider">|</span>
      <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="top-bar__link top-bar__link--whatsapp">
        <span class="top-bar__live-dot"></span>
        <span>WhatsApp Advisory</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="header" id="site-header">
  <div class="container header__inner">
    <!-- Brand Logo -->
    <a href="/" class="header__logo" aria-label={`${SITE.name} — Home`}>
      <img
        src="/images/logo/logo-white.svg"
        alt={SITE.name}
        width="230"
        height="58"
        loading="eager"
        class="header__logo-img"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Main Navigation">
      <ul class="header__nav-list">
        {
          NAVIGATION.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li class="header__nav-item">
                <a
                  href={item.href}
                  class:list={[
                    'header__nav-link',
                    { 'header__nav-link--active': isActive },
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                  {isActive && <span class="header__nav-indicator" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Header Actions (Desktop) -->
    <div class="header__actions">
      <a href="/search" class="header__search-btn" aria-label="Search Portal" title="Search Properties & Blocks">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--sm">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
        </svg>
        <span>Instant Inquiry</span>
      </a>
      <Button href="/contact" variant="primary" size="sm">
        Book Visit
      </Button>
    </div>

    <!-- Mobile Menu Hamburger Trigger -->
    <button
      class="header__hamburger"
      id="mobile-menu-toggle"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="header__hamburger-bar"></span>
      <span class="header__hamburger-bar"></span>
      <span class="header__hamburger-bar"></span>
    </button>
  </div>

  <MobileMenu />
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add('header--scrolled');
      } else {
        header.classList.remove('header--scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  /* ── Top Announcement Bar ───────────────────────────────────────── */
  .top-bar {
    background: linear-gradient(90deg, rgba(5, 8, 22, 0.98), rgba(10, 17, 40, 0.98));
    color: var(--color-neutral-300);
    font-size: var(--text-xs);
    border-bottom: 1px solid rgba(243, 211, 117, 0.12);
    padding: var(--space-2) 0;
    display: none;
  }

  @media (min-width: 768px) {
    .top-bar {
      display: block;
    }
  }

  .top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .top-bar__left,
  .top-bar__right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .top-bar__badge {
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    font-size: 10px;
    font-weight: var(--font-extrabold);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    letter-spacing: 1px;
  }

  .top-bar__text {
    color: var(--color-neutral-300);
    font-size: var(--text-xs);
  }

  .top-bar__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    color: var(--color-neutral-300);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .top-bar__link:hover {
    color: var(--color-primary-300);
  }

  .top-bar__link--whatsapp {
    color: #34D399;
    font-weight: var(--font-semibold);
  }

  .top-bar__icon {
    width: 13px;
    height: 13px;
    color: var(--color-primary-400);
  }

  .top-bar__divider {
    color: var(--color-neutral-600);
  }

  .top-bar__live-dot {
    width: 7px;
    height: 7px;
    background-color: #10B981;
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px #10B981;
    animation: livePulse 1.5s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  /* ── Main Header ────────────────────────────────────────────────── */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: rgba(10, 17, 40, 0.92);
    backdrop-filter: saturate(1.8) blur(20px);
    -webkit-backdrop-filter: saturate(1.8) blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-header);
    transition: background var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .header--scrolled {
    background: rgba(8, 14, 30, 0.96);
    box-shadow: var(--shadow-header-scrolled);
    border-bottom-color: rgba(243, 211, 117, 0.16);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: var(--space-4);
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    padding: var(--space-1) 0;
  }

  .header__logo-img {
    height: 50px;
    width: auto;
    object-fit: contain;
  }

  .header__nav {
    display: none;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-0-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    position: relative;
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: 13px;
    font-weight: var(--font-semibold);
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    border-radius: var(--radius-full);
    letter-spacing: 0.01em;
    transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }

  .header__nav-link:hover {
    color: #FFFFFF;
    background-color: rgba(243, 211, 117, 0.12);
    transform: translateY(-1px);
  }

  .header__nav-link--active {
    color: #FFFFFF;
    font-weight: var(--font-bold);
    background: rgba(197, 155, 39, 0.18);
    box-shadow: inset 0 0 0 1px rgba(243, 211, 117, 0.18);
  }

  .header__nav-indicator {
    position: absolute;
    bottom: -6px;
    left: 50%;
    width: 18px;
    height: 3px;
    background: var(--gradient-gold);
    border-radius: var(--radius-full);
    transform: translateX(-50%);
  }

  .header__actions {
    display: none;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .header__search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .header__search-btn:hover {
    background-color: rgba(243, 211, 117, 0.16);
    color: #F3D375;
    border-color: rgba(243, 211, 117, 0.22);
    transform: translateY(-1px);
  }

  /* WhatsApp Button */
  .btn--whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    background: linear-gradient(135deg, #14946B 0%, #0C7C59 100%);
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: 0 10px 24px -10px rgba(20, 148, 107, 0.7);
  }

  .btn--whatsapp:hover {
    background: linear-gradient(135deg, #18AC7C 0%, #0F8F67 100%);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 14px 28px -10px rgba(20, 148, 107, 0.8);
  }

  .btn__icon {
    width: 16px;
    height: 16px;
  }

  /* Hamburger Menu Toggle */
  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .header__hamburger:hover {
    background-color: rgba(243, 211, 117, 0.12);
  }

  .header__hamburger-bar {
    width: 100%;
    height: 2.2px;
    background-color: #FFFFFF;
    border-radius: var(--radius-full);
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  /* Desktop View Breakpoints */
  @media (min-width: 1080px) {
    .header__nav {
      display: block;
    }
    .header__actions {
      display: flex;
    }
    .header__hamburger {
      display: none;
    }
  }
</style>
