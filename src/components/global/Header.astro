---
import { NAVIGATION } from '@data/site';
import MobileMenu from './MobileMenu.astro';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="DHA Phase 6 Lahore home">
      <span>D6</span>
      <strong>DHA Phase VI <em>Lahore</em></strong>
    </a>
    <nav aria-label="Main navigation">
      <ul>
        {NAVIGATION.map((item) => (
          <li><a class:list={{ active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }} href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a class="map-link" href="/downloads">Map PDFs</a>
      <button id="mobile-menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
    </div>
  </div>
  <MobileMenu />
</header>

<style>
  .site-header{position:sticky;top:0;z-index:100;background:#071a24;border-bottom:1px solid rgba(255,255,255,.1);box-shadow:0 8px 28px rgba(0,0,0,.22)}
  .site-header__inner{display:flex;height:72px;align-items:center;justify-content:space-between;gap:1rem}
  .brand{display:flex;align-items:center;gap:.7rem;color:#fff;text-decoration:none;white-space:nowrap}.brand>span{display:grid;width:38px;height:38px;place-items:center;border-radius:.3rem;background:#d7af57;color:#102421;font-weight:950}.brand strong{font-size:1rem}.brand em{color:#d7af57;font-style:normal}
  nav{display:none;flex:1}nav ul{display:flex;justify-content:center;gap:.05rem;margin:0;padding:0;list-style:none}nav a{display:block;padding:.72rem .46rem;color:#aebfba;text-decoration:none;font-size:.72rem;font-weight:750;white-space:nowrap}nav a:hover,nav a.active{color:#fff}nav a.active{box-shadow:inset 0 -2px #d7af57}
  .actions{display:flex;align-items:center;gap:.65rem}.map-link{padding:.65rem .85rem;background:#d7af57;color:#102421;text-decoration:none;font-size:.72rem;font-weight:900}
  button{display:flex;width:40px;height:40px;flex-direction:column;justify-content:center;gap:5px;padding:9px;border:1px solid rgba(255,255,255,.18);background:transparent}button span{display:block;height:2px;background:#fff}
  @media(min-width:1200px){nav{display:block}button{display:none}.brand strong{font-size:.92rem}.site-header__inner{max-width:1480px}}
  @media(max-width:480px){.brand strong{font-size:.78rem}.map-link{display:none}}
</style>
