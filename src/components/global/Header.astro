---
/**
 * Header.astro — Global Authority Real Estate Header
 * Features an informational top-bar, sticky glassmorphism navigation,
 * official logo branding, and high-conversion WhatsApp CTA.
 */

import { NAVIGATION, SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import MobileMenu from './MobileMenu.astro';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;
---

<!-- Top Announcement & Verification Bar -->
<div class="top-bar">
  <div class="container top-bar__inner">
    <div class="top-bar__left">
      <span class="top-bar__badge">OFFICIAL PORTAL</span>
      <span class="top-bar__text">Al Rehman Garden Phase 2, Main Sharaqpur Road, Lahore</span>
    </div>
    <div class="top-bar__right">
      <a href={`tel:${CONTACTS.phone.primary}`} class="top-bar__link">
        <svg class="top-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Helpline: {CONTACTS.phone.display}</span>
      </a>
      <span class="top-bar__divider">|</span>
      <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="top-bar__link top-bar__link--whatsapp">
        <span class="top-bar__live-dot"></span>
        <span>WhatsApp Advisory</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="header" id="site-header">
  <div class="container header__inner">
    <!-- Brand Logo -->
    <a href="/" class="header__logo" aria-label={`${SITE.name} — Home`}>
      <img
        src="/images/logo/logo.svg"
        alt={SITE.name}
        width="230"
        height="58"
        loading="eager"
        class="header__logo-img"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Main Navigation">
      <ul class="header__nav-list">
        {
          NAVIGATION.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li class="header__nav-item">
                <a
                  href={item.href}
                  class:list={[
                    'header__nav-link',
                    { 'header__nav-link--active': isActive },
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                  {isActive && <span class="header__nav-indicator" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Header Actions (Desktop) -->
    <div class="header__actions">
      <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--sm">
        <svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
        </svg>
        <span>Instant Inquiry</span>
      </a>
      <Button href="/contact" variant="primary" size="sm">
        Book Visit
      </Button>
    </div>

    <!-- Mobile Menu Hamburger Trigger -->
    <button
      class="header__hamburger"
      id="mobile-menu-toggle"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="header__hamburger-bar"></span>
      <span class="header__hamburger-bar"></span>
      <span class="header__hamburger-bar"></span>
    </button>
  </div>

  <MobileMenu />
</header>

<style>
  /* ── Top Announcement Bar ───────────────────────────────────────── */
  .top-bar {
    background-color: var(--color-secondary-950);
    color: var(--color-neutral-300);
    font-size: var(--text-xs);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-2) 0;
    display: none;
  }

  @media (min-width: 768px) {
    .top-bar {
      display: block;
    }
  }

  .top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .top-bar__left,
  .top-bar__right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .top-bar__badge {
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    font-size: 10px;
    font-weight: var(--font-extrabold);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    letter-spacing: 1px;
  }

  .top-bar__text {
    color: var(--color-neutral-300);
    font-size: var(--text-xs);
  }

  .top-bar__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    color: var(--color-neutral-300);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .top-bar__link:hover {
    color: var(--color-primary-300);
  }

  .top-bar__link--whatsapp {
    color: #34D399;
    font-weight: var(--font-semibold);
  }

  .top-bar__icon {
    width: 13px;
    height: 13px;
    color: var(--color-primary-400);
  }

  .top-bar__divider {
    color: var(--color-neutral-600);
  }

  .top-bar__live-dot {
    width: 7px;
    height: 7px;
    background-color: #10B981;
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px #10B981;
    animation: livePulse 1.5s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  /* ── Main Header ────────────────────────────────────────────────── */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: var(--space-4);
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .header__logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .header__nav {
    display: none;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    position: relative;
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .header__nav-link:hover {
    color: var(--color-secondary-900);
    background-color: var(--color-neutral-100);
  }

  .header__nav-link--active {
    color: var(--color-primary-700);
    font-weight: var(--font-bold);
    background-color: var(--color-primary-50);
  }

  .header__nav-indicator {
    position: absolute;
    bottom: 2px;
    left: var(--space-3);
    right: var(--space-3);
    height: 2px;
    background: var(--gradient-gold);
    border-radius: var(--radius-full);
  }

  .header__actions {
    display: none;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  /* WhatsApp Button */
  .btn--whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    background-color: #059669;
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-3-5);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25);
  }

  .btn--whatsapp:hover {
    background-color: #047857;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
  }

  .btn__icon {
    width: 16px;
    height: 16px;
  }

  /* Hamburger Menu Toggle */
  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: var(--color-neutral-100);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .header__hamburger:hover {
    background-color: var(--color-neutral-200);
  }

  .header__hamburger-bar {
    width: 100%;
    height: 2.2px;
    background-color: var(--color-secondary-900);
    border-radius: var(--radius-full);
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  /* Desktop View Breakpoints */
  @media (min-width: 1080px) {
    .header__nav {
      display: block;
    }
    .header__actions {
      display: flex;
    }
    .header__hamburger {
      display: none;
    }
  }
</style>
