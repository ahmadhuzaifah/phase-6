---
/**
 * Header.astro — Global Authority Real Estate Header
 * Pixel-accurate implementation matching the DHA reference design:
 * [D6] DHA Phase VI Lahore | Home Sectors Properties Places Plots Prices Dealers Map | [Map PDFs]
 */

import { NAVIGATION, SITE } from '@data/site';
import MobileMenu from './MobileMenu.astro';

const currentPath = Astro.url.pathname;
---

<!-- Main Sticky Header -->
<header class="header" id="site-header">
  <div class="container header__inner">
    <!-- Brand Identity: [D6] DHA Phase VI Lahore -->
    <a href="/" class="header__brand" aria-label={`${SITE.name} — Home`}>
      <span class="brand-badge">D6</span>
      <span class="brand-title">
        <span class="brand-title__white">DHA Phase</span>
        <span class="brand-title__gold">VI</span>
        <span class="brand-title__white">Lahore</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Main Navigation">
      <ul class="header__nav-list">
        {
          NAVIGATION.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li class="header__nav-item">
                <a
                  href={item.href}
                  class:list={[
                    'header__nav-link',
                    { 'header__nav-link--active': isActive },
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="header__nav-text">{item.label}</span>
                  {isActive && <span class="header__nav-indicator" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Header Right Action: [Map PDFs] -->
    <div class="header__actions">
      <a href="/downloads" class="btn-map-pdf" title="Download Master Plan Maps & PDFs">
        Map PDFs
      </a>

      <!-- Mobile Menu Hamburger Trigger -->
      <button
        class="header__hamburger"
        id="mobile-menu-toggle"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="header__hamburger-bar"></span>
        <span class="header__hamburger-bar"></span>
        <span class="header__hamburger-bar"></span>
      </button>
    </div>
  </div>

  <MobileMenu />
</header>

<style>
  /* ── Header Container ───────────────────────────────────────────── */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky, 100);
    background: #0d1227;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .header--scrolled {
    background: rgba(11, 15, 33, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgba(229, 184, 66, 0.2);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 24px;
  }

  /* ── Brand Identity: [D6] DHA Phase VI Lahore ───────────────────── */
  .header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .header__brand:hover {
    transform: translateY(-1px);
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #e5b842;
    color: #0c1024;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 15px;
    font-weight: 900;
    border-radius: 9px;
    letter-spacing: -0.5px;
    box-shadow: 0 2px 8px rgba(229, 184, 66, 0.35);
    user-select: none;
  }

  .brand-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }

  .brand-title__white {
    color: #ffffff;
  }

  .brand-title__gold {
    color: #e5b842;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  /* ── Navigation Links ───────────────────────────────────────────── */
  .header__nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
    }
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 10px 14px;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 14.5px;
    font-weight: 500;
    color: #94a3b8;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .header__nav-link:hover {
    color: #ffffff;
  }

  .header__nav-link--active {
    color: #ffffff;
    font-weight: 600;
  }

  .header__nav-indicator {
    position: absolute;
    bottom: -6px;
    left: 14px;
    right: 14px;
    height: 2.5px;
    background: #e5b842;
    border-radius: 2px;
  }

  /* ── Right Action Button: [Map PDFs] ────────────────────────────── */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .btn-map-pdf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #e5b842;
    color: #0c1024;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 14px;
    font-weight: 700;
    padding: 9px 22px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 2px 10px rgba(229, 184, 66, 0.25);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-map-pdf:hover {
    background: #f0c559;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(229, 184, 66, 0.4);
    color: #0c1024;
  }

  /* ── Hamburger Menu Trigger ─────────────────────────────────────── */
  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 38px;
    height: 38px;
    padding: 9px 7px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .header__hamburger:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(229, 184, 66, 0.4);
  }

  .header__hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .header__hamburger[aria-expanded="true"] .header__hamburger-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .header__hamburger[aria-expanded="true"] .header__hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .header__hamburger[aria-expanded="true"] .header__hamburger-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .header__hamburger {
      display: none;
    }
  }
</style>

<script>
  function setupHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;

    const handleScroll = () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 20) {
        header.classList.add('header--scrolled');
      } else {
        header.classList.remove('header--scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile menu toggle
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('mobile-menu--open');
        document.body.classList.toggle('menu-open');
      });
    }
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
