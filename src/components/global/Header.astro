---
import { CONTACTS } from '@data/contacts';
import { NAVIGATION } from '@data/site';
import MobileMenu from './MobileMenu.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href === '/sectors/')
    return currentPath.startsWith('/sectors/') || currentPath.includes('-sector-');
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="DHA Phase 6 Lahore home">
      <span>D6</span>
      <strong>DHA Phase <span>6</span> Lahore</strong>
    </a>

    <nav aria-label="Main navigation" class="desktop-nav">
      <ul class="nav-list">
        {
          NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[{ active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a
        href={CONTACTS.whatsapp.url}
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-nav-btn">WhatsApp</a
      >
      <button
        id="mobile-menu-toggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <MobileMenu />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 10, 26, 0.98);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(18px);
  }
  .site-header__inner {
    display: flex;
    height: 72px;
    max-width: 1440px;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .brand {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.65rem;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand > span {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 0.35rem;
    background: linear-gradient(135deg, #059669, #10b981);
    color: #042014;
    font-size: 0.95rem;
    font-weight: 950;
  }
  .brand strong {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .brand strong span {
    color: #10b981;
  }
  .desktop-nav {
    display: none;
    flex: 1;
  }
  .nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-list a {
    display: flex;
    align-items: center;
    padding: 0.7rem 0.64rem;
    color: #9a9ab5;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s ease;
  }
  .nav-list a:hover {
    color: #fff;
  }
  .nav-list a.active {
    color: #34d399;
  }
  .actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
  }
  .whatsapp-nav-btn {
    padding: 0.58rem 0.95rem;
    border-radius: 0.4rem;
    background: linear-gradient(135deg, #059669, #10b981);
    color: #042014;
    font-size: 0.74rem;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }
  .whatsapp-nav-btn:hover {
    color: #042014;
    filter: brightness(1.08);
  }
  button#mobile-menu-toggle {
    display: flex;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 9px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.4rem;
    background: transparent;
    cursor: pointer;
  }
  button#mobile-menu-toggle span {
    display: block;
    height: 2px;
    background: #fff;
  }
  @media (min-width: 1080px) {
    .desktop-nav {
      display: block;
    }
    button#mobile-menu-toggle {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .whatsapp-nav-btn {
      display: none;
    }
  }
</style>
