---
/**
 * Button.astro — Luxury Polymorphic Button Component
 * Supports multiple luxury visual variants, micro-animations, and full accessible states.
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'outline' | 'ghost' | 'glass';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: '_blank' | '_self';
  rel?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  id?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  target,
  rel = target === '_blank' ? 'noopener noreferrer' : undefined,
  fullWidth = false,
  disabled = false,
  id,
  ariaLabel,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';

const attrs = href
  ? { href, target, rel }
  : { type, disabled };
---

<Tag
  class:list={[
    'btn',
    `btn--${variant}`,
    `btn--${size}`,
    { 'btn--full': fullWidth },
    { 'btn--disabled': disabled },
    className,
  ]}
  id={id}
  aria-label={ariaLabel}
  {...attrs}
>
  <slot name="icon-left" />
  <span class="btn__text"><slot /></span>
  <slot name="icon-right" />
</Tag>

<style is:global>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: var(--font-bold);
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    transition: all var(--transition-fast);
    user-select: none;
  }

  .btn:active {
    transform: translateY(1px);
  }

  /* ── Sizes ──────────────────────────────────────────────────────── */
  .btn--xs {
    padding: var(--space-1) var(--space-2-5);
    font-size: var(--text-xs);
    border-radius: var(--radius-sm);
  }

  .btn--sm {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
  }

  .btn--md {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    border-radius: var(--radius-md);
  }

  .btn--lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    border-radius: var(--radius-lg);
  }

  .btn--xl {
    padding: var(--space-5) var(--space-10);
    font-size: var(--text-xl);
    border-radius: var(--radius-xl);
  }

  /* ── Variants ───────────────────────────────────────────────────── */
  /* Primary: Luxury Gold Gradient */
  .btn--primary {
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    border-color: rgba(212, 175, 55, 0.6);
    box-shadow: var(--shadow-gold-subtle);
  }

  .btn--primary:hover {
    background: linear-gradient(135deg, #FBE08B 0%, #D4AF37 50%, #997515 100%);
    box-shadow: var(--shadow-gold-glow);
    transform: translateY(-2px);
    color: var(--color-secondary-950);
  }

  /* Secondary: Deep Royal Navy */
  .btn--secondary {
    background: var(--color-secondary-900);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: var(--shadow-sm);
  }

  .btn--secondary:hover {
    background: var(--color-secondary-800);
    border-color: var(--color-primary-400);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: #FFFFFF;
  }

  /* Accent: High Conversion Emerald (WhatsApp / Booking) */
  .btn--accent {
    background-color: var(--color-accent-600);
    color: #FFFFFF;
    border-color: var(--color-accent-500);
    box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
  }

  .btn--accent:hover {
    background-color: var(--color-accent-700);
    box-shadow: var(--shadow-emerald-glow);
    transform: translateY(-2px);
    color: #FFFFFF;
  }

  /* Outline: Gold Border */
  .btn--outline {
    background-color: transparent;
    color: var(--color-primary-300);
    border: 1.5px solid var(--color-primary-500);
  }

  .btn--outline:hover {
    background-color: rgba(212, 168, 68, 0.12);
    border-color: var(--color-primary-300);
    color: var(--color-primary-300);
    transform: translateY(-2px);
  }

  /* Ghost: Clean transparent */
  .btn--ghost {
    background-color: transparent;
    color: var(--text-secondary);
    border-color: transparent;
  }

  .btn--ghost:hover {
    background-color: var(--color-neutral-100);
    color: var(--text-primary);
  }

  /* Glass: Frosted Acrylic */
  .btn--glass {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .btn--glass:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(243, 211, 117, 0.6);
    color: #F3D375;
    transform: translateY(-2px);
  }

  /* ── Modifiers ──────────────────────────────────────────────────── */
  .btn--full {
    width: 100%;
  }

  .btn--disabled {
    opacity: 0.55;
    pointer-events: none;
    cursor: not-allowed;
  }
</style>
