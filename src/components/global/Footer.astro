---
import { CONTACTS } from '@data/contacts';
import { SITE } from '@data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-callout">
    <div class="container">
      <div>
        <small>Independent buyer support</small><strong
          >Compare the market, then verify the property.</strong>
      </div>
      <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer"
        >WhatsApp {CONTACTS.phone.display}</a
      >
    </div>
  </div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/"><span>D6</span><strong>DHA Phase VI Lahore</strong></a>
      <p>{SITE.description}</p>
      <p class="notice">
        This is an independent information platform and is not an official DHA Lahore website.
      </p>
    </div>
    <div>
      <h2>Explore</h2>
      <a href="/dha-phase-6-lahore-guide/">Complete area guide</a>
      <a href="/houses/">Houses</a>
      <a href="/commercial/">Commercial property</a>
      <a href="/dha-phase-6-lahore-prices/">Property prices</a>
      <a href="/dha-phase-6-property-prices/">Price intelligence</a>
      <a href="/best-sector-to-invest-in-dha-phase-6-lahore/">Investment research</a>
      <a href="/highest-return-sector-dha-phase-6-lahore/">Return analysis</a>
      <a href="/dha-phase-6-lahore-rental-income-guide/">Rental income guide</a>
      <a href="/dha-phase-6-lahore-property-appreciation/">Appreciation guide</a>
      <a href="/guides/">Buyer guides</a>
      <a href="/dha-phase-6-lahore-sectors/">Sector overview</a>
      <a href="/5-marla-plots-dha-phase-6-lahore/">5 Marla plots guide</a>
      <a href="/blog/">Blog</a>
      <a href="/contact/">Contact</a>
    </div>
    <div>
      <h2>Property</h2>
      <a href="/dha-phase-6-lahore/">Master Authority Guide</a>
      <a href="/dha-phase-6-property-market/">Market Intelligence</a>
      <a href="/compare-properties/">Compare Properties</a>
      <a href="/dha-phase-6-best-properties/">Curated Best Properties</a>
      <a href="/search-property/">Search properties</a>
      <a href="/houses-for-sale-dha-phase-6-lahore/">Houses for sale</a>
      <a href="/plots-for-sale-dha-phase-6-lahore/">Plots for sale</a>
      <a href="/dha-phase-6-commercial-areas/">Commercial areas</a>
      <a href="/places/dha-phase-6-schools/">Schools directory</a>
      <a href="/places/dha-phase-6-hospitals/">Hospitals directory</a>
      <a href="/places/dha-phase-6-restaurants/">Restaurants directory</a>
      <a href="/property-advisor/">Property Advisor Assistant</a>
      <a href="/find-my-property/">Find my property</a>
      <a href="/search/">Search the directory</a>
      <a href="/dha-phase-6-property-calculator/">Calculators</a>
    </div>
    <div>
      <h2>Research</h2>
      <a href="/dha-phase-6-market-updates/">Live Market Updates</a>
      <a href="/dha-phase-6-sector-ranking/">Sector Ranking Matrix</a>
      <a href="/why-dha-phase-6-lahore/">Why DHA Phase 6</a>
      <a href="/dha-phase-6-sector-comparison/">Sector Comparison</a>
      <a href="/dha-phase-6-faq/">100+ FAQ Database</a>
      <a href="/dha-phase-6-market-analysis/">2026 Market Analysis</a>
      <a href="/entities/">Sector Entity Profiles</a>
      <a href="/authors/">Research Team</a>
      <a href="/gallery/">Area gallery</a>
      <a href="/how-we-collect-property-data/">Data Verification</a>
      <a href="/property-verification-methodology/">Verification Methodology</a>
      <a href="/editorial-policy/">Editorial Policy</a>
      <a href="/about/">About this portal</a>
    </div>
    <div>
      <h2>Contact</h2>
      <a href={`tel:${CONTACTS.phone.primary}`}>{CONTACTS.phone.display}</a>
      <a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a>
      <span>{CONTACTS.address.short}</span>
      <a href="/contact">Property desk</a>
      <a href="/downloads">Official resource links</a>
    </div>
  </div>
  <div class="container legal">
    <p>
      Property records and rates are unverified asking-price research, not transaction evidence.
      Verify title, seller authority, dues, condition and transfer requirements independently
      through DHA Lahore and appropriate advisers.
    </p>
    <div>
      <span>&copy; {year} {SITE.name}</span><a href="/sitemap">Sitemap</a><a href="/privacy-policy"
        >Privacy</a
      ><a href="/terms-and-conditions">Terms</a><a href="/disclaimer">Disclaimer</a><a
        href="/copyright-policy">Copyright</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #111128;
    color: #9a9ab5;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-callout {
    background: linear-gradient(135deg, #059669, #10b981);
    color: #042014;
  }
  .footer-callout .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }
  .footer-callout small,
  .footer-callout strong {
    display: block;
  }
  .footer-callout small {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer-callout strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .footer-callout a {
    padding: 0.7rem 0.9rem;
    background: #0a0a1a;
    color: #fff;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 900;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.7fr repeat(4, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
  }
  .footer-brand > a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
    text-decoration: none;
  }
  .footer-brand > a span {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    background: linear-gradient(135deg, #059669, #10b981);
    color: #042014;
    font-weight: 950;
  }
  .footer-brand p {
    max-width: 440px;
    line-height: 1.7;
  }
  .notice {
    color: #34d399;
    font-size: 0.78rem;
  }
  .footer-grid h2 {
    margin: 0 0 1rem;
    color: #fff;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer-grid > div:not(:first-child) {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer-grid a {
    color: #9a9ab5;
    text-decoration: none;
    font-size: 0.84rem;
  }
  .footer-grid a:hover {
    color: #34d399;
  }
  .footer-grid span {
    font-size: 0.84rem;
  }
  .legal {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .legal > p {
    max-width: 950px;
    margin: 0 0 1.2rem;
    font-size: 0.72rem;
    line-height: 1.65;
    color: #6a6a85;
  }
  .legal > div {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .legal a,
  .legal span {
    color: #85859f;
    font-size: 0.7rem;
    text-decoration: none;
  }
  .legal span {
    margin-right: auto;
  }
  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1.5fr repeat(2, 1fr);
    }
    .footer-brand {
      grid-row: span 2;
    }
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-row: auto;
      grid-column: 1/-1;
    }
    .footer-callout .container {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-brand {
      grid-column: auto;
    }
    .footer-callout a {
      width: 100%;
      text-align: center;
    }
    .legal span {
      width: 100%;
    }
  }
</style>
