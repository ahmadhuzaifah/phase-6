---
import { CONTACTS } from '@data/contacts';
import { SITE } from '@data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-callout">
    <div class="container">
      <div><small>Independent buyer support</small><strong>Compare the market, then verify the property.</strong></div>
      <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer">WhatsApp {CONTACTS.phone.display}</a>
    </div>
  </div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/"><span>D6</span><strong>DHA Phase VI Lahore</strong></a>
      <p>{SITE.description}</p>
      <p class="notice">This is an independent information platform and is not an official DHA Lahore website.</p>
    </div>
    <div>
      <h2>Property</h2>
      <a href="/properties">Market snapshots</a>
      <a href="/search-property">Search properties</a>
      <a href="/plots">Plots</a>
      <a href="/houses">Houses</a>
      <a href="/commercial">Commercial</a>
      <a href="/dha-phase-6-property-calculator">Calculators</a>
      <a href="/dha-phase-6-lahore-prices">Price guide</a>
    </div>
    <div>
      <h2>Research</h2>
      <a href="/dha-phase-6-lahore-guide">Knowledge Hub</a>
      <a href="/sectors">Sector directory</a>
      <a href="/best-sector-in-dha-phase-6-lahore">Best sectors</a>
      <a href="/blog">Real estate blog</a>
      <a href="/dha-phase-6-lahore-map">Map guide</a>
      <a href="/places">Places directory</a>
      <a href="/construction">Construction</a>
      <a href="/guides">Buyer guides</a>
      <a href="/about">About this portal</a>
    </div>
    <div>
      <h2>Contact</h2>
      <a href={`tel:${CONTACTS.phone.primary}`}>{CONTACTS.phone.display}</a>
      <a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a>
      <span>{CONTACTS.address.short}</span>
      <a href="/contact">Property desk</a>
      <a href="/downloads">Official resource links</a>
    </div>
  </div>
  <div class="container legal">
    <p>Property records and rates are unverified asking-price research, not transaction evidence. Verify title, seller authority, dues, condition and transfer requirements independently through DHA Lahore and appropriate advisers.</p>
    <div><span>&copy; {year} {SITE.name}</span><a href="/sitemap">Sitemap</a><a href="/privacy-policy">Privacy</a><a href="/terms-and-conditions">Terms</a><a href="/disclaimer">Disclaimer</a><a href="/copyright-policy">Copyright</a></div>
  </div>
</footer>

<style>
  .site-footer{background:#111128;color:#9a9ab5;border-top:1px solid rgba(255,255,255,.08)}.footer-callout{background:linear-gradient(135deg,#059669,#10b981);color:#042014}.footer-callout .container{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding-top:1.25rem;padding-bottom:1.25rem}.footer-callout small,.footer-callout strong{display:block}.footer-callout small{font-size:.65rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.footer-callout strong{font-family:var(--font-display);font-size:1.2rem}.footer-callout a{padding:.7rem .9rem;background:#0a0a1a;color:#fff;text-decoration:none;font-size:.75rem;font-weight:900}
  .footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:clamp(2rem,6vw,6rem);padding-top:4.5rem;padding-bottom:3.5rem}.footer-brand>a{display:flex;align-items:center;gap:.7rem;color:#fff;text-decoration:none}.footer-brand>a span{display:grid;width:40px;height:40px;place-items:center;background:linear-gradient(135deg,#059669,#10b981);color:#042014;font-weight:950}.footer-brand p{max-width:440px;line-height:1.7}.notice{color:#34d399;font-size:.78rem}.footer-grid h2{margin:0 0 1rem;color:#fff;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}.footer-grid>div:not(:first-child){display:flex;flex-direction:column;gap:.7rem}.footer-grid a{color:#9a9ab5;text-decoration:none;font-size:.84rem}.footer-grid a:hover{color:#34d399}.footer-grid span{font-size:.84rem}
  .legal{padding-top:1.5rem;padding-bottom:2rem;border-top:1px solid rgba(255,255,255,.08)}.legal>p{max-width:950px;margin:0 0 1.2rem;font-size:.72rem;line-height:1.65;color:#6a6a85}.legal>div{display:flex;flex-wrap:wrap;gap:1rem}.legal a,.legal span{color:#85859f;font-size:.7rem;text-decoration:none}.legal span{margin-right:auto}
  @media(max-width:860px){.footer-grid{grid-template-columns:1fr 1fr}.footer-brand{grid-column:1/-1}.footer-callout .container{align-items:flex-start;flex-direction:column;gap:.8rem}}
  @media(max-width:520px){.footer-grid{grid-template-columns:1fr}.footer-brand{grid-column:auto}.footer-callout a{width:100%;text-align:center}.legal span{width:100%}}
</style>
