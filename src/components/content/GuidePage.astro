---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';

interface Fact { label: string; value: string }
interface Section { heading: string; paragraphs: string[]; bullets?: string[] }
interface FAQ { question: string; answer: string }
interface Source { label: string; href: string }

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  eyebrow?: string;
  updated?: string;
  facts?: Fact[];
  sections: Section[];
  faqs?: FAQ[];
  sources?: Source[];
}

const {
  title,
  metaTitle = title,
  description,
  eyebrow = 'Independent DHA Phase 6 Lahore guide',
  updated = '2 September 2026',
  facts = [],
  sections,
  faqs = [],
  sources = [],
} = Astro.props;

const faqSchema = {
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const breadcrumbSchema = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: title, item: new URL(Astro.url.pathname, SITE.url).toString() },
  ],
};
---

<PageLayout title={metaTitle} description={description}>
  <Schema type="BreadcrumbList" data={breadcrumbSchema} />
  {faqs.length > 0 && <Schema type="FAQPage" data={faqSchema} />}

  <main class="guide-page">
    <header class="guide-hero">
      <div class="container guide-hero__inner">
        <nav aria-label="Breadcrumb" class="guide-breadcrumb"><a href="/">Home</a><span>/</span><span>{title}</span></nav>
        <p class="guide-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="guide-lead">{description}</p>
        <p class="guide-updated">Reviewed {updated}</p>
      </div>
    </header>

    {facts.length > 0 && (
      <section class="fact-band" aria-label="Quick facts">
        <div class="container fact-grid">
          {facts.map((fact) => <div><span>{fact.label}</span><strong>{fact.value}</strong></div>)}
        </div>
      </section>
    )}

    <section class="guide-content">
      <div class="container guide-layout">
        <article class="guide-article">
          {sections.map((section) => (
            <section class="guide-section">
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
            </section>
          ))}

          {faqs.length > 0 && (
            <section class="guide-section" id="faqs">
              <p class="guide-kicker">Common questions</p>
              <h2>Frequently asked questions</h2>
              <div class="faq-stack">
                {faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
              </div>
            </section>
          )}

          {sources.length > 0 && (
            <section class="guide-section source-list">
              <p class="guide-kicker">Research notes</p>
              <h2>Sources and verification links</h2>
              <p>External links are provided for checking source material. Their content can change after this page is reviewed.</p>
              <ul>{sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul>
            </section>
          )}
        </article>

        <aside class="guide-aside">
          <p class="guide-kicker">Start here</p>
          <h2>Research before you commit</h2>
          <p>Shortlist by sector, compare asking prices, inspect the site, then verify ownership, dues and transfer requirements through DHA Lahore.</p>
          <a class="aside-link" href="/properties">Browse market snapshots</a>
          <a class="aside-link" href="/dha-phase-6-lahore-map">Open the map guide</a>
          <a class="aside-link" href="/verification-and-transfer">Use the verification checklist</a>
          <a class="aside-cta" href="/contact">Contact the property desk</a>
        </aside>
      </div>
    </section>

    <section class="independent-notice">
      <div class="container">
        <strong>Independent platform notice</strong>
        <p>This website is an independent information platform. Always verify property details, documents, rates, and official information through DHA Lahore.</p>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .guide-page { background: #0a0a1a; color: #f0f0f5; }
  .guide-hero { padding: clamp(4.5rem, 10vw, 8rem) 0 4.5rem; background: radial-gradient(circle at 88% 0%, #25254d 0, #111128 38%, #0a0a1a 76%); color: #fff; border-bottom: 1px solid rgba(212,168,68,.18); }
  .guide-hero__inner { max-width: 980px; }
  .guide-breadcrumb { display: flex; gap: .6rem; align-items: center; margin-bottom: 2.75rem; color: #9a9ab5; font-size: .82rem; }
  .guide-breadcrumb a { color: #f0c95c; }
  .guide-eyebrow,.guide-kicker { margin: 0 0 .75rem; color: #d4a844; font-size: .73rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .guide-hero h1 { max-width: 850px; margin: 0; color: #fff; font-family: var(--font-display); font-size: clamp(2.55rem, 7vw, 5.8rem); line-height: .98; letter-spacing: -.035em; }
  .guide-lead { max-width: 760px; margin: 1.6rem 0 0; color: #9a9ab5; font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.7; }
  .guide-updated { margin: 1.4rem 0 0; color: #6a6a85; font-size: .8rem; }
  .fact-band { background: linear-gradient(135deg,#d4a844,#f0c95c); color: #0a0a1a; }
  .fact-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(170px,1fr)); }
  .fact-grid div { padding: 1.35rem 1rem; border-right: 1px solid rgba(10,10,26,.18); }
  .fact-grid span,.fact-grid strong { display: block; }
  .fact-grid span { margin-bottom: .25rem; font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; opacity: .72; }
  .fact-grid strong { font-family: var(--font-display); font-size: 1.12rem; }
  .guide-content { padding: clamp(3.5rem,8vw,7rem) 0; }
  .guide-layout { display: grid; grid-template-columns: minmax(0,1fr) 310px; gap: clamp(2.5rem,6vw,6rem); align-items: start; }
  .guide-article { max-width: 790px; }
  .guide-section { margin-bottom: 4rem; }
  .guide-section h2 { margin: 0 0 1.25rem; font-family: var(--font-display); font-size: clamp(1.8rem,4vw,2.65rem); color: #f0f0f5; }
  .guide-section p,.guide-section li { color: #9a9ab5; line-height: 1.82; }
  .guide-section ul { padding-left: 1.25rem; }
  .guide-section li { margin-bottom: .65rem; }
  .guide-aside { position: sticky; top: 100px; padding: 2rem; background: linear-gradient(145deg,#161635,#111128); color: #fff; border: 1px solid rgba(255,255,255,.08); border-top: 5px solid #d4a844; box-shadow: 0 22px 55px rgba(0,0,0,.28); }
  .guide-aside h2 { margin: 0 0 1rem; color: #fff; font-family: var(--font-display); font-size: 1.8rem; }
  .guide-aside p { color: #9a9ab5; line-height: 1.65; }
  .aside-link,.aside-cta { display: block; padding: .8rem 0; color: #f0c95c; border-bottom: 1px solid rgba(255,255,255,.1); text-decoration: none; font-weight: 700; }
  .aside-cta { margin-top: 1.3rem; padding: .9rem 1rem; background: linear-gradient(135deg,#d4a844,#f0c95c); color: #0a0a1a; border: 0; text-align: center; }
  .faq-stack details { margin-bottom: .8rem; padding: 1.1rem 1.25rem; background: #161635; border: 1px solid rgba(255,255,255,.08); }
  .faq-stack summary { cursor: pointer; color: #f0f0f5; font-weight: 800; }
  .faq-stack p { margin-bottom: 0; }
  .source-list a { color: #d4a844; font-weight: 700; }
  .independent-notice { padding: 2rem 0; background: #111128; color: #fff; border-top: 1px solid rgba(212,168,68,.18); }
  .independent-notice .container { display: grid; grid-template-columns: 230px 1fr; gap: 2rem; align-items: baseline; }
  .independent-notice strong { color: #f0c95c; }
  .independent-notice p { margin: 0; color: #9a9ab5; }
  @media (max-width: 820px) { .guide-layout { grid-template-columns: 1fr; } .guide-aside { position: static; } .independent-notice .container { grid-template-columns: 1fr; gap: .5rem; } }
</style>
