---
import RequestPropertyForm from '@components/property/RequestPropertyForm.astro';
import Schema from '@components/seo/Schema.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@data/site';

interface Row { factor: string; reading: string; implication: string }
interface FAQ { question: string; answer: string }
interface Props { title: string; metaTitle: string; description: string; canonicalPath: string; eyebrow: string; thesis: string; audience: string; opportunity: string; primaryRisk: string; indicators: string[]; pros: string[]; cons: string[]; rows: Row[]; faqs: FAQ[] }
const { title, metaTitle, description, canonicalPath, eyebrow, thesis, audience, opportunity, primaryRisk, indicators, pros, cons, rows, faqs } = Astro.props;
const canonical = `${SITE.url}${canonicalPath}/`;
const sharedSections = [
  { heading: 'Build a comparable evidence set before forming a view', text: `Serious property research starts with comparability. A house, residential plot, commercial plot and rental unit respond to different demand drivers, so their asking prices should never be mixed into one average. Within a category, normalize size units, purpose, construction condition, sector, street category and check date. Remove obvious duplicates and retain the source URL so every observation can be revisited. A useful shortlist contains enough alternatives to show a range, not just the cheapest and most expensive advertisements. It should also identify records that have remained unchanged for long periods, because stale advertisements can distort both price and availability. The market tables on this page are orientation tools. They help frame questions, but they do not establish a transaction value for any individual property.` },
  { heading: 'Inspect the micro-location, not only the sector label', text: `Sector-level comparisons are convenient, but value is often decided at street level. During a site visit, record approach roads, carriageway condition, street width, traffic, noise, drainage, plot orientation, neighboring construction, overhead infrastructure, park edges, commercial activity and the distance to an operational gate. Visit at more than one time of day. A route that feels easy on a quiet afternoon may behave differently during school or office peaks. For houses, compare sunlight, ventilation, parking, privacy and evidence of water ingress. For plots, examine level differences, boundaries, access and visible utility constraints. Mark every observation on a map and attach it to the exact property ID; otherwise impressions from several visits can become mixed and lead to a false premium or discount.` },
  { heading: 'Separate asking price, negotiated price and documented value', text: `An advertised demand is the seller or marketer's opening position. A negotiated price is private unless both parties disclose it, while a documented value may refer to a registry, tax or institutional purpose that follows a different methodology. Treating these figures as interchangeable creates false precision. Ask when the demand was last reconfirmed, whether the property is genuinely available, which inclusions are part of the offer and whether any dues or charges remain. Compare on a per-unit basis only after correcting for category and quality. A low demand can indicate urgency, a documentation complication, inferior positioning or simply an outdated advertisement. A high demand can reflect premium characteristics or optimism. Neither should be accepted without evidence, physical inspection and an independent review of documents.` },
  { heading: 'Model cash flow with conservative assumptions', text: `Investment analysis should include more than the purchase amount. Build a cash requirement covering transfer-related charges, taxes, professional advice, documentation, repairs, furnishing, vacancy, brokerage where applicable and an emergency reserve. For rental scenarios, use a conservative achievable rent rather than the highest advertised rent, then deduct vacancy, maintenance, major replacements and management effort. Test at least three cases: a base case, a downside case with slower resale or lower rent, and an upside case that still avoids guaranteed appreciation. Record the holding period and the date of every assumption. If the investment works only when rent is uninterrupted, resale is immediate or prices rise rapidly, the margin of safety is weak. A decision should remain manageable when timing and costs move against the original forecast.` },
  { heading: 'Verify ownership, authority, dues and transfer eligibility', text: `No market score replaces legal and administrative checks. Match the seller's identity and authority with original documents, confirm the exact property reference, and use current DHA Lahore procedures to investigate ownership, outstanding dues, restrictions, NDC requirements and transfer eligibility. Where a representative acts for an owner, obtain qualified advice on the authority being relied upon. Do not treat a portal badge, source link, photocopy, screenshot or verbal assurance as proof of title. Keep written records of representations and payments, use traceable channels, and understand refund conditions before paying a token. Requirements and charges can change, so verify them close to the intended transaction date. Complex ownership, inheritance, corporate, financing or overseas-owner circumstances deserve independent legal and tax advice before any commitment.` },
  { heading: 'Assess construction and replacement-cost exposure', text: `A completed house combines land value with a depreciating and maintenance-intensive structure. Inspect foundations where visible, settlement signs, roof and terrace drainage, waterproofing, plumbing pressure, electrical capacity, HVAC provision, joinery, finishes, approved drawings and alterations. Ask for construction and maintenance records where available. A visually impressive interior can conceal expensive building-services work, while an older but well-maintained house may offer better utility. Estimate immediate repairs and medium-term replacements separately. For a plot-versus-build decision, compare the time, approvals, supervision, escalation risk and temporary accommodation involved in construction. Replacement cost can support asking expectations, but buyers should not automatically reimburse every design choice or luxury finish at its original cost.` },
  { heading: 'Measure liquidity and define an exit plan', text: `Return is incomplete without liquidity. Estimate how many genuinely comparable options are available, how frequently source records change, who the likely future buyer or tenant would be, and what compromises might be required for a timely exit. Standard sizes and practical layouts may have broader audiences, while unusually large, highly customized or narrowly positioned properties can take longer to match with a buyer. Write an exit plan before purchase: target holding period, acceptable discount, likely marketing channels, documentation that must remain current and improvements that could increase usability. Consider what happens if a sale takes twice as long as expected. A property can be attractive on paper yet unsuitable for an investor who may need accessible capital on short notice.` },
  { heading: 'Monitor evidence after purchase instead of chasing headlines', text: `Property management continues after transfer. Maintain a dated file of comparable asking prices, local development changes, service quality, rental enquiries, maintenance expenditure and official notices. Review the thesis periodically and distinguish a broad market shift from a temporary advertising pattern. Headlines about a new road, mall or policy should be tested against implementation, access and actual user behavior. Do not reset expectations because of one exceptional advertisement. A disciplined review asks whether the original audience still exists, whether carrying costs changed, whether the property remains competitive and whether a different use is permitted and practical. This evidence also improves future negotiations because the owner can explain condition, upgrades and market context without relying on unsupported claims.` },
];
const topicSections = [
  { heading: 'The investment question this guide answers', text: `${thesis} The purpose is not to name a universally winning location. It is to establish a repeatable decision framework for ${audience}. A useful answer must connect the buyer's budget, intended use, holding period, tolerance for vacancy or construction, and required liquidity with evidence from comparable active records. ${opportunity} The conclusion should therefore be conditional: a sector or property is attractive only when its specific advantages matter to the intended user and the acquisition price leaves room for uncertainty.` },
  { heading: 'Opportunity and demand interpretation', text: `${opportunity} Demand should be inferred from several signals rather than a marketing label. Review the number of current comparable records, source-check recency, apparent turnover, rental enquiries where relevant, completed construction, daily amenity use and ease of access. Strong advertising volume can mean active demand, but it can also mean abundant supply. Thin inventory can indicate scarcity or simply limited activity. Compare changes over time and investigate the reason behind each pattern. The goal is to understand who is competing for the property and why, then decide whether that audience is durable enough for the proposed holding period.` },
  { heading: 'Principal risks and how to control them', text: `${primaryRisk} Risk control begins before negotiation. Define evidence that would cause the buyer to reduce the offer, require a condition, seek specialist advice or walk away. Budget for delays and keep enough liquidity to avoid a forced sale. Verify material claims with the appropriate source instead of asking the same intermediary to validate their own representation. Diversify assumptions: do not rely simultaneously on uninterrupted rent, rapid appreciation and an immediate exit. When uncertainty cannot be resolved, reflect it in price and transaction structure rather than replacing it with confidence. No ranking, forecast or past performance can remove property-specific legal, physical and market risk.` },
  { heading: 'Signals worth tracking', text: `The most useful monitoring signals for this topic are ${indicators.join(', ')}. Give each signal a date, source and interpretation. Separate an announced project from a completed one, an advertised rent from a collected rent, and a seller's demand from an independently supported range. Track both positive and negative evidence. If travel access improves but traffic noise also rises, record both effects. If commercial activity expands but parking becomes constrained, evaluate the net effect for the target user. A balanced evidence log prevents confirmation bias and makes future updates more useful than a single confident forecast.` },
];
const checklist = ['Define purpose, budget, holding period and required liquidity.', 'Shortlist genuinely comparable properties and retain source dates.', 'Visit each exact location in daylight and during a busy period.', 'Check access, street category, orientation, utilities and neighboring uses.', 'Inspect construction with an appropriately qualified professional.', 'Confirm seller identity, authority, ownership trail, dues and restrictions.', 'Verify the current DHA Lahore transfer and NDC process.', 'Model acquisition costs, repairs, vacancy and downside scenarios.', 'Document negotiation assumptions and token refund conditions.', 'Keep an evidence file and review the investment thesis periodically.'];
---

<PageLayout title={metaTitle} description={description} canonical={canonical}>
  <Schema type="BreadcrumbList" data={{ itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url }, { '@type': 'ListItem', position: 2, name: title, item: canonical }] }} />
  <Schema type="FAQPage" data={{ mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }} />
  <main class="authority-guide"><header><div class="container"><nav><a href="/">Home</a><span>/</span><span>{title}</span></nav><p>{eyebrow}</p><h1>{title}</h1><div><span>{description}</span><small>Reviewed 8 September 2026</small></div></div></header>
    <div class="container guide-body"><article>
      {[...topicSections, ...sharedSections].map((section) => <section><h2>{section.heading}</h2><p>{section.text}</p></section>)}
      <section><h2>Market interpretation table</h2><div class="table-wrap"><table><thead><tr><th>Factor</th><th>Current reading</th><th>Investor implication</th></tr></thead><tbody>{rows.map((row) => <tr><td><strong>{row.factor}</strong></td><td>{row.reading}</td><td>{row.implication}</td></tr>)}</tbody></table></div></section>
      <section><h2>Potential advantages</h2><ul class="pros">{pros.map((item) => <li>{item}</li>)}</ul><h2>Constraints and trade-offs</h2><ul class="cons">{cons.map((item) => <li>{item}</li>)}</ul></section>
      <section><h2>Buyer and investor action checklist</h2><p>Use this sequence as a minimum research record. Adapt it with qualified legal, tax, engineering and valuation advice appropriate to the transaction.</p><ol class="checklist">{checklist.map((item) => <li>{item}</li>)}</ol></section>
      <section><h2>Frequently asked questions</h2><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
    </article><aside><span>Research pathway</span><h2>Continue with live evidence</h2><a href="/dha-phase-6-property-market/">Market intelligence</a><a href="/dha-phase-6-property-prices/">Price trends</a><a href="/compare-properties/">Compare properties</a><a href="/properties/">Active records</a><a href="/places/">Nearby places</a><a href="/verification-and-transfer/">Verification checklist</a></aside></div>
    <div class="container form-wrap"><RequestPropertyForm /></div>
  </main>
</PageLayout>

<style>
  .authority-guide{background:#080f12;color:#e8f0ed}.authority-guide>header{padding:7rem 0 3.2rem;border-bottom:1px solid rgba(48,196,135,.18);background:radial-gradient(circle at 84% 55%,rgba(227,184,90,.11),transparent 25rem),linear-gradient(110deg,#071113,#0b2421)}header nav{display:flex;gap:.55rem;margin-bottom:1.4rem;color:#71847d;font-size:.72rem}header nav a{color:#99aca5}header>div>p{margin:0 0 .55rem;color:#30c487;font-size:.67rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}header h1{max-width:940px;margin:0;color:#fff;font-family:var(--font-display,Georgia,serif);font-size:clamp(2.4rem,5.7vw,4.8rem);line-height:1.02}header>div>div{display:flex;max-width:930px;align-items:end;justify-content:space-between;gap:2rem;margin-top:1.35rem;color:#96a9a2;line-height:1.7}header>div>div span{max-width:730px}header small{color:#667a72;white-space:nowrap}.guide-body{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(2rem,6vw,5rem);align-items:start;padding-top:4rem;padding-bottom:2rem}.guide-body article{max-width:820px}.guide-body article>section{margin-bottom:3.5rem}.guide-body h2{margin:0 0 1rem;color:#eef5f2;font-family:var(--font-display,Georgia,serif);font-size:clamp(1.45rem,3vw,2.2rem)}.guide-body p,.guide-body li,.guide-body td{color:#91a49d;line-height:1.82}.guide-body aside{position:sticky;top:95px;padding:1.4rem;border:1px solid rgba(48,196,135,.22);border-radius:7px;background:#0e1d20}.guide-body aside>span{color:#45d29a;font-size:.62rem;font-weight:850;text-transform:uppercase}.guide-body aside h2{font-size:1.35rem}.guide-body aside a{display:block;padding:.7rem 0;border-bottom:1px solid rgba(185,215,202,.12);color:#9fb2ab;font-size:.72rem}.guide-body aside a:hover{color:#4fd69e}.table-wrap{overflow-x:auto;border:1px solid rgba(185,215,202,.14)}table{width:100%;border-collapse:collapse;font-size:.75rem}th,td{padding:.8rem;border-bottom:1px solid rgba(185,215,202,.11);text-align:left}th{background:#122326;color:#69cba5;font-size:.6rem;text-transform:uppercase}td strong{color:#dfe8e4}.pros,.cons{display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem;padding:0;list-style:none}.pros li,.cons li{padding:.8rem;border:1px solid rgba(48,196,135,.16);border-radius:5px;background:#0d1b1e;font-size:.74rem}.cons li{border-color:rgba(227,184,90,.17)}.checklist{counter-reset:item;display:grid;gap:.6rem;padding:0;list-style:none}.checklist li{padding:.8rem 1rem;border-left:2px solid #30c487;background:#0d1b1e;font-size:.76rem}.faq-list details{margin-bottom:.6rem;padding:1rem;border:1px solid rgba(185,215,202,.13);background:#0d1b1e}.faq-list summary{color:#dfe8e4;font-weight:800;cursor:pointer}.faq-list p{font-size:.78rem}.form-wrap{padding-bottom:5rem}@media(max-width:850px){.guide-body{grid-template-columns:1fr}.guide-body aside{position:static;order:-1}header>div>div{align-items:flex-start;flex-direction:column}}@media(max-width:520px){.authority-guide>header{padding-top:6rem}.pros,.cons{grid-template-columns:1fr}}
</style>
