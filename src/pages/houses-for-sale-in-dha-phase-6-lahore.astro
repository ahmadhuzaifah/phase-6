---
/**
 * DHA Phase 6 Lahore — Houses for Sale High-Intent Search Landing Page (Phase 10.15 Task 2)
 * Route: /houses-for-sale-in-dha-phase-6-lahore/
 */
import PageLayout from '@layouts/PageLayout.astro';
import propertiesRaw from '@data/properties-import.json';
import { SECTORS_DIRECTORY } from '@data/places/index';
import { SITE } from '@data/site';

const canonical = `${SITE.url}/houses-for-sale-in-dha-phase-6-lahore/`;
const pageTitle = 'Houses for Sale in DHA Phase 6 Lahore — Verified Villas & Designer Homes';
const metaDesc = 'Explore verified houses for sale in DHA Phase 6 Lahore. View brand new 5 Marla, 10 Marla, 1 Kanal and 2 Kanal luxury villas, latest price trends, sector comparisons, and contact details.';

interface PropertyItem {
  id: string;
  slug: string;
  title: string;
  price?: number;
  propertyType: string;
  size?: string;
  images?: any[];
  block?: string;
  bedrooms?: number;
  bathrooms?: number;
  location?: { address?: string; block?: string };
}

const allProperties = (Array.isArray(propertiesRaw) ? (propertiesRaw as any[]) : []) as PropertyItem[];
const houses = allProperties.filter((p) => p.propertyType === 'house' || p.propertyType === 'villa');
const displayHouses = (houses.length > 0 ? houses : allProperties.slice(0, 8));

function formatPrice(val: number | undefined): string {
  if (!val) return 'Call for Price';
  const cr = val / 10000000;
  if (cr >= 1) return `PKR ${cr.toFixed(2)} Cr`;
  const lac = val / 100000;
  return `PKR ${lac.toFixed(1)} Lac`;
}

const popularHouseSectors = SECTORS_DIRECTORY.filter((s) => ['sector-a', 'sector-c', 'sector-d', 'sector-e', 'sector-k'].includes(s.key));

const faqs = [
  {
    q: 'What are the current price ranges for houses in DHA Phase 6 Lahore?',
    a: '10 Marla houses typically range between PKR 4.50 Crore and PKR 7.50 Crore, while 1 Kanal luxury designer homes range from PKR 7.50 Crore up to PKR 14.50 Crore depending on finishes, basement, and sector.'
  },
  {
    q: 'Which sectors are best for buying a family house in Phase 6?',
    a: 'Sector A, Sector C, and Sector D are top-tier for family living due to proximity to Beaconhouse, the Grand Jamia Mosque, and Dolmen Mall. Sector K and Sector E offer serene, low-traffic residential pockets.'
  },
  {
    q: 'Are brand-new constructed houses available with full completion certificates?',
    a: 'Yes, most listed villas are brand-new architect-designed homes with DHA completion certificates, gas meters, electricity connections, and water filtration access.'
  },
  {
    q: 'What is the rental yield for houses in DHA Phase 6 Lahore?',
    a: '1 Kanal houses in Phase 6 generate rental yields between 4.8% and 5.6% annually, with monthly rents ranging between PKR 2.5 Lac to PKR 4.5 Lac.'
  }
];

const structuredData: { '@context': string; '@graph': any[] } = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description: metaDesc,
      inLanguage: 'en-PK',
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Properties', item: `${SITE.url}/properties/` },
        { '@type': 'ListItem', position: 3, name: 'Houses for Sale', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
    ...displayHouses.map((h) => ({
      '@type': 'RealEstateListing',
      '@id': `${SITE.url}/properties/${h.slug}/`,
      name: h.title,
      url: `${SITE.url}/properties/${h.slug}/`,
      offers: {
        '@type': 'Offer',
        price: h.price,
        priceCurrency: 'PKR',
        availability: 'https://schema.org/InStock',
      },
    })),
  ],
};
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <header class="prop-search-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/properties/">Properties</a>
        <span>/</span>
        <span aria-current="page">Houses for Sale</span>
      </nav>

      <span class="hero-badge">Verified Residential Inventory</span>
      <h1>Houses for Sale in DHA Phase 6 Lahore</h1>
      <p class="hero-desc">
        Browse verified designer houses, brand-new luxury villas, and bespoke family residences across prime sectors of DHA Phase 6 Lahore. Verified pricing, floor plans, and direct property consultations.
      </p>

      <div class="quick-links-bar">
        <a href="#available-listings" class="btn-primary">View Available Houses ({displayHouses.length}) ↓</a>
        <a href="/dha-phase-6-lahore-house-prices/" class="btn-secondary">House Price Trends →</a>
        <a href="/plots-for-sale-in-dha-phase-6-lahore/" class="btn-secondary">Plots for Sale →</a>
      </div>
    </div>
  </header>

  <main class="prop-search-main">
    <div class="container">
      <!-- Market Overview Section -->
      <section class="overview-section">
        <h2>DHA Phase 6 House Market Overview</h2>
        <p>
          DHA Phase 6 Lahore is widely regarded as one of Pakistan's most desirable upscale residential destinations. Characterized by 150-foot wide central boulevards, complete underground electrical infrastructure, high natural terrain, and comprehensive security, Phase 6 houses attract affluent families, overseas Pakistanis, and corporate leaders.
        </p>
        
        <div class="house-tiers-grid">
          <div class="tier-card">
            <span class="tier-tag">10 Marla</span>
            <h3>Family Villas</h3>
            <p class="tier-price">PKR 4.50 Cr – 7.50 Cr</p>
            <p class="tier-desc">Modern 4 to 5 bedroom homes with double unit layout, servant quarters, and imported fixtures.</p>
          </div>
          <div class="tier-card highlight">
            <span class="tier-tag">1 Kanal (Most Popular)</span>
            <h3>Luxury Designer Homes</h3>
            <p class="tier-price">PKR 7.50 Cr – 14.50 Cr</p>
            <p class="tier-desc">Spanish, Contemporary &amp; Minimalist luxury homes featuring basements, home cinemas, and Italian kitchens.</p>
          </div>
          <div class="tier-card">
            <span class="tier-tag">2 Kanal</span>
            <h3>Executive Mansions</h3>
            <p class="tier-price">PKR 14.00 Cr – 24.00 Cr</p>
            <p class="tier-desc">Palatial residences in Sector A, Sector C, and Defence Raya overlooking parklands and the golf course.</p>
          </div>
        </div>
      </section>

      <!-- Available Listings Grid -->
      <section id="available-listings" class="listings-section">
        <div class="section-header">
          <div>
            <span class="section-kicker"><span></span> Active Market Listings</span>
            <h2>Current Houses for Sale in DHA Phase 6</h2>
            <p>Direct listings verified with land record documentation and current on-ground condition.</p>
          </div>
        </div>

        <div class="props-grid-cards">
          {displayHouses.map((house) => (
            <article class="prop-card">
              <a class="prop-img-wrap" href={`/properties/${house.slug}/`}>
                <img
                  src={house.images && house.images[0] ? house.images[0] : 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=600&auto=format&fit=crop&q=80'}
                  alt={house.title}
                  loading="lazy"
                />
                <span class="prop-badge-status">Verified Available</span>
                <span class="prop-badge-type">{house.propertyType}</span>
              </a>

              <div class="prop-card-body">
                <div class="prop-card-top">
                  <span class="prop-price">{formatPrice(house.price)}</span>
                  <span class="prop-size">{house.size}</span>
                </div>

                <h3>
                  <a href={`/properties/${house.slug}/`}>{house.title}</a>
                </h3>

                <p class="prop-address">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  <span>{house.location?.address || house.location?.block || 'DHA Phase 6 Lahore'}</span>
                </p>

                <div class="prop-features">
                  {house.bedrooms && <span>🛏️ {house.bedrooms} Beds</span>}
                  {house.bathrooms && <span>🚿 {house.bathrooms} Baths</span>}
                  <span>🏛️ Brand New</span>
                </div>

                <div class="prop-card-footer">
                  <a class="btn-view-prop" href={`/properties/${house.slug}/`}>View Property Details →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Popular Sectors Section -->
      <section class="popular-sectors-section">
        <span class="section-kicker"><span></span> Prime Residential Zones</span>
        <h2>Top Sectors for Buying a House in Phase 6</h2>
        <div class="sectors-cards-grid">
          {popularHouseSectors.map((sector) => (
            <div class="sector-choice-card">
              <h3>{sector.label}</h3>
              <p>{sector.description}</p>
              <div class="sector-card-links">
                <a href={`/dha-phase-6-${sector.key}-lahore/`}>Complete Sector Guide →</a>
                <a href={`/sectors/${sector.key}/properties/`}>View Houses in {sector.label} →</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQs -->
      <section class="faqs-section">
        <span class="section-kicker"><span></span> Buyer Inquiries</span>
        <h2>Frequently Asked Questions About Houses in DHA Phase 6</h2>
        <div class="faqs-list">
          {faqs.map((faq) => (
            <details class="faq-card" open>
              <summary class="faq-q">
                <span>{faq.q}</span>
                <span class="faq-arrow">+</span>
              </summary>
              <div class="faq-a">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
</PageLayout>

<style>
  :root {
    --h-bg: #080818;
    --h-surface: #111125;
    --h-surface-2: #161633;
    --h-gold: #10b981;
    --h-gold-light: #34d399;
    --h-text: #f0f0f5;
    --h-muted: #9494b8;
    --h-dim: #646485;
    --h-line: rgba(255, 255, 255, 0.08);
  }

  .prop-search-hero {
    padding: 70px 0 50px;
    background: linear-gradient(180deg, #101024 0%, #0c0c1b 100%);
    border-bottom: 1px solid var(--h-line);
    text-align: center;
  }
  .breadcrumb {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    color: var(--h-dim);
    margin-bottom: 1.25rem;
  }
  .breadcrumb a {
    color: var(--h-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--h-gold-light);
  }
  .hero-badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.12);
    color: var(--h-gold-light);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .prop-search-hero h1 {
    font-size: 2.3rem;
    font-weight: 800;
    color: var(--h-text);
    margin: 0 0 1rem;
  }
  .hero-desc {
    max-width: 760px;
    margin: 0 auto 1.75rem;
    color: var(--h-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .quick-links-bar {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--h-gold), var(--h-gold-light));
    color: #06101d;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .btn-secondary {
    background: var(--h-surface);
    color: var(--h-text);
    border: 1px solid var(--h-line);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .btn-secondary:hover {
    border-color: var(--h-gold);
    color: var(--h-gold-light);
  }

  .prop-search-main {
    padding: 50px 0 80px;
    background: var(--h-bg);
  }
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--h-gold-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }
  .section-kicker span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--h-gold);
  }

  /* Overview & Tiers */
  .overview-section {
    margin-bottom: 3.5rem;
  }
  .overview-section h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--h-text);
    margin: 0 0 0.75rem;
  }
  .overview-section p {
    color: var(--h-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 860px;
  }
  .house-tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  .tier-card {
    background: var(--h-surface);
    border: 1px solid var(--h-line);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .tier-card.highlight {
    border-color: rgba(16, 185, 129, 0.4);
    background: linear-gradient(180deg, rgba(22, 22, 51, 0.9) 0%, rgba(17, 17, 37, 0.6) 100%);
  }
  .tier-tag {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--h-gold-light);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .tier-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--h-text);
    margin: 0 0 0.4rem;
  }
  .tier-price {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--h-gold-light);
    margin: 0 0 0.75rem;
  }
  .tier-desc {
    color: var(--h-muted);
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Listings Grid */
  .listings-section {
    margin-bottom: 3.5rem;
  }
  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--h-text);
    margin: 0.3rem 0 0.4rem;
  }
  .section-header p {
    color: var(--h-muted);
    font-size: 0.85rem;
    margin: 0 0 1.5rem;
  }
  .props-grid-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .prop-card {
    background: var(--h-surface);
    border: 1px solid var(--h-line);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .prop-card:hover {
    transform: translateY(-4px);
    border-color: rgba(16, 185, 129, 0.4);
  }
  .prop-img-wrap {
    position: relative;
    height: 160px;
    display: block;
    background: #090918;
  }
  .prop-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prop-badge-status {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(16, 185, 129, 0.9);
    color: #05101a;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
  }
  .prop-badge-type {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(10, 10, 25, 0.8);
    color: var(--h-text);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
  }
  .prop-card-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .prop-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .prop-price {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--h-gold-light);
  }
  .prop-size {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--h-dim);
  }
  .prop-card-body h3 {
    font-size: 0.92rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    line-height: 1.35;
  }
  .prop-card-body h3 a {
    color: var(--h-text);
    text-decoration: none;
  }
  .prop-card-body h3 a:hover {
    color: var(--h-gold-light);
  }
  .prop-address {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--h-dim);
    margin-bottom: 0.85rem;
  }
  .prop-features {
    display: flex;
    gap: 0.6rem;
    font-size: 0.68rem;
    color: var(--h-muted);
    margin-bottom: 1rem;
  }
  .prop-card-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--h-line);
  }
  .btn-view-prop {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--h-gold);
    text-decoration: none;
  }
  .btn-view-prop:hover {
    color: var(--h-gold-light);
  }

  /* Popular Sectors */
  .popular-sectors-section {
    margin-bottom: 3.5rem;
    padding: 2.25rem;
    background: var(--h-surface);
    border: 1px solid var(--h-line);
    border-radius: 12px;
  }
  .popular-sectors-section h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--h-text);
    margin: 0.3rem 0 1.25rem;
  }
  .sectors-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .sector-choice-card {
    background: #0d0d21;
    border: 1px solid var(--h-line);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .sector-choice-card h3 {
    font-size: 1.05rem;
    color: var(--h-text);
    margin: 0 0 0.4rem;
  }
  .sector-choice-card p {
    color: var(--h-muted);
    font-size: 0.78rem;
    line-height: 1.5;
    margin: 0 0 1rem;
    flex-grow: 1;
  }
  .sector-card-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sector-card-links a {
    font-size: 0.72rem;
    color: var(--h-gold-light);
    text-decoration: none;
    font-weight: 700;
  }

  /* FAQs */
  .faqs-section {
    padding: 2.25rem;
    background: var(--h-surface);
    border: 1px solid var(--h-line);
    border-radius: 12px;
  }
  .faqs-section h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--h-text);
    margin: 0.3rem 0 1.25rem;
  }
  .faqs-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-card {
    background: #0d0d21;
    border: 1px solid var(--h-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .faq-q {
    padding: 0.85rem 1.1rem;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--h-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
  }
  .faq-arrow {
    color: var(--h-gold-light);
  }
  .faq-a {
    padding: 0 1.1rem 0.85rem;
    color: var(--h-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .faq-a p {
    margin: 0;
  }

  @media (max-width: 1024px) {
    .props-grid-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .prop-search-hero {
      padding: 48px 0 36px;
    }
    .prop-search-hero h1 {
      font-size: 1.65rem;
    }
    .house-tiers-grid,
    .props-grid-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
