---
/**
 * DHA Phase 6 Lahore — Plots for Sale High-Intent Search Landing Page (Phase 10.15 Task 2)
 * Route: /plots-for-sale-in-dha-phase-6-lahore/
 */
import PageLayout from '@layouts/PageLayout.astro';
import propertiesRaw from '@data/properties-import.json';
import { SECTORS_DIRECTORY } from '@data/places/index';
import { SITE } from '@data/site';

const canonical = `${SITE.url}/plots-for-sale-in-dha-phase-6-lahore/`;
const pageTitle = 'Plots for Sale in DHA Phase 6 Lahore — 5, 10 Marla, 1 & 2 Kanal Residential Plots';
const metaDesc = 'Find verified residential plots for sale in DHA Phase 6 Lahore. Compare 5 Marla, 10 Marla, 1 Kanal, and 2 Kanal plot prices, sector availability, possession status, and transfer procedures.';

interface PropertyItem {
  id: string;
  slug: string;
  title: string;
  price?: number;
  propertyType: string;
  size?: string;
  images?: any[];
  block?: string;
  location?: { address?: string; block?: string };
}

const allProperties = (Array.isArray(propertiesRaw) ? (propertiesRaw as any[]) : []) as PropertyItem[];
const plots = allProperties.filter((p) => p.propertyType === 'plot');
const displayPlots = (plots.length > 0 ? plots : allProperties.slice(0, 8));

function formatPrice(val: number | undefined): string {
  if (!val) return 'Call for Price';
  const cr = val / 10000000;
  if (cr >= 1) return `PKR ${cr.toFixed(2)} Cr`;
  const lac = val / 100000;
  return `PKR ${lac.toFixed(1)} Lac`;
}

const popularPlotSectors = SECTORS_DIRECTORY.filter((s) => ['sector-a', 'sector-b', 'sector-c', 'sector-f', 'sector-j', 'sector-m'].includes(s.key));

const faqs = [
  {
    q: 'What are the current 1 Kanal plot prices in DHA Phase 6 Lahore?',
    a: '1 Kanal residential plots in DHA Phase 6 currently trade between PKR 3.50 Crore in developing blocks up to PKR 6.50 Crore in prime sectors like Sector A, B, and C with full possession and immediate construction approval.'
  },
  {
    q: 'Which sectors in DHA Phase 6 offer 10 Marla and 5 Marla plots?',
    a: '10 Marla plots are primarily available in Sector D, Sector J, and Sector L. Smaller 5 Marla plots can be found in specialized pockets such as Sector J and Sector L extensions.'
  },
  {
    q: 'Are all plots in DHA Phase 6 in ready possession?',
    a: 'Yes, DHA Phase 6 is 100% developed and possessed. All residential sectors have complete asphalt roads, underground electrification, water supply, and security.'
  },
  {
    q: 'What is the DHA Lahore property transfer fee for a 1 Kanal plot in Phase 6?',
    a: 'The DHA Lahore transfer fee varies by filer status (Filer vs Non-Filer), with additional membership fees, CVT, and advance tax under Section 236K and 236C.'
  }
];

const structuredData: { '@context': string; '@graph': any[] } = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description: metaDesc,
      inLanguage: 'en-PK',
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Properties', item: `${SITE.url}/properties/` },
        { '@type': 'ListItem', position: 3, name: 'Plots for Sale', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
    ...displayPlots.map((p) => ({
      '@type': 'RealEstateListing',
      '@id': `${SITE.url}/properties/${p.slug}/`,
      name: p.title,
      url: `${SITE.url}/properties/${p.slug}/`,
      offers: {
        '@type': 'Offer',
        price: p.price,
        priceCurrency: 'PKR',
        availability: 'https://schema.org/InStock',
      },
    })),
  ],
};
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <header class="prop-search-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/properties/">Properties</a>
        <span>/</span>
        <span aria-current="page">Plots for Sale</span>
      </nav>

      <span class="hero-badge">Verified Land Inventory</span>
      <h1>Plots for Sale in DHA Phase 6 Lahore</h1>
      <p class="hero-desc">
        Explore ready-to-build residential plots in DHA Phase 6 Lahore. Featuring 5 Marla, 10 Marla, 1 Kanal and 2 Kanal residential parcels with full possession, underground utilities, and clear land titles.
      </p>

      <div class="quick-links-bar">
        <a href="#available-plots" class="btn-primary">View Available Plots ({displayPlots.length}) ↓</a>
        <a href="/dha-phase-6-lahore-plot-prices/" class="btn-secondary">Plot Price Matrix →</a>
        <a href="/houses-for-sale-in-dha-phase-6-lahore/" class="btn-secondary">Houses for Sale →</a>
      </div>
    </div>
  </header>

  <main class="prop-search-main">
    <div class="container">
      <!-- Plot Categories Grid -->
      <section class="overview-section">
        <h2>Plot Categories &amp; Typical Price Ranges</h2>
        <p>
          Residential land in DHA Phase 6 represents the gold standard of real estate investment in Lahore. Each plot category offers specific building dimensions and living characteristics:
        </p>

        <div class="plot-tiers-grid">
          <div class="tier-card">
            <span class="tier-tag">5 &amp; 8 Marla</span>
            <h3>Compact Residential</h3>
            <p class="tier-price">PKR 1.25 Cr – 2.20 Cr</p>
            <p class="tier-desc">Ideal entry-point plots for small families or budget-focused capital gains in Sector J and L.</p>
          </div>
          <div class="tier-card">
            <span class="tier-tag">10 Marla</span>
            <h3>Family Living</h3>
            <p class="tier-price">PKR 2.25 Cr – 3.80 Cr</p>
            <p class="tier-desc">High liquidity plots in Sector D, J, and L; perfect for constructing modern double-unit 4-bed villas.</p>
          </div>
          <div class="tier-card highlight">
            <span class="tier-tag">1 Kanal (Primary Asset)</span>
            <h3>Standard Luxury</h3>
            <p class="tier-price">PKR 3.50 Cr – 6.50 Cr</p>
            <p class="tier-desc">500 sq yds parcels across all major residential sectors with 50-foot wide streets and park facing options.</p>
          </div>
          <div class="tier-card">
            <span class="tier-tag">2 Kanal</span>
            <h3>Palatial Estates</h3>
            <p class="tier-price">PKR 8.00 Cr – 15.00 Cr</p>
            <p class="tier-desc">Exclusive 1,000 sq yds plots in Sector A, Sector B, Sector C, and Sector K for custom mansion construction.</p>
          </div>
        </div>
      </section>

      <!-- Available Listings Grid -->
      <section id="available-plots" class="listings-section">
        <div class="section-header">
          <div>
            <span class="section-kicker"><span></span> Active Market Listings</span>
            <h2>Verified Plots for Sale in DHA Phase 6</h2>
            <p>Direct plots verified with DHA Lahore transfer records and location clearance.</p>
          </div>
        </div>

        <div class="props-grid-cards">
          {displayPlots.map((plot) => (
            <article class="prop-card">
              <a class="prop-img-wrap" href={`/properties/${plot.slug}/`}>
                <img
                  src={plot.images && plot.images[0] ? plot.images[0] : 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=600&auto=format&fit=crop&q=80'}
                  alt={plot.title}
                  loading="lazy"
                />
                <span class="prop-badge-status">Possession Ready</span>
                <span class="prop-badge-type">Plot</span>
              </a>

              <div class="prop-card-body">
                <div class="prop-card-top">
                  <span class="prop-price">{formatPrice(plot.price)}</span>
                  <span class="prop-size">{plot.size}</span>
                </div>

                <h3>
                  <a href={`/properties/${plot.slug}/`}>{plot.title}</a>
                </h3>

                <p class="prop-address">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  <span>{plot.location?.address || plot.location?.block || 'DHA Phase 6 Lahore'}</span>
                </p>

                <div class="prop-features">
                  <span>📜 Direct Transfer</span>
                  <span>⚡ Underground Grid</span>
                  <span>💧 Sweet Water</span>
                </div>

                <div class="prop-card-footer">
                  <a class="btn-view-prop" href={`/properties/${plot.slug}/`}>View Plot Details →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Key Factors Affecting Plot Prices -->
      <section class="factors-section">
        <span class="section-kicker"><span></span> Valuation Guide</span>
        <h2>Key Factors Determining Plot Valuations in Phase 6</h2>
        <div class="factors-grid">
          <div class="factor-card">
            <h4>1. Location &amp; Sector Tier</h4>
            <p>Western sectors (A, B, C) adjacent to Phase 5 command a 20% to 35% premium over boundary sectors due to immediate accessibility.</p>
          </div>
          <div class="factor-card">
            <h4>2. Orientation &amp; Facing</h4>
            <p>Park-facing, corner plots, and boulevard-facing plots command 10% to 20% premium over standard demarcation parcels.</p>
          </div>
          <div class="factor-card">
            <h4>3. Road Width</h4>
            <p>Plots on 60-ft and 80-ft avenues carry higher asking prices than internal 40-ft and 50-ft residential cul-de-sacs.</p>
          </div>
          <div class="factor-card">
            <h4>4. Soil &amp; Ground Level</h4>
            <p>Plots with on-level natural terrain requiring minimal earth filling offer significant construction cost savings.</p>
          </div>
        </div>
      </section>

      <!-- Popular Sectors Section -->
      <section class="popular-sectors-section">
        <span class="section-kicker"><span></span> Sector Selection</span>
        <h2>Top Sectors for Plot Investment in Phase 6</h2>
        <div class="sectors-cards-grid">
          {popularPlotSectors.map((sector) => (
            <div class="sector-choice-card">
              <h3>{sector.label}</h3>
              <p>{sector.description}</p>
              <div class="sector-card-links">
                <a href={`/dha-phase-6-${sector.key}-lahore/`}>Complete Sector Guide →</a>
                <a href={`/sectors/${sector.key}/properties/`}>View Plots in {sector.label} →</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQs -->
      <section class="faqs-section">
        <span class="section-kicker"><span></span> Investor Inquiries</span>
        <h2>Frequently Asked Questions About Plots in DHA Phase 6</h2>
        <div class="faqs-list">
          {faqs.map((faq) => (
            <details class="faq-card" open>
              <summary class="faq-q">
                <span>{faq.q}</span>
                <span class="faq-arrow">+</span>
              </summary>
              <div class="faq-a">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
</PageLayout>

<style>
  :root {
    --p-bg: #080818;
    --p-surface: #111125;
    --p-surface-2: #161633;
    --p-gold: #10b981;
    --p-gold-light: #34d399;
    --p-text: #f0f0f5;
    --p-muted: #9494b8;
    --p-dim: #646485;
    --p-line: rgba(255, 255, 255, 0.08);
  }

  .prop-search-hero {
    padding: 70px 0 50px;
    background: linear-gradient(180deg, #101024 0%, #0c0c1b 100%);
    border-bottom: 1px solid var(--p-line);
    text-align: center;
  }
  .breadcrumb {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    color: var(--p-dim);
    margin-bottom: 1.25rem;
  }
  .breadcrumb a {
    color: var(--p-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--p-gold-light);
  }
  .hero-badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.12);
    color: var(--p-gold-light);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .prop-search-hero h1 {
    font-size: 2.3rem;
    font-weight: 800;
    color: var(--p-text);
    margin: 0 0 1rem;
  }
  .hero-desc {
    max-width: 760px;
    margin: 0 auto 1.75rem;
    color: var(--p-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .quick-links-bar {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--p-gold), var(--p-gold-light));
    color: #06101d;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .btn-secondary {
    background: var(--p-surface);
    color: var(--p-text);
    border: 1px solid var(--p-line);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .btn-secondary:hover {
    border-color: var(--p-gold);
    color: var(--p-gold-light);
  }

  .prop-search-main {
    padding: 50px 0 80px;
    background: var(--p-bg);
  }
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--p-gold-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }
  .section-kicker span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--p-gold);
  }

  /* Overview & Tiers */
  .overview-section {
    margin-bottom: 3.5rem;
  }
  .overview-section h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--p-text);
    margin: 0 0 0.75rem;
  }
  .overview-section p {
    color: var(--p-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 860px;
  }
  .plot-tiers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .tier-card {
    background: var(--p-surface);
    border: 1px solid var(--p-line);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .tier-card.highlight {
    border-color: rgba(16, 185, 129, 0.4);
    background: linear-gradient(180deg, rgba(22, 22, 51, 0.9) 0%, rgba(17, 17, 37, 0.6) 100%);
  }
  .tier-tag {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--p-gold-light);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .tier-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--p-text);
    margin: 0 0 0.4rem;
  }
  .tier-price {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--p-gold-light);
    margin: 0 0 0.75rem;
  }
  .tier-desc {
    color: var(--p-muted);
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Listings Grid */
  .listings-section {
    margin-bottom: 3.5rem;
  }
  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--p-text);
    margin: 0.3rem 0 0.4rem;
  }
  .section-header p {
    color: var(--p-muted);
    font-size: 0.85rem;
    margin: 0 0 1.5rem;
  }
  .props-grid-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .prop-card {
    background: var(--p-surface);
    border: 1px solid var(--p-line);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .prop-card:hover {
    transform: translateY(-4px);
    border-color: rgba(16, 185, 129, 0.4);
  }
  .prop-img-wrap {
    position: relative;
    height: 160px;
    display: block;
    background: #090918;
  }
  .prop-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prop-badge-status {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(16, 185, 129, 0.9);
    color: #05101a;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
  }
  .prop-badge-type {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(10, 10, 25, 0.8);
    color: var(--p-text);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
  }
  .prop-card-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .prop-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .prop-price {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--p-gold-light);
  }
  .prop-size {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--p-dim);
  }
  .prop-card-body h3 {
    font-size: 0.92rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    line-height: 1.35;
  }
  .prop-card-body h3 a {
    color: var(--p-text);
    text-decoration: none;
  }
  .prop-card-body h3 a:hover {
    color: var(--p-gold-light);
  }
  .prop-address {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--p-dim);
    margin-bottom: 0.85rem;
  }
  .prop-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.68rem;
    color: var(--p-muted);
    margin-bottom: 1rem;
  }
  .prop-card-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--p-line);
  }
  .btn-view-prop {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--p-gold);
    text-decoration: none;
  }
  .btn-view-prop:hover {
    color: var(--p-gold-light);
  }

  /* Factors */
  .factors-section {
    margin-bottom: 3.5rem;
    padding: 2.25rem;
    background: var(--p-surface);
    border: 1px solid var(--p-line);
    border-radius: 12px;
  }
  .factors-section h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--p-text);
    margin: 0.3rem 0 1.25rem;
  }
  .factors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .factor-card {
    background: #0d0d21;
    border: 1px solid var(--p-line);
    border-radius: 8px;
    padding: 1.2rem;
  }
  .factor-card h4 {
    color: var(--p-gold-light);
    font-size: 0.9rem;
    margin: 0 0 0.4rem;
  }
  .factor-card p {
    color: var(--p-muted);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Popular Sectors */
  .popular-sectors-section {
    margin-bottom: 3.5rem;
    padding: 2.25rem;
    background: var(--p-surface);
    border: 1px solid var(--p-line);
    border-radius: 12px;
  }
  .popular-sectors-section h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--p-text);
    margin: 0.3rem 0 1.25rem;
  }
  .sectors-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .sector-choice-card {
    background: #0d0d21;
    border: 1px solid var(--p-line);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .sector-choice-card h3 {
    font-size: 1.05rem;
    color: var(--p-text);
    margin: 0 0 0.4rem;
  }
  .sector-choice-card p {
    color: var(--p-muted);
    font-size: 0.78rem;
    line-height: 1.5;
    margin: 0 0 1rem;
    flex-grow: 1;
  }
  .sector-card-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sector-card-links a {
    font-size: 0.72rem;
    color: var(--p-gold-light);
    text-decoration: none;
    font-weight: 700;
  }

  /* FAQs */
  .faqs-section {
    padding: 2.25rem;
    background: var(--p-surface);
    border: 1px solid var(--p-line);
    border-radius: 12px;
  }
  .faqs-section h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--p-text);
    margin: 0.3rem 0 1.25rem;
  }
  .faqs-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-card {
    background: #0d0d21;
    border: 1px solid var(--p-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .faq-q {
    padding: 0.85rem 1.1rem;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--p-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
  }
  .faq-arrow {
    color: var(--p-gold-light);
  }
