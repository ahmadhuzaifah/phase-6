---
/**
 * Property Dealer Profile Page — Ahmad Huzaifah
 * Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyWatermark from '@components/property/PropertyWatermark.astro';
import { SITE } from '@data/site';
import propertiesData from '@data/properties-import.json';

const consultant = {
  name: 'Ahmad Huzaifah',
  title: 'PROPERTY CONSULTANT',
  location: 'Al Rehman Garden Phase 2 Lahore',
  phone: '03257800001',
  phoneTel: '+923257800001',
  whatsappNumber: '03257800001',
  whatsappUrl: 'https://wa.me/923257800001',
  image: '/images/dealers/ahmad-huzaifah.png',
  bio: 'Helping buyers find residential plots, houses, and investment opportunities in Al Rehman Garden Phase 2 Lahore with transparent guidance and verified property information.',
  serviceArea: 'Al Rehman Garden Phase 2 Lahore',
  services: 'Property Consultation & Plot / House Assistance',
};

const pageSchema = {
  name: `Ahmad Huzaifah — Property Consultant in Al Rehman Garden Phase 2 Lahore`,
  description: `Contact Ahmad Huzaifah for verified residential plots, houses, market prices, and property viewing in Al Rehman Garden Phase 2 Lahore.`,
  url: `${SITE.url}/property-dealer`,
};

const realEstateAgentSchema = {
  name: consultant.name,
  jobTitle: consultant.title,
  telephone: consultant.phoneTel,
  url: `${SITE.url}/property-dealer`,
  image: `${SITE.url}${consultant.image}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Property Dealer',
      item: `${SITE.url}/property-dealer`,
    },
  ],
};

const buyerGuideSteps = [
  {
    icon: '📋',
    title: 'Verify Documents',
    desc: 'Check ownership, transfer status, NDC clearance, and official society records.',
  },
  {
    icon: '📍',
    title: 'Check Property Location',
    desc: 'Visit the property on-ground before making a financial commitment.',
  },
  {
    icon: '📊',
    title: 'Compare Market Prices',
    desc: 'Understand current market benchmarks and sector rates before investing.',
  },
  {
    icon: '🏗️',
    title: 'Review Development Status',
    desc: 'Inspect block infrastructure progress, underground utilities, and road carpeting.',
  },
  {
    icon: '🏛️',
    title: 'Use Official Transfer Process',
    desc: 'Execute all purchase transactions through the authorized management office.',
  },
  {
    icon: '📝',
    title: 'Keep Written Agreements',
    desc: 'Document all token payments, receipts, and commission terms in writing.',
  },
];

const assistanceServices = [
  {
    icon: '🏡',
    title: 'Residential Plots',
    desc: '3 Marla, 5 Marla, 10 Marla & 1 Kanal plots in mature and upcoming sectors.',
  },
  {
    icon: '🏰',
    title: 'Ready & Built Houses',
    desc: 'Newly constructed double-story luxury designer villas with immediate possession.',
  },
  {
    icon: '📈',
    title: 'Investment Guidance',
    desc: 'Independent market analysis, capital appreciation trends, and high-ROI location advice.',
  },
  {
    icon: '🚗',
    title: 'Property Viewing',
    desc: 'Complimentary guided physical site tours, plot demarcation, and sector visits.',
  },
];

// Featured 3 curated listings for quick preview
const featuredListings = propertiesData.slice(0, 3);
---

<PageLayout
  title="Al Rehman Garden Phase 2 Lahore Property Dealer | Verified Property Assistance"
  description="Contact Al Rehman Garden Phase 2 Lahore property consultant Ahmad Huzaifah (03257800001) for verified plots, houses, investment guidance, and property viewing assistance."
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="RealEstateAgent" data={realEstateAgentSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />

  <main class="dealer-page">
    <!-- Top Sub-Navigation Bar matching reference -->
    <header class="dealer-topbar">
      <div class="container dealer-topbar__inner">
        <a href="/" class="dealer-topbar__logo">
          <img src="/images/logo/logo-white.svg" alt={SITE.name} width="190" height="48" />
        </a>

        <nav class="dealer-topbar__nav">
          <a href="/" class="dealer-nav-link">Home</a>
          <a href="/blocks" class="dealer-nav-link">Blocks</a>
          <a href="/properties" class="dealer-nav-link">Properties</a>
          <a href="/plots" class="dealer-nav-link">Plots</a>
          <a href="/houses-for-sale-in-al-rehman-garden-phase-2-lahore" class="dealer-nav-link">Houses</a>
          <a href="/places" class="dealer-nav-link">Places</a>
          <a href="/map" class="dealer-nav-link">Map</a>
          <a href="/property-prices" class="dealer-nav-link">Prices</a>
          <a href="/contact" class="dealer-nav-link">Contact</a>
        </nav>

        <a
          href={consultant.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="dealer-btn-gold"
        >
          WhatsApp
        </a>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="dealer-hero">
      <div class="container text-center">
        <!-- Breadcrumbs -->
        <nav class="dealer-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>&gt;</span>
          <span class="active">Property Dealer</span>
        </nav>

        <!-- Main Heading -->
        <h1 class="dealer-hero__title">
          Al Rehman Garden Phase 2 Lahore <br />
          <span class="text-gold">Property Dealer</span>
        </h1>

        <!-- Subtitle -->
        <p class="dealer-hero__subtitle">
          Contact us for property inquiries, buying assistance, and viewing arrangements in Al Rehman Garden Phase 2 Lahore.
        </p>

        <!-- Main Dealer Profile Card -->
        <div class="profile-card">
          <div class="profile-card__top">
            <div class="profile-card__avatar-wrap">
              <img
                src={consultant.image}
                alt={consultant.name}
                class="profile-card__avatar"
                width="110"
                height="110"
                loading="eager"
              />
            </div>
            <div class="profile-card__identity">
              <div class="profile-card__badge-row">
                <span class="profile-badge">{consultant.title}</span>
              </div>
              <h2 class="profile-card__name">{consultant.name}</h2>
              <span class="profile-card__loc">📍 {consultant.location}</span>
            </div>
          </div>

          <p class="profile-card__bio">{consultant.bio}</p>

          <!-- 4 Information Cards (2x2 Grid) -->
          <div class="info-matrix-grid">
            <div class="info-mini-card">
              <span class="info-mini-card__label">SERVICE AREA</span>
              <strong class="info-mini-card__val">{consultant.serviceArea}</strong>
            </div>

            <div class="info-mini-card">
              <span class="info-mini-card__label">SERVICES</span>
              <strong class="info-mini-card__val">{consultant.services}</strong>
            </div>

            <div class="info-mini-card">
              <span class="info-mini-card__label">WHATSAPP</span>
              <strong class="info-mini-card__val">{consultant.whatsappNumber}</strong>
            </div>

            <div class="info-mini-card">
              <span class="info-mini-card__label">CALL</span>
              <strong class="info-mini-card__val">{consultant.phone}</strong>
            </div>
          </div>

          <!-- Direct CTA Buttons -->
          <div class="profile-card__actions">
            <a
              href={consultant.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-action btn-action--whatsapp"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
              </svg>
              <span>WhatsApp {consultant.whatsappNumber}</span>
            </a>

            <a
              href={`tel:${consultant.phoneTel}`}
              class="btn-action btn-action--call"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Call {consultant.phone}</span>
            </a>
          </div>
        </div>

        <!-- Warning Trust Box -->
        <div class="warning-trust-box">
          <span class="warning-trust-box__icon">⚠️</span>
          <p class="warning-trust-box__text">
            Always verify property ownership, documents, prices, and transfer status before making any payment.
          </p>
        </div>
      </div>
    </section>

    <!-- Buyer's Guide Section -->
    <section class="dealer-section">
      <div class="container">
        <div class="section-center-head">
          <div class="guide-eyebrow">
            <span class="guide-eyebrow__line"></span>
            <span>BEFORE YOU BUY</span>
            <span class="guide-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Buyer's Guide</h2>
          <p class="section-sub-title">Use these checks before buying, selling, or renting a property in Al Rehman Garden Phase 2 Lahore.</p>
        </div>

        <div class="guide-card-grid">
          {buyerGuideSteps.map((step) => (
            <div class="guide-card">
              <div class="guide-card__icon-wrap">
                <span class="guide-card__icon">{step.icon}</span>
              </div>
              <h3 class="guide-card__title">{step.title}</h3>
              <p class="guide-card__desc">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How We Help Section -->
    <section class="dealer-section dealer-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="guide-eyebrow">
            <span class="guide-eyebrow__line"></span>
            <span>PROPERTY ASSISTANCE</span>
            <span class="guide-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">How We Help</h2>
          <p class="section-sub-title">Comprehensive real estate solutions for home buyers and real estate investors.</p>
        </div>

        <div class="services-grid-4">
          {assistanceServices.map((svc) => (
            <div class="service-card">
              <span class="service-card__icon">{svc.icon}</span>
              <h3 class="service-card__title">{svc.title}</h3>
              <p class="service-card__desc">{svc.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Property Section -->
    <section class="dealer-section">
      <div class="container">
        <div class="section-center-head">
          <div class="guide-eyebrow">
            <span class="guide-eyebrow__line"></span>
            <span>VERIFIED INVENTORY</span>
            <span class="guide-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Latest Available Properties</h2>
          <p class="section-sub-title">Handpicked verified properties ready for site viewing in Al Rehman Garden Phase 2.</p>
        </div>

        <div class="properties-preview-grid">
          {featuredListings.map((prop) => (
            <div class="prop-mini-card">
              <div class="prop-mini-card__img-wrap">
                <img
                  src={prop.images[0]?.url || '/images/placeholders/property-placeholder.webp'}
                  alt={prop.title}
                  class="prop-mini-card__img"
                  loading="lazy"
                />
                <PropertyWatermark position="bottom-right" opacity={0.8} />
                <span class="prop-mini-card__status-badge">🟢 Available</span>
              </div>

              <div class="prop-mini-card__content">
                <div class="prop-mini-card__meta">
                  <span class="prop-mini-tag">{prop.size} {prop.unit}</span>
                  <span class="prop-mini-tag prop-mini-tag--block">{prop.block}</span>
                </div>
                <h3 class="prop-mini-card__title">{prop.title}</h3>
                <div class="prop-mini-card__price">
                  PKR {new Intl.NumberFormat('en-PK').format(prop.price)}
                </div>

                <div class="prop-mini-card__footer">
                  <a
                    href={`/properties/${prop.slug}`}
                    class="btn-prop-view"
                  >
                    View Details
                  </a>
                  <a
                    href={`https://wa.me/923257800001?text=${encodeURIComponent(`Salam Ahmad Huzaifah, I am interested in property "${prop.title}" (${prop.id}) in Al Rehman Garden Phase 2.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-prop-whatsapp"
                    title="Inquire on WhatsApp"
                  >
                    💬 WhatsApp
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div style="text-align: center; margin-top: 40px;">
          <a href="/properties" class="btn-explore-all">
            Explore All 100+ Verified Properties →
          </a>
        </div>
      </div>
    </section>

    <!-- Large Contact CTA Section -->
    <section class="dealer-cta-section">
      <div class="container">
        <div class="dealer-cta-box">
          <div class="dealer-cta-box__body">
            <h2 class="dealer-cta-box__title">
              Looking for property in <br />
              <span class="text-gold">Al Rehman Garden Phase 2 Lahore?</span>
            </h2>
            <p class="dealer-cta-box__desc">
              Get in touch with <strong>Ahmad Huzaifah</strong> today for verified plot prices, map coordinates, and guided physical site inspections.
            </p>
          </div>

          <div class="dealer-cta-box__actions">
            <a
              href={consultant.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-action btn-action--whatsapp btn-action--lg"
            >
              💬 WhatsApp Consultation
            </a>
            <a
              href={`tel:${consultant.phoneTel}`}
              class="btn-action btn-action--call btn-action--lg"
            >
              📞 Call 03257800001
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Premium Dark Footer matching reference structure -->
    <footer class="dealer-footer">
      <div class="container">
        <div class="dealer-footer__grid">
          <!-- Left Column -->
          <div class="dealer-footer__brand-col">
            <img src="/images/logo/logo-white.svg" alt={SITE.name} width="220" height="55" class="dealer-footer__logo" />
            <p class="dealer-footer__desc">
              An independent real estate information portal providing property guidance, market information, and investment resources for Al Rehman Garden Phase 2 Lahore.
            </p>
            <div class="dealer-footer__contact-direct">
              <span>👤 <strong>Ahmad Huzaifah</strong></span>
              <span>📞 <a href={`tel:${consultant.phoneTel}`}>{consultant.phone}</a></span>
              <span>💬 <a href={consultant.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp {consultant.whatsappNumber}</a></span>
            </div>
          </div>

          <!-- Column 2: Pages -->
          <div class="dealer-footer__col">
            <h4 class="dealer-footer__heading">Pages</h4>
            <ul class="dealer-footer__list">
              <li><a href="/">Home</a></li>
              <li><a href="/properties">Properties</a></li>
              <li><a href="/blocks">Blocks</a></li>
              <li><a href="/property-prices">Prices</a></li>
              <li><a href="/places">Places</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <!-- Column 3: Resources -->
          <div class="dealer-footer__col">
            <h4 class="dealer-footer__heading">Resources</h4>
            <ul class="dealer-footer__list">
              <li><a href="/al-rehman-garden-phase-2-location">Location Guide</a></li>
              <li><a href="/al-rehman-garden-phase-2-investment-guide">Investment Guide</a></li>
              <li><a href="/al-rehman-garden-phase-2-payment-plan">Payment Plan</a></li>
              <li><a href="/faq">FAQs</a></li>
              <li><a href="/downloads">Masterplan Downloads</a></li>
            </ul>
          </div>

          <!-- Column 4: Legal -->
          <div class="dealer-footer__col">
            <h4 class="dealer-footer__heading">Legal</h4>
            <ul class="dealer-footer__list">
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
              <li><a href="/disclaimer">Disclaimer</a></li>
              <li><a href="/copyright-policy">Copyright Policy</a></li>
            </ul>
          </div>
        </div>

        <div class="dealer-footer__bottom">
          <p>&copy; {new Date().getFullYear()} Al Rehman Garden Phase 2 Lahore Authority Portal. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </main>
</PageLayout>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     THEME & GLOBAL CANVAS — DARK NAVY #0B0B20
     ══════════════════════════════════════════════════════════════════════════ */
  .dealer-page {
    background-color: #0B0B20;
    color: #F8FAFC;
    min-height: 100vh;
    font-family: var(--font-sans);
  }

  .text-gold {
    color: #F3D375;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     TOP NAVIGATION BAR
     ══════════════════════════════════════════════════════════════════════════ */
  .dealer-topbar {
    background: rgba(11, 11, 32, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    padding: 14px 0;
  }

  .dealer-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .dealer-topbar__nav {
    display: none;
    align-items: center;
    gap: 22px;
  }

  @media (min-width: 992px) {
    .dealer-topbar__nav {
      display: flex;
    }
  }

  .dealer-nav-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .dealer-nav-link:hover {
    color: #F3D375;
  }

  .dealer-btn-gold {
    background: #E5C058;
    color: #0B0B20;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .dealer-btn-gold:hover {
    background: #F3D375;
    transform: translateY(-1px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     HERO & PROFILE CARD
     ══════════════════════════════════════════════════════════════════════════ */
  .dealer-hero {
    padding: 48px 0 64px;
    background: radial-gradient(circle at 50% 15%, #181945 0%, #0B0B20 80%);
  }

  .dealer-breadcrumb {
    font-size: 12.5px;
    color: #94A3B8;
    margin-bottom: 18px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .dealer-breadcrumb a {
    color: #94A3B8;
    text-decoration: none;
  }

  .dealer-breadcrumb a:hover {
    color: #F3D375;
  }

  .dealer-breadcrumb .active {
    color: #CBD5E1;
  }

  .dealer-hero__title {
    font-size: clamp(26px, 4.5vw, 42px);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .dealer-hero__subtitle {
    font-size: 14.5px;
    color: #94A3B8;
    max-width: 600px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  /* Profile Card */
  .profile-card {
    background: #141432;
    border: 1px solid rgba(243, 211, 117, 0.25);
    border-radius: 18px;
    padding: 36px;
    max-width: 740px;
    margin: 0 auto;
    text-align: left;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 640px) {
    .profile-card {
      padding: 24px;
    }
  }

  .profile-card__top {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }

  @media (max-width: 540px) {
    .profile-card__top {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
  }

  .profile-card__avatar-wrap {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 2px solid #E5C058;
    padding: 3px;
    flex-shrink: 0;
    background: #0B0B20;
  }

  .profile-card__avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-card__identity {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .profile-badge {
    background: rgba(229, 192, 88, 0.15);
    color: #E5C058;
    border: 1px solid rgba(229, 192, 88, 0.4);
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.8px;
    display: inline-block;
    align-self: flex-start;
  }

  @media (max-width: 540px) {
    .profile-badge {
      align-self: center;
    }
  }

  .profile-card__name {
    font-size: 24px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 4px 0 2px;
  }

  .profile-card__loc {
    font-size: 13px;
    color: #94A3B8;
  }

  .profile-card__bio {
    font-size: 13.5px;
    color: #CBD5E1;
    line-height: 1.6;
    margin: 0 0 24px;
  }

  /* Information Matrix (2x2 Grid) */
  .info-matrix-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  @media (min-width: 540px) {
    .info-matrix-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .info-mini-card {
    background: #1B1B3E;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .info-mini-card__label {
    font-size: 10px;
    font-weight: 700;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }

  .info-mini-card__val {
    font-size: 13.5px;
    font-weight: 600;
    color: #F8FAFC;
  }

  /* Action CTA Buttons */
  .profile-card__actions {
    display: grid;
