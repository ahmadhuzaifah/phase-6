---
/**
 * Property Dealer Profile Page — Ahmad Huzaifah
 * DHA Phase 6 Lahore Authority Platform
 * Designed to exactly match the reference authority dealer specification.
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';

const consultant = {
  name: 'Ahmad Huzaifah',
  title: 'PROPERTY DEALER',
  location: 'DHA Phase 6 Lahore',
  phone: '0325 7800001',
  phoneTel: '+923257800001',
  whatsappNumber: '0325 7800001',
  whatsappUrl: 'https://wa.me/923257800001?text=Salam%20Ahmad%20Huzaifah%2C%20I%20am%20interested%20in%20DHA%20Phase%206%20Lahore%20properties.',
  image: '/images/dealers/ahmad-huzaifah.png',
  bio: 'Contact Ahmad Huzaifah for property inquiries and viewing arrangements in DHA Phase 6 Lahore. Share the property title or your requirements when you call or send a WhatsApp message.',
  serviceArea: 'DHA Phase 6 Lahore',
  services: 'Property inquiries and viewing arrangements',
};

const pageSchema = {
  name: `Ahmad Huzaifah — Property Dealer in DHA Phase 6 Lahore`,
  description: `Contact Ahmad Huzaifah about properties and viewing arrangements in DHA Phase 6 Lahore.`,
  url: `${SITE.url}/property-dealer`,
};

const realEstateAgentSchema = {
  name: consultant.name,
  jobTitle: consultant.title,
  telephone: consultant.phoneTel,
  url: `${SITE.url}/property-dealer`,
  image: `${SITE.url}${consultant.image}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Main Boulevard, Phase 6, DHA Lahore',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Property Dealer',
      item: `${SITE.url}/property-dealer`,
    },
  ],
};

const buyerGuideSteps = [
  {
    icon: 'verified',
    title: 'Verify Registration',
    desc: 'Confirm the dealer and agency details before sharing documents or making a payment.',
  },
  {
    icon: 'star',
    title: 'Check Track Record',
    desc: 'Ask for recent DHA Phase 6 deals and references from past clients.',
  },
  {
    icon: 'users',
    title: 'Meet in Person',
    desc: 'Meet at the property or an agreed office before moving ahead with a deal.',
  },
  {
    icon: 'document',
    title: 'Verify Documents',
    desc: 'Check ownership, dues, allotment, and transfer documents through the relevant DHA office.',
  },
  {
    icon: 'currency',
    title: 'Agree on Commission',
    desc: 'Confirm the commission and payment terms in writing before the transaction.',
  },
  {
    icon: 'transfer',
    title: 'Use DHA Transfer',
    desc: 'Complete the transfer through the official DHA process and keep payment records.',
  },
];
---

<PageLayout
  title="DHA Phase 6 Lahore Property Dealers | Ahmad Huzaifah"
  description="Contact Ahmad Huzaifah about properties and viewing arrangements in DHA Phase 6 Lahore."
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="RealEstateAgent" data={realEstateAgentSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />

  <main class="dealer-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="dealer-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="dealer-breadcrumb__sep">&gt;</span>
        <span class="active">Property Dealer</span>
      </nav>

      <!-- Main Heading -->
      <header class="dealer-header">
        <h1 class="dealer-header__title">
          <span class="text-gold">DHA Phase 6 Lahore</span> Property Dealers
        </h1>
        <p class="dealer-header__subtitle">
          Contact Ahmad Huzaifah about properties and viewing arrangements in DHA Phase 6 Lahore.
        </p>
      </header>

      <!-- Main Dealer Profile Card -->
      <div class="profile-container">
        <div class="profile-card">
          <!-- Top Tag -->
          <div class="profile-badge-row">
            <span class="profile-badge">PROPERTY DEALER</span>
          </div>

          <!-- Avatar & Header Info -->
          <div class="profile-header-row">
            <div class="profile-avatar-wrap">
              <img
                src={consultant.image}
                alt={consultant.name}
                class="profile-avatar"
                width="90"
                height="90"
                loading="eager"
              />
            </div>
            <div class="profile-header-info">
              <h2 class="profile-name">{consultant.name}</h2>
              <p class="profile-sub">{consultant.location}</p>
            </div>
          </div>

          <!-- Bio Paragraph -->
          <p class="profile-bio">
            {consultant.bio}
          </p>

          <!-- 2x2 Information Grid -->
          <div class="info-matrix">
            <div class="info-box">
              <span class="info-box__label">SERVICE AREA</span>
              <strong class="info-box__value">{consultant.serviceArea}</strong>
            </div>
            <div class="info-box">
              <span class="info-box__label">SERVICES</span>
              <strong class="info-box__value">{consultant.services}</strong>
            </div>
            <div class="info-box">
              <span class="info-box__label">WHATSAPP</span>
              <strong class="info-box__value">{consultant.whatsappNumber}</strong>
            </div>
            <div class="info-box">
              <span class="info-box__label">CALL</span>
              <strong class="info-box__value">{consultant.phone}</strong>
            </div>
          </div>

          <!-- Dual Action Buttons -->
          <div class="action-buttons-row">
            <a
              href={consultant.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-dealer btn-dealer--whatsapp"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
              </svg>
              <span>WhatsApp {consultant.whatsappNumber}</span>
            </a>

            <a
              href={`tel:${consultant.phoneTel}`}
              class="btn-dealer btn-dealer--call"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Call {consultant.phone}</span>
            </a>
          </div>
        </div>

        <!-- Warning Alert Strip Below Card -->
        <div class="warning-pill">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="warning-icon">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>Check property ownership, dues, area, and transfer status before making a payment.</span>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════════════════════════════════
           BUYER'S GUIDE SECTION
           ══════════════════════════════════════════════════════════════════════════ -->
      <section class="guide-section">
        <div class="guide-header">
          <div class="guide-eyebrow">
            <span class="guide-eyebrow__dash">—</span>
            <span>BEFORE YOU DEAL</span>
            <span class="guide-eyebrow__dash">—</span>
          </div>
          <h2 class="guide-title">Buyer's Guide</h2>
          <p class="guide-subtitle">
            Use these checks before buying, selling, or renting a property.
          </p>
        </div>

        <div class="guide-grid">
          {
            buyerGuideSteps.map((step) => (
              <div class="guide-card">
                <div class="guide-card__icon-box">
                  {step.icon === 'verified' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#E5B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  )}
                  {step.icon === 'star' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#E5B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  )}
                  {step.icon === 'users' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#E5B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                  )}
                  {step.icon === 'document' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#E5B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                      <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                  )}
                  {step.icon === 'currency' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#E5B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="1" x2="12" y2="23"></line>
                      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                  )}
                  {step.icon === 'transfer' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#E5B842" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="9" y1="3" x2="9" y2="21"></line>
                      <path d="M9 12h12"></path>
                    </svg>
                  )}
                </div>
                <h3 class="guide-card__title">{step.title}</h3>
                <p class="guide-card__desc">{step.desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Published Note -->
      <div class="published-tag">
        Published: 10 August, 2026
      </div>
    </div>
  </main>
</PageLayout>

<style>
  /* ── Page Background & Base Layout ──────────────────────────────── */
  .dealer-page {
    background-color: #0d1227;
    min-height: 100vh;
    padding: 40px 0 80px;
    color: #ffffff;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
  }

  /* ── Breadcrumb ─────────────────────────────────────────────────── */
  .dealer-breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13.5px;
    color: #64748b;
    margin-bottom: 24px;
  }

  .dealer-breadcrumb a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .dealer-breadcrumb a:hover {
    color: #e5b842;
  }

  .dealer-breadcrumb__sep {
    color: #475569;
    font-size: 12px;
  }

  .dealer-breadcrumb .active {
    color: #94a3b8;
  }

  /* ── Page Header ────────────────────────────────────────────────── */
  .dealer-header {
    text-align: center;
    margin-bottom: 44px;
  }

  .dealer-header__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 12px;
    letter-spacing: -0.5px;
  }

  .text-gold {
    color: #e5b842;
  }

  .dealer-header__subtitle {
    font-size: 16px;
    color: #94a3b8;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* ── Profile Card Container ─────────────────────────────────────── */
  .profile-container {
    max-width: 780px;
    margin: 0 auto 70px;
  }

  .profile-card {
    position: relative;
    background: #141a33;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 18px;
    padding: 36px 40px 32px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  /* ── Top Badge ──────────────────────────────────────────────────── */
  .profile-badge-row {
    position: absolute;
    top: 28px;
    right: 32px;
  }

  .profile-badge {
    display: inline-block;
    border: 1px solid rgba(229, 184, 66, 0.4);
    background: rgba(229, 184, 66, 0.08);
    color: #e5b842;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    padding: 4px 12px;
    border-radius: 6px;
    text-transform: uppercase;
  }

  /* ── Profile Header Row ─────────────────────────────────────────── */
  .profile-header-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
  }

  .profile-avatar-wrap {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #e5b842;
    flex-shrink: 0;
    background: #0d1227;
  }

  .profile-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-header-info {
    flex: 1;
  }

  .profile-name {
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 4px;
    letter-spacing: -0.3px;
  }

  .profile-sub {
    font-size: 14.5px;
    color: #94a3b8;
    margin: 0;
    font-weight: 500;
  }

  /* ── Profile Bio ────────────────────────────────────────────────── */
  .profile-bio {
    font-size: 14.5px;
    color: #94a3b8;
    line-height: 1.65;
    margin: 0 0 24px;
  }

  /* ── Info Matrix (2x2) ──────────────────────────────────────────── */
  .info-matrix {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .info-box {
    background: #0d1227;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 16px 20px;
  }

  .info-box__label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .info-box__value {
    display: block;
    font-size: 14.5px;
    font-weight: 600;
    color: #ffffff;
  }

  /* ── Action Buttons ─────────────────────────────────────────────── */
  .action-buttons-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .btn-dealer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
  }

  .btn-dealer:hover {
    transform: translateY(-2px);
  }

  .btn-dealer--whatsapp {
    background: #10b981;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
  }

  .btn-dealer--whatsapp:hover {
    filter: brightness(1.08);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
  }

  .btn-dealer--call {
    background: #e5b842;
    color: #0c1024;
    box-shadow: 0 4px 16px rgba(229, 184, 66, 0.25);
  }

  .btn-dealer--call:hover {
    background: #f0c559;
    box-shadow: 0 6px 20px rgba(229, 184, 66, 0.4);
  }

  /* ── Warning Pill Below Card ────────────────────────────────────── */
  .warning-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 10px;
    padding: 12px 20px;
    margin-top: 20px;
    color: #cbd5e1;
    font-size: 13.5px;
    text-align: center;
  }

  .warning-icon {
    flex-shrink: 0;
  }

  /* ── Buyer's Guide Section ──────────────────────────────────────── */
  .guide-section {
    max-width: 960px;
    margin: 0 auto 60px;
  }

  .guide-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .guide-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e5b842;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .guide-title {
    font-size: clamp(28px, 3.5vw, 36px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px;
  }

  .guide-subtitle {
    font-size: 15px;
    color: #94a3b8;
    margin: 0;
  }

  /* ── Guide Cards Grid ───────────────────────────────────────────── */
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .guide-card {
    background: #141a33;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 28px 24px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .guide-card:hover {
    transform: translateY(-3px);
    border-color: rgba(229, 184, 66, 0.3);
  }

  .guide-card__icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(229, 184, 66, 0.1);
    border-radius: 10px;
    margin-bottom: 18px;
  }

  .guide-card__title {
    font-size: 17px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px;
  }

  .guide-card__desc {
    font-size: 13.5px;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  /* ── Published Tag ──────────────────────────────────────────────── */
  .published-tag {
    text-align: left;
    max-width: 960px;
    margin: 0 auto;
    font-size: 13px;
    color: #475569;
    padding-top: 10px;
  }

  /* ── Responsive Queries ─────────────────────────────────────────── */
  @media (max-width: 860px) {
    .guide-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .profile-card {
      padding: 28px 20px 24px;
    }

    .profile-badge-row {
      position: static;
      margin-bottom: 16px;
    }

    .profile-header-row {
      flex-direction: column;
      text-align: center;
    }

    .info-matrix {
      grid-template-columns: 1fr;
    }

    .action-buttons-row {
      grid-template-columns: 1fr;
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
