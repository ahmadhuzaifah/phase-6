<script>
  function setupDealerInteractions() {
    const closeBtn = document.getElementById('agentPopupClose');
    const popup = document.getElementById('agentContactPopup');
    if (closeBtn && popup) {
      closeBtn.addEventListener('click', () => {
        popup.style.display = 'none';
      });
    }

    const backToTop = document.getElementById('backToTop');
    if (backToTop) {
      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }

  setupDealerInteractions();
  document.addEventListener('astro:after-swap', setupDealerInteractions);
</script>
