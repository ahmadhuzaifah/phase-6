---
/**
 * Houses For Sale in Al Rehman Garden Phase 2 Lahore — Local SEO Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import Button from '@components/global/Button.astro';
import { SITE } from '@data/site';
import propertiesData from '@data/properties-import.json';

const houses = propertiesData.filter(
  (p) => (p.propertyType === 'house' || p.propertyType === 'villa') && p.purpose === 'sale'
);

const pageSchema = {
  name: 'Houses for Sale in DHA Phase 6 Lahore',
  description: 'Verified brand new 10 Marla, 1 & 2 Kanal designer houses and villas for sale in DHA Phase 6 Lahore.',
  url: `${SITE.url}/houses-for-sale-in-al-rehman-garden-phase-2-lahore`,
};
---

<PageLayout
  title="Houses for Sale in DHA Phase 6 Lahore — Verified Listings 2026"
  description="Find brand new 10 Marla, 1 & 2 Kanal houses and golf villas for sale in DHA Phase 6 Lahore. Ready possession double-story designer homes with verified titles."
>
  <Schema type="WebSite" data={pageSchema} />

  <section class="local-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Verified Ready Houses</div>
      <h1 class="local-hero__title">
        Houses for Sale in <span class="text-gradient-gold">DHA Phase 6 Lahore</span>
      </h1>
      <p class="local-hero__lead lead">
        Browse move-in ready designer houses, double-story executive residences, and Defence Raya golf villas built with solid structure and premium imported finishes.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Available Homes</span>
          <h2 class="section-header__title">Featured Houses For Sale</h2>
        </div>
        <Button href="/properties?type=house" variant="outline" size="sm">
          Filter by Bedrooms & Budget →
        </Button>
      </div>

      <div class="local-grid">
        {houses.map((prop) => (
          <PropertyCard
            title={prop.title}
            slug={prop.slug}
            propertyType={prop.propertyType}
            purpose={prop.purpose}
            price={prop.price}
            priceUnit={prop.priceUnit}
            size={prop.size}
            sizeUnit={prop.unit}
            block={prop.block}
            location={prop.location.address}
            image={prop.images && prop.images.length > 0 ? prop.images[0] : undefined}
            verificationStatus={prop.verificationStatus}
            availabilityStatus={prop.availabilityStatus}
            lastVerifiedDate={prop.lastVerifiedDate}
            isFeatured={prop.isFeatured}
          />
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .local-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .local-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .local-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .local-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .local-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .local-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
