---
import Schema from '@components/seo/Schema.astro';
import PageLayout from '@layouts/PageLayout.astro';
import properties from '@data/properties-import.json';
import { SITE } from '@data/site';
import { isActiveProperty } from '@utils/propertyLifecycle';
import { isPublishableProperty } from '@utils/propertyQualityScore';
import { createPriceRows, formatMarketPrice, type MarketProperty } from '@utils/marketIntelligence';

const active = (properties as MarketProperty[]).filter((property) => isPublishableProperty(property) && isActiveProperty(property));
const rows = createPriceRows(active);
const canonical = `${SITE.url}/dha-phase-6-property-prices/`;
const title = 'DHA Phase 6 Lahore Property Prices: 2015-2026 Trends';
const description = 'Research DHA Phase 6 Lahore property asking prices, current house and plot benchmarks, and a documented 2015-2026 development timeline.';
const timeline = [
  { year: 2015, index: 24, event: 'Early possession and construction activity broadened end-user attention.' },
  { year: 2016, index: 29, event: 'Road access and neighborhood development improved practical connectivity.' },
  { year: 2017, index: 35, event: 'More completed homes made street-level quality differences easier to compare.' },
  { year: 2018, index: 39, event: 'Commercial planning and daily-service coverage supported residential use.' },
  { year: 2019, index: 42, event: 'Buyer demand became more selective across sectors and plot positions.' },
  { year: 2020, index: 50, event: 'Construction demand and changing household preferences affected asking prices.' },
  { year: 2021, index: 65, event: 'Materials inflation and broad property demand lifted replacement-cost expectations.' },
  { year: 2022, index: 76, event: 'Macroeconomic volatility widened the gap between advertised and executable prices.' },
  { year: 2023, index: 79, event: 'High financing and construction costs shifted activity toward cash buyers.' },
  { year: 2024, index: 84, event: 'Commercial growth and mature occupancy supported established streets.' },
  { year: 2025, index: 92, event: 'Liquidity remained property-specific, with strong premiums for condition and access.' },
  { year: 2026, index: 100, event: 'Current source-referenced inventory provides a transparent asking-price baseline.' },
];
const points = timeline.map((item, index) => `${30 + index * 85},${250 - item.index * 2}`).join(' ');
const faqs = [
  { question: 'Are these registered sale prices?', answer: 'No. Current figures are averages of active source-referenced asking-price records. The historical chart is a normalized development narrative, not an official transaction index.' },
  { question: 'Why can two properties in one sector have different prices?', answer: 'Street width, orientation, plot category, exact position, construction quality, age, possession, documentation, dues and seller urgency can materially change value.' },
  { question: 'How should buyers verify a quoted price?', answer: 'Compare multiple recent and genuinely comparable properties, inspect the exact site, review documents and obtain independent professional advice before committing funds.' },
];
---

<PageLayout title={title} description={description} canonical={canonical}>
  <Schema type="BreadcrumbList" data={{ itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url }, { '@type': 'ListItem', position: 2, name: 'Property Prices', item: canonical }] }} />
  <Schema type="FAQPage" data={{ mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }} />
  <main class="prices-page"><header class="prices-hero"><div class="container"><nav><a href="/">Home</a><span>/</span><span>Property prices</span></nav><p>Historical context and current evidence</p><h1>DHA Phase 6 Lahore <em>Property Prices</em></h1><span>Understand the forces behind asking prices before comparing individual listings.</span></div></header>
    <div class="container prices-body">
      <section><div class="section-heading"><p>2015-2026 timeline</p><h2>A market shaped by development, access and occupancy</h2></div><div class="chart"><svg viewBox="0 0 1020 290" role="img" aria-labelledby="trend-title trend-desc"><title id="trend-title">Normalized DHA Phase 6 market development index</title><desc id="trend-desc">An editorial index rising from 24 in 2015 to 100 in 2026. It describes relative market maturity rather than transaction prices.</desc><line x1="30" y1="250" x2="990" y2="250"></line><polyline points={points}></polyline>{timeline.map((item, index) => <g><circle cx={30 + index * 85} cy={250 - item.index * 2} r="5"></circle><text x={30 + index * 85} y="275">{String(item.year).slice(2)}</text></g>)}</svg><small>Normalized editorial maturity index (2026 = 100). Not an official price index.</small></div><div class="timeline-grid">{timeline.map((item) => <article><strong>{item.year}</strong><span>Index {item.index}</span><p>{item.event}</p></article>)}</div></section>
      <section><div class="section-heading"><p>Current benchmarks</p><h2>Active asking-price evidence</h2></div><div class="price-grid">{rows.map((row) => <article><span>{row.label}</span><strong>{formatMarketPrice(row.average)}</strong><small>{formatMarketPrice(row.minimum)} - {formatMarketPrice(row.maximum)}</small><p>{row.count} records / {row.demand} dataset demand</p></article>)}</div></section>
      <section><div class="section-heading"><p>Market drivers</p><h2>What changed property expectations</h2></div><div class="driver-grid"><article><b>01</b><h3>Development milestones</h3><p>Possession, completed streets, occupied homes and functioning utilities progressively reduced development uncertainty. Mature streets can command a different asking profile from locations where construction intensity, access or services remain uneven.</p></article><article><b>02</b><h3>Commercial growth</h3><p>CCA areas, Main Boulevard activity, Defence Raya and wider retail access changed daily convenience. Proximity can support demand, but commercial traffic, noise and parking pressure may be disadvantages for some residential buyers.</p></article><article><b>03</b><h3>Road connectivity</h3><p>Bedian Road, Barki Road and links through the wider DHA network influence commute choices. Buyers should test routes at realistic travel times instead of relying on distance estimates alone.</p></article><article><b>04</b><h3>Demand changes</h3><p>Construction costs, taxation, financing conditions, currency changes and buyer confidence alter both asking prices and liquidity. An advertised increase does not prove that transactions cleared at the same level.</p></article></div></section>
      <section class="guidance"><div><p>Practical use</p><h2>Compare like with like</h2><p>Separate plots from completed houses, sale listings from rentals, and ordinary streets from premium categories. Use medians and ranges where possible, ask when each record was checked, then investigate outliers rather than averaging them blindly.</p></div><nav><a href="/dha-phase-6-property-market/">Open live market dashboard</a><a href="/compare-properties/">Compare individual properties</a><a href="/dha-phase-6-lahore-property-appreciation/">Read appreciation guide</a><a href="/verification-and-transfer/">Verify before buying</a></nav></section>
      <section><div class="section-heading"><p>Questions</p><h2>Price research FAQ</h2></div><div class="faqs">{faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
    </div>
  </main>
</PageLayout>

<style>
  .prices-page{background:#080f12;color:#e8f0ed}.prices-hero{padding:7.2rem 0 3.2rem;border-bottom:1px solid rgba(48,196,135,.18);background:radial-gradient(circle at 82% 50%,rgba(227,184,90,.12),transparent 24rem),linear-gradient(110deg,#071113,#0b2421)}.prices-hero nav{display:flex;gap:.55rem;margin-bottom:1.5rem;color:#6f8580;font-size:.75rem}.prices-hero nav a{color:#9db0aa}.prices-hero>div>p,.section-heading p,.guidance>div>p{margin:0 0 .55rem;color:#30c487;font-size:.67rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.prices-hero h1{max-width:900px;margin:0 0 1rem;color:#fff;font-family:var(--font-display,Georgia,serif);font-size:clamp(2.5rem,6vw,5rem);line-height:1}.prices-hero h1 em{color:#e3b85a;font-style:normal}.prices-hero>div>span{color:#9aada6}.prices-body{padding-top:4rem;padding-bottom:5rem}.prices-body>section{margin-bottom:4.5rem}.section-heading h2,.guidance h2{margin:0 0 1.4rem;color:#f2f7f5;font-family:var(--font-display,Georgia,serif);font-size:clamp(1.6rem,3vw,2.5rem)}.chart{padding:1rem;border:1px solid rgba(185,215,202,.14);border-radius:8px;background:#0d1b1e}.chart svg{width:100%;height:auto}.chart line{stroke:#32443f;stroke-width:1}.chart polyline{fill:none;stroke:#e3b85a;stroke-width:4}.chart circle{fill:#30c487;stroke:#071113;stroke-width:3}.chart text{fill:#7f928b;font-size:11px;text-anchor:middle}.chart small{display:block;color:#657871;font-size:.62rem}.timeline-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin-top:.8rem}.timeline-grid article,.driver-grid article,.price-grid article{padding:1rem;border:1px solid rgba(185,215,202,.13);border-radius:6px;background:#0d1b1e}.timeline-grid strong{color:#e3b85a}.timeline-grid span{margin-left:.5rem;color:#4fd49c;font-size:.6rem}.timeline-grid p,.driver-grid p{margin:.55rem 0 0;color:#869991;font-size:.7rem;line-height:1.6}.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.price-grid span,.price-grid strong,.price-grid small{display:block}.price-grid span{color:#7e918a;font-size:.65rem}.price-grid strong{margin:.35rem 0;color:#e3b85a;font-family:var(--font-display,Georgia,serif);font-size:1.35rem}.price-grid small{color:#a5b5af;font-size:.65rem}.price-grid p{margin:.7rem 0 0;color:#49d198;font-size:.61rem}.driver-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.driver-grid b{color:#30c487;font-size:.65rem}.driver-grid h3{margin:.6rem 0 0;color:#eef5f2}.guidance{display:grid;grid-template-columns:1.4fr 1fr;gap:2rem;padding:2rem;border:1px solid rgba(48,196,135,.25);border-radius:8px;background:linear-gradient(145deg,#132527,#0b171a)}.guidance p{color:#90a29b;line-height:1.7}.guidance nav{display:flex;flex-direction:column}.guidance a{padding:.65rem 0;border-bottom:1px solid rgba(185,215,202,.12);color:#50d69e;font-size:.75rem}.faqs details{margin-bottom:.65rem;padding:1rem;border:1px solid rgba(185,215,202,.13);background:#0d1b1e}.faqs summary{color:#e7efec;font-weight:800;cursor:pointer}.faqs p{color:#8b9e97;font-size:.78rem;line-height:1.65}@media(max-width:800px){.timeline-grid{grid-template-columns:repeat(2,1fr)}.price-grid{grid-template-columns:repeat(2,1fr)}.guidance{grid-template-columns:1fr}}@media(max-width:520px){.prices-hero{padding-top:6rem}.timeline-grid,.price-grid,.driver-grid{grid-template-columns:1fr}}
</style>
