---
/**
 * Al Rehman Garden Phase 2 Blocks Guide — Authority SEO Hub
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import BlockCard from '@components/blocks/BlockCard.astro';
import Button from '@components/global/Button.astro';
import { BLOCKS } from '@data/blocks';
import { CONTACTS } from '@data/contacts';

const faqs = [
  {
    question: 'How many blocks are in Al Rehman Garden Phase 2 Lahore?',
    answer: 'Al Rehman Garden Phase 2 features over 15 master-planned sectors including Block A (Executive), Block B, Block C (Commercial Broadway), Block D (Rose Garden), Block E, Block F, Mirabel Block, Royal Block, and Beverly Hills Block.',
  },
  {
    question: 'Which block in Al Rehman Garden Phase 2 has the highest possession rate?',
    answer: 'Block A (Executive) and Block B have 100% on-ground development and full residential possession with hundreds of families already living.',
  },
  {
    question: 'Which block is best for luxury villas and 1 Kanal plots?',
    answer: 'Mirabel Block and Beverly Hills Block are dedicated executive luxury sectors featuring 10 Marla and 1 Kanal villa plots with dedicated sports complexes and mini-golf amenities.',
  },
];

const faqSchema = {
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<PageLayout
  title="Al Rehman Garden Phase 2 Blocks & Sectors Guide 2026 — Masterplan & Status"
  description="Comprehensive guide to all blocks in Al Rehman Garden Phase 2 Lahore. Compare Block A, B, C, D, Mirabel, and Royal Block possession rates, plot sizes, and price trends."
>
  <Schema type="FAQPage" data={faqSchema} />

  <section class="auth-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Complete Sector Directory</div>
      <h1 class="auth-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">Blocks Guide</span>
      </h1>
      <p class="auth-hero__lead lead">
        An exhaustive sector-by-sector breakdown of all residential, commercial, and executive blocks in Al Rehman Garden Phase 2 Lahore.
      </p>
      <div class="auth-meta-bar">
        <span>📅 Last Updated: September 2026</span>
        <span>🛡️ Source: Official Developer Masterplan & Field Audits</span>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="blocks-grid-3col">
        {BLOCKS.map((b) => (
          <BlockCard
            name={b.name}
            slug={b.slug}
            category={b.category}
            status={b.status}
            possessionPercentage={b.possessionPercentage}
            description={b.description}
            plotSizes={b.plotSizes}
            plotTypes={b.plotTypes}
            features={b.features}
            locationHighlight={b.locationHighlight}
          />
        ))}
      </div>

      <!-- FAQ Accordion / List -->
      <div class="auth-faq-card">
        <h2 class="auth-faq-card__title">Frequently Asked Questions About Phase 2 Blocks</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <h3 class="faq-item__q">Q: {f.question}</h3>
              <p class="faq-item__a">{f.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Internal Navigation & CTAs -->
      <div class="auth-cta-box">
        <div>
          <h3>Looking for a specific plot in one of these blocks?</h3>
          <p>Our advisory team has verified on-ground plot inventory for all sectors.</p>
        </div>
        <div class="auth-cta-buttons">
          <Button href="/properties" variant="primary" size="md">Browse Property Listings</Button>
          <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--md">
            Ask on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .auth-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .auth-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .auth-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0 0 var(--space-4);
  }

  .auth-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: #F3D375;
  }

  .blocks-grid-3col {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .blocks-grid-3col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .blocks-grid-3col {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .auth-faq-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-8);
  }

  .auth-faq-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .faq-item__q {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .faq-item__a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .auth-cta-box {
    background: linear-gradient(135deg, #101F44 0%, #0A1128 100%);
    color: white;
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .auth-cta-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .auth-cta-box h3 {
    color: white;
    margin: 0 0 var(--space-1);
  }

  .auth-cta-box p {
    color: var(--color-neutral-300);
    font-size: var(--text-sm);
    margin: 0;
  }

  .auth-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    flex-shrink: 0;
  }
</style>
