---
/**
 * Terms and Conditions — Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const pageSchema = {
  name: `Terms & Conditions — ${SITE.name}`,
  description: 'Terms and conditions governing the use of Al Rehman Garden Phase 2 Lahore Real Estate Authority Portal.',
  url: `${SITE.url}/terms-and-conditions`,
};
---

<PageLayout
  title={`Terms & Conditions | ${SITE.name}`}
  description="Terms and conditions governing the use of Al Rehman Garden Phase 2 Lahore Real Estate Authority Portal. Read about listing verification rules, pricing volatility, and user responsibilities."
>
  <Schema type="WebSite" data={pageSchema} />

  <section class="legal-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Legal Framework</div>
      <h1 class="legal-hero__title">Terms & <span class="text-gradient-gold">Conditions</span></h1>
      <p class="legal-hero__lead lead">
        Effective date: September 1, 2026. Please read these terms carefully before utilizing our property directory and advisory services.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="legal-card">
        <div class="legal-prose">
          <h2>1. Acceptance of Terms</h2>
          <p>
            By accessing or browsing the <strong>Al Rehman Garden Phase 2 Lahore Authority Portal</strong> ({SITE.url}), you agree to be bound by these Terms and Conditions and all applicable laws and regulations of Pakistan. If you do not agree with any of these terms, you are prohibited from using or accessing this site.
          </p>

          <h2>2. Nature of the Platform</h2>
          <p>
            This portal operates as an <strong>independent real estate information hub and authorized property directory</strong>. While we strive for 100% data fidelity through our 4-Tier Verification Workflow, published rates, development timelines, and inventory availability are subject to rapid real estate market shifts.
          </p>

          <h2>3. Property Listings & Availability Disclaimer</h2>
          <ul>
            <li><strong>No Guaranteed Availability:</strong> Real estate plots and houses in mature sectors (such as Block A, B, C, D) are actively transacted in the open market. A listing displayed on our portal may be reserved or sold between periodic audit updates.</li>
            <li><strong>Price Sanity:</strong> Listed prices reflect demanded market rates or developer installment schedules at the time of publication. Actual closing values may vary based on corner location, boulevard frontage, park proximity, and immediate payment terms.</li>
            <li><strong>Mandatory Verification:</strong> Buyers are strongly advised to execute on-site physical visits and verify original allotment letters directly through the official society management office before making monetary advance transfers.</li>
          </ul>

          <h2>4. Intellectual Property & Permitted Use</h2>
          <p>
            All content on this website, including editorial block guides, sector maps, market analytics charts, branding vectors, and watermarked photography, is the intellectual property of the portal or its licensed contributors.
          </p>
          <p>
            You are granted a limited license to view and share links for personal, non-commercial property evaluation. You may not scrape, reproduce, republish, or commercially redistribute data or watermarked media without written permission.
          </p>

          <h2>5. Limitation of Liability</h2>
          <p>
            In no event shall {SITE.name}, its editors, verified brokers, or contributors be held liable for any direct, indirect, incidental, or consequential damages arising from property transactions, private bilateral agreements, or discrepancies between listed estimates and final registry closing rates.
          </p>

          <h2>6. Governing Law & Jurisdiction</h2>
          <p>
            These terms shall be governed by and construed in accordance with the laws of the Islamic Republic of Pakistan, and any disputes relating to these terms shall be subject to the exclusive jurisdiction of the courts of Lahore.
          </p>

          <div class="legal-contact-box">
            <strong>Inquiries & Legal Clarifications:</strong><br />
            {SITE.name} Advisory & Compliance Desk<br />
            {CONTACTS.address.full}<br />
            Email: {CONTACTS.email} • Helpline: {CONTACTS.phone.display}
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .legal-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .legal-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .legal-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .legal-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8) var(--space-10);
    box-shadow: var(--shadow-card);
    max-width: 900px;
    margin: 0 auto;
  }

  .legal-prose h2 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-8) 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }

  .legal-prose h2:first-of-type {
    margin-top: 0;
  }

  .legal-prose p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .legal-prose ul {
    margin: 0 0 var(--space-4) var(--space-6);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .legal-prose li {
    margin-bottom: var(--space-2);
  }

  .legal-contact-box {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin-top: var(--space-4);
  }
</style>
