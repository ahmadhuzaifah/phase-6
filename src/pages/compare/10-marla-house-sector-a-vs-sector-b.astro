---
import PropertyComparison from '@components/property/PropertyComparison.astro';
import Schema from '@components/seo/Schema.astro';
import PageLayout from '@layouts/PageLayout.astro';
import properties from '@data/properties-import.json';
import { SITE } from '@data/site';
import type { MarketProperty } from '@utils/marketIntelligence';
const records = properties as MarketProperty[];
const select = (sector: string) => records.find((property) => ['house', 'villa'].includes(property.propertyType) && property.size === '10' && property.unit === 'marla' && property.block === sector) || records.find((property) => ['house', 'villa'].includes(property.propertyType) && property.block === sector) || records[0];
const propertyA = select('Sector A'); const propertyB = select('Sector B');
const canonical = `${SITE.url}/compare/10-marla-house-sector-a-vs-sector-b/`;
const faqs = [{ question: 'Is Sector A always better than Sector B?', answer: 'No. Suitability depends on exact location, budget, property condition, access and buyer priorities. Compare individual properties and verify them independently.' }, { question: 'Are asking prices transaction prices?', answer: 'No. The displayed values are advertised demands from source-referenced records and may differ from a negotiated or registered price.' }];
---
<PageLayout title="10 Marla House Sector A vs Sector B | DHA Phase 6 Lahore" description="Compare representative 10 Marla house asking-price records in DHA Phase 6 Lahore Sector A and Sector B, including size, condition and verification dates." canonical={canonical}>
  <Schema type="BreadcrumbList" data={{ itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url }, { '@type': 'ListItem', position: 2, name: 'Compare Properties', item: `${SITE.url}/compare-properties/` }, { '@type': 'ListItem', position: 3, name: 'Sector A vs Sector B', item: canonical }] }} /><Schema type="FAQPage" data={{ mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }} />
  <main class="seo-compare"><header><div class="container"><p>Property comparison</p><h1>10 Marla House in Sector A vs Sector B</h1><span>A source-referenced starting point for comparing two established DHA Phase 6 Lahore sectors.</span></div></header><div class="container content"><PropertyComparison properties={[propertyA, propertyB]} initialA={propertyA} initialB={propertyB} interactive={false}/><section><h2>How to interpret this comparison</h2><p>A sector name alone does not determine value. Compare street width, orientation, nearby construction, park or commercial proximity, access route, age, approved drawings, renovation requirements and seller documentation. Use the records above as research leads, then inspect both locations.</p><div>{faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div><a href="/compare-properties/">Build another property comparison</a></section></div></main>
</PageLayout>
<style>.seo-compare{background:#080f12;color:#e8f0ed}.seo-compare>header{padding:7rem 0 3rem;background:linear-gradient(110deg,#071113,#0b2421)}header p{color:#30c487;font-size:.67rem;font-weight:850;text-transform:uppercase}header h1{max-width:900px;margin:.5rem 0 1rem;color:#fff;font-family:var(--font-display,Georgia,serif);font-size:clamp(2.3rem,6vw,4.6rem)}header span{color:#91a49e}.content{padding-top:3rem;padding-bottom:5rem}.content>section{margin-top:3rem;padding:1.5rem;border:1px solid rgba(185,215,202,.14);background:#0d1b1e}.content h2{color:#eef5f2;font-family:var(--font-display,Georgia,serif)}.content p{color:#8da099;line-height:1.7}.content details{padding:.8rem 0;border-bottom:1px solid rgba(185,215,202,.12)}.content summary{color:#dce6e2;font-weight:800;cursor:pointer}.content a{display:inline-block;margin-top:1rem;color:#4fd69e;font-weight:800}</style>
