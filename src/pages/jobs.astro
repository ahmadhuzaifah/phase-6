---
import GuidePage from '@components/content/GuidePage.astro';
---
<GuidePage
  title="Jobs in DHA Phase 6 Lahore"
  description="Find current DHA Lahore career opportunities and use a safe application checklist for jobs connected with DHA Phase 6 Lahore."
  eyebrow="Employment links"
  facts={[
    { label: 'Official source', value: 'DHA Lahore Careers' },
    { label: 'HR email shown', value: 'careers@dhalahore.org' },
    { label: 'Office context', value: 'Sector A, Phase VI' },
    { label: 'Listing status', value: 'Check live source' },
  ]}
  sections={[
    { heading: 'Use the official careers page', paragraphs: ['DHA Lahore publishes career opportunities and application guidance on its official careers page. Vacancies and deadlines change, so this independent portal does not copy a job into a permanent local listing. Open the live source before applying.'] },
    { heading: 'Application safety', paragraphs: ['Confirm that an advertisement links to an official DHA Lahore domain, verify the deadline and role requirements, and use the application method stated by DHA Lahore. Be cautious of unsolicited messages or payment requests.'], bullets: ['Check the publisher domain', 'Read the current eligibility criteria', 'Confirm the deadline', 'Keep copies of submitted documents', 'Do not pay an unofficial recruitment fee'] },
    { heading: 'Local private-sector work', paragraphs: ['Shops, offices, schools, healthcare providers and property businesses around Phase 6 may recruit independently. Those employers are separate from DHA Lahore and should be checked directly.'] },
  ]}
  faqs={[
    { question: 'Does this portal accept job applications?', answer: 'No. Use the application route stated on the official employer page.' },
    { question: 'Are jobs shown here guaranteed to remain open?', answer: 'No. Always check the live official careers page and deadline.' },
  ]}
  sources={[{ label: 'DHA Lahore official careers page', href: 'https://dhalahore.org/careers/' }]}
/>
