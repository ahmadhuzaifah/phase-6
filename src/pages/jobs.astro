          <a href="/sectors/">Sectors</a>
          <a href="/properties/">Properties</a>
          <a href="/places/">Places</a>
          <a href="/plots/">Plots</a>
          <a href="/jobs/" class="active" aria-current="page">Jobs</a>
          <a href="/dealers/">Dealers</a>
          <a href="/dha-phase-6-lahore-map/">Map</a>
          <a href="/dha-phase-6-lahore-map/#map-pdf-downloads" class="nav-cta">Map PDFs</a>
        </div>
        <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation menu" aria-controls="navLinks" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <!-- Page Hero -->
    <header class="page-hero">
      <div class="container">
        <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">›</span>
          <span aria-current="page">Jobs</span>
        </nav>
        <h1><span class="gold">DHA Phase 6 Lahore</span> Jobs</h1>
        <p class="page-hero-description">Browse {JOBS.length} openings from {employerCount} employers in Lahore and nearby areas.</p>
      </div>
    </header>

    <!-- Job Directory Section -->
    <section class="content-section bg-primary job-directory">
      <div class="container">
        <!-- Job Stats -->
        <div class="job-stats">
          <div class="glass-card">
            <strong>{JOBS.length}</strong>
            <span>Job openings</span>
          </div>
          <div class="glass-card">
            <strong>{employerCount}</strong>
            <span>Employers</span>
          </div>
          <div class="glass-card">
            <strong>{allTypes.length}</strong>
            <span>Job types</span>
          </div>
        </div>

        <!-- Job Search & Filter Toolbar -->
        <div class="job-tools glass-card" aria-label="Filter jobs">
          <label>
            <span>Search jobs</span>
            <input id="job-search" type="search" placeholder="Job title, company, or location" autocomplete="off">
          </label>
          <label>
            <span>Job type</span>
            <select id="job-type">
              <option value="">All job types</option>
              {allTypes.map((t) => (
                <option value={t.toLowerCase()}>{t}</option>
              ))}
            </select>
          </label>
        </div>

        <p class="job-result-count" id="job-result-count" aria-live="polite">Showing {JOBS.length} jobs</p>

        <!-- Job Cards Grid -->
        <div class="job-grid" id="job-grid">
          {JOBS.map((job) => (
            <article
              class="job-card glass-card"
              data-search={`${job.title} ${job.company} ${job.location} ${job.category}`.toLowerCase()}
              data-types={job.type.map((t) => t.toLowerCase()).join('|')}
            >
              <div class="job-card-topline">
                <span>{job.location}</span>
                <span class="job-badge">{job.officialDha ? 'Official DHA Source' : 'Easily apply'}</span>
              </div>
              <h2>
                <a href={`/jobs/${job.slug}/`}>{job.title}</a>
              </h2>
              <p class="job-company">
                {job.companyUrl ? (
                  <a class="job-company-search" href={job.companyUrl} target="_blank" rel="nofollow noopener noreferrer external" aria-label={`Search Google for ${job.company}`}>
                    {job.company}
                  </a>
                ) : (
                  <span>{job.company}</span>
                )}
              </p>
              <p class="job-date">Added <time datetime="2026-08-22">{job.publishedLabel}</time></p>
              <div class="job-tags">
                {job.type.map((t) => (
                  <span>{t}</span>
                ))}
                {job.compensation && <span>{job.compensation}</span>}
              </div>
              <p>{job.summary}</p>
              <a class="job-details-link" href={`/jobs/${job.slug}/`}>
                View job details <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>

        <div class="job-empty glass-card" id="job-empty" hidden>
          No jobs match these filters.
        </div>

        <!-- Safety Notice Card -->
        <aside class="job-notice glass-card">
          <h2>Before you apply</h2>
          <p>Confirm the role, pay, and work location with the employer. Do not pay a fee to apply for a job.</p>
        </aside>
      </div>
    </section>

    <!-- Publication Meta -->
    <aside class="page-publication-meta" aria-label="Page publication information">
      <div class="container">
        <span>Published <time datetime="2026-09-02T18:14:54+05:00">2 September 2026</time></span>
      </div>
    </aside>
  </main>

