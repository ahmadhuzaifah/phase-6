/**
 * DHA Phase 6 Lahore — Jobs Directory Page
 * Matching the exact structure, layout, aesthetic, and components requested.
 */
import { JOBS } from '@data/jobs';

const employerCount = new Set(JOBS.map((job) => job.company)).size;
const allTypes = [...new Set(JOBS.flatMap((job) => job.type))].sort();
