---
/**
 * Properties Directory — Al Rehman Garden Phase 2 Lahore
 * Full searchable property directory with multi-filter toolbar,
 * sorting, verified badges, and responsive layout.
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import { SITE } from '@data/site';
import { BLOCKS } from '@data/blocks';
import propertiesData from '@data/properties-import.json';

const collectionSchema = {
  name: `Properties for Sale & Rent in ${SITE.name}`,
  description: `Browse verified residential and commercial plots, houses, and shops in Al Rehman Garden Phase 2 Lahore.`,
  url: `${SITE.url}/properties`,
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Properties',
      item: `${SITE.url}/properties`,
    },
  ],
};
---

<PageLayout
  title={`Properties for Sale & Rent — ${SITE.name} Lahore`}
  description={`Browse verified residential plots, commercial plots, and houses for sale in Al Rehman Garden Phase 2 Lahore. Filter by block, size, and price.`}
>
  <Schema type="WebSite" data={collectionSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />

  <!-- Directory Header -->
  <section class="dir-header">
    <div class="container">
      <div class="dir-header__inner">
        <div class="eyebrow eyebrow--dark">ARG Phase 2 Property Directory</div>
        <h1 class="dir-header__title">Properties for Sale in Lahore</h1>
        <p class="dir-header__lead lead">
          Browse verified residential plots, commercial plots, luxury villas, and houses across all sectors of Al Rehman Garden Phase 2 on Main Sharaqpur Road.
        </p>
      </div>
    </div>
  </section>

  <!-- Directory Main Section (Filters + Grid) -->
  <section class="section section--alt" id="directory">
    <div class="container">
      <div class="dir-layout">
        <!-- Filter Sidebar -->
        <aside class="dir-sidebar" id="filter-sidebar" aria-label="Property Search Filters">
          <div class="filter-box">
            <div class="filter-box__header">
              <h2 class="filter-box__title">Filter Listings</h2>
              <button type="button" class="filter-box__clear" id="btn-clear-filters">Reset All</button>
            </div>

            <form class="filter-form" id="directory-filter-form">
              <!-- Search Keyword -->
              <div class="filter-group">
                <label for="filter-search" class="filter-label">Search Keyword</label>
                <div class="filter-search-wrap">
                  <input
                    type="text"
                    id="filter-search"
                    name="q"
                    placeholder="e.g. 5 Marla, Block A, Corner..."
                    class="filter-input"
                  />
                </div>
              </div>

              <!-- Purpose -->
              <div class="filter-group">
                <label for="filter-purpose" class="filter-label">Purpose</label>
                <select id="filter-purpose" name="purpose" class="filter-select">
                  <option value="">Any Purpose</option>
                  <option value="sale" selected>For Sale</option>
                  <option value="rent">For Rent</option>
                  <option value="lease">Commercial Lease</option>
                </select>
              </div>

              <!-- Property Type -->
              <div class="filter-group">
                <label for="filter-type" class="filter-label">Property Type</label>
                <select id="filter-type" name="type" class="filter-select">
                  <option value="">All Property Types</option>
                  <option value="residential-plot">Residential Plot</option>
                  <option value="commercial-plot">Commercial Plot</option>
                  <option value="house">House / Villa</option>
                  <option value="shop">Commercial Shop</option>
                  <option value="apartment">Apartment</option>
                </select>
              </div>

              <!-- Block / Sector -->
              <div class="filter-group">
                <label for="filter-block" class="filter-label">Block / Sector</label>
                <select id="filter-block" name="block" class="filter-select">
                  <option value="">All Society Blocks</option>
                  {BLOCKS.map((b) => (
                    <option value={b.name}>{b.name}</option>
                  ))}
                </select>
              </div>

              <!-- Plot Size -->
              <div class="filter-group">
                <label for="filter-size" class="filter-label">Plot / Property Size</label>
                <select id="filter-size" name="size" class="filter-select">
                  <option value="">Any Size</option>
                  <option value="3">3 Marla</option>
                  <option value="3.5">3.5 Marla</option>
                  <option value="5">5 Marla</option>
                  <option value="8">8 Marla</option>
                  <option value="10">10 Marla</option>
                  <option value="1">1 Kanal</option>
                </select>
              </div>

              <!-- Availability Status -->
              <div class="filter-group">
                <label for="filter-availability" class="filter-label">Availability Status</label>
                <select id="filter-availability" name="availability" class="filter-select">
                  <option value="" selected>All Statuses (Available, Reserved, Sold)</option>
                  <option value="available">Available Units Only</option>
                  <option value="reserved">Reserved / Under Token</option>
                  <option value="sold">Recently Sold Units</option>
                </select>
              </div>

              <!-- Price Range -->
              <div class="filter-group">
                <label for="filter-price" class="filter-label">Price Range (PKR)</label>
                <select id="filter-price" name="priceRange" class="filter-select">
                  <option value="">Any Price Range</option>
                  <option value="0-3000000">Under 30 Lakh</option>
                  <option value="3000000-6000000">30 Lakh to 60 Lakh</option>
                  <option value="6000000-10000000">60 Lakh to 1 Crore</option>
                  <option value="10000000-20000000">1 Crore to 2 Crore</option>
                  <option value="20000000+">2 Crore and Above</option>
                </select>
              </div>

              <!-- Verification Status -->
              <div class="filter-group filter-group--checkbox">
                <label class="filter-checkbox-label">
                  <input type="checkbox" id="filter-verified" name="verified" checked />
                  <span>Verified Listings Only</span>
                </label>
              </div>
            </form>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="dir-content">
          <!-- Active Filter Bar & Results Count -->
          <div class="dir-toolbar">
            <div class="dir-toolbar__count">
              Showing <strong id="results-count">{propertiesData.length}</strong> Available Properties in Phase 2
            </div>

            <div class="dir-toolbar__sort">
              <label for="sort-select" class="dir-toolbar__sort-label">Sort by:</label>
              <select id="sort-select" class="dir-toolbar__sort-select">
                <option value="featured">Featured First</option>
                <option value="price-asc">Price: Low to High</option>
                <option value="price-desc">Price: High to Low</option>
                <option value="newest">Newest Listed</option>
              </select>
            </div>
          </div>

          <!-- Empty State -->
          <div class="dir-empty" id="dir-empty" style="display: none; padding: 48px; background: white; border: 1px dashed var(--border-light); border-radius: var(--radius-xl); text-align: center; margin-bottom: 32px;">
            <div style="font-size: 40px; margin-bottom: 12px;">🔍</div>
            <h3 style="font-size: var(--text-lg); margin-bottom: 8px;">No properties match your current filters</h3>
            <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-bottom: 20px;">Try adjusting your price range, block selection, or clearing keyword search.</p>
            <button type="button" class="btn btn--primary btn--sm" id="btn-empty-reset">Reset All Filters</button>
          </div>

          <!-- Properties Grid -->
          <div class="dir-grid" id="properties-grid">
            {propertiesData.map((prop) => (
              <div
                class="property-item"
                data-title={prop.title.toLowerCase()}
                data-purpose={prop.purpose}
                data-type={prop.propertyType}
                data-block={prop.block}
                data-size={prop.size}
                data-price={prop.price}
                data-availability={prop.availabilityStatus || 'available'}
                data-verified={prop.verificationStatus}
                data-featured={prop.isFeatured ? 'true' : 'false'}
                data-date={prop.publishedDate}
              >
                <PropertyCard
                  title={prop.title}
                  slug={prop.slug}
                  propertyType={prop.propertyType}
                  purpose={prop.purpose}
                  price={prop.price}
                  priceUnit={prop.priceUnit}
                  size={prop.size}
                  sizeUnit={prop.unit}
                  block={prop.block}
                  location={prop.location.address}
                  verificationStatus={prop.verificationStatus}
                  availabilityStatus={prop.availabilityStatus}
                  lastVerifiedDate={prop.lastVerifiedDate}
                  isFeatured={prop.isFeatured}
                />
              </div>
            ))}
          </div>

          <!-- Bottom Help Notice -->
          <div class="dir-help-card">
            <div class="dir-help-card__icon">📞</div>
            <div class="dir-help-card__body">
              <h3 class="dir-help-card__title">Can't Find the Exact Plot You're Looking For?</h3>
              <p class="dir-help-card__text">
                Our property desk maintains direct contact with private plot owners, commercial plaza developers, and file allottees.
              </p>
            </div>
            <a
              href="https://wa.me/923000000000?text=Hello!%20I%20am%20looking%20for%20a%20specific%20property%20in%20Al%20Rehman%20Garden%20Phase%202."
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--accent btn--md"
            >
              Request Custom Plot
            </a>
          </div>
        </main>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* ── Header ─────────────────────────────────────────────────────── */
  .dir-header {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .dir-header__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .dir-header__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  /* ── Layout ─────────────────────────────────────────────────────── */
  .dir-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .dir-layout {
      grid-template-columns: 300px 1fr;
    }
  }

  /* ── Sidebar Filters ────────────────────────────────────────────── */
  .filter-box {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    position: sticky;
    top: 96px;
  }

  .filter-box__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .filter-box__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    margin: 0;
  }

  .filter-box__clear {
    background: none;
    border: none;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-primary-600);
    cursor: pointer;
  }

  .filter-box__clear:hover {
    text-decoration: underline;
  }

  .filter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .filter-label {
    font-size: 11.5px;
    font-weight: var(--font-bold);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .filter-input,
  .filter-select {
    width: 100%;
    padding: var(--space-2-5) var(--space-3);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    background-color: var(--color-neutral-50);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .filter-input:focus,
  .filter-select:focus {
    border-color: var(--color-primary-500);
    outline: none;
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.15);
  }

  .filter-group--checkbox {
    padding-top: var(--space-2);
  }

  .filter-checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    cursor: pointer;
  }

  /* ── Content & Grid ─────────────────────────────────────────────── */
  .dir-toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--bg-primary);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .dir-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .dir-toolbar__count {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .dir-toolbar__count strong {
    color: var(--color-primary-700);
  }

  .dir-toolbar__sort {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dir-toolbar__sort-label {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .dir-toolbar__sort-select {
    padding: var(--space-1-5) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .dir-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 640px) {
    .dir-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Help Notice */
  .dir-help-card {
    background: linear-gradient(135deg, #142147 0%, #0A1128 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.35);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    color: #FFFFFF;
    text-align: center;
  }

  @media (min-width: 768px) {
    .dir-help-card {
      flex-direction: row;
      text-align: left;
    }
  }

  .dir-help-card__icon {
    font-size: 36px;
    flex-shrink: 0;
  }

  .dir-help-card__body {
    flex-grow: 1;
  }

  .dir-help-card__title {
    font-size: var(--text-base);
    color: #FFFFFF;
    margin: 0 0 var(--space-1);
  }

  .dir-help-card__text {
    font-size: var(--text-xs);
    color: var(--color-neutral-300);
    margin: 0;
  }
</style>

<script>
  function initPropertyFilters() {
    const keywordInput = document.getElementById('filter-keyword') as HTMLInputElement | null;
    const purposeSelect = document.getElementById('filter-purpose') as HTMLSelectElement | null;
    const typeSelect = document.getElementById('filter-type') as HTMLSelectElement | null;
    const blockSelect = document.getElementById('filter-block') as HTMLSelectElement | null;
    const sizeSelect = document.getElementById('filter-size') as HTMLSelectElement | null;
    const priceSelect = document.getElementById('filter-price') as HTMLSelectElement | null;
    const availSelect = document.getElementById('filter-availability') as HTMLSelectElement | null;
    const verifiedCheck = document.getElementById('filter-verified') as HTMLInputElement | null;
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
    const clearBtn = document.getElementById('btn-clear-filters');
    const emptyResetBtn = document.getElementById('btn-empty-reset');
    const resultsCount = document.getElementById('results-count');
    const emptyState = document.getElementById('dir-empty');
    const grid = document.getElementById('properties-grid');

    if (!grid) return;

    const items = Array.from(grid.querySelectorAll('.property-item')) as HTMLElement[];

    function applyFilters() {
      const keyword = (keywordInput?.value || '').toLowerCase().trim();
      const purpose = purposeSelect?.value || '';
      const type = typeSelect?.value || '';
      const block = blockSelect?.value || '';
      const size = sizeSelect?.value || '';
      const priceRange = priceSelect?.value || '';
      const availability = availSelect?.value || '';
      const verifiedOnly = verifiedCheck?.checked ?? false;

      let visibleCount = 0;

      items.forEach((item) => {
        const itemTitle = item.dataset.title || '';
        const itemPurpose = item.dataset.purpose || '';
        const itemType = item.dataset.type || '';
        const itemBlock = item.dataset.block || '';
        const itemSize = item.dataset.size || '';
        const itemPrice = parseFloat(item.dataset.price || '0');
        const itemAvail = item.dataset.availability || '';
        const itemVerified = item.dataset.verified === 'verified';

        let matches = true;

        if (keyword && !itemTitle.includes(keyword) && !itemBlock.toLowerCase().includes(keyword)) {
          matches = false;
        }
        if (purpose && itemPurpose !== purpose) {
          matches = false;
        }
        if (type && itemType !== type) {
          matches = false;
        }
        if (block && itemBlock !== block) {
          matches = false;
        }
        if (size && itemSize !== size) {
          matches = false;
        }
        if (availability && itemAvail !== availability) {
          matches = false;
        }
        if (verifiedOnly && !itemVerified) {
          matches = false;
        }

        if (priceRange) {
          if (priceRange === '0-3000000' && itemPrice > 3000000) matches = false;
          else if (priceRange === '3000000-6000000' && (itemPrice < 3000000 || itemPrice > 6000000)) matches = false;
          else if (priceRange === '6000000-10000000' && (itemPrice < 6000000 || itemPrice > 10000000)) matches = false;
          else if (priceRange === '10000000-20000000' && (itemPrice < 10000000 || itemPrice > 20000000)) matches = false;
          else if (priceRange === '20000000+' && itemPrice < 20000000) matches = false;
        }

        if (matches) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (resultsCount) resultsCount.textContent = String(visibleCount);
      if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function applySort() {
      const sortVal = sortSelect?.value || 'featured';
      const sorted = [...items].sort((a, b) => {
        const priceA = parseFloat(a.dataset.price || '0');
        const priceB = parseFloat(b.dataset.price || '0');
        const featA = a.dataset.featured === 'true' ? 1 : 0;
        const featB = b.dataset.featured === 'true' ? 1 : 0;

        if (sortVal === 'price-asc') return priceA - priceB;
        if (sortVal === 'price-desc') return priceB - priceA;
        if (sortVal === 'featured') return featB - featA;
        return 0;
      });

      if (grid) {
        sorted.forEach((el) => grid.appendChild(el));
      }
    }

    function resetFilters() {
      if (keywordInput) keywordInput.value = '';
      if (purposeSelect) purposeSelect.value = '';
      if (typeSelect) typeSelect.value = '';
      if (blockSelect) blockSelect.value = '';
      if (sizeSelect) sizeSelect.value = '';
      if (priceSelect) priceSelect.value = '';
      if (availSelect) availSelect.value = '';
      if (verifiedCheck) verifiedCheck.checked = false;
      applyFilters();
    }

    [keywordInput, purposeSelect, typeSelect, blockSelect, sizeSelect, priceSelect, availSelect, verifiedCheck].forEach((el) => {
      el?.addEventListener('input', applyFilters);
      el?.addEventListener('change', applyFilters);
    });

    sortSelect?.addEventListener('change', applySort);
    clearBtn?.addEventListener('click', resetFilters);
    emptyResetBtn?.addEventListener('click', resetFilters);
  }

  document.addEventListener('DOMContentLoaded', initPropertyFilters);
</script>
