---
import PageLayout from '@layouts/PageLayout.astro';
import RequestPropertyForm from '@components/property/RequestPropertyForm.astro';
import properties from '@data/properties-import.json';
import priceHistory from '@data/property-price-history.json';
import places from '@data/google-places-import.json';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import { isPublishableProperty } from '@utils/propertyQualityScore';
import { getPropertyFreshness } from '@utils/propertyFreshness';
import { isActiveProperty, isRoutableProperty } from '@utils/propertyLifecycle';

export function getStaticPaths() {
  return properties
    .filter((property) => isPublishableProperty(property) && isRoutableProperty(property))
    .map((property) => ({ params: { slug: property.slug }, props: { property } }));
}

const { property } = Astro.props as { property: any };

const formatPrice = (price: number) =>
  price >= 10_000_000
    ? `PKR ${(price / 10_000_000).toFixed(2)} Crore`
    : `PKR ${(price / 100_000).toFixed(2)} Lakh`;
const formattedPrice = formatPrice(property.price);

const dateFormatter = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' });
const checkedAt = property.lastSeenAt || property.lastCheckedDate || property.lastVerifiedDate;
const checked = dateFormatter.format(new Date(checkedAt));
const verified = dateFormatter.format(new Date(property.lastVerifiedDate || checkedAt));
const freshness = getPropertyFreshness(checkedAt);
const availabilityStatus = property.availabilityStatus.toLowerCase();
const availabilityLabel =
  availabilityStatus === 'removed' ? 'EXPIRED' : availabilityStatus.toUpperCase();

const propId = property.id || `DHA6-${property.slug.substring(0, 8).toUpperCase()}`;
const inquiryContext = `Property ID: ${propId}; Sector: ${property.block}; Size: ${property.size} ${property.unit}; Type: ${property.propertyType.replaceAll('-', ' ')}`;
const whatsappNumber = CONTACTS.whatsapp.number.replace(/[^0-9]/g, '');
const whatsappUrl = (request: string) =>
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`${request}. ${inquiryContext}. Link: https://dhaphase6lahore.pk/properties/${property.slug}/`)}`;
const inquiryUrl = whatsappUrl(`I am interested in DHA Phase 6 Lahore property ${propId}`);
const priceUpdateUrl = whatsappUrl('Please send me the latest price update for this property');
const visitUrl = whatsappUrl('I would like to schedule a visit for this property');
const phoneUrl = `tel:${CONTACTS.phone.primary.replace(/[^+0-9]/g, '')}`;
const history =
  (
    priceHistory as Record<
      string,
      Array<{ date: string; price: number; previousPrice?: number | null; newPrice?: number }>
    >
  )[propId] || [];
const mapQuery = encodeURIComponent(
  property.location.coordinates
    ? `${property.location.coordinates.lat},${property.location.coordinates.lng}`
    : property.location.address,
);
const mapUrl = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const isHouse = ['house', 'villa'].includes(property.propertyType);
const isPlot = property.propertyType === 'residential-plot';
const priceGuideUrl = isHouse
  ? '/dha-phase-6-lahore-house-prices/'
  : isPlot
    ? '/dha-phase-6-lahore-plot-prices/'
    : '/dha-phase-6-commercial-areas/';
const sizeGuideMap: Record<string, string> = {
  'house-5-marla': '/5-marla-house-for-sale-dha-phase-6-lahore/',
  'house-10-marla': '/10-marla-house-for-sale-dha-phase-6-lahore/',
  'house-1-kanal': '/1-kanal-house-for-sale-dha-phase-6-lahore/',
  'residential-plot-5-marla': '/5-marla-plot-for-sale-dha-phase-6-lahore/',
  'residential-plot-10-marla': '/10-marla-plot-for-sale-dha-phase-6-lahore/',
  'residential-plot-1-kanal': '/1-kanal-plot-for-sale-dha-phase-6-lahore/',
};
const sizeGuideUrl = sizeGuideMap[`${property.propertyType}-${property.size}-${property.unit}`];

// Sector matching for places
const cleanSectorKey = property.block.toLowerCase().replace('sector ', 'sector-').trim();
const sectorKeyAliases: Record<string, string> = {
  'dha phase 6': '',
  'cca 1': 'cca',
  'cca 2': 'cca',
  'main boulevard': 'main-boulevard-commercial',
  'main boulevard commercial': 'main-boulevard-commercial',
  'raya commercial': 'raya-commercial',
  'defence raya': 'defence-raya',
};
const normalizedSectorKey = sectorKeyAliases[cleanSectorKey] ?? cleanSectorKey;
const hasResidentialSector = normalizedSectorKey.startsWith('sector-');
const sectorPropertiesUrl = normalizedSectorKey
  ? `/sectors/${normalizedSectorKey}/properties/`
  : '/properties/';
const nearbyPlacesUrl = normalizedSectorKey
  ? `/sectors/${normalizedSectorKey}/places/`
  : '/places/';
const sectorGuideUrl = hasResidentialSector
  ? `/dha-phase-6-${normalizedSectorKey}-lahore/`
  : '/dha-phase-6-lahore/';
const entityUrl = hasResidentialSector
  ? `/entities/dha-phase-6-${normalizedSectorKey}/`
  : sectorGuideUrl;
const sectorPlaces = places.filter(
  (p) => p.sector === normalizedSectorKey || p.sectorLabel?.toLowerCase().includes(cleanSectorKey),
);

const nearbySchools = places
  .filter(
    (p) =>
      (p.category === 'schools' || p.category === 'school') &&
      (p.sector === cleanSectorKey || sectorPlaces.includes(p)),
  )
  .slice(0, 3);
const nearbyHospitals = places
  .filter(
    (p) => p.category === 'hospitals' || p.category === 'hospital' || p.category === 'pharmacies',
  )
  .slice(0, 3);
const nearbyRestaurants = places
  .filter(
    (p) => p.category === 'restaurants' || p.category === 'restaurant' || p.category === 'cafes',
  )
  .slice(0, 3);

// Rank active alternatives by sector, type, size, then proportional price proximity.
const similarProperties = properties
  .filter((p) => p.slug !== property.slug && isActiveProperty(p))
  .sort((a, b) => {
    let scoreA = 0;
    let scoreB = 0;
    if (a.block === property.block) scoreA += 3;
    if (b.block === property.block) scoreB += 3;
    if (a.propertyType === property.propertyType) scoreA += 3;
    if (b.propertyType === property.propertyType) scoreB += 3;
    if (a.size === property.size) scoreA += 2;
    if (b.size === property.size) scoreB += 2;
    if (Math.abs(a.price - property.price) <= property.price * 0.2) scoreA += 1;
    if (Math.abs(b.price - property.price) <= property.price * 0.2) scoreB += 1;
    return scoreB - scoreA;
  })
  .slice(0, 3);

const mainImage = property.images?.[0]?.url || '/images/placeholders/property-placeholder.webp';
const imageAlt = property.images?.[0]?.alt || `${property.title} in DHA Phase 6 Lahore`;
const sourceUrl = property.sourceUrl;
const sourceLinkUrl = property.sourceLinkAllowed === false ? '' : sourceUrl;
const imageStatus =
  property.imageStatus || (mainImage.includes('/placeholders/') ? 'rejected' : 'approved');
const imageLabel =
  imageStatus === 'approved'
    ? 'Authorized property image'
    : imageStatus === 'watermarked'
      ? 'Source watermarked image'
      : imageStatus === 'branded'
        ? 'Source branded image'
        : 'No verified image available';

const canonical = `${SITE.url}/properties/${property.slug}/`;
const typeLabel = property.propertyType
  .replaceAll('-', ' ')
  .replace(/\b\w/g, (character: string) => character.toUpperCase());
const purposeLabel = property.purpose === 'rent' ? 'Rent' : 'Sale';
const pageTitle = `${property.size} ${property.unit.replace(/\b\w/g, (character: string) => character.toUpperCase())} ${typeLabel} for ${purposeLabel} in DHA Phase 6 Lahore ${property.block} | ${propId}`;
const pageDesc = `${property.size} ${property.unit} ${property.propertyType.replaceAll('-', ' ')} in ${property.block}, DHA Phase 6 Lahore. ${availabilityLabel}; advertised at ${formattedPrice}. Reference ${propId}, checked ${checked}.`;

const landmarkContext = `Located in prestigious ${property.block}, DHA Phase 6 Lahore, this ${property.size} ${property.unit} ${property.propertyType.replaceAll('-', ' ')} enjoys immediate proximity to key sector landmarks including Grand Jamia mosques, neighborhood parks, premier educational institutions, and arterial boulevards with direct access to Lahore Ring Road and Bedian Road.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'RealEstateListing',
      '@id': `${canonical}#listing`,
      name: property.title,
      description: property.description,
      url: canonical,
      datePosted: property.publishedDate || '2026-09-02',
      image: {
        '@type': 'ImageObject',
        contentUrl: `${SITE.url}${mainImage}`,
        caption: imageAlt,
      },
      offers: {
        '@type': 'Offer',
        price: property.price,
        priceCurrency: 'PKR',
        availability: ['sold', 'removed'].includes(availabilityStatus)
          ? 'https://schema.org/OutOfStock'
          : availabilityStatus === 'reserved'
            ? 'https://schema.org/LimitedAvailability'
            : 'https://schema.org/InStock',
        url: sourceLinkUrl || canonical,
      },
      spatialCoverage: { '@id': `${canonical}#place` },
    },
    {
      '@type': 'Place',
      '@id': `${canonical}#place`,
      name: `${property.block}, DHA Phase 6 Lahore`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: property.location.address,
        addressLocality: 'Lahore',
        addressRegion: 'Punjab',
        addressCountry: 'PK',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Properties', item: `${SITE.url}/properties/` },
        {
          '@type': 'ListItem',
          position: 3,
          name: property.block,
          item: `${SITE.url}${sectorPropertiesUrl}`,
        },
        { '@type': 'ListItem', position: 4, name: property.title, item: canonical },
      ],
    },
  ],
};
---

<PageLayout
  title={pageTitle}
  description={pageDesc}
  canonical={canonical}
  ogImage={mainImage}
  ogType="product"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <article class="property-detail-page">
    <header class="listing-hero">
      <div class="container">
        <nav class="listing-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/properties/">Properties</a><span>/</span><a
            href={sectorPropertiesUrl}>{property.block}</a
          >
        </nav>
        <div class="listing-badges">
          <span class="badge-sector">{property.block}</span>
          <span class="badge-type">{typeLabel}</span>
          <span class:list={['badge-avail', `badge-avail--${availabilityStatus}`]}
            >{availabilityLabel}</span
          >
          <span class:list={['badge-freshness', `badge-freshness--${freshness.key}`]}
            >{freshness.label}</span
          >
        </div>
        <h1 class="listing-title">{property.title}</h1>
        <p class="listing-location">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M20 10c0 5.5-8 11-8 11S4 15.5 4 10a8 8 0 1 1 16 0Z"></path><circle
              cx="12"
              cy="10"
              r="2.5"></circle></svg
          >
          {property.location.address}, DHA Phase 6, Lahore
        </p>
      </div>
    </header>

    <section class="listing-content">
      <div class="container">
        <div class="listing-grid">
          <div class="listing-main">
            <div
              class="gallery-container"
              data-property-gallery
              tabindex="0"
              aria-label={`${property.title} image gallery`}
            >
              <div class="gallery-main">
                <img
                  data-gallery-main
                  src={mainImage}
                  alt={imageAlt}
                  width={property.images?.[0]?.width || 1200}
                  height={property.images?.[0]?.height || 800}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  onerror="this.onerror=null;this.src='/images/placeholders/property-placeholder.webp'"
                />
                <span class="gallery-counter"
                  ><span data-gallery-current>1</span> / {property.images?.length || 1}</span
                >
                <span class="gallery-image-label">{imageLabel}</span>
              </div>
              {
                property.images?.length > 1 && (
                  <div class="gallery-thumbnails" aria-label="Choose property image">
                    {property.images.map((img: { url: string; alt?: string }, index: number) => (
                      <button
                        class:list={['gallery-thumbnail', { active: index === 0 }]}
                        type="button"
                        data-gallery-src={img.url}
                        data-gallery-alt={img.alt || `${property.title} image ${index + 1}`}
                        aria-label={`Show image ${index + 1}`}
                      >
                        <img
                          src={img.url}
                          alt=""
                          width="180"
                          height="112"
                          loading="lazy"
                          decoding="async"
                          onerror="this.onerror=null;this.src='/images/placeholders/property-placeholder.webp'"
                        />
                      </button>
                    ))}
                  </div>
                )
              }
            </div>

            <div class="price-card glass-card mobile-price-card">
              <span class="price-kicker">Advertised demand</span><strong>{formattedPrice}</strong>
              <p>{property.size} {property.unit} · For {purposeLabel}</p>
              <div class="price-actions">
                <a href={inquiryUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a><a
                  href={phoneUrl}>Call</a>
              </div>
            </div>

            <div class="listing-quick-stats">
              <div class="quick-stat">
                <span class="quick-icon">BR</span><div>
                  <strong>{property.bedrooms || 'N/A'}</strong><span>Bedrooms</span>
                </div>
              </div>
              <div class="quick-stat">
                <span class="quick-icon">BA</span><div>
                  <strong>{property.bathrooms || 'N/A'}</strong><span>Bathrooms</span>
                </div>
              </div>
              <div class="quick-stat">
                <span class="quick-icon">SZ</span><div>
                  <strong>{property.size} {property.unit}</strong><span>Area</span>
                </div>
              </div>
              <div class="quick-stat">
                <span class="quick-icon">PT</span><div>
                  <strong>{typeLabel}</strong><span>Property type</span>
                </div>
              </div>
            </div>

            <section class="listing-section" aria-labelledby="overview-heading">
              <h2 id="overview-heading">Overview</h2>
              <dl class="details-grid">
                <div><dt>Type</dt><dd>{typeLabel}</dd></div><div>
                  <dt>Purpose</dt><dd>For {purposeLabel}</dd>
                </div>
                <div><dt>Price</dt><dd class="highlight">{formattedPrice}</dd></div><div>
                  <dt>Sector</dt><dd>{property.block}</dd>
                </div>
                <div><dt>Bedroom(s)</dt><dd>{property.bedrooms || 'Not specified'}</dd></div><div>
                  <dt>Bath(s)</dt><dd>{property.bathrooms || 'Not specified'}</dd>
                </div>
                <div><dt>Area</dt><dd>{property.size} {property.unit}</dd></div><div>
                  <dt>Construction</dt><dd>
                    {
                      property.constructionStatus ||
                        property.condition ||
                        (isPlot ? 'Plot' : 'Not specified')
                    }
                  </dd>
                </div>
                <div><dt>Property ID</dt><dd class="code-id">{propId}</dd></div><div>
                  <dt>Last checked</dt><dd>{checked}</dd>
                </div>
              </dl>
            </section>

            <section class="listing-section" aria-labelledby="description-heading">
              <h2 id="description-heading">Property Description</h2>
              <div class="listing-description-text">
                <p>{property.description}</p><p>
                  <strong>Neighborhood setting:</strong>
                  {landmarkContext}
                </p>
              </div>
              <div class="feature-chips">
                {property.features.map((feature: string) => <span>{feature}</span>)}
                {property.floors && <span>{property.floors} floors</span>}
                {property.condition && <span>{property.condition}</span>}
              </div>
              <p class="source-notice">
                {
                  property.legalNotice ||
                    'Property information is collected from publicly available sources. Buyers should independently verify availability, ownership, and pricing before any transaction.'
                }
              </p>
            </section>

            <section class="listing-section location-section" aria-labelledby="location-heading">
              <h2 id="location-heading">Location &amp; Price History</h2>
              <div class="location-card">
                <div>
                  <strong>{property.block}, DHA Phase 6</strong><span
                    >{property.location.address}, Lahore, Punjab, Pakistan</span>
                </div>
              </div>
              <iframe
                src={mapUrl}
                title={`Map for ${property.title}`}
                width="800"
                height="360"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
              <p class="map-note">
                The map is based on the source address and may identify the sector rather than an
                exact plot.
              </p>
              <div class="history-strip">
                {
                  history.length > 0 ? (
                    history
                      .slice()
                      .reverse()
                      .slice(0, 3)
                      .map((entry) => (
                        <div>
                          <>
                            <time datetime={entry.date}>
                              {new Intl.DateTimeFormat('en-PK', { dateStyle: 'medium' }).format(
                                new Date(entry.date),
                              )}
                            </time>
                            <strong>{formatPrice(entry.price)}</strong>
                          </>
                        </div>
                      ))
                  ) : (
                    <p>No recorded price changes yet.</p>
                  )
                }
              </div>
            </section>

            <section class="listing-section" aria-labelledby="amenities-heading">
              <h2 id="amenities-heading">Nearby Facilities</h2>
              <div class="amenity-groups">
                <div>
                  <h3>Schools</h3>{
                    nearbySchools.length ? (
                      nearbySchools.map((place) => (
                        <a href={nearbyPlacesUrl}>
                          {place.name}
                          <small>{place.address}</small>
                        </a>
                      ))
                    ) : (
                      <p>
                        LGS, Beaconhouse and Roots Millennium campuses are accessible from Phase 6.
                      </p>
                    )
                  }
                </div>
                <div>
                  <h3>Healthcare</h3>{
                    nearbyHospitals.length ? (
                      nearbyHospitals.map((place) => (
                        <a href={nearbyPlacesUrl}>
                          {place.name}
                          <small>{place.address}</small>
                        </a>
                      ))
                    ) : (
                      <p>DHA Medical Centre and PKLI are accessible via Main Boulevard.</p>
                    )
                  }
                </div>
                <div>
                  <h3>Dining</h3>{
                    nearbyRestaurants.length ? (
                      nearbyRestaurants.map((place) => (
                        <a href={nearbyPlacesUrl}>
                          {place.name}
                          <small>{place.address}</small>
                        </a>
                      ))
                    ) : (
                      <p>CCA and Defence Raya dining districts are within easy reach.</p>
                    )
                  }
                </div>
              </div>
            </section>

            <section class="listing-section diligence-section" aria-labelledby="diligence-heading">
              <span class="section-label">Before you buy</span><h2 id="diligence-heading">
                Buyer Due Diligence
              </h2>
              <ol>
                <li>
                  <strong>Inspect the site:</strong> Confirm the location, street width, condition and
                  utilities on ground.
                </li><li>
                  <strong>Check title documents:</strong> Match the original allotment or transfer letter
                  with the seller's identity.
                </li><li>
                  <strong>Request the NDC:</strong> Confirm dues and development charges through official
                  DHA channels.
                </li><li>
                  <strong>Use the transfer office:</strong> Complete transfer procedures only through
                  the official DHA Lahore office.
                </li>
              </ol>
              <div class="inline-links">
                <a href="/verification-and-transfer/">Transfer verification guide</a><a
                  href="/dha-phase-6-property-calculator/">Calculate transfer costs</a>
              </div>
            </section>
          </div>

          <aside class="listing-sidebar">
            <div class="price-card glass-card">
              <span class="price-kicker">Advertised demand</span><strong>{formattedPrice}</strong><p
              >
                {property.size}
                {property.unit} · For {purposeLabel}
              </p>
              <div class="price-actions">
                <a href={inquiryUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a><a
                  href={phoneUrl}>Call</a>
              </div>
              <a
                class="secondary-action"
                href={priceUpdateUrl}
                target="_blank"
                rel="noopener noreferrer">Request Price Update</a
              >
              <a class="secondary-action" href={visitUrl} target="_blank" rel="noopener noreferrer"
                >Schedule Visit</a
              >
            </div>

            <div class="verification-card glass-card">
              <span class="verification-eyebrow">Property Information Verified</span><h2>
                Source Check &amp; Availability
              </h2>
              <p class="verification-copy">
                Listing facts were checked against the cited source. This does not certify legal
                title or ownership.
              </p>
              <dl>
                <div>
                  <dt>Availability</dt><dd class:list={[`status--${availabilityStatus}`]}>
                    {availabilityLabel}
                  </dd>
                </div><div><dt>Verified date</dt><dd>{verified}</dd></div><div>
                  <dt>Last checked</dt><dd>{checked}</dd>
                </div><div><dt>Freshness</dt><dd>{freshness.label}</dd></div><div>
                  <dt>Source</dt><dd>{property.source || 'Public market record'}</dd>
                </div><div><dt>Quality score</dt><dd>{property.qualityScore || 60}/100</dd></div>
              </dl>
              {
                sourceLinkUrl && (
                  <a
                    class="source-link"
                    href={sourceLinkUrl}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                  >
                    View original source
                  </a>
                )
              }
              <small
                >Independent zero-commission information portal. Confirm ownership, dues, condition,
                price and availability before committing funds.</small
              >
            </div>

            <nav class="knowledge-card glass-card" aria-label="Related property guides">
              <span class="section-label">Explore related pages</span><h2>
                Property Knowledge Hub
              </h2>
              <a href={sectorGuideUrl}>{property.block} guide <span>→</span></a><a href={entityUrl}
                >{property.block} profile <span>→</span></a
              ><a href={priceGuideUrl}>Relevant price guide <span>→</span></a>{
                sizeGuideUrl && (
                  <a href={sizeGuideUrl}>
                    {property.size} {property.unit} guide <span>→</span>
                  </a>
                )
              }<a href={nearbyPlacesUrl}>Nearby Places Directory <span>→</span></a><a
                href="/dha-phase-6-property-market/">Market analysis <span>→</span></a
              ><a href="/best-sector-to-invest-in-dha-phase-6-lahore/">Investment guide <span>→</span></a
              ><a href="/verification-and-transfer/">Verification process <span>→</span></a>
            </nav>
          </aside>
        </div>
      </div>
    </section>

    {
      similarProperties.length > 0 && (
        <section class="similar-properties">
          <div class="container">
            <>
              <span class="section-label">You may also like</span>
              <div class="similar-heading">
                <>
                  <h2>Similar Properties in DHA Phase 6</h2>
                  <a href={sectorPropertiesUrl}>View more in {property.block} →</a>
                </>
              </div>
              <div class="similar-track">
                {similarProperties.map((similar) => (
                  <article class="similar-card glass-card">
                    <a class="similar-image" href={`/properties/${similar.slug}`}>
                      <img
                        src={
                          similar.images?.[0]?.url ||
                          '/images/placeholders/property-placeholder.webp'
                        }
                        alt={similar.images?.[0]?.alt || similar.title}
                        width={similar.images?.[0]?.width || 800}
                        height={similar.images?.[0]?.height || 560}
                        loading="lazy"
                        decoding="async"
                        onerror="this.onerror=null;this.src='/images/placeholders/property-placeholder.webp'"
                      />
                      <span>{similar.block}</span>
                    </a>
                    <div class="similar-body">
                      <strong>{formatPrice(similar.price)}</strong>
                      <h3>
                        <a href={`/properties/${similar.slug}`}>{similar.title}</a>
                      </h3>
                      <p>
                        {similar.bedrooms ? `${similar.bedrooms} Beds · ` : ''}
                        {similar.bathrooms ? `${similar.bathrooms} Baths · ` : ''}
                        {similar.size} {similar.unit}
                      </p>
                      <a class="view-property" href={`/properties/${similar.slug}`}>
                        View property →
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </>
          </div>
        </section>
      )
    }
