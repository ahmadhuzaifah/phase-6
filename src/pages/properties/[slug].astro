---
import GuidePage from '@components/content/GuidePage.astro';
import properties from '@data/properties-import.json';

export function getStaticPaths() {
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }));
}

const { property } = Astro.props;
const formattedPrice = property.price >= 10_000_000
  ? `PKR ${(property.price / 10_000_000).toFixed(2)} Crore`
  : `PKR ${(property.price / 100_000).toFixed(2)} Lakh`;
const checked = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' }).format(new Date(property.lastCheckedDate));
const contactUrl = `https://wa.me/923257800001?text=${encodeURIComponent(`Please help me verify: ${property.title}`)}`;
---

<GuidePage
  title={property.title}
  metaTitle={`${property.title} | DHA Phase 6 Lahore`}
  description={property.description}
  eyebrow="Source-referenced asking-price snapshot"
  updated={checked}
  facts={[
    { label: 'Advertised demand', value: formattedPrice },
    { label: 'Size', value: `${property.size} ${property.unit}` },
    { label: 'Location', value: property.block },
    { label: 'Status', value: 'Source check required' },
  ]}
  sections={[
    {
      heading: 'What this record means',
      paragraphs: [
        property.description,
        'This page is a research record, not an offer by this website and not a confirmation that the property remains available. The amount is the advertised demand observed on the linked source, not a registered transaction price or formal valuation.',
      ],
    },
    {
      heading: 'Details recorded from the source',
      paragraphs: ['The following limited details were retained so buyers can compare market advertisements without republishing third-party listing photography.'],
      bullets: [...property.features, `Property type: ${property.propertyType.replaceAll('-', ' ')}`, `Purpose: ${property.purpose}`],
    },
    {
      heading: 'Checks to complete before payment',
      paragraphs: ['Open the source to check whether the advertisement is still active. Then independently confirm seller identity, allocation or title documents, exact plot or house location, DHA dues, NDC and transfer requirements. Inspect the property and use qualified legal or technical advice where appropriate.'],
      bullets: ['Match the plot or house number with original documents', 'Confirm ownership and seller authority', 'Check dues, restrictions and transfer costs', 'Inspect the site and surrounding land use', 'Do not pay solely on the basis of an online advertisement'],
    },
    {
      heading: 'Request help with verification',
      paragraphs: [`The independent property desk can help organize a market comparison or site visit. Use the contact page or open WhatsApp: ${contactUrl}`],
    },
  ]}
  sources={[{ label: `Original public listing source: ${property.source}`, href: property.sourceURL }]}
/>
