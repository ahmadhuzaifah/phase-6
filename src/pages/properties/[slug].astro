</style>

<script is:inline>
  document.querySelectorAll('[data-property-gallery]').forEach((gallery) => {
    const mainImage = gallery.querySelector('[data-gallery-main]');
    const current = gallery.querySelector('[data-gallery-current]');
    const thumbnails = [...gallery.querySelectorAll('[data-gallery-src]')];

    const showImage = (thumbnail, index) => {
      if (!(mainImage instanceof HTMLImageElement) || !(thumbnail instanceof HTMLElement)) return;
      const source = thumbnail.dataset.gallerySrc;
      if (!source) return;
      mainImage.style.opacity = '0.3';
      mainImage.src = source;
      mainImage.alt = thumbnail.dataset.galleryAlt || mainImage.alt;
      mainImage.addEventListener(
        'load',
        () => {
          mainImage.style.opacity = '1';
        },
        { once: true },
      );
      thumbnails.forEach((item) => item.classList.remove('active'));
      thumbnail.classList.add('active');
      if (current) current.textContent = String(index + 1);
    };

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => showImage(thumbnail, index));
    });
  });
</script>

<script
  is:inline
  define:vars={{
    viewedItem: {
      slug: property.slug,
      title: property.title,
      block: property.block,
      price: formattedPrice,
      image: mainImage,
    },
  }}
>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      let recent = JSON.parse(localStorage.getItem('dha6_recent_views') || '[]');
      recent = recent.filter((item) => item.slug !== viewedItem.slug);
      recent.unshift(viewedItem);
      if (recent.length > 6) recent = recent.slice(0, 6);
      localStorage.setItem('dha6_recent_views', JSON.stringify(recent));
    } catch {
      // Local storage may be unavailable in privacy-restricted browsers.
    }
  });
</script>
