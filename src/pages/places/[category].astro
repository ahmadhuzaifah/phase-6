---
/**
 * DHA Phase 6 Lahore — Category Places Page
 * Handles /places/[category]/ for all 41 place categories.
 */
import { PLACE_CATEGORIES, PLACES_DATA, type PlaceCategoryMeta } from '@data/places';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return PLACE_CATEGORIES.map((category) => ({
    params: { category: category.key },
    props: { categoryMeta: category },
  }));
}

interface Props {
  categoryMeta: PlaceCategoryMeta;
}

const { categoryMeta } = Astro.props;

// Filter places matching this category or fallback
const places = PLACES_DATA.filter((place) => place.category === categoryMeta.key);

const sectors = ['Sector A', 'Sector B', 'Sector C', 'Sector D', 'Sector E', 'Sector F', 'Sector G', 'Sector H', 'Sector J', 'Sector K', 'Sector L', 'Sector M', 'Sector N'];
const canonical = `${SITE.url}/places/${categoryMeta.key}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: categoryMeta.seoTitle,
      description: categoryMeta.seoDesc,
      inLanguage: 'en-PK',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      mainEntity: { '@id': `${canonical}#directory` },
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
        { '@type': 'ListItem', position: 3, name: categoryMeta.label, item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#directory`,
      name: `${categoryMeta.label} in DHA Phase 6 Lahore`,
      numberOfItems: places.length,
      itemListElement: places.map((place, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'LocalBusiness',
          '@id': `${SITE.url}/places/${place.category}/${place.slug}/`,
          name: place.name,
          url: `${SITE.url}/places/${place.category}/${place.slug}/`,
          ...(place.images[0] ? { image: place.images[0] } : {}),
          ...(place.phone ? { telephone: place.phone } : {}),
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            addressCountry: 'PK',
          },
          ...(place.rating && place.reviewCount > 0 ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: place.rating,
              reviewCount: place.reviewCount,
              bestRating: 5,
            },
          } : {}),
        },
      })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en-PK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a1a">

  <!-- SEO -->
  <title>{categoryMeta.seoTitle}</title>
  <meta name="description" content={categoryMeta.seoDesc}>
  <meta name="keywords" content={`${categoryMeta.label}, DHA Phase 6 Lahore, Phase 6 places, ${categoryMeta.key}`}>
  <meta name="author" content="DHA Phase 6 Lahore Guide">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="en-PK" href={canonical}>
  <link rel="alternate" hreflang="x-default" href={canonical}>

  <!-- Open Graph -->
  <meta property="og:title" content={categoryMeta.seoTitle}>
  <meta property="og:description" content={categoryMeta.seoDesc}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="DHA Phase 6 Lahore">
  <meta property="og:locale" content="en_PK">
  <meta property="og:image" content="/images/hero-bg.png">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'&gt;&lt;rect width='100' height='100' rx='16' fill='%23d4a844'/&gt;&lt;text x='50' y='66' font-size='48' text-anchor='middle' font-family='serif' font-weight='bold' fill='%230a0a1a'&gt;D6&lt;/text&gt;&lt;/svg&gt;">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <!-- Header -->
  <header class="site-header">
    <nav class="navbar" id="navbar" aria-label="Primary navigation">
      <div class="container">
        <a href="/" class="nav-logo" aria-label="DHA Phase 6 Lahore home">
          <div class="nav-logo-icon">D6</div>
          DHA Phase <span>6</span> Lahore
        </a>
        <div class="nav-links" id="navLinks">
          <a href="/">Home</a>
          <a href="/sectors/">Sectors</a>
          <a href="/properties/">Properties</a>
          <a href="/places/" class="active" aria-current="page">Places</a>
          <a href="/plots/">Plots</a>
          <a href="/jobs/">Jobs</a>
          <a href="/dealers/">Dealers</a>
          <a href="/dha-phase-6-lahore-map/">Map</a>
          <a href="/dha-phase-6-lahore-map/#map-pdf-downloads" class="nav-cta">Map PDFs</a>
        </div>
        <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation menu" aria-controls="navLinks" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <!-- Category Hero -->
    <header class="page-hero">
      <div class="container">
        <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/places/">Places</a>
          <span class="breadcrumb-sep">›</span>
          <span aria-current="page">{categoryMeta.label}</span>
        </nav>
        <h1><span class="gold">{categoryMeta.label}</span> in DHA Phase 6 Lahore</h1>
        <p class="page-hero-description">{categoryMeta.introText}</p>
      </div>
    </header>

    <!-- Places Content Section -->
    <section class="content-section bg-primary">
      <div class="container">
        {places.length > 0 ? (
          <div class="cat-grid">
            {places.map((place) => (
              <article class="place-card glass-card">
                <span class="place-tag">{place.categoryLabel}</span>
                <h2>
                  <a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a>
                </h2>
                <p class="place-meta">{place.distance} • {place.travelTime}</p>
                <p class="place-desc">{place.description}</p>
                <ul class="place-features">
                  {place.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
                <div class="place-actions">
                  <a
                    class="map-link"
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.name + ' ' + place.address)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open Live Google Map ↗
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="category-overview-card glass-card">
            <h2>Category Guide: {categoryMeta.label}</h2>
            <p>{categoryMeta.seoDesc}</p>
            <p>Commercial hubs in CCA 1 (Sector C), CCA 2 (Sector J), and Main Boulevard Phase 6 host multiple top-rated {categoryMeta.label.toLowerCase()} facilities.</p>
            
            <div style="margin-top: 24px;">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(categoryMeta.label + ' DHA Phase 6 Lahore')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                Search {categoryMeta.label} on Google Maps ↗
              </a>
            </div>
          </div>
        )}

        <!-- Sector Level Filter Links -->
        <div class="sector-filter-box glass-card" style="margin-top: 48px; padding: 28px;">
          <h3 style="color: var(--clr-accent-gold); margin-bottom: 14px; font-family: var(--ff-heading);">Browse {categoryMeta.label} by Sector</h3>
          <p style="color: var(--clr-text-secondary); margin-bottom: 18px; font-size: 0.92rem;">Filter {categoryMeta.label.toLowerCase()} facilities located across individual sectors in DHA Phase 6 Lahore:</p>
          <div class="sector-buttons-grid">
            {sectors.map((sec) => {
              const secSlug = sec.toLowerCase().replace(' ', '-');
              return (
                <a href={`/sectors/${secSlug}/places/${categoryMeta.key}/`} class="sector-btn">
                  {sec}
                </a>
              );
            })}
          </div>
        </div>

        <div style="margin-top: 36px; text-align: center;">
          <a href="/places/" class="job-back-link" style="display: inline-block;">
            ← Back to Places Directory
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer" id="footer">
    <div class="container">
      <div class="footer-bottom">
        <div class="footer-copyright">&copy; 2026 DHA Phase 6 Lahore Guide. All rights reserved.</div>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --clr-bg-primary: #0a0a1a;
    --clr-bg-secondary: #111128;
    --clr-accent-gold: #d4a844;
    --clr-accent-gold-light: #f0c95c;
    --clr-text-primary: #f0f0f5;
    --clr-text-secondary: #9a9ab5;
    --clr-text-muted: #6a6a85;
    --clr-glass: rgba(255, 255, 255, 0.04);
    --clr-glass-border: rgba(255, 255, 255, 0.08);
    --grad-gold: linear-gradient(135deg, #d4a844, #f0c95c);
    --ff-heading: 'Inter', sans-serif;
    --ff-body: 'Inter', sans-serif;
  }
  body {
    background-color: var(--clr-bg-primary);
    color: var(--clr-text-primary);
    font-family: var(--ff-body);
    line-height: 1.7;
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .glass-card {
    background: var(--clr-glass);
    border: 1px solid var(--clr-glass-border);
    border-radius: 12px;
    backdrop-filter: blur(14px);
  }
  .page-hero {
    padding: 140px 0 50px;
    background: var(--clr-bg-secondary);
    border-bottom: 1px solid var(--clr-glass-border);
    text-align: center;
  }
  .page-hero-breadcrumb {
    color: var(--clr-text-muted);
    font-size: 0.85rem;
    margin-bottom: 16px;
  }
  .page-hero h1 {
    font-family: var(--ff-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin-bottom: 12px;
  }
  .gold {
    background: var(--grad-gold);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-hero-description {
    color: var(--clr-text-secondary);
    max-width: 650px;
    margin: 0 auto;
  }
  .content-section {
    padding: 60px 0;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .place-card {
    padding: 28px;
  }
  .place-tag {
    color: var(--clr-accent-gold);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .place-card h2 {
    font-family: var(--ff-heading);
    font-size: 1.35rem;
    margin: 8px 0;
  }
  .place-card h2 a:hover {
    color: var(--clr-accent-gold);
  }
  .place-meta {
    color: var(--clr-text-muted);
    font-size: 0.82rem;
    margin-bottom: 12px;
  }
  .place-desc {
    color: var(--clr-text-secondary);
    font-size: 0.92rem;
  }
  .place-features {
    margin: 14px 0;
    padding-left: 20px;
    color: var(--clr-text-secondary);
    font-size: 0.88rem;
  }
  .map-link {
    display: inline-block;
    color: var(--clr-accent-gold);
    font-weight: 700;
    font-size: 0.88rem;
  }
  .category-overview-card {
    padding: 32px;
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
  }
  .category-overview-card h2 {
    color: var(--clr-accent-gold);
    margin-bottom: 12px;
    font-family: var(--ff-heading);
  }
  .btn-primary {
    background: var(--grad-gold);
    color: #0a0a1a;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 8px;
    display: inline-block;
  }
  .sector-buttons-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .sector-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--clr-glass-border);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--clr-text-secondary);
  }
  .sector-btn:hover {
    border-color: var(--clr-accent-gold);
    color: var(--clr-accent-gold);
  }
  .site-header {
    position: relative;
    z-index: 1000;
  }
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(10, 10, 26, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--clr-glass-border);
    padding: 14px 0;
  }
  .navbar .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .nav-logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--grad-gold);
    color: #0a0a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }
  .nav-links {
    display: flex;
    gap: 24px;
  }
  .nav-links a {
    color: var(--clr-text-secondary);
    font-size: 0.9rem;
  }
  .nav-links a.active {
    color: var(--clr-accent-gold);
  }
  .nav-cta {
    background: var(--grad-gold) !important;
    color: #0a0a1a !important;
    padding: 8px 18px !important;
    border-radius: 8px;
    font-weight: 700 !important;
  }
  .footer-bottom {
    border-top: 1px solid var(--clr-glass-border);
    padding: 24px 0;
    text-align: center;
    color: var(--clr-text-muted);
    font-size: 0.82rem;
  }
  @media (max-width: 768px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
