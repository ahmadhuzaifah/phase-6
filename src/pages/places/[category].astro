---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { PLACE_CATEGORIES, PLACES_DATA, type PlaceCategoryMeta } from '@data/places';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return PLACE_CATEGORIES.map((category) => ({ params: { category: category.key }, props: { categoryMeta: category } }));
}

interface Props { categoryMeta: PlaceCategoryMeta }
const { categoryMeta } = Astro.props;
const places = PLACES_DATA.filter((place) => place.category === categoryMeta.key);
const itemListSchema = {
  itemListElement: places.map((place,index)=>({ '@type':'ListItem', position:index+1, name:place.name, url:`${SITE.url}/places/${place.category}/${place.slug}` })),
};
---

<PageLayout title={categoryMeta.seoTitle} description={categoryMeta.seoDesc}>
  <Schema type="ItemList" data={itemListSchema} />
  <header class="cat-hero"><div class="container"><a href="/places">Places directory</a><p>{categoryMeta.icon} {categoryMeta.label}</p><h1>{categoryMeta.seoTitle}</h1><span>{categoryMeta.introText}</span></div></header>
  <section class="cat-section"><div class="container">
    <div class="cat-grid">{places.map((place)=><article class="place-card"><p>{place.categoryLabel}</p><h2><a href={`/places/${place.category}/${place.slug}`}>{place.name}</a></h2><span>{place.distance} | {place.travelTime}</span><div>{place.description}</div><ul>{place.features.map((feature)=><li>{feature}</li>)}</ul><a class="map-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.name+' '+place.address)}`} target="_blank" rel="noopener noreferrer">Open current map search</a></article>)}</div>
  </div></section>
</PageLayout>

<style>
  .cat-hero{padding:4.5rem 0;background:radial-gradient(circle at 80% 0,#25254d,#111128 40%,#0a0a1a 78%);color:#fff;border-bottom:1px solid rgba(212,168,68,.18)}.cat-hero a{color:#f0c95c}.cat-hero p{margin:2.4rem 0 .6rem;color:#d4a844;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.cat-hero h1{max-width:900px;margin:0 0 1rem;color:#fff;font-family:var(--font-display);font-size:clamp(2.5rem,6vw,4.8rem);line-height:1}.cat-hero span{color:#9a9ab5;font-size:1.06rem}.cat-section{padding:5rem 0;background:#0a0a1a}.cat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.place-card{padding:2rem;background:linear-gradient(145deg,#161635,#111128);border:1px solid rgba(255,255,255,.08)}.place-card>p{color:#d4a844;font-size:.7rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.place-card h2{margin:.6rem 0;font-family:var(--font-display);font-size:1.8rem}.place-card h2 a{color:#f0f0f5;text-decoration:none}.place-card>span{color:#6a6a85;font-size:.82rem}.place-card>div{margin:1rem 0;color:#9a9ab5;line-height:1.65}.place-card ul{padding-left:1.1rem;color:#9a9ab5}.map-link{display:inline-block;margin-top:1rem;color:#d4a844;font-weight:800}@media(max-width:680px){.cat-grid{grid-template-columns:1fr}}
</style>
