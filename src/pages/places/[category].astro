---
/**
 * Category Specific Places Directory — Al Rehman Garden Phase 2 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import Button from '@components/global/Button.astro';
import { SITE } from '@data/site';
import { PLACES_DATA } from '@data/places';

export async function getStaticPaths() {
  const categoryMap: Record<string, { label: string; seoTitle: string; seoDesc: string }> = {
    schools: {
      label: 'Schools & Academies',
      seoTitle: 'Best Schools in and near Al Rehman Garden Phase 2 Lahore',
      seoDesc: 'Comprehensive guide to top primary, secondary, and Cambridge O/A Level schools located in and near Al Rehman Garden Phase 2 Lahore.',
    },
    colleges: {
      label: 'Colleges & Higher Education',
      seoTitle: 'Colleges near Al Rehman Garden Phase 2 Lahore',
      seoDesc: 'Explore intermediate FSc, ICS, and degree colleges located near Al Rehman Garden Phase 2 on Main Sharaqpur Road Lahore.',
    },
    hospitals: {
      label: 'Hospitals & Emergency Care',
      seoTitle: 'Hospitals near Al Rehman Garden Phase 2 Lahore (24/7 Care)',
      seoDesc: 'Find 24/7 trauma emergency hospitals, ICU facilities, and medical centers inside and near Al Rehman Garden Phase 2 Lahore.',
    },
    clinics: {
      label: 'Medical & Dental Clinics',
      seoTitle: 'Clinics & Diagnostic Labs in Al Rehman Garden Phase 2',
      seoDesc: 'Discover pathology labs, dental clinics, and specialist doctor clinics located in Al Rehman Garden Phase 2 Lahore.',
    },
    restaurants: {
      label: 'Restaurants & Family Dining',
      seoTitle: 'Restaurants in Al Rehman Garden Phase 2 Lahore',
      seoDesc: 'Top family restaurants, BBQ, Fast Food, and traditional Karahi dining spots in Al Rehman Garden Phase 2 Lahore.',
    },
    cafes: {
      label: 'Cafes & Coffee Lounges',
      seoTitle: 'Cafes & Coffee Shops in Al Rehman Garden Phase 2',
      seoDesc: 'Relaxing coffee lounges, bakeries, and tea houses located in Al Rehman Garden Phase 2 Lahore.',
    },
    mosques: {
      label: 'Grand Jamia Mosques',
      seoTitle: 'Mosques in Al Rehman Garden Phase 2 Lahore',
      seoDesc: 'Explore the Grand Jamia Mosque and sector prayer halls with Turkish architecture in Al Rehman Garden Phase 2 Lahore.',
    },
    markets: {
      label: 'Shopping Malls & Supermarkets',
      seoTitle: 'Supermarkets & Shopping in Al Rehman Garden Phase 2',
      seoDesc: 'Departmental stores, grocery marts, and commercial shopping centers in Al Rehman Garden Phase 2 Lahore.',
    },
    banks: {
      label: 'Banks & 24/7 ATMs',
      seoTitle: 'Banks & ATMs in Al Rehman Garden Phase 2 Lahore',
      seoDesc: 'Commercial and Islamic banks with 24/7 ATMs located in Al Rehman Garden Phase 2 Lahore commercial zones.',
    },
    'petrol-stations': {
      label: 'Petrol & Fuel Stations',
      seoTitle: 'Petrol Pumps & EV Charging near Al Rehman Garden Phase 2',
      seoDesc: '24/7 fuel stations and car service centers near Al Rehman Garden Phase 2 on Main Sharaqpur Road Lahore.',
    },
    gyms: {
      label: 'Gyms & Fitness Centers',
      seoTitle: 'Gyms & Fitness Clubs in Al Rehman Garden Phase 2',
      seoDesc: 'Modern fitness centers, CrossFit arenas, and ladies fitness gyms in Al Rehman Garden Phase 2 Lahore.',
    },
  };

  return Object.keys(categoryMap).map((catKey) => {
    const meta = categoryMap[catKey];
    const items = PLACES_DATA.filter((p) => p.category === catKey);
    return {
      params: { category: catKey },
      props: {
        categoryKey: catKey,
        label: meta.label,
        seoTitle: meta.seoTitle,
        seoDesc: meta.seoDesc,
        places: items,
      },
    };
  });
}

const { categoryKey, label, seoTitle, seoDesc, places } = Astro.props;

const pageSchema = {
  name: `${label} — ${SITE.name}`,
  description: seoDesc,
  url: `${SITE.url}/places/${categoryKey}`,
};

const allCategories = [
  { slug: 'all', label: 'All Places' },
  { slug: 'schools', label: '🏫 Schools' },
  { slug: 'colleges', label: '🎓 Colleges' },
  { slug: 'hospitals', label: '🏥 Hospitals' },
  { slug: 'clinics', label: '🩺 Clinics' },
  { slug: 'restaurants', label: '🍽️ Restaurants' },
  { slug: 'cafes', label: '☕ Cafes' },
  { slug: 'mosques', label: '🕌 Mosques' },
  { slug: 'markets', label: '🛒 Shopping' },
  { slug: 'banks', label: '💳 Banks' },
  { slug: 'petrol-stations', label: '⛽ Fuel Stations' },
  { slug: 'gyms', label: '🏋️ Gyms' },
];
---

<PageLayout
  title={`${seoTitle} | ${SITE.name}`}
  description={seoDesc}
>
  <Schema type="WebSite" data={pageSchema} />

  <!-- Hero Section -->
  <section class="places-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Community Directory</div>
      <h1 class="places-hero__title">
        {label} in <span class="text-gradient-gold">Phase 2 Lahore</span>
      </h1>
      <p class="places-hero__lead lead">{seoDesc}</p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="section section--alt">
    <div class="container">
      <!-- Category Tabs -->
      <div class="places-pills-row">
        {allCategories.map((c) => (
          <a
            href={c.slug === 'all' ? '/places' : `/places/${c.slug}`}
            class:list={['places-pill', { 'places-pill--active': c.slug === categoryKey }]}
          >
            {c.label}
          </a>
        ))}
      </div>

      <!-- Places List -->
      <div class="places-grid">
        {places.map((p) => (
          <div class="place-card">
            <div class="place-card__header">
              <div class="place-card__badge-row">
                <span class="place-badge">{p.categoryLabel}</span>
                <span class="place-dist-badge">📍 {p.distance} ({p.travelTime})</span>
              </div>
              <h3 class="place-card__title">{p.name}</h3>
              <p class="place-card__address">{p.address}</p>
            </div>

            <p class="place-card__desc">{p.description}</p>

            <div class="place-card__features">
              {p.features.map((f) => (
                <span class="place-feat-tag">✓ {f}</span>
              ))}
            </div>

            <div class="place-card__footer">
              <div class="place-rating">
                <span style="color: #F59E0B;">★ {p.rating?.toFixed(1) || '4.8'}</span>
                <small>({p.reviewCount || 50} Reviews)</small>
              </div>
              <a
                href={`https://maps.google.com/?q=${encodeURIComponent(`${p.name} Al Rehman Garden Phase 2 Lahore`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--outline btn--sm"
              >
                Directions ↗
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Back to all places -->
      <div style="margin-top: 48px; text-align: center;">
        <Button href="/places" variant="outline" size="md">
          ← View All Society Amenities &amp; Places
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .places-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .places-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .places-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .places-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .places-pill {
    padding: var(--space-2) var(--space-4);
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .places-pill:hover {
    border-color: var(--border-gold);
    color: var(--color-secondary-900);
    transform: translateY(-2px);
  }

  .places-pill--active {
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    border-color: var(--color-primary-500);
    box-shadow: 0 2px 8px rgba(197, 155, 39, 0.3);
  }

  .places-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .places-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .places-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .place-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .place-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-gold);
  }

  .place-card__badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .place-badge {
    font-size: 10.5px;
    font-weight: var(--font-bold);
    background: var(--color-primary-50);
    color: var(--color-primary-800);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  .place-dist-badge {
    font-size: 11px;
    color: #059669;
    font-weight: var(--font-extrabold);
  }

  .place-card__title {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 4px;
  }

  .place-card__address {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    margin: 0 0 var(--space-3);
  }

  .place-card__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .place-card__features {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-5);
  }

  .place-feat-tag {
    font-size: 10px;
    background: var(--color-neutral-100);
    color: var(--text-secondary);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  .place-card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .place-rating {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
  }

  .place-rating small {
    color: var(--text-tertiary);
    font-weight: normal;
    display: block;
    font-size: 10px;
  }
</style>
