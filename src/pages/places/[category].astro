---
/**
 * Category Specific Places Authority Landing Page
 * Route: /places/[category]
 * Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyWatermark from '@components/property/PropertyWatermark.astro';
import { SITE } from '@data/site';
import { PLACES_DATA, PLACE_CATEGORIES, type PlaceCategoryMeta } from '@data/places';
import propertiesData from '@data/properties-import.json';

export async function getStaticPaths() {
  return PLACE_CATEGORIES.map((catMeta) => {
    const places = PLACES_DATA.filter((p) => p.category === catMeta.key);
    return {
      params: { category: catMeta.key },
      props: {
        categoryMeta: catMeta,
        places,
      },
    };
  });
}

interface Props {
  categoryMeta: PlaceCategoryMeta;
  places: typeof PLACES_DATA;
}

const { categoryMeta, places } = Astro.props;

// Category specific FAQ dataset
const categoryFaqs: Record<string, { question: string; answer: string }[]> = {
  schools: [
    {
      question: 'Which top schools are located inside Al Rehman Garden Phase 2?',
      answer: 'The City School operates a dedicated primary and secondary campus in Block B, while Beaconhouse School System and Dar-e-Arqam are situated within 1 to 3 minutes drive from the society entrance.',
    },
    {
      question: 'Are school bus services available inside the society?',
      answer: 'Yes, both school-operated and private air-conditioned van transport routes cover all sectors from Block A to Beverly Hills.',
    },
  ],
  hospitals: [
    {
      question: 'Is there a 24/7 hospital inside Al Rehman Garden Phase 2?',
      answer: 'Yes, the Al Rehman Garden Trust Hospital in Block C operates 24 hours a day with trauma emergency, ICU, pharmacy, and diagnostic lab services.',
    },
    {
      question: 'What tertiary care hospitals are nearby?',
      answer: 'Farooq Hospital West Lahore and Sharaqpur District Hospital are located within a 7 to 10 minute drive via Sagian Bypass.',
    },
  ],
  mosques: [
    {
      question: 'How many Jamia mosques are built in Phase 2?',
      answer: 'Phase 2 features dedicated air-conditioned Jamia mosques in every sector, headlined by the iconic Grand Turkish Architecture Mosque in Block A accommodating over 3,500 worshippers.',
    },
  ],
  restaurants: [
    {
      question: 'What dining and fast food options are available in Phase 2?',
      answer: 'The 150ft Commercial Broadway features family dining at Broadway Grill, Gloria Jean\'s Coffees, and 24/7 drive-thrus for McDonald\'s and KFC at the Faizpur Interchange.',
    },
  ],
  shopping: [
    {
      question: 'Where can residents do everyday grocery shopping?',
      answer: 'Al Rehman Super Mart in Block B and multiple sector mini-marts provide fresh organic produce, butcher services, and pantry goods. Metro Cash & Carry is 10 minutes away via Sagian.',
    },
  ],
  banks: [
    {
      question: 'Which banks have branches and ATMs in Phase 2?',
      answer: 'Meezan Bank and HBL operate full commercial branches with 24/7 Cash Deposit Machines (CDM) and biometric ATMs on Block C Broadway.',
    },
  ],
  'petrol-stations': [
    {
      question: 'Is there a petrol station near the society gate?',
      answer: 'Yes, Total Parco and Shell service stations with Hi-Octane, CNG, EV charging, and automated car wash are located 800 meters from the entrance gate.',
    },
  ],
  parks: [
    {
      question: 'Are there family parks in Al Rehman Garden Phase 2?',
      answer: 'Yes, Phase 2 features the Central Family Theme Park with musical fountains in Mirabel, the Rose Garden in Sector D, and neighborhood parks in every residential block.',
    },
  ],
  gyms: [
    {
      question: 'Are there separate gym timings for women in Phase 2?',
      answer: 'Yes, Titanium Fitness Club in Mirabel Sports Complex offers dedicated ladies-only workout shifts from 11:00 AM to 03:00 PM with certified female fitness coaches.',
    },
  ],
  hotels: [
    {
      question: 'Can overseas visitors book guest suites in Phase 2?',
      answer: 'Yes, Executive Residence Suites on Block C Broadway provides fully furnished executive suites with 24/7 concierge and security for visitors and investors.',
    },
  ],
};

const currentFaqs = categoryFaqs[categoryMeta.key] || [
  {
    question: `How accessible are ${categoryMeta.label.toLowerCase()} from Al Rehman Garden Phase 2?`,
    answer: `All ${categoryMeta.label.toLowerCase()} are conveniently located either directly within society sectors or within a 2 to 5 minute drive on Main Sharaqpur Road.`,
  },
];

const pageSchema = {
  name: `${categoryMeta.seoTitle} — ${SITE.name}`,
  description: categoryMeta.seoDesc,
  url: `${SITE.url}/places/${categoryMeta.key}`,
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Places Directory',
      item: `${SITE.url}/places`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoryMeta.label,
      item: `${SITE.url}/places/${categoryMeta.key}`,
    },
  ],
};

const faqSchema = {
  itemListElement: currentFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const featuredProps = propertiesData.slice(0, 3);
---

<PageLayout
  title={categoryMeta.seoTitle}
  description={categoryMeta.seoDesc}
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />
  <Schema type="FAQPage" data={faqSchema} />

  <main class="cat-page">
    <!-- Top Header Navigation -->
    <header class="cat-topbar">
      <div class="container cat-topbar__inner">
        <a href="/" class="cat-topbar__logo">
          <img src="/images/logo/logo-white.svg" alt={SITE.name} width="190" height="48" />
        </a>

        <nav class="cat-topbar__nav">
          <a href="/" class="cat-nav-link">Home</a>
          <a href="/blocks" class="cat-nav-link">Blocks</a>
          <a href="/properties" class="cat-nav-link">Properties</a>
          <a href="/plots" class="cat-nav-link">Plots</a>
          <a href="/houses-for-sale-in-al-rehman-garden-phase-2-lahore" class="cat-nav-link">Houses</a>
          <a href="/places" class="cat-nav-link cat-nav-link--active">Places</a>
          <a href="/al-rehman-garden-phase-2-map" class="cat-nav-link">Map</a>
          <a href="/property-prices" class="cat-nav-link">Prices</a>
          <a href="/contact" class="cat-nav-link">Contact</a>
        </nav>

        <a
          href="https://wa.me/923257800001"
          target="_blank"
          rel="noopener noreferrer"
          class="cat-btn-gold"
        >
          WhatsApp
        </a>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="cat-hero">
      <div class="container text-center">
        <!-- Breadcrumbs -->
        <nav class="cat-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>&gt;</span>
          <a href="/places">Places</a>
          <span>&gt;</span>
          <span class="active">{categoryMeta.label}</span>
        </nav>

        <h1 class="cat-hero__title">
          {categoryMeta.label} in <br />
          <span class="text-gold">Al Rehman Garden Phase 2 Lahore</span>
        </h1>

        <p class="cat-hero__subtitle">{categoryMeta.introText}</p>

        <!-- Category Switching Shortcut Bar -->
        <div class="cat-pill-switcher">
          {PLACE_CATEGORIES.map((c) => (
            <a
              href={`/places/${c.key}`}
              class:list={['cat-pill-link', { 'cat-pill-link--active': c.key === categoryMeta.key }]}
            >
              <span>{c.icon}</span>
              <span>{c.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Places Listing Grid -->
    <section class="cat-section">
      <div class="container">
        <div class="section-center-head">
          <div class="cat-eyebrow">
            <span class="cat-eyebrow__line"></span>
            <span>DIRECTORY LISTINGS</span>
            <span class="cat-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Verified {categoryMeta.label}</h2>
          <p class="section-sub-title">Explore complete facilities, on-ground locations, and operational timings.</p>
        </div>

        <div class="cat-places-grid">
          {places.map((p) => (
            <div class="place-main-card">
              <div class="place-main-card__img-wrap">
                <img
                  src={p.images[0] || '/images/og/homepage-og.jpg'}
                  alt={p.name}
                  class="place-main-card__img"
                  loading="lazy"
                />
                <PropertyWatermark position="bottom-right" opacity={0.35} />
                <span class="place-dist-badge">📍 {p.distance} ({p.travelTime})</span>
              </div>

              <div class="place-main-card__content">
                <div class="place-main-card__top">
                  <span class="place-sub-badge">{p.categoryLabel}</span>
                  <div class="place-rating-badge">★ {p.rating.toFixed(1)}</div>
                </div>

                <h3 class="place-main-card__title">
                  <a href={`/places/${p.category}/${p.slug}`}>{p.name}</a>
                </h3>
                <p class="place-main-card__address">📍 {p.address}</p>
                <p class="place-main-card__desc">{p.description}</p>

                <div class="place-main-card__features">
                  {p.features.slice(0, 3).map((f) => (
                    <span class="place-feat-tag">✓ {f}</span>
                  ))}
                </div>

                <div class="place-main-card__actions">
                  <a
                    href={`/places/${p.category}/${p.slug}`}
                    class="btn-view-place"
                  >
                    View Full Profile →
                  </a>
                  <a
                    href={`https://maps.google.com/?q=${encodeURIComponent(`${p.name} Al Rehman Garden Phase 2 Lahore`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-direct-map"
                    title="Open in Google Maps"
                  >
                    📍 Directions
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Interactive Map Section -->
    <section class="cat-section cat-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="cat-eyebrow">
            <span class="cat-eyebrow__line"></span>
            <span>MAP LOCATIONS</span>
            <span class="cat-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">{categoryMeta.label} Location Map</h2>
          <p class="section-sub-title">Interactive GPS coordinates and access routes inside and around Al Rehman Garden Phase 2.</p>
        </div>

        <div class="cat-map-card">
          <iframe
            title={`${categoryMeta.label} in Al Rehman Garden Phase 2 Lahore Google Map`}
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13594.756281096538!2d74.2154!3d31.5768!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391901a1c9df253b%3A0xb35a80579e0f63e6!2sAl-Rehman%20Garden%20Phase%202%2C%20Lahore!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s"
            width="100%"
            height="420"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            class="cat-map-iframe"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Related Verified Properties in Society -->
    <section class="cat-section">
      <div class="container">
        <div class="section-center-head">
          <div class="cat-eyebrow">
            <span class="cat-eyebrow__line"></span>
            <span>FEATURED PROPERTIES</span>
            <span class="cat-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Properties Near These Facilities</h2>
          <p class="section-sub-title">Verified plots and ready houses situated in walking distance of top society amenities.</p>
        </div>

        <div class="cat-props-grid">
          {featuredProps.map((prop) => (
            <div class="cat-prop-card">
              <div class="cat-prop-card__img-wrap">
                <img
                  src={prop.images[0]?.url || '/images/placeholders/property-placeholder.webp'}
                  alt={prop.title}
                  class="cat-prop-card__img"
                  loading="lazy"
                />
                <PropertyWatermark position="bottom-right" opacity={0.35} />
                <span class="cat-prop-card__badge">🟢 Available</span>
              </div>
              <div class="cat-prop-card__content">
                <div class="cat-prop-card__meta">
                  <span class="tag-meta">{prop.size} {prop.unit}</span>
                  <span class="tag-meta tag-meta--block">{prop.block}</span>
                </div>
                <h3 class="cat-prop-card__title">{prop.title}</h3>
                <div class="cat-prop-card__price">
                  PKR {new Intl.NumberFormat('en-PK').format(prop.price)}
                </div>
                <a href={`/properties/${prop.slug}`} class="btn-prop-link">
                  View Property Details →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Category FAQs -->
    <section class="cat-section cat-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="cat-eyebrow">
            <span class="cat-eyebrow__line"></span>
            <span>COMMUNITY FAQS</span>
            <span class="cat-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Frequently Asked Questions</h2>
          <p class="section-sub-title">Everything you need to know about {categoryMeta.label.toLowerCase()} in Phase 2.</p>
        </div>

        <div class="cat-faqs-grid">
          {currentFaqs.map((faq) => (
            <div class="cat-faq-card">
              <h3 class="cat-faq-card__q">{faq.question}</h3>
              <p class="cat-faq-card__a">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cat-cta-section">
      <div class="container">
        <div class="cat-cta-box">
          <div class="cat-cta-box__body">
            <h2 class="cat-cta-box__title">
              Looking for Property in <br />
              <span class="text-gold">Al Rehman Garden Phase 2 Lahore?</span>
            </h2>
            <p class="cat-cta-box__desc">
              Contact <strong>Ahmad Huzaifah</strong> for verified plot prices, map demarcations, and guided site tours near top society facilities.
            </p>
          </div>

          <div class="cat-cta-box__actions">
            <a
              href={`https://wa.me/923257800001?text=${encodeURIComponent(`Salam Ahmad Huzaifah, I am interested in purchasing property near ${categoryMeta.label} in Al Rehman Garden Phase 2.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-cta-gold"
            >
              💬 WhatsApp Consultation
            </a>
            <a href="/properties" class="btn-cta-outline">
              Explore All Properties
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="cat-footer">
      <div class="container">
        <div class="cat-footer__grid">
          <div class="cat-footer__brand-col">
            <img src="/images/logo/logo-white.svg" alt={SITE.name} width="220" height="55" class="cat-footer__logo" />
            <p class="cat-footer__desc">
              Independent verified society directory and local facilities guide for Al Rehman Garden Phase 2 Lahore.
            </p>
          </div>

          <div class="cat-footer__col">
            <h4 class="cat-footer__heading">Categories</h4>
            <ul class="cat-footer__list">
              <li><a href="/places/schools">Schools</a></li>
              <li><a href="/places/hospitals">Hospitals</a></li>
              <li><a href="/places/mosques">Mosques</a></li>
              <li><a href="/places/restaurants">Restaurants</a></li>
              <li><a href="/places/shopping">Shopping</a></li>
              <li><a href="/places/banks">Banks</a></li>
            </ul>
          </div>

          <div class="cat-footer__col">
            <h4 class="cat-footer__heading">Explore</h4>
            <ul class="cat-footer__list">
              <li><a href="/blocks">Blocks Directory</a></li>
              <li><a href="/al-rehman-garden-phase-2-map">Master Map</a></li>
              <li><a href="/property-prices">Property Prices</a></li>
              <li><a href="/property-dealer">Property Consultant</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <div class="cat-footer__col">
            <h4 class="cat-footer__heading">Legal</h4>
            <ul class="cat-footer__list">
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
              <li><a href="/disclaimer">Disclaimer</a></li>
              <li><a href="/copyright-policy">Copyright</a></li>
            </ul>
          </div>
        </div>

        <div class="cat-footer__bottom">
          <p>&copy; {new Date().getFullYear()} Al Rehman Garden Phase 2 Lahore Authority Portal. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </main>
</PageLayout>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     THEME & GLOBAL CANVAS — DARK NAVY #090B20 & GOLD #D4AF37
     ══════════════════════════════════════════════════════════════════════════ */
  .cat-page {
    background-color: #090B20;
    color: #F8FAFC;
    min-height: 100vh;
    font-family: var(--font-sans);
  }

  .text-gold {
    color: #D4AF37;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     TOP NAVIGATION BAR
     ══════════════════════════════════════════════════════════════════════════ */
  .cat-topbar {
    background: rgba(9, 11, 32, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    padding: 14px 0;
  }

  .cat-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cat-topbar__nav {
    display: none;
    align-items: center;
    gap: 20px;
  }

  @media (min-width: 992px) {
    .cat-topbar__nav {
      display: flex;
    }
  }

  .cat-nav-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cat-nav-link:hover,
  .cat-nav-link--active {
    color: #D4AF37;
  }

  .cat-btn-gold {
    background: #D4AF37;
    color: #090B20;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cat-btn-gold:hover {
    background: #F3D375;
    transform: translateY(-1px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     HERO SECTION & CATEGORY SWITCHER
     ══════════════════════════════════════════════════════════════════════════ */
  .cat-hero {
    padding: 44px 0 36px;
    background: radial-gradient(circle at 50% 15%, #181A45 0%, #090B20 80%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cat-breadcrumb {
    font-size: 12.5px;
    color: #94A3B8;
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .cat-breadcrumb a {
    color: #94A3B8;
    text-decoration: none;
  }

  .cat-breadcrumb a:hover {
    color: #D4AF37;
  }

  .cat-breadcrumb .active {
    color: #CBD5E1;
  }

  .cat-hero__title {
    font-size: clamp(24px, 4vw, 38px);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .cat-hero__subtitle {
    font-size: 14.5px;
    color: #94A3B8;
    max-width: 650px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }

  .cat-pill-switcher {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .cat-pill-link {
    background: #15172D;
    color: #CBD5E1;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 20px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
  }

  .cat-pill-link:hover {
    background: #1D203C;
    border-color: rgba(212, 175, 55, 0.35);
    color: #FFFFFF;
  }

  .cat-pill-link--active {
    background: rgba(212, 175, 55, 0.15);
    border-color: #D4AF37;
    color: #F3D375;
    font-weight: 700;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION HEADINGS & GRIDS (#15172D CARDS)
     ══════════════════════════════════════════════════════════════════════════ */
  .cat-section {
    padding: 64px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cat-section--alt {
    background: #0D0F2A;
  }

  .section-center-head {
    text-align: center;
    margin-bottom: 40px;
  }

  .cat-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 800;
    color: #D4AF37;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 8px;
  }

  .cat-eyebrow__line {
    width: 32px;
    height: 1px;
    background: rgba(212, 175, 55, 0.5);
  }

  .section-main-title {
    font-size: clamp(22px, 3.5vw, 32px);
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .section-sub-title {
    font-size: 14px;
    color: #94A3B8;
    max-width: 550px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Places Grid */
  .cat-places-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .cat-places-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cat-places-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .place-main-card {
    background: #15172D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .place-main-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.4);
  }

  .place-main-card__img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #000;
  }

  .place-main-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

