---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { PLACE_CATEGORIES, PLACES_DATA } from '@data/places';
import { SITE } from '@data/site';

const directorySchema = {
  name: 'DHA Phase 6 Lahore Places Directory',
  description: 'Independent directory of education, healthcare, worship, dining, shopping, banking, parks, sports and everyday services.',
  url: `${SITE.url}/places`,
};
---

<PageLayout title="Places in DHA Phase 6 Lahore | Local Directory" description="Explore schools, healthcare, mosques, restaurants, shopping, banks, parks, sports and services in and around DHA Phase 6 Lahore.">
  <Schema type="WebSite" data={directorySchema} />
  <header class="places-hero"><div class="container"><p>Local research directory</p><h1>Places in and around DHA Phase 6 Lahore</h1><span>Use each entry as a starting point and confirm current details directly.</span></div></header>
  <section class="places-section"><div class="container">
    <div class="places-note"><strong>Directory, not endorsement.</strong><p>Routes, opening hours, tenants and services change. Exact travel time depends on the sector and gate.</p></div>
    <div class="category-grid">{PLACE_CATEGORIES.map((category) => {
      const count=PLACES_DATA.filter((place)=>place.category===category.key).length;
      return <a href={`/places/${category.key}`} class="category-card"><span>{category.icon}</span><div><h2>{category.label}</h2><p>{category.introText}</p><strong>{count} research {count===1?'entry':'entries'}</strong></div></a>
    })}</div>
  </div></section>
</PageLayout>

<style>
  .places-hero{padding:clamp(5rem,10vw,8rem) 0;background:radial-gradient(circle at 80% 0,#315c50,#102d2a 40%,#071a24 78%);color:#fff}.places-hero>div>p{margin:0 0 .75rem;color:#e0bb62;font-size:.74rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.places-hero h1{max-width:980px;margin:0 0 1.2rem;color:#fff;font-family:var(--font-display);font-size:clamp(2.8rem,7vw,5.8rem);line-height:.97}.places-hero span{color:#c7d5d0;font-size:1.08rem}.places-section{padding:clamp(3.5rem,8vw,7rem) 0;background:#f6f2e9}.places-note{display:grid;grid-template-columns:240px 1fr;gap:2rem;margin-bottom:2rem;padding:1.35rem 1.5rem;background:#d5ad55;color:#102421}.places-note p{margin:0}.category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.category-card{display:flex;gap:1.2rem;min-height:230px;padding:1.7rem;background:#fff;border:1px solid #ded6c5;color:#17322e;text-decoration:none}.category-card>span{display:grid;place-items:center;width:48px;height:48px;flex:0 0 48px;background:#123a34;color:#e0bb62;font-weight:900}.category-card h2{margin:.15rem 0 .7rem;font-family:var(--font-display);font-size:1.5rem}.category-card p{color:#62706b;line-height:1.6}.category-card strong{color:#11604f;font-size:.8rem}@media(max-width:900px){.category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.category-grid,.places-note{grid-template-columns:1fr;gap:.7rem}}
</style>
