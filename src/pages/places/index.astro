---
/**
 * Master Places & Local Amenities Directory
 * Route: /places
 * Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyWatermark from '@components/property/PropertyWatermark.astro';
import { SITE } from '@data/site';
import { PLACES_DATA, PLACE_CATEGORIES } from '@data/places';

const pageSchema = {
  name: `Nearby Places & Amenities Directory — ${SITE.name}`,
  description: 'Explore schools, hospitals, clinics, mosques, restaurants, shopping marts, and banks inside and near Al Rehman Garden Phase 2 Lahore.',
  url: `${SITE.url}/places`,
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Places Directory',
      item: `${SITE.url}/places`,
    },
  ],
};

const faqSchema = {
  itemListElement: [
    {
      '@type': 'Question',
      name: 'What facilities are available directly inside Al Rehman Garden Phase 2?',
      answer: 'Phase 2 features on-site educational campuses (The City School), 24/7 emergency hospital (Al Rehman Trust Hospital), Grand Turkish Jamia Mosque, departmental supermarkets, branch banks (Meezan, HBL), central theme parks with musical fountains, fitness gyms, and fine dining.',
    },
    {
      '@type': 'Question',
      name: 'How close is Al Rehman Garden Phase 2 to the M-2 Motorway and major destinations?',
      answer: 'Al Rehman Garden Phase 2 is situated just 2 minutes from M-2 Motorway Faizpur Interchange, 10 minutes from Mall Road and Civil Lines Lahore via Sagian Bridge, and 20 minutes from Allama Iqbal International Airport via Lahore Ring Road.',
    },
  ].map((f) => ({
    '@type': 'Question',
    name: f.name,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<PageLayout
  title={`Nearby Places & Amenities Directory | Al Rehman Garden Phase 2 Lahore`}
  description="Discover schools, top hospitals, Grand Jamia Mosques, restaurants, supermarkets, and banks situated inside and near Al Rehman Garden Phase 2 Lahore."
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />
  <Schema type="FAQPage" data={faqSchema} />

  <main class="places-hub-page">
    <!-- Top Header Navigation -->
    <header class="hub-topbar">
      <div class="container hub-topbar__inner">
        <a href="/" class="hub-topbar__logo">
          <img src="/images/logo/logo-white.svg" alt={SITE.name} width="190" height="48" />
        </a>

        <nav class="hub-topbar__nav">
          <a href="/" class="hub-nav-link">Home</a>
          <a href="/blocks" class="hub-nav-link">Blocks</a>
          <a href="/properties" class="hub-nav-link">Properties</a>
          <a href="/plots" class="hub-nav-link">Plots</a>
          <a href="/houses-for-sale-in-al-rehman-garden-phase-2-lahore" class="hub-nav-link">Houses</a>
          <a href="/places" class="hub-nav-link hub-nav-link--active">Places</a>
          <a href="/al-rehman-garden-phase-2-map" class="hub-nav-link">Map</a>
          <a href="/property-prices" class="hub-nav-link">Prices</a>
          <a href="/contact" class="hub-nav-link">Contact</a>
        </nav>

        <a
          href="https://wa.me/923257800001"
          target="_blank"
          rel="noopener noreferrer"
          class="hub-btn-gold"
        >
          WhatsApp
        </a>
      </div>
    </header>

    <!-- Hero Header -->
    <section class="hub-hero">
      <div class="container text-center">
        <!-- Breadcrumb -->
        <nav class="hub-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>&gt;</span>
          <span class="active">Places Directory</span>
        </nav>

        <h1 class="hub-hero__title">
          Places, Schools &amp; <br />
          <span class="text-gold">Nearby Amenities</span>
        </h1>

        <p class="hub-hero__subtitle">
          Explore premier educational institutions, 24/7 hospitals, family dining, Grand Jamia Mosques, supermarkets, and banking centers situated inside and adjacent to Al Rehman Garden Phase 2 Lahore.
        </p>

        <div class="hub-trust-pill">
          <span>✨ Verified civic infrastructure &amp; community lifestyle directory</span>
        </div>
      </div>
    </section>

    <!-- 10 Category Grid Section -->
    <section class="hub-section">
      <div class="container">
        <div class="section-center-head">
          <div class="hub-eyebrow">
            <span class="hub-eyebrow__line"></span>
            <span>DIRECTORY CATEGORIES</span>
            <span class="hub-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Explore by Category</h2>
          <p class="section-sub-title">Quickly find specific amenities, distances, and contact details across society sectors.</p>
        </div>

        <div class="categories-grid">
          {PLACE_CATEGORIES.map((c) => {
            const count = PLACES_DATA.filter((p) => p.category === c.key).length;
            return (
              <a href={`/places/${c.key}`} class="cat-tile">
                <span class="cat-tile__icon">{c.icon}</span>
                <h3 class="cat-tile__title">{c.label}</h3>
                <span class="cat-tile__count">{count} Verified Locations</span>
                <span class="cat-tile__arrow">Explore →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- All Places Master Listings -->
    <section class="hub-section hub-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="hub-eyebrow">
            <span class="hub-eyebrow__line"></span>
            <span>FEATURED LOCAL PLACES</span>
            <span class="hub-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">All Society Places &amp; Amenities</h2>
          <p class="section-sub-title">Verified on-ground institutions and commercial landmarks inside Al Rehman Garden Phase 2.</p>
        </div>

        <div class="master-places-grid">
          {PLACES_DATA.map((p) => (
            <div class="master-place-card">
              <div class="master-place-card__img-wrap">
                <img
                  src={p.images[0] || '/images/og/homepage-og.jpg'}
                  alt={p.name}
                  class="master-place-card__img"
                  loading="lazy"
                />
                <PropertyWatermark position="bottom-right" opacity={0.35} />
                <span class="master-dist-badge">📍 {p.distance} ({p.travelTime})</span>
              </div>

              <div class="master-place-card__content">
                <div class="master-place-card__top">
                  <span class="master-cat-badge">{p.categoryLabel}</span>
                  <span class="master-rating">★ {p.rating.toFixed(1)}</span>
                </div>

                <h3 class="master-place-card__title">
                  <a href={`/places/${p.category}/${p.slug}`}>{p.name}</a>
                </h3>

                <p class="master-place-card__address">📍 {p.address}</p>
                <p class="master-place-card__desc">{p.description}</p>

                <div class="master-place-card__features">
                  {p.features.slice(0, 3).map((f) => (
                    <span class="feat-pill">✓ {f}</span>
                  ))}
                </div>

                <div class="master-place-card__actions">
                  <a
                    href={`/places/${p.category}/${p.slug}`}
                    class="btn-card-gold"
                  >
                    View Details
                  </a>
                  <a
                    href={`https://maps.google.com/?q=${encodeURIComponent(`${p.name} Al Rehman Garden Phase 2 Lahore`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-card-nav"
                    title="Get Directions"
                  >
                    📍 Directions
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Master Society Interactive Location Map -->
    <section class="hub-section">
      <div class="container">
        <div class="section-center-head">
          <div class="hub-eyebrow">
            <span class="hub-eyebrow__line"></span>
            <span>SOCIETY GPS MAP</span>
            <span class="hub-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Interactive Society Facilities Map</h2>
          <p class="section-sub-title">Explore road networks, entrance gates, and sector landmarks on Main Sharaqpur Road.</p>
        </div>

        <div class="hub-map-card">
          <iframe
            title="Al Rehman Garden Phase 2 Lahore Amenities Map"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13594.756281096538!2d74.2154!3d31.5768!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391901a1c9df253b%3A0xb35a80579e0f63e6!2sAl-Rehman%20Garden%20Phase%202%2C%20Lahore!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s"
            width="100%"
            height="440"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            class="hub-map-iframe"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="hub-section hub-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="hub-eyebrow">
            <span class="hub-eyebrow__line"></span>
            <span>CIVIC INFORMATION</span>
            <span class="hub-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Frequently Asked Questions</h2>
          <p class="section-sub-title">Important inquiries regarding society lifestyle, transit times, and services.</p>
        </div>

        <div class="hub-faqs-grid">
          {faqSchema.itemListElement.map((faq) => (
            <div class="hub-faq-card">
              <h3 class="hub-faq-card__q">{faq.name}</h3>
              <p class="hub-faq-card__a">{faq.acceptedAnswer.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Large CTA Section -->
    <section class="hub-cta-section">
      <div class="container">
        <div class="hub-cta-box">
          <div class="hub-cta-box__body">
            <h2 class="hub-cta-box__title">
              Ready to Buy or Invest in <br />
              <span class="text-gold">Al Rehman Garden Phase 2 Lahore?</span>
            </h2>
            <p class="hub-cta-box__desc">
              Connect directly with <strong>Ahmad Huzaifah</strong> for verified plot prices, map demarcations, and guided physical site tours.
            </p>
          </div>

          <div class="hub-cta-box__actions">
            <a
              href="https://wa.me/923257800001"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-cta-gold"
            >
              💬 WhatsApp 03257800001
            </a>
            <a href="/properties" class="btn-cta-outline">
              Explore 100+ Properties
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="hub-footer">
      <div class="container">
        <div class="hub-footer__grid">
          <div class="hub-footer__brand-col">
            <img src="/images/logo/logo-white.svg" alt={SITE.name} width="220" height="55" class="hub-footer__logo" />
            <p class="hub-footer__desc">
              Independent verified society directory and local facilities authority portal for Al Rehman Garden Phase 2 Lahore.
            </p>
          </div>

          <div class="hub-footer__col">
            <h4 class="hub-footer__heading">Categories</h4>
            <ul class="hub-footer__list">
              <li><a href="/places/schools">Schools</a></li>
              <li><a href="/places/hospitals">Hospitals</a></li>
              <li><a href="/places/mosques">Mosques</a></li>
              <li><a href="/places/restaurants">Restaurants</a></li>
              <li><a href="/places/shopping">Shopping</a></li>
              <li><a href="/places/parks">Parks</a></li>
            </ul>
          </div>

          <div class="hub-footer__col">
            <h4 class="hub-footer__heading">Explore</h4>
            <ul class="hub-footer__list">
              <li><a href="/blocks">Blocks Directory</a></li>
              <li><a href="/al-rehman-garden-phase-2-map">Master Map</a></li>
              <li><a href="/property-prices">Property Prices</a></li>
              <li><a href="/property-dealer">Property Consultant</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <div class="hub-footer__col">
            <h4 class="hub-footer__heading">Legal</h4>
            <ul class="hub-footer__list">
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
              <li><a href="/disclaimer">Disclaimer</a></li>
              <li><a href="/copyright-policy">Copyright</a></li>
            </ul>
          </div>
        </div>

        <div class="hub-footer__bottom">
          <p>&copy; {new Date().getFullYear()} Al Rehman Garden Phase 2 Lahore Authority Portal. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </main>
</PageLayout>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     THEME & GLOBAL CANVAS — DARK NAVY #090B20 & GOLD #D4AF37
     ══════════════════════════════════════════════════════════════════════════ */
  .places-hub-page {
    background-color: #090B20;
    color: #F8FAFC;
    min-height: 100vh;
    font-family: var(--font-sans);
  }

  .text-gold {
    color: #D4AF37;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     TOP NAVIGATION BAR
     ══════════════════════════════════════════════════════════════════════════ */
  .hub-topbar {
    background: rgba(9, 11, 32, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    padding: 14px 0;
  }

  .hub-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .hub-topbar__nav {
    display: none;
    align-items: center;
    gap: 20px;
  }

  @media (min-width: 992px) {
    .hub-topbar__nav {
      display: flex;
    }
  }

  .hub-nav-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hub-nav-link:hover,
  .hub-nav-link--active {
    color: #D4AF37;
  }

  .hub-btn-gold {
    background: #D4AF37;
    color: #090B20;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .hub-btn-gold:hover {
    background: #F3D375;
    transform: translateY(-1px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     HERO SECTION
     ══════════════════════════════════════════════════════════════════════════ */
  .hub-hero {
    padding: 48px 0 40px;
    background: radial-gradient(circle at 50% 15%, #181A45 0%, #090B20 80%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hub-breadcrumb {
    font-size: 12.5px;
    color: #94A3B8;
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .hub-breadcrumb a {
    color: #94A3B8;
    text-decoration: none;
  }

  .hub-breadcrumb a:hover {
    color: #D4AF37;
  }

  .hub-breadcrumb .active {
    color: #CBD5E1;
  }

  .hub-hero__title {
    font-size: clamp(26px, 4.5vw, 42px);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .hub-hero__subtitle {
    font-size: 14.5px;
    color: #94A3B8;
    max-width: 680px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }

  .hub-trust-pill {
    display: inline-block;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: #F3D375;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 20px;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     CATEGORY TILES GRID (10 CATEGORIES)
     ══════════════════════════════════════════════════════════════════════════ */
  .hub-section {
    padding: 64px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .hub-section--alt {
    background: #0D0F2A;
  }

  .section-center-head {
    text-align: center;
    margin-bottom: 40px;
  }

  .hub-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 800;
    color: #D4AF37;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 8px;
  }

  .hub-eyebrow__line {
    width: 32px;
    height: 1px;
    background: rgba(212, 175, 55, 0.5);
  }

  .section-main-title {
    font-size: clamp(22px, 3.5vw, 32px);
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .section-sub-title {
    font-size: 14px;
    color: #94A3B8;
    max-width: 550px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .cat-tile {
    background: #15172D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 22px 18px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cat-tile:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
  }

  .cat-tile__icon {
    font-size: 32px;
    margin-bottom: 8px;
  }

  .cat-tile__title {
    font-size: 14.5px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 4px;
  }

  .cat-tile__count {
    font-size: 11px;
    color: #94A3B8;
    margin-bottom: 10px;
  }

  .cat-tile__arrow {
    font-size: 11.5px;
    font-weight: 700;
    color: #D4AF37;
    margin-top: auto;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     MASTER PLACES LISTINGS GRID (#15172D CARDS)
     ══════════════════════════════════════════════════════════════════════════ */
  .master-places-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .master-places-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .master-places-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .master-place-card {
    background: #15172D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .master-place-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.4);
  }

  .master-place-card__img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #000;
  }

  .master-place-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .master-dist-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(9, 11, 32, 0.88);
    color: #CBD5E1;
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .master-place-card__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .master-place-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .master-cat-badge {
    font-size: 10.5px;
    font-weight: 700;
    color: #D4AF37;
    background: rgba(212, 175, 55, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .master-rating {
    font-size: 11px;
    font-weight: 700;
    color: #FBBF24;
  }

  .master-place-card__title {
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 6px;
    line-height: 1.35;
  }

  .master-place-card__title a {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .master-place-card__title a:hover {
    color: #D4AF37;
  }

  .master-place-card__address {
    font-size: 12px;
    color: #94A3B8;
    margin: 0 0 10px;
  }

  .master-place-card__desc {
    font-size: 13px;
    color: #CBD5E1;
    line-height: 1.5;
    margin: 0 0 16px;
  }

  .master-place-card__features {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .feat-pill {
    font-size: 10.5px;
    background: #1D203C;
    color: #94A3B8;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .master-place-card__actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }

  .btn-card-gold {
    flex: 1.4;
    background: #D4AF37;
    color: #090B20;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 6px;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-card-gold:hover {
    background: #F3D375;
  }

  .btn-card-nav {
    flex: 1;
    background: #1D203C;
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 6px;
    text-align: center;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
