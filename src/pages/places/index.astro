  <main id="main-content">
    <!-- Page Hero -->
    <header class="page-hero">
      <div class="container">
        <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">›</span>
          <span aria-current="page">Places and Services</span>
        </nav>
        <h1>Places and Services in DHA Phase 6 Lahore</h1>
        <p class="page-hero-description">Find useful local categories for DHA Phase 6 Lahore, then open a sector-specific page for a more focused guide.</p>
      </div>
    </header>

    <!-- Explore DHA Phase 6 Lahore Facilities (Task 4) -->
    <section class="facilities-showcase" id="facilities-overview">
      <div class="container">
        <div class="facilities-header reveal">
          <span class="facilities-badge">Phase 6 Facilities Directory</span>
          <h2 class="facilities-title">Explore DHA Phase 6 Lahore Facilities</h2>
          <p class="facilities-subtitle">
            Discover schools, hospitals, restaurants, shopping areas and essential services across DHA Phase 6 Lahore.
          </p>
        </div>

        <div class="facilities-grid">
          {SECTORS_DIRECTORY.map((sector) => {
            const summary = getSectorCategorySummary(sector.key);
            const letter = sector.key.startsWith('sector-')
              ? sector.key.replace('sector-', '').toUpperCase()
              : sector.label.charAt(0);
            return (
              <a href={`/places/${sector.key}/`} class="facility-sector-card glass-card reveal">
                <div class="facility-sector-top">
                  <div class="facility-sector-letter">{letter}</div>
                  <span class="facility-sector-count">{summary.totalPlaces} Places</span>
                </div>
                <div class="facility-sector-name">{sector.label}</div>
                <div class="facility-sector-cats">
                  {summary.topCategories.length > 0
                    ? summary.topCategories.join(' • ')
                    : 'Verified Community Facilities'}
                </div>
                <div class="facility-sector-btn">
                  <span>Explore Facilities</span>
                  <span>→</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Verified Places by Category Section -->
    <section class="content-section bg-primary" id="all-categories">
      <div class="container">
        <div class="section-header text-center" style="margin: 0 auto 40px; max-width: 750px;">
          <h2 style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 10px;">
            Verified Places by Category
          </h2>
          <p style="color: var(--clr-text-secondary); font-size: 0.95rem; line-height: 1.6;">
            Browse verified institutions, services, and commercial establishments in DHA Phase 6 Lahore.
            Select a sector below to jump directly to verified local sector branches.
          </p>
        </div>

        <div class="directory-grid">
          {populatedCategories.map((cat) => {
            const sectorsWithPlaces = getCategorySectors(cat.key);
            const totalInCat = sectorsWithPlaces.reduce((sum, s) => sum + s.count, 0);
            return (
              <article class="directory-card glass-card reveal">
                <h2>
                  <a href={`/places/${cat.key}/`}>{cat.label}</a>
                </h2>
                <p>{cat.seoDesc}</p>
                <div class="directory-actions">
                  <a
                    href={`/places/${cat.key}/`}
                    class="view-all-pill"
                  >
                    View All ({totalInCat})
                  </a>
                  {sectorsWithPlaces.map(({ sector, count }) => {
                    const hasSubpage = hasSectorCategoryPage(sector.key, cat.key);
                    return (
                      <a href={hasSubpage ? `/places/${sector.key}/${cat.key}/` : `/places/${sector.key}/`}>
                        {sector.label} ({count})
                      </a>
                    );
                  })}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Publication Meta -->
    <aside class="page-publication-meta" aria-label="Page publication information">
      <div class="container">
        <span>Published <time datetime="2026-09-02T18:14:54+05:00">2 September 2026</time></span>
