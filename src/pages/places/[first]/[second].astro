            <p>Browse all sectors or return to the {sectorMeta?.label} property directory.</p>
            <div>
              <a class="gold-button" href="/sectors/">View all sectors</a>
              <a class="outline-button" href={`/sectors/${sectorMeta?.key}/`}>
