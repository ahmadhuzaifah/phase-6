    background: rgba(52, 152, 219, 0.15);
    border: 1px solid rgba(52, 152, 219, 0.35);
    color: #60a5fa;
    transition: all 0.2s;
  }
  .badge-sector:hover {
    background: rgba(52, 152, 219, 0.25);
    color: #93c5fd;
  }
  .badge-status {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--dir-line);
    color: #34d399;
  }
  .hero-business-card h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.15;
    color: #ffffff;
    font-weight: 800;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .hero-address {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--dir-muted);
    font-size: 0.92rem;
    margin: 0 0 1rem;
  }
  .hero-address svg {
    color: var(--dir-gold);
    flex-shrink: 0;
  }
  .hero-rating-box {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.9rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--dir-line);
    border-radius: 999px;
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
  }
  .rating-stars {
    color: #f59e0b;
    font-size: 0.88rem;
    letter-spacing: 0.05em;
  }
  .hero-rating-box strong {
    color: #ffffff;
  }
  .hero-rating-box span {
    color: var(--dir-dim);
  }
  .hero-rating-box small {
    color: var(--dir-muted);
  }
  .hero-actions-bar {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .btn-lg {
    padding: 0.7rem 1.4rem;
    font-size: 0.82rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 8px;
    font-weight: 700;
  }

  .detail-two-col {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .detail-main-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .detail-photo-box {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--dir-line);
    aspect-ratio: 16 / 9;
    background: #1a1a31;
    box-shadow: 0 16px 36px -20px rgba(0, 0, 0, 0.8);
  }
  .detail-photo-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-badge {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    background: rgba(8, 8, 24, 0.88);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Info Cards Grid (Task 1) */
  .info-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  .info-card {
    background: var(--dir-surface);
    border: 1px solid var(--dir-line);
    border-radius: 10px;
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: border-color 0.2s;
  }
  .info-card:hover {
    border-color: rgba(16, 185, 129, 0.3);
  }
  .info-card-icon {
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
  }
  .info-card h4 {
    margin: 0;
    color: var(--dir-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .info-card-link {
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    word-break: break-all;
    transition: color 0.2s;
  }
  .info-card-link:hover {
    color: var(--dir-gold-light);
  }
  .info-card-link.highlight-maps {
    color: #38bdf8;
  }
  .info-card-link.highlight-maps:hover {
    color: #7dd3fc;
  }
  .info-card-status {
    color: #34d399;
    font-size: 0.9rem;
  }
  .info-card-muted {
    color: var(--dir-dim);
    font-size: 0.85rem;
  }
  .info-card small {
    color: var(--dir-dim);
    font-size: 0.65rem;
    margin-top: 0.2rem;
  }

  /* Detail Card & Amenities */
  .detail-card {
    background: var(--dir-surface);
    border: 1px solid var(--dir-line);
    border-radius: 12px;
    padding: 1.75rem;
  }
  .detail-card h2 {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.8rem;
  }
  .detail-desc {
    color: var(--dir-text);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 1.25rem;
  }
  .detail-amenities {
    border-top: 1px solid var(--dir-line);
    padding-top: 1.15rem;
  }
  .detail-amenities h3 {
    color: var(--dir-muted);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.75rem;
  }
  .amenities-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .amenities-tags span {
    padding: 0.35rem 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--dir-line);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--dir-text);
  }

  /* Location Grid */
  .detail-loc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .detail-loc-grid div {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--dir-line);
    border-radius: 8px;
    padding: 0.9rem;
  }
  .detail-loc-grid small {
    display: block;
    color: var(--dir-dim);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.3rem;
  }
  .detail-loc-grid strong {
    color: #ffffff;
    font-size: 0.84rem;
    line-height: 1.4;
    display: block;
  }
  .detail-actions-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Nearby Places System (Task 2) */
  .nearby-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .nearby-header h2 {
    margin: 0.2rem 0 0.4rem;
  }
  .card-subtext {
    color: var(--dir-muted);
    font-size: 0.82rem;
    margin: 0;
    max-width: 620px;
    line-height: 1.5;
  }
  .nearby-pillars-stack {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .nearby-pillar-block {
    border-top: 1px solid var(--dir-line);
    padding-top: 1.1rem;
  }
  .nearby-pillar-block:first-child {
    border-top: none;
    padding-top: 0;
  }
  .pillar-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 800;
    margin: 0 0 0.85rem;
  }
  .nearby-places-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }
  .nearby-place-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--dir-line);
    border-radius: 8px;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: transform 0.2s, border-color 0.2s;
  }
  .nearby-place-card:hover {
    border-color: rgba(16, 185, 129, 0.35);
    transform: translateY(-2px);
  }
  .np-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.58rem;
  }
  .np-cat {
    color: var(--dir-dim);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 700;
  }
  .np-sector-pill {
    padding: 0.12rem 0.4rem;
    border-radius: 4px;
    font-size: 0.55rem;
    font-weight: 800;
  }
  .pill-same-sector {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
  }
  .pill-nearby-sector {
    background: rgba(255, 255, 255, 0.05);
    color: var(--dir-dim);
  }
  .np-name {
    margin: 0.2rem 0 0;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .np-name a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s;
  }
  .np-name a:hover {
    color: var(--dir-gold-light);
  }
  .np-address {
    color: var(--dir-muted);
    font-size: 0.68rem;
    margin: 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .np-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.65rem;
  }
  .np-rating {
    color: #f59e0b;
    font-weight: 700;
  }
  .np-rating-muted {
    color: var(--dir-dim);
  }
  .np-actions {
    display: flex;
    gap: 0.4rem;
  }
  .np-link-detail {
    color: var(--dir-gold-light);
    font-weight: 700;
    text-decoration: none;
  }
  .np-link-map {
    color: #38bdf8;
    font-weight: 700;
    text-decoration: none;
  }

  /* Properties Near Card (Task 3) */
  .props-cards-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .prop-card-mini {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--dir-line);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }
  .prop-card-mini:hover {
    border-color: rgba(212, 168, 68, 0.35);
    transform: translateY(-2px);
  }
  .prop-card-mini-media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #131327;
    overflow: hidden;
  }
  .prop-card-mini-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prop-badge-mini {
    position: absolute;
    top: 0.4rem;
    left: 0.4rem;
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
    font-size: 0.52rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .badge-local {
    background: rgba(16, 185, 129, 0.9);
    color: #080818;
  }
  .badge-nearby {
    background: rgba(8, 8, 24, 0.85);
    color: var(--dir-dim);
    border: 1px solid var(--dir-line);
  }
  .prop-type-pill {
    position: absolute;
    bottom: 0.4rem;
    left: 0.4rem;
    padding: 0.12rem 0.35rem;
    border-radius: 3px;
    background: rgba(8, 8, 24, 0.8);
    color: #ffffff;
    font-size: 0.52rem;
    font-weight: 700;
    text-transform: capitalize;
  }
  .prop-card-mini-body {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .prop-mini-price {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .prop-mini-price strong {
    color: #34d399;
    font-size: 0.9rem;
    font-weight: 800;
  }
  .prop-mini-price small {
    color: var(--dir-dim);
    font-size: 0.58rem;
    font-weight: 700;
  }
  .prop-mini-title {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prop-mini-title a {
    color: #ffffff;
    text-decoration: none;
  }
  .prop-mini-title a:hover {
    color: var(--dir-gold-light);
  }
  .prop-mini-avail {
    color: #10b981;
    font-size: 0.58rem;
    font-weight: 700;
  }
  .btn-prop-mini {
    margin-top: auto;
    padding: 0.35rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--dir-line);
    color: #ffffff;
    font-size: 0.64rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-prop-mini:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: var(--dir-gold);
    color: var(--dir-gold-light);
  }

  /* Sidebar Navigation Groups */
  .sidebar-links-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sidebar-nav-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--dir-line);
    text-decoration: none;
    transition: all 0.2s;
  }
  .sidebar-nav-btn:hover {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(255, 255, 255, 0.04);
  }
  .sidebar-nav-btn span {
    font-size: 1.2rem;
  }
  .sidebar-nav-btn strong {
    display: block;
    color: #ffffff;
    font-size: 0.78rem;
  }
  .sidebar-nav-btn small {
    display: block;
    color: var(--dir-dim);
    font-size: 0.65rem;
  }

  /* Internal Linking Trail (Task 8) */
  .internal-linking-hub {
    margin-top: 3rem;
    padding: 1.75rem;
    background: var(--dir-surface);
    border: 1px solid var(--dir-line);
    border-radius: 12px;
  }
  .internal-linking-hub h2 {
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 1rem;
  }
  .hub-breadcrumbs-trail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hub-pill {
    padding: 0.45rem 0.8rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--dir-line);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }
  .hub-pill span {
    color: var(--dir-dim);
    font-weight: 600;
  }
  .hub-pill:hover {
    border-color: var(--dir-gold);
    color: var(--dir-gold-light);
  }
  .hub-arrow {
    color: var(--dir-dim);
    font-size: 0.8rem;
  }
  .props-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .prop-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--dir-line);
    border-radius: 8px;
  }
  .prop-tag {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    background: rgba(212, 168, 68, 0.15);
    color: var(--dir-gold);
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    border-radius: 4px;
    margin-bottom: 0.25rem;
  }
  .prop-link {
    display: block;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.88rem;
  }
  .prop-link:hover {
    color: var(--dir-gold-light);
  }
  .prop-price {
    text-align: right;
    flex-shrink: 0;
  }
  .prop-price strong {
    display: block;
    color: #ffffff;
    font-size: 0.92rem;
  }
  .prop-price a {
    color: var(--dir-gold);
    font-size: 0.7rem;
    font-weight: 700;
  }
  .prop-tags-strip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }
  .prop-badge-pill {
    font-size: 0.55rem;
    font-weight: 800;
    padding: 0.12rem 0.4rem;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .pill-direct {
    background: rgba(212, 168, 68, 0.2);
    color: var(--dir-gold-light);
  }
  .pill-nearby {
    background: rgba(255, 255, 255, 0.05);
    color: var(--dir-dim);
  }
  .prop-size-badge {
    font-size: 0.58rem;
    color: var(--dir-muted);
    font-weight: 700;
  }
  .prop-detail-footer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--dir-line);
  }
  .prop-detail-cta-text {
    margin-bottom: 0.75rem;
  }
  .prop-detail-cta-text strong {
    display: block;
    color: #ffffff;
    font-size: 0.85rem;
  }
  .prop-detail-cta-text span {
    display: block;
    color: var(--dir-muted);
    font-size: 0.75rem;
    margin-top: 0.2rem;
  }
  .prop-detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .btn-gold-sm {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--dir-gold), var(--dir-gold-light));
    color: #080818;
    font-size: 0.72rem;
    font-weight: 800;
    text-decoration: none;
  }
  .btn-outline-sm {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.8rem;
    border-radius: 6px;
    border: 1px solid var(--dir-line);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-outline-sm:hover {
    border-color: var(--dir-gold);
    color: var(--dir-gold-light);
  }
  .detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-box {
    background: var(--dir-surface);
    border: 1px solid var(--dir-line);
    border-radius: 10px;
    padding: 1.5rem;
  }
  .sidebar-box h3 {
    margin: 0 0 1rem;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    border-bottom: 1px solid var(--dir-line);
    padding-bottom: 0.75rem;
  }
  .summary-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .summary-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.78rem;
  }
  .summary-list span {
    color: var(--dir-dim);
  }
  .summary-list strong {
    color: #ffffff;
    font-weight: 600;
  }
  .summary-list .text-green {
    color: #2ecc71;
  }
  .full-w {
    width: 100%;
    text-align: center;
    justify-content: center;
  }
  .sibling-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sibling-item {
    display: block;
    padding: 0.75rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--dir-line);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .sibling-item:hover {
    border-color: rgba(212, 168, 68, 0.3);
    background: rgba(255, 255, 255, 0.04);
  }
  .sibling-item small {
    display: block;
    color: var(--dir-gold);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .sibling-item strong {
    display: block;
    color: #ffffff;
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .directory-toolbar {
      grid-template-columns: 1fr;
    }
    .business-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .detail-two-col {
      grid-template-columns: 1fr;
    }
    .nearby-places-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .props-cards-grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .detail-loc-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 620px) {
    .page-hero,
    .place-hero-premium {
      padding: 40px 0 32px;
    }
    .directory-section {
      padding: 35px 0 55px;
    }
    .directory-controls,
    .business-grid,
    .info-cards-grid,
    .nearby-places-grid,
    .props-cards-grid-4 {
      grid-template-columns: 1fr;
    }
    .hero-actions-bar {
      flex-direction: column;
    }
    .btn-lg {
      width: 100%;
      justify-content: center;
