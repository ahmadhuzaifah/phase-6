---
/**
 * DHA Phase 6 Lahore — Places Level 3 Handler
 * Handles:
 * 1. Sector + Category Directory: /places/[sector]/[category]/ (e.g. /places/sector-a/restaurants/)
 * 2. Place Detail Page: /places/[category]/[slug]/ (e.g. /places/schools/beaconhouse-school-system-dha-phase-6-campus/)
 */
import PageLayout from '@layouts/PageLayout.astro';
import PlaceImage from '@components/places/PlaceImage.astro';
import {
  SECTORS_DIRECTORY,
  PLACE_CATEGORIES,
  getAllPlaces,
  getSectorPlaces,
  getSectorCategoryPlaces,
  getCategorySectors,
  getPopulatedSectorCategoryPairs,
  getPlaceImage,
  type PlaceRecord,
  type SectorMeta,
} from '@data/places/index';
import type { PlaceCategoryMeta } from '@data/places';
import propertiesRaw from '@data/properties-import.json';
import { SITE } from '@data/site';

export function getStaticPaths() {
  const populatedPairs = getPopulatedSectorCategoryPairs();
  const sectorCategoryPaths = populatedPairs.map(({ sector, category, places }) => ({
    params: { first: sector.key, second: category.key },
    props: {
      type: 'sector-category' as const,
      sectorMeta: sector,
      categoryMeta: category,
      places,
      place: null,
    },
  }));

  const allPlaces = getAllPlaces();
  const placeDetailPaths = allPlaces.map((place) => ({
    params: { first: place.category, second: place.slug },
    props: {
      type: 'place-detail' as const,
      sectorMeta: SECTORS_DIRECTORY.find((s) => s.key === place.sector) || null,
      categoryMeta: PLACE_CATEGORIES.find((c) => c.key === place.category) || null,
      places: [],
      place: place,
    },
  }));

  return [...sectorCategoryPaths, ...placeDetailPaths];
}

interface Props {
  type: 'sector-category' | 'place-detail';
  sectorMeta: SectorMeta | null;
  categoryMeta: PlaceCategoryMeta | null;
  places: PlaceRecord[];
  place: PlaceRecord | null;
}

const { type, sectorMeta, categoryMeta, places, place } = Astro.props as Props;
const isDetail = type === 'place-detail' && place !== null;

// Nearby places computation (Task 2)
const allOtherPlaces = isDetail ? getAllPlaces().filter((p) => p.id !== place.id) : [];

const sortedNearby = isDetail
  ? [...allOtherPlaces].sort((a, b) => {
      // Prioritize same sector first
      if (a.sector === place.sector && b.sector !== place.sector) return -1;
      if (b.sector === place.sector && a.sector !== place.sector) return 1;
      const distA = Math.hypot(a.lat - place.lat, a.lng - place.lng);
      const distB = Math.hypot(b.lat - place.lat, b.lng - place.lng);
      return distA - distB;
    })
  : [];

const NEARBY_PILLARS = [
  { title: 'Nearby Dining', icon: '🍽️', categories: ['restaurants', 'restaurant', 'cafes', 'cafe', 'bakery', 'fast-food'] },
  { title: 'Nearby Mosques', icon: '🕌', categories: ['mosque', 'mosques'] },
  { title: 'Nearby Schools', icon: '🎓', categories: ['schools', 'school', 'colleges'] },
  { title: 'Nearby Banks & ATMs', icon: '🏦', categories: ['banks', 'bank', 'services'] },
  { title: 'Nearby Parks & Health', icon: '🌳', categories: ['park', 'parks', 'hospital', 'hospitals', 'clinic', 'pharmacy', 'gym', 'gyms'] },
];

const nearbyPillars = isDetail
  ? NEARBY_PILLARS.map((pillar) => {
      const matched = sortedNearby.filter((p) => pillar.categories.includes(p.category)).slice(0, 3);
      return { ...pillar, places: matched };
    }).filter((pillar) => pillar.places.length > 0)
  : [];

const siblingPlaces = isDetail
  ? getSectorPlaces(place.sector).filter((p) => p.id !== place.id).slice(0, 4)
  : [];

const currentSectorLabel = isDetail ? place.sectorLabel : sectorMeta?.label;

// Property connections (Task 3)
const sectorDirectProperties = (propertiesRaw as any[]).filter((prop) => {
  if (!currentSectorLabel) return false;
  return (
    prop.block?.toLowerCase().includes(currentSectorLabel.toLowerCase()) ||
    prop.location?.address?.toLowerCase().includes(currentSectorLabel.toLowerCase())
  );
});

const otherProperties = (propertiesRaw as any[]).filter(
  (prop) => !sectorDirectProperties.some((dp) => dp.id === prop.id)
);

const allPropsPool = [...sectorDirectProperties, ...otherProperties];
const nearbyHouses = allPropsPool.filter((p) => p.propertyType === 'house').slice(0, 2);
const nearbyPlots = allPropsPool.filter((p) => p.propertyType === 'plot').slice(0, 2);
const nearbyCommercial = allPropsPool.filter((p) => p.propertyType === 'commercial').slice(0, 2);

const curatedProperties = [
  ...nearbyHouses,
  ...nearbyPlots,
  ...nearbyCommercial,
  ...allPropsPool,
].filter((item, index, self) => index === self.findIndex((t) => t.id === item.id)).slice(0, 4);

const pageTitle = isDetail
  ? `${place.name} | ${place.categoryLabel} in ${place.sectorLabel}, DHA Phase 6 Lahore`
  : `Best ${categoryMeta?.label} in DHA Phase 6 Lahore ${sectorMeta?.label}`;

const metaDesc = isDetail
  ? `${place.name} located at ${place.address}. Verified rating: ${place.rating ? `${place.rating}★ (${place.reviewCount} reviews)` : 'Verified'}. Contact, operating status, and direct Google Maps directions.`
  : `Discover the best verified ${categoryMeta?.label?.toLowerCase()} in ${sectorMeta?.label}, DHA Phase 6 Lahore. Complete directory with phone numbers, Google Maps directions, ratings, and addresses.`;

const canonical = isDetail
  ? `${SITE.url}/places/${place.category}/${place.slug}/`
  : `${SITE.url}/places/${sectorMeta?.key}/${categoryMeta?.key}/`;

const publishedDate = isDetail && place ? place.retrievedAt : places[0]?.retrievedAt || '2026-09-03';
const formattedDate = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' }).format(new Date(`${publishedDate}T12:00:00`));

// Only link to sectors that actually have places in this category
const nearbySectors = categoryMeta
  ? getCategorySectors(categoryMeta.key)
      .map((s) => s.sector)
      .filter((s) => s.key !== sectorMeta?.key)
  : [];

// Only link to categories that actually exist in this sector
const relatedCategories = sectorMeta
  ? PLACE_CATEGORIES.filter(
      (c) => getSectorCategoryPlaces(sectorMeta.key, c.key).length > 0 && c.key !== categoryMeta?.key
    )
  : [];

const placePropertySchemas = isDetail && sectorDirectProperties.length > 0
  ? sectorDirectProperties.map((prop) => ({
      '@type': 'RealEstateListing',
      '@id': `${SITE.url}/properties/${prop.slug}/`,
      name: prop.title,
      url: `${SITE.url}/properties/${prop.slug}/`,
      description: prop.description,
      offers: {
        '@type': 'Offer',
        price: prop.price,
        priceCurrency: prop.currency || 'PKR',
        availability: 'https://schema.org/InStock',
      },
    }))
  : [];

const structuredData = isDetail
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'LocalBusiness',
          '@id': canonical,
          name: place.name,
          description: place.description,
          url: canonical,
          image: getPlaceImage(place).src,
          telephone: place.phone || '+92 42 111 342 547',
          hasMap: place.googleMapsUrl,
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
          geo: {
            '@type': 'GeoCoordinates',
            latitude: place.lat,
            longitude: place.lng,
          },
          openingHoursSpecification: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
            opens: '08:00',
            closes: '22:00',
          },
          ...(place.rating ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: place.rating,
              reviewCount: place.reviewCount || 1,
              bestRating: '5',
              worstRating: '1',
            },
          } : {}),
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
            { '@type': 'ListItem', position: 3, name: place.categoryLabel, item: `${SITE.url}/places/${place.category}/` },
            { '@type': 'ListItem', position: 4, name: place.sectorLabel, item: `${SITE.url}/sectors/${place.sector}/places/` },
            { '@type': 'ListItem', position: 5, name: place.name, item: canonical },
          ],
        },
        ...placePropertySchemas,
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'CollectionPage',
          '@id': canonical,
          name: pageTitle,
          description: metaDesc,
          url: canonical,
        },
        {
          '@type': 'ItemList',
          name: pageTitle,
          description: metaDesc,
          itemListOrder: 'https://schema.org/ItemListOrderDescending',
          numberOfItems: places.length,
          itemListElement: places.map((p, idx) => ({
            '@type': 'ListItem',
            position: idx + 1,
            item: {
              '@type': 'LocalBusiness',
              name: p.name,
              description: p.description,
              url: `${SITE.url}/places/${p.category}/${p.slug}/`,
              image: getPlaceImage(p).src,
              address: {
                '@type': 'PostalAddress',
                streetAddress: p.address,
                addressLocality: 'Lahore',
                addressRegion: 'Punjab',
                postalCode: '54792',
                addressCountry: 'PK',
              },
              ...(p.phone ? { telephone: p.phone } : {}),
              ...(p.rating
                ? {
                    aggregateRating: {
                      '@type': 'AggregateRating',
                      ratingValue: p.rating,
                      reviewCount: p.reviewCount || 1,
                    },
                  }
                : {}),
            },
          })),
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
            { '@type': 'ListItem', position: 3, name: sectorMeta?.label || 'Sector', item: `${SITE.url}/places/${sectorMeta?.key}/` },
            { '@type': 'ListItem', position: 4, name: categoryMeta?.label || 'Category', item: canonical },
          ],
        },
      ],
    };
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  {isDetail && place ? (
    <div class="place-detail-container">
      <header class="place-hero-premium">
        <div class="container">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/places/">Places</a>
            <span>/</span>
            <a href={`/places/${place.category}/`}>{place.categoryLabel}</a>
            <span>/</span>
            <a href={`/sectors/${place.sector}/places/`}>{place.sectorLabel}</a>
            <span>/</span>
            <span aria-current="page">{place.name}</span>
          </nav>

          <div class="hero-business-card">
            <div class="hero-business-badges">
              <span class="badge-pill badge-category">{place.categoryLabel}</span>
              <a href={`/sectors/${place.sector}/places/`} class="badge-pill badge-sector">{place.sectorLabel}</a>
              <span class="badge-pill badge-status">● {place.status || 'Open Daily'}</span>
            </div>
            <h1>{place.name}</h1>
            <p class="hero-address">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>{place.address}</span>
            </p>
            {place.rating && (
              <div class="hero-rating-box">
                <span class="rating-stars" aria-label={`${place.rating} out of 5 stars`}>
                  {'★'.repeat(Math.round(place.rating))}
                </span>
                <strong>{place.rating.toFixed(1)}</strong>
                <span>/ 5.0</span>
                <small>{place.reviewCount > 0 ? `(${place.reviewCount} verified reviews)` : '(Verified local establishment)'}</small>
              </div>
            )}
            <div class="hero-actions-bar">
              <a
                href={place.googleMapsUrl}
                target="_blank"
                rel="noopener"
                class="gold-button btn-lg"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                Open in Google Maps ↗
              </a>
              {place.phone ? (
                <a href={`tel:${place.phone.replace(/\s+/g, '')}`} class="outline-button btn-lg">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  Call {place.phone}
                </a>
              ) : (
                <a href={`/sectors/${place.sector}/places/`} class="outline-button btn-lg">
                  Explore {place.sectorLabel} Facilities →
                </a>
              )}
            </div>
          </div>
        </div>
      </header>

      <section class="directory-section">
        <div class="container">
          <div class="detail-two-col">
            <div class="detail-main-info">
              <!-- Photo showcase -->
              <div class="detail-photo-box">
                <PlaceImage place={place} width={850} height={480} priority={true} />
                <span class="photo-badge">Verified {place.categoryLabel}</span>
              </div>

              <!-- About & Profile Card -->
              <div class="detail-card">
                <h2>About {place.name}</h2>
                <p class="detail-desc">{place.description}</p>

                {place.features && place.features.length > 0 && (
                  <div class="detail-amenities">
                    <h3>Highlights &amp; Amenities</h3>
                    <div class="amenities-tags">
                      {place.features.map((f) => (
                        <span>✓ {f}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <!-- Information Cards Grid (Task 1) -->
              <div class="info-cards-grid">
                <div class="info-card">
                  <div class="info-card-icon">📞</div>
                  <h4>Phone &amp; Inquiries</h4>
                  {place.phone ? (
                    <a href={`tel:${place.phone.replace(/\s+/g, '')}`} class="info-card-link">{place.phone}</a>
                  ) : (
                    <span class="info-card-muted">Sector office inquiries</span>
                  )}
                  <small>Direct voice contact</small>
                </div>

                <div class="info-card">
                  <div class="info-card-icon">🌐</div>
                  <h4>Official Website</h4>
                  {place.website ? (
                    <a href={place.website} target="_blank" rel="noopener" class="info-card-link">Visit Website ↗</a>
                  ) : (
                    <a href={place.googleMapsUrl} target="_blank" rel="noopener" class="info-card-link">Verified Google Listing ↗</a>
                  )}
                  <small>Online presence &amp; details</small>
                </div>

                <div class="info-card">
                  <div class="info-card-icon">🗺️</div>
                  <h4>Navigation</h4>
                  <a href={place.googleMapsUrl} target="_blank" rel="noopener" class="info-card-link highlight-maps">Open in Google Maps ↗</a>
                  <small>Universal live search pin</small>
                </div>

                <div class="info-card">
                  <div class="info-card-icon">🕒</div>
                  <h4>Operating Status</h4>
                  <strong class="info-card-status">{place.status || 'Open Daily'}</strong>
                  <small>DHA Phase 6 local timings</small>
                </div>
              </div>

              <!-- Location & Coordinates Card -->
              <div class="detail-card">
                <h2>Location &amp; Coordinates</h2>
                <div class="detail-loc-grid">
                  <div>
                    <small>Full Address</small>
                    <strong>{place.address}</strong>
                  </div>
                  <div>
                    <small>Sector &amp; Area</small>
                    <strong>{place.sectorLabel}, DHA Phase 6 Lahore</strong>
                  </div>
                  <div>
                    <small>GPS Coordinates</small>
                    <strong>{place.lat.toFixed(4)}° N, {place.lng.toFixed(4)}° E</strong>
                  </div>
                </div>
                <div class="detail-actions-bar">
                  <a
                    href={place.googleMapsUrl}
                    target="_blank"
                    rel="noopener"
                    class="gold-button"
                  >
                    Open in Google Maps ↗
                  </a>
                  {place.phone && (
                    <a href={`tel:${place.phone.replace(/\s+/g, '')}`} class="outline-button">
                      Call {place.phone}
                    </a>
                  )}
                </div>
              </div>

              <!-- Nearby Places System (Task 2) -->
              <div class="detail-card nearby-places-card">
                <div class="nearby-header">
                  <div>
                    <span class="section-kicker"><span></span> Proximity Intelligence</span>
                    <h2>Nearby Places Around {place.name}</h2>
                    <p class="card-subtext">
                      Verified places and essential amenities in {place.sectorLabel} and adjacent sectors.
                    </p>
                  </div>
                  <a href={`/sectors/${place.sector}/places/`} class="btn-outline-sm">
                    View All {place.sectorLabel} Places →
                  </a>
                </div>

                <div class="nearby-pillars-stack">
                  {nearbyPillars.map((pillar) => (
                    <div class="nearby-pillar-block">
                      <h3 class="pillar-title">
                        <span>{pillar.icon}</span>
                        {pillar.title}
                      </h3>
                      <div class="nearby-places-grid">
                        {pillar.places.map((np) => (
                          <div class="nearby-place-card">
                            <div class="np-header">
                              <span class="np-cat">{np.categoryLabel}</span>
                              <span class={`np-sector-pill ${np.sector === place.sector ? 'pill-same-sector' : 'pill-nearby-sector'}`}>
                                {np.sector === place.sector ? `Same Sector (${place.sectorLabel})` : np.sectorLabel}
                              </span>
                            </div>
                            <h4 class="np-name">
                              <a href={`/places/${np.category}/${np.slug}/`}>{np.name}</a>
                            </h4>
                            <p class="np-address">{np.address}</p>
                            <div class="np-footer">
                              {np.rating ? (
                                <span class="np-rating">★ {np.rating.toFixed(1)}</span>
                              ) : (
                                <span class="np-rating-muted">Verified</span>
                              )}
                              <div class="np-actions">
                                <a href={`/places/${np.category}/${np.slug}/`} class="np-link-detail">Details →</a>
                                <a href={np.googleMapsUrl} target="_blank" rel="noopener" class="np-link-map" title="Open in Google Maps">Maps ↗</a>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Properties Near This Location (Task 3) -->
              <div class="detail-card properties-near-card">
                <div class="nearby-header">
                  <div>
                    <span class="section-kicker"><span></span> Property Intelligence</span>
                    <h2>Properties Near {place.name}</h2>
                    <p class="card-subtext">
                      Verified market listings, houses, plots, and commercial opportunities in and around {place.sectorLabel}, DHA Phase 6.
                    </p>
                  </div>
                  <a href={`/sectors/${place.sector}/properties/`} class="btn-outline-sm">
                    {place.sectorLabel} Property Guide →
                  </a>
                </div>

                <div class="props-cards-grid-4">
                  {curatedProperties.map((prop) => {
                    const isDirect = prop.block?.toLowerCase().includes(place.sectorLabel.toLowerCase()) ||
                      prop.location?.address?.toLowerCase().includes(place.sectorLabel.toLowerCase());
                    return (
                      <div class="prop-card-mini">
                        <div class="prop-card-mini-media">
                          <img
                            src={prop.images?.[0] || 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=600&auto=format&fit=crop&q=80'}
                            alt={prop.title}
                            loading="lazy"
                          />
                          <span class={`prop-badge-mini ${isDirect ? 'badge-local' : 'badge-nearby'}`}>
                            {isDirect ? place.sectorLabel : (prop.block || 'Nearby')}
                          </span>
                          <span class="prop-type-pill">{prop.propertyType}</span>
                        </div>
                        <div class="prop-card-mini-body">
                          <div class="prop-mini-price">
                            <strong>PKR {(prop.price / 10000000).toFixed(2)} Cr</strong>
                            <small>{prop.size} {prop.unit.toUpperCase()}</small>
                          </div>
                          <h4 class="prop-mini-title">
                            <a href={`/properties/${prop.slug}/`}>{prop.title}</a>
                          </h4>
                          <span class="prop-mini-avail">● Verified Available</span>
                          <a href={`/properties/${prop.slug}/`} class="btn-prop-mini">
                            View Property →
                          </a>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <div class="prop-detail-footer">
                  <div class="prop-detail-cta-text">
                    <strong>Looking for custom plots or luxury houses in {place.sectorLabel}?</strong>
                    <span>Explore complete sector inventory or search live listings on Zameen.com</span>
                  </div>
                  <div class="prop-detail-actions">
                    <a
                      href="https://www.zameen.com/Plots/Lahore_Defence__DHA__Phase_6-1448-1.html"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-gold-sm"
                    >
                      Search on Zameen ↗
                    </a>
                    <a href={`/sectors/${place.sector}/properties/`} class="btn-outline-sm">
                      {place.sectorLabel} Property Guide →
                    </a>
                    <a href={`/sectors/${place.sector}/places/`} class="btn-outline-sm">
                      {place.sectorLabel} Facilities Guide →
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <aside class="detail-sidebar">
              <div class="sidebar-box">
                <h3>Facility Summary</h3>
                <ul class="summary-list">
                  <li><span>Category:</span> <strong>{place.categoryLabel}</strong></li>
                  <li><span>Sector:</span> <strong>{place.sectorLabel}</strong></li>
                  <li><span>Address:</span> <strong>{place.address}</strong></li>
                  <li><span>Timings:</span> <strong class="text-green">{place.status || 'Open daily'}</strong></li>
                  {place.phone && <li><span>Phone:</span> <strong>{place.phone}</strong></li>}
                  <li><span>City:</span> <strong>DHA Phase 6, Lahore</strong></li>
                  <li><span>Postal Code:</span> <strong>54792</strong></li>
                </ul>
                <a
                  href={place.googleMapsUrl}
                  target="_blank"
                  rel="noopener"
                  class="gold-button full-w"
                >
                  Open in Google Maps ↗
                </a>
                {place.phone && (
                  <a href={`tel:${place.phone.replace(/\s+/g, '')}`} class="outline-button full-w" style="margin-top: 0.6rem;">
                    Call {place.phone}
                  </a>
                )}
              </div>

              <!-- Sector Hub Navigation -->
              <div class="sidebar-box">
                <h3>{place.sectorLabel} Guides</h3>
                <div class="sidebar-links-group">
                  <a href={`/sectors/${place.sector}/properties/`} class="sidebar-nav-btn">
                    <span>🏢</span>
                    <div>
                      <strong>{place.sectorLabel} Properties</strong>
                      <small>Plots, houses &amp; pricing</small>
                    </div>
                  </a>
                  <a href={`/sectors/${place.sector}/places/`} class="sidebar-nav-btn">
