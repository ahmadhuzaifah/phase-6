---
/**
 * DHA Phase 6 Lahore — Places Level 3 Handler
 * Handles:
 * 1. Sector + Category Directory: /places/[sector]/[category]/ (e.g. /places/sector-a/restaurants/)
 * 2. Place Detail Page: /places/[category]/[slug]/ (e.g. /places/schools/beaconhouse-school-system-dha-phase-6-campus/)
 */
import PageLayout from '@layouts/PageLayout.astro';
import PlaceImage from '@components/places/PlaceImage.astro';
import {
  SECTORS_DIRECTORY,
  PLACE_CATEGORIES,
  getAllPlaces,
  getSectorPlaces,
  getSectorCategoryPlaces,
  getCategorySectors,
  getPopulatedSectorCategoryPairs,
  getPlaceImage,
  type PlaceRecord,
  type SectorMeta,
} from '@data/places/index';
import type { PlaceCategoryMeta } from '@data/places';
import propertiesRaw from '@data/properties-import.json';
import { SITE } from '@data/site';

export function getStaticPaths() {
  const populatedPairs = getPopulatedSectorCategoryPairs();
  const sectorCategoryPaths = populatedPairs.map(({ sector, category, places }) => ({
    params: { first: sector.key, second: category.key },
    props: {
      type: 'sector-category' as const,
      sectorMeta: sector,
      categoryMeta: category,
      places,
      place: null,
    },
  }));

  const allPlaces = getAllPlaces();
  const placeDetailPaths = allPlaces.map((place) => ({
    params: { first: place.category, second: place.slug },
    props: {
      type: 'place-detail' as const,
      sectorMeta: SECTORS_DIRECTORY.find((s) => s.key === place.sector) || null,
      categoryMeta: PLACE_CATEGORIES.find((c) => c.key === place.category) || null,
      places: [],
      place: place,
    },
  }));

  return [...sectorCategoryPaths, ...placeDetailPaths];
}

interface Props {
  type: 'sector-category' | 'place-detail';
  sectorMeta: SectorMeta | null;
  categoryMeta: PlaceCategoryMeta | null;
  places: PlaceRecord[];
  place: PlaceRecord | null;
}

const { type, sectorMeta, categoryMeta, places, place } = Astro.props;
const isDetail = type === 'place-detail' && place !== null;

const siblingPlaces = isDetail
  ? getSectorPlaces(place.sector).filter((p) => p.id !== place.id).slice(0, 4)
  : [];

const currentSectorLabel = isDetail ? place.sectorLabel : sectorMeta?.label;
const nearbyProperties = propertiesRaw.filter((prop) => {
  if (!currentSectorLabel) return false;
  return (
    prop.block?.toLowerCase().includes(currentSectorLabel.toLowerCase()) ||
    prop.location?.address?.toLowerCase().includes(currentSectorLabel.toLowerCase())
  );
}).slice(0, 3);

const pageTitle = isDetail
  ? `${place.name} | ${place.categoryLabel} in ${place.sectorLabel}, DHA Phase 6 Lahore`
  : `${categoryMeta?.label} in ${sectorMeta?.label} | DHA Phase 6 Lahore Directory`;

const metaDesc = isDetail
  ? `${place.name} located at ${place.address}. Verified rating: ${place.rating ? `${place.rating}★ (${place.reviewCount} reviews)` : 'Verified'}. Contact, operating status, and direct Google Maps directions.`
  : `Explore verified ${categoryMeta?.label?.toLowerCase()} in ${sectorMeta?.label}, DHA Phase 6 Lahore with exact addresses, ratings, and maps.`;

const canonical = isDetail
  ? `${SITE.url}/places/${place.category}/${place.slug}/`
  : `${SITE.url}/places/${sectorMeta?.key}/${categoryMeta?.key}/`;

const publishedDate = isDetail && place ? place.retrievedAt : places[0]?.retrievedAt || '2026-09-03';
const formattedDate = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' }).format(new Date(`${publishedDate}T12:00:00`));

// Only link to sectors that actually have places in this category
const nearbySectors = categoryMeta
  ? getCategorySectors(categoryMeta.key)
      .map((s) => s.sector)
      .filter((s) => s.key !== sectorMeta?.key)
  : [];

// Only link to categories that actually exist in this sector
const relatedCategories = sectorMeta
  ? PLACE_CATEGORIES.filter(
      (c) => getSectorCategoryPlaces(sectorMeta.key, c.key).length > 0 && c.key !== categoryMeta?.key
    )
  : [];


const structuredData = isDetail
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'LocalBusiness',
          '@id': canonical,
          name: place.name,
          description: place.description,
          url: canonical,
          image: getPlaceImage(place).src,
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
          geo: {
            '@type': 'GeoCoordinates',
            latitude: place.lat,
            longitude: place.lng,
          },
          ...(place.rating ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: place.rating,
              reviewCount: place.reviewCount || 1,
            },
          } : {}),
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
            { '@type': 'ListItem', position: 3, name: place.categoryLabel, item: `${SITE.url}/places/${place.category}/` },
            { '@type': 'ListItem', position: 4, name: place.name, item: canonical },
          ],
        },
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'CollectionPage',
          '@id': canonical,
          name: pageTitle,
          description: metaDesc,
          url: canonical,
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
            { '@type': 'ListItem', position: 3, name: sectorMeta?.label || 'Sector', item: `${SITE.url}/places/${sectorMeta?.key}/` },
            { '@type': 'ListItem', position: 4, name: categoryMeta?.label || 'Category', item: canonical },
          ],
        },
      ],
    };
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  {isDetail && place ? (
    <div class="place-detail-container">
      <header class="page-hero">
        <div class="container">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/places/">Places</a>
            <span>/</span>
            <a href={`/places/${place.sector}/`}>{place.sectorLabel}</a>
            <span>/</span>
            <a href={`/places/${place.category}/`}>{place.categoryLabel}</a>
            <span>/</span>
            <span aria-current="page">{place.name}</span>
          </nav>

          <h1>{place.name}</h1>
          <p>{place.address}</p>
        </div>
      </header>

      <section class="directory-section">
        <div class="container">
          <div class="detail-two-col">
            <div class="detail-main-info">
              <div class="detail-photo-box">
                <PlaceImage place={place} width={800} height={460} priority={true} />
              </div>

              <div class="detail-card">
                <div class="detail-header-row">
                  <div class="business-tags">
                    <span>{place.categoryLabel}</span>
                    <span>{place.sectorLabel}</span>
                  </div>
                  {place.rating && (
                    <div class="business-rating">
                      <span aria-label={`${place.rating} out of 5 stars`}>★</span>
                      <strong>{place.rating.toFixed(1)}</strong>
                      <small>{place.reviewCount > 0 ? `(${place.reviewCount} Google reviews)` : ''}</small>
                    </div>
                  )}
                </div>

                <h2>About {place.name}</h2>
                <p class="detail-desc">{place.description}</p>

                {place.features && place.features.length > 0 && (
                  <div class="detail-amenities">
                    <h3>Key Highlights &amp; Amenities</h3>
                    <div class="amenities-tags">
                      {place.features.map((f) => (
                        <span>✓ {f}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div class="detail-card">
                <h2>Location &amp; Coordinates</h2>
                <div class="detail-loc-grid">
                  <div>
                    <small>Sector &amp; Area</small>
                    <strong>{place.sectorLabel}, DHA Phase 6 Lahore</strong>
                  </div>
                  <div>
                    <small>GPS Coordinates</small>
                    <strong>{place.lat.toFixed(4)}° N, {place.lng.toFixed(4)}° E</strong>
                  </div>
                </div>
                <div class="detail-actions-bar">
                  <a
                    href={place.googleMapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="gold-button"
                  >
                    Open Google Maps Directions ↗
                  </a>
                  {place.phone && (
                    <a href={`tel:${place.phone}`} class="outline-button">
                      Call {place.phone}
                    </a>
                  )}
                </div>
              </div>

              {nearbyProperties.length > 0 && (
                <div class="detail-card">
                  <h2>Properties Near {place.name}</h2>
                  <p class="card-subtext">Live asking-price snapshots in {place.sectorLabel}, DHA Phase 6.</p>
                  <div class="props-list">
                    {nearbyProperties.map((prop) => (
                      <div class="prop-row">
                        <div>
                          <span class="prop-tag">{prop.propertyType}</span>
                          <a href={`/properties/${prop.slug}/`} class="prop-link">{prop.title}</a>
                          <small>{prop.location?.address || prop.block}</small>
                        </div>
                        <div class="prop-price">
                          <strong>PKR {(prop.price / 10000000).toFixed(2)} Cr</strong>
                          <a href={`/properties/${prop.slug}/`}>View Plot →</a>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <aside class="detail-sidebar">
              <div class="sidebar-box">
                <h3>Facility Summary</h3>
                <ul class="summary-list">
                  <li><span>Category:</span> <strong>{place.categoryLabel}</strong></li>
                  <li><span>Sector:</span> <strong>{place.sectorLabel}</strong></li>
                  <li><span>Timings:</span> <strong class="text-green">{place.status}</strong></li>
                  {place.phone && <li><span>Phone:</span> <strong>{place.phone}</strong></li>}
                  <li><span>City:</span> <strong>DHA Phase 6, Lahore</strong></li>
                  <li><span>Postal Code:</span> <strong>54792</strong></li>
                </ul>
                <a
                  href={place.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="gold-button full-w"
                >
                  Navigate via Maps ↗
                </a>
              </div>

              {siblingPlaces.length > 0 && (
                <div class="sidebar-box">
                  <h3>Other Places in {place.sectorLabel}</h3>
                  <div class="sibling-links">
                    {siblingPlaces.map((s) => (
                      <a href={`/places/${s.category}/${s.slug}/`} class="sibling-item">
                        <small>{s.categoryLabel}</small>
                        <strong>{s.name}</strong>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </aside>
          </div>

          <section class="sector-callout">
            <p class="section-kicker"><span></span> {place.sectorLabel} local guide</p>
            <h2>Explore more in {place.sectorLabel}</h2>
            <p>Browse all sectors or return to the {place.sectorLabel} property directory.</p>
            <div>
              <a class="gold-button" href="/sectors/">View all sectors</a>
              <a class="outline-button" href={`/places/${place.sector}/`}>
                All Places in {place.sectorLabel}
              </a>
            </div>
          </section>
        </div>
      </section>

      <aside class="publication">
        <div class="container">
          Published {formattedDate} <span>Business information sourced from public Google Maps cards; verify details before visiting.</span>
        </div>
      </aside>
    </div>
  ) : (
    <div class="sector-category-directory">
      <header class="page-hero">
        <div class="container">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/places/">Places</a>
            <span>/</span>
            <a href={`/places/${sectorMeta?.key}/`}>{sectorMeta?.label}</a>
            <span>/</span>
            <span aria-current="page">{categoryMeta?.label}</span>
          </nav>

          <h1>{categoryMeta?.label} in {sectorMeta?.label} DHA Phase 6 Lahore</h1>
          <p>
            A focused local guide to {categoryMeta?.label?.toLowerCase()} and services in {sectorMeta?.label}, DHA Phase 6 Lahore.
          </p>
        </div>
      </header>

      <section class="directory-section">
        <div class="container">
          <div class="directory-toolbar">
            <div>
              <p class="section-kicker"><span></span> Local directory</p>
              <h2>{categoryMeta?.label} in {sectorMeta?.label}</h2>
              <p>
                <strong id="result-count">{places.length}</strong> {places.length === 1 ? 'business' : 'businesses'} in DHA Phase 6 Lahore
              </p>
            </div>

            <div class="directory-controls">
              <label>
                Search businesses
                <input id="business-search" type="search" placeholder="Search by name or address" />
              </label>
              <label>
                Sort results
                <select id="business-sort">
                  <option value="reviews">Most reviewed</option>
                  <option value="rating">Highest rated</option>
                  <option value="name">Name A-Z</option>
                </select>
              </label>
            </div>
          </div>

          {places.length > 0 ? (
            <div class="business-grid" id="business-grid">
              {places.map((p) => (
                <article
                  class="business-card"
                  data-name={p.name.toLowerCase()}
                  data-address={p.address.toLowerCase()}
                  data-rating={p.rating || 0}
                  data-reviews={p.reviewCount}
                >
                  <a class="business-photo" href={`/places/${p.category}/${p.slug}/`}>
                    <PlaceImage place={p} />
                  </a>

                  <div class="business-body">
                    <div class="business-tags">
                      <span>{categoryMeta?.label}</span>
                      <span>{sectorMeta?.label}</span>
                    </div>

                    <h3>
                      <a href={`/places/${p.category}/${p.slug}/`}>{p.name}</a>
                    </h3>

                    <div class="business-rating">
                      {p.rating ? (
                        <>
                          <span aria-label={`${p.rating} out of 5 stars`}>★</span>
                          <strong>{p.rating.toFixed(1)}</strong>
                          <small>{p.reviewCount > 0 ? `${p.reviewCount.toLocaleString('en-PK')} reviews` : 'Google rating'}</small>
                        </>
                      ) : (
                        <small>Rating not shown</small>
                      )}
                    </div>

                    <address>{p.address}</address>

                    <div class="business-chips">
                      <span>{categoryMeta?.label}</span>
                      {p.phone && <span>{p.phone}</span>}
                    </div>

                    <div class="business-actions">
                      <a class="business-primary" href={`/places/${p.category}/${p.slug}/`}>
                        View business
                      </a>
                      <a class="business-directions" href={p.googleMapsUrl} target="_blank" rel="noopener noreferrer">
                        Directions ↗
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <p>Currently no verified listings available for this category. New locations will be added after verification.</p>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                  `${categoryMeta?.label} in ${sectorMeta?.label} DHA Phase 6 Lahore`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Search Google Maps ↗
              </a>
            </div>
          )}

          <p class="no-results" id="no-results" hidden>No businesses match your search.</p>

          <section class="sector-callout">
            <p class="section-kicker"><span></span> {sectorMeta?.label} local guide</p>
            <h2>Explore more in {sectorMeta?.label}</h2>
            <p>Browse all sectors or return to the {sectorMeta?.label} property directory.</p>
            <div>
              <a class="gold-button" href="/sectors/">View all sectors</a>
              <a class="outline-button" href={`/sectors/${sectorMeta?.key}/`}>
                View {sectorMeta?.label} property directory
              </a>
            </div>
          </section>

          {nearbySectors.length > 0 && (
            <section class="link-section">
              <h2>Also search nearby sectors</h2>
              <div>
                {nearbySectors.map((sector) => (
                  <a href={`/places/${sector.key}/${categoryMeta?.key}/`}>{sector.label}</a>
                ))}
              </div>
            </section>
          )}

          {relatedCategories.length > 0 && (
            <section class="link-section">
              <h2>Related places and services</h2>
              <div>
                {relatedCategories.map((category) => (
                  <a href={`/places/${sectorMeta?.key}/${category.key}/`}>{category.label}</a>
                ))}
              </div>
            </section>
          )}
        </div>
      </section>

      <aside class="publication">
        <div class="container">
          Published {formattedDate} <span>Business information sourced from public Google Maps cards; verify details before visiting.</span>
        </div>
      </aside>

      <script>
        const search = document.querySelector<HTMLInputElement>('#business-search');
        const sort = document.querySelector<HTMLSelectElement>('#business-sort');
        const grid = document.querySelector<HTMLElement>('#business-grid');
        const count = document.querySelector<HTMLElement>('#result-count');
        const empty = document.querySelector<HTMLElement>('#no-results');
        const cards = Array.from(document.querySelectorAll<HTMLElement>('.business-card'));
        const updateDirectory = () => {
          const query = search?.value.trim().toLowerCase() || '';
          const visible = cards.filter((card) => `${card.dataset.name} ${card.dataset.address}`.includes(query));
          cards.forEach((card) => {
            card.hidden = !visible.includes(card);
          });
          visible.sort((a, b) => {
            if (sort?.value === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
            const key = sort?.value === 'rating' ? 'rating' : 'reviews';
            return Number(b.dataset[key]) - Number(a.dataset[key]);
          });
          visible.forEach((card) => grid?.append(card));
          if (count) count.textContent = String(visible.length);
          if (empty) empty.hidden = visible.length > 0;
        };
        search?.addEventListener('input', updateDirectory);
        sort?.addEventListener('change', updateDirectory);
      </script>
    </div>
  )}
</PageLayout>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
   * LOCAL DIRECTORY STYLES (Exact 1:1 Implementation from Screenshot)
   * ══════════════════════════════════════════════════════════════════════════ */
  :root {
    --dir-bg: #080818;
    --dir-surface: #111125;
    --dir-surface-2: #15152d;
    --dir-gold: #d4a844;
    --dir-gold-light: #f0c95c;
    --dir-text: #f0f0f5;
    --dir-muted: #9292ad;
    --dir-dim: #64647f;
    --dir-line: rgba(255, 255, 255, 0.09);
  }

  .page-hero {
    padding: 72px 0 56px;
    background: #101024;
    border-bottom: 1px solid var(--dir-line);
    text-align: center;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.48rem;
    margin-bottom: 1.25rem;
    color: var(--dir-dim);
    font-size: 0.72rem;
  }
  .breadcrumb a {
    color: var(--dir-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .breadcrumb a:hover {
    color: var(--dir-gold-light);
  }
  .page-hero h1 {
    max-width: 900px;
    margin: 0 auto;
    color: #ffffff;
    font-size: clamp(2rem, 4.7vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .page-hero p {
    max-width: 620px;
    margin: 1rem auto 0;
    color: var(--dir-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .directory-section {
    padding: 64px 0 88px;
    background: var(--dir-bg);
  }
  .directory-toolbar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }
  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    color: var(--dir-gold);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .section-kicker > span {
    width: 28px;
    height: 2px;
    background: var(--dir-gold);
  }
  .directory-toolbar h2,
  .sector-callout h2,
  .link-section h2 {
    margin: 0;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .directory-toolbar > div > p:last-child {
    margin: 0.35rem 0 0;
    color: var(--dir-muted);
    font-size: 0.78rem;
  }
  .directory-controls {
    display: grid;
    grid-template-columns: 230px 145px;
    gap: 0.7rem;
  }
  .directory-controls label {
    color: var(--dir-dim);
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .directory-controls input,
  .directory-controls select {
    display: block;
    width: 100%;
    height: 42px;
    margin-top: 0.35rem;
    padding: 0 0.75rem;
    border: 1px solid var(--dir-line);
    border-radius: 6px;
    background: var(--dir-surface);
    color: var(--dir-text);
    font: inherit;
    font-size: 0.72rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .directory-controls input:focus,
  .directory-controls select:focus {
    border-color: var(--dir-gold);
  }

  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .business-card {
    overflow: hidden;
    border: 1px solid var(--dir-line);
    border-radius: 10px;
    background: var(--dir-surface);
    box-shadow: 0 18px 45px -35px #000000;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .business-card:hover {
    border-color: rgba(212, 168, 68, 0.3);
    transform: translateY(-2px);
  }
  .business-card[hidden] {
    display: none;
  }
  .business-photo {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #1a1a31;
  }
  .business-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .business-card:hover .business-photo img {
    transform: scale(1.03);
  }
  .business-photo > span {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    padding: 0.24rem 0.42rem;
    border-radius: 4px;
    background: rgba(8, 8, 24, 0.82);
    color: #ffffff;
    font-size: 0.55rem;
  }
  .business-body {
    padding: 1rem;
  }
  .business-tags,
  .business-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .business-tags span,
  .business-chips span {
    padding: 0.22rem 0.45rem;
    border: 1px solid rgba(212, 168, 68, 0.22);
    border-radius: 999px;
    color: var(--dir-gold);
    font-size: 0.55rem;
    font-weight: 600;
  }
  .business-card h3 {
    margin: 0.62rem 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 700;
