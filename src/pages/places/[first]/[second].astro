---
/**
 * DHA Phase 6 Lahore — Places Level 3 Handler
 * Handles:
 * 1. Sector + Category Directory: /places/[sector]/[category]/ (e.g. /places/sector-a/restaurants/)
 * 2. Place Detail Page: /places/[category]/[slug]/ (e.g. /places/schools/beaconhouse-school-system-dha-phase-6-campus/)
 */
import PageLayout from '@layouts/PageLayout.astro';
import {
  SECTORS_DIRECTORY,
  PLACE_CATEGORIES,
  getAllPlaces,
  getSectorPlaces,
  getPopulatedSectorCategoryPairs,
  type PlaceRecord,
  type SectorMeta,
} from '@data/places/index';
import type { PlaceCategoryMeta } from '@data/places';
import propertiesRaw from '@data/properties-import.json';
import { SITE } from '@data/site';

export function getStaticPaths() {
  // 1. Populated Sector + Category combinations ONLY (strictly prunes empty 0-place routes)
  const populatedPairs = getPopulatedSectorCategoryPairs();
  const sectorCategoryPaths = populatedPairs.map(({ sector, category, places }) => ({
    params: { first: sector.key, second: category.key },
    props: {
      type: 'sector-category' as const,
      sectorMeta: sector,
      categoryMeta: category,
      places,
      place: null,
    },
  }));

  // 2. Individual Place Detail Pages (109+ routes)
  const allPlaces = getAllPlaces();
  const placeDetailPaths = allPlaces.map((place) => ({
    params: { first: place.category, second: place.slug },
    props: {
      type: 'place-detail' as const,
      sectorMeta: SECTORS_DIRECTORY.find((s) => s.key === place.sector) || null,
      categoryMeta: PLACE_CATEGORIES.find((c) => c.key === place.category) || null,
      places: [],
      place: place,
    },
  }));

  return [...sectorCategoryPaths, ...placeDetailPaths];
}

interface Props {
  type: 'sector-category' | 'place-detail';
  sectorMeta: SectorMeta | null;
  categoryMeta: PlaceCategoryMeta | null;
  places: PlaceRecord[];
  place: PlaceRecord | null;
}

const { type, sectorMeta, categoryMeta, places, place } = Astro.props;

// Helper variables depending on type
const isDetail = type === 'place-detail' && place !== null;

// Page Title (matching Task 6 specific example: "Restaurants in DHA Phase 6 Lahore Sector A")
const pageTitle = isDetail
  ? `${place.name} | ${place.categoryLabel} in ${place.sectorLabel}, DHA Phase 6 Lahore`
  : `${categoryMeta?.label || 'Places'} in DHA Phase 6 Lahore ${sectorMeta?.label || ''}`;

const metaDesc = isDetail
  ? `${place.name} located at ${place.address}. Verified rating: ${place.rating ? `${place.rating}★ (${place.reviewCount} reviews)` : 'Verified'}. Contact, operating status, and direct Google Maps directions.`
  : `Find verified ${categoryMeta?.label || 'places'} in ${sectorMeta?.label || 'DHA Phase 6'}, Lahore. Check addresses, Google ratings, reviews, contact details, and nearby property snapshots.`;

const canonical = isDetail
  ? `${SITE.url}/places/${place.category}/${place.slug}/`
  : `${SITE.url}/places/${sectorMeta?.key}/${categoryMeta?.key}/`;

// Matching nearby properties
const targetSectorLabel = isDetail ? place.sectorLabel : sectorMeta?.label || 'DHA Phase 6';
const nearbyProperties = propertiesRaw
  .filter((prop) => {
    return (
      prop.block?.toLowerCase().includes(targetSectorLabel.toLowerCase()) ||
      prop.location?.address?.toLowerCase().includes(targetSectorLabel.toLowerCase())
    );
  })
  .slice(0, 3);

// Related places in same sector
const siblingPlaces = isDetail
  ? getSectorPlaces(place.sector).filter((p) => p.id !== place.id).slice(0, 3)
  : [];

// Structured Data
const structuredData = isDetail
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'LocalBusiness',
          '@id': canonical,
          name: place.name,
          description: place.description,
          url: canonical,
          ...(place.phone ? { telephone: place.phone } : {}),
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
          geo: {
            '@type': 'GeoCoordinates',
            latitude: place.lat,
            longitude: place.lng,
          },
          ...(place.rating
            ? {
                aggregateRating: {
                  '@type': 'AggregateRating',
                  ratingValue: place.rating,
                  reviewCount: place.reviewCount || 1,
                },
              }
            : {}),
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
            { '@type': 'ListItem', position: 3, name: place.categoryLabel, item: `${SITE.url}/places/${place.category}/` },
            { '@type': 'ListItem', position: 4, name: place.name, item: canonical },
          ],
        },
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'CollectionPage',
          '@id': canonical,
          name: pageTitle,
          description: metaDesc,
          url: canonical,
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
            { '@type': 'ListItem', position: 3, name: sectorMeta?.label || 'Sector', item: `${SITE.url}/places/${sectorMeta?.key}/` },
            { '@type': 'ListItem', position: 4, name: categoryMeta?.label || 'Category', item: canonical },
          ],
        },
        {
          '@type': 'ItemList',
          name: pageTitle,
          numberOfItems: places.length,
          itemListElement: places.map((p, idx) => ({
            '@type': 'ListItem',
            position: idx + 1,
            item: {
              '@type': 'LocalBusiness',
              name: p.name,
              address: {
                '@type': 'PostalAddress',
                streetAddress: p.address,
                addressLocality: 'Lahore',
                addressRegion: 'Punjab',
                postalCode: '54792',
                addressCountry: 'PK',
              },
              url: `${SITE.url}/places/${p.category}/${p.slug}/`,
            },
          })),
        },
      ],
    };
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  {isDetail ? (
    /* ================================================================ */
    /* SINGLE PLACE DETAIL PAGE                                         */
    /* ================================================================ */
    <div class="place-detail-wrapper">
      <!-- Breadcrumbs & Hero -->
      <section class="place-detail-hero">
        <div class="container">
          <nav class="detail-breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="sep">/</span>
            <a href="/places/">Places</a>
            <span class="sep">/</span>
            <a href={`/places/${place.sector}/`}>{place.sectorLabel}</a>
            <span class="sep">/</span>
            <a href={`/places/${place.category}/`}>{place.categoryLabel}</a>
            <span class="sep">/</span>
            <span class="current">{place.name}</span>
          </nav>

          <div class="detail-hero-inner">
            <div class="detail-hero-left">
              <div class="detail-badges-row">
                <a href={`/places/${place.sector}/`} class="badge-sector">
                  📍 {place.sectorLabel}
                </a>
                <a href={`/places/${place.category}/`} class="badge-category">
                  {place.categoryLabel}
                </a>
                <span class="badge-status">
                  {place.status}
                </span>
              </div>

              <h1 class="detail-place-title">
                {place.name}
              </h1>
              <p class="detail-place-address">
                <span class="addr-icon">📍</span>
                <span>{place.address}</span>
              </p>
            </div>

            <!-- Rating & Action Buttons -->
            <div class="detail-hero-right">
              {place.rating && (
                <div class="detail-rating-card">
                  <div class="rating-score">
                    <span class="star">★</span>
                    <span>{place.rating.toFixed(1)}</span>
                  </div>
                  <div class="rating-count">{place.reviewCount} Google Reviews</div>
                </div>
              )}
              <a
                href={place.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-maps-directions"
              >
                <span>Google Maps Directions</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Main Detail Content -->
      <div class="container detail-content-grid">
        <!-- Left Column: Details & Overview -->
        <div class="detail-main-col">
          <!-- Overview Card -->
          <div class="detail-card">
            <h2 class="card-heading">About {place.name}</h2>
            <p class="card-paragraph">
              {place.description}
            </p>

            {place.features && place.features.length > 0 && (
              <div class="amenities-block">
                <h3 class="amenities-title">Key Highlights &amp; Amenities</h3>
                <div class="amenities-grid">
                  {place.features.map((f) => (
                    <div class="amenity-chip">
                      <span class="check-icon">✓</span>
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Location & Coordinates Card -->
          <div class="detail-card">
            <h2 class="card-heading">Location &amp; Navigation Details</h2>
            <div class="location-facts-grid">
              <div class="loc-fact-box">
                <div class="fact-label">Sector &amp; Area</div>
                <div class="fact-val">{place.sectorLabel}, DHA Phase 6 Lahore</div>
              </div>
              <div class="loc-fact-box">
                <div class="fact-label">Exact GPS Coordinates</div>
                <div class="fact-val font-mono">{place.lat.toFixed(4)}° N, {place.lng.toFixed(4)}° E</div>
              </div>
            </div>

            <div class="taxi-nav-banner">
              <div>
                <div class="banner-label">Address for Taxi &amp; Courier Navigation:</div>
                <div class="banner-addr">{place.address}</div>
              </div>
              <a
                href={place.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-open-app"
              >
                Open in Maps App
              </a>
            </div>
          </div>

          <!-- Properties Near This Place -->
          {nearbyProperties.length > 0 && (
            <div class="detail-card">
              <div class="prop-card-header">
                <div>
                  <h2 class="card-heading">Properties Near {place.name}</h2>
                  <p class="card-subtext">
                    Live market asking-price snapshots in {place.sectorLabel} DHA Phase 6.
                  </p>
                </div>
                <a href="/properties/" class="link-all-props">
                  All Properties →
                </a>
              </div>

              <div class="prop-snapshots-list">
                {nearbyProperties.map((prop) => (
                  <div class="prop-snapshot-item">
                    <div>
                      <span class="prop-type-tag">{prop.propertyType}</span>
                      <h4 class="prop-item-title">
                        <a href={`/properties/${prop.slug}/`}>
                          {prop.title}
                        </a>
                      </h4>
                      <p class="prop-item-loc">{prop.location?.address || prop.block}</p>
                    </div>
                    <div class="prop-item-right">
                      <div class="prop-item-price">PKR {(prop.price / 10000000).toFixed(2)} Cr</div>
                      <a href={`/properties/${prop.slug}/`} class="prop-item-btn">
                        View Details →
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Right Column: Sidebar Facts & Sibling Facilities -->
        <aside class="detail-sidebar-col">
          <!-- Facility Summary Card -->
          <div class="sidebar-card">
            <h3 class="sidebar-heading">Facility Information</h3>
            <ul class="facility-info-list">
              <li>
                <span class="info-label">Category:</span>
                <a href={`/places/${place.category}/`} class="info-link">
                  {place.categoryLabel}
                </a>
              </li>
              <li>
                <span class="info-label">Sector:</span>
                <a href={`/places/${place.sector}/`} class="info-link">
                  {place.sectorLabel}
                </a>
              </li>
              <li>
                <span class="info-label">Timings:</span>
                <span class="info-status">{place.status}</span>
              </li>
              {place.phone && (
                <li>
                  <span class="info-label">Contact:</span>
                  <a href={`tel:${place.phone}`} class="info-phone">
                    {place.phone}
                  </a>
                </li>
              )}
              <li>
                <span class="info-label">City / Phase:</span>
                <span class="info-val">DHA Phase 6, Lahore</span>
              </li>
              <li>
                <span class="info-label">Postal Code:</span>
                <span class="info-val">54792</span>
              </li>
            </ul>

            <div class="sidebar-cta-wrap">
              <a
                href={place.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-sidebar-nav"
              >
                <span>Navigate via Google Maps</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <!-- Other Facilities in same sector -->
          {siblingPlaces.length > 0 && (
            <div class="sidebar-card">
              <h3 class="sidebar-heading">Other Places in {place.sectorLabel}</h3>
              <div class="sibling-places-list">
                {siblingPlaces.map((s) => (
                  <a
                    href={`/places/${s.category}/${s.slug}/`}
                    class="sibling-place-item"
                  >
                    <div class="sib-cat">{s.categoryLabel}</div>
                    <div class="sib-name">{s.name}</div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  ) : (
    /* ================================================================ */
    /* SECTOR + CATEGORY DIRECTORY PAGE                                 */
    /* (e.g. /places/sector-a/restaurants/)                             */
    /* ================================================================ */
    <div class="sector-cat-wrapper">
      <!-- Hero -->
      <header class="place-directory-hero">
        <div class="container">
          <nav class="directory-breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="sep">/</span>
            <a href="/places/">Places</a>
            <span class="sep">/</span>
            <a href={`/places/${sectorMeta?.key}/`}>
              {sectorMeta?.label}
            </a>
            <span class="sep">/</span>
            <span class="current">{categoryMeta?.label}</span>
          </nav>

          <div class="hero-content">
            <div class="cat-badges-top">
              <span class="hero-kicker">
                {sectorMeta?.label} Directory
              </span>
              <span class="hero-pill-category">
                {categoryMeta?.label}
              </span>
            </div>

            <h1 class="hero-title">
              {categoryMeta?.label} in <span class="gold-gradient">{sectorMeta?.label}</span>, DHA Phase 6 Lahore
            </h1>

            <p class="hero-subtitle">
              Verified guide to {categoryMeta?.label?.toLowerCase()} in {sectorMeta?.label}, DHA Phase 6 Lahore.
              Check exact locations, Google star ratings, direct directions, and properties nearby.
            </p>

            <div class="cat-stats-row">
              <span class="cat-stat-badge">
                <strong class="gold-text">{places.length}</strong> {categoryMeta?.label} Found
              </span>
              <span class="cat-stat-badge">
                📍 {sectorMeta?.label} Anchor: {sectorMeta?.lat.toFixed(4)}° N, {sectorMeta?.lng.toFixed(4)}° E
              </span>
            </div>
          </div>
        </div>
      </header>

      <!-- Grid Content -->
      <section class="places-main-section">
        <div class="container">
          {places.length > 0 ? (
            <div class="places-cards-grid">
              {places.map((p) => (
                <article class="place-card">
                  <div class="card-content">
                    <div class="card-meta-top">
                      <span class="category-tag">
                        {p.categoryLabel}
                      </span>
                      {p.rating && (
                        <div class="rating-badge">
                          <span class="star">★</span>
                          <span class="score">{p.rating.toFixed(1)}</span>
                          {p.reviewCount > 0 && <span class="reviews">({p.reviewCount})</span>}
                        </div>
                      )}
                    </div>

                    <h3 class="place-name">
                      <a href={`/places/${p.category}/${p.slug}/`}>
                        {p.name}
                      </a>
                    </h3>

                    <p class="place-address">
                      <span class="addr-icon">📍</span>
                      <span>{p.address}</span>
                    </p>

                    <p class="place-desc">
                      {p.description}
                    </p>

                    <div class="gps-text">
                      GPS: {p.lat.toFixed(4)}° N, {p.lng.toFixed(4)}° E
                    </div>
                  </div>

                  <div class="card-footer">
                    <span class="status-indicator">{p.status}</span>
                    <div class="card-actions">
                      <a
                        href={p.googleMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-action-map"
                      >
                        Map ↗
                      </a>
                      <a
                        href={`/places/${p.category}/${p.slug}/`}
                        class="btn-action-details"
                      >
                        Details
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-state-box">
              <div class="empty-icon">📍</div>
              <p class="empty-text">
                Currently no verified listings available for this category. New locations will be added after verification.
              </p>
              <div class="empty-actions">
                <a
                  href={`/places/${categoryMeta?.key}/`}
                  class="btn-action-details"
                >
                  View {categoryMeta?.label} across Phase 6
                </a>
                <a
                  href={`/places/${sectorMeta?.key}/`}
                  class="btn-action-map"
                >
                  All Places in {sectorMeta?.label}
                </a>
              </div>
            </div>
          )}

          <!-- Properties Near This Category Section -->
          {nearbyProperties.length > 0 && (
            <div class="properties-cross-section">
              <div class="cross-section-header">
                <div>
                  <h3 class="cross-title">
                    Properties Near {categoryMeta?.label} in {sectorMeta?.label}
                  </h3>
                  <p class="cross-desc">
                    Available residential and commercial property listings in {sectorMeta?.label}.
                  </p>
                </div>
                <a href="/properties/" class="cross-link-all">
                  Explore all Phase 6 plots →
                </a>
              </div>

              <div class="properties-mini-grid">
                {nearbyProperties.map((prop) => (
                  <div class="property-mini-card">
                    <span class="prop-type-badge">{prop.propertyType}</span>
                    <h4 class="prop-title">
                      <a href={`/properties/${prop.slug}/`}>
                        {prop.title}
                      </a>
                    </h4>
                    <div class="prop-location">{prop.location?.address || prop.block}</div>
                    <div class="prop-bottom">
                      <span class="prop-price">PKR {(prop.price / 10000000).toFixed(2)} Cr</span>
                      <a href={`/properties/${prop.slug}/`} class="prop-link">
                        View Plot →
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    </div>
  )}
</PageLayout>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
   * PLACE DETAIL & SECTOR-CATEGORY DIRECTORY STYLES (Vanilla CSS)
   * ══════════════════════════════════════════════════════════════════════════ */
  .place-detail-wrapper,
  .sector-cat-wrapper {
    background: #0a0a1a;
    color: #f0f0f5;
    min-height: 80vh;
  }

  /* DETAIL HERO */
  .place-detail-hero {
    position: relative;
    padding: 48px 0 36px;
    background: linear-gradient(180deg, #111128 0%, #0a0a1a 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .detail-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #9a9ab5;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .detail-breadcrumbs a {
    color: #9a9ab5;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .detail-breadcrumbs a:hover {
    color: #f0c95c;
  }
  .detail-breadcrumbs .sep {
    color: #6a6a85;
  }
  .detail-breadcrumbs .current {
    color: #d4a844;
    font-weight: 600;
  }

  .detail-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .detail-hero-left {
    max-width: 720px;
  }
  .detail-badges-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .badge-sector {
    padding: 4px 12px;
    background: #161635;
    color: #f0f0f5;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .badge-sector:hover {
    background: rgba(212, 168, 68, 0.15);
    border-color: rgba(212, 168, 68, 0.4);
    color: #f0c95c;
  }
  .badge-category {
    padding: 4px 12px;
    background: rgba(212, 168, 68, 0.12);
    color: #d4a844;
    border: 1px solid rgba(212, 168, 68, 0.25);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }
  .badge-status {
    padding: 4px 12px;
    background: rgba(46, 204, 113, 0.12);
    color: #2ecc71;
    border: 1px solid rgba(46, 204, 113, 0.25);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .detail-place-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .detail-place-address {
    font-size: 0.95rem;
    color: #9a9ab5;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .detail-hero-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .detail-rating-card {
    background: #161635;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px 18px;
    text-align: center;
  }
  .rating-score {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 1.4rem;
    font-weight: 800;
    color: #f0c95c;
  }
  .rating-count {
    font-size: 0.72rem;
    color: #9a9ab5;
    margin-top: 2px;
  }
  .btn-maps-directions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    background: linear-gradient(135deg, #d4a844, #f0c95c);
    color: #0a0a1a;
    font-size: 0.92rem;
    font-weight: 800;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(212, 168, 68, 0.25);
    transition: all 0.25s ease;
  }
  .btn-maps-directions:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(212, 168, 68, 0.4);
  }

  /* DETAIL CONTENT 2-COLUMN GRID */
