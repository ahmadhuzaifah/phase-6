            <div class="empty-state">
              <p>Currently no verified listings available for this category. New locations will be added after verification.</p>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                  `${categoryMeta?.label} in ${sectorMeta?.label} DHA Phase 6 Lahore`
