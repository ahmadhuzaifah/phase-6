---
/**
 * DHA Phase 6 Lahore — Places Sector & Category Directory Handler
 * Supports:
 * - /places/[sector]/ (e.g. /places/sector-a/, /places/cca/)
 * - /places/[category]/ (e.g. /places/restaurants/, /places/schools/)
 */
import PageLayout from '@layouts/PageLayout.astro';
import PlaceImage from '@components/places/PlaceImage.astro';
import propertiesRaw from '@data/properties-import.json';
import {
  SECTORS_DIRECTORY,
  PLACE_CATEGORIES,
  getSectorPlaces,
  getCategoryPlaces,
  getPopulatedCategories,
  getSectorCategoryPlaces,
  getCategorySectors,
  getPlaceImage,
  type PlaceRecord,
  type SectorMeta,
} from '@data/places/index';
import type { PlaceCategoryMeta } from '@data/places';
import { SITE } from '@data/site';

export function getStaticPaths() {
  const sectorPaths = SECTORS_DIRECTORY.map((sector) => ({
    params: { first: sector.key },
    props: {
      type: 'sector' as const,
      sectorMeta: sector,
      categoryMeta: null,
      places: getSectorPlaces(sector.key),
    },
  }));

  // Only generate category pages for categories that have at least 1 verified place (Task 1 & 7)
  const populatedCategories = getPopulatedCategories();
  const categoryPaths = populatedCategories.map((category) => ({
    params: { first: category.key },
    props: {
      type: 'category' as const,
      sectorMeta: null,
      categoryMeta: category,
      places: getCategoryPlaces(category.key),
    },
  }));

  // Plural aliases (prevents 404 on common plural routes like /places/mosques/, /places/parks/, etc.)
  const ALIASES: Record<string, string> = {
    mosques: 'mosque',
    parks: 'park',
    gyms: 'gym',
    hospitals: 'hospital',
    supermarket: 'supermarkets',
    school: 'schools',
    bank: 'banks',
    cafe: 'cafes',
    restaurant: 'restaurants',
  };

  const aliasPaths = Object.entries(ALIASES).map(([aliasKey, canonicalKey]) => {
    const category = PLACE_CATEGORIES.find((c) => c.key === canonicalKey);
    return {
      params: { first: aliasKey },
      props: {
        type: 'category' as const,
        sectorMeta: null,
        categoryMeta: category || null,
        places: category ? getCategoryPlaces(canonicalKey) : [],
      },
    };
  }).filter((p) => p.props.categoryMeta !== null);

  return [...sectorPaths, ...categoryPaths, ...aliasPaths];
}

interface Props {
  type: 'sector' | 'category';
  sectorMeta: SectorMeta | null;
  categoryMeta: PlaceCategoryMeta | null;
  places: PlaceRecord[];
}

const { type, sectorMeta, categoryMeta, places } = Astro.props as Props;

// Page titles and meta descriptions
const pageTitle =
  type === 'sector' && sectorMeta
    ? `${sectorMeta.label} Places, Facilities & Amenities | DHA Phase 6 Lahore`
    : categoryMeta
      ? `Best ${categoryMeta.label} in DHA Phase 6 Lahore | Top Rated Directory`
      : 'Places & Facilities in DHA Phase 6 Lahore';

const metaDesc =
  type === 'sector' && sectorMeta
    ? `Explore verified schools, clinics, restaurants, mosques, banks, and recreation in ${sectorMeta.label}, DHA Phase 6 Lahore with exact addresses, ratings, and maps.`
    : categoryMeta
      ? `Discover the best verified ${categoryMeta.label.toLowerCase()} in DHA Phase 6 Lahore with verified locations, customer ratings, reviews, contact details, and Google Maps navigation.`
      : 'Comprehensive directory of verified local businesses, amenities, and essential services across DHA Phase 6 Lahore.';

const canonical = `${SITE.url}/places/${type === 'sector' ? sectorMeta?.key : categoryMeta?.key}/`;

// Category Intros
const categoryIntros: Record<string, string> = {
  restaurants:
    "DHA Phase 6 Lahore has developed into one of the city's premier dining corridors, centered around CCA, Raya Commercial Fairways, and Main Boulevard. From upscale fine dining and artisanal steakhouses to family bistros, fast-casual eateries, and late-night cafes, residents enjoy unparalleled culinary variety right within the community.",
  cafes:
    "Coffee culture and social workspaces thrive across DHA Phase 6 Lahore. Featuring high-end espresso bars, bakery bistros, and outdoor patios in Defence Raya Commercial and Sector CCA, the neighbourhood offers vibrant meeting spots for professionals and families alike.",
  mosque:
    "Spiritual life in DHA Phase 6 Lahore is anchored by architecturally distinguished Jamia mosques thoughtfully located within each sector. Equipped with climate-controlled prayer halls, landscaped courtyards, dedicated ladies' prayer galleries, and spacious wudhu facilities, every sector provides accessible worship within minutes of home.",
  school:
    "Education in DHA Phase 6 Lahore is characterized by world-class academic institutions, international preschools, and top-tier grammar schools. Families benefit from premier schools situated within secure, wide-avenue residential blocks and dedicated institutional zones.",
  hospital:
    "Healthcare infrastructure in DHA Phase 6 Lahore features modern hospitals, multi-specialty medical complexes, 24/7 urgent care clinics, and specialized diagnostics. Residents have rapid emergency access and comprehensive outpatient care without leaving Phase 6.",
  clinic:
    "Primary and specialized outpatient clinics across DHA Phase 6 Lahore provide family medicine, pediatric checkups, dental surgeries, physiotherapy, and dermatology. Situated primarily in commercial hubs like CCA, clinics offer rapid, reliable healthcare.",
  bank:
    "Financial services in DHA Phase 6 Lahore are comprehensive, with major commercial and Islamic banks operating flagship branches and 24/7 digital ATM lobbies across Commercial Broadway, CCA 1, CCA 2, and Main Boulevard.",
  supermarket:
    "Everyday convenience and luxury grocery shopping in DHA Phase 6 Lahore are supported by expansive department stores, high-end marts, and round-the-clock express stores across CCA, Raya, and residential sectors.",
  park:
    "Green living and recreation are central to DHA Phase 6's master planning. Featuring lush family parks, jogging tracks, children's play zones, and manicured green belts in every residential sector from Sector A to Sector N.",
  bakery:
    "Freshly baked artisan breads, customized gourmet cakes, traditional sweets, and patisserie delights are well catered for across DHA Phase 6's commercial sectors.",
  pharmacy:
    "Around-the-clock pharmacies and healthcare dispensaries operate throughout DHA Phase 6 Lahore, ensuring immediate access to prescription medicines, infant care, and medical supplies.",
  gym:
    "Phase 6 boasts state-of-the-art fitness centers, boutique CrossFit studios, women-only workout clubs, and wellness spas.",
  shopping:
    "Retail destinations in DHA Phase 6 Lahore range from luxury brand outlets in Defence Raya to multi-story retail plazas in CCA and Commercial Broadway.",
};

const categoryIntro = categoryMeta
  ? categoryIntros[categoryMeta.key] ||
    `Explore verified ${categoryMeta.label.toLowerCase()} across DHA Phase 6 Lahore with verified locations, contact numbers, direct Google Maps navigation, and community ratings.`
  : '';

// Popular / Top Places Showcase (Task 4)
const topPlaces = places
  .slice()
  .sort((a, b) => {
    const rA = a.rating || 0;
    const rB = b.rating || 0;
    if (rB !== rA) return rB - rA;
    return (b.reviewCount || 0) - (a.reviewCount || 0);
  })
  .slice(0, 4);

// Sector-wise Breakdown (Task 4)
const sectorDistribution =
  type === 'category'
    ? SECTORS_DIRECTORY.map((sec) => {
        const secPlaces = places.filter((p) => p.sector === sec.key);
        return {
          sector: sec,
          count: secPlaces.length,
        };
      })
        .filter((item) => item.count > 0)
        .sort((a, b) => b.count - a.count)
    : [];

// Category FAQs (Task 4)
const categoryFaqsMap: Record<string, Array<{ q: string; a: string }>> = {
  restaurants: [
    {
      q: 'Where are the best restaurants located in DHA Phase 6 Lahore?',
      a: 'The primary dining clusters in DHA Phase 6 are Defence Raya Fairways Commercial, CCA 1, CCA 2, and the Main Boulevard Commercial strip, featuring both local Pakistani cuisine and international culinary brands.',
    },
    {
      q: 'Are family-friendly restaurants with outdoor seating available in DHA Phase 6?',
      a: 'Yes, venues like Defence Raya Golf Resort restaurants, Broadway eateries, and cafes across CCA feature open-air patios, family dining halls, and dedicated valet parking.',
    },
    {
      q: 'What dining hours are typical in DHA Phase 6?',
      a: 'Most restaurants open for lunch around 12:00 PM and operate until 1:00 AM on weekdays, extending up to 2:00 AM on weekends, with fast-casual spots offering late-night delivery.',
    },
  ],
  mosque: [
    {
      q: 'Are there Jamia mosques in every sector of DHA Phase 6?',
      a: "Yes, DHA Lahore's master plan includes dedicated Sector Jamia Mosques in Sectors A through N, ensuring prayer facilities are within walking distance for all residents.",
    },
    {
      q: "Do mosques in DHA Phase 6 have parking and ladies' prayer sections?",
      a: "Most central sector Jamia mosques (such as Jamia Mosque Sector C, E, and K) offer expansive paved parking lots and dedicated, air-conditioned female prayer halls.",
    },
  ],
  school: [
    {
      q: 'What top schools operate in or near DHA Phase 6 Lahore?',
      a: 'DHA Phase 6 hosts premier institutions including Beaconhouse, The City School, Roots Millennium, and DHA Junior School, alongside specialized early learning academies.',
    },
    {
      q: 'Are preschools and daycares available in residential sectors of Phase 6?',
      a: 'Yes, Montessori and early learning centers are situated in sectors like Sector A, C, and D, providing secure drop-off zones and accredited curricula.',
    },
  ],
  hospital: [
    {
      q: 'What emergency medical facilities and hospitals serve DHA Phase 6?',
      a: 'DHA Phase 6 is served by major medical facilities such as PKLI (Pakistan Kidney and Liver Institute) on Park Road, nearby National Hospital, and multi-specialty emergency clinics in CCA.',
    },
    {
      q: 'Are 24-hour pharmacies available near hospitals and clinics in Phase 6?',
      a: "Yes, Servaid, Fazal Din's, and Clinix operate 24/7 pharmacies in CCA 1, CCA 2, and along Main Boulevard.",
    },
  ],
  bank: [
    {
      q: 'Which commercial banks have branches in DHA Phase 6 Lahore?',
      a: 'Leading banks—including Meezan Bank, HBL, MCB, Allied Bank, Bank Alfalah, and Faysal Bank—maintain full-service branches with cash deposit machines and ATM lobbies in Phase 6 CCA and Main Boulevard.',
    },
  ],
  supermarket: [
    {
      q: 'Where can residents do grocery and daily shopping in DHA Phase 6?',
      a: 'Major supermarkets such as Jalal Sons, Al-Fatah, Euro Store, and Greenvalley Express are located in CCA and Raya Commercial, alongside local mini-marts in each residential sector.',
    },
  ],
  park: [
    {
      q: 'Are the parks in DHA Phase 6 secure and family-friendly?',
      a: "Yes, all sector parks in DHA Phase 6 are maintained by DHA's horticulture and security departments, featuring perimeter fencing, walking/jogging tracks, children's swings, and illuminated pathways.",
    },
  ],
};

const categoryFaqs = categoryMeta
  ? categoryFaqsMap[categoryMeta.key] || [
      {
        q: `How many verified ${categoryMeta.label} exist in DHA Phase 6 Lahore?`,
        a: `Currently, our directory tracks ${places.length} verified ${categoryMeta.label.toLowerCase()} across DHA Phase 6, complete with addresses, ratings, and Google Maps links.`,
      },
      {
        q: `Which sectors have the highest concentration of ${categoryMeta.label.toLowerCase()}?`,
        a: `Most commercial and lifestyle amenities are concentrated in CCA 1, CCA 2, Defence Raya, and along Main Boulevard, with essential facilities distributed across residential sectors.`,
      },
    ]
  : [];

// Properties in Sectors with these places (Task 4)
interface PropertyItem {
  id: string;
  slug: string;
  title: string;
  price?: number;
  propertyType: string;
  size?: string;
  images?: any[];
  block?: string;
  location?: { address?: string; block?: string };
}
const allProperties = (Array.isArray(propertiesRaw) ? (propertiesRaw as any[]) : []) as PropertyItem[];
const categorySectorKeys = new Set(places.map((p) => p.sector));
const categoryProps = allProperties.filter((prop) => {
  const blockLower = (prop.block || '').toLowerCase();
  return Array.from(categorySectorKeys).some((secKey) => {
    const cleanKey = secKey.replace(/^sector-/, '').toLowerCase();
    return blockLower.includes(cleanKey);
  });
});
const relatedProps = (categoryProps.length > 0 ? categoryProps : allProperties).slice(0, 4);

function formatPrice(val: number | undefined): string {
  if (!val) return 'Call for Price';
  const cr = val / 10000000;
  if (cr >= 1) return `PKR ${cr.toFixed(2)} Cr`;
  const lac = val / 100000;
  return `PKR ${lac.toFixed(1)} Lac`;
}

// JSON-LD Structured Data
const structuredData: { '@context': string; '@graph': any[] } = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description: metaDesc,
      inLanguage: 'en-PK',
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
        {
          '@type': 'ListItem',
          position: 3,
          name: type === 'sector' ? sectorMeta?.label : categoryMeta?.label,
          item: canonical,
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#directory`,
      name: pageTitle,
      numberOfItems: places.length,
      itemListElement: places.map((place, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'LocalBusiness',
          name: place.name,
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
          ...(place.rating ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: place.rating,
              reviewCount: place.reviewCount || 1,
            },
          } : {}),
          ...(place.phone ? { telephone: place.phone } : {}),
          image: getPlaceImage(place).src,
          url: `${SITE.url}/places/${place.category}/${place.slug}/`,
        },
      })),
    },
  ],
};

if (type === 'category' && categoryFaqs.length > 0) {
  structuredData['@graph'].push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: categoryFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  });
}

const publishedDate = places[0]?.retrievedAt || '2026-09-03';
const formattedDate = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' }).format(new Date(`${publishedDate}T12:00:00`));

// Sectors for "Also search nearby sectors" (only sectors with places for this category)
const nearbySectors =
  type === 'category' && categoryMeta
    ? getCategorySectors(categoryMeta.key).map((s) => s.sector)
    : SECTORS_DIRECTORY.filter((s) => s.key !== sectorMeta?.key);

// Categories for "Related places and services" (only categories that actually exist in this sector)
const relatedCategories =
  type === 'sector' && sectorMeta
    ? PLACE_CATEGORIES.filter((c) => getSectorCategoryPlaces(sectorMeta.key, c.key).length > 0)
    : getPopulatedCategories().filter((c) => c.key !== categoryMeta?.key);
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <header class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/places/">Places</a>
        <span>/</span>
        {type === 'sector' && sectorMeta ? (
          <span aria-current="page">{sectorMeta.label}</span>
        ) : (
          <span aria-current="page">{categoryMeta?.label}</span>
        )}
      </nav>

      <h1>
        {type === 'sector' && sectorMeta ? (
          `Facilities & Places in ${sectorMeta.label} DHA Phase 6 Lahore`
        ) : (
          `Best ${categoryMeta?.label} in DHA Phase 6 Lahore`
        )}
      </h1>
      <p>
        {type === 'sector' && sectorMeta
          ? `A focused local guide to businesses, amenities, and community services in ${sectorMeta.label}, DHA Phase 6 Lahore.`
          : categoryIntro}
      </p>
    </div>
  </header>

  <section class="directory-section">
    <div class="container">
      {type === 'category' && topPlaces.length > 0 && (
        <section class="category-showcase-section">
          <div class="section-kicker"><span></span> Featured & Top Rated</div>
          <h2 class="showcase-title">Popular {categoryMeta?.label} in DHA Phase 6</h2>
          <p class="showcase-desc">Highly rated by residents and visitors for service excellence, reliability, and community standing.</p>
          <div class="top-showcase-grid">
            {topPlaces.map((tp, idx) => (
              <a href={`/places/${tp.category}/${tp.slug}/`} class="top-showcase-card">
                <div class="top-rank-badge">#{idx + 1} Rated</div>
                <div class="top-showcase-img">
                  <PlaceImage place={tp} />
                </div>
                <div class="top-showcase-content">
                  <span class="top-sector-pill">{tp.sectorLabel}</span>
                  <h3>{tp.name}</h3>
                  <div class="top-rating-row">
                    <span class="star">★</span>
                    <strong>{tp.rating ? tp.rating.toFixed(1) : '5.0'}</strong>
                    <small>({tp.reviewCount > 0 ? `${tp.reviewCount.toLocaleString('en-PK')} reviews` : 'Verified'})</small>
                  </div>
                  <address>{tp.address}</address>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {type === 'category' && sectorDistribution.length > 0 && (
        <section class="sector-breakdown-section">
          <div class="section-kicker"><span></span> Sector-Wise Breakdown</div>
          <h2>{categoryMeta?.label} by Sector in DHA Phase 6</h2>
          <p class="sector-breakdown-desc">Explore where {categoryMeta?.label?.toLowerCase()} are concentrated across DHA Phase 6 sectors and commercial centers:</p>
          <div class="sector-dist-pills">
            {sectorDistribution.map((item) => (
              <a href={`/sectors/${item.sector.key}/${categoryMeta?.key}/`} class="sector-dist-pill">
                <span class="sector-pill-name">{item.sector.label}</span>
                <span class="sector-pill-count">{item.count} {item.count === 1 ? 'place' : 'places'}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="directory-toolbar">
        <div>
          <p class="section-kicker"><span></span> Local directory</p>
          <h2>
            {type === 'sector' && sectorMeta
              ? `Facilities in ${sectorMeta.label}`
              : `All Verified ${categoryMeta?.label}`}
          </h2>
          <p>
            <strong id="result-count">{places.length}</strong> {places.length === 1 ? 'business' : 'businesses'} in DHA Phase 6 Lahore
          </p>
        </div>

        <div class="directory-controls">
          <label>
            Search businesses
            <input id="business-search" type="search" placeholder="Search by name or address" />
          </label>
          <label>
            Sort results
            <select id="business-sort">
              <option value="reviews">Most reviewed</option>
              <option value="rating">Highest rated</option>
              <option value="name">Name A-Z</option>
            </select>
          </label>
        </div>
      </div>

      {places.length > 0 ? (
        <div class="business-grid" id="business-grid">
          {places.map((place) => (
            <article
              class="business-card"
              data-name={place.name.toLowerCase()}
              data-address={place.address.toLowerCase()}
              data-rating={place.rating || 0}
              data-reviews={place.reviewCount}
            >
              <a class="business-photo" href={`/places/${place.category}/${place.slug}/`}>
                <PlaceImage place={place} />
              </a>

              <div class="business-body">
                <div class="business-tags">
                  <span>{place.categoryLabel}</span>
                  <span>{place.sectorLabel}</span>
                </div>

                <h3>
                  <a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a>
                </h3>

                <div class="business-rating">
                  {place.rating ? (
                    <>
                      <span aria-label={`${place.rating} out of 5 stars`}>★</span>
                      <strong>{place.rating.toFixed(1)}</strong>
                      <small>{place.reviewCount > 0 ? `${place.reviewCount.toLocaleString('en-PK')} reviews` : 'Google rating'}</small>
                    </>
                  ) : (
                    <small>Rating not shown</small>
                  )}
                </div>

                <address>{place.address}</address>

                <div class="business-chips">
                  <span>{place.categoryLabel}</span>
                  {place.phone && <span>{place.phone}</span>}
                </div>

                <div class="business-actions">
                  {place.phone ? (
                    <a class="business-btn-phone" href={`tel:${place.phone.replace(/\s+/g, '')}`} title={`Call ${place.name}`} aria-label={`Call ${place.name}`}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                      <span>Call</span>
                    </a>
                  ) : (
                    <span class="business-btn-phone disabled" title="Phone not listed">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                      <span>No Phone</span>
                    </span>
                  )}
                  <a class="business-btn-maps" href={place.googleMapsUrl} target="_blank" rel="noopener" title={`Open ${place.name} in Google Maps`} aria-label={`Open ${place.name} in Google Maps`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                    <span>Open in Google Maps</span>
                  </a>
                  <a class="business-btn-detail" href={`/places/${place.category}/${place.slug}/`} aria-label={`View details for ${place.name}`}>
                    <span>Details</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Currently no verified listings available for this category. New locations will be added after verification.</p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
              type === 'sector' && sectorMeta
                ? `Places in ${sectorMeta.label} DHA Phase 6 Lahore`
                : `${categoryMeta?.label} in DHA Phase 6 Lahore`
            )}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Search Google Maps ↗
          </a>
        </div>
      )}

      <p class="no-results" id="no-results" hidden>No businesses match your search.</p>

      {/* Properties in Sectors with Category Places (Task 4) */}
      {type === 'category' && relatedProps.length > 0 && (
        <section class="category-properties-section">
          <div class="properties-near-header">
            <div>
              <p class="section-kicker"><span></span> Real Estate & Living</p>
              <h2>Properties Available in Sectors with {categoryMeta?.label}</h2>
              <p>Explore houses, plots, and commercial opportunities located in sectors featuring top {categoryMeta?.label?.toLowerCase()}.</p>
            </div>
            <a class="view-all-props-link" href="/properties/">Browse All DHA Properties →</a>
          </div>

          <div class="mini-props-grid">
            {relatedProps.map((prop) => (
              <article class="mini-prop-card">
                <a class="mini-prop-img-link" href={`/properties/${prop.slug}/`}>
                  <img
                    src={prop.images && prop.images[0] ? prop.images[0] : '/images/placeholders/commercial.webp'}
                    alt={prop.title}
                    loading="lazy"
                  />
                  <span class="mini-prop-type-badge">{prop.propertyType}</span>
                </a>
                <div class="mini-prop-body">
                  <div class="mini-prop-meta">
                    <span class="mini-prop-price">{formatPrice(prop.price)}</span>
                    <span class="mini-prop-size">{prop.size}</span>
                  </div>
                  <h3 class="mini-prop-title">
                    <a href={`/properties/${prop.slug}/`}>{prop.title}</a>
                  </h3>
                  <div class="mini-prop-loc">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
