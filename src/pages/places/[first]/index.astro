                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {/* Category FAQs (Task 4) */}
      {type === 'category' && categoryFaqs.length > 0 && (
        <section class="category-faqs-section">
          <p class="section-kicker"><span></span> Common Inquiries</p>
          <h2>Frequently Asked Questions About {categoryMeta?.label} in DHA Phase 6</h2>
          <div class="category-faqs-list">
            {categoryFaqs.map((faq) => (
              <details class="faq-item" open>
                <summary class="faq-question">
                  <span>{faq.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                <div class="faq-answer">
                  <p>{faq.a}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Sector Callout (matches screenshot) -->
      <section class="sector-callout">
        <p class="section-kicker">
          <span></span> {type === 'sector' && sectorMeta ? `${sectorMeta.label} local guide` : 'DHA Phase 6 local guide'}
        </p>
        <h2>
          {type === 'sector' && sectorMeta
            ? `Explore more in ${sectorMeta.label}`
            : 'Explore more in DHA Phase 6'}
        </h2>
        <p>
          {type === 'sector' && sectorMeta
            ? `Browse all sectors or return to the ${sectorMeta.label} property directory.`
            : 'Browse all sectors or return to the DHA Phase 6 property directory.'}
        </p>
        <div>
          <a class="gold-button" href="/sectors/">View all sectors</a>
          <a
            class="outline-button"
            href={type === 'sector' && sectorMeta ? `/sectors/${sectorMeta.key}/` : '/sectors/'}
          >
            {type === 'sector' && sectorMeta
              ? `View ${sectorMeta.label} property directory`
              : 'View Phase 6 property directory'}
          </a>
          {type === 'sector' && sectorMeta && (
            <a class="outline-button" href={`/sectors/${sectorMeta.key}/places/`}>
              {sectorMeta.label} Facilities Guide →
            </a>
          )}
        </div>
      </section>

      <!-- Also search nearby sectors (matches screenshot) -->
      {nearbySectors.length > 0 && (
        <section class="link-section">
          <h2>Also search nearby sectors</h2>
          <div>
            {nearbySectors.map((sector) => (
              <a href={type === 'category' && categoryMeta ? `/places/${sector.key}/${categoryMeta.key}/` : `/places/${sector.key}/`}>
                {sector.label}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Related places and services (matches screenshot) -->
      {relatedCategories.length > 0 && (
        <section class="link-section">
          <h2>Related places and services</h2>
          <div>
            {relatedCategories.map((category) => (
              <a href={type === 'sector' && sectorMeta ? `/places/${sectorMeta.key}/${category.key}/` : `/places/${category.key}/`}>
                {category.label}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <aside class="publication">
    <div class="container">
      Published {formattedDate} <span>Business information sourced from public Google Maps cards; verify details before visiting.</span>
    </div>
  </aside>

  <script>
    const search = document.querySelector<HTMLInputElement>('#business-search');
    const sort = document.querySelector<HTMLSelectElement>('#business-sort');
    const grid = document.querySelector<HTMLElement>('#business-grid');
    const count = document.querySelector<HTMLElement>('#result-count');
    const empty = document.querySelector<HTMLElement>('#no-results');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.business-card'));
    const updateDirectory = () => {
      const query = search?.value.trim().toLowerCase() || '';
      const visible = cards.filter((card) => `${card.dataset.name} ${card.dataset.address}`.includes(query));
      cards.forEach((card) => {
        card.hidden = !visible.includes(card);
      });
      visible.sort((a, b) => {
        if (sort?.value === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        const key = sort?.value === 'rating' ? 'rating' : 'reviews';
        return Number(b.dataset[key]) - Number(a.dataset[key]);
      });
      visible.forEach((card) => grid?.append(card));
      if (count) count.textContent = String(visible.length);
      if (empty) empty.hidden = visible.length > 0;
    };
    search?.addEventListener('input', updateDirectory);
    sort?.addEventListener('change', updateDirectory);
  </script>
</PageLayout>

