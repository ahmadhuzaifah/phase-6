---
/**
 * DHA Phase 6 Lahore — Places Sector & Category Directory Handler
 * Supports:
 * - /places/[sector]/ (e.g. /places/sector-a/, /places/cca/)
 * - /places/[category]/ (e.g. /places/restaurants/, /places/schools/)
 */
import PageLayout from '@layouts/PageLayout.astro';
import {
  SECTORS_DIRECTORY,
  getPopulatedCategories,
  getSectorPlaces,
  getCategoryPlaces,
  type PlaceRecord,
  type SectorMeta,
} from '@data/places/index';
import type { PlaceCategoryMeta } from '@data/places';
import { SITE } from '@data/site';

export function getStaticPaths() {
  const sectorPaths = SECTORS_DIRECTORY.map((sector) => ({
    params: { first: sector.key },
    props: {
      type: 'sector' as const,
      sectorMeta: sector,
      categoryMeta: null,
      places: getSectorPlaces(sector.key),
    },
  }));

  // Only generate category pages for categories that have at least 1 verified place (Task 1 & 7)
  const populatedCategories = getPopulatedCategories();
  const categoryPaths = populatedCategories.map((category) => ({
    params: { first: category.key },
    props: {
      type: 'category' as const,
      sectorMeta: null,
      categoryMeta: category,
      places: getCategoryPlaces(category.key),
    },
  }));

  return [...sectorPaths, ...categoryPaths];
}

interface Props {
  type: 'sector' | 'category';
  sectorMeta: SectorMeta | null;
  categoryMeta: PlaceCategoryMeta | null;
  places: PlaceRecord[];
}

const { type, sectorMeta, categoryMeta, places } = Astro.props;

// Page titles and meta descriptions
const pageTitle =
  type === 'sector' && sectorMeta
    ? `${sectorMeta.label} Places, Facilities & Amenities | DHA Phase 6 Lahore`
    : categoryMeta
      ? `${categoryMeta.label} in DHA Phase 6 Lahore | Verified Directory`
      : 'Places & Facilities in DHA Phase 6 Lahore';

const metaDesc =
  type === 'sector' && sectorMeta
    ? `Explore verified schools, clinics, restaurants, mosques, banks, and recreation in ${sectorMeta.label}, DHA Phase 6 Lahore with exact addresses, ratings, and maps.`
    : categoryMeta
      ? `Find verified ${categoryMeta.label} across all sectors of DHA Phase 6 Lahore with addresses, Google ratings, reviews, and direct Google Maps navigation.`
      : 'Comprehensive directory of places and amenities in DHA Phase 6 Lahore.';

const canonical = `${SITE.url}/places/${type === 'sector' ? sectorMeta?.key : categoryMeta?.key}/`;

// JSON-LD Structured Data
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description: metaDesc,
      inLanguage: 'en-PK',
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Places', item: `${SITE.url}/places/` },
        {
          '@type': 'ListItem',
          position: 3,
          name: type === 'sector' ? sectorMeta?.label : categoryMeta?.label,
          item: canonical,
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#directory`,
      name: pageTitle,
      numberOfItems: places.length,
      itemListElement: places.map((place, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'LocalBusiness',
          name: place.name,
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
          ...(place.rating ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: place.rating,
              reviewCount: place.reviewCount || 1,
            },
          } : {}),
          ...(place.phone ? { telephone: place.phone } : {}),
          url: `${SITE.url}/places/${place.category}/${place.slug}/`,
        },
      })),
    },
  ],
};
const publishedDate = places[0]?.retrievedAt || '2026-09-03';
const formattedDate = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' }).format(new Date(`${publishedDate}T12:00:00`));

// Sectors for "Also search nearby sectors"
const nearbySectors =
  type === 'sector'
    ? SECTORS_DIRECTORY.filter((s) => s.key !== sectorMeta?.key)
    : SECTORS_DIRECTORY.filter((s) => places.some((p) => p.sector === s.key));

// Categories for "Related places and services"
const relatedCategories =
  type === 'sector'
    ? getPopulatedCategories()
    : getPopulatedCategories().filter((c) => c.key !== categoryMeta?.key);
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <header class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/places/">Places</a>
        <span>/</span>
        {type === 'sector' && sectorMeta ? (
          <span aria-current="page">{sectorMeta.label}</span>
        ) : (
          <span aria-current="page">{categoryMeta?.label}</span>
        )}
      </nav>

      <h1>
        {type === 'sector' && sectorMeta ? (
          `Facilities & Places in ${sectorMeta.label} DHA Phase 6 Lahore`
        ) : (
          `${categoryMeta?.label} in DHA Phase 6 Lahore`
        )}
      </h1>
      <p>
        {type === 'sector' && sectorMeta
          ? `A focused local guide to businesses, amenities, and community services in ${sectorMeta.label}, DHA Phase 6 Lahore.`
          : `A focused local guide to ${categoryMeta?.label?.toLowerCase()} across DHA Phase 6 Lahore.`}
      </p>
    </div>
  </header>

  <section class="directory-section">
    <div class="container">
      <div class="directory-toolbar">
        <div>
          <p class="section-kicker"><span></span> Local directory</p>
          <h2>
            {type === 'sector' && sectorMeta
              ? `Facilities in ${sectorMeta.label}`
              : `${categoryMeta?.label} Directory`}
          </h2>
          <p>
            <strong id="result-count">{places.length}</strong> {places.length === 1 ? 'business' : 'businesses'} in DHA Phase 6 Lahore
          </p>
        </div>

        <div class="directory-controls">
          <label>
            Search businesses
            <input id="business-search" type="search" placeholder="Search by name or address" />
          </label>
          <label>
            Sort results
            <select id="business-sort">
              <option value="reviews">Most reviewed</option>
              <option value="rating">Highest rated</option>
              <option value="name">Name A-Z</option>
            </select>
          </label>
        </div>
      </div>

      {places.length > 0 ? (
        <div class="business-grid" id="business-grid">
          {places.map((place) => (
            <article
              class="business-card"
              data-name={place.name.toLowerCase()}
              data-address={place.address.toLowerCase()}
              data-rating={place.rating || 0}
              data-reviews={place.reviewCount}
            >
              <a class="business-photo" href={`/places/${place.category}/${place.slug}/`}>
                <img
                  src={place.image || '/images/og/homepage-og.svg'}
                  alt={`${place.name} in ${place.sectorLabel}, DHA Phase 6 Lahore`}
                  width="720"
                  height="440"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />
                <span>Google Maps photo</span>
              </a>

              <div class="business-body">
                <div class="business-tags">
                  <span>{place.categoryLabel}</span>
                  <span>{place.sectorLabel}</span>
                </div>

                <h3>
                  <a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a>
                </h3>

                <div class="business-rating">
                  {place.rating ? (
                    <>
                      <span aria-label={`${place.rating} out of 5 stars`}>★</span>
                      <strong>{place.rating.toFixed(1)}</strong>
                      <small>{place.reviewCount > 0 ? `${place.reviewCount.toLocaleString('en-PK')} reviews` : 'Google rating'}</small>
                    </>
                  ) : (
                    <small>Rating not shown</small>
                  )}
                </div>

                <address>{place.address}</address>

                <div class="business-chips">
                  <span>{place.categoryLabel}</span>
                  {place.phone && <span>{place.phone}</span>}
                </div>

                <div class="business-actions">
                  <a class="business-primary" href={`/places/${place.category}/${place.slug}/`}>
                    View business
                  </a>
                  <a class="business-directions" href={place.googleMapsUrl} target="_blank" rel="noopener noreferrer">
                    Directions ↗
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Currently no verified listings available for this category. New locations will be added after verification.</p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
              type === 'sector' && sectorMeta
                ? `Places in ${sectorMeta.label} DHA Phase 6 Lahore`
                : `${categoryMeta?.label} in DHA Phase 6 Lahore`
            )}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Search Google Maps ↗
          </a>
        </div>
      )}

      <p class="no-results" id="no-results" hidden>No businesses match your search.</p>

      <!-- Sector Callout (matches screenshot) -->
      <section class="sector-callout">
        <p class="section-kicker">
          <span></span> {type === 'sector' && sectorMeta ? `${sectorMeta.label} local guide` : 'DHA Phase 6 local guide'}
        </p>
        <h2>
          {type === 'sector' && sectorMeta
            ? `Explore more in ${sectorMeta.label}`
            : 'Explore more in DHA Phase 6'}
        </h2>
        <p>
          {type === 'sector' && sectorMeta
            ? `Browse all sectors or return to the ${sectorMeta.label} property directory.`
            : 'Browse all sectors or return to the DHA Phase 6 property directory.'}
        </p>
        <div>
          <a class="gold-button" href="/sectors/">View all sectors</a>
          <a
            class="outline-button"
            href={type === 'sector' && sectorMeta ? `/sectors/${sectorMeta.key}/` : '/sectors/'}
          >
            {type === 'sector' && sectorMeta
              ? `View ${sectorMeta.label} property directory`
              : 'View Phase 6 property directory'}
          </a>
        </div>
      </section>

      <!-- Also search nearby sectors (matches screenshot) -->
      <section class="link-section">
        <h2>Also search nearby sectors</h2>
        <div>
          {nearbySectors.map((sector) => (
            <a href={`/places/${sector.key}/`}>{sector.label}</a>
          ))}
        </div>
      </section>

      <!-- Related places and services (matches screenshot) -->
      <section class="link-section">
        <h2>Related places and services</h2>
        <div>
          {relatedCategories.map((category) => (
            <a href={type === 'sector' && sectorMeta ? `/places/${sectorMeta.key}/${category.key}/` : `/places/${category.key}/`}>
              {category.label}
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>

  <aside class="publication">
    <div class="container">
      Published {formattedDate} <span>Business information sourced from public Google Maps cards; verify details before visiting.</span>
    </div>
  </aside>

  <script>
    const search = document.querySelector<HTMLInputElement>('#business-search');
    const sort = document.querySelector<HTMLSelectElement>('#business-sort');
    const grid = document.querySelector<HTMLElement>('#business-grid');
    const count = document.querySelector<HTMLElement>('#result-count');
    const empty = document.querySelector<HTMLElement>('#no-results');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.business-card'));
    const updateDirectory = () => {
      const query = search?.value.trim().toLowerCase() || '';
      const visible = cards.filter((card) => `${card.dataset.name} ${card.dataset.address}`.includes(query));
      cards.forEach((card) => {
        card.hidden = !visible.includes(card);
      });
      visible.sort((a, b) => {
        if (sort?.value === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        const key = sort?.value === 'rating' ? 'rating' : 'reviews';
        return Number(b.dataset[key]) - Number(a.dataset[key]);
      });
      visible.forEach((card) => grid?.append(card));
      if (count) count.textContent = String(visible.length);
      if (empty) empty.hidden = visible.length > 0;
    };
    search?.addEventListener('input', updateDirectory);
    sort?.addEventListener('change', updateDirectory);
  </script>
</PageLayout>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
   * LOCAL DIRECTORY STYLES (Exact 1:1 Implementation from Screenshot)
   * ══════════════════════════════════════════════════════════════════════════ */
  :root {
    --dir-bg: #080818;
    --dir-surface: #111125;
    --dir-surface-2: #15152d;
    --dir-gold: #d4a844;
    --dir-gold-light: #f0c95c;
    --dir-text: #f0f0f5;
    --dir-muted: #9292ad;
    --dir-dim: #64647f;
    --dir-line: rgba(255, 255, 255, 0.09);
  }

  .page-hero {
    padding: 72px 0 56px;
    background: #101024;
    border-bottom: 1px solid var(--dir-line);
    text-align: center;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.48rem;
    margin-bottom: 1.25rem;
    color: var(--dir-dim);
    font-size: 0.72rem;
  }
  .breadcrumb a {
    color: var(--dir-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .breadcrumb a:hover {
    color: var(--dir-gold-light);
  }
  .page-hero h1 {
    max-width: 900px;
    margin: 0 auto;
    color: #ffffff;
    font-size: clamp(2rem, 4.7vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .page-hero p {
    max-width: 620px;
    margin: 1rem auto 0;
    color: var(--dir-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .directory-section {
    padding: 64px 0 88px;
    background: var(--dir-bg);
  }
  .directory-toolbar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }
  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    color: var(--dir-gold);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .section-kicker > span {
    width: 28px;
    height: 2px;
    background: var(--dir-gold);
  }
  .directory-toolbar h2,
  .sector-callout h2,
  .link-section h2 {
    margin: 0;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .directory-toolbar > div > p:last-child {
    margin: 0.35rem 0 0;
    color: var(--dir-muted);
    font-size: 0.78rem;
  }
  .directory-controls {
    display: grid;
    grid-template-columns: 230px 145px;
    gap: 0.7rem;
  }
  .directory-controls label {
    color: var(--dir-dim);
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .directory-controls input,
  .directory-controls select {
    display: block;
    width: 100%;
    height: 42px;
    margin-top: 0.35rem;
    padding: 0 0.75rem;
    border: 1px solid var(--dir-line);
    border-radius: 6px;
    background: var(--dir-surface);
    color: var(--dir-text);
    font: inherit;
    font-size: 0.72rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .directory-controls input:focus,
  .directory-controls select:focus {
    border-color: var(--dir-gold);
  }

  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .business-card {
    overflow: hidden;
    border: 1px solid var(--dir-line);
    border-radius: 10px;
    background: var(--dir-surface);
    box-shadow: 0 18px 45px -35px #000000;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .business-card:hover {
    border-color: rgba(212, 168, 68, 0.3);
    transform: translateY(-2px);
  }
  .business-card[hidden] {
    display: none;
  }
  .business-photo {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #1a1a31;
  }
  .business-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .business-card:hover .business-photo img {
    transform: scale(1.03);
  }
  .business-photo > span {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    padding: 0.24rem 0.42rem;
    border-radius: 4px;
    background: rgba(8, 8, 24, 0.82);
    color: #ffffff;
    font-size: 0.55rem;
  }
  .business-body {
    padding: 1rem;
  }
  .business-tags,
  .business-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .business-tags span,
  .business-chips span {
    padding: 0.22rem 0.45rem;
    border: 1px solid rgba(212, 168, 68, 0.22);
    border-radius: 999px;
    color: var(--dir-gold);
    font-size: 0.55rem;
    font-weight: 600;
  }
  .business-card h3 {
    margin: 0.62rem 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .business-card h3 a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .business-card h3 a:hover {
    color: var(--dir-gold-light);
  }
  .business-rating {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.68rem;
  }
  .business-rating > span {
    color: var(--dir-gold);
  }
  .business-rating small {
    color: var(--dir-dim);
  }
  .business-card address {
    min-height: 2.6em;
    margin: 0.55rem 0;
    color: var(--dir-muted);
    font-size: 0.68rem;
    font-style: normal;
    line-height: 1.5;
  }
  .business-chips {
    margin: 0.75rem 0;
  }
  .business-chips span {
    border-color: var(--dir-line);
    color: var(--dir-dim);
  }
  .business-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    margin-top: 0.9rem;
  }
  .business-primary,
  .gold-button {
    padding: 0.6rem 0.85rem;
    border-radius: 5px;
    background: linear-gradient(135deg, var(--dir-gold), var(--dir-gold-light));
    color: #090918;
    font-size: 0.64rem;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }
  .business-primary:hover,
  .gold-button:hover {
    opacity: 0.9;
  }
  .business-directions {
    color: #2ecc71;
    font-size: 0.64rem;
    font-weight: 800;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .business-directions:hover {
    opacity: 0.8;
  }

  .empty-state,
  .no-results {
    padding: 2.5rem;
    border: 1px solid var(--dir-line);
    border-radius: 10px;
    background: var(--dir-surface);
    text-align: center;
  }
  .empty-state p,
  .no-results {
    color: var(--dir-muted);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }
  .empty-state a {
    color: var(--dir-gold);
    font-weight: 800;
    text-decoration: none;
  }

  .sector-callout {
    margin-top: 2.5rem;
    padding: 1.8rem;
    border: 1px solid var(--dir-line);
    border-radius: 9px;
    background: var(--dir-surface);
  }
  .sector-callout > p:not(.section-kicker) {
    margin: 0.65rem 0 1rem;
    color: var(--dir-muted);
    font-size: 0.75rem;
  }
  .sector-callout > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .outline-button {
    padding: 0.58rem 0.78rem;
    border: 1px solid var(--dir-line);
    border-radius: 5px;
    color: #ffffff;
    font-size: 0.64rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .outline-button:hover {
    border-color: var(--dir-gold);
    color: var(--dir-gold-light);
  }

  .link-section {
    margin-top: 2rem;
  }
  .link-section h2 {
    margin-bottom: 0.8rem;
  }
  .link-section > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .link-section a {
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--dir-line);
    border-radius: 5px;
    background: var(--dir-surface);
    color: var(--dir-muted);
    font-size: 0.62rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .link-section a:hover {
    border-color: rgba(212, 168, 68, 0.35);
    color: var(--dir-gold-light);
  }

  .publication {
    padding: 0.8rem 0;
    border-top: 1px solid var(--dir-line);
    border-bottom: 1px solid var(--dir-line);
    background: #0d0d21;
    color: var(--dir-dim);
    font-size: 0.58rem;
  }
  .publication .container {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .directory-toolbar {
      grid-template-columns: 1fr;
    }
    .business-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .page-hero {
      padding: 48px 0 36px;
    }
    .directory-section {
      padding: 40px 0 60px;
    }
    .directory-controls,
    .business-grid {
      grid-template-columns: 1fr;
    }
    .publication .container {
      flex-direction: column;
    }
  }
</style>
