---
/**
 * Individual Place Detail Authority Page
 * Route: /places/[category]/[slug]
 * Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyWatermark from '@components/property/PropertyWatermark.astro';
import { SITE } from '@data/site';
import { PLACES_DATA, PLACE_CATEGORIES, type PlaceItem } from '@data/places';
import propertiesData from '@data/properties-import.json';

export async function getStaticPaths() {
  return PLACES_DATA.map((place) => {
    return {
      params: {
        category: place.category,
        slug: place.slug,
      },
      props: {
        place,
      },
    };
  });
}

interface Props {
  place: PlaceItem;
}

const { place } = Astro.props;

const categoryMeta = PLACE_CATEGORIES.find((c) => c.key === place.category);
const categoryLabel = categoryMeta?.label || place.categoryLabel;

// Match related properties in the same block if available, else first 3
const relatedProps = propertiesData
  .filter((prop) => !place.block || prop.block.toLowerCase().includes(place.block.toLowerCase().replace('block ', '')))
  .slice(0, 3);

const displayProps = relatedProps.length > 0 ? relatedProps : propertiesData.slice(0, 3);

// Related other places in same category
const otherPlacesInCategory = PLACES_DATA.filter(
  (p) => p.category === place.category && p.id !== place.id
).slice(0, 3);

const pageSchema = {
  name: `${place.name} — ${categoryLabel} in Al Rehman Garden Phase 2 Lahore`,
  description: place.description,
  url: `${SITE.url}/places/${place.category}/${place.slug}`,
};

const placeSchema = {
  name: place.name,
  description: place.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: place.address,
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: place.lat,
    longitude: place.lng,
  },
  telephone: place.phone || '+923257800001',
  url: `${SITE.url}/places/${place.category}/${place.slug}`,
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Places Directory',
      item: `${SITE.url}/places`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoryLabel,
      item: `${SITE.url}/places/${place.category}`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: place.name,
      item: `${SITE.url}/places/${place.category}/${place.slug}`,
    },
  ],
};

const faqSchema = {
  itemListElement: place.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<PageLayout
  title={`${place.name} | ${categoryLabel} in Al Rehman Garden Phase 2 Lahore`}
  description={`${place.name} located at ${place.address} (${place.distance} from Phase 2). View timings, amenities, reviews, map location, and nearby properties.`}
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="Place" data={placeSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />
  {place.faqs.length > 0 && <Schema type="FAQPage" data={faqSchema} />}

  <main class="place-detail-page">
    <!-- Top Header Navigation -->
    <header class="place-topbar">
      <div class="container place-topbar__inner">
        <a href="/" class="place-topbar__logo">
          <img src="/images/logo/logo-white.svg" alt={SITE.name} width="190" height="48" />
        </a>

        <nav class="place-topbar__nav">
          <a href="/" class="place-nav-link">Home</a>
          <a href="/blocks" class="place-nav-link">Blocks</a>
          <a href="/properties" class="place-nav-link">Properties</a>
          <a href="/plots" class="place-nav-link">Plots</a>
          <a href="/houses-for-sale-in-al-rehman-garden-phase-2-lahore" class="place-nav-link">Houses</a>
          <a href="/places" class="place-nav-link place-nav-link--active">Places</a>
          <a href="/al-rehman-garden-phase-2-map" class="place-nav-link">Map</a>
          <a href="/property-prices" class="place-nav-link">Prices</a>
          <a href="/contact" class="place-nav-link">Contact</a>
        </nav>

        <a
          href="https://wa.me/923257800001"
          target="_blank"
          rel="noopener noreferrer"
          class="place-btn-gold"
        >
          WhatsApp
        </a>
      </div>
    </header>

    <!-- Hero Header -->
    <section class="place-hero">
      <div class="container">
        <!-- Breadcrumb -->
        <nav class="place-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>&gt;</span>
          <a href="/places">Places</a>
          <span>&gt;</span>
          <a href={`/places/${place.category}`}>{categoryLabel}</a>
          <span>&gt;</span>
          <span class="active">{place.name}</span>
        </nav>

        <div class="place-hero__header">
          <div class="place-hero__badges">
            <span class="place-pill place-pill--gold">{categoryLabel}</span>
            <span class="place-pill place-pill--dist">📍 {place.distance} ({place.travelTime})</span>
            <span class="place-pill place-pill--rating">★ {place.rating.toFixed(1)} ({place.reviewCount} Reviews)</span>
          </div>

          <h1 class="place-hero__title">{place.name}</h1>
          <p class="place-hero__address">📍 {place.address}</p>
        </div>
      </div>
    </section>

    <!-- Main Content Grid -->
    <section class="place-section">
      <div class="container">
        <div class="place-layout-grid">
          <!-- Left Main Column -->
          <div class="place-main-col">
            <!-- Image Showcase -->
            <div class="place-gallery-card">
              <div class="place-gallery__main-img-wrap">
                <img
                  src={place.images[0] || '/images/og/homepage-og.jpg'}
                  alt={place.name}
                  class="place-gallery__img"
                  loading="eager"
                />
                <PropertyWatermark position="bottom-right" opacity={0.35} />
                <span class="place-gallery__status-badge">🟢 Verified Facility</span>
              </div>
            </div>

            <!-- Overview & Long Description -->
            <div class="place-card-block">
              <h2 class="place-block-title">About {place.name}</h2>
              <p class="place-body-text">{place.longDescription || place.description}</p>
            </div>

            <!-- Key Features & Amenities Checklist -->
            <div class="place-card-block">
              <h2 class="place-block-title">Key Amenities &amp; Features</h2>
              <div class="place-features-grid">
                {place.features.map((feat) => (
                  <div class="place-feature-item">
                    <span class="place-feature-icon">✓</span>
                    <span class="place-feature-text">{feat}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Interactive Map Section -->
            <div class="place-card-block">
              <div class="place-map-header">
                <div>
                  <h2 class="place-block-title" style="margin-bottom: 4px;">Location &amp; Coordinates</h2>
                  <p class="place-map-sub">GPS: {place.lat}° N, {place.lng}° E • {place.address}</p>
                </div>
                <a
                  href={`https://maps.google.com/?q=${encodeURIComponent(`${place.name} Al Rehman Garden Phase 2 Lahore`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-open-nav"
                >
                  Get Directions ↗
                </a>
              </div>

              <div class="place-map-frame-box">
                <iframe
                  title={`${place.name} Google Map Location`}
                  src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13594.756281096538!2d${place.lng}!3d${place.lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391901a1c9df253b%3A0xb35a80579e0f63e6!2sAl-Rehman%20Garden%20Phase%202%2C%20Lahore!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s`}
                  width="100%"
                  height="360"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  class="place-map-iframe"
                ></iframe>
              </div>
            </div>

            <!-- Nearby Places in Same Category -->
            {otherPlacesInCategory.length > 0 && (
              <div class="place-card-block">
                <h2 class="place-block-title">Other {categoryLabel} Nearby</h2>
                <div class="other-places-grid">
                  {otherPlacesInCategory.map((other) => (
                    <a href={`/places/${other.category}/${other.slug}`} class="other-place-card">
                      <div class="other-place-card__img-wrap">
                        <img
                          src={other.images[0] || '/images/placeholders/property-placeholder.webp'}
                          alt={other.name}
                          class="other-place-card__img"
                          loading="lazy"
                        />
                        <span class="other-place-card__dist">📍 {other.distance}</span>
                      </div>
                      <div class="other-place-card__body">
                        <h3 class="other-place-card__title">{other.name}</h3>
                        <span class="other-place-card__link">View Facility Details →</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- FAQ Section -->
            {place.faqs.length > 0 && (
              <div class="place-card-block">
                <h2 class="place-block-title">Frequently Asked Questions</h2>
                <div class="place-faqs-list">
                  {place.faqs.map((faq) => (
                    <div class="place-faq-item">
                      <h3 class="place-faq-q">{faq.question}</h3>
                      <p class="place-faq-a">{faq.answer}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Right Sticky Sidebar -->
          <aside class="place-sidebar-col">
            <!-- Facility Info Card -->
            <div class="sidebar-box">
              <h3 class="sidebar-box__title">Facility Quick Info</h3>
              
              <div class="sidebar-info-rows">
                <div class="sidebar-info-row">
                  <span class="sidebar-label">CATEGORY</span>
                  <strong class="sidebar-value">{categoryLabel}</strong>
                </div>

                <div class="sidebar-info-row">
                  <span class="sidebar-label">DISTANCE</span>
                  <strong class="sidebar-value">{place.distance}</strong>
                </div>

                <div class="sidebar-info-row">
                  <span class="sidebar-label">DRIVE TIME</span>
                  <strong class="sidebar-value">{place.travelTime}</strong>
                </div>

                {place.timings && (
                  <div class="sidebar-info-row">
                    <span class="sidebar-label">OPERATING HOURS</span>
                    <strong class="sidebar-value">{place.timings}</strong>
                  </div>
                )}

                {place.phone && (
                  <div class="sidebar-info-row">
                    <span class="sidebar-label">CONTACT / INQUIRY</span>
                    <strong class="sidebar-value">{place.phone}</strong>
                  </div>
                )}
              </div>

              <div class="sidebar-actions">
                <a
                  href={`https://wa.me/923257800001?text=${encodeURIComponent(`Salam Ahmad Huzaifah, I need more information regarding ${place.name} near Al Rehman Garden Phase 2 Lahore.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-sidebar btn-sidebar--whatsapp"
                >
                  💬 Inquire on WhatsApp
                </a>

                <a
                  href={`https://maps.google.com/?q=${encodeURIComponent(`${place.name} Al Rehman Garden Phase 2 Lahore`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-sidebar btn-sidebar--map"
                >
                  📍 Open Live Navigation
                </a>
              </div>
            </div>

            <!-- Nearby Landmarks Card -->
            {place.nearbyLandmarks.length > 0 && (
              <div class="sidebar-box">
                <h3 class="sidebar-box__title">Surrounding Landmarks</h3>
                <ul class="landmarks-list">
                  {place.nearbyLandmarks.map((lm) => (
                    <li>📍 {lm}</li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Nearby Verified Properties Preview -->
            <div class="sidebar-box">
              <h3 class="sidebar-box__title">Nearby Verified Properties</h3>
              <div class="sidebar-props-list">
                {displayProps.map((prop) => (
                  <a href={`/properties/${prop.slug}`} class="mini-prop-link">
                    <div class="mini-prop-thumb-wrap">
                      <img
                        src={prop.images[0]?.url || '/images/placeholders/property-placeholder.webp'}
                        alt={prop.title}
                        class="mini-prop-thumb"
                        loading="lazy"
                      />
                    </div>
                    <div class="mini-prop-info">
                      <span class="mini-prop-block">{prop.block}</span>
                      <h4 class="mini-prop-title">{prop.title}</h4>
                      <strong class="mini-prop-price">PKR {new Intl.NumberFormat('en-PK').format(prop.price)}</strong>
                    </div>
                  </a>
                ))}
              </div>

              <a href="/properties" class="btn-sidebar-viewall">
                Browse All Properties in Society →
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Large CTA Section -->
    <section class="place-cta-section">
      <div class="container">
        <div class="place-cta-box">
          <div class="place-cta-box__body">
            <h2 class="place-cta-box__title">
              Looking to Buy Property near <br />
              <span class="text-gold">{place.name}?</span>
            </h2>
            <p class="place-cta-box__desc">
              Connect with <strong>Ahmad Huzaifah</strong> for verified on-ground plots and ready designer houses located within walking distance of {place.name}.
            </p>
          </div>

          <div class="place-cta-box__actions">
            <a
              href={`https://wa.me/923257800001?text=${encodeURIComponent(`Salam Ahmad Huzaifah, I want to find verified properties near ${place.name} in Al Rehman Garden Phase 2.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-cta-gold"
            >
              💬 WhatsApp Property Desk
            </a>
            <a href="/properties" class="btn-cta-outline">
              View All Properties
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="place-footer">
      <div class="container">
        <div class="place-footer__grid">
          <div class="place-footer__brand-col">
            <img src="/images/logo/logo-white.svg" alt={SITE.name} width="220" height="55" class="place-footer__logo" />
            <p class="place-footer__desc">
              Comprehensive community facilities, schools, hospitals, and local business directory for Al Rehman Garden Phase 2 Lahore.
            </p>
          </div>

          <div class="place-footer__col">
            <h4 class="place-footer__heading">Categories</h4>
            <ul class="place-footer__list">
              <li><a href="/places/schools">Schools</a></li>
              <li><a href="/places/hospitals">Hospitals</a></li>
              <li><a href="/places/mosques">Mosques</a></li>
              <li><a href="/places/restaurants">Restaurants</a></li>
              <li><a href="/places/shopping">Shopping</a></li>
              <li><a href="/places/parks">Parks</a></li>
            </ul>
          </div>

          <div class="place-footer__col">
            <h4 class="place-footer__heading">Explore</h4>
            <ul class="place-footer__list">
              <li><a href="/blocks">Blocks Directory</a></li>
              <li><a href="/al-rehman-garden-phase-2-map">Master Map</a></li>
              <li><a href="/property-prices">Property Prices</a></li>
              <li><a href="/property-dealer">Property Consultant</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <div class="place-footer__col">
            <h4 class="place-footer__heading">Legal</h4>
            <ul class="place-footer__list">
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
              <li><a href="/disclaimer">Disclaimer</a></li>
              <li><a href="/copyright-policy">Copyright</a></li>
            </ul>
          </div>
        </div>

        <div class="place-footer__bottom">
          <p>&copy; {new Date().getFullYear()} Al Rehman Garden Phase 2 Lahore Authority Portal. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </main>
</PageLayout>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     THEME & GLOBAL CANVAS — DARK NAVY #090B20 & GOLD #D4AF37
     ══════════════════════════════════════════════════════════════════════════ */
  .place-detail-page {
    background-color: #090B20;
    color: #F8FAFC;
    min-height: 100vh;
    font-family: var(--font-sans);
  }

  .text-gold {
    color: #D4AF37;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     TOP NAVIGATION BAR
     ══════════════════════════════════════════════════════════════════════════ */
  .place-topbar {
    background: rgba(9, 11, 32, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    padding: 14px 0;
  }

  .place-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .place-topbar__nav {
    display: none;
    align-items: center;
    gap: 20px;
  }

  @media (min-width: 992px) {
    .place-topbar__nav {
      display: flex;
    }
  }

  .place-nav-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .place-nav-link:hover,
  .place-nav-link--active {
    color: #D4AF37;
  }

  .place-btn-gold {
    background: #D4AF37;
    color: #090B20;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .place-btn-gold:hover {
    background: #F3D375;
    transform: translateY(-1px);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     HERO SECTION
     ══════════════════════════════════════════════════════════════════════════ */
  .place-hero {
    padding: 40px 0 32px;
    background: radial-gradient(circle at 50% 15%, #181A45 0%, #090B20 80%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .place-breadcrumb {
    font-size: 12.5px;
    color: #94A3B8;
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .place-breadcrumb a {
    color: #94A3B8;
    text-decoration: none;
  }

  .place-breadcrumb a:hover {
    color: #D4AF37;
  }

  .place-breadcrumb .active {
    color: #CBD5E1;
  }

  .place-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
  }

  .place-pill {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 6px;
  }

  .place-pill--gold {
    background: rgba(212, 175, 55, 0.15);
    color: #F3D375;
    border: 1px solid rgba(212, 175, 55, 0.35);
  }

  .place-pill--dist {
    background: rgba(255, 255, 255, 0.08);
    color: #CBD5E1;
  }

  .place-pill--rating {
    background: rgba(245, 158, 11, 0.15);
    color: #FBBF24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .place-hero__title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 6px;
    line-height: 1.25;
  }

  .place-hero__address {
    font-size: 14px;
    color: #94A3B8;
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     MAIN LAYOUT GRID & CARDS (#15172D)
     ══════════════════════════════════════════════════════════════════════════ */
  .place-section {
    padding: 48px 0 64px;
  }

  .place-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 992px) {
    .place-layout-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .place-main-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .place-gallery-card {
    background: #15172D;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
  }

  .place-gallery__main-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .place-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .place-gallery__status-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(6, 78, 59, 0.88);
    color: #6EE7B7;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    backdrop-filter: blur(4px);
  }

  .place-card-block {
    background: #15172D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 28px;
  }

  .place-block-title {
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 14px;
  }

  .place-body-text {
    font-size: 14.5px;
    color: #CBD5E1;
    line-height: 1.7;
    margin: 0;
  }

  /* Features Grid */
  .place-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 600px) {
    .place-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .place-feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1D203C;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 10px 14px;
    border-radius: 8px;
  }

  .place-feature-icon {
    color: #34D399;
    font-weight: 800;
  }

  .place-feature-text {
    font-size: 13.5px;
    color: #E2E8F0;
  }

  /* Map Container */
  .place-map-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  @media (min-width: 600px) {
    .place-map-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .place-map-sub {
    font-size: 12.5px;
    color: #94A3B8;
    margin: 0;
  }

  .btn-open-nav {
