---
import GuidePage from '@components/content/GuidePage.astro';
import { PLACES_DATA, type PlaceItem } from '@data/places';

export function getStaticPaths() {
  return PLACES_DATA.map((place) => ({ params: { category: place.category, slug: place.slug }, props: { place } }));
}

interface Props { place: PlaceItem }
const { place } = Astro.props;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.name+' '+place.address)}`;
---

<GuidePage
  title={place.name}
  metaTitle={`${place.name} | DHA Phase 6 Lahore Places`}
  description={place.description}
  eyebrow={place.categoryLabel}
  facts={[
    { label: 'Area', value: place.distance },
    { label: 'Travel time', value: place.travelTime },
    { label: 'Hours', value: place.timings || 'Confirm directly' },
    { label: 'Directory status', value: 'Research starting point' },
  ]}
  sections={[
    { heading: 'Location overview', paragraphs: [place.longDescription || place.description, `Directory address: ${place.address}. Use current navigation and confirm the destination directly.`] },
    { heading: 'What to check', paragraphs: ['Information can change after publication.'], bullets: [...place.features, 'Current opening hours and access', 'Route from the exact DHA Phase 6 gate'] },
    { heading: 'Map and nearby context', paragraphs: [`Nearby references include ${place.nearbyLandmarks.join(', ')}.`, `Open the current Google Maps search: ${mapHref}`] },
  ]}
  faqs={place.faqs}
  sources={[{ label: 'Open current Google Maps search', href: mapHref }, { label: 'Back to category', href: `/places/${place.category}` }]}
/>
