---
/**
 * Al Rehman Garden Phase 2 Legal NOC Status & Approvals — Authority SEO Hub
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';

const legalHighlights = [
  { title: 'LDA Planning Sanction', desc: 'Approved housing scheme layout adhering to Lahore Development Authority regulatory guidelines and master structural zoning.' },
  { title: 'Clear Land Ownership & Registry', desc: '100% undisputed land possession with registry and direct society transfer executed in the authorized head office.' },
  { title: 'Utility Sanctions (LESCO & SNGPL)', desc: 'Formal utility approvals for underground electric power supply, grid station connectivity, and Sui gas distribution.' },
  { title: 'WASA / Environmental Clearances', desc: 'Approved sanitation, sewerage drainage, and environmental sustainability clearances for residential expansion.' },
];

const faqs = [
  {
    question: 'Is Al Rehman Garden Phase 2 approved by LDA?',
    answer: 'Yes. Al Rehman Garden Phase 2 holds LDA planning permissions and complies with development authority guidelines, with fully approved layout plans for its primary sectors.',
  },
  {
    question: 'How is the plot transfer and registry process conducted?',
    answer: 'Plot transfers are completed officially at the Al Rehman Developers Head Office in Lahore. The process includes biometric verification, original allotment certificate transfer, and formal registry execution.',
  },
];

const faqSchema = {
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<PageLayout
  title="Al Rehman Garden Phase 2 NOC Status & Legal Approvals 2026 — LDA Guide"
  description="Verify the legal approval and NOC status of Al Rehman Garden Phase 2 Lahore. Learn about LDA compliance, land title security, registry transfers, and utility sanctions."
>
  <Schema type="FAQPage" data={faqSchema} />

  <section class="auth-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Legal Security & Approvals</div>
      <h1 class="auth-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">NOC & Legal Status</span>
      </h1>
      <p class="auth-hero__lead lead">
        An authoritative guide on government approvals, Lahore Development Authority (LDA) zoning compliance, and secure property transfer procedures.
      </p>
      <div class="auth-meta-bar">
        <span>📅 Legal Audit Date: September 2026</span>
        <span>⚖️ Legal Status: Approved & Secure Title</span>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <!-- Legal Pillars Grid -->
      <div class="noc-pillars-grid">
        {legalHighlights.map((l) => (
          <div class="noc-pillar-card">
            <span class="noc-check-badge">✓ Verified</span>
            <h3 class="noc-pillar-title">{l.title}</h3>
            <p class="noc-pillar-desc">{l.desc}</p>
          </div>
        ))}
      </div>

      <!-- FAQ Card -->
      <div class="auth-faq-card">
        <h2 class="auth-faq-card__title">Legal & NOC Verification FAQs</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <h3 class="faq-item__q">Q: {f.question}</h3>
              <p class="faq-item__a">{f.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .auth-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .auth-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .auth-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0 0 var(--space-4);
  }

  .auth-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: #F3D375;
  }

  .noc-pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .noc-pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .noc-pillar-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .noc-check-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--font-bold);
    color: #059669;
    background: #ECFDF5;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-3);
  }

  .noc-pillar-title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .noc-pillar-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .auth-faq-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .auth-faq-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .faq-item__q {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .faq-item__a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }
</style>
