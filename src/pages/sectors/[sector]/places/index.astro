---
/**
 * DHA Phase 6 Lahore — Sector Facilities & Places Landing Page
 * Route: /sectors/[sector]/places/
 * Generates a comprehensive Facilities Guide for every sector.
 */
import {
  SECTORS_DIRECTORY,
  PLACE_CATEGORIES,
  getSectorPlaces,
  getSectorCategoryPlaces,
  getPlaceImage,
  type SectorMeta,
} from '@data/places/index';

import PlaceImage from '@components/places/PlaceImage.astro';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return SECTORS_DIRECTORY.map((sector) => ({
    params: { sector: sector.key },
    props: { sectorMeta: sector },
  }));
}

interface Props { sectorMeta: SectorMeta; }
const { sectorMeta } = Astro.props as Props;

const allPlaces = getSectorPlaces(sectorMeta.key);
const canonical = `${SITE.url}/sectors/${sectorMeta.key}/places/`;
const pageTitle = `${sectorMeta.label} Facilities Guide — DHA Phase 6 Lahore`;
const metaTitle = `${sectorMeta.label} Places & Facilities | DHA Phase 6 Lahore`;
const description = `Complete facilities guide for ${sectorMeta.label}, DHA Phase 6 Lahore. Browse verified schools, hospitals, restaurants, mosques, banks, supermarkets, gyms, parks and more.`;

// Category groups for display
const FACILITY_GROUPS = [
  { key: 'all', label: 'All Facilities', icon: '🏙️', categories: null },
  { key: 'education', label: 'Education', icon: '🎓', categories: ['schools', 'colleges', 'school', 'college'] },
  { key: 'healthcare', label: 'Healthcare', icon: '🏥', categories: ['hospital', 'hospitals', 'clinic', 'pharmacy', 'idc'] },
  { key: 'food', label: 'Dining', icon: '🍽️', categories: ['restaurants', 'cafes', 'bakery', 'fast-food'] },
  { key: 'religion', label: 'Mosques', icon: '🕌', categories: ['mosque', 'mosques'] },
  { key: 'shopping', label: 'Shopping', icon: '🛍️', categories: ['supermarkets', 'shopping', 'beauty-salons'] },
  { key: 'services', label: 'Services', icon: '🏦', categories: ['banks', 'services', 'courier-services', 'internet-providers'] },
  { key: 'lifestyle', label: 'Lifestyle', icon: '💪', categories: ['gym', 'gyms', 'park', 'parks', 'club'] },
];

// Stats per group
function getGroupCount(groupKey: string): number {
  const g = FACILITY_GROUPS.find(x => x.key === groupKey);
  if (!g || !g.categories) return allPlaces.length;
  return allPlaces.filter(p => g.categories!.includes(p.category)).length;
}

// Build category summary cards (categories with ≥1 place in this sector)
const categorySummary = PLACE_CATEGORIES
  .map(cat => ({ cat, count: getSectorCategoryPlaces(sectorMeta.key, cat.key).length }))
  .filter(x => x.count > 0)
  .sort((a, b) => b.count - a.count);

const topCats = categorySummary.slice(0, 8);

// Nearby sectors (all residential, excluding self)
const nearbySectors = SECTORS_DIRECTORY
  .filter(s => s.key !== sectorMeta.key && s.type === 'residential')
  .slice(0, 6);

// FAQs
const faqs = [
  {
    q: `How many verified places are listed in ${sectorMeta.label}?`,
    a: `This guide currently lists ${allPlaces.length} verified places across ${categorySummary.length} categories in ${sectorMeta.label}, DHA Phase 6 Lahore. All business information is sourced from public records and Google Maps data.`,
  },
  {
    q: `What types of facilities are available in ${sectorMeta.label}?`,
    a: `${sectorMeta.label} has ${categorySummary.slice(0, 4).map(x => x.cat.label).join(', ')}, and more. Use the filter buttons above to browse by facility type.`,
  },
  {
    q: `Where can I find schools in ${sectorMeta.label}?`,
    a: `You can browse all schools and educational institutions in ${sectorMeta.label} using the Education filter. This includes private schools, academies, and colleges near ${sectorMeta.label}.`,
  },
  {
    q: `Are there hospitals or clinics in ${sectorMeta.label}?`,
    a: `Yes, ${sectorMeta.label} has healthcare facilities including clinics, pharmacies, and nearby hospitals. Use the Healthcare filter to view all verified medical services.`,
  },
  {
    q: `Is this an official DHA Lahore directory?`,
    a: `No. This is an independent information portal. Business listings are compiled from publicly available data including Google Maps. Always verify details directly before visiting.`,
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: 'en-PK',
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Sectors', item: `${SITE.url}/sectors/` },
        { '@type': 'ListItem', position: 3, name: sectorMeta.label, item: `${SITE.url}/sectors/${sectorMeta.key}/` },
        { '@type': 'ListItem', position: 4, name: 'Places & Facilities', item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#facilities`,
      name: `Verified places in ${sectorMeta.label} DHA Phase 6 Lahore`,
      numberOfItems: allPlaces.length,
      itemListElement: allPlaces.slice(0, 30).map((place, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'LocalBusiness',
          '@id': `${SITE.url}/places/${place.category}/${place.slug}/`,
          name: place.name,
          url: `${SITE.url}/places/${place.category}/${place.slug}/`,
          image: getPlaceImage(place).src,
          ...(place.phone ? { telephone: place.phone } : {}),
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
        },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en-PK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a1a" />
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- Header -->
    <header class="site-header">
      <nav class="navbar" aria-label="Primary navigation">
        <div class="container nav-inner">
          <a href="/" class="nav-logo" aria-label="DHA Phase 6 Lahore home">
            <span>D6</span>
            <strong>DHA Phase <b>6</b> Lahore</strong>
          </a>
          <div class="nav-links" id="nav-links">
            <a href="/">Home</a>
            <a href="/sectors/" class="active">Sectors</a>
            <a href="/properties/">Properties</a>
            <a href="/places/">Places</a>
            <a href="/plots/">Plots</a>
            <a href="/jobs/">Jobs</a>
            <a href="/dealers/">Dealers</a>
            <a href="/dha-phase-6-lahore-map/">Map</a>
            <a href="/dha-phase-6-lahore-map/#map-pdf-downloads" class="nav-cta">Map PDFs</a>
          </div>
          <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="Open navigation">
            <span></span><span></span><span></span>
          </button>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <!-- Hero -->
      <header class="page-hero">
        <div class="container">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span>
            <a href="/sectors/">Sectors</a><span>/</span>
            <a href={`/sectors/${sectorMeta.key}/`}>{sectorMeta.label}</a><span>/</span>
            <span aria-current="page">Places &amp; Facilities</span>
          </nav>
          <div class="hero-badge">Facilities Guide</div>
          <h1>{sectorMeta.label} Facilities &amp; Places Guide</h1>
          <p>{description}</p>
          <!-- Stats strip -->
          <div class="stats-strip">
            <div class="stat-pill">
              <strong>{allPlaces.length}</strong>
              <span>Verified Places</span>
            </div>
            <div class="stat-pill">
              <strong>{categorySummary.length}</strong>
              <span>Categories</span>
            </div>
            <div class="stat-pill">
              <strong>{getGroupCount('education')}</strong>
              <span>Schools &amp; Colleges</span>
            </div>
            <div class="stat-pill">
              <strong>{getGroupCount('healthcare')}</strong>
              <span>Healthcare</span>
            </div>
            <div class="stat-pill">
              <strong>{getGroupCount('food')}</strong>
              <span>Dining</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Sector Overview -->
      <section class="sector-overview-section">
        <div class="container">
          <div class="overview-grid">
            <div class="overview-text">
              <p class="section-kicker"><span></span> Local area guide</p>
              <h2>About {sectorMeta.label}</h2>
              <p>{sectorMeta.description}</p>
              <p>Use the facility finder below to browse all verified businesses and services. For property information, visit the <a href={`/sectors/${sectorMeta.key}/`}>{sectorMeta.label} property directory</a>.</p>
              <div class="overview-actions">
                <a href={`/places/${sectorMeta.key}/`} class="btn-gold">Browse All Places</a>
                <a href={`/sectors/${sectorMeta.key}/`} class="btn-outline">Property Directory</a>
              </div>
            </div>
            <div class="cat-quick-grid">
              {topCats.map(({ cat, count }) => (
                <a href={`/places/${sectorMeta.key}/${cat.key}/`} class="cat-quick-card">
                  <strong>{count}</strong>
                  <span>{cat.label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Facility Directory -->
      <section class="directory-section" id="facilities">
        <div class="container">
          <div class="dir-header">
            <p class="section-kicker"><span></span> Verified businesses</p>
            <h2>{sectorMeta.label} Places Directory</h2>
            <p class="dir-meta"><strong id="result-count">{allPlaces.length}</strong> verified places — filter by category or search by name</p>
          </div>

          <!-- Filter tabs -->
          <div class="filter-tabs" role="tablist" aria-label="Filter by facility type">
            {FACILITY_GROUPS.map((g, i) => (
              <button
                class={`filter-tab${i === 0 ? ' active' : ''}`}
                data-filter={g.key}
                data-cats={g.categories ? g.categories.join(',') : ''}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="business-grid"
                id={`tab-${g.key}`}
              >
                <span class="tab-icon">{g.icon}</span>
                <span>{g.label}</span>
                <span class="tab-count">{g.key === 'all' ? allPlaces.length : getGroupCount(g.key)}</span>
              </button>
            ))}
          </div>

          <!-- Search -->
          <div class="search-bar-wrap">
            <div class="search-bar">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="business-search" type="search" placeholder={`Search in ${sectorMeta.label}…`} aria-label="Search businesses" />
            </div>
            <label class="sort-label">
              <span>Sort</span>
              <select id="business-sort">
                <option value="reviews">Most reviewed</option>
                <option value="rating">Highest rated</option>
                <option value="name">Name A–Z</option>
              </select>
            </label>
          </div>

          <!-- Grid -->
          <div class="business-grid" id="business-grid">
            {allPlaces.map((place) => {
              const img = getPlaceImage(place);
              return (
                <article
                  class="business-card"
                  data-name={place.name.toLowerCase()}
                  data-address={place.address.toLowerCase()}
                  data-rating={place.rating || 0}
                  data-reviews={place.reviewCount}
                  data-category={place.category}
                >
                  <a class="business-photo" href={`/places/${place.category}/${place.slug}/`} aria-label={`View ${place.name}`}>
                    <PlaceImage place={place} />
                    {img.isOriginal && <span class="verified-badge">Verified</span>}
                  </a>
                  <div class="business-body">
                    <div class="business-tags">
                      <span>{place.categoryLabel}</span>
                      <span>{sectorMeta.label}</span>
                    </div>
                    <h3><a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a></h3>
                    <div class="business-rating">
                      {place.rating ? (
                        <>
                          <span aria-label={`${place.rating} out of 5 stars`}>★</span>
                          <strong>{place.rating.toFixed(1)}</strong>
                          <small>{place.reviewCount > 0 ? `${place.reviewCount.toLocaleString('en-PK')} reviews` : 'Rated'}</small>
                        </>
                      ) : <small>Rating not shown</small>}
                    </div>
                    <address>{place.address}</address>
                    <div class="business-actions">
                      {place.phone ? (
                        <a class="btn-phone" href={`tel:${place.phone.replace(/\s+/g, '')}`} title={`Call ${place.name}`} aria-label={`Call ${place.name}`}>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                          Call
                        </a>
                      ) : (
                        <span class="btn-phone disabled">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                          No Phone
                        </span>
                      )}
                      <a class="btn-maps" href={place.googleMapsUrl} target="_blank" rel="noopener noreferrer" aria-label={`${place.name} on Google Maps`}>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                        Maps ↗
                      </a>
                      <a class="btn-detail" href={`/places/${place.category}/${place.slug}/`} aria-label={`View details for ${place.name}`}>Details</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
          <p class="no-results" id="no-results" hidden>No places match your search.</p>
        </div>
      </section>

      <!-- Map Context -->
      <section class="map-context-section">
        <div class="container">
          <div class="map-context-inner">
            <div class="map-context-text">
              <p class="section-kicker"><span></span> Location</p>
              <h2>{sectorMeta.label} — Sector Map</h2>
              <p>View the exact position and boundaries of {sectorMeta.label} within DHA Phase 6 Lahore on the official phase map.</p>
              <div class="map-coords">
                <span>Lat: {sectorMeta.lat.toFixed(4)}</span>
                <span>Lng: {sectorMeta.lng.toFixed(4)}</span>
              </div>
              <div class="map-context-actions">
                <a
                  href={`https://www.google.com/maps/@${sectorMeta.lat},${sectorMeta.lng},17z`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-gold"
                >Open in Google Maps ↗</a>
                <a href="/dha-phase-6-lahore-map/" class="btn-outline">Official Phase 6 Map PDF</a>
              </div>
            </div>
            <div class="map-embed-box">
              <iframe
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src={`https://www.google.com/maps/embed/v1/view?key=AIzaSyD-9tSrke72PouQMnMX-a7eZSW0jkFMBWY&center=${sectorMeta.lat},${sectorMeta.lng}&zoom=16&maptype=roadmap`}
                title={`Map showing ${sectorMeta.label} DHA Phase 6 Lahore`}
                style="width:100%;height:100%;border:0;"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <!-- Nearby Sectors -->
      {nearbySectors.length > 0 && (
        <section class="nearby-section">
          <div class="container">
            <p class="section-kicker"><span></span> Compare sectors</p>
            <h2>Explore Nearby Sectors</h2>
            <div class="nearby-grid">
              {nearbySectors.map((sector) => (
                <a href={`/sectors/${sector.key}/places/`} class="nearby-card">
                  <strong>{sector.label}</strong>
                  <span>Facilities Guide →</span>
                </a>
              ))}
            </div>
            <div class="nearby-all">
              <a href="/sectors/" class="btn-outline">View All Sectors Guide</a>
              <a href="/places/" class="btn-outline">Complete Places Directory</a>
            </div>
          </div>
        </section>
      )}

      <!-- FAQ -->
      <section class="faq-section" id="faq">
        <div class="container">
          <p class="section-kicker"><span></span> Common questions</p>
          <h2>{sectorMeta.label} Facilities — FAQ</h2>
          <div class="faq-list">
            {faqs.map((faq, i) => (
              <details class="faq-item" id={`faq-${i + 1}`}>
                <summary>{faq.q}</summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Internal Linking Hub -->
      <section class="links-hub-section">
        <div class="container">
          <div class="links-hub-grid">
            <div class="links-hub-card">
              <h3>Property Directory</h3>
              <p>View market snapshot prices and plot information for {sectorMeta.label}.</p>
              <a href={`/sectors/${sectorMeta.key}/`} class="link-hub-btn">
                {sectorMeta.label} Property Guide →
              </a>
            </div>
            <div class="links-hub-card">
              <h3>All Sectors Guide</h3>
              <p>Compare all 13 residential sectors and 4 commercial zones of DHA Phase 6 Lahore.</p>
              <a href="/sectors/" class="link-hub-btn">View All Sectors →</a>
            </div>
            <div class="links-hub-card">
              <h3>Investment Guide</h3>
              <p>Understand buying costs, possession checks, and due diligence steps before investing.</p>
              <a href="/investment-guide/" class="link-hub-btn">Read Investment Guide →</a>
            </div>
            <div class="links-hub-card">
              <h3>Complete Places Directory</h3>
              <p>Browse 396+ verified places across all sectors and categories in DHA Phase 6.</p>
              <a href="/places/" class="link-hub-btn">Browse All Places →</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <aside class="publication">
      <div class="container">
        <span>Published September 2026</span>
        <span>Business information sourced from public Google Maps records. Verify details before visiting.</span>
      </div>
    </aside>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/"><span>D6</span><strong>DHA Phase 6 Lahore</strong></a>
          <p>An independent local guide to sectors, properties, maps, places, services and everyday life across DHA Phase 6 Lahore.</p>
        </div>
        <div>
          <h2>Pages</h2>
          <a href="/">Home</a><a href="/sectors/">Sectors</a>
          <a href="/properties/">Property Listings</a><a href="/plots/">Plots</a>
          <a href="/places/">Places &amp; Services</a><a href="/jobs/">Jobs</a>
          <a href="/faq/">FAQ</a><a href="/sitemap/">Sitemap</a>
        </div>
        <div>
          <h2>Sectors</h2>
          {SECTORS_DIRECTORY.filter(s => s.type === 'residential').map(s => (
            <a href={`/sectors/${s.key}/places/`}>{s.label} Places</a>
          ))}
        </div>
        <div>
          <h2>Useful links</h2>
          <a href="/dha-phase-6-lahore-map/">Phase 6 Map</a>
          <a href="/helplines/">Helplines</a>
          <a href="/postal-code/">Postal Code</a>
          <a href="/weather/">Weather</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/disclaimer/">Disclaimer</a>
        </div>
      </div>
      <div class="container footer-bottom">© 2026 DHA Phase 6 Lahore Guide. All rights reserved.</div>
    </footer>
    <a class="back-top" href="#main-content" aria-label="Back to top">↑</a>

    <script>
      // Filter tabs
      const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.business-card'));
      const countEl = document.querySelector<HTMLElement>('#result-count');
      const emptyEl = document.querySelector<HTMLElement>('#no-results');
      const searchEl = document.querySelector<HTMLInputElement>('#business-search');
      const sortEl = document.querySelector<HTMLSelectElement>('#business-sort');

      let activeFilter = 'all';
      let activeQuery = '';

      function applyFilters() {
        let visible = cards.filter(card => {
          const cat = card.dataset.category || '';
          const name = card.dataset.name || '';
          const addr = card.dataset.address || '';
          const matchesCat = activeFilter === 'all' || (() => {
            const activeTab = document.querySelector<HTMLButtonElement>(`[data-filter="${activeFilter}"]`);
            const cats = activeTab?.dataset.cats?.split(',') || [];
            return cats.includes(cat);
          })();
          const matchesQuery = !activeQuery || `${name} ${addr}`.includes(activeQuery);
          return matchesCat && matchesQuery;
        });
        cards.forEach(c => { c.hidden = !visible.includes(c); });
        // Sort
        const grid = document.querySelector<HTMLElement>('#business-grid');
        if (grid && sortEl) {
          visible.sort((a, b) => {
            if (sortEl.value === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
            const key = sortEl.value === 'rating' ? 'rating' : 'reviews';
            return Number(b.dataset[key]) - Number(a.dataset[key]);
          });
          visible.forEach(c => grid.append(c));
        }
        if (countEl) countEl.textContent = String(visible.length);
        if (emptyEl) emptyEl.hidden = visible.length > 0;
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          activeFilter = tab.dataset.filter || 'all';
          applyFilters();
        });
      });
      searchEl?.addEventListener('input', () => { activeQuery = searchEl.value.trim().toLowerCase(); applyFilters(); });
      sortEl?.addEventListener('change', applyFilters);

      // Nav toggle
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const navLinks = document.querySelector<HTMLElement>('#nav-links');
      toggle?.addEventListener('click', () => {
        const open = navLinks?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    </script>
  </body>
</html>

<style is:global>
