---
/**
 * DHA Phase 6 Lahore — Sector Specific Places Category Page
 * Handles /sectors/[sector]/places/[category]/ (e.g. /sectors/sector-a/places/bakery/)
 */
import { PLACE_CATEGORIES, PLACES_DATA, type PlaceCategoryMeta } from '@data/places';

export function getStaticPaths() {
  const sectors = [
    { key: 'sector-a', label: 'Sector A' },
    { key: 'sector-b', label: 'Sector B' },
    { key: 'sector-c', label: 'Sector C' },
    { key: 'sector-d', label: 'Sector D' },
    { key: 'sector-e', label: 'Sector E' },
    { key: 'sector-f', label: 'Sector F' },
    { key: 'sector-g', label: 'Sector G' },
    { key: 'sector-h', label: 'Sector H' },
    { key: 'sector-j', label: 'Sector J' },
    { key: 'sector-k', label: 'Sector K' },
    { key: 'sector-l', label: 'Sector L' },
    { key: 'sector-m', label: 'Sector M' },
    { key: 'sector-n', label: 'Sector N' },
  ];

  const paths = [];

  for (const sec of sectors) {
    for (const cat of PLACE_CATEGORIES) {
      paths.push({
        params: { sector: sec.key, category: cat.key },
        props: { sectorMeta: sec, categoryMeta: cat },
      });
    }
  }

  return paths;
}

interface Props {
  sectorMeta: { key: string; label: string };
  categoryMeta: PlaceCategoryMeta;
}

const { sectorMeta, categoryMeta } = Astro.props;

// Filter matching places in this sector or fallback
const places = PLACES_DATA.filter(
  (p) => p.category === categoryMeta.key && (p.block?.toLowerCase() === sectorMeta.label.toLowerCase() || p.address.toLowerCase().includes(sectorMeta.label.toLowerCase()))
);
---

<!DOCTYPE html>
<html lang="en-PK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a1a">

  <!-- SEO -->
  <title>{categoryMeta.label} in {sectorMeta.label} DHA Phase 6 Lahore</title>
  <meta name="description" content={`Explore ${categoryMeta.label.toLowerCase()} facilities, locations, and directions in ${sectorMeta.label}, DHA Phase 6 Lahore.`}>
  <meta name="keywords" content={`${categoryMeta.label}, ${sectorMeta.label}, DHA Phase 6 Lahore, Phase 6 places`}>
  <meta name="author" content="DHA Phase 6 Lahore Guide">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

  <!-- Open Graph -->
  <meta property="og:title" content={`${categoryMeta.label} in ${sectorMeta.label} DHA Phase 6 Lahore`}>
  <meta property="og:description" content={`Explore ${categoryMeta.label.toLowerCase()} facilities in ${sectorMeta.label}, DHA Phase 6 Lahore.`}>
  <meta property="og:type" content="website">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'&gt;&lt;rect width='100' height='100' rx='16' fill='%23d4a844'/&gt;&lt;text x='50' y='66' font-size='48' text-anchor='middle' font-family='serif' font-weight='bold' fill='%230a0a1a'&gt;D6&lt;/text&gt;&lt;/svg&gt;">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <!-- Header -->
  <header class="site-header">
    <nav class="navbar" id="navbar" aria-label="Primary navigation">
      <div class="container">
        <a href="/" class="nav-logo" aria-label="DHA Phase 6 Lahore home">
          <div class="nav-logo-icon">D6</div>
          DHA Phase <span>6</span> Lahore
        </a>
        <div class="nav-links" id="navLinks">
          <a href="/">Home</a>
          <a href="/sectors/">Sectors</a>
          <a href="/properties/">Properties</a>
          <a href="/places/" class="active" aria-current="page">Places</a>
          <a href="/plots/">Plots</a>
          <a href="/jobs/">Jobs</a>
          <a href="/dealers/">Dealers</a>
          <a href="/dha-phase-6-lahore-map/">Map</a>
          <a href="/dha-phase-6-lahore-map/#map-pdf-downloads" class="nav-cta">Map PDFs</a>
        </div>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <!-- Hero -->
    <header class="page-hero">
      <div class="container">
        <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/places/">Places</a>
          <span class="breadcrumb-sep">›</span>
          <a href={`/places/${categoryMeta.key}/`}>{categoryMeta.label}</a>
          <span class="breadcrumb-sep">›</span>
          <span aria-current="page">{sectorMeta.label}</span>
        </nav>
        <h1><span class="gold">{categoryMeta.label}</span> in {sectorMeta.label}</h1>
        <p class="page-hero-description">Find {categoryMeta.label.toLowerCase()} facilities, nearby commercial plaza access, and directions for residents in {sectorMeta.label}, DHA Phase 6 Lahore.</p>
      </div>
    </header>

    <!-- Places Content Section -->
    <section class="content-section bg-primary">
      <div class="container">
        {places.length > 0 ? (
          <div class="cat-grid">
            {places.map((place) => (
              <article class="place-card glass-card">
                <span class="place-tag">{place.categoryLabel} • {sectorMeta.label}</span>
                <h2>
                  <a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a>
                </h2>
                <p class="place-meta">{place.distance} • {place.travelTime}</p>
                <p class="place-desc">{place.description}</p>
                <ul class="place-features">
                  {place.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
                <div class="place-actions">
                  <a
                    class="map-link"
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.name + ' ' + sectorMeta.label + ' DHA Phase 6 Lahore')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open Live Google Map ↗
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="category-overview-card glass-card">
            <h2>{categoryMeta.label} in {sectorMeta.label}</h2>
            <p>Residents of {sectorMeta.label} have convenient access to {categoryMeta.label.toLowerCase()} services located in nearby CCA 1 (Sector C), CCA 2 (Sector J), and Main Boulevard commercial zones.</p>
            
            <div style="margin-top: 24px;">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(categoryMeta.label + ' ' + sectorMeta.label + ' DHA Phase 6 Lahore')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                Search {categoryMeta.label} in {sectorMeta.label} on Google Maps ↗
              </a>
            </div>
          </div>
        )}

        <div style="margin-top: 48px; text-align: center; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
          <a href={`/places/${categoryMeta.key}/`} class="job-back-link">
            ← View All {categoryMeta.label} in Phase 6
          </a>
          <a href={`/sectors/${sectorMeta.key}/`} class="job-back-link">
            View {sectorMeta.label} Sector Guide →
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer" id="footer">
    <div class="container">
      <div class="footer-bottom">
        <div class="footer-copyright">&copy; 2026 DHA Phase 6 Lahore Guide. All rights reserved.</div>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --clr-bg-primary: #0a0a1a;
    --clr-bg-secondary: #111128;
    --clr-accent-gold: #d4a844;
    --clr-accent-gold-light: #f0c95c;
    --clr-text-primary: #f0f0f5;
    --clr-text-secondary: #9a9ab5;
    --clr-text-muted: #6a6a85;
    --clr-glass: rgba(255, 255, 255, 0.04);
    --clr-glass-border: rgba(255, 255, 255, 0.08);
    --grad-gold: linear-gradient(135deg, #d4a844, #f0c95c);
    --ff-heading: 'Inter', sans-serif;
    --ff-body: 'Inter', sans-serif;
  }
  body {
    background-color: var(--clr-bg-primary);
    color: var(--clr-text-primary);
    font-family: var(--ff-body);
    line-height: 1.7;
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .glass-card {
    background: var(--clr-glass);
    border: 1px solid var(--clr-glass-border);
    border-radius: 12px;
    backdrop-filter: blur(14px);
  }
  .page-hero {
    padding: 140px 0 50px;
    background: var(--clr-bg-secondary);
    border-bottom: 1px solid var(--clr-glass-border);
    text-align: center;
  }
  .page-hero-breadcrumb {
    color: var(--clr-text-muted);
    font-size: 0.85rem;
    margin-bottom: 16px;
  }
  .page-hero h1 {
    font-family: var(--ff-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin-bottom: 12px;
  }
  .gold {
    background: var(--grad-gold);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-hero-description {
    color: var(--clr-text-secondary);
    max-width: 650px;
    margin: 0 auto;
  }
  .content-section {
    padding: 60px 0;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .place-card {
    padding: 28px;
  }
  .place-tag {
    color: var(--clr-accent-gold);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .place-card h2 {
    font-family: var(--ff-heading);
    font-size: 1.35rem;
    margin: 8px 0;
  }
  .place-card h2 a:hover {
    color: var(--clr-accent-gold);
  }
  .place-meta {
    color: var(--clr-text-muted);
    font-size: 0.82rem;
    margin-bottom: 12px;
  }
  .place-desc {
    color: var(--clr-text-secondary);
    font-size: 0.92rem;
  }
  .place-features {
    margin: 14px 0;
    padding-left: 20px;
    color: var(--clr-text-secondary);
    font-size: 0.88rem;
  }
  .map-link {
    display: inline-block;
    color: var(--clr-accent-gold);
    font-weight: 700;
    font-size: 0.88rem;
  }
  .category-overview-card {
    padding: 32px;
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
  }
  .category-overview-card h2 {
    color: var(--clr-accent-gold);
    margin-bottom: 12px;
    font-family: var(--ff-heading);
  }
  .btn-primary {
    background: var(--grad-gold);
    color: #0a0a1a;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 8px;
    display: inline-block;
  }
  .job-back-link {
    display: inline-block;
    padding: 10px 20px;
    color: var(--clr-accent-gold);
    border: 1px solid var(--clr-glass-border);
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 700;
  }
  .site-header {
    position: relative;
    z-index: 1000;
  }
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(10, 10, 26, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--clr-glass-border);
    padding: 14px 0;
  }
  .navbar .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .nav-logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--grad-gold);
    color: #0a0a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }
  .nav-links {
    display: flex;
    gap: 24px;
  }
  .nav-links a {
    color: var(--clr-text-secondary);
    font-size: 0.9rem;
  }
  .nav-links a.active {
    color: var(--clr-accent-gold);
  }
  .nav-cta {
    background: var(--grad-gold) !important;
    color: #0a0a1a !important;
    padding: 8px 18px !important;
    border-radius: 8px;
    font-weight: 700 !important;
  }
  .footer-bottom {
    border-top: 1px solid var(--clr-glass-border);
    padding: 24px 0;
    text-align: center;
    color: var(--clr-text-muted);
    font-size: 0.82rem;
  }
  @media (max-width: 768px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
