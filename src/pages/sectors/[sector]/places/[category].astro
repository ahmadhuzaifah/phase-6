---
import {
  PLACE_CATEGORIES,
  SECTORS_DIRECTORY,
  getSectorCategoryPlaces,
  getCategorySectors,
  getPopulatedSectorCategoryPairs,
  getPlaceImage,
  type SectorMeta,
} from '@data/places/index';
import type { PlaceCategoryMeta } from '@data/places';
import PlaceImage from '@components/places/PlaceImage.astro';
import { SITE } from '@data/site';

export function getStaticPaths() {
  const populatedPairs = getPopulatedSectorCategoryPairs();
  return populatedPairs.map(({ sector, category }) => ({
    params: { sector: sector.key, category: category.key },
    props: { sectorMeta: sector, categoryMeta: category },
  }));
}

interface Props {
  sectorMeta: SectorMeta;
  categoryMeta: PlaceCategoryMeta;
}

const { sectorMeta, categoryMeta } = Astro.props as Props;
const places = getSectorCategoryPlaces(sectorMeta.key, categoryMeta.key);
const canonical = `${SITE.url}/sectors/${sectorMeta.key}/places/${categoryMeta.key}/`;
const pageTitle = `${categoryMeta.label} in ${sectorMeta.label} DHA Phase 6 Lahore`;
const description = `A focused local guide to ${categoryMeta.label.toLowerCase()} businesses and services in ${sectorMeta.label}, DHA Phase 6 Lahore.`;

// Only link to sectors that actually have places in this category
const nearbySectors = getCategorySectors(categoryMeta.key)
  .filter((s) => s.sector.key !== sectorMeta.key)
  .map((s) => s.sector);

// Only link to categories that actually have places in this sector
const relatedCategories = PLACE_CATEGORIES.filter(
  (c) => getSectorCategoryPlaces(sectorMeta.key, c.key).length > 0 && c.key !== categoryMeta.key
);

const publishedDate = places[0]?.retrievedAt || '2026-09-03';
const formattedDate = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' }).format(new Date(`${publishedDate}T12:00:00`));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: 'en-PK',
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Sectors', item: `${SITE.url}/sectors/` },
        { '@type': 'ListItem', position: 3, name: sectorMeta.label, item: `${SITE.url}/sectors/${sectorMeta.key}/` },
        { '@type': 'ListItem', position: 4, name: 'Places', item: `${SITE.url}/places/` },
        { '@type': 'ListItem', position: 5, name: categoryMeta.label, item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#directory`,
      name: pageTitle,
      numberOfItems: places.length,
      itemListElement: places.map((place, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'LocalBusiness',
          '@id': `${SITE.url}/places/${place.category}/${place.slug}/`,
          name: place.name,
          url: `${SITE.url}/places/${place.category}/${place.slug}/`,
          image: getPlaceImage(place).src,
          ...(place.phone ? { telephone: place.phone } : {}),
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            postalCode: '54792',
            addressCountry: 'PK',
          },
          ...(place.rating && place.reviewCount > 0 ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: place.rating,
              reviewCount: place.reviewCount,
              bestRating: 5,
            },
          } : {}),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en-PK">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a1a" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} /><meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header"><nav class="navbar" aria-label="Primary navigation"><div class="container nav-inner">
      <a href="/" class="nav-logo" aria-label="DHA Phase 6 Lahore home"><span>D6</span><strong>DHA Phase <b>6</b> Lahore</strong></a>
      <div class="nav-links" id="nav-links"><a href="/">Home</a><a href="/sectors/">Sectors</a><a href="/properties/">Properties</a><a href="/places/" class="active">Places</a><a href="/plots/">Plots</a><a href="/jobs/">Jobs</a><a href="/dealers/">Dealers</a><a href="/dha-phase-6-lahore-map/">Map</a><a href="/dha-phase-6-lahore-map/#map-pdf-downloads" class="nav-cta">Map PDFs</a></div>
      <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="Open navigation"><span></span><span></span><span></span></button>
    </div></nav></header>

    <main id="main-content">
      <header class="page-hero"><div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/sectors/">Sectors</a><span>/</span><a href={`/sectors/${sectorMeta.key}/`}>{sectorMeta.label}</a><span>/</span><a href="/places/">Places</a><span>/</span><span aria-current="page">{categoryMeta.label}</span></nav>
        <h1>{categoryMeta.label} in {sectorMeta.label} DHA Phase 6 Lahore</h1><p>{description}</p>
      </div></header>

      <section class="directory-section"><div class="container">
        <div class="directory-toolbar">
          <div><p class="section-kicker"><span></span> Local directory</p><h2>{categoryMeta.label} in {sectorMeta.label}</h2><p><strong id="result-count">{places.length}</strong> {places.length === 1 ? 'business' : 'businesses'} in DHA Phase 6 Lahore</p></div>
          <div class="directory-controls"><label>Search businesses<input id="business-search" type="search" placeholder="Search by name or address" /></label><label>Sort results<select id="business-sort"><option value="reviews">Most reviewed</option><option value="rating">Highest rated</option><option value="name">Name A-Z</option></select></label></div>
        </div>

        {places.length > 0 ? (
          <div class="business-grid" id="business-grid">{places.map((place) => (
            <article class="business-card" data-name={place.name.toLowerCase()} data-address={place.address.toLowerCase()} data-rating={place.rating || 0} data-reviews={place.reviewCount}>
              <a class="business-photo" href={`/places/${place.category}/${place.slug}/`}>
                <PlaceImage place={place} />
              </a>
              <div class="business-body">
                <div class="business-tags">
                  <span>{categoryMeta.label}</span>
                  <span>{sectorMeta.label}</span>
                </div>
                <h3><a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a></h3>
                <div class="business-rating">
                  {place.rating ? (
                    <>
                      <span aria-label={`${place.rating} out of 5 stars`}>★</span>
                      <strong>{place.rating.toFixed(1)}</strong>
                      <small>{place.reviewCount > 0 ? `${place.reviewCount.toLocaleString('en-PK')} reviews` : 'Google rating'}</small>
                    </>
                  ) : (
                    <small>Rating not shown</small>
                  )}
                </div>
                <address>{place.address}</address>
                <div class="business-chips"><span>{categoryMeta.label}</span>{place.phone && <span>{place.phone}</span>}</div>
                <div class="business-actions">
                  <a class="business-primary" href={`/places/${place.category}/${place.slug}/`}>View Details</a>
                  <a class="business-directions" href={place.googleMapsUrl} target="_blank" rel="noopener" aria-label={`Open ${place.name} in Google Maps`}>Open in Google Maps ↗</a>
                </div>
              </div>
            </article>
          ))}</div>
        ) : (
          <div class="empty-state">
            <p>Currently no verified listings available for this category. New locations will be added after verification.</p>
            <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${categoryMeta.label} in ${sectorMeta.label} DHA Phase 6 Lahore`)}`} target="_blank" rel="noopener noreferrer">Search Google Maps ↗</a>
          </div>
        )}
        <p class="no-results" id="no-results" hidden>No businesses match your search.</p>

        <section class="sector-callout"><p class="section-kicker"><span></span> {sectorMeta.label} local guide</p><h2>Explore more in {sectorMeta.label}</h2><p>Browse all sectors or return to the {sectorMeta.label} property directory.</p><div><a class="gold-button" href="/sectors/">View all sectors</a><a class="outline-button" href={`/sectors/${sectorMeta.key}/`}>View {sectorMeta.label} property directory</a></div></section>
        
        {nearbySectors.length > 0 && (
          <section class="link-section">
            <h2>Also search nearby sectors</h2>
            <div>
              {nearbySectors.map((sector) => (
                <a href={`/sectors/${sector.key}/places/${categoryMeta.key}/`}>{sector.label}</a>
              ))}
            </div>
          </section>
        )}

        {relatedCategories.length > 0 && (
          <section class="link-section">
            <h2>Related places and services</h2>
            <div>
              {relatedCategories.map((category) => (
                <a href={`/sectors/${sectorMeta.key}/places/${category.key}/`}>{category.label}</a>
              ))}
            </div>
          </section>
        )}
      </div></section>
    </main>

    <aside class="publication"><div class="container">Published {formattedDate} <span>Business information sourced from public Google Maps cards; verify details before visiting.</span></div></aside>
    <footer class="site-footer"><div class="container footer-grid">
      <div class="footer-brand"><a href="/"><span>D6</span><strong>DHA Phase 6 Lahore</strong></a><p>An independent local guide to sectors, properties, maps, places, services and everyday life across DHA Phase 6 Lahore.</p></div>
      <div><h2>Pages</h2><a href="/">Home</a><a href="/sectors/">Sectors</a><a href="/properties/">Property Listings</a><a href="/plots/">Plots</a><a href="/dealers/">Property Dealers</a><a href="/places/">Places & Services</a><a href="/jobs/">Jobs</a><a href="/faq/">FAQ</a><a href="/sitemap/">Sitemap</a></div>
      <div><h2>Sectors</h2>{SECTORS_DIRECTORY.slice(0, 9).map((sector) => <a href={`/sectors/${sector.key}/`}>{sector.label}</a>)}</div>
      <div><h2>Useful links</h2><a href="/dha-phase-6-lahore-map/">Phase 6 Map</a><a href="/helplines/">Helplines</a><a href="/postal-code/">Postal Code</a><a href="/weather/">Weather</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/disclaimer/">Disclaimer</a></div>
    </div><div class="container footer-bottom">© 2026 DHA Phase 6 Lahore Guide. All rights reserved.</div></footer>
    <a class="back-top" href="#main-content" aria-label="Back to top">↑</a>

    <script>
      const search = document.querySelector<HTMLInputElement>('#business-search');
      const sort = document.querySelector<HTMLSelectElement>('#business-sort');
      const grid = document.querySelector<HTMLElement>('#business-grid');
      const count = document.querySelector<HTMLElement>('#result-count');
      const empty = document.querySelector<HTMLElement>('#no-results');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.business-card'));
      const updateDirectory = () => {
        const query = search?.value.trim().toLowerCase() || '';
        const visible = cards.filter((card) => `${card.dataset.name} ${card.dataset.address}`.includes(query));
        cards.forEach((card) => { card.hidden = !visible.includes(card); });
        visible.sort((a, b) => {
          if (sort?.value === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          const key = sort?.value === 'rating' ? 'rating' : 'reviews';
          return Number(b.dataset[key]) - Number(a.dataset[key]);
        });
        visible.forEach((card) => grid?.append(card));
        if (count) count.textContent = String(visible.length);
        if (empty) empty.hidden = visible.length > 0;
      };
      search?.addEventListener('input', updateDirectory);
      sort?.addEventListener('change', updateDirectory);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --dir-bg: #080818;
    --dir-surface: #111125;
    --dir-surface-2: #15152d;
    --dir-gold: #10b981;
    --dir-gold-light: #34d399;
    --dir-text: #f0f0f5;
    --dir-muted: #9292ad;
    --dir-dim: #64647f;
    --dir-line: rgba(255, 255, 255, 0.09);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', sans-serif; background: var(--dir-bg); color: var(--dir-text); }
  .container { width: min(1200px, 92%); margin-inline: auto; }
  .skip-link { position: absolute; left: -999px; top: 1rem; z-index: 99; padding: .5rem 1rem; background: var(--dir-gold); color: #000; font-weight: 700; text-decoration: none; border-radius: 4px; }
  .skip-link:focus { left: 1rem; }
  .site-header { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(14px); background: rgba(8, 8, 24, .88); border-bottom: 1px solid var(--dir-line); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .nav-logo { display: inline-flex; align-items: center; gap: .6rem; color: #fff; text-decoration: none; font-size: 1.05rem; }
  .nav-logo span { width: 34px; height: 34px; border-radius: 6px; display: grid; place-items: center; background: linear-gradient(135deg, var(--dir-gold), var(--dir-gold-light)); color: #080818; font-weight: 800; font-size: .88rem; }
  .nav-logo b { color: var(--dir-gold-light); }
  .nav-links { display: flex; align-items: center; gap: 1.25rem; }
  .nav-links a { color: var(--dir-muted); text-decoration: none; font-size: .84rem; font-weight: 600; transition: color .2s; }
  .nav-links a:hover, .nav-links a.active { color: #fff; }
  .nav-cta { padding: .45rem .85rem; border-radius: 5px; background: linear-gradient(135deg, var(--dir-gold), var(--dir-gold-light)) !important; color: #080818 !important; font-weight: 700 !important; }
  .nav-toggle { display: none; background: transparent; border: 0; cursor: pointer; padding: .5rem; }
  .nav-toggle span { display: block; width: 22px; height: 2px; background: #fff; margin: 4px 0; border-radius: 1px; }

  .page-hero { padding: 72px 0 56px; background: #101024; border-bottom: 1px solid var(--dir-line); text-align: center; }
  .breadcrumb { display: flex; flex-wrap: wrap; justify-content: center; gap: .48rem; margin-bottom: 1.25rem; color: var(--dir-dim); font-size: .72rem; }
  .breadcrumb a { color: var(--dir-dim); text-decoration: none; }
  .breadcrumb a:hover { color: var(--dir-gold-light); }
  .page-hero h1 { max-width: 900px; margin: 0 auto; color: #fff; font-size: clamp(2rem, 4.7vw, 3.2rem); line-height: 1.15; letter-spacing: -.03em; font-weight: 800; }
  .page-hero p { max-width: 620px; margin: 1rem auto 0; color: var(--dir-muted); font-size: .92rem; line-height: 1.6; }

  .directory-section { padding: 64px 0 88px; }
  .directory-toolbar { display: grid; grid-template-columns: 1fr auto; gap: 2.5rem; align-items: end; margin-bottom: 1.5rem; }
  .section-kicker { display: flex; align-items: center; gap: .6rem; margin: 0 0 .75rem; color: var(--dir-gold); font-size: .64rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .section-kicker > span { width: 28px; height: 2px; background: var(--dir-gold); }
  .directory-toolbar h2, .sector-callout h2, .link-section h2 { margin: 0; color: #fff; font-size: 1.25rem; font-weight: 800; }
  .directory-toolbar > div > p:last-child { margin: .35rem 0 0; color: var(--dir-muted); font-size: .78rem; }
  .directory-controls { display: grid; grid-template-columns: 230px 145px; gap: .7rem; }
  .directory-controls label { color: var(--dir-dim); font-size: .58rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  .directory-controls input, .directory-controls select { display: block; width: 100%; height: 42px; margin-top: .35rem; padding: 0 .75rem; border: 1px solid var(--dir-line); border-radius: 6px; background: var(--dir-surface); color: var(--dir-text); font: inherit; font-size: .72rem; outline: none; }
  .directory-controls input:focus, .directory-controls select:focus { border-color: var(--dir-gold); }

  .business-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .business-card { overflow: hidden; border: 1px solid var(--dir-line); border-radius: 10px; background: var(--dir-surface); box-shadow: 0 18px 45px -35px #000; transition: transform .25s ease, border-color .25s ease; }
  .business-card:hover { border-color: rgba(212, 168, 68, .3); transform: translateY(-2px); }
  .business-card[hidden] { display: none; }
  .business-photo { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #1a1a31; }
  .business-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s; }
  .business-card:hover .business-photo img { transform: scale(1.03); }
  .business-photo > span { position: absolute; right: .55rem; bottom: .55rem; padding: .24rem .42rem; border-radius: 4px; background: rgba(8, 8, 24, .82); color: #fff; font-size: .55rem; }
  .business-body { padding: 1rem; }
  .business-tags, .business-chips { display: flex; flex-wrap: wrap; gap: .35rem; }
  .business-tags span, .business-chips span { padding: .22rem .45rem; border: 1px solid rgba(212, 168, 68, .22); border-radius: 999px; color: var(--dir-gold); font-size: .55rem; font-weight: 600; }
  .business-card h3 { margin: .62rem 0 .35rem; font-size: 1.05rem; font-weight: 700; }
  .business-card h3 a { color: #fff; text-decoration: none; }
  .business-card h3 a:hover { color: var(--dir-gold-light); }
  .business-rating { display: flex; align-items: center; gap: .3rem; font-size: .68rem; }
  .business-rating > span { color: var(--dir-gold); }
  .business-rating small { color: var(--dir-dim); }
  .business-card address { min-height: 2.6em; margin: .55rem 0; color: var(--dir-muted); font-size: .68rem; font-style: normal; line-height: 1.5; }
  .business-chips { margin: .75rem 0; }
  .business-actions { display: grid; grid-template-columns: 1fr 1.35fr; gap: .5rem; margin-top: .9rem; padding-top: .75rem; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .business-primary, .gold-button { display: inline-flex; align-items: center; justify-content: center; padding: .52rem .55rem; border-radius: 5px; background: linear-gradient(135deg, var(--dir-gold), var(--dir-gold-light)); color: #090918; font-size: .63rem; font-weight: 800; text-decoration: none; text-align: center; white-space: nowrap; }
  .business-directions { display: inline-flex; align-items: center; justify-content: center; padding: .52rem .55rem; border-radius: 5px; background: rgba(52, 152, 219, 0.12); border: 1px solid rgba(52, 152, 219, 0.3); color: #3498db; font-size: .63rem; font-weight: 800; text-decoration: none; text-align: center; white-space: nowrap; }
  .business-directions:hover { background: rgba(52, 152, 219, 0.25); border-color: #3498db; }

  .empty-state, .no-results { padding: 2.5rem; border: 1px solid var(--dir-line); border-radius: 10px; background: var(--dir-surface); text-align: center; }
  .empty-state p, .no-results { color: var(--dir-muted); font-size: .9rem; margin: 0 0 1rem; }
  .empty-state a { color: var(--dir-gold); font-weight: 800; text-decoration: none; }

  .sector-callout { margin-top: 2.5rem; padding: 1.8rem; border: 1px solid var(--dir-line); border-radius: 9px; background: var(--dir-surface); }
  .sector-callout > p:not(.section-kicker) { margin: .65rem 0 1rem; color: var(--dir-muted); font-size: .75rem; }
  .sector-callout > div { display: flex; flex-wrap: wrap; gap: .65rem; }
  .outline-button { padding: .58rem .78rem; border: 1px solid var(--dir-line); border-radius: 5px; color: #fff; font-size: .64rem; font-weight: 800; text-decoration: none; }

  .link-section { margin-top: 2rem; }
  .link-section h2 { margin-bottom: .8rem; }
  .link-section > div { display: flex; flex-wrap: wrap; gap: .4rem; }
  .link-section a { padding: .42rem .62rem; border: 1px solid var(--dir-line); border-radius: 5px; background: var(--dir-surface); color: var(--dir-muted); font-size: .62rem; text-decoration: none; }
  .link-section a:hover { border-color: rgba(212, 168, 68, .35); color: var(--dir-gold-light); }

  .publication { padding: .8rem 0; border-top: 1px solid var(--dir-line); border-bottom: 1px solid var(--dir-line); background: #0d0d21; color: var(--dir-dim); font-size: .58rem; }
  .publication .container { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  .site-footer { padding: 48px 0 28px; background: #060613; border-top: 1px solid var(--dir-line); }
  .footer-grid { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr; gap: 2rem; margin-bottom: 2rem; }
  .footer-brand p { color: var(--dir-dim); font-size: .74rem; line-height: 1.6; max-width: 320px; }
  .footer-grid h2 { color: #fff; font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 .8rem; }
  .footer-grid a { display: block; color: var(--dir-muted); text-decoration: none; font-size: .72rem; margin-bottom: .45rem; }
  .footer-grid a:hover { color: #fff; }
  .footer-bottom { color: var(--dir-dim); font-size: .65rem; border-top: 1px solid var(--dir-line); padding-top: 1.2rem; }
  .back-top { position: fixed; right: 1.2rem; bottom: 1.2rem; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: var(--dir-surface-2); border: 1px solid var(--dir-line); color: #fff; text-decoration: none; font-size: .9rem; z-index: 40; }

  @media (max-width: 900px) {
    .directory-toolbar { grid-template-columns: 1fr; }
    .business-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .page-hero { padding: 48px 0 36px; }
    .directory-section { padding: 40px 0 60px; }
    .directory-controls, .business-grid, .footer-grid { grid-template-columns: 1fr; }
    .publication .container { flex-direction: column; }
    .nav-links { display: none; }
    .nav-toggle { display: block; }
  }
</style>
