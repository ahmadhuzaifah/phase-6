---
import { PLACE_CATEGORIES, PLACES_DATA, type PlaceCategoryMeta } from '@data/places';
import googlePlaces from '@data/google-places-import.json';
import { SITE } from '@data/site';

const SECTORS = [
  { key: 'sector-a', label: 'Sector A' }, { key: 'sector-b', label: 'Sector B' },
  { key: 'sector-c', label: 'Sector C' }, { key: 'sector-d', label: 'Sector D' },
  { key: 'sector-e', label: 'Sector E' }, { key: 'sector-f', label: 'Sector F' },
  { key: 'sector-g', label: 'Sector G' }, { key: 'sector-h', label: 'Sector H' },
  { key: 'sector-j', label: 'Sector J' }, { key: 'sector-k', label: 'Sector K' },
  { key: 'sector-l', label: 'Sector L' }, { key: 'sector-m', label: 'Sector M' },
  { key: 'sector-n', label: 'Sector N' },
];

interface ImportedPlace {
  id: string; name: string; sector: string; sectorLabel: string; category: string;
  categoryLabel: string; rating: number | null; reviewCount: number; address: string;
  phone: string | null; status: string; image: string | null; googleMapsUrl: string;
  sourceQuery: string; retrievedAt: string;
}

interface DirectoryPlace extends ImportedPlace { tags: string[]; internalUrl?: string }

export function getStaticPaths() {
  const sectors = [
    { key: 'sector-a', label: 'Sector A' }, { key: 'sector-b', label: 'Sector B' },
    { key: 'sector-c', label: 'Sector C' }, { key: 'sector-d', label: 'Sector D' },
    { key: 'sector-e', label: 'Sector E' }, { key: 'sector-f', label: 'Sector F' },
    { key: 'sector-g', label: 'Sector G' }, { key: 'sector-h', label: 'Sector H' },
    { key: 'sector-j', label: 'Sector J' }, { key: 'sector-k', label: 'Sector K' },
    { key: 'sector-l', label: 'Sector L' }, { key: 'sector-m', label: 'Sector M' },
    { key: 'sector-n', label: 'Sector N' },
  ];
  return sectors.flatMap((sector) => PLACE_CATEGORIES.map((category) => ({
    params: { sector: sector.key, category: category.key },
    props: { sectorMeta: sector, categoryMeta: category },
  })));
}

interface Props { sectorMeta: { key: string; label: string }; categoryMeta: PlaceCategoryMeta }
const { sectorMeta, categoryMeta } = Astro.props as Props;
const importedPlaces = (googlePlaces as ImportedPlace[])
  .filter((place) => place.sector === sectorMeta.key && place.category === categoryMeta.key)
  .map((place): DirectoryPlace => ({
    ...place,
    tags: [categoryMeta.label, sectorMeta.label],
  }));
const existingPlaces: DirectoryPlace[] = PLACES_DATA
  .filter((place) => place.category === categoryMeta.key && (place.block?.toLowerCase() === sectorMeta.label.toLowerCase() || place.address.toLowerCase().includes(sectorMeta.label.toLowerCase())))
  .filter((place) => !importedPlaces.some((imported) => imported.name.toLowerCase() === place.name.toLowerCase()))
  .map((place) => ({
    id: place.id, name: place.name, sector: sectorMeta.key, sectorLabel: sectorMeta.label,
    category: categoryMeta.key, categoryLabel: place.categoryLabel, rating: place.rating,
    reviewCount: place.reviewCount, address: place.address, phone: place.phone || null,
    status: place.timings || 'Check current hours', image: place.images[0] || null,
    googleMapsUrl: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${place.name} ${place.address}`)}`,
    sourceQuery: `${categoryMeta.label} in ${sectorMeta.label} DHA Phase 6 Lahore`, retrievedAt: '2026-09-03',
    tags: [place.categoryLabel, sectorMeta.label], internalUrl: `/places/${place.category}/${place.slug}/`,
  }));
const places = [...importedPlaces, ...existingPlaces];
const canonical = `${SITE.url}/sectors/${sectorMeta.key}/places/${categoryMeta.key}/`;
const pageTitle = `${categoryMeta.label} in ${sectorMeta.label} DHA Phase 6 Lahore`;
const description = `A focused local guide to ${categoryMeta.label.toLowerCase()} businesses and services in ${sectorMeta.label}, DHA Phase 6 Lahore.`;
const relatedCategories = PLACE_CATEGORIES.filter((category) => category.key !== categoryMeta.key).slice(0, 10);
const nearbySectors = SECTORS.filter((sector) => sector.key !== sectorMeta.key).slice(0, 8);
const publishedDate = places[0]?.retrievedAt || '2026-09-03';
const formattedDate = new Intl.DateTimeFormat('en-PK', { dateStyle: 'long' }).format(new Date(`${publishedDate}T12:00:00`));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description,
      dateModified: publishedDate,
      inLanguage: 'en-PK',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      mainEntity: { '@id': `${canonical}#directory` },
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Sectors', item: `${SITE.url}/sectors/` },
        { '@type': 'ListItem', position: 3, name: sectorMeta.label, item: `${SITE.url}/sectors/${sectorMeta.key}/` },
        { '@type': 'ListItem', position: 4, name: 'Places', item: `${SITE.url}/places/` },
        { '@type': 'ListItem', position: 5, name: categoryMeta.label, item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#directory`,
      name: pageTitle,
      numberOfItems: places.length,
      itemListElement: places.map((place, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'LocalBusiness',
          '@id': place.internalUrl ? `${SITE.url}${place.internalUrl}` : place.googleMapsUrl,
          name: place.name,
          url: place.internalUrl ? `${SITE.url}${place.internalUrl}` : place.googleMapsUrl,
          ...(place.image ? { image: place.image } : {}),
          ...(place.phone ? { telephone: place.phone } : {}),
          address: {
            '@type': 'PostalAddress',
            streetAddress: place.address,
            addressLocality: 'Lahore',
            addressRegion: 'Punjab',
            addressCountry: 'PK',
          },
          ...(place.rating && place.reviewCount > 0 ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: place.rating,
              reviewCount: place.reviewCount,
              bestRating: 5,
            },
          } : {}),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en-PK">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a1a" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} /><meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header"><nav class="navbar" aria-label="Primary navigation"><div class="container nav-inner">
      <a href="/" class="nav-logo" aria-label="DHA Phase 6 Lahore home"><span>D6</span><strong>DHA Phase <b>6</b> Lahore</strong></a>
      <div class="nav-links" id="nav-links"><a href="/">Home</a><a href="/sectors/">Sectors</a><a href="/properties/">Properties</a><a href="/places/" class="active">Places</a><a href="/plots/">Plots</a><a href="/jobs/">Jobs</a><a href="/dealers/">Dealers</a><a href="/dha-phase-6-lahore-map/">Map</a><a href="/dha-phase-6-lahore-map/#map-pdf-downloads" class="nav-cta">Map PDFs</a></div>
      <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="Open navigation"><span></span><span></span><span></span></button>
    </div></nav></header>

    <main id="main-content">
      <header class="page-hero"><div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/sectors/">Sectors</a><span>/</span><a href={`/sectors/${sectorMeta.key}/`}>{sectorMeta.label}</a><span>/</span><a href="/places/">Places</a><span>/</span><span aria-current="page">{categoryMeta.label}</span></nav>
        <h1>{categoryMeta.label} in {sectorMeta.label} DHA Phase 6 Lahore</h1><p>{description}</p>
      </div></header>

      <section class="directory-section"><div class="container">
        <div class="directory-toolbar">
          <div><p class="section-kicker"><span></span> Local directory</p><h2>{categoryMeta.label} in {sectorMeta.label}</h2><p><strong id="result-count">{places.length}</strong> {places.length === 1 ? 'business' : 'businesses'} in DHA Phase 6 Lahore</p></div>
          <div class="directory-controls"><label>Search businesses<input id="business-search" type="search" placeholder="Search by name or address" /></label><label>Sort results<select id="business-sort"><option value="reviews">Most reviewed</option><option value="rating">Highest rated</option><option value="name">Name A-Z</option></select></label></div>
        </div>

        {places.length > 0 ? (
          <div class="business-grid" id="business-grid">{places.map((place) => (
            <article class="business-card" data-name={place.name.toLowerCase()} data-address={place.address.toLowerCase()} data-rating={place.rating || 0} data-reviews={place.reviewCount}>
              <a class="business-photo" href={place.internalUrl || place.googleMapsUrl}><img src={place.image || '/images/og/blog-og.svg'} alt={`${place.name} in ${sectorMeta.label}, DHA Phase 6 Lahore`} width="720" height="440" loading="lazy" referrerpolicy="no-referrer" />{place.image && <span>Google Maps photo</span>}</a>
              <div class="business-body"><div class="business-tags">{place.tags.map((tag) => <span>{tag}</span>)}</div><h3><a href={place.internalUrl || place.googleMapsUrl}>{place.name}</a></h3>
                <div class="business-rating">{place.rating ? <><span aria-label={`${place.rating} out of 5 stars`}>★</span><strong>{place.rating.toFixed(1)}</strong><small>{place.reviewCount > 0 ? `${place.reviewCount.toLocaleString('en-PK')} reviews` : 'Google rating'}</small></> : <small>Rating not shown</small>}</div>
                <address>{place.address}</address><div class="business-chips"><span>{categoryMeta.label}</span>{place.phone && <span>{place.phone}</span>}</div>
                <div class="business-actions"><a class="business-primary" href={place.internalUrl || place.googleMapsUrl}>View business</a><a class="business-directions" href={place.googleMapsUrl} target="_blank" rel="noopener noreferrer">Directions ↗</a></div>
              </div>
            </article>
          ))}</div>
        ) : (
          <div class="empty-state"><h3>No sourced listing is published yet</h3><p>Use the live map search to check nearby results while this directory is being verified.</p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${categoryMeta.label} in ${sectorMeta.label} DHA Phase 6 Lahore`)}`} target="_blank" rel="noopener noreferrer">Search Google Maps ↗</a></div>
        )}
        <p class="no-results" id="no-results" hidden>No businesses match your search.</p>

        <section class="sector-callout"><p class="section-kicker"><span></span> {sectorMeta.label} local guide</p><h2>Explore more in {sectorMeta.label}</h2><p>Browse all sectors or return to the {sectorMeta.label} property directory.</p><div><a class="gold-button" href="/sectors/">View all sectors</a><a class="outline-button" href={`/sectors/${sectorMeta.key}/`}>View {sectorMeta.label} property directory</a></div></section>
        <section class="link-section"><h2>Also search nearby sectors</h2><div>{nearbySectors.map((sector) => <a href={`/sectors/${sector.key}/places/${categoryMeta.key}/`}>{sector.label}</a>)}</div></section>
        <section class="link-section"><h2>Related places and services</h2><div>{relatedCategories.map((category) => <a href={`/sectors/${sectorMeta.key}/places/${category.key}/`}>{category.label}</a>)}</div></section>
      </div></section>
    </main>

    <aside class="publication"><div class="container">Published {formattedDate} <span>Business information sourced from public Google Maps cards; verify details before visiting.</span></div></aside>
    <footer class="site-footer"><div class="container footer-grid">
      <div class="footer-brand"><a href="/"><span>D6</span><strong>DHA Phase 6 Lahore</strong></a><p>An independent local guide to sectors, properties, maps, places, services and everyday life across DHA Phase 6 Lahore.</p></div>
      <div><h2>Pages</h2><a href="/">Home</a><a href="/sectors/">Sectors</a><a href="/properties/">Property Listings</a><a href="/plots/">Plots</a><a href="/dealers/">Property Dealers</a><a href="/places/">Places & Services</a><a href="/jobs/">Jobs</a><a href="/faq/">FAQ</a><a href="/sitemap/">Sitemap</a></div>
      <div><h2>Sectors</h2>{SECTORS.slice(0, 9).map((sector) => <a href={`/sectors/${sector.key}/`}>{sector.label}</a>)}</div>
      <div><h2>Useful links</h2><a href="/dha-phase-6-lahore-map/">Phase 6 Map</a><a href="/helplines/">Helplines</a><a href="/postal-code/">Postal Code</a><a href="/weather/">Weather</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/disclaimer/">Disclaimer</a></div>
    </div><div class="container footer-bottom">© 2026 DHA Phase 6 Lahore Guide. All rights reserved.</div></footer>
    <a class="back-top" href="#main-content" aria-label="Back to top">↑</a>

    <script>
      const search = document.querySelector<HTMLInputElement>('#business-search');
      const sort = document.querySelector<HTMLSelectElement>('#business-sort');
      const grid = document.querySelector<HTMLElement>('#business-grid');
      const count = document.querySelector<HTMLElement>('#result-count');
      const empty = document.querySelector<HTMLElement>('#no-results');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.business-card'));
      const updateDirectory = () => {
        const query = search?.value.trim().toLowerCase() || '';
        const visible = cards.filter((card) => `${card.dataset.name} ${card.dataset.address}`.includes(query));
        cards.forEach((card) => { card.hidden = !visible.includes(card); });
        visible.sort((a, b) => { if (sort?.value === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || ''); const key = sort?.value === 'rating' ? 'rating' : 'reviews'; return Number(b.dataset[key]) - Number(a.dataset[key]); });
        visible.forEach((card) => grid?.append(card)); if (count) count.textContent = String(visible.length); if (empty) empty.hidden = visible.length > 0;
      };
      search?.addEventListener('input', updateDirectory); sort?.addEventListener('change', updateDirectory);
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle'); const nav = document.querySelector<HTMLElement>('#nav-links');
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('open', !open); });
    </script>
  </body>
</html>

<style is:global>
  :root{--bg:#080818;--surface:#111125;--surface-2:#15152d;--gold:#d4a844;--gold-light:#f0c95c;--text:#f0f0f5;--muted:#9292ad;--dim:#64647f;--line:rgba(255,255,255,.09);font-family:'Inter',sans-serif;color-scheme:dark}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}.container{width:min(1120px,calc(100% - 40px));margin-inline:auto}.skip-link{position:fixed;left:1rem;top:-5rem;z-index:9999;padding:.7rem 1rem;background:var(--gold);color:#090918}.skip-link:focus{top:1rem}
  .navbar{position:fixed;inset:0 0 auto;z-index:1000;height:68px;background:rgba(10,10,26,.94);border-bottom:1px solid var(--line);backdrop-filter:blur(16px)}.nav-inner{display:flex;height:100%;align-items:center;justify-content:space-between}.nav-logo{display:flex;align-items:center;gap:.65rem;font-size:.88rem}.nav-logo>span{display:grid;width:32px;height:32px;place-items:center;border-radius:6px;background:linear-gradient(135deg,var(--gold),var(--gold-light));color:#090918;font-weight:900}.nav-logo strong{font-weight:800}.nav-logo b{color:var(--gold)}.nav-links{display:flex;align-items:center;gap:1.25rem}.nav-links>a{padding:.6rem 0;color:var(--muted);font-size:.72rem;font-weight:600}.nav-links>a:hover,.nav-links>a.active{color:#fff}.nav-links>a.active{border-bottom:2px solid var(--gold)}.nav-links .nav-cta{padding:.66rem 1rem;border-radius:6px;background:linear-gradient(135deg,var(--gold),var(--gold-light));color:#090918;font-weight:800}.nav-toggle{display:none;width:40px;height:40px;padding:8px;border:1px solid var(--line);background:transparent}.nav-toggle span{display:block;height:2px;margin:5px 0;background:#fff}
  .page-hero{padding:150px 0 72px;background:#101024;border-bottom:1px solid var(--line);text-align:center}.breadcrumb{display:flex;flex-wrap:wrap;justify-content:center;gap:.48rem;margin-bottom:1.25rem;color:var(--dim);font-size:.7rem}.breadcrumb a:hover{color:var(--gold-light)}.page-hero h1{max-width:900px;margin:0 auto;color:#fff;font-size:clamp(2rem,4.7vw,3.5rem);line-height:1.1;letter-spacing:-.04em}.page-hero p{max-width:620px;margin:1rem auto 0;color:var(--muted);font-size:.92rem}
  .directory-section{padding:74px 0 88px}.directory-toolbar{display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:end;margin-bottom:1.5rem}.section-kicker{display:flex;align-items:center;gap:.6rem;margin:0 0 .75rem;color:var(--gold);font-size:.64rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.section-kicker>span{width:28px;height:2px;background:var(--gold)}.directory-toolbar h2,.sector-callout h2,.link-section h2{margin:0;color:#fff;font-size:1.25rem}.directory-toolbar>div>p:last-child{margin:.35rem 0 0;color:var(--muted);font-size:.78rem}.directory-controls{display:grid;grid-template-columns:230px 145px;gap:.7rem}.directory-controls label{color:var(--dim);font-size:.56rem;font-weight:800;text-transform:uppercase}.directory-controls input,.directory-controls select{display:block;width:100%;height:42px;margin-top:.35rem;padding:0 .75rem;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--text);font:inherit;font-size:.72rem;outline:none}.directory-controls input:focus,.directory-controls select:focus{border-color:var(--gold)}
  .business-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;align-items:start}.business-card{overflow:hidden;border:1px solid var(--line);border-radius:10px;background:var(--surface);box-shadow:0 18px 45px -35px #000}.business-card[hidden]{display:none}.business-photo{position:relative;display:block;aspect-ratio:16/10;overflow:hidden;background:#1a1a31}.business-photo img{width:100%;height:100%;object-fit:cover;transition:transform .35s}.business-card:hover .business-photo img{transform:scale(1.025)}.business-photo>span{position:absolute;right:.55rem;bottom:.55rem;padding:.24rem .42rem;border-radius:4px;background:rgba(8,8,24,.82);color:#fff;font-size:.55rem}.business-body{padding:1rem}.business-tags,.business-chips{display:flex;flex-wrap:wrap;gap:.35rem}.business-tags span,.business-chips span{padding:.22rem .4rem;border:1px solid rgba(212,168,68,.22);border-radius:999px;color:var(--gold);font-size:.54rem}.business-card h3{margin:.62rem 0 .35rem;font-size:1rem}.business-card h3 a:hover{color:var(--gold-light)}.business-rating{display:flex;align-items:center;gap:.3rem;font-size:.68rem}.business-rating>span{color:var(--gold)}.business-rating small{color:var(--dim)}.business-card address{min-height:2.6em;margin:.55rem 0;color:var(--muted);font-size:.67rem;font-style:normal;line-height:1.5}.business-chips{margin:.75rem 0}.business-chips span{border-color:var(--line);color:var(--dim)}.business-actions{display:flex;align-items:center;justify-content:space-between;gap:.65rem;margin-top:.9rem}.business-primary,.gold-button{padding:.6rem .78rem;border-radius:5px;background:linear-gradient(135deg,var(--gold),var(--gold-light));color:#090918;font-size:.64rem;font-weight:800}.business-directions{color:#2ecc71;font-size:.62rem;font-weight:800}.empty-state,.no-results{padding:2rem;border:1px solid var(--line);border-radius:10px;background:var(--surface);text-align:center}.empty-state h3{margin:0}.empty-state p{color:var(--muted)}.empty-state a{color:var(--gold);font-weight:800}.no-results{color:var(--muted)}
  .sector-callout{margin-top:2.5rem;padding:1.8rem;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.sector-callout>p:not(.section-kicker){margin:.65rem 0 1rem;color:var(--muted);font-size:.75rem}.sector-callout>div{display:flex;flex-wrap:wrap;gap:.65rem}.outline-button{padding:.58rem .78rem;border:1px solid var(--line);border-radius:5px;color:#fff;font-size:.64rem;font-weight:800}.link-section{margin-top:2rem}.link-section h2{margin-bottom:.8rem}.link-section>div{display:flex;flex-wrap:wrap;gap:.4rem}.link-section a{padding:.42rem .62rem;border:1px solid var(--line);border-radius:5px;background:var(--surface);color:var(--muted);font-size:.6rem}.link-section a:hover{border-color:rgba(212,168,68,.35);color:var(--gold-light)}
