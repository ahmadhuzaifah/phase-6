---
/**
 * Route: /sectors/[sector]/properties/
 * DHA Phase 6 Lahore — Sector Property & Investment Guide
 * Generates an in-depth property intelligence page for each sector.
 */
import PageLayout from '@layouts/PageLayout.astro';
import PlaceImage from '@components/places/PlaceImage.astro';
import {
  SECTORS_DIRECTORY,
  getSectorPlaces,
  type SectorMeta,
} from '@data/places/index';
import { BLOCKS } from '@data/blocks';
import propertiesRaw from '@data/properties-import.json';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return SECTORS_DIRECTORY.map((sector) => ({
    params: { sector: sector.key },
    props: { sectorMeta: sector },
  }));
}

interface Props {
  sectorMeta: SectorMeta;
}

const { sectorMeta } = Astro.props as Props;

// Find block details if available
const block = BLOCKS.find((b) => b.slug === sectorMeta.key);
const sectorPlaces = getSectorPlaces(sectorMeta.key);

// Filter matched properties
const sectorProperties = (propertiesRaw as any[]).filter((prop) => {
  return (
    prop.block?.toLowerCase().includes(sectorMeta.label.toLowerCase()) ||
    prop.location?.address?.toLowerCase().includes(sectorMeta.label.toLowerCase())
  );
});

// Fallback nearby properties if none in this exact sector
const otherProperties = (propertiesRaw as any[])
  .filter((prop) => !sectorProperties.some((sp) => sp.id === prop.id))
  .slice(0, Math.max(0, 3 - sectorProperties.length));

const displayedProperties = [...sectorProperties, ...otherProperties].slice(0, 3);

// Categorize top places for quick amenity preview
const schools = sectorPlaces.filter((p) => p.category === 'schools' || p.category === 'colleges').slice(0, 2);
const healthcare = sectorPlaces.filter((p) => ['hospital', 'clinic', 'pharmacy'].includes(p.category)).slice(0, 2);
const dining = sectorPlaces.filter((p) => ['restaurants', 'cafes', 'fast-food'].includes(p.category)).slice(0, 2);
const mosques = sectorPlaces.filter((p) => p.category === 'mosque').slice(0, 2);
const previewPlaces = [...schools, ...healthcare, ...dining, ...mosques].slice(0, 6);

const canonical = `${SITE.url}/sectors/${sectorMeta.key}/properties/`;
const pageTitle = `${sectorMeta.label} Property & Investment Guide — DHA Phase 6 Lahore`;
const metaTitle = `${sectorMeta.label} Properties for Sale & Investment | DHA Phase 6 Lahore`;
const description = `In-depth property analysis for ${sectorMeta.label}, DHA Phase 6 Lahore. Plot sizes (${block?.plotSizes.join(', ') || '1 Kanal, 2 Kanal'}), asking prices, nearby amenities, and buyer due diligence.`;

const faqs = [
  {
    question: `What plot sizes and property formats are available in ${sectorMeta.label}?`,
    answer: `${sectorMeta.label} primarily features ${block?.plotSizes.join(', ') || '1 Kanal residential plots and luxury houses'}. The sector is known for ${block?.locationHighlight || 'its prime location in DHA Phase 6 Lahore'}.`,
  },
  {
    question: `Is ${sectorMeta.label} fully possession-ready with completed utilities?`,
    answer: `Yes. ${sectorMeta.label} in DHA Phase 6 Lahore is fully developed with underground electricity, sewerage lines, water supply infrastructure, and street carpet roads. Building plans can be submitted to DHA Lahore immediately upon property transfer.`,
  },
  {
    question: `What amenities and facilities are located within ${sectorMeta.label}?`,
    answer: `${sectorMeta.label} boasts ${sectorPlaces.length} verified local facilities including sector mosques, parks, schools, healthcare clinics, and shopping centers. Browse the complete ${sectorMeta.label} Facilities Guide for detailed contact information.`,
  },
  {
    question: `How do asking prices in ${sectorMeta.label} compare with other DHA Phase 6 sectors?`,
    answer: `Property values in ${sectorMeta.label} vary by street width, corner vs standard status, park proximity, and boulevard access. Always cross-reference asking prices with multiple recent transactions and obtain verified DHA transfer data before placing an earnest deposit.`,
  },
  {
    question: `What are the mandatory steps to buy a plot or house in ${sectorMeta.label}?`,
    answer: `Step 1: Verify the physical plot number against the official DHA Phase VI map. Step 2: Confirm ownership and obtain a DHA No Demand Certificate (NDC). Step 3: Clear all applicable transfer taxes and municipal dues. Step 4: Execute the transfer exclusively at the DHA Lahore Main Office.`,
  },
];

const propertySchemas = sectorProperties.map((prop) => ({
  '@type': 'RealEstateListing',
  '@id': `${SITE.url}/properties/${prop.slug}/`,
  name: prop.title,
  url: `${SITE.url}/properties/${prop.slug}/`,
  description: prop.description,
  offers: {
    '@type': 'Offer',
    price: prop.price,
    priceCurrency: prop.currency || 'PKR',
    availability: 'https://schema.org/InStock',
  },
}));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description: description,
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Sectors', item: `${SITE.url}/sectors/` },
        { '@type': 'ListItem', position: 3, name: sectorMeta.label, item: `${SITE.url}/sectors/${sectorMeta.key}/` },
        { '@type': 'ListItem', position: 4, name: 'Property Guide', item: canonical },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    ...propertySchemas,
  ],
};
---

<PageLayout title={metaTitle} description={description} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <!-- HERO SECTION -->
  <header class="prop-hero">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span>
        <a href="/sectors/">Sectors</a><span>/</span>
        <a href={`/sectors/${sectorMeta.key}/`}>{sectorMeta.label}</a><span>/</span>
        <span aria-current="page">Property Guide</span>
      </nav>
      <div class="hero-badge">{sectorMeta.label} Property Intelligence</div>
      <h1>{sectorMeta.label} Property &amp; Investment Guide</h1>
      <p class="hero-lead">
        Comprehensive real estate market intelligence for {sectorMeta.label}, DHA Phase 6 Lahore. Compare plot sizes, asking-price trends, nearby amenities, and essential due diligence.
      </p>

      <div class="hero-stats-row">
        <div class="stat-pill">
          <strong>{block?.plotSizes?.join(', ') || '1K, 2K'}</strong>
          <span>Plot Sizes</span>
        </div>
        <div class="stat-pill">
          <strong>{sectorPlaces.length}</strong>
          <span>Verified Places</span>
        </div>
        <div class="stat-pill">
          <strong>{sectorMeta.type === 'residential' ? 'Residential' : 'Commercial'}</strong>
          <span>Zoning Category</span>
        </div>
        <div class="stat-pill">
          <strong>100%</strong>
          <span>Possession &amp; Utilities</span>
        </div>
      </div>
    </div>
  </header>

  <!-- OVERVIEW & MARKET INTELLIGENCE -->
  <section class="overview-section">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-content">
          <p class="section-kicker"><span></span> Sector Analysis</p>
          <h2>Real Estate Landscape in {sectorMeta.label}</h2>
          <p>
            {sectorMeta.description}
          </p>
          {block && (
            <p>
              {block.description}
            </p>
          )}
          <p>
            Whether planning to build a custom residence or evaluating long-term capital preservation, {sectorMeta.label} offers established infrastructure, wide road frontages, and underground utilities.
          </p>
          <div class="overview-highlights">
            <h3>Key Location Attributes</h3>
            <ul>
              {block?.features?.map((f) => (
                <li>
                  <span class="bullet-dot">•</span>
                  <span>{f}</span>
                </li>
              )) || (
                <>
                  <li><span class="bullet-dot">•</span><span>Prime internal road connectivity in DHA Phase 6</span></li>
                  <li><span class="bullet-dot">•</span><span>Underground electrical cabling and modern sewerage</span></li>
                  <li><span class="bullet-dot">•</span><span>Dedicated sector parks and community mosques</span></li>
                </>
              )}
            </ul>
          </div>
        </div>

        <div class="overview-sidebar-card">
          <h3>Quick Links for {sectorMeta.label}</h3>
          <p>Navigate directly between facilities, street maps, and market listings.</p>
          <div class="sidebar-links-list">
            <a href={`/sectors/${sectorMeta.key}/places/`} class="btn-gold-full">
              {sectorMeta.label} Facilities Guide ({sectorPlaces.length} Places) →
            </a>
            <a href={`/sectors/${sectorMeta.key}/`} class="btn-outline-full">
              {sectorMeta.label} Sector Profile →
            </a>
            <a href="https://www.zameen.com/Plots/Lahore_Defence__DHA__Phase_6-1448-1.html" target="_blank" rel="noopener noreferrer" class="btn-outline-full">
              Search {sectorMeta.label} on Zameen.com ↗
            </a>
            <a href="/investment-guide/" class="btn-outline-full">
              DHA Phase 6 Investment Guide →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROPERTIES AVAILABLE SECTION -->
  <section class="properties-section" id="listings">
    <div class="container">
      <div class="section-head">
        <p class="section-kicker"><span></span> Market Inventory</p>
        <h2>Properties Available in &amp; Near {sectorMeta.label}</h2>
        <p class="section-subtext">
          {sectorProperties.length > 0
            ? `Verified asking-price snapshots directly located in ${sectorMeta.label}.`
            : `Representative market snapshots in and around ${sectorMeta.label}, DHA Phase 6 Lahore.`}
        </p>
      </div>

      <div class="props-grid">
        {displayedProperties.map((prop) => {
          const isDirect = prop.block?.toLowerCase().includes(sectorMeta.label.toLowerCase()) ||
            prop.location?.address?.toLowerCase().includes(sectorMeta.label.toLowerCase());
          return (
            <article class="prop-card">
              <div class="prop-media">
                <img src={prop.images?.[0]?.url || '/images/placeholders/property-placeholder.svg'} alt={prop.title} loading="lazy" />
                <span class={`prop-badge ${isDirect ? 'badge-direct' : 'badge-nearby'}`}>
                  {isDirect ? sectorMeta.label : (prop.block || 'Nearby')}
                </span>
                <span class="prop-type">{prop.propertyType.replace('-', ' ')}</span>
              </div>
              <div class="prop-body">
                <div class="prop-price-line">
                  <strong>PKR {(prop.price / 10000000).toFixed(2)} Cr</strong>
                  <span>{prop.size} {prop.unit.toUpperCase()}</span>
                </div>
                <h3><a href={`/properties/${prop.slug}/`}>{prop.title}</a></h3>
                <p class="prop-addr">{prop.location?.address || `${prop.block}, DHA Phase 6`}</p>
                <div class="prop-footer">
                  <span class="prop-status">Market Snapshot</span>
                  <a href={`/properties/${prop.slug}/`} class="btn-view-prop">Details →</a>
                </div>
              </div>
            </article>
          );
        })}

        <div class="prop-cta-card">
          <div class="cta-badge">Live Search</div>
          <h3>Browse All {sectorMeta.label} Listings</h3>
          <p>View current asking prices, plot orientations, and builder houses across external portals.</p>
          <div class="cta-actions">
            <a
              href="https://www.zameen.com/Plots/Lahore_Defence__DHA__Phase_6-1448-1.html"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-gold"
            >
              Search on Zameen.com ↗
            </a>
            <a href="/properties/" class="btn-outline">
              All Property Snapshots →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NEARBY AMENITIES HIGHLIGHT -->
  {previewPlaces.length > 0 && (
    <section class="amenities-preview-section">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker"><span></span> Lifestyle Convenience</p>
          <h2>Key Facilities in {sectorMeta.label}</h2>
          <p class="section-subtext">Verified schools, healthcare clinics, dining, and mosques within the sector.</p>
        </div>

        <div class="places-grid">
          {previewPlaces.map((place) => (
            <article class="place-mini-card">
              <a href={`/places/${place.category}/${place.slug}/`} class="place-mini-thumb">
                <PlaceImage place={place} />
              </a>
              <div class="place-mini-body">
                <span class="place-cat">{place.categoryLabel}</span>
                <h3><a href={`/places/${place.category}/${place.slug}/`}>{place.name}</a></h3>
                <p>{place.address}</p>
                <div class="place-mini-links">
                  <a href={`/places/${place.category}/${place.slug}/`}>View Place →</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="amenities-cta">
          <a href={`/sectors/${sectorMeta.key}/places/`} class="btn-gold">
            Browse All {sectorPlaces.length} Places in {sectorMeta.label} →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- MAP CONTEXT (Task 5) -->
  <section class="map-context-section">
    <div class="container">
      <div class="map-grid">
        <div class="map-text">
          <p class="section-kicker"><span></span> Geographic Positioning</p>
          <h2>{sectorMeta.label} Location &amp; Boundaries</h2>
          <p>
            {sectorMeta.label} is positioned at Latitude {sectorMeta.lat.toFixed(4)}, Longitude {sectorMeta.lng.toFixed(4)} in DHA Phase 6 Lahore. Inspect its position relative to internal boulevards, CCA hubs, and regional access routes.
          </p>
          <div class="map-actions">
            <a
              href={`https://www.google.com/maps/@${sectorMeta.lat},${sectorMeta.lng},17z`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-gold"
            >
              Open in Google Maps ↗
            </a>
            <a href="/dha-phase-6-lahore-map/" class="btn-outline">
              Official Phase 6 Map PDF →
            </a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps/embed/v1/view?key=AIzaSyD-9tSrke72PouQMnMX-a7eZSW0jkFMBWY&center=${sectorMeta.lat},${sectorMeta.lng}&zoom=16&maptype=roadmap`}
            title={`Map of ${sectorMeta.label} DHA Phase 6 Lahore`}
            style="width:100%;height:100%;border:0;"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- BUYER DUE DILIGENCE CHECKLIST -->
  <section class="checklist-section">
    <div class="container">
      <div class="checklist-card">
        <p class="section-kicker"><span></span> Acquisition Protocol</p>
        <h2>{sectorMeta.label} Property Buyer Checklist</h2>
        <ul class="checklist-items">
          <li>
            <span class="chk-icon">✓</span>
            <div>
              <strong>Map &amp; Physical Demarcation:</strong>
              <span>Always verify the exact plot peg and road width on ground against the official DHA Phase VI map.</span>
            </div>
          </li>
          <li>
            <span class="chk-icon">✓</span>
            <div>
              <strong>DHA NDC &amp; Transfer Eligibility:</strong>
              <span>Verify that the property possesses a valid No Demand Certificate (NDC) with all development charges paid.</span>
            </div>
          </li>
          <li>
            <span class="chk-icon">✓</span>
            <div>
              <strong>Utility Verification:</strong>
              <span>Confirm underground water supply, sewerage connection point, and electrical transformer proximity.</span>
            </div>
          </li>
          <li>
            <span class="chk-icon">✓</span>
            <div>
              <strong>Surrounding Construction Context:</strong>
              <span>Inspect active construction on the immediate street to understand neighbor setbacks and shared boundary walls.</span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="section-head">
        <p class="section-kicker"><span></span> Common Questions</p>
        <h2>{sectorMeta.label} Property FAQ</h2>
      </div>

      <div class="faq-accordion">
        {faqs.map((faq, i) => (
          <details class="faq-card" id={`faq-${i + 1}`}>
            <summary>{faq.question}</summary>
            <div class="faq-body">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- INTERNAL LINKING HUB -->
  <section class="links-hub-section">
    <div class="container">
      <div class="links-grid">
        <div class="link-card">
          <h3>{sectorMeta.label} Facilities Guide</h3>
          <p>Browse {sectorPlaces.length} verified places: schools, clinics, dining, mosques, and parks.</p>
          <a href={`/sectors/${sectorMeta.key}/places/`} class="link-btn">Facilities Guide →</a>
        </div>
        <div class="link-card">
          <h3>{sectorMeta.label} Sector Profile</h3>
          <p>Detailed sector history, road layout, and geographical features.</p>
          <a href={`/sectors/${sectorMeta.key}/`} class="link-btn">Sector Overview →</a>
        </div>
        <div class="link-card">
          <h3>All Sectors Comparison</h3>
          <p>Compare all 13 residential sectors and 4 commercial zones across DHA Phase 6.</p>
          <a href="/sectors/" class="link-btn">Compare Sectors →</a>
        </div>
        <div class="link-card">
          <h3>Investment Guide</h3>
          <p>Comprehensive framework on buying costs, rental yields, and legal due diligence.</p>
          <a href="/investment-guide/" class="link-btn">Read Investment Guide →</a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Base & Hero */
  .prop-hero {
    padding: 72px 0 56px;
    background: linear-gradient(165deg, #090919 0%, #111128 55%, #0c0c1e 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }
  .breadcrumb-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #64647f;
    margin-bottom: 1.2rem;
  }
  .breadcrumb-nav a {
    color: #9292ad;
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-nav a:hover {
    color: #f0c857;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgba(212, 168, 68, 0.12);
    border: 1px solid rgba(212, 168, 68, 0.3);
    color: #f0c857;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .prop-hero h1 {
    font-size: clamp(2rem, 4.2vw, 2.8rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 840px;
    margin: 0 auto 0.8rem;
  }
  .hero-lead {
    font-size: 0.95rem;
    color: #9292ad;
    max-width: 640px;
    margin: 0 auto 1.75rem;
    line-height: 1.6;
  }
  .hero-stats-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .stat-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.65rem 1.2rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 100px;
  }
  .stat-pill strong {
    font-size: 1.35rem;
    font-weight: 800;
    color: #f0c857;
    line-height: 1;
  }
  .stat-pill span {
    font-size: 0.6rem;
    color: #9292ad;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.3rem;
  }

  /* Section Kicker */
  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #d4a844;
    margin-bottom: 0.5rem;
  }
  .section-kicker span {
    width: 22px;
    height: 2px;
    background: #d4a844;
    border-radius: 1px;
  }
  .section-head {
    margin-bottom: 2rem;
  }
  .section-head h2 {
    color: #ffffff;
    font-size: 1.65rem;
    font-weight: 800;
    margin: 0 0 0.4rem;
  }
  .section-subtext {
    color: #9292ad;
    font-size: 0.88rem;
    margin: 0;
  }

  /* Overview */
  .overview-section {
    padding: 64px 0;
    background: #080818;
  }
  .overview-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .overview-content h2 {
    color: #ffffff;
    font-size: 1.55rem;
    font-weight: 800;
    margin: 0 0 1rem;
  }
  .overview-content p {
    color: #a5a5c0;
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .overview-highlights {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: 8px;
    background: #111125;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .overview-highlights h3 {
    margin: 0 0 0.75rem;
    color: #f0c857;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .overview-highlights ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .overview-highlights li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #9292ad;
    font-size: 0.84rem;
  }
  .bullet-dot {
    color: #d4a844;
    font-weight: bold;
  }
  .overview-sidebar-card {
    background: #111125;
    border: 1px solid rgba(212, 168, 68, 0.25);
    border-radius: 12px;
    padding: 1.75rem;
  }
  .overview-sidebar-card h3 {
    margin: 0 0 0.5rem;
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 800;
  }
  .overview-sidebar-card p {
    color: #9292ad;
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }
  .sidebar-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .btn-gold-full {
    display: block;
    text-align: center;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    background: linear-gradient(135deg, #d4a844, #f0c857);
    color: #080818;
    font-size: 0.76rem;
    font-weight: 800;
    text-decoration: none;
  }
  .btn-outline-full {
    display: block;
    text-align: center;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
