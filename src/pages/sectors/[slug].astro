---
import GuidePage from '@components/content/GuidePage.astro';
import { BLOCKS, type Block } from '@data/blocks';
import { getSectorPlaces } from '@data/places/index';

export function getStaticPaths() {
  return BLOCKS.map((block) => ({ params: { slug: block.slug }, props: { block } }));
}

interface Props { block: Block }
const { block } = Astro.props;
const statusLabel = block.status === 'possession-ready' ? 'Established / possession context' : block.status.replace('-', ' ');

// Get places count for this sector (residential sectors only)
const sectorKey = block.slug; // e.g. "sector-a"
const sectorPlaces = getSectorPlaces(sectorKey);
const placesCount = sectorPlaces.length;
const hasFacilities = placesCount > 0;
---

<GuidePage
  title={`${block.name}, DHA Phase 6 Lahore`}
  metaTitle={`${block.name} DHA Phase 6 Lahore | Map, Plots and Guide`}
  description={block.description}
  eyebrow="DHA Phase 6 Lahore sector guide"
  facts={[
    { label: 'Area type', value: block.category.replace('-', ' ') },
    { label: 'General status', value: statusLabel },
    { label: 'Common sizes', value: block.plotSizes.join(', ') },
    { label: 'Map note', value: block.locationHighlight },
    ...(hasFacilities ? [{ label: 'Verified local places', value: `${placesCount} verified businesses & services` }] : []),
  ]}
  sections={[
    {
      heading: `Overview of ${block.name}`,
      paragraphs: [
        block.description,
        'Sector-level notes are general context. An exact street can differ in access, road width, construction activity, noise and proximity to facilities.',
      ],
    },
    {
      heading: 'Location and nearby context',
      paragraphs: [block.locationHighlight, 'Use the official Phase VI map first, then confirm the exact property number and physical street during a daylight visit.'],
      bullets: block.features,
    },
    ...(hasFacilities ? [{
      heading: `${block.name} Facilities & Local Places`,
      paragraphs: [
        `${block.name} has ${placesCount} verified local places including schools, clinics, restaurants, mosques, banks, supermarkets, parks, and gyms. Browse the complete ${block.name} facilities guide for contact details, ratings, and directions.`,
      ],
    }] : []),
    {
      heading: 'Property and investment checks',
      paragraphs: [
        `Common categories associated with this guide include ${block.plotTypes.join(', ')}. Published plot-size context includes ${block.plotSizes.join(', ')}.`,
        'Compare multiple current asking prices and distinguish seller demand from completed transaction evidence. Verify ownership, dues, NDC requirements and transfer eligibility before making a payment.',
      ],
    },
    {
      heading: 'Site visit checklist',
      paragraphs: ['Record the visit date and evaluate the exact location consistently.'],
      bullets: ['Road width and surface', 'Plot dimensions and orientation', 'Drainage and street level', 'Occupied houses and active construction', 'Nearby parks, mosques and commercial activity', 'Utility and transfer status'],
    },
  ]}
  faqs={[
    { question: `Is ${block.name} fully verified by this portal?`, answer: 'No. This page provides general area context. Verify the exact property and current official requirements independently.' },
    { question: `Where can I find properties linked to ${block.name}?`, answer: 'Use the property directory and sector filter. Public-portal records remain source-referenced market snapshots, not verified inventory.' },
    ...(hasFacilities ? [{ question: `What facilities and services are in ${block.name}?`, answer: `${block.name} has ${placesCount} verified local places including schools, healthcare clinics, restaurants, mosques, banks, supermarkets, parks and gyms. Use the ${block.name} Facilities Guide to browse all verified places with contact details and Google Maps directions.` }] : []),
  ]}
  sources={[
    { label: 'Official DHA Lahore Phase VI map PDF', href: 'https://dhalahore.org/wp-content/uploads/2025/09/PHASE-VI.pdf' },
    { label: 'Browse property market snapshots', href: '/properties' },
    ...(hasFacilities ? [{ label: `${block.name} Facilities & Places Guide (${placesCount} verified places)`, href: `/sectors/${sectorKey}/places/` }] : []),
    { label: 'DHA Phase 6 Investment Guide', href: '/investment-guide/' },
  ]}
/>

