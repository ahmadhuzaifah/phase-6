---
/**
 * 10 Marla House in Al Rehman Garden Phase 2 — Local SEO Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import propertiesData from '@data/properties-import.json';

const tenMarlaHouses = propertiesData.filter(
  (p) => p.size === '10' && (p.propertyType === 'house' || p.propertyType === 'villa')
);

const pageSchema = {
  name: '10 Marla House in DHA Phase 6 Lahore',
  description: 'Verified 10 Marla luxury designer houses and architectural villas for sale in DHA Phase 6 Lahore.',
  url: `${SITE.url}/10-marla-house-al-rehman-garden-phase-2`,
};
---

<PageLayout
  title="10 Marla House in DHA Phase 6 Lahore — Luxury Villas 2026"
  description="Explore 10 Marla designer houses and luxury villas for sale in DHA Phase 6 Lahore. 4-5 bedroom executive residences in Sector H & Sector J."
>
  <Schema type="WebSite" data={pageSchema} />

  <section class="local-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Executive Living</div>
      <h1 class="local-hero__title">
        10 Marla House in <span class="text-gradient-gold">DHA Phase 6 Lahore</span>
      </h1>
      <p class="local-hero__lead lead">
        Spacious executive residences in Sector H & J featuring 4 to 5 master bedrooms with attached designer baths, double car porches, modern Italian kitchens, and rooftop servant quarters.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Available Residences</span>
          <h2 class="section-header__title">Featured 10 Marla Houses</h2>
        </div>
        <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--sm">
          Schedule Private House Tour
        </a>
      </div>

      <div class="local-grid">
        {tenMarlaHouses.map((prop) => (
          <PropertyCard
            title={prop.title}
            slug={prop.slug}
            propertyType={prop.propertyType}
            purpose={prop.purpose}
            price={prop.price}
            priceUnit={prop.priceUnit}
            size={prop.size}
            sizeUnit={prop.unit}
            block={prop.block}
            location={prop.location.address}
            image={prop.images && prop.images.length > 0 ? prop.images[0] : undefined}
            verificationStatus={prop.verificationStatus}
            availabilityStatus={prop.availabilityStatus}
            lastVerifiedDate={prop.lastVerifiedDate}
            isFeatured={prop.isFeatured}
          />
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .local-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .local-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .local-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .local-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .local-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .local-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
