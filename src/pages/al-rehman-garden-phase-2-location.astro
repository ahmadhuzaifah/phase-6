---
/**
 * Al Rehman Garden Phase 2 Location Guide — High-Intent SEO Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const locationSchema = {
  name: 'Al Rehman Garden Phase 2 Location & Accessibility Guide',
  description: 'Complete location and route guide to Al Rehman Garden Phase 2 Lahore on Main Sharaqpur Road near M2 Motorway Faizpur Interchange.',
  url: `${SITE.url}/al-rehman-garden-phase-2-location`,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.5768,
    longitude: 74.2254,
  },
};

const routes = [
  {
    from: 'M-2 Motorway (Faizpur Interchange)',
    time: '2 Minutes (1.2 km)',
    route: 'Direct exit from Faizpur Interchange onto Main Sharaqpur Road heading toward Al Rehman Garden grand gate.',
    highlight: 'Signal-free direct expressway access',
  },
  {
    from: 'Mall Road & Lower Mall / Secretariat',
    time: '10 Minutes (6.5 km)',
    route: 'Via Sagianwala Bypass and Sharaqpur Road straight to the 150ft main society entrance.',
    highlight: 'Quick downtown commercial connection',
  },
  {
    from: 'Thokar Niaz Baig & Multan Road',
    time: '12 Minutes (11 km)',
    route: 'Via M-2 Motorway northbound directly to Faizpur exit.',
    highlight: 'Bypasses city traffic signals',
  },
  {
    from: 'Lahore Ring Road (SL-3 / Western Arc)',
    time: '5 Minutes (3 km)',
    route: 'Fast linkage connecting to DHA, Gulberg, and Allama Iqbal International Airport.',
    highlight: 'Direct airport connectivity in 25 mins',
  },
  {
    from: 'District & Session Courts / Civil Lines',
    time: '12 Minutes (7.5 km)',
    route: 'Via Ravi Bridge and Sagian access corridor.',
    highlight: 'Convenient for legal and administrative professionals',
  },
];
---

<PageLayout
  title="Al Rehman Garden Phase 2 Location Lahore — Main Sharaqpur Road & M2 Access"
  description="Discover the exact location of Al Rehman Garden Phase 2 Lahore on Main Sharaqpur Road, 2 mins from M-2 Motorway Faizpur Interchange and 10 mins from Mall Road. Get GPS directions."
>
  <Schema type="WebSite" data={locationSchema} />

  <!-- Hero Header -->
  <section class="seo-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Location & Route Guide</div>
      <h1 class="seo-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">Location Lahore</span>
      </h1>
      <p class="seo-hero__lead lead">
        Strategically situated on <strong>Main Sharaqpur Road, Lahore</strong>, just <strong>2 minutes from M-2 Motorway Faizpur Interchange</strong> and 10 minutes from Mall Road.
      </p>
    </div>
  </section>

  <!-- Location Breakdown -->
  <section class="section section--alt">
    <div class="container">
      <div class="loc-grid">
        <!-- Main Route Details -->
        <div class="loc-main">
          <div class="loc-card">
            <h2 class="loc-card__title">Prime Location Advantage</h2>
            <p>
              Al Rehman Garden Phase 2 occupies one of the most accessible and rapidly appreciating real estate locations in Western Lahore. Situated directly on the 150ft Main Sharaqpur Road, it serves as the vital gateway connecting downtown Lahore with the M-2 Motorway and Lahore Ring Road network.
            </p>
            <p>
              Unlike isolated housing schemes, Phase 2 benefits from direct arterial connectivity, ensuring that residents can reach central commercial hubs, educational campuses, and medical centers in under 15 minutes.
            </p>
          </div>

          <!-- Travel Times Matrix -->
          <div class="loc-card">
            <h2 class="loc-card__title">Key Routes & Travel Times</h2>
            <div class="routes-list">
              {routes.map((r) => (
                <div class="route-item">
                  <div class="route-item__header">
                    <strong class="route-item__from">{r.from}</strong>
                    <span class="route-item__time">{r.time}</span>
                  </div>
                  <p class="route-item__desc">{r.route}</p>
                  <span class="route-item__hl">✓ {r.highlight}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar / GPS Coordinates & CTA -->
        <aside class="loc-sidebar">
          <div class="loc-gps-box">
            <div class="loc-gps-box__badge">GPS Navigation</div>
            <h3 class="loc-gps-box__title">Coordinates</h3>
            <div class="loc-gps-box__coords">31.5768° N, 74.2254° E</div>
            <p class="loc-gps-box__text">Main Sharaqpur Road, near Faizpur Interchange, Lahore, Punjab, Pakistan.</p>
            
            <a
              href="https://maps.google.com/?q=Al+Rehman+Garden+Phase+2+Lahore"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary btn--full"
            >
              Open in Google Maps ↗
            </a>

            <hr class="loc-gps-box__hr" />

            <h4 class="loc-gps-box__sub">Need Directions Guidance?</h4>
            <p class="loc-gps-box__text">Contact our site desk for live location pin sharing on WhatsApp.</p>
            <a
              href={CONTACTS.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--accent btn--full"
            >
              Get WhatsApp Location Pin
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .seo-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .seo-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .seo-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .loc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .loc-grid {
      grid-template-columns: 1fr 340px;
    }
  }

  .loc-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-6);
  }

  .loc-card__title {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }

  .loc-card p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .routes-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .route-item {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .route-item__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .route-item__from {
    font-size: var(--text-base);
    color: var(--text-primary);
  }

  .route-item__time {
    font-size: var(--text-xs);
    font-weight: var(--font-extrabold);
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-gold);
  }

  .route-item__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin: 0 0 var(--space-2);
  }

  .route-item__hl {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: #059669;
  }

  /* GPS Box */
  .loc-gps-box {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-xl);
    position: sticky;
    top: 96px;
  }

  .loc-gps-box__badge {
    display: inline-block;
    font-size: 10px;
    font-weight: var(--font-extrabold);
    text-transform: uppercase;
    color: var(--color-secondary-950);
    background: var(--gradient-gold);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-2);
  }

  .loc-gps-box__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-1);
  }

  .loc-gps-box__coords {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-primary-700);
    font-weight: var(--font-bold);
    background: var(--color-primary-50);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .loc-gps-box__text {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .loc-gps-box__hr {
    border: none;
    border-top: 1px solid var(--border-light);
    margin: var(--space-5) 0;
  }

  .loc-gps-box__sub {
    font-size: var(--text-sm);
    margin: 0 0 var(--space-1);
  }
</style>
