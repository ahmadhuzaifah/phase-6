---
/**
 * Plots Directory — Al Rehman Garden Phase 2 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import Button from '@components/global/Button.astro';
import { SITE } from '@data/site';
import propertiesData from '@data/properties-import.json';

const plotsListings = propertiesData.filter((p) => p.propertyType.includes('plot'));

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Plots for Sale',
      item: `${SITE.url}/plots`,
    },
  ],
};
---

<PageLayout
  title={`Residential & Commercial Plots for Sale — ${SITE.name}`}
  description={`Browse verified residential and commercial plots for sale in Al Rehman Garden Phase 2 Lahore. Ready possession 3, 5, 8, 10 Marla & 1 Kanal plots.`}
>
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />

  <section class="plots-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Verified Plot Inventory</div>
      <h1 class="plots-hero__title">Plots for Sale in Phase 2</h1>
      <p class="plots-hero__lead lead">
        Explore 100% on-ground residential & commercial plots with underground utilities, ready possession, and direct access to Main Sharaqpur Road Lahore.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Available Inventory</span>
          <h2 class="section-header__title">Latest Available Plots</h2>
        </div>
        <Button href="/properties" variant="outline" size="sm">
          All Listings & Filters →
        </Button>
      </div>

      <div class="plots-grid">
        {plotsListings.map((prop) => (
          <PropertyCard
            title={prop.title}
            slug={prop.slug}
            propertyType={prop.propertyType}
            purpose={prop.purpose}
            price={prop.price}
            priceUnit={prop.priceUnit}
            size={prop.size}
            sizeUnit={prop.unit}
            block={prop.block}
            location={prop.location.address}
            image={prop.images && prop.images.length > 0 ? prop.images[0] : undefined}
            verificationStatus={prop.verificationStatus}
            availabilityStatus={prop.availabilityStatus}
            lastVerifiedDate={prop.lastVerifiedDate}
            isFeatured={prop.isFeatured}
          />
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .plots-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .plots-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .plots-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .plots-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .plots-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .plots-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
