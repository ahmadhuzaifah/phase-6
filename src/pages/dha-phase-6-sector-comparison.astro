---
/**
 * Buyer Intent Funnel: Research Stage
 * /dha-phase-6-sector-comparison/
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@data/site';

const title = "DHA Phase 6 Sector Comparison Guide — Side-by-Side Analysis of Sectors A to N";
const description = "Comprehensive side-by-side comparison of DHA Phase 6 sectors. Compare plot prices, house rates, commercial access, noise levels, and school proximity across Sectors A, B, C, D, E, F, G, H, J, K, L, M, and N.";
const canonical = `${SITE.url}/dha-phase-6-sector-comparison/`;

const sectorGroups = [
  {
    groupTitle: "Prime Central & Luxury Sectors (Sectors C, D, Raya M/N)",
    summary: "The highest prestige tier in DHA Phase 6. Unmatched walking adjacency to CCA 1, Grand Jamia Mosque, and the Defence Raya Golf Course.",
    sectors: [
      { name: "Sector C", sizes: "1 & 2 Kanal", plotPrice: "PKR 5.60 – 6.50 Cr", housePrice: "PKR 12.50 – 16.00 Cr", character: "Ultra-prime, Grand Jamia Mosque, low through-traffic", commercial: "Immediate walk to CCA 1" },
      { name: "Sector D", sizes: "1 Kanal", plotPrice: "PKR 5.20 – 6.00 Cr", housePrice: "PKR 11.50 – 14.50 Cr", character: "Vibrant family living, top rental liquidity", commercial: "Directly facing CCA 1" },
      { name: "Defence Raya (M & N)", sizes: "1 & 2 Kanal + Villas", plotPrice: "PKR 6.50 – 8.50 Cr", housePrice: "PKR 15.00 – 24.00 Cr", character: "18-hole golf fairways, private country club, resort lifestyle", commercial: "Fairways commercial promenade" }
    ]
  },
  {
    groupTitle: "Executive Western Sectors (Sectors A & B)",
    summary: "Front-facing sectors offering instant signal-free commutes to Bedian Road, DHA Phase 5, and elite educational campuses.",
    sectors: [
      { name: "Sector A", sizes: "1 & 2 Kanal", plotPrice: "PKR 5.40 – 6.20 Cr", housePrice: "PKR 12.00 – 15.00 Cr", character: "Main gate convenience, zero commute friction to Phase 5", commercial: "Main Boulevard commercial strips" },
      { name: "Sector B", sizes: "1 & 2 Kanal", plotPrice: "PKR 5.20 – 5.90 Cr", housePrice: "PKR 11.20 – 14.00 Cr", character: "Roots Millennium School, mature park system, executive privacy", commercial: "5 min drive to CCA 1" }
    ]
  },
  {
    groupTitle: "Civic & Tranquility Sectors (Sectors E & F)",
    summary: "Ideal for families prioritizing healthcare access, quiet residential streets, and spacious sports facilities.",
    sectors: [
      { name: "Sector E", sizes: "1 Kanal", plotPrice: "PKR 4.90 – 5.60 Cr", housePrice: "PKR 10.80 – 13.50 Cr", character: "DHA Medical Centre, sports complex, high civic utility", commercial: "Central convenience to CCA 1 & 2" },
      { name: "Sector F", sizes: "1 & 2 Kanal", plotPrice: "PKR 4.80 – 5.50 Cr", housePrice: "PKR 10.50 – 13.00 Cr", character: "Secluded southern pocket, zero heavy commuter traffic", commercial: "Quick access to CCA 2" }
    ]
  },
  {
    groupTitle: "10 Marla & High-Activity Family Sectors (Sectors J, G, H)",
    summary: "The most popular sectors for modern 10 Marla houses, top private schools, and practical family living budgets.",
    sectors: [
      { name: "Sector J", sizes: "10 Marla & 1 Kanal", plotPrice: "PKR 2.90 – 3.60 Cr (10M)", housePrice: "PKR 5.80 – 7.50 Cr (10M)", character: "Beaconhouse Newlands, lively sector market, dense family occupancy", commercial: "Sector J retail strip & CCA 2" },
      { name: "Sector G", sizes: "10 Marla & 1 Kanal", plotPrice: "PKR 2.65 – 3.30 Cr (10M)", housePrice: "PKR 5.40 – 6.80 Cr (10M)", character: "Attractive entry pricing, direct Bedian Road transit", commercial: "Local sector commercial" },
      { name: "Sector H", sizes: "10 Marla & 1 Kanal", plotPrice: "PKR 2.75 – 3.45 Cr (10M)", housePrice: "PKR 5.60 – 7.20 Cr (10M)", character: "Balanced central position, equidistant to CCA 1 & CCA 2", commercial: "Immediate adjacency to CCA 2" }
    ]
  },
  {
    groupTitle: "Growth & Capital Appreciation Corridor (Sectors K & L)",
    summary: "Eastern sectors offering 20% entry price discounts with rapid construction activity and direct Lahore Ring Road connectivity.",
    sectors: [
      { name: "Sector K", sizes: "10 Marla & 1 Kanal", plotPrice: "PKR 4.10 – 4.75 Cr (1K)", housePrice: "PKR 9.20 – 11.50 Cr (1K)", character: "Fastest emerging construction, prime long-term upside", commercial: "CCA 2 proximity" },
      { name: "Sector L", sizes: "1 & 2 Kanal", plotPrice: "PKR 3.95 – 4.60 Cr (1K)", housePrice: "PKR 9.00 – 11.00 Cr (1K)", character: "Direct Ring Road interchange access, peaceful eastern boundary", commercial: "Short drive to CCA 2" }
    ]
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonical}#article`,
      "isPartOf": { "@type": "WebSite", "@id": `${SITE.url}/#website` },
      "headline": title,
      "description": description,
      "url": canonical,
      "datePublished": "2026-03-01T08:00:00+05:00",
      "dateModified": "2026-09-05T20:00:00+05:00"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "Research", "item": `${SITE.url}/sectors/` },
        { "@type": "ListItem", "position": 3, "name": "Sector Comparison", "item": canonical }
      ]
    }
  ]
};
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <header class="comp-hero">
    <div class="container">
      <div class="stage-tag">Stage 2: In-Depth Sector Research</div>
      <h1 class="hero-h1">
        DHA Phase 6 <span class="text-gold">Sector Comparison Guide</span>
      </h1>
      <p class="hero-p">
        Objective side-by-side evaluation of Sectors A to N. Compare prevailing plot and house prices, commercial convenience, tranquility ratings, and target buyer profiles.
      </p>
    </div>
  </header>

  <main class="container comp-main">

    <!-- SECTOR CLUSTER COMPARISON SECTIONS -->
    <div class="clusters-container">
      {sectorGroups.map(group => (
        <section class="cluster-card">
          <div class="cluster-header">
            <h2>{group.groupTitle}</h2>
            <p>{group.summary}</p>
          </div>

          <div class="table-wrap">
            <table class="comp-table">
              <thead>
                <tr>
                  <th>Sector</th>
                  <th>Plot Sizes</th>
                  <th>Observed Plot Demand</th>
                  <th>Observed House Demand</th>
                  <th>Neighborhood Vibe</th>
                  <th>Commercial Access</th>
                </tr>
              </thead>
              <tbody>
                {group.sectors.map(sec => (
                  <tr>
                    <td><strong>{sec.name}</strong></td>
                    <td><span class="pill-size">{sec.sizes}</span></td>
                    <td><strong class="text-price">{sec.plotPrice}</strong></td>
                    <td>{sec.housePrice}</td>
                    <td>{sec.character}</td>
                    <td>{sec.commercial}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>

    <!-- FUNNEL STEP 3 NEXT-STEP TRANSITION -->
    <section class="funnel-next-step">
      <div class="step-card">
        <span class="step-number">Next Step in Buyer Journey</span>
        <h2>Stage 3: Decision &amp; Curated Best Properties</h2>
        <p>Identified the right sector for your lifestyle and budget? Review our handpicked selection of top ready houses, investment plots, and commercial assets.</p>
        <div class="btn-group">
          <a href="/dha-phase-6-best-properties/" class="btn-step">Explore Best Properties in Phase 6 →</a>
          <a href="/search-property/" class="btn-step-subtle">Filter Full Search Inventory</a>
        </div>
      </div>
    </section>

  </main>
</PageLayout>

<style>
  .comp-hero {
    background: linear-gradient(135deg, #09121d 0%, #152436 100%);
    color: #ffffff;
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .stage-tag {
    display: inline-block;
    background: rgba(200, 150, 12, 0.2);
    color: #facc15;
    border: 1px solid rgba(200, 150, 12, 0.4);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .hero-h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .text-gold {
    background: linear-gradient(135deg, #e5b324 0%, #fef08a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-p {
    font-size: 1.15rem;
    color: #94a3b8;
    max-width: 800px;
    line-height: 1.6;
  }

  .comp-main {
    padding: 3.5rem 0 5rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .clusters-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .cluster-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }
  .cluster-header h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.5rem 0;
  }
  .cluster-header p {
    font-size: 0.95rem;
    color: #64748b;
    margin-bottom: 1.5rem;
  }

  .table-wrap {
    overflow-x: auto;
  }
  .comp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .comp-table th {
    background: #f8fafc;
    color: #475569;
    padding: 0.85rem 1rem;
    text-align: left;
    font-weight: 700;
    border-bottom: 2px solid #e2e8f0;
    white-space: nowrap;
  }
  .comp-table td {
    padding: 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
  }
  .comp-table tr:hover {
    background: #f8fafc;
  }
  .pill-size {
    background: #f1f5f9;
    color: #475569;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .text-price {
    color: #0f172a;
    white-space: nowrap;
  }

  .funnel-next-step {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
  }
  .step-card {
    max-width: 720px;
    margin: 0 auto;
  }
  .step-number {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #facc15;
    display: block;
    margin-bottom: 0.5rem;
  }
  .step-card h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
  }
  .step-card p {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .btn-group {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn-step {
    background: #c8960c;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .btn-step:hover {
    background: #b08207;
  }
  .btn-step-subtle {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
</style>
