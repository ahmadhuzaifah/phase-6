---
/**
 * Al Rehman Garden Phase 2 Plot Prices & Rate List — High-Intent SEO Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const pricesSchema = {
  name: 'Al Rehman Garden Phase 2 Plot Prices & Installment Rate List',
  description: 'Updated 2026 price list for residential and commercial plots in Al Rehman Garden Phase 2 Lahore across all blocks.',
  url: `${SITE.url}/al-rehman-garden-phase-2-prices`,
};

const priceRates = [
  { size: '3 Marla', type: 'Residential Plot', cashRange: 'PKR 24 - 30 Lakh', installmentRange: '3 - 5 Years Easy Plan', possession: 'Ready in Block B, E' },
  { size: '3.5 Marla', type: 'Residential Plot', cashRange: 'PKR 27 - 33 Lakh', installmentRange: 'Available in Block E', possession: 'Ready Possession' },
  { size: '5 Marla', type: 'Residential Plot', cashRange: 'PKR 40 - 55 Lakh', installmentRange: 'Available in Mirabel / Royal', possession: 'Ready in Block A, B, C, D' },
  { size: '7 Marla', type: 'Residential Plot', cashRange: 'PKR 58 - 68 Lakh', installmentRange: 'Cash / Selective Installment', possession: 'Ready in Block B' },
  { size: '8 Marla', type: 'Residential Plot', cashRange: 'PKR 68 - 80 Lakh', installmentRange: 'Cash Deals', possession: 'Ready in Block C' },
  { size: '10 Marla', type: 'Residential Plot', cashRange: 'PKR 80 Lakh - 1.10 Cr', installmentRange: 'Available in Royal / Mirabel', possession: 'Ready in Block A, B' },
  { size: '1 Kanal', type: 'Residential Plot', cashRange: 'PKR 1.65 - 2.20 Cr', installmentRange: 'Luxury Enclave Enrolment', possession: 'Ready in Block A, Mirabel' },
  { size: '2 Marla', type: 'Commercial Plot / Shop', cashRange: 'PKR 60 - 85 Lakh', installmentRange: 'Sector Commercial Plan', possession: 'Ready in Block A, Royal' },
  { size: '4 Marla', type: 'Commercial Broadway', cashRange: 'PKR 1.50 - 2.00 Cr', installmentRange: 'High-Yield Commercial', possession: 'Ready in Block C Broadway' },
  { size: '8 Marla', type: 'Main Boulevard Comm', cashRange: 'PKR 3.00 - 4.20 Cr', installmentRange: 'Corporate Flagship', possession: 'Ready in Block A Boulevard' },
];
---

<PageLayout
  title="Al Rehman Garden Phase 2 Prices 2026 — Plot Rates & Payment Plans"
  description="Explore the latest 2026 plot price list for Al Rehman Garden Phase 2 Lahore. Compare 3, 5, 8, 10 Marla & 1 Kanal cash rates and flexible monthly installment payment plans."
>
  <Schema type="WebSite" data={pricesSchema} />

  <!-- Hero Header -->
  <section class="seo-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Updated 2026 Price Index</div>
      <h1 class="seo-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">Plot Prices</span>
      </h1>
      <p class="seo-hero__lead lead">
        Transparent, market-verified price guide and flexible installment schedules for residential and commercial plots across all blocks in Al Rehman Garden Phase 2 Lahore.
      </p>
    </div>
  </section>

  <!-- Rate List Table & Payment Plan -->
  <section class="section section--alt">
    <div class="container">
      <div class="price-table-card">
        <div class="price-table-card__header">
          <div>
            <span class="price-table-card__tag">Market Rate Sheet</span>
            <h2 class="price-table-card__title">Current Plot Price Ranges by Size</h2>
          </div>
          <a
            href={CONTACTS.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--accent btn--sm"
          >
            Get Live Rate PDF on WhatsApp
          </a>
        </div>

        <div class="table-responsive">
          <table class="rate-table">
            <thead>
              <tr>
                <th>Plot Size</th>
                <th>Category</th>
                <th>Estimated Cash Price</th>
                <th>Installment Schedule</th>
                <th>Possession Status</th>
              </tr>
            </thead>
            <tbody>
              {priceRates.map((r) => (
                <tr>
                  <td><strong>{r.size}</strong></td>
                  <td>{r.type}</td>
                  <td><span class="rate-price-tag">{r.cashRange}</span></td>
                  <td>{r.installmentRange}</td>
                  <td><span class="rate-possession-tag">✓ {r.possession}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="price-table-card__footer">
          <p>
            * Note: Plot prices vary based on location attributes such as Corner, Park Facing, 150ft Boulevard Frontage, and ready possession status. Contact advisory for exact plot numbers and allotment records.
          </p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .seo-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .seo-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .seo-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .price-table-card {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-xl);
  }

  .price-table-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-light);
  }

  @media (min-width: 640px) {
    .price-table-card__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .price-table-card__tag {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .price-table-card__title {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .table-responsive {
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }

  .rate-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: var(--text-sm);
  }

  .rate-table th {
    background-color: var(--color-secondary-900);
    color: #FFFFFF;
    padding: var(--space-3-5) var(--space-4);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .rate-table td {
    padding: var(--space-3-5) var(--space-4);
    border-bottom: 1px solid var(--border-light);
    color: var(--text-secondary);
  }

  .rate-table tbody tr:hover {
    background-color: var(--color-primary-50);
  }

  .rate-price-tag {
    font-weight: var(--font-extrabold);
    color: var(--color-secondary-900);
  }

  .rate-possession-tag {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: #059669;
  }

  .price-table-card__footer {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
