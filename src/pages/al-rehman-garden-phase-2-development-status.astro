---
/**
 * Al Rehman Garden Phase 2 On-Ground Development Status — Authority SEO Hub
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { BLOCKS } from '@data/blocks';

const faqs = [
  {
    question: 'What is the current development status of Al Rehman Garden Phase 2?',
    answer: 'Block A, B, C, and D are 100% completed with ready possession, paved roads, and active underground electricity. Blocks E & F are over 80% developed. Newly launched sectors like Mirabel Block and Beverly Hills are actively under rapid machinery work.',
  },
  {
    question: 'How fast can I start building a house after purchasing a plot?',
    answer: 'In possession blocks (Block A, B, C, D, and E), you can submit your building map to the society architecture wing and begin construction within 1 to 2 weeks.',
  },
];

const faqSchema = {
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<PageLayout
  title="Al Rehman Garden Phase 2 Development Status 2026 — On-Ground Progress"
  description="Latest 2026 development progress update for Al Rehman Garden Phase 2 Lahore. View block-by-block possession rates, road carpeting, electrification, and machinery progress."
>
  <Schema type="FAQPage" data={faqSchema} />

  <section class="auth-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Live Site Progress 2026</div>
      <h1 class="auth-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">Development Status</span>
      </h1>
      <p class="auth-hero__lead lead">
        An accurate audit of on-ground infrastructure progress, road carpeting, underground electrification, Sui gas pipelines, and sector possession milestones.
      </p>
      <div class="auth-meta-bar">
        <span>📅 On-Site Audit Date: September 2026</span>
        <span>🏗️ Source: Direct Site Inspection & Management Reports</span>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <!-- Block Progress Table -->
      <div class="dev-status-card">
        <h2 class="dev-status-card__title">Block-by-Block On-Ground Progress</h2>
        <div class="table-responsive">
          <table class="dev-table">
            <thead>
              <tr>
                <th>Sector Name</th>
                <th>Category</th>
                <th>Possession Rate</th>
                <th>Electrification</th>
                <th>Current Status</th>
              </tr>
            </thead>
            <tbody>
              {BLOCKS.map((b) => (
                <tr>
                  <td><strong>{b.name}</strong></td>
                  <td style="text-transform: capitalize;">{b.category.replace('-', ' ')}</td>
                  <td>
                    <div class="prog-bar-wrap">
                      <div class="prog-bar" style={`width: ${b.possessionPercentage}%`}></div>
                      <span>{b.possessionPercentage}%</span>
                    </div>
                  </td>
                  <td>✓ 100% Underground</td>
                  <td>
                    <span class={`status-pill status-pill--${b.status}`}>
                      {b.status.replace('-', ' ')}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Card -->
      <div class="auth-faq-card" style="margin-top: 32px;">
        <h2 class="auth-faq-card__title">Development & Construction FAQs</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <h3 class="faq-item__q">Q: {f.question}</h3>
              <p class="faq-item__a">{f.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .auth-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .auth-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .auth-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0 0 var(--space-4);
  }

  .auth-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: #F3D375;
  }

  .dev-status-card {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-xl);
  }

  .dev-status-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .dev-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .dev-table th {
    background-color: var(--color-secondary-900);
    color: white;
    padding: var(--space-3-5) var(--space-4);
    text-align: left;
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .dev-table td {
    padding: var(--space-3-5) var(--space-4);
    border-bottom: 1px solid var(--border-light);
    color: var(--text-secondary);
  }

  .prog-bar-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 140px;
  }

  .prog-bar {
    height: 8px;
    background: var(--gradient-gold);
    border-radius: var(--radius-full);
  }

  .status-pill {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--font-bold);
    text-transform: capitalize;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  .status-pill--developed,
  .status-pill--ready-possession {
    background: #ECFDF5;
    color: #059669;
  }

  .status-pill--under-construction,
  .status-pill--developing {
    background: #FEF3C7;
    color: #D97706;
  }

  .auth-faq-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .auth-faq-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .faq-item__q {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .faq-item__a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }
</style>
