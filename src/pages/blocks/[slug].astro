---
/**
 * Dynamic Block Detail Page Template — Al Rehman Garden Phase 2
 * Comprehensive sector profile with plot sizes, price ranges, development metrics,
 * available inventory, and sector FAQ Schema.
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import Button from '@components/global/Button.astro';
import { SITE } from '@data/site';
import { BLOCKS } from '@data/blocks';
import { CONTACTS } from '@data/contacts';
import propertiesData from '@data/properties-import.json';

export async function getStaticPaths() {
  return BLOCKS.map((block) => ({
    params: { slug: block.slug },
    props: { block },
  }));
}

const { block } = Astro.props;

// Filter properties in this block
const blockProperties = propertiesData.filter(
  (p) => p.block.toLowerCase().includes(block.name.toLowerCase().split(' ')[0])
);

// Sector FAQs
const blockFaqs = [
  {
    question: `What plot sizes are available in ${block.name}?`,
    answer: `${block.name} offers ${block.plotSizes.join(', ')} plots across residential and commercial sectors.`,
  },
  {
    question: `What is the possession and development status of ${block.name}?`,
    answer: `${block.name} currently has ${block.possessionPercentage}% on-ground development with ${block.status.replace('-', ' ')} status.`,
  },
  {
    question: `How can I buy or verify a plot in ${block.name}?`,
    answer: `Contact the official Al Rehman Garden advisory desk via WhatsApp or phone to verify allotment files, map coordinates, and schedule an on-ground physical visit.`,
  },
];

const faqSchema = {
  mainEntity: blockFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blocks',
      item: `${SITE.url}/blocks`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: block.name,
      item: `${SITE.url}/blocks/${block.slug}`,
    },
  ],
};
---

<PageLayout
  title={`${block.name} Al Rehman Garden Phase 2 Lahore — Map, Rates & Status`}
  description={`Comprehensive guide to ${block.name} in Al Rehman Garden Phase 2 Lahore. View available plot sizes (${block.plotSizes.join(', ')}), possession status (${block.possessionPercentage}%), amenities, and verified listings.`}
>
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />
  <Schema type="FAQPage" data={faqSchema} />

  <!-- Block Header -->
  <section class="block-detail-header">
    <div class="container">
      <div class="block-detail-header__inner">
        <div class="eyebrow eyebrow--dark">Sector Profile • {block.category.replace('-', ' ')}</div>
        <h1 class="block-detail-header__title">{block.name}</h1>
        <p class="block-detail-header__lead lead">{block.description}</p>
        
        <div class="block-detail-header__stats">
          <div class="block-stat-pill">
            <span>Possession:</span>
            <strong>{block.possessionPercentage}% On-Ground</strong>
          </div>
          <div class="block-stat-pill">
            <span>Status:</span>
            <strong style="text-transform: capitalize;">{block.status.replace('-', ' ')}</strong>
          </div>
          <div class="block-stat-pill">
            <span>Plots:</span>
            <strong>{block.plotSizes.join(', ')}</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Block Main Content -->
  <section class="section section--alt">
    <div class="container">
      <div class="block-page-grid">
        <!-- Main Details Column -->
        <div class="block-page-main">
          <!-- Overview Card -->
          <div class="block-info-card">
            <h2 class="block-info-card__title">Sector Specifications & Infrastructure</h2>
            <div class="block-specs-grid">
              <div class="block-spec-item">
                <span class="block-spec-icon">📍</span>
                <div>
                  <span class="block-spec-lbl">Location Inside Society</span>
                  <strong>{block.locationHighlight || 'Main Sharaqpur Road Corridor'}</strong>
                </div>
              </div>
              <div class="block-spec-item">
                <span class="block-spec-icon">📐</span>
                <div>
                  <span class="block-spec-lbl">Plot Categories</span>
                  <strong>{block.plotSizes.join(', ')}</strong>
                </div>
              </div>
              <div class="block-spec-item">
                <span class="block-spec-icon">⚡</span>
                <div>
                  <span class="block-spec-lbl">Underground Grid</span>
                  <strong>100% Concealed Power</strong>
                </div>
              </div>
              <div class="block-spec-item">
                <span class="block-spec-icon">🛡️</span>
                <div>
                  <span class="block-spec-lbl">Security Access</span>
                  <strong>Gated & Monitored 24/7</strong>
                </div>
              </div>
            </div>

            {block.features && block.features.length > 0 && (
              <div class="block-features-wrap">
                <h3 class="block-features-title">Sector Highlights & Landmarks</h3>
                <ul class="block-features-list">
                  {block.features.map((feat) => (
                    <li class="block-feature-item">
                      <span class="block-feature-check">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Properties in this Block -->
          <div class="block-properties-section">
            <div class="section-header-row">
              <div>
                <span class="eyebrow">Available Inventory</span>
                <h2 class="section-header__title">Plots & Properties in {block.name}</h2>
              </div>
              <Button href={`/properties?block=${encodeURIComponent(block.name)}`} variant="outline" size="sm">
                View All Plots →
              </Button>
            </div>

            {blockProperties.length > 0 ? (
              <div class="block-prop-grid">
                {blockProperties.map((prop) => (
                  <PropertyCard
                    title={prop.title}
                    slug={prop.slug}
                    propertyType={prop.propertyType}
                    purpose={prop.purpose}
                    price={prop.price}
                    priceUnit={prop.priceUnit}
                    size={prop.size}
                    sizeUnit={prop.unit}
                    block={prop.block}
                    location={prop.location.address}
                    image={prop.images && prop.images.length > 0 ? prop.images[0] : undefined}
                    verificationStatus={prop.verificationStatus}
                    availabilityStatus={prop.availabilityStatus}
                    lastVerifiedDate={prop.lastVerifiedDate}
                    isFeatured={prop.isFeatured}
                  />
                ))}
              </div>
            ) : (
              <div class="block-empty-card">
                <p>New verified listings for {block.name} are being added. Contact our official desk for off-market inventory.</p>
                <a
                  href={`https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hello! Please share current plot rates and available inventory for ${block.name}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn--accent btn--md"
                >
                  Request {block.name} Rate List on WhatsApp
                </a>
              </div>
            )}
          </div>

          <!-- Block FAQs -->
          <div class="block-faq-card" style="margin-top: 32px;">
            <h3 class="block-faq-card__title">Frequently Asked Questions about {block.name}</h3>
            <div class="faq-list">
              {blockFaqs.map((f) => (
                <div class="faq-item">
                  <h4 class="faq-item__q">Q: {f.question}</h4>
                  <p class="faq-item__a">{f.answer}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="block-page-sidebar">
          <div class="block-cta-card">
            <h3 class="block-cta-card__title">Inquire About {block.name}</h3>
            <p class="block-cta-card__text">
              Speak directly with an authorized representative for map location, title verification, and available plot numbers.
            </p>
            <a
              href={`https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hello! I am interested in ${block.name} in Al Rehman Garden Phase 2.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--accent btn--lg btn--full"
            >
              WhatsApp Inquiry
            </a>
            <a href={`tel:${CONTACTS.phone.primary}`} class="btn btn--secondary btn--md btn--full" style="margin-top: 10px;">
              📞 Call {CONTACTS.phone.display}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .block-detail-header {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .block-detail-header__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .block-detail-header__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0 0 var(--space-6);
  }

  .block-detail-header__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .block-stat-pill {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(212, 175, 55, 0.35);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-neutral-200);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .block-stat-pill strong {
    color: #F3D375;
  }

  .block-page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .block-page-grid {
      grid-template-columns: 1fr 340px;
    }
  }

  .block-info-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-8);
  }

  .block-info-card__title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-5);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }

  .block-specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .block-specs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .block-spec-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-neutral-50);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .block-spec-icon {
    font-size: 20px;
  }

  .block-spec-lbl {
    display: block;
    font-size: 10px;
    font-weight: var(--font-bold);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .block-spec-item strong {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .block-features-wrap {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-light);
  }

  .block-features-title {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .block-features-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .block-features-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .block-feature-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .block-feature-check {
    color: #059669;
    font-weight: var(--font-extrabold);
  }

  .block-prop-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .block-prop-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .block-empty-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .block-empty-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .block-faq-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .block-faq-card__title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-4);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .faq-item__q {
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin: 0 0 var(--space-1);
  }

  .faq-item__a {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* Sidebar */
  .block-cta-card {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-xl);
    position: sticky;
    top: 96px;
  }

  .block-cta-card__title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .block-cta-card__text {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
  }
</style>
