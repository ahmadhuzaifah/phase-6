---
import GuidePage from '@components/content/GuidePage.astro';
---

<GuidePage
  title="DHA Phase 6 Verification and Transfer Guide"
  metaTitle="DHA Phase 6 Lahore Property Verification and Transfer Checklist"
  description="A practical due-diligence checklist for ownership, dues, NDC, identity, site inspection and transfer when buying DHA Phase 6 Lahore property."
  facts={[
    { label: 'First rule', value: 'Verify the exact property' },
    { label: 'Official checkpoint', value: 'DHA Lahore records and process' },
    { label: 'Payment rule', value: 'Document every transaction' },
    { label: 'Professional help', value: 'Use qualified legal advice' },
  ]}
  sections={[
    {
      heading: 'Before paying a token',
      paragraphs: [
        'Match the seller identity, property number, sector, size and document trail. Ask DHA Lahore about the current verification and transfer process and confirm outstanding dues, restrictions and the requirements for a No Demand Certificate.',
        'A portal screenshot, WhatsApp image or dealer statement is not a substitute for official verification. Do not send funds merely because an advertisement is marked urgent or verified.',
      ],
      bullets: ['Seller identity and authority to sell', 'Original allocation or title documents', 'Property number and map position', 'Dues, charges and NDC requirements', 'Transfer eligibility and appointment process', 'Tax and payment documentation'],
    },
    {
      heading: 'Inspect the physical property',
      paragraphs: [
        'For plots, confirm demarcation, access, levels and boundaries. For houses, inspect structure, services, approved drawings, completion status and alterations. A qualified surveyor, architect or engineer may be appropriate.',
      ],
    },
    {
      heading: 'Complete the official process',
      paragraphs: [
        'Use the current DHA Lahore process for transfer and keep stamped receipts, signed agreements and identity records. Requirements can change, so confirm current forms, fees and appointment rules directly before the transaction.',
      ],
    },
  ]}
  faqs={[
    { question: 'Does a source link mean a listing is verified?', answer: 'No. It only shows where the asking-price snapshot came from. Ownership, availability and transfer eligibility still require independent checks.' },
    { question: 'Should I pay a token before checking documents?', answer: 'Avoid committing funds until the parties, property and current official requirements have been checked and the payment terms are documented.' },
  ]}
  sources={[
    { label: 'DHA Lahore official website', href: 'https://dhalahore.org/' },
    { label: 'DHA Lahore official FAQs', href: 'https://dhalahore.org/faqs/' },
  ]}
/>
