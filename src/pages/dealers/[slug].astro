---
/**
 * Dynamic Dealer Profile Page Template — Al Rehman Garden Phase 2
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import { SITE } from '@data/site';
import { DEALERS } from '@data/dealers';
import propertiesData from '@data/properties-import.json';

export async function getStaticPaths() {
  return DEALERS.map((dealer) => ({
    params: { slug: dealer.slug },
    props: { dealer },
  }));
}

const { dealer } = Astro.props;

// Filter properties managed by this dealer
const dealerProperties = propertiesData.filter((p) =>
  dealer.specializationBlocks.some((blk) => p.block.includes(blk.split(' ')[0]))
);

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Dealers',
      item: `${SITE.url}/dealers`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: dealer.name,
      item: `${SITE.url}/dealers/${dealer.slug}`,
    },
  ],
};
---

<PageLayout
  title={`${dealer.name} — Verified Property Dealer | ${SITE.name}`}
  description={`${dealer.name} at ${dealer.agencyName} specializing in Al Rehman Garden Phase 2 Lahore. Experience: ${dealer.experienceYears}+ years, Rating: ${dealer.rating}/5.0. Verified property listings.`}
>
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />

  <section class="dealer-profile-hero">
    <div class="container">
      <div class="dealer-profile-header">
        <div class="dealer-avatar-lg">
          <span>{dealer.name.charAt(0)}</span>
        </div>
        <div class="dealer-profile-info">
          <div class="dealer-profile-badge">✓ Verified Authorized Dealer</div>
          <h1 class="dealer-profile-name">{dealer.name}</h1>
          <p class="dealer-profile-agency">{dealer.agencyName} • {dealer.experienceYears}+ Years Experience in Society</p>
          <div class="dealer-profile-contact-row">
            <span>📍 {dealer.officeAddress}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="dealer-page-grid">
        <div class="dealer-page-main">
          <!-- Overview Card -->
          <div class="dealer-info-card">
            <h2 class="dealer-info-card__title">About {dealer.name}</h2>
            <p>{dealer.description}</p>
            <div class="dealer-highlights-grid">
              <div class="d-hl-item">
                <span class="d-hl-icon">🏆</span>
                <div>
                  <span class="d-hl-lbl">Deals Closed</span>
                  <strong>{dealer.totalDeals}+ Verified Transactions</strong>
                </div>
              </div>
              <div class="d-hl-item">
                <span class="d-hl-icon">⭐</span>
                <div>
                  <span class="d-hl-lbl">Client Rating</span>
                  <strong>{dealer.rating.toFixed(1)} / 5.0 Star Feedback</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- Listings by Dealer -->
          <div class="dealer-inventory-section">
            <div class="section-header-row">
              <div>
                <span class="eyebrow">Active Inventory</span>
                <h2 class="section-header__title">Properties Recommended by {dealer.name}</h2>
              </div>
            </div>

            <div class="dealer-prop-grid">
              {dealerProperties.slice(0, 6).map((prop) => (
                <PropertyCard
                  title={prop.title}
                  slug={prop.slug}
                  propertyType={prop.propertyType}
                  purpose={prop.purpose}
                  price={prop.price}
                  priceUnit={prop.priceUnit}
                  size={prop.size}
                  sizeUnit={prop.unit}
                  block={prop.block}
                  location={prop.location.address}
                  verificationStatus={prop.verificationStatus}
                  isFeatured={prop.isFeatured}
                />
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar Direct Inquiry -->
        <aside class="dealer-page-sidebar">
          <div class="dealer-connect-box">
            <h3 class="dealer-connect-box__title">Contact {dealer.name}</h3>
            <p class="dealer-connect-box__desc">
              Connect directly via WhatsApp or phone for direct plot inspections and title checks.
            </p>
            <a
              href={`https://wa.me/${dealer.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hello ${dealer.name}! I am looking for property assistance in Al Rehman Garden Phase 2.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--accent btn--lg btn--full"
            >
              💬 WhatsApp Direct
            </a>
            <a
              href={`tel:${dealer.phone}`}
              class="btn btn--secondary btn--md btn--full"
              style="margin-top: 10px;"
            >
              📞 Call {dealer.phone}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .dealer-profile-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .dealer-profile-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .dealer-profile-header {
      flex-direction: row;
      align-items: center;
    }
  }

  .dealer-avatar-lg {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-lg);
  }

  .dealer-profile-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--font-bold);
    color: #059669;
    background: #ECFDF5;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-2);
  }

  .dealer-profile-name {
    color: #FFFFFF;
    margin: 0 0 4px;
  }

  .dealer-profile-agency {
    color: var(--color-neutral-300);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }

  .dealer-profile-contact-row {
    font-size: var(--text-xs);
    color: var(--color-neutral-400);
  }

  .dealer-page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .dealer-page-grid {
      grid-template-columns: 1fr 340px;
    }
  }

  .dealer-info-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-8);
  }

  .dealer-info-card__title {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }

  .dealer-info-card p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .dealer-highlights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .dealer-highlights-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .d-hl-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-neutral-50);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .d-hl-icon {
    font-size: 24px;
  }

  .d-hl-lbl {
    display: block;
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .d-hl-item strong {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .dealer-prop-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .dealer-prop-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .dealer-connect-box {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-xl);
    position: sticky;
    top: 96px;
  }

  .dealer-connect-box__title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .dealer-connect-box__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
  }
</style>
