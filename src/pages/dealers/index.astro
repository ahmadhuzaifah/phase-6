    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
  </button>

  <!-- Client-side Interactive Script -->
  <script is:inline>
    // 1. WhatsApp Dynamic Message
    const agentWhatsapp = document.querySelector('[data-agent-whatsapp]');
    const updateWhatsappLink = () => {
      if (!agentWhatsapp) return;
      const phone = agentWhatsapp.dataset.whatsappPhone;
      const message = agentWhatsapp.dataset.whatsappMessage;
      if (!phone || !message) return;
      const fullMessage = `${message}\n\nSource: ${window.location.href}`;
      agentWhatsapp.href = `https://wa.me/${phone}?text=${encodeURIComponent(fullMessage)}`;
    };
    updateWhatsappLink();
    agentWhatsapp?.addEventListener('click', updateWhatsappLink);

    // 2. Agent Popup Display & Dismissal
    const popup = document.querySelector('#agentContactPopup');
    const popupClose = document.querySelector('#agentPopupClose');
    const dismissedKey = 'dha-agent-popup-dismissed';
    let isDismissed = false;
    try {
      isDismissed = sessionStorage.getItem(dismissedKey) === 'true';
    } catch {
      isDismissed = false;
    }

    if (popup && !isDismissed) {
      window.setTimeout(() => {
        popup.hidden = false;
        window.requestAnimationFrame(() => popup.classList.add('visible'));
      }, 2200);
    }

    popupClose?.addEventListener('click', () => {
      if (popup) {
        popup.classList.remove('visible');
        window.setTimeout(() => { popup.hidden = true; }, 250);
        try { sessionStorage.setItem(dismissedKey, 'true'); } catch {}
      }
    });

    // 3. Navbar Scrolled State & Back to Top
    const navbar = document.querySelector('#navbar');
    const backToTop = document.querySelector('#backToTop');
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      if (navbar) {
        if (scrollY > 50) navbar.classList.add('scrolled');
        else navbar.classList.remove('scrolled');
      }
      if (backToTop) {
        if (scrollY > 400) backToTop.classList.add('visible');
        else backToTop.classList.remove('visible');
      }
    }, { passive: true });

    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // 4. Mobile Menu Toggle
    const navToggle = document.querySelector('#navToggle');
    const navLinks = document.querySelector('#navLinks');
    navToggle?.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', String(!isExpanded));
      navToggle.classList.toggle('active');
      navLinks?.classList.toggle('active');
    });

    navLinks?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navToggle?.setAttribute('aria-expanded', 'false');
        navToggle?.classList.remove('active');
        navLinks?.classList.remove('active');
      });
    });

    // 5. Scroll Reveal Animation
    const revealElements = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.15 });

    revealElements.forEach(el => revealObserver.observe(el));
  </script>
</body>
