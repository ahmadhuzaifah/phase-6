      target="_blank"
      rel="noopener noreferrer"
      data-agent-whatsapp
      data-whatsapp-phone="923257800001"
      data-whatsapp-message="Hi Ahmad Huzaifah, I am looking for a property in DHA Phase 6 Lahore. Please guide me about the available options."
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.6 9.6 0 0 1-4-1l-5 1 1-5a9.6 9.6 0 0 1-1-4 8.5 8.5 0 1 1 17 0z"></path><path d="M8.5 8.5c.5 3 2 4.5 5 5"></path></svg>
      Chat on WhatsApp
    </a>
  </aside>

  <!-- Back to top button -->
