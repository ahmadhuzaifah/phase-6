---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
const groups = [
  { title: 'Property research', links: [['All properties','/properties'],['Plots','/plots'],['Houses','/houses'],['Commercial','/commercial'],['Prices','/dha-phase-6-lahore-prices'],['Property desk','/dealers']] },
  { title: 'Area information', links: [['Sector directory','/sectors'],['Map guide','/dha-phase-6-lahore-map'],['Location','/location'],['Amenities','/dha-phase-6-lahore-amenities'],['Places','/places'],['Utilities','/utilities']] },
  { title: 'Practical resources', links: [['Construction','/construction'],['Guides','/guides'],['FAQs','/faq'],['Downloads','/downloads'],['Jobs','/jobs'],['Helplines','/helplines'],['Postal code','/postal-code'],['Prayer times','/prayer-times']] },
  { title: 'Website', links: [['About','/about'],['Contact','/contact'],['Privacy','/privacy-policy'],['Terms','/terms-and-conditions'],['Disclaimer','/disclaimer'],['Copyright','/copyright-policy']] },
];
---
<PageLayout title="DHA Phase 6 Lahore Sitemap" description="Browse the complete DHA Phase 6 Lahore independent property portal by topic.">
  <Schema type="BreadcrumbList" data={{ itemListElement: [{ '@type':'ListItem', position:1, name:'Home', item:SITE.url },{ '@type':'ListItem', position:2, name:'Sitemap', item:`${SITE.url}/sitemap` }] }} />
  <header class="hero"><div class="container"><p>All portal sections</p><h1>HTML sitemap</h1><span>Find property, sector, map, daily-life and legal resources.</span></div></header>
  <section><div class="container grid">{groups.map(group=><article><h2>{group.title}</h2>{group.links.map(link=><a href={link[1]}>{link[0]}</a>)}</article>)}</div></section>
</PageLayout>
<style>.hero{padding:5rem 0;background:radial-gradient(circle at 80% 0,#25254d,#111128 40%,#0a0a1a 78%);color:#fff;border-bottom:1px solid rgba(16,185,129,.18)}.hero p{color:#10b981;text-transform:uppercase;font-size:.72rem;font-weight:900;letter-spacing:.15em}.hero h1{margin:.4rem 0;color:#fff;font-family:var(--font-display);font-size:clamp(3rem,8vw,6rem)}.hero span{color:#9a9ab5}section{padding:5rem 0;background:#0a0a1a}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08)}.grid article{display:flex;flex-direction:column;gap:.7rem;padding:2rem;background:linear-gradient(145deg,#161635,#111128)}.grid h2{color:#f0f0f5;font-family:var(--font-display);font-size:1.8rem}.grid a{color:#10b981}@media(max-width:650px){.grid{grid-template-columns:1fr}}</style>
