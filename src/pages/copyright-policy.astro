<GuidePage
  title="Copyright and content policy"
  description="Copyright, attribution and content-removal policy for the independent DHA Phase 6 Lahore portal."
  eyebrow="Content standards"
  sections={[
    { heading: 'Original portal content', paragraphs: ['Original editorial writing, interface code and site-owned graphics are protected by applicable copyright law. Factual source references and links remain associated with their respective publishers.'] },
    { heading: 'Third-party photographs', paragraphs: ['This portal does not intentionally copy, remove watermarks from or rebrand third-party property photographs. Where image rights are unavailable, a neutral site-owned graphic is shown with a direct link to the original listing source.'] },
    { heading: 'Official resources', paragraphs: ['Official map and regulation links point to DHA Lahore. The linked documents retain their original ownership, branding and terms. This portal does not claim ownership of them.'] },
    { heading: 'Removal requests', paragraphs: ['A rights holder may identify a specific URL and describe the copyrighted work or inaccurate record through the contact page. Valid requests will be reviewed and the relevant content may be corrected or removed.'] },
  ]}
/>
