---
/**
 * Privacy Policy — Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const pageSchema = {
  name: `Privacy Policy — ${SITE.name}`,
  description: 'Learn how Al Rehman Garden Phase 2 Authority Portal collects, utilizes, and protects user information, WhatsApp inquiries, and cookies.',
  url: `${SITE.url}/privacy-policy`,
};
---

<PageLayout
  title={`Privacy Policy | ${SITE.name}`}
  description="Privacy Policy for Al Rehman Garden Phase 2 Lahore Authority Portal. Detailed guidelines on data collection, WhatsApp inquiry handling, analytics, cookies, and user privacy protection."
>
  <Schema type="WebSite" data={pageSchema} />

  <section class="legal-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Legal Transparency</div>
      <h1 class="legal-hero__title">Privacy <span class="text-gradient-gold">Policy</span></h1>
      <p class="legal-hero__lead lead">
        Last updated: September 1, 2026. This policy describes how your information is handled when using our real estate directory and advisory channels.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="legal-card">
        <div class="legal-prose">
          <h2>1. Introduction</h2>
          <p>
            Welcome to the <strong>Al Rehman Garden Phase 2 Lahore Real Estate Authority Portal</strong> ("Platform", "we", "us", or "our"). We are committed to protecting the privacy, confidentiality, and security of our visitors, property buyers, sellers, and authorized real estate consultants.
          </p>

          <h2>2. Information We Collect</h2>
          <p>We may collect information through the following voluntary and automated interactions:</p>
          <ul>
            <li><strong>Contact & Property Requests:</strong> Full name, telephone number, WhatsApp contact details, email address, preferred block/sector, plot dimensions, and budgetary requirements submitted via our "Find My Property" or inquiry forms.</li>
            <li><strong>Direct Communication Data:</strong> Messages, property queries, and rate sheet requests initiated through our direct WhatsApp link or telephone helpline.</li>
            <li><strong>Automated Device & Usage Analytics:</strong> IP address, browser type, operating system, referring URL, pages visited, time spent per listing, and search filters applied, gathered via Google Analytics 4 (GA4).</li>
          </ul>

          <h2>3. How We Use Your Information</h2>
          <p>The information collected is used strictly for legitimate real estate advisory purposes:</p>
          <ul>
            <li>To match your investment criteria with verified on-ground plots, houses, and commercial broadway units in Al Rehman Garden Phase 2.</li>
            <li>To facilitate direct communication between you and authorized society property advisors.</li>
            <li>To generate anonymous, aggregate market demand metrics (e.g. popular plot sizes and block view percentages).</li>
            <li>To detect and prevent fraudulent property duplicate claims or spam submissions.</li>
          </ul>

          <h2>4. WhatsApp & Communication Protocols</h2>
          <p>
            When you initiate a WhatsApp chat or submit an inquiry, we use your number exclusively to provide verified rate sheets, society maps, NOC status documentation, or arrange on-site visits. <strong>We do not sell, rent, or distribute your telephone number to unauthorized third-party marketing telemarketers.</strong>
          </p>

          <h2>5. Cookies & Tracking Technologies</h2>
          <p>
            Our portal uses essential session cookies and anonymous analytics cookies to maintain user preferences, measure page load performance, and optimize navigation. You can adjust your browser settings to decline cookies; however, certain interactive filtering features may be affected.
          </p>

          <h2>6. Third-Party Links & Services</h2>
          <p>
            Our portal contains outbound links to official regulatory portals (such as the Lahore Development Authority - LDA), mapping services (Google Maps), and certified real estate agencies. We are not responsible for the privacy practices or content of external third-party domains.
          </p>

          <h2>7. User Rights & Data Deletion</h2>
          <p>
            You have the right to request access to any personal inquiry data held by us, request correction of inaccurate contact records, or request complete deletion of your past inquiries from our internal CRM.
          </p>
          <p>
            To exercise your data privacy rights, please contact our Data Governance Desk at <a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a> or via mail at:
          </p>
          <div class="legal-contact-box">
            <strong>Data Privacy & Governance Officer</strong><br />
            {SITE.name} Public Information Desk<br />
            {CONTACTS.address.full}<br />
            Email: {CONTACTS.email} • Helpline: {CONTACTS.phone.display}
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .legal-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .legal-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .legal-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .legal-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8) var(--space-10);
    box-shadow: var(--shadow-card);
    max-width: 900px;
    margin: 0 auto;
  }

  .legal-prose h2 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-8) 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }

  .legal-prose h2:first-of-type {
    margin-top: 0;
  }

  .legal-prose p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .legal-prose ul {
    margin: 0 0 var(--space-4) var(--space-6);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .legal-prose li {
    margin-bottom: var(--space-2);
  }

  .legal-contact-box {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin-top: var(--space-4);
  }
</style>
