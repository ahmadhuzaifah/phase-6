---
/**
 * Al Rehman Garden Phase 2 Payment Plan Guide — Authority SEO Hub
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { CONTACTS } from '@data/contacts';

const paymentPlans = [
  { size: '3 Marla', booking: 'PKR 250,000', monthly: 'PKR 15,000', semiAnnual: 'PKR 65,000', total: 'PKR 1,450,000', duration: '3.5 - 5 Years' },
  { size: '5 Marla', booking: 'PKR 380,000', monthly: 'PKR 24,000', semiAnnual: 'PKR 110,000', total: 'PKR 2,450,000', duration: '3.5 - 5 Years' },
  { size: '8 Marla', booking: 'PKR 550,000', monthly: 'PKR 35,000', semiAnnual: 'PKR 170,000', total: 'PKR 3,750,000', duration: '3 - 4 Years' },
  { size: '10 Marla', booking: 'PKR 700,000', monthly: 'PKR 45,000', semiAnnual: 'PKR 220,000', total: 'PKR 4,800,000', duration: '3 - 4 Years' },
  { size: '1 Kanal', booking: 'PKR 1,200,000', monthly: 'PKR 85,000', semiAnnual: 'PKR 420,000', total: 'PKR 8,900,000', duration: '3 Years' },
  { size: '2 Marla Comm', booking: 'PKR 800,000', monthly: 'PKR 60,000', semiAnnual: 'PKR 300,000', total: 'PKR 5,500,000', duration: '2.5 - 3 Years' },
  { size: '4 Marla Comm', booking: 'PKR 1,500,000', monthly: 'PKR 120,000', semiAnnual: 'PKR 600,000', total: 'PKR 11,500,000', duration: '2.5 - 3 Years' },
];

const faqs = [
  {
    question: 'Are installment payment plans available in Al Rehman Garden Phase 2?',
    answer: 'Yes, flexible 3 to 5-year installment plans are available for newly launched residential sectors (such as Mirabel Block, Beverly Hills, and extensions of Block E and F), with down payments starting from 15-20%.',
  },
  {
    question: 'How do cash plots differ from installment plots in Phase 2?',
    answer: 'Cash plots are 100% developed on-ground with immediate possession (ready for construction), located in mature sectors like Block A, B, C, and D. Installment plots offer lower initial capital entry spread over monthly installments.',
  },
  {
    question: 'Are there hidden development charges?',
    answer: 'All official payment plans clearly specify whether development charges are included or scheduled in installment milestones. Always verify with the authorized society office.',
  },
];

const faqSchema = {
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<PageLayout
  title="Al Rehman Garden Phase 2 Payment Plan 2026 — Installment Schedules"
  description="Explore official installment payment plans for Al Rehman Garden Phase 2 Lahore. View down payments, monthly installments, and total costs for 3, 5, 8, 10 Marla & 1 Kanal plots."
>
  <Schema type="FAQPage" data={faqSchema} />

  <section class="auth-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Flexible Installments & Booking</div>
      <h1 class="auth-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">Payment Plan</span>
      </h1>
      <p class="auth-hero__lead lead">
        Detailed breakdown of booking amounts, monthly installments, balloting charges, and possession schedules across residential and commercial sectors.
      </p>
      <div class="auth-meta-bar">
        <span>📅 Last Updated: September 2026</span>
        <span>🛡️ Source: Al Rehman Developers Official Schedule</span>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="pay-card">
        <div class="pay-card__header">
          <div>
            <span class="pay-card__tag">Installment Matrix</span>
            <h2 class="pay-card__title">Standard Installment Payment Plans (3 to 5 Years)</h2>
          </div>
          <a
            href={CONTACTS.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--accent btn--sm"
          >
            Get PDF Schedule on WhatsApp
          </a>
        </div>

        <div class="table-responsive">
          <table class="plan-table">
            <thead>
              <tr>
                <th>Plot Size</th>
                <th>Booking Down Payment</th>
                <th>Monthly Installment</th>
                <th>Semi-Annual Balloon</th>
                <th>Est. Total Price</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              {paymentPlans.map((p) => (
                <tr>
                  <td><strong>{p.size}</strong></td>
                  <td><span class="highlight-val">{p.booking}</span></td>
                  <td>{p.monthly}</td>
                  <td>{p.semiAnnual}</td>
                  <td><strong>{p.total}</strong></td>
                  <td>{p.duration}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="pay-card__notice">
          <p>
            * Prices and installment structures may vary by block launch and location premium (Corner, Park Facing, Boulevard). Contact advisory desk for active file inventory.
          </p>
        </div>
      </div>

      <!-- FAQ Card -->
      <div class="auth-faq-card" style="margin-top: 32px;">
        <h2 class="auth-faq-card__title">Payment Plan FAQs</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <h3 class="faq-item__q">Q: {f.question}</h3>
              <p class="faq-item__a">{f.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .auth-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .auth-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .auth-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0 0 var(--space-4);
  }

  .auth-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: #F3D375;
  }

  .pay-card {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-xl);
  }

  .pay-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-light);
  }

  @media (min-width: 640px) {
    .pay-card__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .pay-card__tag {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: var(--color-primary-700);
    text-transform: uppercase;
  }

  .pay-card__title {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .table-responsive {
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  .plan-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .plan-table th {
    background-color: var(--color-secondary-900);
    color: white;
    padding: var(--space-3-5) var(--space-4);
    text-align: left;
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .plan-table td {
    padding: var(--space-3-5) var(--space-4);
    border-bottom: 1px solid var(--border-light);
    color: var(--text-secondary);
  }

  .highlight-val {
    color: var(--color-secondary-900);
    font-weight: var(--font-extrabold);
  }

  .pay-card__notice {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .auth-faq-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .auth-faq-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .faq-item__q {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .faq-item__a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }
</style>
