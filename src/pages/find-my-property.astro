---
/**
 * Find My Property — Custom Property Request System & Lead Acquisition
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { BLOCKS } from '@data/blocks';
import { CONTACTS } from '@data/contacts';

const pageSchema = {
  name: 'Find My Property — Custom Real Estate Matching Service',
  description: 'Submit your property requirements for DHA Phase 6 Lahore and request a source comparison, shortlist or viewing conversation.',
  url: `${SITE.url}/find-my-property`,
};
---

<PageLayout
  title={`Find My Property — Custom Plot & House Matcher | ${SITE.name}`}
  description="Looking for a plot, house or commercial property in DHA Phase 6 Lahore? Share your budget and preferred sector for a source comparison and shortlist."
>
  <Schema type="WebSite" data={pageSchema} />

  <section class="finder-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">VIP Property Matcher</div>
      <h1 class="finder-hero__title">
        Find My Property in <span class="text-gradient-gold">DHA Phase 6 Lahore</span>
      </h1>
      <p class="finder-hero__lead lead">
        Share your preferred size, sector and budget. The property desk can compare public sources and discuss a shortlist, but every option still requires independent verification.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="finder-grid">
        <!-- Main Interactive Form -->
        <div class="finder-form-card">
          <div class="finder-form-card__header">
            <h2 class="finder-form-card__title">Submit Your Property Request</h2>
            <p class="finder-form-card__subtitle">We will review your brief and respond using the contact details you provide.</p>
          </div>

          <form class="finder-form" id="property-finder-form" action="/contact" method="post">
            <div class="form-row">
              <div class="form-group">
                <label for="finder-name" class="form-label">Full Name *</label>
                <input type="text" id="finder-name" name="name" required placeholder="e.g. Tariq Mehmood" class="form-input" />
              </div>
              <div class="form-group">
                <label for="finder-phone" class="form-label">Phone Number *</label>
                <input type="tel" id="finder-phone" name="phone" required placeholder="e.g. 0300-1234567" class="form-input" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="finder-whatsapp" class="form-label">WhatsApp Number</label>
                <input type="tel" id="finder-whatsapp" name="whatsapp" placeholder="e.g. 0300-1234567" class="form-input" />
              </div>
              <div class="form-group">
                <label for="finder-type" class="form-label">Property Category *</label>
                <select id="finder-type" name="propertyType" class="form-select">
                  <option value="residential-plot">Residential Plot (3, 5, 8, 10 Marla, 1 Kanal)</option>
                  <option value="commercial-plot">Commercial Broadway Plot (2, 4, 8 Marla)</option>
                  <option value="house-sale">Brand New Ready House (For Sale)</option>
                  <option value="house-rent">House / Upper Portion (For Rent)</option>
                  <option value="installment-file">Installment Payment Plan File</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="finder-block" class="form-label">Preferred Block / Sector</label>
                <select id="finder-block" name="block" class="form-select">
                  <option value="any">Any Prime Block</option>
                  {BLOCKS.map((b) => (
                    <option value={b.slug}>{b.name}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label for="finder-budget" class="form-label">Estimated Budget</label>
                <select id="finder-budget" name="budget" class="form-select">
                  <option value="under-30-lakh">Under PKR 30 Lakh</option>
                  <option value="30-50-lakh" selected>PKR 30 Lakh to 50 Lakh</option>
                  <option value="50-80-lakh">PKR 50 Lakh to 80 Lakh</option>
                  <option value="80-lakh-1.5-cr">PKR 80 Lakh to 1.50 Crore</option>
                  <option value="above-1.5-cr">PKR 1.50 Crore+</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="finder-notes" class="form-label">Specific Requirements / Preferences</label>
              <textarea id="finder-notes" name="notes" rows="3" placeholder="e.g. Corner plot, Park facing, 40ft road, ready for immediate construction..." class="form-textarea"></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--full">
              Find Matching Properties →
            </button>
          </form>
        </div>

        <!-- Sidebar / Direct WhatsApp Matching -->
        <aside class="finder-sidebar">
          <div class="finder-fast-box">
            <div class="finder-fast-badge">⚡ Instant Assistance</div>
            <h3 class="finder-fast-title">Prefer Direct Chat?</h3>
            <p class="finder-fast-desc">
              Connect directly with our senior on-site property advisor on WhatsApp for instant rate sheets, map coordinates, and available plot numbers.
            </p>
            <a
              href={CONTACTS.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--accent btn--lg btn--full"
            >
              💬 WhatsApp Property Desk
            </a>
            <hr class="finder-hr" />
            <div class="finder-perks">
              <div class="perk-item">✓ 100% Free Consultation</div>
              <div class="perk-item">✓ Direct Allotment Verification</div>
              <div class="perk-item">✓ No Duplicate / Fake Listings</div>
              <div class="perk-item">✓ Physical Guided Site Tour</div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .finder-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .finder-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .finder-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .finder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .finder-grid {
      grid-template-columns: 1fr 340px;
    }
  }

  .finder-form-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .finder-form-card__header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-light);
  }

  .finder-form-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-1);
  }

  .finder-form-card__subtitle {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
  }

  .finder-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .form-label {
    font-size: 11.5px;
    font-weight: var(--font-bold);
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-3-5);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    background-color: var(--color-neutral-50);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--color-primary-500);
    outline: none;
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.15);
  }

  .finder-fast-box {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-xl);
    position: sticky;
    top: 96px;
  }

  .finder-fast-badge {
    display: inline-block;
    font-size: 10.5px;
    font-weight: var(--font-extrabold);
    text-transform: uppercase;
    color: var(--color-secondary-950);
    background: var(--gradient-gold);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-2);
  }

  .finder-fast-title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .finder-fast-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .finder-hr {
    border: none;
    border-top: 1px solid var(--border-light);
    margin: var(--space-5) 0;
  }

  .finder-perks {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .perk-item {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: #059669;
  }
</style>
