---
/**
 * Global Portal Omnibox Search — Al Rehman Garden Phase 2 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { BLOCKS } from '@data/blocks';
import { PLACES_DATA } from '@data/places';
import { FAQS_DATA } from '@data/faqs';
import { COMPARISONS_DATA } from '@data/comparisons';
import propertiesData from '@data/properties-import.json';

const pageSchema = {
  name: `Global Search — ${SITE.name}`,
  description: 'Search properties, plot sizes, sector maps, schools, hospitals, investment guides, and FAQs across Al Rehman Garden Phase 2 Lahore.',
  url: `${SITE.url}/search`,
};

// Compile searchable items
const searchableItems = [
  ...propertiesData.map((p) => ({
    type: 'Property',
    typeBadge: '🏠 Property',
    title: p.title,
    subtitle: `${p.size} ${p.unit} • ${p.block} • PKR ${new Intl.NumberFormat('en-PK').format(p.price)}`,
    url: `/properties/${p.slug}`,
    keywords: `${p.title} ${p.block} ${p.size} ${p.unit} ${p.propertyType} ${p.purpose}`,
  })),
  ...BLOCKS.map((b) => ({
    type: 'Block',
    typeBadge: '🏛️ Sector',
    title: `${b.name} Sector Guide`,
    subtitle: `Possession: ${b.possessionPercentage}% • Plot Sizes: ${b.plotSizes.join(', ')}`,
    url: `/blocks/${b.slug}`,
    keywords: `${b.name} ${b.slug} ${b.category} block sector`,
  })),
  ...PLACES_DATA.map((pl) => ({
    type: 'Place',
    typeBadge: '📍 Place',
    title: pl.name,
    subtitle: `${pl.categoryLabel} • Distance: ${pl.distance}`,
    url: `/places/${pl.category}`,
    keywords: `${pl.name} ${pl.category} ${pl.categoryLabel} ${pl.address}`,
  })),
  ...COMPARISONS_DATA.map((c) => ({
    type: 'Comparison',
    typeBadge: '⚖️ Comparison',
    title: c.heroTitle,
    subtitle: `Compare rates, location, and ROI vs ${c.competitorName}`,
    url: `/${c.slug}`,
    keywords: `${c.heroTitle} ${c.competitorName} vs comparison`,
  })),
  ...FAQS_DATA.flatMap((cat) =>
    cat.questions.map((q) => ({
      type: 'FAQ',
      typeBadge: '❓ FAQ',
      title: q.question,
      subtitle: cat.name,
      url: '/faq',
      keywords: `${q.question} ${q.answer} ${cat.name}`,
    }))
  ),
];
---

<PageLayout
  title={`Search Portal | Al Rehman Garden Phase 2 Lahore`}
  description="Instant global search across all property listings, sector guides, schools, hospitals, price index, downloads, and FAQs in Al Rehman Garden Phase 2."
>
  <Schema type="WebSite" data={pageSchema} />

  <!-- Hero Section -->
  <section class="search-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Universal Information Search</div>
      <h1 class="search-hero__title">
        Search the <span class="text-gradient-gold">Phase 2 Portal</span>
      </h1>
      <p class="search-hero__lead lead">
        Instantly search across 100+ verified properties, 15+ society sectors, nearby schools and hospitals, market price indexes, and investor FAQs.
      </p>

      <!-- Search Input Form -->
      <div class="search-input-wrap">
        <span class="search-icon">🔍</span>
        <input
          type="text"
          id="global-search-input"
          placeholder="Try searching: '5 Marla plot', 'Block A', 'Hospital', 'Price', 'DHA vs'..."
          class="global-search-input"
          autofocus
        />
      </div>
    </div>
  </section>

  <!-- Search Results Section -->
  <section class="section section--alt">
    <div class="container">
      <!-- Active Results Counter -->
      <div class="search-toolbar">
        <span id="search-count-label">Showing all searchable portal entries</span>
        <div class="search-filter-pills">
          <button type="button" class="search-type-pill search-type-pill--active" data-type="all">All</button>
          <button type="button" class="search-type-pill" data-type="Property">Properties</button>
          <button type="button" class="search-type-pill" data-type="Block">Sectors</button>
          <button type="button" class="search-type-pill" data-type="Place">Places</button>
          <button type="button" class="search-type-pill" data-type="Comparison">Comparisons</button>
          <button type="button" class="search-type-pill" data-type="FAQ">FAQs</button>
        </div>
      </div>

      <!-- Results Grid -->
      <div class="search-results-grid" id="search-results-grid">
        {searchableItems.map((item) => (
          <a
            href={item.url}
            class="search-item-card"
            data-type={item.type}
            data-keywords={item.keywords.toLowerCase()}
          >
            <div class="search-item__header">
              <span class="search-badge">{item.typeBadge}</span>
            </div>
            <h3 class="search-item__title">{item.title}</h3>
            <p class="search-item__subtitle">{item.subtitle}</p>
            <span class="search-item__link-arrow">View details →</span>
          </a>
        ))}
      </div>

      <!-- Empty State -->
      <div id="search-empty" style="display: none; padding: 60px 20px; background: white; border: 1px dashed var(--border-light); border-radius: var(--radius-2xl); text-align: center; margin-top: 32px;">
        <div style="font-size: 44px; margin-bottom: 12px;">🔎</div>
        <h3 style="font-size: var(--text-xl); margin-bottom: 6px;">No exact matching portal entries found</h3>
        <p style="font-size: var(--text-sm); color: var(--text-secondary); margin-bottom: 20px;">Try typing a broader keyword such as "plot", "house", "block", or "school".</p>
        <button type="button" class="btn btn--primary btn--sm" id="btn-search-reset">Reset Search</button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .search-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .search-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .search-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0 0 var(--space-6);
  }

  .search-input-wrap {
    position: relative;
    max-width: 720px;
  }

  .search-icon {
    position: absolute;
    left: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
  }

  .global-search-input {
    width: 100%;
    padding: var(--space-4) var(--space-5) var(--space-4) 56px;
    font-size: var(--text-base);
    border-radius: var(--radius-full);
    border: 2px solid var(--border-gold);
    background: #FFFFFF;
    color: var(--text-primary);
    box-shadow: var(--shadow-lg);
    transition: all var(--transition-fast);
  }

  .global-search-input:focus {
    outline: none;
    box-shadow: 0 0 0 4px rgba(243, 211, 117, 0.35);
  }

  .search-toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .search-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  #search-count-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: var(--font-semibold);
  }

  .search-filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  .search-type-pill {
    padding: var(--space-1-5) var(--space-3-5);
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .search-type-pill:hover {
    border-color: var(--border-gold);
    color: var(--color-secondary-900);
  }

  .search-type-pill--active {
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    border-color: var(--color-primary-500);
  }

  .search-results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .search-results-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .search-results-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .search-item-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-6);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .search-item-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-gold);
  }

  .search-item__header {
    margin-bottom: var(--space-2);
  }

  .search-badge {
    font-size: 10px;
    font-weight: var(--font-bold);
    background: var(--color-neutral-100);
    color: var(--text-primary);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  .search-item__title {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 4px;
    line-height: var(--leading-snug);
  }

  .search-item__subtitle {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-3);
  }

  .search-item__link-arrow {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: var(--color-primary-600);
    margin-top: auto;
  }
</style>

<script>
  function initGlobalSearch() {
    const input = document.getElementById('global-search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.search-item-card');
    const pills = document.querySelectorAll('.search-type-pill');
    const label = document.getElementById('search-count-label');
    const emptyState = document.getElementById('search-empty');
    const resetBtn = document.getElementById('btn-search-reset');

    // Read initial URL query parameter e.g. ?q=5-marla
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    if (input && initialQuery) {
      input.value = initialQuery;
    }

    let currentTypeFilter = 'all';

    function applySearch() {
      const q = (input?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((c) => {
        const cardEl = c as HTMLElement;
        const keywords = cardEl.getAttribute('data-keywords') || '';
        const itemType = cardEl.getAttribute('data-type') || '';

        let matchesSearch = !q || keywords.includes(q);
        let matchesType = currentTypeFilter === 'all' || itemType === currentTypeFilter;

        if (matchesSearch && matchesType) {
          cardEl.style.display = '';
          visibleCount++;
        } else {
          cardEl.style.display = 'none';
        }
      });

      if (label) {
        label.textContent = q
          ? `Found ${visibleCount} result(s) for "${q}"`
          : `Showing ${visibleCount} portal entries`;
      }

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    input?.addEventListener('input', applySearch);

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        pills.forEach((el) => el.classList.remove('search-type-pill--active'));
        p.classList.add('search-type-pill--active');
        currentTypeFilter = p.getAttribute('data-type') || 'all';
        applySearch();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      currentTypeFilter = 'all';
      pills.forEach((el) => el.classList.remove('search-type-pill--active'));
      pills[0]?.classList.add('search-type-pill--active');
      applySearch();
    });

    applySearch();
  }

  document.addEventListener('DOMContentLoaded', initGlobalSearch);
</script>
