---
/**
 * Plots For Sale in Al Rehman Garden Phase 2 Lahore — Local SEO Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import Button from '@components/global/Button.astro';
import { SITE } from '@data/site';
import propertiesData from '@data/properties-import.json';

const plots = propertiesData.filter((p) => p.propertyType.includes('plot'));

const pageSchema = {
  name: 'Plots for Sale in DHA Phase 6 Lahore',
  description: 'Verified 5, 10 Marla, 1 & 2 Kanal residential and commercial Broadway plots for sale in DHA Phase 6 Lahore.',
  url: `${SITE.url}/plots-for-sale-in-al-rehman-garden-phase-2-lahore`,
};
---

<PageLayout
  title="Plots for Sale in DHA Phase 6 Lahore — Verified Plot Rates 2026"
  description="Buy verified residential & commercial plots in DHA Phase 6 Lahore. Ready possession 5, 10 Marla, 1 & 2 Kanal plots and CCA commercial broadways."
>
  <Schema type="WebSite" data={pageSchema} />

  <section class="local-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Verified Plot Inventory</div>
      <h1 class="local-hero__title">
        Plots for Sale in <span class="text-gradient-gold">DHA Phase 6 Lahore</span>
      </h1>
      <p class="local-hero__lead lead">
        Explore 100% on-ground residential plots and high-yield commercial properties with underground utilities, ready possession, and direct Ring Road access.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">On-Ground Availability</span>
          <h2 class="section-header__title">Available Plot Listings</h2>
        </div>
        <Button href="/properties" variant="outline" size="sm">
          All Listings & Custom Filters →
        </Button>
      </div>

      <div class="local-grid">
        {plots.map((prop) => (
          <PropertyCard
            title={prop.title}
            slug={prop.slug}
            propertyType={prop.propertyType}
            purpose={prop.purpose}
            price={prop.price}
            priceUnit={prop.priceUnit}
            size={prop.size}
            sizeUnit={prop.unit}
            block={prop.block}
            location={prop.location.address}
            image={prop.images && prop.images.length > 0 ? prop.images[0] : undefined}
            verificationStatus={prop.verificationStatus}
            availabilityStatus={prop.availabilityStatus}
            lastVerifiedDate={prop.lastVerifiedDate}
            isFeatured={prop.isFeatured}
          />
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .local-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .local-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .local-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .local-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .local-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .local-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
