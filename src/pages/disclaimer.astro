---
/**
 * Legal Disclaimer — Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const pageSchema = {
  name: `Legal & Real Estate Disclaimer — ${SITE.name}`,
  description: 'Important legal disclosure regarding independent authority status, price estimates, on-ground verification, and transaction transparency.',
  url: `${SITE.url}/disclaimer`,
};
---

<PageLayout
  title={`Legal & Real Estate Disclaimer | ${SITE.name}`}
  description="Important legal disclaimer and disclosure for Al Rehman Garden Phase 2 Lahore Authority Portal. Clarity on property availability, rates, independent directory status, and title verification."
>
  <Schema type="WebSite" data={pageSchema} />

  <section class="legal-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Transparency & Compliance</div>
      <h1 class="legal-hero__title">Legal <span class="text-gradient-gold">Disclaimer</span></h1>
      <p class="legal-hero__lead lead">
        Please review our formal disclosures regarding directory listings, society representation, price estimates, and verification obligations.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="legal-card">
        <div class="legal-prose">
          <div class="alert alert--warning" style="margin-bottom: 28px;">
            <div class="alert__icon">⚠️</div>
            <div class="alert__content">
              <strong>Mandatory Notice to Buyers & Investors:</strong>
              This platform serves as an independent real estate information, market analysis, and property directory portal. Always verify original allotment documents with official society management prior to any financial transaction.
            </div>
          </div>

          <h2>1. Independent Information Portal Status</h2>
          <p>
            {SITE.name} ({SITE.url}) is a dedicated real estate research, directory, and advisory authority platform created to provide accurate, transparent, and structured information to home buyers, commercial investors, and overseas Pakistanis.
          </p>
          <p>
            Unless explicitly designated under official contractual mandate, this website is not the primary developer corporation (Al Rehman Developers) itself, but rather an authorized, independent digital information guide and certified dealer networking directory.
          </p>

          <h2>2. Market Prices & Volatility Notice</h2>
          <p>
            The property rates, installment schedules, down payments, and market value estimates displayed on this platform are compiled through weekly field audits, closed registry benchmarks, and authorized broker submissions.
          </p>
          <p>
            Because the Lahore real estate market fluctuates based on infrastructure progress, macroeconomic inflation, and sector possession readiness, <strong>all published prices should be treated as indicative market valuations</strong>.
          </p>

          <h2>3. Property Availability & Status Lags</h2>
          <p>
            High-demand residential and commercial plots (such as 5 Marla and 10 Marla plots in Block A, Block B, and Mirabel Block) are subject to immediate private sales. While our automation pipeline flags listings exceeding 30 days for re-verification, we cannot guarantee that a specific plot remains unsold at the exact minute of your inquiry.
          </p>

          <h2>4. On-Site Inspection & Verification Obligation</h2>
          <p>
            We strictly encourage every prospective buyer to:
          </p>
          <ul>
            <li>Conduct a physical, on-ground site inspection of the plot number and street demarcation.</li>
            <li>Request an official Allotment Verification Certificate from the Al Rehman Garden Head Office.</li>
            <li>Confirm NDC (No Demand Certificate) status and clear utility dues before executing final payment.</li>
          </ul>

          <h2>5. Contact for Compliance & Legal Inquiries</h2>
          <div class="legal-contact-box">
            <strong>Society Information & Compliance Helpdesk:</strong><br />
            {SITE.name}<br />
            {CONTACTS.address.full}<br />
            Helpline: {CONTACTS.phone.display} • Email: {CONTACTS.email}<br />
            WhatsApp Official Desk: <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer">{CONTACTS.phone.display}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .legal-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .legal-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .legal-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .legal-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8) var(--space-10);
    box-shadow: var(--shadow-card);
    max-width: 900px;
    margin: 0 auto;
  }

  .legal-prose h2 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-8) 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }

  .legal-prose h2:first-of-type {
    margin-top: 0;
  }

  .legal-prose p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .legal-prose ul {
    margin: 0 0 var(--space-4) var(--space-6);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .legal-prose li {
    margin-bottom: var(--space-2);
  }

  .legal-contact-box {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin-top: var(--space-4);
  }

  .alert {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
  }

  .alert--warning {
    background: #FFFBEB;
    border: 1px solid #FCD34D;
    color: #92400E;
  }

  .alert__icon {
    font-size: 20px;
  }
</style>
