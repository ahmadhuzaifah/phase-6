---
/**
 * 10 Marla Plot for Sale DHA Phase 6 Lahore — Search Intent Landing Page
 * Route: /10-marla-plot-for-sale-dha-phase-6-lahore/
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const canonical = `${SITE.url}/10-marla-plot-for-sale-dha-phase-6-lahore/`;
const pageTitle = `10 Marla Plot for Sale DHA Phase 6 Lahore — 2026 Sector C & D Prices`;
const metaDesc = `Explore 10 Marla residential plots for sale in DHA Phase 6 Lahore. Real-time plot prices in Sectors C & D (PKR 3.2 to 4.5 Crore), dimensions (35x65), and transfer guidance.`;
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <header class="search-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/plots-for-sale-dha-phase-6-lahore/">Plots for Sale</a> <span>/</span>
        <span aria-current="page">10 Marla Plot for Sale</span>
      </nav>
      <div class="intent-badge">10 Marla Residential &bull; 35 &times; 65 ft &bull; Sectors C &amp; D</div>
      <h1>10 Marla Plot for Sale in DHA Phase 6 Lahore</h1>
      <p class="hero-desc">
        Authoritative pricing guide and market availability for 10 Marla (approx. 2,250 sq ft / 250 sq yds) residential plots in DHA Phase 6 Lahore. 
        Concentrated in prime central Sectors C and D.
      </p>
    </div>
  </header>

  <main class="container search-body">
    <div class="search-layout">
      <div class="search-main">
        <section class="search-card">
          <h2>10 Marla Plot Price Guidance in DHA Phase 6 (2026)</h2>
          <p>
            10 Marla plots in Phase 6 are exclusive to Sector C and Sector D. 
            Because these sectors are located right along Main Boulevard near CCA 1 and top schools, prices reflect strong end-user demand:
          </p>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Sector Location</th>
                  <th>Plot Category</th>
                  <th>Demand Range</th>
                  <th>Possession Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Sector C</strong></td>
                  <td>General 10 Marla Plot</td>
                  <td>PKR 3.20 – 4.25 Crore</td>
                  <td>100% Possession / Ready to Build</td>
                </tr>
                <tr>
                  <td><strong>Sector C</strong></td>
                  <td>Corner / Park Facing Plot</td>
                  <td>PKR 3.60 – 4.70 Crore</td>
                  <td>Premium Category</td>
                </tr>
                <tr>
                  <td><strong>Sector D</strong></td>
                  <td>General 10 Marla Plot</td>
                  <td>PKR 3.40 – 4.50 Crore</td>
                  <td>Adjacent to Beaconhouse</td>
                </tr>
                <tr>
                  <td><strong>Sector D</strong></td>
                  <td>Corner / Main Road Facing</td>
                  <td>PKR 3.80 – 4.90 Crore</td>
                  <td>Premium Category</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="search-card">
          <h2>Why Buy a 10 Marla Plot in DHA Phase 6?</h2>
          <ul>
            <li><strong>Prime Central Density:</strong> Sectors C and D are over 80% occupied with modern luxury homes.</li>
            <li><strong>Walking Distance to Amenities:</strong> Immediate access to the Sector C Grand Mosque, Sector D Beaconhouse, and CCA 1 retail plazas.</li>
            <li><strong>High Resale Value:</strong> Consistent transactional volume ensures high liquidity when you decide to sell.</li>
          </ul>
        </section>
      </div>

      <aside class="search-sidebar">
        <div class="side-box cta-box">
          <h3>10 Marla Plot Desk</h3>
          <p>Get authentic plot numbers, map layouts, and verification support before transferring.</p>
          <a href={`https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hello, I want to inquire about 10 Marla plots for sale in DHA Phase 6 Lahore.')}`} target="_blank" rel="noopener noreferrer" class="btn-wa">
            WhatsApp 10 Marla Desk
          </a>
        </div>
        <div class="side-box">
          <h4>Related Links</h4>
          <ul class="side-nav">
            <li><a href="/1-kanal-plot-for-sale-dha-phase-6-lahore/">1 Kanal Plots</a></li>
            <li><a href="/10-marla-house-for-sale-dha-phase-6-lahore/">10 Marla Built Houses</a></li>
            <li><a href="/dha-phase-6-sector-c-lahore/">Sector C Overview</a></li>
            <li><a href="/dha-phase-6-sector-d-lahore/">Sector D Overview</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</PageLayout>

<style>
  .search-hero { background: linear-gradient(135deg, #090e1a 0%, #1e293b 100%); color: #fff; padding: 3rem 0 2.5rem; }
  .breadcrumb { font-size: 0.8rem; color: #94a3b8; margin-bottom: 1rem; display: flex; gap: 0.45rem; }
  .breadcrumb a { color: #94a3b8; text-decoration: none; }
  .breadcrumb a:hover { color: #10b981; }
  .intent-badge { display: inline-block; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.3rem 0.75rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.75rem; }
  .search-hero h1 { font-family: var(--font-display, Georgia, serif); font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; margin: 0 0 0.85rem; }
  .hero-desc { font-size: 1.05rem; line-height: 1.65; color: #cbd5e1; max-width: 850px; margin: 0; }
  .search-body { padding: 3rem 0; }
  .search-layout { display: grid; grid-template-columns: 1fr 320px; gap: 2.5rem; }
  .search-main { display: flex; flex-direction: column; gap: 2.5rem; }
  .search-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.75rem; }
  .search-card h2 { font-family: var(--font-display, Georgia, serif); font-size: 1.35rem; font-weight: 800; color: #0f172a; margin: 0 0 0.85rem; padding-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; }
  .search-card p { font-size: 0.95rem; line-height: 1.7; color: #334155; margin-bottom: 1rem; }
  .table-wrap { overflow-x: auto; margin-top: 1rem; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .data-table th { background: #f1f5f9; padding: 0.75rem 1rem; text-align: left; font-weight: 700; color: #0f172a; border-bottom: 2px solid #cbd5e1; }
  .data-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #e2e8f0; color: #334155; }
  .search-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
  .side-box { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; }
  .side-box h3, .side-box h4 { font-size: 0.95rem; font-weight: 800; color: #0f172a; margin: 0 0 0.65rem; }
  .cta-box { background: #0f172a; color: #fff; }
  .cta-box h3 { color: #fff; }
  .cta-box p { font-size: 0.82rem; color: #94a3b8; line-height: 1.5; margin-bottom: 1rem; }
  .btn-wa { display: block; text-align: center; background: #10b981; color: #042014; font-weight: 800; padding: 0.65rem; border-radius: 6px; text-decoration: none; font-size: 0.85rem; }
  .side-nav { margin: 0; padding-left: 1.15rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .side-nav a { font-size: 0.82rem; color: #059669; text-decoration: none; }
  @media (max-width: 900px) { .search-layout { grid-template-columns: 1fr; } }
</style>
