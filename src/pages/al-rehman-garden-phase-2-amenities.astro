---
/**
 * Al Rehman Garden Phase 2 Amenities & Facilities Guide — Authority SEO Hub
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import Button from '@components/global/Button.astro';
import { AMENITIES } from '@data/amenities';
import { CONTACTS } from '@data/contacts';

const faqs = [
  {
    question: 'What amenities are available in Al Rehman Garden Phase 2 Lahore?',
    answer: 'Al Rehman Garden Phase 2 offers 100% underground electrification, Sui gas supply, operational grand mosques in every block, Al-Rehman Hospital, Allied School and LACAS campuses, family theme parks, commercial markets, and 24/7 security.',
  },
  {
    question: 'Is electricity underground in all blocks?',
    answer: 'Yes, Phase 2 features a complete underground power grid system with no hanging overhead cables, backed by high-capacity dedicated transformers.',
  },
  {
    question: 'Are there operational schools and hospitals inside the society?',
    answer: 'Yes, Al-Rehman Hospital provides emergency, OPD, and pharmacy services. Renowned educational systems including Allied School and Dare Arqam operate dedicated branches inside Phase 2.',
  },
];

const faqSchema = {
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<PageLayout
  title="Al Rehman Garden Phase 2 Amenities & World-Class Facilities Guide 2026"
  description="Explore the complete amenities in Al Rehman Garden Phase 2 Lahore: Underground utilities, Al-Rehman Hospital, top schools, theme parks, grand mosques, and 24/7 gated security."
>
  <Schema type="FAQPage" data={faqSchema} />

  <section class="auth-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">World-Class Infrastructure</div>
      <h1 class="auth-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">Amenities & Facilities</span>
      </h1>
      <p class="auth-hero__lead lead">
        Experience a complete lifestyle ecosystem with fully operational utilities, healthcare facilities, education networks, retail shopping, and recreational parks.
      </p>
      <div class="auth-meta-bar">
        <span>📅 Last Updated: September 2026</span>
        <span>🛡️ Source: On-Ground Field Audit & Developer Masterplan</span>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <!-- Amenities Grid -->
      <div class="amenities-grid-2col">
        {AMENITIES.map((am) => (
          <div class="amenity-detail-card">
            <div class="amenity-detail-card__header">
              <span class="amenity-icon">{am.icon}</span>
              <div>
                <h3 class="amenity-title">{am.name}</h3>
                <span class="amenity-status-tag">✓ Fully Operational</span>
              </div>
            </div>
            <p class="amenity-desc">{am.description}</p>
            {am.highlight && (
              <div class="amenity-hl">
                <span>✓</span> <strong>{am.highlight}</strong>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- FAQ Card -->
      <div class="auth-faq-card">
        <h2 class="auth-faq-card__title">Amenities & Living Standards FAQs</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <h3 class="faq-item__q">Q: {f.question}</h3>
              <p class="faq-item__a">{f.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Advisory CTA Box -->
      <div class="auth-cta-box">
        <div>
          <h3>Want to experience society facilities in person?</h3>
          <p>Book a free guided physical site tour with our on-ground property advisory desk.</p>
        </div>
        <div class="auth-cta-buttons">
          <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--md">
            Book Site Visit on WhatsApp
          </a>
          <Button href="/contact" variant="outline" size="md">Contact Office</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .auth-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .auth-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .auth-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0 0 var(--space-4);
  }

  .auth-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: #F3D375;
  }

  .amenities-grid-2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .amenities-grid-2col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .amenity-detail-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .amenity-detail-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .amenity-icon {
    font-size: 32px;
  }

  .amenity-title {
    font-size: var(--text-lg);
    margin: 0 0 2px;
  }

  .amenity-status-tag {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: #059669;
  }

  .amenity-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .amenity-hl-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .amenity-hl-list li {
    font-size: var(--text-xs);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .amenity-hl-list span {
    color: #059669;
    font-weight: bold;
  }

  .auth-faq-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-8);
  }

  .auth-faq-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background: var(--color-neutral-50);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .faq-item__q {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .faq-item__a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .auth-cta-box {
    background: linear-gradient(135deg, #101F44 0%, #0A1128 100%);
    color: white;
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .auth-cta-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .auth-cta-box h3 {
    color: white;
    margin: 0 0 var(--space-1);
  }

  .auth-cta-box p {
    color: var(--color-neutral-300);
    font-size: var(--text-sm);
    margin: 0;
  }

  .auth-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    flex-shrink: 0;
  }
</style>
