---
/**
 * Contact & Site Office Advisory — Al Rehman Garden Phase 2 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const contactSchema = {
  name: 'Al Rehman Garden Phase 2 Contact & Advisory Desk',
  description: 'Official real estate contact desk for Al Rehman Garden Phase 2 on Main Sharaqpur Road Lahore.',
  url: `${SITE.url}/contact`,
  telephone: CONTACTS.phone.primary,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACTS.address.full,
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
};
---

<PageLayout
  title={`Contact Advisory & Site Office — ${SITE.name}`}
  description={`Contact Al Rehman Garden Phase 2 Lahore for verified plot availability, rate comparisons, site visit appointments, and official transfer procedures.`}
>
  <Schema type="WebSite" data={contactSchema} />

  <section class="contact-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Official Property Advisory</div>
      <h1 class="contact-hero__title">
        Get in Touch with <span class="text-gradient-gold">Phase 2 Desk</span>
      </h1>
      <p class="contact-hero__lead lead">
        Connect with our on-site property advisors for plot availability, rate lists, map coordinates, and guided physical site tours.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Form Card -->
        <div class="contact-card">
          <h2 class="contact-card__title">Send an Inquiry Request</h2>
          <p class="contact-card__desc">Fill out the quick form below and our representative will respond within 15 minutes.</p>

          <form class="contact-form" action="/contact" method="post">
            <div class="form-group">
              <label for="contact-name" class="form-label">Full Name</label>
              <input type="text" id="contact-name" name="name" required placeholder="e.g. Muhammad Ali" class="form-input" />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="contact-phone" class="form-label">Phone Number</label>
                <input type="tel" id="contact-phone" name="phone" required placeholder="e.g. 0300-1234567" class="form-input" />
              </div>
              <div class="form-group">
                <label for="contact-whatsapp" class="form-label">WhatsApp Number</label>
                <input type="tel" id="contact-whatsapp" name="whatsapp" placeholder="e.g. 0300-1234567" class="form-input" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="contact-interest" class="form-label">Interested In</label>
                <select id="contact-interest" name="interest" class="form-select">
                  <option value="residential-plot">Residential Plot (3, 5, 10 Marla, 1 Kanal)</option>
                  <option value="commercial-plot">Commercial Plot / Shop</option>
                  <option value="house-villa">Ready House / Luxury Villa</option>
                  <option value="installment-plan">Installment Payment Plan</option>
                  <option value="file-verification">Plot Allotment / File Verification</option>
                </select>
              </div>
              <div class="form-group">
                <label for="contact-budget" class="form-label">Estimated Budget</label>
                <select id="contact-budget" name="budget" class="form-select">
                  <option value="under-30-lakh">Under 30 Lakh</option>
                  <option value="30-50-lakh" selected>30 Lakh to 50 Lakh</option>
                  <option value="50-80-lakh">50 Lakh to 80 Lakh</option>
                  <option value="80-lakh-1.5-cr">80 Lakh to 1.5 Crore</option>
                  <option value="above-1.5-cr">1.5 Crore+</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">Your Message or Specific Requirements</label>
              <textarea id="contact-message" name="message" rows="4" placeholder="Mention preferred block, plot size, or specific questions..." class="form-textarea"></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--full">
              Submit Inquiry Request →
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <aside class="contact-sidebar">
          <div class="contact-info-box">
            <h3 class="contact-info-box__title">Direct Helplines</h3>
            
            <div class="contact-point">
              <span class="contact-icon">📞</span>
              <div>
                <span class="contact-lbl">Phone Helpline</span>
                <a href={`tel:${CONTACTS.phone.primary}`} class="contact-val">{CONTACTS.phone.display}</a>
              </div>
            </div>

            <div class="contact-point">
              <span class="contact-icon">💬</span>
              <div>
                <span class="contact-lbl">WhatsApp Live Advisory</span>
                <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="contact-val" style="color: #10B981;">
                  Chat with Property Desk
                </a>
              </div>
            </div>

            <div class="contact-point">
              <span class="contact-icon">✉️</span>
              <div>
                <span class="contact-lbl">Email Inquiries</span>
                <a href={`mailto:${CONTACTS.email}`} class="contact-val">{CONTACTS.email}</a>
              </div>
            </div>

            <div class="contact-point">
              <span class="contact-icon">📍</span>
              <div>
                <span class="contact-lbl">Site Office Address</span>
                <span class="contact-val">{CONTACTS.address.full}</span>
              </div>
            </div>

            <hr class="contact-hr" />

            <div class="contact-hours-block">
              <strong>Site Office Working Hours:</strong>
              <p>Monday – Saturday: {CONTACTS.officeHours.weekdays}<br />Sunday: Site tours by advance appointment.</p>
            </div>

            <a
              href="https://maps.google.com/?q=Al+Rehman+Garden+Phase+2+Lahore"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--secondary btn--full"
            >
              Get Google Maps Directions ↗
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .contact-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .contact-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .contact-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 360px;
    }
  }

  .contact-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .contact-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-1);
  }

  .contact-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .form-label {
    font-size: 11.5px;
    font-weight: var(--font-bold);
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-3-5);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    background-color: var(--color-neutral-50);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--color-primary-500);
    outline: none;
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.15);
  }

  .contact-info-box {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-xl);
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-info-box__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin: 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .contact-point {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .contact-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .contact-lbl {
    display: block;
    font-size: 10.5px;
    font-weight: var(--font-bold);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .contact-val {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-secondary-900);
    text-decoration: none;
  }

  .contact-hr {
    border: none;
    border-top: 1px solid var(--border-light);
    margin: var(--space-2) 0;
  }

  .contact-hours-block {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .contact-hours-block strong {
    color: var(--text-primary);
  }

  .contact-hours-block p {
    margin: var(--space-1) 0 0;
  }
</style>
