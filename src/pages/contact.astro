---
/**
 * Contact & Advisory Desk — DHA Phase 6 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const contactSchema = {
  '@id': `${SITE.url}/contact#local-business`,
  name: 'DHA Phase 6 Lahore Property Advisory Desk',
  description: 'Specialist real estate information and advisory desk for DHA Phase 6 on Main Boulevard Lahore.',
  url: `${SITE.url}/contact`,
  telephone: CONTACTS.phone.primary,
  priceRange: '$$$$',
  areaServed: 'DHA Phase 6 Lahore',
  sameAs: [SITE.url],
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACTS.address.full,
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
};
---

<PageLayout
  title={`Contact Advisory & Property Desk — ${SITE.name}`}
  description={`Contact DHA Phase 6 Lahore property desk for verified plot availability, rate comparisons, Defence Raya viewings, and transfer guidance.`}
>
  <Schema type="LocalBusiness" data={contactSchema} />
  <Schema type="Place" data={{ name: SITE.name, description: SITE.description, url: `${SITE.url}/dha-phase-6-lahore-map`, address: contactSchema.address }} />

  <section class="contact-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Property Information Advisory</div>
      <h1 class="contact-hero__title">
        Get in Touch with <span class="text-gradient-gold">DHA Phase 6 Desk</span>
      </h1>
      <p class="contact-hero__lead lead">
        Connect with our on-site property advisors for plot availability, rate lists, map coordinates, and guided physical site tours.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Form Card -->
        <div class="contact-card">
          <h2 class="contact-card__title">Send an Inquiry Request</h2>
          <p class="contact-card__desc">Fill out the quick form below and our representative will respond within 15 minutes.</p>

          <form class="contact-form" action="/contact" method="post">
            <div class="form-group">
              <label for="contact-name" class="form-label">Full Name</label>
              <input type="text" id="contact-name" name="name" required placeholder="e.g. Muhammad Ali" class="form-input" />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="contact-phone" class="form-label">Phone Number</label>
                <input type="tel" id="contact-phone" name="phone" required placeholder="e.g. 0300-1234567" class="form-input" />
              </div>
              <div class="form-group">
                <label for="contact-whatsapp" class="form-label">WhatsApp Number</label>
                <input type="tel" id="contact-whatsapp" name="whatsapp" placeholder="e.g. 0300-1234567" class="form-input" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="contact-interest" class="form-label">Interested In</label>
                <select id="contact-interest" name="interest" class="form-select">
                  <option value="residential-plot">Residential Plot (3, 5, 10 Marla, 1 Kanal)</option>
                  <option value="commercial-plot">Commercial Plot / Shop</option>
                  <option value="house-villa">Ready House / Luxury Villa</option>
                  <option value="installment-plan">Installment Payment Plan</option>
                  <option value="file-verification">Plot Allotment / File Verification</option>
                </select>
              </div>
              <div class="form-group">
                <label for="contact-budget" class="form-label">Estimated Budget</label>
                <select id="contact-budget" name="budget" class="form-select">
                  <option value="under-30-lakh">Under 30 Lakh</option>
                  <option value="30-50-lakh" selected>30 Lakh to 50 Lakh</option>
                  <option value="50-80-lakh">50 Lakh to 80 Lakh</option>
                  <option value="80-lakh-1.5-cr">80 Lakh to 1.5 Crore</option>
                  <option value="above-1.5-cr">1.5 Crore+</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">Your Message or Specific Requirements</label>
              <textarea id="contact-message" name="message" rows="4" placeholder="Mention preferred block, plot size, or specific questions..." class="form-textarea"></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--full">
              Submit Inquiry Request →
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <aside class="contact-sidebar">
          <div class="contact-cards-stack">
            <!-- Card 1: Sales Inquiry -->
            <div class="contact-spec-card">
              <div class="contact-spec-card__badge">Plot Sales &amp; Bookings</div>
              <h3 class="contact-spec-card__title">Sales &amp; Booking Advisory</h3>
              <p class="contact-spec-card__desc">Confirm current on-ground plot availability, cash discount rates, and flexible 3-5 year installment plans.</p>
              <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--sm btn--full">
                💬 WhatsApp Sales Desk
              </a>
            </div>

            <!-- Card 2: General Information -->
            <div class="contact-spec-card">
              <div class="contact-spec-card__badge">Society Information</div>
              <h3 class="contact-spec-card__title">General Information &amp; Maps</h3>
              <p class="contact-spec-card__desc">Inquire about sector masterplans, utility connection statuses, school admissions, and hospital timings.</p>
              <a href={`tel:${CONTACTS.phone.primary}`} class="btn btn--secondary btn--sm btn--full">
                📞 Call {CONTACTS.phone.display}
              </a>
            </div>

            <!-- Card 3: Property Assistance -->
            <div class="contact-spec-card">
              <div class="contact-spec-card__badge">Legal &amp; Title Verification</div>
              <h3 class="contact-spec-card__title">NDC &amp; Transfer Assistance</h3>
              <p class="contact-spec-card__desc">Verify original allotment letters, NDC dues status, and schedule official management transfers.</p>
              <a href={`mailto:${CONTACTS.email}`} class="btn btn--outline btn--sm btn--full">
                ✉️ Email Verification Desk
              </a>
            </div>

            <!-- Office Details -->
            <div class="contact-info-box">
              <div class="contact-point">
                <span class="contact-icon">📍</span>
                <div>
                  <span class="contact-lbl">Site Office Address</span>
                  <span class="contact-val">{CONTACTS.address.full}</span>
                </div>
              </div>
              <div class="contact-hours-block" style="margin-top: 12px;">
                <strong>Site Office Timings:</strong>
                <p>Monday – Saturday: {CONTACTS.officeHours.weekdays}<br />Sunday: Site tours by advance appointment.</p>
              </div>
              <a
                href="https://maps.google.com/?q=Al+Rehman+Garden+Phase+2+Lahore"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--outline btn--full"
                style="margin-top: 12px;"
              >
                Get Google Maps Directions ↗
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .contact-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .contact-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .contact-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 360px;
    }
  }

  .contact-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .contact-card__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-1);
  }

  .contact-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .form-label {
    font-size: 11.5px;
    font-weight: var(--font-bold);
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-3-5);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    background-color: var(--color-neutral-50);
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--color-primary-500);
    outline: none;
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.15);
  }

  .contact-cards-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: 96px;
  }

  .contact-spec-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-6);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .contact-spec-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-gold);
  }

  .contact-spec-card__badge {
    font-size: 10px;
    font-weight: var(--font-extrabold);
    background: var(--color-primary-50);
    color: var(--color-primary-800);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    align-self: flex-start;
  }

  .contact-spec-card__title {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0;
  }

  .contact-spec-card__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-2);
  }

  .contact-info-box {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-6);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-info-box__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin: 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .contact-point {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .contact-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .contact-lbl {
    display: block;
    font-size: 10.5px;
    font-weight: var(--font-bold);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .contact-val {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-secondary-900);
    text-decoration: none;
  }

  .contact-hr {
    border: none;
    border-top: 1px solid var(--border-light);
    margin: var(--space-2) 0;
  }

  .contact-hours-block {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .contact-hours-block strong {
    color: var(--text-primary);
  }

  .contact-hours-block p {
    margin: var(--space-1) 0 0;
  }
</style>
