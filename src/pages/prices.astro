---
/**
 * Prices Page — DHA Phase 6 Lahore
 * Plot Price Index & Market Rates
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const pricesSchema = {
  name: 'DHA Phase 6 Lahore Plot Rates & Price Index',
  description: 'Complete 2026 plot price list and market benchmarks for DHA Phase 6 Lahore.',
  url: `${SITE.url}/prices`,
};

const residentialPrices = [
  { size: '5 Marla (Standard)', cash: 'PKR 1.10 - 1.65 Cr', installment: 'Cash Transfer Ready', status: 'Ready in Sector J' },
  { size: '10 Marla (Prime)', cash: 'PKR 2.20 - 3.80 Cr', installment: 'Immediate Possession', status: 'Ready in Sector H, J, G' },
  { size: '1 Kanal (Standard)', cash: 'PKR 4.20 - 6.50 Cr', installment: 'High Demand', status: 'Ready in Sectors C, D, E, F' },
  { size: '1 Kanal (Executive & Golf)', cash: 'PKR 6.50 - 8.50 Cr', installment: 'Direct Transfer', status: 'Ready in Sector A, B, Raya' },
  { size: '2 Kanal (Luxury Enclave)', cash: 'PKR 9.50 - 18.5 Cr', installment: 'Exclusive Inventory', status: 'Ready in Sector A, B, K, M' },
];

const commercialPrices = [
  { size: '4 Marla Commercial (CCA-1 & 2)', cash: 'PKR 13.5 - 22.0 Cr', installment: 'Prime Broadway Commercial', status: 'Possession Ready in CCA-1 & CCA-2' },
  { size: '8 Marla Commercial (Main Boulevard)', cash: 'PKR 28.0 - 48.0 Cr', installment: 'High-Yield Corporate Plaza', status: 'Possession Ready on Main Boulevard' },
  { size: 'Commercial Floor / Office Suite', cash: 'PKR 2.20 - 4.50 Cr', installment: 'Rental Yielding', status: 'Operational Plazas' },
];
---

<PageLayout
  title={`Plot Prices 2026 & Market Rates — ${SITE.name}`}
  description={`Official 2026 price list for DHA Phase 6 Lahore. View updated market rates for 5, 10 Marla, 1 & 2 Kanal residential & commercial Broadway plots.`}
>
  <Schema type="WebSite" data={pricesSchema} />

  <!-- Header -->
  <section class="price-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Property Rate List 2026</div>
      <h1 class="price-hero__title">
        DHA Phase 6 Lahore <span class="text-gradient-gold">Plot Prices</span>
      </h1>
      <p class="price-hero__lead lead">
        Compare authentic on-ground cash rates for residential and commercial broadway plots across Sectors A to N and Defence Raya in DHA Phase 6 Lahore.
      </p>
    </div>
  </section>

  <!-- Prices Content -->
  <section class="section section--alt">
    <div class="container">
      <!-- Residential Table -->
      <div class="rate-card">
        <div class="rate-card__header">
          <div>
            <span class="rate-card__tag">Residential Sectors</span>
            <h2 class="rate-card__title">Residential Plot Price Index</h2>
          </div>
          <a
            href={CONTACTS.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--accent btn--sm"
          >
            WhatsApp Rate Inquiry
          </a>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Plot Size</th>
                <th>Estimated Cash Price</th>
                <th>Installment Option</th>
                <th>Possession Status</th>
              </tr>
            </thead>
            <tbody>
              {residentialPrices.map((item) => (
                <tr>
                  <td><strong>{item.size}</strong></td>
                  <td><span class="price-highlight">{item.cash}</span></td>
                  <td>{item.installment}</td>
                  <td><span class="status-badge">✓ {item.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Commercial Table -->
      <div class="rate-card" style="margin-top: 32px;">
        <div class="rate-card__header">
          <div>
            <span class="rate-card__tag">Commercial Broadway</span>
            <h2 class="rate-card__title">Commercial Plot & Shop Price Index</h2>
          </div>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Commercial Size</th>
                <th>Estimated Cash Price</th>
                <th>Installment Option</th>
                <th>Location Sector</th>
              </tr>
            </thead>
            <tbody>
              {commercialPrices.map((item) => (
                <tr>
                  <td><strong>{item.size}</strong></td>
                  <td><span class="price-highlight">{item.cash}</span></td>
                  <td>{item.installment}</td>
                  <td><span class="status-badge">✓ {item.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .price-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .price-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .price-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .rate-card {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-xl);
  }

  .rate-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-light);
  }

  @media (min-width: 640px) {
    .rate-card__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .rate-card__tag {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: var(--color-primary-700);
    text-transform: uppercase;
  }

  .rate-card__title {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .data-table th {
    background-color: var(--color-secondary-900);
    color: white;
    padding: var(--space-3-5) var(--space-4);
    text-align: left;
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .data-table td {
    padding: var(--space-3-5) var(--space-4);
    border-bottom: 1px solid var(--border-light);
    color: var(--text-secondary);
  }

  .data-table tbody tr:hover {
    background-color: var(--color-primary-50);
  }

  .price-highlight {
    font-weight: var(--font-extrabold);
    color: var(--color-secondary-900);
  }

  .status-badge {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: #059669;
  }
</style>
