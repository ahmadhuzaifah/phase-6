---
/**
 * Society Media Gallery — DHA Phase 6 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyWatermark from '@components/property/PropertyWatermark.astro';
import { SITE } from '@data/site';
import { GALLERY_DATA } from '@data/gallery';

const pageSchema = {
  name: `Official Society Gallery — ${SITE.name}`,
  description: 'High-resolution photo gallery showcasing 150ft boulevards, Grand Jamia Mosque, designer houses, theme parks, and commercial hubs in DHA Phase 6 Lahore.',
  url: `${SITE.url}/gallery`,
};

const filterTabs = [
  { id: 'all', label: 'All Media' },
  { id: 'views', label: 'Society Views' },
  { id: 'roads', label: 'Roads & Boulevards' },
  { id: 'parks', label: 'Parks & Greenery' },
  { id: 'houses', label: 'Houses & Architecture' },
  { id: 'commercial', label: 'Commercial Broadway' },
  { id: 'maps', label: 'Masterplan Maps' },
];
---

<PageLayout
  title={`Photo Gallery & Visual Tour | DHA Phase 6 Lahore`}
  description="Explore official high-resolution photographs of DHA Phase 6 Lahore: Turkish Grand Mosque, 150ft boulevards, Rose Garden theme parks, and designer villas."
>
  <Schema type="WebSite" data={pageSchema} />

  <!-- Hero Section -->
  <section class="gallery-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Visual Community Tour</div>
      <h1 class="gallery-hero__title">
        Society <span class="text-gradient-gold">Photo Gallery</span>
      </h1>
      <p class="gallery-hero__lead lead">
        Experience the architectural elegance, lush green landscaping, signal-free boulevards, and vibrant lifestyle of DHA Phase 6 Lahore through our verified photo gallery.
      </p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="section section--alt">
    <div class="container">
      <!-- Tabs -->
      <div class="gallery-tabs">
        {filterTabs.map((t) => (
          <button
            type="button"
            class:list={['gallery-tab', { 'gallery-tab--active': t.id === 'all' }]}
            data-filter={t.id}
          >
            {t.label}
          </button>
        ))}
      </div>

      <!-- Media Grid -->
      <div class="gallery-grid" id="gallery-grid">
        {GALLERY_DATA.map((item) => (
          <div class="gallery-card" data-category={item.category}>
            <div class="gallery-card__img-wrap">
              <img
                src={item.imageUrl}
                alt={item.altText}
                loading="lazy"
                class="gallery-card__img"
              />
              <PropertyWatermark position="bottom-right" opacity={0.35} />
              <span class="gallery-card__badge">{item.categoryLabel}</span>
            </div>
            <div class="gallery-card__body">
              <h3 class="gallery-card__title">{item.title}</h3>
              <p class="gallery-card__caption">{item.caption}</p>
              <span class="gallery-card__loc">📍 {item.location}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .gallery-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .gallery-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .gallery-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .gallery-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .gallery-tab {
    padding: var(--space-2) var(--space-4);
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .gallery-tab:hover {
    border-color: var(--border-gold);
    color: var(--color-secondary-900);
    transform: translateY(-2px);
  }

  .gallery-tab--active {
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    border-color: var(--color-primary-500);
    box-shadow: 0 2px 8px rgba(197, 155, 39, 0.3);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-gold);
  }

  .gallery-card__img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #0A1128;
  }

  .gallery-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-card:hover .gallery-card__img {
    transform: scale(1.06);
  }

  .gallery-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: rgba(10, 17, 40, 0.85);
    color: #F3D375;
    font-size: 10.5px;
    font-weight: var(--font-bold);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(212, 175, 55, 0.3);
    backdrop-filter: blur(4px);
  }

  .gallery-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .gallery-card__title {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 6px;
  }

  .gallery-card__caption {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-3);
  }

  .gallery-card__loc {
    font-size: 11px;
    color: var(--text-tertiary);
    font-weight: var(--font-semibold);
    margin-top: auto;
  }
</style>

<script>
  function initGalleryFilter() {
    const tabs = document.querySelectorAll('.gallery-tab');
    const cards = document.querySelectorAll('.gallery-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-filter');

        tabs.forEach((t) => t.classList.remove('gallery-tab--active'));
        tab.classList.add('gallery-tab--active');

        cards.forEach((c) => {
          const cardEl = c as HTMLElement;
          const cat = cardEl.getAttribute('data-category');
          if (target === 'all' || cat === target) {
            cardEl.style.display = '';
          } else {
            cardEl.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initGalleryFilter);
</script>
