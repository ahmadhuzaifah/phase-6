---
/**
 * Admin Content & Guides Management — Al Rehman Garden Phase 2 Operations System
 */

import AdminLayout from '@layouts/AdminLayout.astro';
import { BLOCKS } from '@data/blocks';

const authorityGuides = [
  { title: 'Sector Blocks Complete Directory', slug: 'al-rehman-garden-phase-2-blocks', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
  { title: 'Installment & Payment Plan 2026', slug: 'al-rehman-garden-phase-2-payment-plan', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
  { title: 'Amenities & Facilities Directory', slug: 'al-rehman-garden-phase-2-amenities', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
  { title: 'Complete Investment & ROI Guide', slug: 'al-rehman-garden-phase-2-investment-guide', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
  { title: 'In-Depth Society Review & Pros/Cons', slug: 'al-rehman-garden-phase-2-review', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
  { title: 'On-Ground Development Status 2026', slug: 'al-rehman-garden-phase-2-development-status', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
  { title: 'LDA Sanctions & NOC Legal Status', slug: 'al-rehman-garden-phase-2-noc-status', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
  { title: 'Location Comparison vs Other Societies', slug: 'al-rehman-garden-phase-2-location-vs-other-societies', lastUpdated: '2026-09-01', schema: 'FAQPage, BreadcrumbList' },
];

const localSeoPages = [
  { title: 'Houses for Sale Search Hub', slug: 'houses-for-sale-in-al-rehman-garden-phase-2-lahore', targetKeyword: 'Houses for sale in Al Rehman Garden Phase 2 Lahore' },
  { title: 'Plots for Sale Search Hub', slug: 'plots-for-sale-in-al-rehman-garden-phase-2-lahore', targetKeyword: 'Plots for sale in Al Rehman Garden Phase 2 Lahore' },
  { title: '5 Marla Plot Target Landing Page', slug: '5-marla-plot-al-rehman-garden-phase-2', targetKeyword: '5 Marla plot in Al Rehman Garden Phase 2' },
  { title: '10 Marla House Target Landing Page', slug: '10-marla-house-al-rehman-garden-phase-2', targetKeyword: '10 Marla house in Al Rehman Garden Phase 2' },
  { title: '1 Kanal Plot Target Landing Page', slug: '1-kanal-plot-al-rehman-garden-phase-2', targetKeyword: '1 Kanal plot in Al Rehman Garden Phase 2' },
];
---

<AdminLayout title="Content & Guides Management" activeSection="content">
  <!-- Authority Hub Content -->
  <div class="admin-card" style="margin-bottom: 24px;">
    <div class="admin-card__header">
      <h2 class="admin-card__title">SEO Authority Topic Guides (8 Hubs)</h2>
      <span class="badge badge--success">100% Schema Valid</span>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Guide Title</th>
            <th>Canonical Slug</th>
            <th>Structured Data</th>
            <th>Last Audited</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {authorityGuides.map((g) => (
            <tr>
              <td><strong>{g.title}</strong></td>
              <td><code>/{g.slug}</code></td>
              <td><span class="type-pill">{g.schema}</span></td>
              <td>{g.lastUpdated}</td>
              <td>
                <a href={`/${g.slug}`} target="_blank" class="action-icon-btn" title="View Public Page">
                  👁️
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Local SEO Pages -->
  <div class="admin-card" style="margin-bottom: 24px;">
    <div class="admin-card__header">
      <h2 class="admin-card__title">Local SEO Query Landing Pages (5 Hubs)</h2>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Page Title</th>
            <th>Target High-Volume Query</th>
            <th>URL</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {localSeoPages.map((lp) => (
            <tr>
              <td><strong>{lp.title}</strong></td>
              <td><span style="color: #60A5FA;">"{lp.targetKeyword}"</span></td>
              <td><code>/{lp.slug}</code></td>
              <td>
                <a href={`/${lp.slug}`} target="_blank" class="action-icon-btn" title="View Public Page">
                  👁️
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Sector Profiles -->
  <div class="admin-card">
    <div class="admin-card__header">
      <h2 class="admin-card__title">Master Sector Profiles (8 Blocks)</h2>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Sector Name</th>
            <th>Status</th>
            <th>Possession</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {BLOCKS.map((b) => (
            <tr>
              <td><strong>{b.name}</strong></td>
              <td><span class="badge badge--success">{b.status}</span></td>
              <td>{b.possessionPercentage}% On-Ground</td>
              <td>
                <a href={`/blocks/${b.slug}`} target="_blank" class="action-icon-btn" title="View Public Page">
                  👁️
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
  .type-pill {
    background: #1E293B;
    color: #94A3B8;
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    font-size: 10.5px;
  }

  .action-icon-btn {
    background: #1E293B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    padding: 3px 6px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    font-size: 12px;
    text-decoration: none;
  }
</style>
