---
/**
 * Admin Image Management & Watermark Inspector — Al Rehman Garden Phase 2 Operations System
 */

import AdminLayout from '@layouts/AdminLayout.astro';
import propertiesData from '@data/properties-import.json';

const sampleImages = propertiesData.slice(0, 12).map((p) => ({
  id: p.id,
  title: p.title,
  thumbnail: p.images[0]?.url || '/images/og/property-og.jpg',
  seoFilename: `al-rehman-garden-phase-2-${p.size}-${p.unit}-${p.propertyType}-${p.id.toLowerCase()}-1.webp`,
  altText: p.images[0]?.alt || `${p.title} Al Rehman Garden Phase 2 Lahore`,
  watermarkOpacity: '35%',
  watermarkPosition: 'Bottom-Right Crest',
  status: 'Optimized WebP',
  sizeBytes: '42.5 KB',
}));
---

<AdminLayout title="Image & Watermark Inspector" activeSection="images">
  <div class="admin-card" style="margin-bottom: 24px;">
    <div class="admin-card__header">
      <h2 class="admin-card__title">Automated Media Asset Pipeline</h2>
      <button class="btn btn--primary btn--xs" onclick="alert('Image Pipeline: Automated 100-batch WebP conversion and 35% watermark active.')">
        🔄 Re-process Media Assets
      </button>
    </div>
    <p style="font-size: var(--text-xs); color: #94A3B8; margin: 0;">
      All uploaded real estate photography is automatically stripped of GPS metadata, compressed to high-efficiency WebP format, stamped with our 35% opacity institutional emblem, and indexed with keyword-rich Alt tags.
    </p>
  </div>

  <div class="image-gallery-grid">
    {sampleImages.map((img) => (
      <div class="image-card">
        <div class="image-card__preview">
          <img src={img.thumbnail} alt={img.altText} class="image-card__img" />
          <span class="image-card__wm-badge">🔒 {img.watermarkOpacity} Watermark</span>
        </div>
        <div class="image-card__details">
          <code class="image-card__filename">{img.seoFilename}</code>
          <p class="image-card__alt">Alt: {img.altText}</p>
          <div class="image-card__meta">
            <span>{img.status} • {img.sizeBytes}</span>
            <span style="color: #D4AF37;">{img.id}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</AdminLayout>

<style>
  .image-gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .image-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .image-gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .image-card {
    background: #0E1626;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .image-card__preview {
    position: relative;
    height: 160px;
    background: #050914;
  }

  .image-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-card__wm-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.75);
    color: #F3D375;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(212, 175, 55, 0.4);
  }

  .image-card__details {
    padding: var(--space-3) var(--space-4);
  }

  .image-card__filename {
    display: block;
    font-size: 10px;
    color: #60A5FA;
    margin-bottom: 4px;
    word-break: break-all;
  }

  .image-card__alt {
    font-size: 11px;
    color: #CBD5E1;
    margin: 0 0 var(--space-2);
    line-height: 1.3;
  }

  .image-card__meta {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: #64748B;
  }
</style>
