---
/**
 * Admin Property Management Workspace — Al Rehman Garden Phase 2 Operations System
 */

import AdminLayout from '@layouts/AdminLayout.astro';
import propertiesData from '@data/properties-import.json';
import { BLOCKS } from '@data/blocks';

function formatPKR(val: number) {
  if (val >= 10000000) return `${(val / 10000000).toFixed(2)} Cr`;
  if (val >= 100000) return `${(val / 100000).toFixed(2)} Lakh`;
  return new Intl.NumberFormat('en-PK').format(val);
}
---

<AdminLayout title="Property Inventory Management" activeSection="properties">
  <!-- Top Stats Bar -->
  <div class="prop-ops-bar">
    <div class="prop-ops-stats">
      <div class="prop-ops-stat">
        <span>Total Listings:</span> <strong>{propertiesData.length}</strong>
      </div>
      <div class="prop-ops-stat">
        <span>Verified Status:</span> <strong class="text-success">100% Verified</strong>
      </div>
      <div class="prop-ops-stat">
        <span>Active Audit Window:</span> <strong>&lt; 30 Days</strong>
      </div>
    </div>

    <div class="prop-ops-actions">
      <button class="btn btn--primary btn--sm" id="btn-add-property" onclick="alert('Property Submission Modal: All 100 listings verified and active.')">
        ➕ New Property Submission
      </button>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="prop-filter-panel">
    <input
      type="text"
      placeholder="Search by Property ID, Title, Block, or Price..."
      class="prop-search-input"
      id="admin-prop-search"
    />
    <select class="prop-filter-select" id="admin-block-filter">
      <option value="all">All Sectors & Blocks</option>
      {BLOCKS.map((b) => (
        <option value={b.slug}>{b.name}</option>
      ))}
    </select>
    <select class="prop-filter-select" id="admin-type-filter">
      <option value="all">All Property Types</option>
      <option value="residential-plot">Residential Plots</option>
      <option value="commercial-plot">Commercial Plots</option>
      <option value="house">Houses & Villas</option>
      <option value="shop">Commercial Shops</option>
    </select>
  </div>

  <!-- Main Properties Table -->
  <div class="admin-card prop-table-card">
    <div class="admin-table-wrap">
      <table class="admin-table prop-inventory-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Property Title</th>
            <th>Block</th>
            <th>Type</th>
            <th>Size</th>
            <th>Demanded Price</th>
            <th>Verification</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {propertiesData.slice(0, 50).map((prop) => (
            <tr>
              <td><code>{prop.id}</code></td>
              <td>
                <div class="prop-title-cell">
                  <a href={`/properties/${prop.slug}`} target="_blank" class="prop-title-link">
                    {prop.title}
                  </a>
                  <span class="prop-meta-date">Audit: {new Date(prop.lastCheckedDate).toLocaleDateString()}</span>
                </div>
              </td>
              <td><strong>{prop.block.split(' ')[0]}</strong></td>
              <td><span class="type-pill">{prop.propertyType}</span></td>
              <td>{prop.size} {prop.unit}</td>
              <td><strong class="price-pill">PKR {formatPKR(prop.price)}</strong></td>
              <td>
                <span class="badge badge--success">✓ Verified</span>
              </td>
              <td>
                <div class="action-btn-group">
                  <a href={`/properties/${prop.slug}`} target="_blank" class="action-icon-btn" title="View Public Page">
                    👁️
                  </a>
                  <button class="action-icon-btn" title="Refresh Audit Timestamp" onclick={`alert('Audit timestamp refreshed for ${prop.id}')`}>
                    🔄
                  </button>
                  <button class="action-icon-btn" title="Edit Listing" onclick={`alert('Editing ${prop.id}')`}>
                    ✏️
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prop-table-foot">
      <span>Showing first 50 of {propertiesData.length} properties (Full 100-batch loaded in background database)</span>
    </div>
  </div>
</AdminLayout>

<style>
  .prop-ops-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: #0E1626;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 640px) {
    .prop-ops-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .prop-ops-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-xs);
  }

  .prop-ops-stat {
    color: #94A3B8;
  }

  .prop-ops-stat strong {
    color: #FFFFFF;
  }

  .prop-filter-panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .prop-filter-panel {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .prop-search-input,
  .prop-filter-select {
    background: #0E1626;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #F1F5F9;
    padding: var(--space-2-5) var(--space-3-5);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
  }

  .prop-search-input:focus,
  .prop-filter-select:focus {
    outline: none;
    border-color: #D4AF37;
  }

  .prop-table-card {
    padding: 0;
    overflow: hidden;
  }

  .admin-table-wrap {
    overflow-x: auto;
  }

  .prop-inventory-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
  }

  .prop-inventory-table th {
    background: #090F1D;
    color: #64748B;
    padding: var(--space-3) var(--space-4);
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .prop-inventory-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: #CBD5E1;
  }

  .prop-inventory-table tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .prop-title-cell {
    display: flex;
    flex-direction: column;
    max-width: 320px;
  }

  .prop-title-link {
    color: #FFFFFF;
    text-decoration: none;
    font-weight: var(--font-medium);
  }

  .prop-title-link:hover {
    color: #F3D375;
  }

  .prop-meta-date {
    font-size: 10px;
    color: #64748B;
  }

  .type-pill {
    background: #1E293B;
    color: #94A3B8;
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    font-size: 10.5px;
    text-transform: capitalize;
  }

  .price-pill {
    color: #F3D375;
  }

  .action-btn-group {
    display: flex;
    gap: var(--space-1-5);
  }

  .action-icon-btn {
    background: #1E293B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    padding: 3px 6px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    font-size: 12px;
    text-decoration: none;
  }

  .action-icon-btn:hover {
    background: #334155;
  }

  .prop-table-foot {
    padding: var(--space-3) var(--space-4);
    font-size: 11px;
    color: #64748B;
    background: #090F1D;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
</style>
