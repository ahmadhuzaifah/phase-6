---
/**
 * Admin Dealer Management Workspace — Al Rehman Garden Phase 2 Operations System
 */

import AdminLayout from '@layouts/AdminLayout.astro';
import { DEALERS } from '@data/dealers';
---

<AdminLayout title="Dealers Network Management" activeSection="dealers">
  <div class="admin-card">
    <div class="admin-card__header" style="padding: 16px 24px;">
      <h2 class="admin-card__title">Authorized Real Estate Agencies & Dealers</h2>
      <button class="btn btn--primary btn--xs" onclick="alert('Add Dealer Modal: Form for credentials, phone, and specialization sectors.')">
        ➕ Add New Dealer
      </button>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Dealer Name</th>
            <th>Agency / Entity</th>
            <th>Experience</th>
            <th>Rating</th>
            <th>Deals Closed</th>
            <th>Specializations</th>
            <th>Verification</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {DEALERS.map((d) => (
            <tr>
              <td><strong>{d.name}</strong></td>
              <td>{d.agencyName}</td>
              <td>{d.experienceYears}+ Years</td>
              <td><span style="color: #F59E0B;">★ {d.rating.toFixed(1)}</span></td>
              <td><strong>{d.totalDeals}+</strong></td>
              <td>
                <div class="dealer-mini-chips">
                  {d.specializationBlocks.slice(0, 2).map((blk) => (
                    <span class="mini-chip">{blk.split(' ')[0]}</span>
                  ))}
                </div>
              </td>
              <td>
                <span class="badge badge--success">✓ Verified</span>
              </td>
              <td>
                <a href={`/dealers/${d.slug}`} target="_blank" class="action-icon-btn" title="View Public Profile">
                  👁️
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
  .dealer-mini-chips {
    display: flex;
    gap: 4px;
  }

  .mini-chip {
    font-size: 10px;
    background: #1E293B;
    color: #94A3B8;
    padding: 1px 5px;
    border-radius: var(--radius-xs);
  }

  .action-icon-btn {
    background: #1E293B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    padding: 3px 6px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    font-size: 12px;
    text-decoration: none;
  }
</style>
