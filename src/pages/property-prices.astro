---
/**
 * Property Price Index & Market Valuation Guide (2026)
 * Al Rehman Garden Phase 2 Lahore Authority Portal
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import { PROPERTY_PRICES } from '@data/prices';

const pageSchema = {
  name: `2026 Property Price Index — ${SITE.name}`,
  description: 'Audited 2026 property rate card and price index for 3, 5, 7, 10 Marla & 1 Kanal residential plots, commercial units, and luxury houses in Al Rehman Garden Phase 2 Lahore.',
  url: `${SITE.url}/property-prices`,
};

function formatPKR(val: number) {
  if (val >= 10000000) {
    return `${(val / 10000000).toFixed(2)} Crore`;
  } else if (val >= 100000) {
    return `${(val / 100000).toFixed(2)} Lakh`;
  }
  return new Intl.NumberFormat('en-PK').format(val);
}

const residentialPlots = PROPERTY_PRICES.filter((p) => p.category === 'residential-plot');
const houses = PROPERTY_PRICES.filter((p) => p.category === 'house');
const commercial = PROPERTY_PRICES.filter((p) => p.category === 'commercial-plot' || p.category === 'shop');
---

<PageLayout
  title={`Property Price Index 2026 | Al Rehman Garden Phase 2 Lahore Plot Rates`}
  description="Official 2026 Property Price Index for Al Rehman Garden Phase 2 Lahore. View latest demanded rates for 3, 5, 7, 10 Marla & 1 Kanal plots, luxury houses, and commercial broadway units."
>
  <Schema type="WebSite" data={pageSchema} />

  <!-- Hero Section -->
  <section class="price-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Audited Market Benchmarks</div>
      <h1 class="price-hero__title">
        2026 Property <span class="text-gradient-gold">Price Index</span>
      </h1>
      <p class="price-hero__lead lead">
        Explore transparent, verified market valuation benchmarks for residential plots, commercial broadway units, and newly constructed designer houses across all sectors of Al Rehman Garden Phase 2 Lahore.
      </p>
    </div>
  </section>

  <!-- Notice / Disclaimer Band -->
  <div class="price-disclaimer-band">
    <div class="container">
      <div class="price-disclaimer-inner">
        <span style="font-size: 20px;">⚖️</span>
        <p>
          <strong>Official Price Notice:</strong> Listed rates reflect current demanded open-market benchmarks and developer payment schedules as of September 2026. Specific plot valuations vary based on corner locations, 150ft boulevard frontage, park proximity, and immediate possession status.
        </p>
      </div>
    </div>
  </div>

  <!-- Price Category 1: Residential Plots -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Residential Plot Market</span>
        <h2 class="section-header__title">Residential Plot Price Index (2026)</h2>
        <p class="section-header__desc">Demanded prices for demarcated residential plots across mature and under-development sectors.</p>
      </div>

      <div class="price-card-grid">
        {residentialPlots.map((p) => (
          <div class="price-index-card">
            <div class="price-index-card__header">
              <div class="price-index-card__badge">{p.size} {p.unit}</div>
              <span class="price-index-card__trend">
                <span style="color: #059669;">↑ {p.growthYoY} YoY</span>
              </span>
            </div>

            <div class="price-index-card__body">
              <span class="price-index-card__lbl">Demanded Price Range:</span>
              <div class="price-index-card__range">
                PKR {formatPKR(p.minPrice)} – {formatPKR(p.maxPrice)}
              </div>
              <div class="price-index-card__avg">
                Estimated Average: <strong>PKR {formatPKR(p.avgPrice)}</strong>
              </div>

              <div class="price-index-card__meta">
                <div class="price-meta-row">
                  <span>Possession Ready:</span>
                  <strong>From PKR {formatPKR(p.possessionMinPrice || p.minPrice)}</strong>
                </div>
                <div class="price-meta-row">
                  <span>Top Sectors:</span>
                  <span>{p.popularBlocks.join(', ')}</span>
                </div>
              </div>
            </div>

            <div class="price-index-card__footer">
              <a
                href={`/properties?size=${p.size}`}
                class="btn btn--primary btn--sm btn--full"
              >
                View Available {p.size} {p.unit} Plots →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Price Category 2: Houses & Designer Villas -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Built Housing & Rental Yields</span>
        <h2 class="section-header__title">Houses &amp; Designer Villas Price Index</h2>
        <p class="section-header__desc">Brand-new double-story Spanish and contemporary family homes with ready possession.</p>
      </div>

      <div class="price-card-grid">
        {houses.map((p) => (
          <div class="price-index-card">
            <div class="price-index-card__header">
              <div class="price-index-card__badge price-index-card__badge--house">{p.size} {p.unit} House</div>
              <span class="price-index-card__trend">
                <span style="color: #059669;">↑ {p.growthYoY} YoY</span>
              </span>
            </div>

            <div class="price-index-card__body">
              <span class="price-index-card__lbl">Finished House Price Range:</span>
              <div class="price-index-card__range">
                PKR {formatPKR(p.minPrice)} – {formatPKR(p.maxPrice)}
              </div>
              <div class="price-index-card__avg">
                Benchmark Cost: <strong>PKR {formatPKR(p.avgPrice)}</strong>
              </div>

              <div class="price-index-card__meta">
                {p.rentalYield && (
                  <div class="price-meta-row">
                    <span>Monthly Rental Yield:</span>
                    <strong style="color: #059669;">{p.rentalYield}</strong>
                  </div>
                )}
                <div class="price-meta-row">
                  <span>Prime Sectors:</span>
                  <span>{p.popularBlocks.join(', ')}</span>
                </div>
              </div>
            </div>

            <div class="price-index-card__footer">
              <a
                href={`/properties?type=house`}
                class="btn btn--secondary btn--sm btn--full"
              >
                View Available Houses →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Price Category 3: Commercial Broadway -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">High-ROI Commercial Sector</span>
        <h2 class="section-header__title">Commercial Plots &amp; Plaza Shops Price Index</h2>
        <p class="section-header__desc">Commercial broadway units on 150ft central arteries with exceptional business footfall.</p>
      </div>

      <div class="price-card-grid">
        {commercial.map((p) => (
          <div class="price-index-card">
            <div class="price-index-card__header">
              <div class="price-index-card__badge price-index-card__badge--comm">{p.size} {p.unit} {p.category === 'shop' ? 'Shop' : 'Commercial Plot'}</div>
              <span class="price-index-card__trend">
                <span style="color: #059669;">↑ {p.growthYoY} YoY</span>
              </span>
            </div>

            <div class="price-index-card__body">
              <span class="price-index-card__lbl">Demanded Price Range:</span>
              <div class="price-index-card__range">
                PKR {formatPKR(p.minPrice)} – {formatPKR(p.maxPrice)}
              </div>
              <div class="price-index-card__avg">
                Average Value: <strong>PKR {formatPKR(p.avgPrice)}</strong>
              </div>

              <div class="price-index-card__meta">
                {p.rentalYield && (
                  <div class="price-meta-row">
                    <span>Estimated Rental:</span>
                    <strong style="color: #059669;">{p.rentalYield}</strong>
                  </div>
                )}
                <div class="price-meta-row">
                  <span>Location Strip:</span>
                  <span>{p.popularBlocks.join(', ')}</span>
                </div>
              </div>
            </div>

            <div class="price-index-card__footer">
              <a
                href={`/properties?type=commercial-plot`}
                class="btn btn--primary btn--sm btn--full"
              >
                Explore Commercial Inventory →
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Quick Action Callout -->
      <div class="price-cta-banner" style="margin-top: 56px;">
        <div class="price-cta-banner__body">
          <h3 style="color: #FFFFFF; font-size: var(--text-2xl); margin: 0 0 8px;">Need Specific Plot Rate Verification?</h3>
          <p style="color: #CBD5E1; font-size: var(--text-sm); margin: 0;">
            Our advisory desk tracks real-time closed registry values, corner premiums, and NOC statuses. Connect with an authorized consultant on WhatsApp.
          </p>
        </div>
        <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--lg" style="flex-shrink: 0;">
          Request Rate List on WhatsApp
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .price-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .price-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .price-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .price-disclaimer-band {
    background: #FFFBEB;
    border-bottom: 1px solid #FCD34D;
    padding: var(--space-3) 0;
    font-size: var(--text-xs);
    color: #92400E;
  }

  .price-disclaimer-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .price-disclaimer-inner p {
    margin: 0;
    line-height: 1.5;
  }

  .price-card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .price-card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .price-card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .price-index-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .price-index-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-gold);
  }

  .price-index-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .price-index-card__badge {
    font-size: var(--text-sm);
    font-weight: var(--font-extrabold);
    background: var(--color-primary-50);
    color: var(--color-primary-800);
    padding: 3px 10px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-gold);
  }

  .price-index-card__badge--house {
    background: #EFF6FF;
    color: #1E40AF;
    border-color: #93C5FD;
  }

  .price-index-card__badge--comm {
    background: #FEF3C7;
    color: #92400E;
    border-color: #FCD34D;
  }

  .price-index-card__trend {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
  }

  .price-index-card__lbl {
    font-size: 11px;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 2px;
  }

  .price-index-card__range {
    font-size: var(--text-lg);
    font-weight: var(--font-extrabold);
    color: var(--color-secondary-950);
    margin-bottom: 4px;
  }

  .price-index-card__avg {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .price-index-card__meta {
    background: var(--color-neutral-50);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .price-meta-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--text-secondary);
  }

  .price-meta-row strong {
    color: var(--text-primary);
  }

  .price-index-card__footer {
    margin-top: auto;
  }

  .price-cta-banner {
    background: linear-gradient(135deg, #101F44 0%, #0A1128 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .price-cta-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
