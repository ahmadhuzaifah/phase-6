    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .pill-blue {
    background: rgba(59, 130, 246, 0.12);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.28);
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .pill-purple {
    background: rgba(168, 85, 247, 0.12);
    color: #d8b4fe;
