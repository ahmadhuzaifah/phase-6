---
/**
 * Authors & Editorial Desk — E-E-A-T Trust Profile
 * Route: /authors/
 * Features: Research team profile, editorial standards, data verification process, conflict of interest policy.
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@data/site';

const canonical = `${SITE.url}/authors/`;
const pageTitle = `Research Team & Editorial Standards — DHA Phase 6 Lahore Knowledge Desk`;
const metaDesc = `Meet the independent real estate research desk, property analysts, and field investigators behind DHA Phase 6 Lahore. Review our editorial standards and verification methodologies.`;

const authorSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": canonical,
      "name": pageTitle,
      "description": metaDesc,
      "publisher": { "@type": "Organization", "name": SITE.name, "url": SITE.url }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE.url}/` },
        { "@type": "ListItem", "position": 2, "name": "About", "item": `${SITE.url}/about/` },
        { "@type": "ListItem", "position": 3, "name": "Authors & Research Team", "item": canonical }
      ]
    }
  ]
};
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(authorSchema)} />

  <header class="author-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/about/">About</a> <span>/</span>
        <span aria-current="page">Authors &amp; Editorial Desk</span>
      </nav>
      <div class="author-badge">E-E-A-T Transparency &bull; Independent Research</div>
      <h1>Research Team &amp; Editorial Standards</h1>
      <p class="hero-intro">
        Our platform operates as an independent real estate intelligence service. 
        Meet the property analysts, urban researchers, and data verification specialists dedicated to providing objective, accurate information about DHA Phase 6 Lahore.
      </p>
    </div>
  </header>

  <main class="container author-body">
    <div class="author-layout">
      
      <div class="author-main">
        
        <!-- Team Profiles -->
        <section class="author-card">
          <h2>1. Real Estate Research &amp; Field Analysis Team</h2>
          <p>
            Unlike automated property listing aggregators that republish unverified claims, our content is authored and reviewed by professionals with on-ground expertise in the Lahore real estate market:
          </p>

          <div class="team-grid">
            <!-- Team Member 1 -->
            <div class="team-card">
              <div class="team-avatar">HA</div>
              <div class="team-info">
                <h3>Huzaifa Ahmad</h3>
                <span class="role">Lead Real Estate Research Analyst &amp; Urban Planner</span>
                <p>
                  Specializes in DHA master-planned communities, infrastructure valuation metrics, and demographic migration trends across Lahore. 
                  Conducts weekly secondary market transaction assessments and title due diligence research.
                </p>
              </div>
            </div>

            <!-- Team Member 2 -->
            <div class="team-card">
              <div class="team-avatar">RS</div>
              <div class="team-info">
                <h3>Rahman Shafi</h3>
                <span class="role">Commercial Property &amp; Yield Consultant</span>
                <p>
                  Focuses on commercial real estate economics across CCA 1, CCA 2, Main Boulevard, and Defence Raya. 
                  Monitors institutional banking leases, retail footfall indices, and capitalization rates.
                </p>
              </div>
            </div>

            <!-- Team Member 3 -->
            <div class="team-card">
              <div class="team-avatar">DK</div>
              <div class="team-info">
                <h3>DHA Field Verification Unit</h3>
                <span class="role">On-Ground Field Surveyors &amp; Document Reviewers</span>
                <p>
                  Physically visits advertised plots, verifies boundary pegs, inspects turnkey houses, confirms GPS coordinates, 
                  and verifies local amenities across all 17 sectors and commercial zones.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Editorial Standards -->
        <section class="author-card">
          <h2>2. Editorial Standards &amp; Accuracy Charter</h2>
          <p>
            To maintain our reputation as the definitive independent knowledge source on DHA Phase 6 Lahore, our editorial desk adheres to rigorous guidelines:
          </p>
          <ul class="guidelines-list">
            <li><strong>Zero Sponsored Bias:</strong> We do not accept undisclosed payments, commissions, or sponsored bias to inflate sector valuations or conceal development deficiencies.</li>
            <li><strong>Independence Disclaimer:</strong> We make it strictly clear that this platform is independent and is not an official branch, subsidiary, or management arm of DHA Lahore.</li>
            <li><strong>Triangulated Pricing:</strong> Every price range quoted on our portal is corroborated across multiple independent estate agencies, recent bank valuation reports, and verified DHA transfer records.</li>
            <li><strong>Correction Policy:</strong> If a price, phone number, or establishment address changes, our data team updates the record within 48 hours of verification.</li>
          </ul>
        </section>

        <!-- Verification Process -->
        <section class="author-card">
          <h2>3. Four-Tier Data Verification Process</h2>
          <ol class="verify-steps">
            <li><strong>Source Identification:</strong> Gathering pricing and property listings directly from licensed DHA Lahore realtors and direct owners.</li>
            <li><strong>Title &amp; Plot Check:</strong> Cross-referencing plot numbers against the official DHA Phase 6 Master Plan to verify zoning, setbacks, and sector boundaries.</li>
            <li><strong>Physical Verification:</strong> Periodic ground audits to ensure images accurately depict current construction status rather than 3D render mockups.</li>
            <li><strong>Quarterly Review:</strong> Regular recalibration of sector price brackets in response to federal taxation (FBR 236K/236C) and macroeconomic shifts.</li>
          </ol>
          <p>
            For a detailed technical explanation of our database pipeline, visit <a href="/how-we-collect-property-data/">How We Collect &amp; Verify Property Data</a>.
          </p>
        </section>

      </div>

      <aside class="author-sidebar">
        <div class="side-card">
          <h3>Editorial Inquiries</h3>
          <p>Have a question regarding our research methodology or spotted an outdated record?</p>
          <a href="/contact/" class="btn-side">Contact Editorial Desk</a>
        </div>

        <div class="side-card">
          <h4>Trust &amp; Policies</h4>
          <ul class="side-links">
            <li><a href="/how-we-collect-property-data/">Data Collection Methodology</a></li>
            <li><a href="/disclaimer/">Platform Disclaimer</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li>
          </ul>
        </div>
      </aside>

    </div>
  </main>
</PageLayout>

<style>
  .author-hero {
    background: linear-gradient(135deg, #090e1a 0%, #1e293b 100%);
    color: #fff;
    padding: 3.5rem 0 3rem;
  }
  .breadcrumb {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.45rem;
  }
  .breadcrumb a { color: #94a3b8; text-decoration: none; }
  .breadcrumb a:hover { color: #10b981; }
  .author-badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.35rem 0.85rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .author-hero h1 {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 800;
    margin: 0 0 1rem;
  }
  .hero-intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 850px;
    margin: 0;
  }

  .author-body { padding: 3rem 0; }
  .author-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
  }
  .author-main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .author-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 2rem;
  }
  .author-card h2 {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .author-card p {
    font-size: 0.98rem;
    line-height: 1.75;
    color: #334155;
    margin-bottom: 1.25rem;
  }

  .team-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }
  .team-card {
    display: flex;
    gap: 1.25rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }
  .team-avatar {
    width: 60px;
    height: 60px;
    background: #0f172a;
    color: #10b981;
    font-weight: 900;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .team-info h3 { font-size: 1.15rem; color: #0f172a; margin: 0 0 0.25rem; }
  .team-info .role { display: block; font-size: 0.82rem; font-weight: 700; color: #059669; margin-bottom: 0.5rem; }
  .team-info p { font-size: 0.88rem; line-height: 1.6; color: #475569; margin: 0; }

  .guidelines-list, .verify-steps {
    margin: 0;
    padding-left: 1.35rem;
    line-height: 1.75;
    color: #334155;
  }
  .guidelines-list li, .verify-steps li { margin-bottom: 0.65rem; }
  .guidelines-list strong, .verify-steps strong { color: #0f172a; }

  .author-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .side-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }
  .side-card h3, .side-card h4 {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.65rem;
  }
  .side-card p { font-size: 0.82rem; color: #64748b; line-height: 1.5; margin-bottom: 1rem; }
  .btn-side {
    display: block;
    text-align: center;
    background: #0f172a;
    color: #fff;
    font-weight: 700;
    padding: 0.65rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.85rem;
  }
  .btn-side:hover { background: #10b981; color: #042014; }

  .side-links {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .side-links a { font-size: 0.82rem; color: #059669; text-decoration: none; font-weight: 500; }
  .side-links a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .author-layout { grid-template-columns: 1fr; }
  }
</style>
