---
/**
 * Al Rehman Garden Phase 2 Master Map Guide — High-Intent SEO Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import Button from '@components/global/Button.astro';
import { SITE } from '@data/site';
import { BLOCKS } from '@data/blocks';
import { CONTACTS } from '@data/contacts';

const mapSchema = {
  name: 'Al Rehman Garden Phase 2 Master Plan & Sector Map',
  description: 'Official masterplan and high-resolution sector layout map for Al Rehman Garden Phase 2 Lahore.',
  url: `${SITE.url}/al-rehman-garden-phase-2-map`,
};
---

<PageLayout
  title="Al Rehman Garden Phase 2 Map Lahore — Masterplan & Sector Layout"
  description="View and download the high-resolution masterplan map of Al Rehman Garden Phase 2 Lahore. Explore Block A, B, C, D, Mirabel, and Royal Block layout maps."
>
  <Schema type="WebSite" data={mapSchema} />

  <!-- Hero Header -->
  <section class="seo-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Master Plan & Sector Map</div>
      <h1 class="seo-hero__title">
        Al Rehman Garden Phase 2 <span class="text-gradient-gold">Society Map</span>
      </h1>
      <p class="seo-hero__lead lead">
        Explore the comprehensive masterplan layout of Al Rehman Garden Phase 2 Lahore. View block boundaries, 150ft main boulevard, parks, grand mosques, commercial zones, and hospital complexes.
      </p>
    </div>
  </section>

  <!-- Map Showcase & Sector Directory -->
  <section class="section section--alt">
    <div class="container">
      <!-- High Resolution Map Container Card -->
      <div class="map-showcase-card">
        <div class="map-showcase-card__header">
          <div>
            <span class="map-showcase-card__tag">Official Masterplan</span>
            <h2 class="map-showcase-card__title">Phase 2 Master Layout Overview</h2>
          </div>
          <a
            href={CONTACTS.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--accent btn--sm"
          >
            Request HD Map PDF on WhatsApp
          </a>
        </div>

        <div class="map-display-box">
          <div class="map-display-inner">
            <div class="map-display-badge">
              <span>🗺️ Al Rehman Garden Phase 2 Master Map</span>
            </div>
            <p class="map-display-text">
              High-resolution vector maps for Block A, B, C, D, E, F, Mirabel Block, and Royal Block with marked plot numbers and boulevard coordinates.
            </p>
            <div class="map-actions">
              <a
                href="https://maps.google.com/?q=Al+Rehman+Garden+Phase+2+Lahore"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--primary btn--md"
              >
                Open Google Satellite View ↗
              </a>
              <Button href="/blocks" variant="outline" size="md">
                Browse Block-by-Block Maps
              </Button>
            </div>
          </div>
        </div>
      </div>

      <!-- Sector Breakdown Grid -->
      <div class="sector-map-grid">
        {BLOCKS.map((block) => (
          <div class="sector-map-item">
            <div class="sector-map-item__header">
              <h3 class="sector-map-item__title">{block.name}</h3>
              <span class="sector-map-item__status" style="text-transform: capitalize;">{block.status.replace('-', ' ')}</span>
            </div>
            <p class="sector-map-item__desc">{block.description}</p>
            <div class="sector-map-item__plots">
              <strong>Plots:</strong> {block.plotSizes.join(', ')}
            </div>
            <a href={`/blocks/${block.slug}`} class="sector-map-item__link">
              View {block.name} Layout →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .seo-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .seo-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .seo-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .map-showcase-card {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-gold);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-xl);
    margin-bottom: var(--space-12);
  }

  .map-showcase-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-light);
  }

  @media (min-width: 640px) {
    .map-showcase-card__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .map-showcase-card__tag {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: var(--color-primary-700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .map-showcase-card__title {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .map-display-box {
    background: linear-gradient(135deg, #101F44 0%, #0A1128 100%);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-6);
    text-align: center;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .map-display-badge {
    display: inline-block;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid #D4AF37;
    color: #F3D375;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .map-display-text {
    max-width: 55ch;
    margin: 0 auto var(--space-8);
    font-size: var(--text-base);
    color: var(--color-neutral-300);
  }

  .map-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Sector Grid */
  .sector-map-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .sector-map-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sector-map-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sector-map-item {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .sector-map-item__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .sector-map-item__title {
    font-size: var(--text-base);
    margin: 0;
  }

  .sector-map-item__status {
    font-size: 10.5px;
    font-weight: var(--font-bold);
    color: #059669;
    background: #ECFDF5;
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  .sector-map-item__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .sector-map-item__plots {
    font-size: 11.5px;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .sector-map-item__link {
    margin-top: auto;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-primary-700);
    text-decoration: none;
  }

  .sector-map-item__link:hover {
    text-decoration: underline;
  }
</style>
