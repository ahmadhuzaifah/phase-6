---
/**
 * Master Map & Location Authority Hub — Al Rehman Garden Phase 2 Lahore
 * Designed in luxury dark aesthetic (#090B20, #15172D, #D4AF37)
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyWatermark from '@components/property/PropertyWatermark.astro';
import { SITE } from '@data/site';
import { BLOCKS } from '@data/blocks';
import { CONTACTS } from '@data/contacts';

const pageSchema = {
  name: `Al Rehman Garden Phase 2 Lahore Map | Master Plan & Location Guide`,
  description: `Explore Al Rehman Garden Phase 2 Lahore map, master plan, blocks, location, nearby areas, and downloadable society maps.`,
  url: `${SITE.url}/al-rehman-garden-phase-2-map`,
};

const placeSchema = {
  name: 'Al Rehman Garden Phase 2 Lahore',
  description: 'Master-planned housing community on Main Sharaqpur Road near M-2 Motorway Faizpur Interchange Lahore.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Main Sharaqpur Road, Near Faizpur Interchange M-2',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    postalCode: '54000',
    addressCountry: 'PK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.5768,
    longitude: 74.2254,
  },
  url: `${SITE.url}/al-rehman-garden-phase-2-map`,
  telephone: CONTACTS.phone.primary,
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Society Map',
      item: `${SITE.url}/al-rehman-garden-phase-2-map`,
    },
  ],
};

const faqSchema = {
  itemListElement: [
    {
      '@type': 'Question',
      name: 'Where is Al Rehman Garden Phase 2 located on Lahore map?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Al Rehman Garden Phase 2 is situated directly on Main Sharaqpur Road, just 2 minutes from the M-2 Motorway Faizpur Interchange and 10 minutes from Mall Road and Sagian Bridge.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I download the official high-resolution society masterplan map?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can download the full vectorized HD PDF masterplan map directly from our Download Maps section or request individual sector maps on WhatsApp.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which sectors are possession-ready on the Phase 2 map?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Block A, Block B, Block C, Block D, and Blocks E & F have 100% on-ground ready possession with operational electricity, Sui gas, and residing families.',
      },
    },
  ],
};

// Map PDF Downloads Dataset
const mapDownloads = [
  {
    id: 'masterplan',
    title: 'Society Master Plan',
    desc: 'High-resolution vectorized layout of all sectors, 150ft boulevard, and civic areas.',
    size: '14.5 MB',
    format: 'PDF',
    image: '/images/og/homepage-og.jpg',
  },
  {
    id: 'block-a',
    title: 'Block A Map (Executive)',
    desc: 'Executive sector layout featuring 3, 5, 10 Marla plots and Grand Turkish Mosque.',
    size: '4.2 MB',
    format: 'PDF',
    image: '/images/og/property-og.jpg',
  },
  {
    id: 'block-b',
    title: 'Block B Map',
    desc: 'Residential sector layout with The City School, Central Park, and ready villas.',
    size: '3.8 MB',
    format: 'PDF',
    image: '/images/placeholders/property-placeholder.webp',
  },
  {
    id: 'block-c',
    title: 'Block C Map (Commercial & Civic)',
    desc: 'Commercial broadway, financial banks, trust hospital, and residential lanes.',
    size: '4.5 MB',
    format: 'PDF',
    image: '/images/og/homepage-og.jpg',
  },
  {
    id: 'block-d',
    title: 'Block D Map (Rose Garden)',
    desc: 'Rose Garden theme park enclave with 3, 5, and 10 Marla plot demarcations.',
    size: '3.9 MB',
    format: 'PDF',
    image: '/images/placeholders/property-placeholder.webp',
  },
  {
    id: 'mirabel',
    title: 'Mirabel Luxury Block Map',
    desc: 'Luxury sector layout with musical fountains, sports arena, and 1 Kanal plots.',
    size: '5.1 MB',
    format: 'PDF',
    image: '/images/og/property-og.jpg',
  },
  {
    id: 'royal',
    title: 'Royal Block Map',
    desc: 'Modern under-development sector with fast-track road carpeting and utility grid.',
    size: '4.8 MB',
    format: 'PDF',
    image: '/images/placeholders/property-placeholder.webp',
  },
  {
    id: 'commercial',
    title: '150ft Commercial Broadway Map',
    desc: 'Dedicated commercial plaza demarcations, multi-story parking, and corporate hub.',
    size: '6.2 MB',
    format: 'PDF',
    image: '/images/og/homepage-og.jpg',
  },
];

// Educational How to Read Cards
const howToReadCards = [
  {
    num: '01',
    icon: '🏛️',
    title: 'Block Identification',
    desc: 'Learn how sectors are logically indexed from mature Blocks A–F to luxury enclaves like Mirabel and Beverly Hills.',
  },
  {
    num: '02',
    icon: '🛣️',
    title: 'Road Network',
    desc: 'Understand the road hierarchy: 150ft main entrance boulevard, 80ft sector dividers, and 30ft paved residential streets.',
  },
  {
    num: '03',
    icon: '📐',
    title: 'Plot Categories',
    desc: 'Identify residential plot sizes (3, 5, 7, 10 Marla & 1 Kanal) and differentiate from dedicated commercial broadway strips.',
  },
  {
    num: '04',
    icon: '🕌',
    title: 'Facilities Location',
    desc: 'Locate essential amenities including the Grand Turkish Mosque, 24/7 Trust Hospital, The City School, and theme parks.',
  },
  {
    num: '05',
    icon: '📈',
    title: 'Investment Zones',
    desc: 'Identify high-appreciation commercial corridors and emerging sectors offering maximum capital appreciation.',
  },
  {
    num: '06',
    icon: '🚀',
    title: 'Future Development',
    desc: 'Track planned motorway bypass connections, upcoming commercial plazas, and future sector extensions.',
  },
];

// Location Advantages Cards
const locationAdvantages = [
  {
    icon: '⭐',
    title: 'Prime Lahore Location',
    desc: 'Strategically located on Main Sharaqpur Road, just 10 minutes from Mall Road and central Lahore.',
  },
  {
    icon: '🚗',
    title: 'Easy Accessibility',
    desc: 'Direct 2-minute signal-free connection to M-2 Motorway Faizpur Interchange and Lahore Ring Road.',
  },
  {
    icon: '🏥',
    title: 'Nearby Facilities',
    desc: 'Surrounded by top universities, operational hospitals, commercial banks, and shopping markets.',
  },
  {
    icon: '💰',
    title: 'Investment Potential',
    desc: 'Consistently delivers 14% to 18% annual capital appreciation driven by Western Lahore expansion.',
  },
  {
    icon: '🏗️',
    title: 'Future Growth',
    desc: 'Beneficiary of multi-billion rupee provincial road infrastructure projects and bypass linkages.',
  },
];

// Related Authority Guides
const relatedGuides = [
  { title: 'Location Guide', href: '/al-rehman-garden-phase-2-location', icon: '📍', desc: 'Detailed transit times and access routes.' },
  { title: 'Property Prices', href: '/property-prices', icon: '📊', desc: 'Audited 2026 market plot & house rate index.' },
  { title: 'Payment Plans', href: '/al-rehman-garden-phase-2-payment-plan', icon: '💳', desc: 'Installment schedules for 3, 5, and 10 Marla plots.' },
  { title: 'Blocks Directory', href: '/blocks', icon: '🏛️', desc: 'Comprehensive sector-by-sector overview.' },
  { title: 'Amenities & Grid', href: '/utilities', icon: '⚡', desc: 'Underground power, Sui gas, and RO water.' },
  { title: 'Investment Guide', href: '/al-rehman-garden-phase-2-investment-guide', icon: '📈', desc: 'Expert ROI and capital growth forecasts.' },
];
---

<PageLayout
  title="Al Rehman Garden Phase 2 Lahore Map | Master Plan & Location Guide"
  description="Explore Al Rehman Garden Phase 2 Lahore map, master plan, blocks, location, nearby areas, and downloadable society maps."
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="Place" data={placeSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />
  <Schema type="FAQPage" data={faqSchema} />

  <main class="map-page">
    <!-- Top Header Navigation -->
    <header class="map-topbar">
      <div class="container map-topbar__inner">
        <a href="/" class="map-topbar__logo">
          <img src="/images/logo/logo-white.svg" alt={SITE.name} width="190" height="48" />
        </a>

        <nav class="map-topbar__nav">
          <a href="/" class="map-nav-link">Home</a>
          <a href="/about" class="map-nav-link">About</a>
          <a href="/blocks" class="map-nav-link">Blocks</a>
          <a href="/properties" class="map-nav-link">Properties</a>
          <a href="/plots" class="map-nav-link">Plots</a>
          <a href="/houses-for-sale-in-al-rehman-garden-phase-2-lahore" class="map-nav-link">Houses</a>
          <a href="/places" class="map-nav-link">Places</a>
          <a href="/al-rehman-garden-phase-2-map" class="map-nav-link map-nav-link--active">Map</a>
          <a href="/property-prices" class="map-nav-link">Prices</a>
          <a href="/al-rehman-garden-phase-2-investment-guide" class="map-nav-link">Guides</a>
        </nav>

        <a
          href="https://wa.me/923257800001"
          target="_blank"
          rel="noopener noreferrer"
          class="map-btn-gold"
        >
          WhatsApp
        </a>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="map-hero">
      <div class="container text-center">
        <!-- Breadcrumbs -->
        <nav class="map-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>&gt;</span>
          <span class="active">Map</span>
        </nav>

        <!-- Main Heading -->
        <h1 class="map-hero__title">
          Al Rehman Garden Phase 2 Lahore <br />
          <span class="text-gold">Map</span>
        </h1>

        <!-- Subtitle -->
        <p class="map-hero__subtitle">
          Explore the complete location, block layout, master plan, and nearby facilities of Al Rehman Garden Phase 2 Lahore.
        </p>

        <div class="map-trust-badge">
          <span>✨ Interactive location guide for investors, residents, and property buyers.</span>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECTION 1: INTERACTIVE LOCATION MAP
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="map-section">
      <div class="container">
        <div class="section-center-head">
          <div class="map-eyebrow">
            <span class="map-eyebrow__line"></span>
            <span>SOCIETY LOCATION</span>
            <span class="map-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Al Rehman Garden Phase 2 Location Map</h2>
          <p class="section-sub-title">Find the society location, nearby landmarks, roads, and important destinations.</p>
        </div>

        <!-- Google Map Interactive Container -->
        <div class="interactive-map-card">
          <div class="interactive-map-frame-wrap">
            <iframe
              title="Al Rehman Garden Phase 2 Lahore Google Map Location"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13594.756281096538!2d74.2154!3d31.5768!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391901a1c9df253b%3A0xb35a80579e0f63e6!2sAl-Rehman%20Garden%20Phase%202%2C%20Lahore!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s"
              width="100%"
              height="480"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="interactive-map-iframe"
            ></iframe>
          </div>

          <div class="map-card-bar">
            <div class="map-coord-badge">
              <span>📍 GPS Coordinates: 31.5768° N, 74.2254° E • Main Sharaqpur Road, Lahore</span>
            </div>
            <a
              href="https://maps.google.com/?q=Al+Rehman+Garden+Phase+2+Lahore"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-open-gmaps"
            >
              Open in Google Maps ↗
            </a>
          </div>
        </div>

        <!-- 4 Location Cards below map -->
        <div class="location-cards-grid">
          <div class="loc-info-card">
            <span class="loc-info-card__icon">📍</span>
            <h3 class="loc-info-card__title">Lahore Location</h3>
            <p class="loc-info-card__desc">
              Situated directly on Main Sharaqpur Road, just 10 minutes from Mall Road, Sagian Bridge, and District Courts Lahore.
            </p>
          </div>

          <div class="loc-info-card">
            <span class="loc-info-card__icon">🚗</span>
            <h3 class="loc-info-card__title">Motorway Access</h3>
            <p class="loc-info-card__desc">
              Just 2 minutes signal-free direct drive to M-2 Motorway Faizpur Interchange, linking seamlessly to Islamabad and Ring Road.
            </p>
          </div>

          <div class="loc-info-card">
            <span class="loc-info-card__icon">🏙️</span>
            <h3 class="loc-info-card__title">Nearby Areas</h3>
            <p class="loc-info-card__desc">
              Immediate access to Shahdara, Gulshan-e-Ravi, Lower Mall, Sagian Bypass, and Thokar Niaz Baig via motorway bypass.
            </p>
          </div>

          <div class="loc-info-card">
            <span class="loc-info-card__icon">🛣️</span>
            <h3 class="loc-info-card__title">Road Connectivity</h3>
            <p class="loc-info-card__desc">
              Fronted by a 150ft wide signal-free entrance boulevard with wide 80ft inter-sector avenues and carpeted streets.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECTION 2: BLOCK MAP EXPLORER & MASTER PLAN
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="map-section map-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="map-eyebrow">
            <span class="map-eyebrow__line"></span>
            <span>SECTOR LAYOUT</span>
            <span class="map-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Al Rehman Garden Phase 2 Master Plan</h2>
          <p class="section-sub-title">Explore blocks, sectors, roads, and development layout.</p>
        </div>

        <!-- Large Master Plan Image with Overlay -->
        <div class="masterplan-display-card">
          <div class="masterplan-img-wrap">
            <img
              src="/images/og/homepage-og.jpg"
              alt="Al Rehman Garden Phase 2 Lahore Official Master Plan Map"
              class="masterplan-img"
              loading="lazy"
            />
            <PropertyWatermark position="bottom-right" opacity={0.8} />

            <div class="masterplan-overlay-cta">
              <a
                href="#download-maps"
                class="btn-masterplan-view"
              >
                🔍 View Full Master Plan &amp; Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Block Selector Cards Grid -->
        <div class="block-selector-grid">
          {BLOCKS.map((b) => (
            <div class="block-sel-card">
              <div class="block-sel-card__top">
                <h3 class="block-sel-card__title">{b.name}</h3>
                <span class:list={['block-status-pill', `block-status-pill--${b.status}`]}>
                  {b.status === 'possession-ready' ? 'Ready Possession' : b.status === 'developed' ? '100% Inhabited' : 'Developing'}
                </span>
              </div>

              <div class="block-sel-card__sizes">
                <strong>Plot Sizes:</strong> {b.plotSizes.join(', ')}
              </div>

              <a
                href={`/blocks/${b.slug}`}
                class="block-sel-card__btn"
              >
                View Block Details →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECTION 3: DOWNLOAD MAP PDFs
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="map-section" id="download-maps">
      <div class="container">
        <div class="section-center-head">
          <div class="map-eyebrow">
            <span class="map-eyebrow__line"></span>
            <span>HIGH RESOLUTION MAPS</span>
            <span class="map-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Download Maps</h2>
          <p class="section-sub-title">Official high-resolution PDF maps for society sectors and commercial hubs.</p>
        </div>

        <div class="map-download-grid">
          {mapDownloads.map((m) => (
            <div class="map-dl-card">
              <div class="map-dl-card__preview">
                <img
                  src={m.image}
                  alt={m.title}
                  class="map-dl-card__img"
                  loading="lazy"
                />
                <span class="map-dl-card__badge">{m.format} • {m.size}</span>
              </div>

              <div class="map-dl-card__content">
                <h3 class="map-dl-card__title">{m.title}</h3>
                <p class="map-dl-card__desc">{m.desc}</p>

                <div class="map-dl-card__actions">
                  <a
                    href={m.image}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-map-view"
                  >
                    View Map
                  </a>
                  <a
                    href={m.image}
                    download={`${m.id}-al-rehman-garden-phase-2.jpg`}
                    class="btn-map-dl"
                  >
                    📥 Download PDF
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECTION 4: HOW TO READ THE MAP (6 CARDS)
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="map-section map-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="map-eyebrow">
            <span class="map-eyebrow__line"></span>
            <span>MAP READING GUIDE</span>
            <span class="map-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">How to Read Al Rehman Garden Phase 2 Map</h2>
          <p class="section-sub-title">A step-by-step visual guide to navigating sector masterplans and demarcations.</p>
        </div>

        <div class="how-read-grid">
          {howToReadCards.map((c) => (
            <div class="how-read-card">
              <div class="how-read-card__header">
                <span class="how-read-card__icon">{c.icon}</span>
                <span class="how-read-card__num">{c.num}</span>
              </div>
              <h3 class="how-read-card__title">{c.title}</h3>
              <p class="how-read-card__desc">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECTION 5: LOCATION ADVANTAGES (5 CARDS)
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="map-section">
      <div class="container">
        <div class="section-center-head">
          <div class="map-eyebrow">
            <span class="map-eyebrow__line"></span>
            <span>LOCATION ADVANTAGES</span>
            <span class="map-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Why This Location Matters</h2>
          <p class="section-sub-title">Strategic connectivity and civic advantages making Phase 2 Lahore's premier choice.</p>
        </div>

        <div class="adv-cards-grid">
          {locationAdvantages.map((adv) => (
            <div class="adv-card">
              <span class="adv-card__icon">{adv.icon}</span>
              <h3 class="adv-card__title">{adv.title}</h3>
              <p class="adv-card__desc">{adv.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECTION 6: RELATED GUIDES
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="map-section map-section--alt">
      <div class="container">
        <div class="section-center-head">
          <div class="map-eyebrow">
            <span class="map-eyebrow__line"></span>
            <span>SOCIETY KNOWLEDGEBASE</span>
            <span class="map-eyebrow__line"></span>
          </div>
          <h2 class="section-main-title">Related Location &amp; Property Guides</h2>
          <p class="section-sub-title">Deepen your understanding of Al Rehman Garden Phase 2 with our verified research resources.</p>
        </div>

        <div class="related-guides-grid">
          {relatedGuides.map((g) => (
            <a href={g.href} class="related-guide-card">
              <span class="related-guide-card__icon">{g.icon}</span>
              <h3 class="related-guide-card__title">{g.title}</h3>
              <p class="related-guide-card__desc">{g.desc}</p>
              <span class="related-guide-card__link">Explore Guide →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         SECTION 7: CTA SECTION
         ══════════════════════════════════════════════════════════════════════════ -->
    <section class="map-cta-section">
      <div class="container">
        <div class="map-cta-box">
          <div class="map-cta-box__body">
            <h2 class="map-cta-box__title">
              Looking for a Property in <br />
              <span class="text-gold">Al Rehman Garden Phase 2 Lahore?</span>
            </h2>
            <p class="map-cta-box__desc">
              Browse 100+ verified on-ground plots and ready designer houses, or get in touch with our property advisory desk for instant rate confirmation and site tours.
            </p>
          </div>

          <div class="map-cta-box__actions">
            <a href="/properties" class="btn-cta-gold">
              View Available Properties
            </a>
            <a
              href="https://wa.me/923257800001"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-cta-green"
            >
              💬 WhatsApp Consultation
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════════════
         FOOTER
         ══════════════════════════════════════════════════════════════════════════ -->
    <footer class="map-footer">
      <div class="container">
        <div class="map-footer__grid">
          <!-- Left Column -->
          <div class="map-footer__brand-col">
            <img src="/images/logo/logo-white.svg" alt={SITE.name} width="220" height="55" class="map-footer__logo" />
            <p class="map-footer__desc">
              An independent real estate information portal providing verified society maps, market valuations, sector masterplans, and property guidance for Al Rehman Garden Phase 2 Lahore.
            </p>
          </div>

          <!-- Column 2: Pages -->
          <div class="map-footer__col">
            <h4 class="map-footer__heading">Pages</h4>
            <ul class="map-footer__list">
              <li><a href="/">Home</a></li>
              <li><a href="/properties">Properties</a></li>
              <li><a href="/blocks">Blocks</a></li>
              <li><a href="/places">Places</a></li>
              <li><a href="/al-rehman-garden-phase-2-map">Map</a></li>
              <li><a href="/property-prices">Prices</a></li>
            </ul>
          </div>

          <!-- Column 3: Guides -->
          <div class="map-footer__col">
            <h4 class="map-footer__heading">Guides</h4>
