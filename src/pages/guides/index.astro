---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';

const guides = [
  { title: 'Investment guide', desc: 'Compare returns, risks and resale factors without guaranteed-growth claims.', href: '/investment-guide' },
  { title: 'Verification and transfer', desc: 'Ownership, dues, NDC, identity and official transfer checks.', href: '/verification-and-transfer' },
  { title: 'Buying costs', desc: 'Build a complete acquisition budget beyond the seller demand.', href: '/buying-costs' },
  { title: 'Best sector framework', desc: 'Compare sectors A-N against one consistent buyer brief.', href: '/best-sector-in-dha-phase-6-lahore' },
  { title: 'Construction guide', desc: 'Indicative rates, approvals, project stages and cost controls.', href: '/construction' },
  { title: 'Living in Phase 6', desc: 'Commute, daily services and street-level trade-offs.', href: '/living-in-dha-phase-6-lahore' },
  { title: 'Location and directions', desc: 'Road connections, map checks and site-visit planning.', href: '/location' },
  { title: 'Weather and site visits', desc: 'Use heat, rain and winter conditions as part of inspection.', href: '/weather' },
];
---

<PageLayout title="DHA Phase 6 Lahore Guides" description="Original buyer, investor, construction and neighbourhood guides for DHA Phase 6 Lahore.">
  <Schema type="BreadcrumbList" data={{ itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/guides` },
  ] }} />
  <header class="guides-hero"><div class="container"><p>Independent research library</p><h1>DHA Phase 6 Lahore guides</h1><span>Clear checklists, source links and no guaranteed-return claims.</span></div></header>
  <section class="guides-section"><div class="container guides-grid">{guides.map((guide,index) => <a href={guide.href} class="guide-card"><span>{String(index + 1).padStart(2,'0')}</span><h2>{guide.title}</h2><p>{guide.desc}</p><strong>Read guide</strong></a>)}</div></section>
</PageLayout>

<style>
  .guides-hero{padding:clamp(5rem,10vw,8rem) 0;background:radial-gradient(circle at 80% 0,#25254d,#111128 40%,#0a0a1a 78%);color:#fff;border-bottom:1px solid rgba(212,168,68,.18)}.guides-hero p{margin:0 0 .8rem;color:#d4a844;font-size:.74rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.guides-hero h1{max-width:900px;margin:0 0 1.2rem;color:#fff;font-family:var(--font-display);font-size:clamp(3rem,8vw,6.5rem);line-height:.95}.guides-hero span{color:#9a9ab5;font-size:1.1rem}.guides-section{padding:clamp(4rem,8vw,7rem) 0;background:#0a0a1a}.guides-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08)}.guide-card{min-height:270px;padding:2.2rem;background:linear-gradient(145deg,#161635,#111128);color:#f0f0f5;text-decoration:none;transition:transform .2s,background .2s}.guide-card:hover{position:relative;z-index:1;transform:translateY(-5px);background:#1c1c42}.guide-card>span{color:#d4a844;font-weight:900;letter-spacing:.1em}.guide-card h2{margin:2.7rem 0 .8rem;color:#f0f0f5;font-family:var(--font-display);font-size:2rem}.guide-card p{max-width:52ch;color:#9a9ab5;line-height:1.65}.guide-card strong{display:block;margin-top:1.3rem;color:#f0c95c}@media(max-width:700px){.guides-grid{grid-template-columns:1fr}}
</style>
