---
/**
 * 1 Kanal Plot for Sale DHA Phase 6 Lahore — Search Intent Landing Page
 * Route: /1-kanal-plot-for-sale-dha-phase-6-lahore/
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const canonical = `${SITE.url}/1-kanal-plot-for-sale-dha-phase-6-lahore/`;
const pageTitle = `1 Kanal Plot for Sale DHA Phase 6 Lahore — 2026 Sector Price Matrix`;
const metaDesc = `Explore 1 Kanal residential plots for sale in DHA Phase 6 Lahore. Real-time sector-by-sector price matrix (PKR 4.2 to 7.5 Crore), corner & park-facing plots, and transfer dues.`;
---

<PageLayout title={pageTitle} description={metaDesc} canonical={canonical}>
  <header class="search-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/plots-for-sale-dha-phase-6-lahore/">Plots for Sale</a> <span>/</span>
        <span aria-current="page">1 Kanal Plot for Sale</span>
      </nav>
      <div class="intent-badge">The Sovereign Standard &bull; 50 &times; 90 ft &bull; 100% Possession</div>
      <h1>1 Kanal Plot for Sale in DHA Phase 6 Lahore</h1>
      <p class="hero-desc">
        Comprehensive buyer guide and sector pricing matrix for 1 Kanal (500 sq yds / 4,500 sq ft) residential plots in DHA Phase 6 Lahore. 
        Available across Sectors A through N with complete underground electricity and ready possession.
      </p>
    </div>
  </header>

  <main class="container search-body">
    <div class="search-layout">
      <div class="search-main">
        <section class="search-card">
          <h2>1 Kanal Plot Price Matrix Across All Sectors (2026)</h2>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Sector Location</th>
                  <th>Key Proximity / Landmarks</th>
                  <th>General Plot Demand</th>
                  <th>Corner / Park Facing</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Sector A</strong></td>
                  <td>DHA Head Office, Bedian Road Entrance</td>
                  <td>PKR 5.50 – 7.50 Crore</td>
                  <td>PKR 6.50 – 8.50 Crore</td>
                </tr>
                <tr>
                  <td><strong>Sector B</strong></td>
                  <td>Shabbir Sharif Road, Dolmen Mall Proximity</td>
                  <td>PKR 5.25 – 7.00 Crore</td>
                  <td>PKR 6.20 – 8.00 Crore</td>
                </tr>
                <tr>
                  <td><strong>Sector C &amp; D</strong></td>
                  <td>Grand Jamia Masjid, Beaconhouse</td>
                  <td>PKR 5.00 – 7.00 Crore</td>
                  <td>PKR 5.80 – 7.80 Crore</td>
                </tr>
                <tr>
                  <td><strong>Sector E &amp; F</strong></td>
                  <td>DHA Medical Centre, Sports Complex</td>
                  <td>PKR 4.80 – 6.60 Crore</td>
                  <td>PKR 5.60 – 7.40 Crore</td>
                </tr>
                <tr>
                  <td><strong>Sector G &amp; H</strong></td>
                  <td>Sector H Grand Central Park (800m track)</td>
                  <td>PKR 4.60 – 6.40 Crore</td>
                  <td>PKR 5.40 – 7.20 Crore</td>
                </tr>
                <tr>
                  <td><strong>Sector J &amp; K</strong></td>
                  <td>LGU &amp; TMUC Campuses</td>
                  <td>PKR 4.30 – 5.80 Crore</td>
                  <td>PKR 5.00 – 6.60 Crore</td>
                </tr>
                <tr>
                  <td><strong>Sector L &amp; M</strong></td>
                  <td>Army Public School, Barki Road</td>
                  <td>PKR 4.20 – 5.60 Crore</td>
                  <td>PKR 4.80 – 6.30 Crore</td>
                </tr>
                <tr>
                  <td><strong>Sector N</strong></td>
                  <td>PKLI Hospital, Defence Raya Golf</td>
                  <td>PKR 4.50 – 6.00 Crore</td>
                  <td>PKR 5.20 – 6.80 Crore</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="search-card">
          <h2>1 Kanal Plot Specifications &amp; Transfer Charges</h2>
          <p>
            When purchasing a 1 Kanal plot in DHA Phase 6, the following costs apply beyond the agreed purchase price:
          </p>
          <ul>
            <li><strong>DHA Transfer Fee:</strong> Paid via DHA official challan at the Phase 6 Head Office.</li>
            <li><strong>Punjab Stamp Duty:</strong> Typically 1% of the registered DC value via e-Stamp.</li>
            <li><strong>Advance Income Tax (Section 236K):</strong> Withholding tax calculated according to FBR Active Taxpayer list status.</li>
            <li><strong>Membership Fee:</strong> Mandatory DHA membership registration for first-time buyers.</li>
          </ul>
        </section>
      </div>

      <aside class="search-sidebar">
        <div class="side-box cta-box">
          <h3>1 Kanal Plot Consultation</h3>
          <p>Verify plot map, boundaries, and seller NDC status before paying bayana deposit.</p>
          <a href={`https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hello, I want to inquire about 1 Kanal plots for sale in DHA Phase 6 Lahore.')}`} target="_blank" rel="noopener noreferrer" class="btn-wa">
            WhatsApp 1 Kanal Desk
          </a>
        </div>
        <div class="side-box">
          <h4>Related Links</h4>
          <ul class="side-nav">
            <li><a href="/1-kanal-house-for-sale-dha-phase-6-lahore/">1 Kanal Built Houses</a></li>
            <li><a href="/plots-for-sale-dha-phase-6-lahore/">All Plots for Sale</a></li>
            <li><a href="/dha-phase-6-property-calculator/">Property Tax Calculator</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</PageLayout>

<style>
  .search-hero { background: linear-gradient(135deg, #090e1a 0%, #1e293b 100%); color: #fff; padding: 3rem 0 2.5rem; }
  .breadcrumb { font-size: 0.8rem; color: #94a3b8; margin-bottom: 1rem; display: flex; gap: 0.45rem; }
  .breadcrumb a { color: #94a3b8; text-decoration: none; }
  .breadcrumb a:hover { color: #10b981; }
  .intent-badge { display: inline-block; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.3rem 0.75rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.75rem; }
  .search-hero h1 { font-family: var(--font-display, Georgia, serif); font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 800; margin: 0 0 0.85rem; }
  .hero-desc { font-size: 1.05rem; line-height: 1.65; color: #cbd5e1; max-width: 850px; margin: 0; }
  .search-body { padding: 3rem 0; }
  .search-layout { display: grid; grid-template-columns: 1fr 320px; gap: 2.5rem; }
  .search-main { display: flex; flex-direction: column; gap: 2.5rem; }
  .search-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.75rem; }
  .search-card h2 { font-family: var(--font-display, Georgia, serif); font-size: 1.35rem; font-weight: 800; color: #0f172a; margin: 0 0 0.85rem; padding-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; }
  .search-card p { font-size: 0.95rem; line-height: 1.7; color: #334155; margin-bottom: 1rem; }
  .table-wrap { overflow-x: auto; margin-top: 1rem; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .data-table th { background: #f1f5f9; padding: 0.75rem 1rem; text-align: left; font-weight: 700; color: #0f172a; border-bottom: 2px solid #cbd5e1; }
  .data-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #e2e8f0; color: #334155; }
  .search-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
  .side-box { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; }
  .side-box h3, .side-box h4 { font-size: 0.95rem; font-weight: 800; color: #0f172a; margin: 0 0 0.65rem; }
  .cta-box { background: #0f172a; color: #fff; }
  .cta-box h3 { color: #fff; }
  .cta-box p { font-size: 0.82rem; color: #94a3b8; line-height: 1.5; margin-bottom: 1rem; }
  .btn-wa { display: block; text-align: center; background: #10b981; color: #042014; font-weight: 800; padding: 0.65rem; border-radius: 6px; text-decoration: none; font-size: 0.85rem; }
  .side-nav { margin: 0; padding-left: 1.15rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .side-nav a { font-size: 0.82rem; color: #059669; text-decoration: none; }
  @media (max-width: 900px) { .search-layout { grid-template-columns: 1fr; } }
</style>
