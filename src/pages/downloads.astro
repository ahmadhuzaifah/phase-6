---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { DOWNLOADS_DATA } from '@data/downloads';
import { SITE } from '@data/site';
---

<PageLayout title="DHA Phase 6 Lahore Maps and Resources" description="Official external map and construction references plus independent DHA Phase 6 Lahore research resources.">
  <Schema type="BreadcrumbList" data={{ itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Downloads', item: `${SITE.url}/downloads` },
  ] }} />
  <header class="resource-hero"><div class="container"><p>Maps and source documents</p><h1>DHA Phase 6 Lahore resources</h1><span>Official files are linked to their publisher instead of copied or rebranded.</span></div></header>
  <section class="resource-section"><div class="container">
    <div class="resource-note"><strong>Check the publisher.</strong><p>DHA Lahore links below are external official references. Independent market pages are clearly labeled and are not official documents.</p></div>
    <div class="resource-grid">{DOWNLOADS_DATA.map((item) => <article class="resource-card"><div class="resource-meta"><span>{item.category}</span><span>{item.fileFormat}</span></div><h2>{item.title}</h2><p>{item.description}</p><dl><div><dt>Publisher</dt><dd>{item.publisher}</dd></div><div><dt>Status</dt><dd>{item.isOfficial ? 'Official external source' : 'Independent research'}</dd></div><div><dt>Reviewed</dt><dd>{item.lastUpdated}</dd></div></dl><a href={item.downloadUrl} target={item.downloadUrl.startsWith('http') ? '_blank' : undefined} rel={item.downloadUrl.startsWith('http') ? 'noopener noreferrer' : undefined}>Open {item.fileFormat}</a></article>)}</div>
  </div></section>
</PageLayout>

<style>
  .resource-hero{padding:clamp(5rem,10vw,8rem) 0;background:radial-gradient(circle at 80% 0,#315c50,#102d2a 40%,#071a24 78%);color:#fff}.resource-hero p{margin:0 0 .75rem;color:#e0bb62;font-size:.74rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.resource-hero h1{max-width:900px;margin:0 0 1.2rem;color:#fff;font-family:var(--font-display);font-size:clamp(3rem,8vw,6rem);line-height:.96}.resource-hero span{color:#c7d5d0;font-size:1.08rem}.resource-section{padding:clamp(3.5rem,8vw,7rem) 0;background:#f6f2e9}.resource-note{display:grid;grid-template-columns:220px 1fr;gap:2rem;margin-bottom:2rem;padding:1.4rem 1.6rem;background:#d5ad55;color:#102421}.resource-note p{margin:0}.resource-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem}.resource-card{padding:2rem;background:#fff;border:1px solid #ded6c5}.resource-meta{display:flex;justify-content:space-between;color:#967021;font-size:.7rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.resource-card h2{margin:1.4rem 0 .8rem;color:#102d2a;font-family:var(--font-display);font-size:1.8rem}.resource-card p{color:#5b6964;line-height:1.7}.resource-card dl{margin:1.5rem 0}.resource-card dl div{display:grid;grid-template-columns:100px 1fr;padding:.45rem 0;border-bottom:1px solid #eee8dc;font-size:.82rem}.resource-card dt{color:#78837e}.resource-card dd{margin:0;color:#223a35;font-weight:700}.resource-card a{display:inline-block;padding:.8rem 1rem;background:#123a34;color:#fff;text-decoration:none;font-weight:800}@media(max-width:720px){.resource-grid,.resource-note{grid-template-columns:1fr;gap:.7rem}}
</style>
