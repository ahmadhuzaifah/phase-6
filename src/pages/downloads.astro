---
/**
 * Official Downloads Center — Al Rehman Garden Phase 2 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import { DOWNLOADS_DATA } from '@data/downloads';

const pageSchema = {
  name: `Official Downloads Center — ${SITE.name}`,
  description: 'Download official high-resolution society maps, installment payment schedules, sector rate sheets, and brochures for Al Rehman Garden Phase 2 Lahore.',
  url: `${SITE.url}/downloads`,
};
---

<PageLayout
  title={`Official Downloads & Maps | Al Rehman Garden Phase 2 Lahore`}
  description="Download official HD society maps, payment schedules, sector-wise plot rate sheets, and community brochures for Al Rehman Garden Phase 2 Lahore in PDF format."
>
  <Schema type="WebSite" data={pageSchema} />

  <!-- Hero Section -->
  <section class="dl-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Official Resource Center</div>
      <h1 class="dl-hero__title">
        Official <span class="text-gradient-gold">Downloads Center</span>
      </h1>
      <p class="dl-hero__lead lead">
        Access and download high-resolution masterplan maps, sector installment schedules, audited property price benchmark sheets, and legal verification checklists in PDF format.
      </p>
    </div>
  </section>

  <!-- Downloads Grid Section -->
  <section class="section section--alt">
    <div class="container">
      <div class="dl-grid">
        {DOWNLOADS_DATA.map((item) => (
          <div class="dl-card">
            <div class="dl-card__header">
              <div class="dl-card__badge-row">
                <span class="dl-format-badge">{item.fileFormat}</span>
                <span class="dl-cat-badge">{item.category}</span>
                {item.isPopular && <span class="dl-popular-badge">★ Popular</span>}
              </div>
              <span class="dl-size-badge">{item.fileSize}</span>
            </div>

            <h2 class="dl-card__title">{item.title}</h2>
            <p class="dl-card__desc">{item.description}</p>

            <div class="dl-card__footer">
              <span class="dl-date">Updated: {item.lastUpdated}</span>
              <a
                href={item.downloadUrl}
                download={item.title.replace(/\s+/g, '-').toLowerCase()}
                class="btn btn--primary btn--sm"
              >
                📥 Download {item.fileFormat}
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Need Custom Document Callout -->
      <div class="dl-custom-box" style="margin-top: 56px;">
        <div>
          <h3 style="color: #FFFFFF; font-size: var(--text-2xl); margin: 0 0 8px;">Looking for Specific Sector Allotment Documents?</h3>
          <p style="color: #CBD5E1; font-size: var(--text-sm); margin: 0;">
            If you need individual block street maps, NDC verification forms, or customized payment schedules, contact our compliance desk directly.
          </p>
        </div>
        <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--lg" style="flex-shrink: 0;">
          Request Documents on WhatsApp
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .dl-hero {
    background: radial-gradient(circle at 80% 20%, #16244F 0%, #0A1128 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .dl-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .dl-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .dl-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .dl-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .dl-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .dl-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .dl-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--border-gold);
  }

  .dl-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-light);
  }

  .dl-card__badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dl-format-badge {
    background: #DC2626;
    color: white;
    font-size: 10px;
    font-weight: var(--font-extrabold);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    letter-spacing: 0.5px;
  }

  .dl-cat-badge {
    font-size: 11px;
    font-weight: var(--font-bold);
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  .dl-popular-badge {
    font-size: 10px;
    font-weight: var(--font-bold);
    background: #FEF3C7;
    color: #92400E;
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  .dl-size-badge {
    font-size: 11px;
    color: var(--text-tertiary);
    font-weight: var(--font-semibold);
  }

  .dl-card__title {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
    line-height: var(--leading-snug);
  }

  .dl-card__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .dl-card__footer {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dl-date {
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .dl-custom-box {
    background: linear-gradient(135deg, #101F44 0%, #0A1128 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .dl-custom-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
