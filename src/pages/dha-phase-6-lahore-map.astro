---
/**
 * DHA Phase 6 Lahore Map Page
 * Exact implementation matching the reference specification.
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';

const pageSchema = {
  name: 'DHA Phase 6 Lahore Map',
  description: 'Interactive Google Maps view of DHA Phase 6 Lahore with all sectors, Defence Raya, CCA broadways, and nearby landmarks.',
  url: `${SITE.url}/map`,
};

const placeSchema = {
  name: 'DHA Phase 6 Lahore',
  description: 'Premier master-planned luxury housing community featuring 18-hole Defence Raya Golf Course, CCA Broadways, and modern infrastructure.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Main Boulevard, Phase 6, DHA Lahore',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    postalCode: '54792',
    addressCountry: 'PK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.4682,
    longitude: 74.4354,
  },
  url: `${SITE.url}/map`,
  telephone: CONTACTS.phone.primary,
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Map',
      item: `${SITE.url}/map`,
    },
  ],
};

const sectors = [
  { letter: 'A', name: 'Sector A', slug: 'sector-a' },
  { letter: 'B', name: 'Sector B', slug: 'sector-b' },
  { letter: 'C', name: 'Sector C', slug: 'sector-c' },
  { letter: 'D', name: 'Sector D', slug: 'sector-d' },
  { letter: 'E', name: 'Sector E', slug: 'sector-e' },
  { letter: 'F', name: 'Sector F', slug: 'sector-f' },
  { letter: 'G', name: 'Sector G', slug: 'sector-g' },
  { letter: 'H', name: 'Sector H', slug: 'sector-h' },
  { letter: 'J', name: 'Sector J', slug: 'sector-j' },
  { letter: 'K', name: 'Sector K', slug: 'sector-k' },
  { letter: 'L', name: 'Sector L', slug: 'sector-l' },
  { letter: 'M', name: 'Sector M', slug: 'sector-m' },
  { letter: 'N', name: 'Sector N', slug: 'sector-n' },
  { letter: 'R', name: 'Defence Raya', slug: 'defence-raya-golf-resort' },
];

const mapDownloads = [
  {
    title: 'Master Plan PDF',
    desc: 'Complete DHA Phase 6 layout with all sectors, 150ft boulevards, CCA-1 & CCA-2, and Defence Raya.',
    size: 'PDF · 4.12 MB',
    href: '/downloads',
    img: '/images/og/homepage-og.jpg',
  },
  {
    title: 'Sector A Map',
    desc: 'Detailed Sector A plot and street layout near Defence Raya.',
    size: 'PDF · 0.62 MB',
    href: '/blocks/sector-a',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector B Map',
    desc: 'Detailed Sector B golf-facing plot and street layout.',
    size: 'PDF · 0.58 MB',
    href: '/blocks/sector-b',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector C Map',
    desc: 'Detailed Sector C plot layout adjacent to CCA-1 Broadway.',
    size: 'PDF · 0.65 MB',
    href: '/blocks/sector-c',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector D Map',
    desc: 'Detailed Sector D plot layout near Grand Jamia Mosque.',
    size: 'PDF · 0.55 MB',
    href: '/blocks/sector-d',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector E Map',
    desc: 'Detailed Sector E tranquil avenues and central park plots.',
    size: 'PDF · 0.70 MB',
    href: '/blocks/sector-e',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector F Map',
    desc: 'Detailed Sector F 1 & 2 Kanal avenues layout.',
    size: 'PDF · 0.60 MB',
    href: '/blocks/sector-f',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector G Map',
    desc: 'Detailed Sector G 5, 10 Marla and 1 Kanal layout.',
    size: 'PDF · 0.75 MB',
    href: '/blocks/sector-g',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector H Map',
    desc: 'Detailed Sector H residential and CCA-2 Broadway layout.',
    size: 'PDF · 0.82 MB',
    href: '/blocks/sector-h',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Sector J Map',
    desc: 'Detailed Sector J 5 & 10 Marla high-demand street layout.',
    size: 'PDF · 0.59 MB',
    href: '/blocks/sector-j',
    img: '/images/og/property-og.jpg',
  },
  {
    title: 'Defence Raya Map',
    desc: '18-hole championship golf course, fairways villas & country club.',
    size: 'PDF · 0.88 MB',
    href: '/blocks/defence-raya-golf-resort',
    img: '/images/og/homepage-og.jpg',
  },
];
---

<PageLayout
  title="DHA Phase 6 Lahore Map"
  description="Interactive Google Maps view of DHA Phase 6 Lahore with all sectors, entry gates, and nearby landmarks."
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="Place" data={placeSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />

  <!-- Page Hero -->
  <header class="page-hero">
    <div class="container">
      <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">›</span>
        <span aria-current="page">Map</span>
      </nav>
      <h1>DHA Phase 6 Lahore Map</h1>
      <p class="page-hero-description">
        Explore DHA Phase 6 Lahore on Google Maps. Find all sectors, Defence Raya, CCA broadways, and get directions.
      </p>
    </div>
  </header>

  <!-- Interactive Map Section -->
  <section class="content-section bg-primary">
    <div class="container">
      <div class="content-section-header">
        <span class="section-label">Map</span>
        <h2 class="section-title">DHA Phase VI Lahore Map</h2>
        <p class="section-subtitle">
          Pan, zoom, and explore the entire DHA Phase 6 community on the interactive map below.
        </p>
      </div>

      <div class="full-map-wrapper">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d27228.618037303036!2d74.4354!3d31.4682!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391908906e0e0921%3A0x6739d2f2b380d393!2sDHA%20Phase%206%2C%20Lahore!5e0!3m2!1sen!2spk!4v1700000000000!5m2!1sen!2spk"
          width="1200"
          height="675"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="DHA Phase VI Lahore Map"
        ></iframe>
      </div>

      <div class="map-download-actions">
        <a href="/downloads" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Master Plan</span>
        </a>
        <a href="#map-pdf-downloads" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>All Sector Map PDFs</span>
        </a>
      </div>

      <!-- Sector Legend -->
      <div class="sector-legend">
        {
          sectors.map((sec) => (
            <a class="sector-legend-item glass-card" href={`/blocks/${sec.slug}`}>
              <div class="sector-legend-dot">{sec.letter}</div>
              <span class="sector-legend-label">{sec.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Master Plan Preview Section -->
  <section class="content-section bg-secondary" id="map-pdf-downloads">
    <div class="container">
      <div class="content-section-header">
        <span class="section-label">Map Preview</span>
        <h2 class="section-title">DHA Phase 6 Master Plan</h2>
        <p class="section-subtitle">
          Preview the master plan layout showing all sectors, main boulevards, CCA broadways, and key landmarks.
        </p>
      </div>

      <div class="map-preview">
        <a href="/downloads" aria-label="Open the DHA Phase 6 master plan PDF">
          <img
            src="/images/og/homepage-og.jpg"
            alt="DHA Phase 6 Lahore master plan preview"
            width="1200"
            height="848"
            loading="lazy"
          />
        </a>
        <div class="map-preview-overlay">
          <a href="/downloads" class="map-preview-cta">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>View Full Resolution Map</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Download Map PDFs Section -->
  <section class="content-section bg-primary">
    <div class="container">
      <div class="content-section-header">
        <span class="section-label">Downloads</span>
        <h2 class="section-title">Download Map PDFs</h2>
        <p class="section-subtitle">
          Download the complete master plan or an individual sector map for offline viewing and reference.
        </p>
      </div>

      <div class="download-grid">
        {
          mapDownloads.map((item) => (
            <div class="download-card glass-card">
              <a class="download-card-preview" href={item.href} aria-label={`Open ${item.title}`}>
                <img src={item.img} alt={item.title} width="1200" height="900" loading="lazy" />
              </a>
              <div class="download-card-title">{item.title}</div>
              <div class="download-card-desc">{item.desc}</div>
              <div class="download-card-size">{item.size}</div>
              <div class="download-card-actions">
                <a href={item.href} class="download-card-btn" aria-label={`Download ${item.title}`}>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Download PDF</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Map Guide: How to Read the DHA Map -->
  <section class="content-section bg-secondary">
    <div class="container">
      <div class="content-section-header">
        <span class="section-label">Map Guide</span>
        <h2 class="section-title">How to Read the DHA Map</h2>
        <p class="section-subtitle">
          Understand the key elements and symbols used in DHA Phase 6 maps.
        </p>
      </div>

      <div class="map-legend-grid">
        <div class="map-legend-item glass-card">
          <div class="map-legend-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <path d="M3 9h18"></path>
              <path d="M9 21V9"></path>
            </svg>
          </div>
          <div>
            <div class="map-legend-title">Plot Numbers</div>
            <div class="map-legend-desc">Each plot is identified by a unique number within its sector. Numbers are shown inside the plot boundary.</div>
          </div>
        </div>

        <div class="map-legend-item glass-card">
          <div class="map-legend-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 17h14v-5l-2-5H7L5 12v5z"></path>
              <circle cx="7.5" cy="17" r="1.5"></circle>
              <circle cx="16.5" cy="17" r="1.5"></circle>
            </svg>
          </div>
          <div>
            <div class="map-legend-title">Roads &amp; Boulevards</div>
            <div class="map-legend-desc">150ft and 120ft Main Boulevards are shown as wider lines. Sector avenues appear as medium lines, and internal streets as thinner lines.</div>
          </div>
        </div>

        <div class="map-legend-item glass-card">
          <div class="map-legend-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22v-6"></path>
              <path d="M7 16l5-5 5 5"></path>
              <path d="M5.5 12L12 5.5 18.5 12"></path>
            </svg>
          </div>
          <div>
            <div class="map-legend-title">Parks &amp; Green Areas</div>
            <div class="map-legend-desc">Green shaded areas indicate parks, playgrounds, golf courses, and landscaped open spaces within each sector.</div>
          </div>
        </div>

        <div class="map-legend-item glass-card">
          <div class="map-legend-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18"></path>
              <path d="M3 10h18"></path>
              <path d="M12 3l9 7H3l9-7z"></path>
            </svg>
          </div>
          <div>
            <div class="map-legend-title">Community Buildings</div>
            <div class="map-legend-desc">Mosques, schools, commercial plazas, and community clubs are marked with distinct symbols and labels.</div>
          </div>
        </div>

        <div class="map-legend-item glass-card">
          <div class="map-legend-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div>
            <div class="map-legend-title">Defence Raya &amp; CCAs</div>
            <div class="map-legend-desc">The 18-hole championship golf course and CCA-1 &amp; CCA-2 commercial broadways are highlighted with prominent demarcations.</div>
          </div>
        </div>

        <div class="map-legend-item glass-card">
          <div class="map-legend-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div>
            <div class="map-legend-title">Sector Boundaries</div>
            <div class="map-legend-desc">Clear boundary markings indicate sector boundaries. Each sector is labeled with its letter designation (A through N).</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- External Resources Section -->
  <section class="content-section bg-primary">
    <div class="container">
      <div class="content-section-header">
        <span class="section-label">External Links</span>
        <h2 class="section-title">Related Resources</h2>
        <p class="section-subtitle">
          Official and authoritative resources for DHA Phase 6 Lahore maps and information.
        </p>
      </div>

      <div class="resources-grid">
        <a href="https://www.dhalahore.org" target="_blank" rel="noopener" class="resource-card glass-card">
          <div class="resource-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
            </svg>
          </div>
          <div>
            <div class="resource-card-title">DHA Official Website</div>
            <div class="resource-card-url">dhalahore.org</div>
          </div>
        </a>

        <a href="https://dhamaps.com" target="_blank" rel="noopener" class="resource-card glass-card">
          <div class="resource-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line>
              <line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
          </div>
          <div>
            <div class="resource-card-title">DHA Maps Portal</div>
            <div class="resource-card-url">dhamaps.com</div>
          </div>
        </a>

        <a href="https://www.google.com/maps/place/DHA+Phase+6,+Lahore" target="_blank" rel="noopener" class="resource-card glass-card">
          <div class="resource-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div>
            <div class="resource-card-title">Google Maps</div>
            <div class="resource-card-url">google.com/maps</div>
          </div>
        </a>

        <a href="https://www.zameen.com" target="_blank" rel="noopener" class="resource-card glass-card">
          <div class="resource-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <div>
            <div class="resource-card-title">Zameen.com</div>
            <div class="resource-card-url">zameen.com</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Publication Meta -->
  <aside class="page-publication-meta" aria-label="Page publication information">
    <div class="container">
      <span>Published <time datetime="2026-08-18T05:27:34+05:00">18 August 2026</time></span>
    </div>
  </aside>

  <!-- Agent WhatsApp Popup (matching reference) -->
  <aside class="agent-contact-popup" id="agentContactPopup" aria-label="Contact property consultant">
    <button class="agent-popup-close" id="agentPopupClose" type="button" aria-label="Close message">×</button>
    <div class="agent-popup-profile">
      <div class="agent-popup-photo">
        <img src="/images/dealers/ahmad-huzaifah.png" alt="Ahmad Huzaifah, property specialist" width="72" height="72" />
        <span class="online-indicator"></span>
      </div>
      <div>
        <small>Property Specialist</small>
        <strong>Ahmad Huzaifah</strong>
        <span>Usually replies quickly</span>
      </div>
    </div>
    <p>
      <strong>Looking for the right property?</strong> Get expert help finding verified plots and luxury houses in DHA Phase 6 Lahore matching your requirements.
    </p>
    <a
      class="agent-popup-whatsapp"
      href="https://wa.me/923257800001?text=Hi%20Ahmad%20Huzaifah%2C%20I%20am%20looking%20for%20a%20property%20in%20DHA%20Phase%206%20Lahore.%20Please%20guide%20me%20about%20the%20available%20options."
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
        <path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.6 9.6 0 0 1-4-1l-5 1 1-5a9.6 9.6 0 0 1-1-4 8.5 8.5 0 1 1 17 0z"></path>
        <path d="M8.5 8.5c.5 3 2 4.5 5 5"></path>
      </svg>
      <span>Chat on WhatsApp</span>
    </a>
  </aside>

  <!-- Back to top button -->
  <button class="back-to-top" id="backToTop" aria-label="Back to top">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</PageLayout>

<style>
  /* ── Colors & Backgrounds ───────────────────────────────────────── */
  .bg-primary {
    background-color: #0a0a1a;
  }

  .bg-secondary {
    background-color: #0f132a;
  }

  /* ── Page Hero ──────────────────────────────────────────────────── */
  .page-hero {
    background: #0a0a1a;
    padding: 36px 0 28px;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .page-hero-breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13.5px;
    color: #64748b;
    margin-bottom: 14px;
  }

  .page-hero-breadcrumb a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .page-hero-breadcrumb a:hover {
    color: #e5b842;
  }

  .breadcrumb-sep {
    color: #475569;
  }

  .page-hero h1 {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px;
    letter-spacing: -0.5px;
  }

  .page-hero-description {
    font-size: 15.5px;
    color: #94a3b8;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* ── Content Sections ───────────────────────────────────────────── */
  .content-section {
    padding: 60px 0;
  }

  .content-section-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .section-label {
    display: inline-block;
    color: #e5b842;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .section-title {
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px;
  }

  .section-subtitle {
    font-size: 15px;
    color: #94a3b8;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Map Wrapper ────────────────────────────────────────────────── */
  .full-map-wrapper {
    max-width: 1100px;
    margin: 0 auto 28px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    aspect-ratio: 16 / 9;
  }

  .full-map-wrapper iframe {
    width: 100%;
    height: 100%;
