---
/**
 * Master Map & Sector Authority Hub — DHA Phase 6 Lahore
 * Designed in luxury dark aesthetic (#090B20, #15172D, #C59B27)
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyWatermark from '@components/property/PropertyWatermark.astro';
import { SITE } from '@data/site';
import { BLOCKS } from '@data/blocks';
import { CONTACTS } from '@data/contacts';

const isShortAlias = Astro.url.pathname === '/map' || Astro.url.pathname === '/map/';

const pageSchema = {
  name: `DHA Phase 6 Lahore Map | Master Plan & Sector Location Guide`,
  description: `Explore DHA Phase 6 Lahore master plan map, Sectors A to N, CCA-1, CCA-2, Defence Raya Golf Resort, and downloadable sector maps.`,
  url: `${SITE.url}/dha-phase-6-lahore-map`,
};

const placeSchema = {
  name: 'DHA Phase 6 Lahore',
  description: 'Premier master-planned luxury housing community featuring 18-hole Defence Raya Golf Course, CCA Broadways, and modern infrastructure.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Main Boulevard, Phase 6, DHA Lahore',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    postalCode: '54792',
    addressCountry: 'PK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 31.4682,
    longitude: 74.4354,
  },
  url: `${SITE.url}/dha-phase-6-lahore-map`,
  telephone: CONTACTS.phone.primary,
};

const breadcrumbsSchema = {
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'DHA Phase 6 Map',
      item: `${SITE.url}/dha-phase-6-lahore-map`,
    },
  ],
};

const faqSchema = {
  itemListElement: [
    {
      '@type': 'Question',
      name: 'Where is DHA Phase 6 located on Lahore map?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'DHA Phase 6 Lahore is located along Main Boulevard Phase 6, accessible via Bedian Road, Barki Road, and the Lahore Ring Road (Phase 6 Interchange), just 10 minutes from Allama Iqbal International Airport.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which sectors are in DHA Phase 6 Lahore?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'DHA Phase 6 comprises Sectors A, B, C, D, E, F, G, H, J, K, L, M, and N, along with CCA-1, CCA-2, and the Defence Raya Golf Resort.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is Defence Raya located in Phase 6?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Defence Raya Golf & Country Club is seamlessly integrated across Sector A and Sector B in DHA Phase 6 Lahore.',
      },
    },
  ],
};

// Map PDF Downloads Dataset
const mapDownloads = [
  {
    id: 'masterplan',
    title: 'DHA Phase 6 Master Plan',
    desc: 'High-resolution official vectorized master layout covering Sectors A–N, CCAs, and Ring Road link.',
    size: '18.2 MB',
    format: 'PDF',
    image: '/images/og/homepage-og.jpg',
  },
  {
    id: 'sector-a-b',
    title: 'Sectors A & B (Defence Raya)',
    desc: 'Golf-facing villas, 1 & 2 Kanal executive plots, and Raya Fairways commercial strip.',
    size: '5.4 MB',
    format: 'PDF',
    image: '/images/og/property-og.jpg',
  },
  {
    id: 'sector-c-d',
    title: 'Sectors C & D (CCA-1 Hub)',
    desc: 'Central 1 Kanal residential layout with walking access to CCA-1 banking & dining district.',
    size: '4.8 MB',
    format: 'PDF',
    image: '/images/placeholders/property-placeholder.webp',
  },
  {
    id: 'sector-e-f',
    title: 'Sectors E & F Map',
    desc: 'Lush inner sectors featuring grand mosques, thematic parks, and 1 Kanal designer home plots.',
    size: '4.6 MB',
    format: 'PDF',
    image: '/images/og/homepage-og.jpg',
  },
  {
    id: 'sector-g-h',
    title: 'Sectors G & H Map',
    desc: '10 Marla and 1 Kanal residential zones adjacent to CCA-2 and Bedian Road connectivity.',
    size: '4.9 MB',
    format: 'PDF',
    image: '/images/placeholders/property-placeholder.webp',
  },
  {
    id: 'sector-j',
    title: 'Sector J (10 Marla Center)',
    desc: 'High-density residential sector popular for 10 Marla plots, schools, and family parks.',
    size: '4.1 MB',
    format: 'PDF',
    image: '/images/og/property-og.jpg',
  },
  {
    id: 'cca-1-cca-2',
    title: 'CCA-1 & CCA-2 Broadway Commercials',
    desc: 'Detailed commercial layout for 4 Marla & 8 Marla commercial plazas and bank squares.',
    size: '6.5 MB',
    format: 'PDF',
    image: '/images/og/homepage-og.jpg',
  },
];

// Educational How to Read Cards
const howToReadCards = [
  {
    num: '01',
    icon: '🏛️',
    title: 'Sector Alphabetical Index',
    desc: 'Learn how Phase 6 is organized systematically from executive Sectors A–F to vibrant residential hubs J, K, L, M, and N.',
  },
  {
    num: '02',
    icon: '⛳',
    title: 'Defence Raya Golf Perimeter',
    desc: 'Locate 18-hole championship golf course fairways, Raya luxury villas, condominiums, and the country club.',
  },
  {
    num: '03',
    icon: '🛣️',
    title: 'Arterial Road Hierarchy',
    desc: 'Understand the 150ft Main Boulevard, 100ft sector connectors, Ring Road Interchange, and Bedian/Barki road access points.',
  },
  {
    num: '04',
    icon: '🏪',
    title: 'Commercial Broadways (CCA-1 & CCA-2)',
    desc: 'Pinpoint financial squares, supermarkets like Jalal Sons, corporate offices, and restaurant rows.',
  },
  {
    num: '05',
    icon: '🏥',
    title: 'Health & Civic Enclaves',
    desc: 'Identify proximity to PKLI tertiary hospital, DHA Phase 6 Medical Center, top schools, and Grand Jamia Mosques.',
  },
  {
    num: '06',
    icon: '📈',
    title: 'High-Appreciation Corridors',
    desc: 'Identify prime commercial and corner-facing residential plots delivering maximum long-term rental and capital yield.',
  },
];

// Location Advantages Cards
const locationAdvantages = [
  {
    icon: '⭐',
    title: 'Premier Lahore Address',
    desc: 'The gold standard of luxury suburban living in Lahore with pristine landscaping and underground infrastructure.',
  },
  {
    icon: '✈️',
    title: '10 Mins to Airport & Ring Road',
    desc: 'Direct signal-free interchange on Lahore Ring Road connects directly to Allama Iqbal Airport and Gulberg.',
  },
  {
    icon: '⛳',
    title: 'World-Class Golf Lifestyle',
    desc: 'Home to the international 18-hole championship Defence Raya Golf Resort, country club, and spa.',
  },
  {
    icon: '🏥',
    title: 'Neighboring PKLI Healthcare',
    desc: 'South Asia’s foremost kidney and liver transplant institute and DHA medical centers located right next door.',
  },
  {
    icon: '💰',
    title: 'Unrivaled Capital Security',
    desc: 'DHA Lahore guarantees high liquidity, verified titles, transparent NDC transfer processes, and stable growth.',
  },
];

// Related Authority Guides
const relatedGuides = [
  { title: 'Sector Directory', href: '/blocks', icon: '🏛️', desc: 'Comprehensive sector-by-sector overview from A to N.' },
  { title: 'Property Prices', href: '/property-prices', icon: '📊', desc: 'Audited 2026 market plot and bungalow rate index.' },
  { title: 'Properties for Sale', href: '/properties', icon: '🏡', desc: 'Browse verified 10 Marla, 1 & 2 Kanal listings.' },
  { title: 'Places & Amenities', href: '/places', icon: '📍', desc: 'Schools, hospitals, cafes, and banks directory.' },
  { title: 'Property Consultant', href: '/property-dealer', icon: '👔', desc: 'Consult Ahmad Huzaifah (0325 7800001) for Phase 6 deals.' },
  { title: 'Contact Desk', href: '/contact', icon: '📞', desc: 'Direct inquiry and appointment scheduling desk.' },
];
---

<PageLayout
  title="DHA Phase 6 Lahore Map | Master Plan & Sector Location Guide"
  description="Explore DHA Phase 6 Lahore master plan map, Sectors A to N, CCA-1, CCA-2, Defence Raya Golf Resort, and downloadable sector maps."
  canonical={`${SITE.url}/dha-phase-6-lahore-map`}
  noindex={isShortAlias}
>
  <Schema type="WebSite" data={pageSchema} />
  <Schema type="Place" data={placeSchema} />
  <Schema type="BreadcrumbList" data={breadcrumbsSchema} />
  <Schema type="FAQPage" data={faqSchema} />

  <main class="map-page">
    <!-- Hero Section -->
    <section class="map-hero">
      <div class="container">
        <div class="map-hero__badge">
          <span class="pulse-dot"></span>
          OFFICIAL DHA PHASE 6 MASTER PLAN & SECTOR ATLAS (2026)
        </div>
        <h1 class="map-hero__title">
          DHA Phase 6 Lahore <span class="text-gold">Master Plan & Sector Map</span>
        </h1>
        <p class="map-hero__lead">
          Explore high-resolution sector maps for Sectors A through N, CCA-1, CCA-2, and Defence Raya Golf Resort. Complete with plot demarcation guides, Ring Road connectivity, and verified amenities.
        </p>

        <!-- Quick Stats Strip -->
        <div class="map-stats-strip">
          <div class="stat-pill">
            <span class="stat-pill__val">13+</span>
            <span class="stat-pill__label">Sectors (A to N)</span>
          </div>
          <div class="stat-pill">
            <span class="stat-pill__val">18-Hole</span>
            <span class="stat-pill__label">Championship Golf Course</span>
          </div>
          <div class="stat-pill">
            <span class="stat-pill__val">2</span>
            <span class="stat-pill__label">CCA Broadways (CCA-1 & 2)</span>
          </div>
          <div class="stat-pill">
            <span class="stat-pill__val">100%</span>
            <span class="stat-pill__label">Underground Utilities</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Map Display Section -->
    <section class="container map-display-section" id="master-map">
      <div class="map-viewer-card">
        <div class="map-viewer-card__header">
          <div class="viewer-title-group">
            <span class="viewer-tag">VECTOR HD MAP</span>
            <h2 class="viewer-title">DHA Phase 6 Lahore Master Plan Overview</h2>
          </div>
          <div class="viewer-actions">
            <a href={`https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hi Ahmad Huzaifah, please send me the latest DHA Phase 6 Lahore HD Master Plan PDF.')}`} target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp-compact">
              <span>Get Full Map on WhatsApp</span>
            </a>
          </div>
        </div>

        <div class="map-image-wrapper">
          <PropertyWatermark position="bottom-right" opacity={0.4} />
          <img
            src="/images/og/homepage-og.jpg"
            alt="DHA Phase 6 Lahore Master Plan Map Layout"
            class="map-main-img"
            loading="eager"
            width="1200"
            height="630"
          />
        </div>

        <div class="map-sectors-grid">
          {BLOCKS.map((block) => (
            <div class="sector-quick-box">
              <span class="sector-badge">{block.category.toUpperCase()}</span>
              <h3 class="sector-name">{block.name}</h3>
              <p class="sector-sizes">{block.plotSizes.join(' • ')}</p>
              <p class="sector-highlight">{block.locationHighlight}</p>
              <a href={`/blocks/${block.slug}`} class="sector-link">Explore Sector Details →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Download Sector Maps -->
    <section class="container map-downloads-section">
      <div class="section-heading">
        <span class="badge-gold">PDF REPOSITORY</span>
        <h2 class="heading-gold">Download DHA Phase 6 Sector Maps</h2>
        <p class="subheading-muted">Vectorized blueprints with street numbers, plot series, and green belts.</p>
      </div>

      <div class="downloads-grid">
        {mapDownloads.map((dl) => (
          <div class="download-card">
            <div class="download-card__thumb">
              <img src={dl.image} alt={dl.title} loading="lazy" />
              <span class="file-type-badge">{dl.format}</span>
            </div>
            <div class="download-card__body">
              <h3 class="download-title">{dl.title}</h3>
              <p class="download-desc">{dl.desc}</p>
              <div class="download-meta">
                <span>File Size: {dl.size}</span>
              </div>
              <a
                href={`https://wa.me/${CONTACTS.whatsapp.number.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hi Ahmad Huzaifah, please share the HD PDF map for ${dl.title}.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--gold-outline btn--full"
              >
                Request Download File
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- How to Read Sector Map -->
    <section class="container how-to-read-section">
      <div class="section-heading">
        <span class="badge-gold">EXPERT GUIDELINES</span>
        <h2 class="heading-gold">How to Navigate the DHA Phase 6 Map</h2>
        <p class="subheading-muted">Essential guide for home buyers and real estate investors evaluating plot locations.</p>
      </div>

      <div class="how-to-read-grid">
        {howToReadCards.map((card) => (
          <div class="read-card">
            <div class="read-card__top">
              <span class="read-card__num">{card.num}</span>
              <span class="read-card__icon">{card.icon}</span>
            </div>
            <h3 class="read-card__title">{card.title}</h3>
            <p class="read-card__desc">{card.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Location Advantages -->
    <section class="container location-advantages-section">
      <div class="section-heading">
        <span class="badge-gold">CONNECTIVITY & PRESTIGE</span>
        <h2 class="heading-gold">Why DHA Phase 6 Leads Lahore's Real Estate</h2>
      </div>

      <div class="advantages-grid">
        {locationAdvantages.map((item) => (
          <div class="advantage-card">
            <span class="advantage-icon">{item.icon}</span>
            <h3 class="advantage-title">{item.title}</h3>
            <p class="advantage-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Authority Links -->
    <section class="container related-guides-section">
      <div class="section-heading">
        <span class="badge-gold">AUTHORITY RESOURCES</span>
        <h2 class="heading-gold">Explore DHA Phase 6 Portals</h2>
      </div>

      <div class="related-guides-grid">
        {relatedGuides.map((guide) => (
          <a href={guide.href} class="guide-link-card">
            <span class="guide-icon">{guide.icon}</span>
            <div class="guide-content">
              <h3 class="guide-title">{guide.title}</h3>
              <p class="guide-desc">{guide.desc}</p>
            </div>
            <span class="guide-arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .map-page {
    background: #090B20;
    color: #F8FAFC;
    padding-bottom: 5rem;
  }

  .map-hero {
    padding: 4.5rem 0 3rem;
    text-align: center;
    background: radial-gradient(circle at 50% 20%, rgba(197, 155, 39, 0.15) 0%, rgba(9, 11, 32, 0.95) 75%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .map-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    background: rgba(197, 155, 39, 0.12);
    border: 1px solid rgba(243, 211, 117, 0.3);
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #F3D375;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .map-hero__title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .text-gold {
    background: linear-gradient(135deg, #F3D375 0%, #C59B27 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .map-hero__lead {
    max-width: 780px;
    margin: 0 auto 2.5rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #94A3B8;
  }

  .map-stats-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .stat-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-pill__val {
    font-size: 1.35rem;
    font-weight: 800;
    color: #F3D375;
  }

  .stat-pill__label {
    font-size: 0.78rem;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Map Display Card */
  .map-display-section {
    margin-top: 3rem;
  }

  .map-viewer-card {
    background: #111430;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
  }

  .map-viewer-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .viewer-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #F3D375;
    background: rgba(197, 155, 39, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .viewer-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .btn--whatsapp-compact {
    background: linear-gradient(135deg, #14946B 0%, #0C7C59 100%);
    color: white;
    padding: 0.65rem 1.25rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .map-image-wrapper {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 2.5rem;
  }

  .map-main-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-sectors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .sector-quick-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .sector-quick-box:hover {
    transform: translateY(-3px);
    border-color: rgba(243, 211, 117, 0.3);
  }

  .sector-badge {
    font-size: 0.68rem;
    font-weight: 700;
    color: #F3D375;
    background: rgba(197, 155, 39, 0.15);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .sector-name {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0.5rem 0 0.25rem;
  }

  .sector-sizes {
    font-size: 0.82rem;
    color: #CBD5E1;
    margin-bottom: 0.4rem;
  }

  .sector-highlight {
    font-size: 0.8rem;
    color: #94A3B8;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .sector-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #F3D375;
    text-decoration: none;
  }

  /* Section Headings */
  .section-heading {
    text-align: center;
    margin: 4.5rem 0 2.5rem;
  }

  .badge-gold {
    font-size: 0.75rem;
    font-weight: 700;
    color: #F3D375;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .heading-gold {
    font-size: 2rem;
    font-weight: 800;
    margin: 0.5rem 0 0.5rem;
  }

  .subheading-muted {
    color: #94A3B8;
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Downloads Grid */
  .downloads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .download-card {
    background: #111430;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .download-card__thumb {
    position: relative;
    height: 160px;
  }

  .download-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .file-type-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #DC2626;
    color: white;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .download-card__body {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .download-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .download-desc {
    font-size: 0.85rem;
    color: #94A3B8;
    line-height: 1.5;
    margin-bottom: 1rem;
    flex: 1;
  }

  .download-meta {
    font-size: 0.78rem;
    color: #CBD5E1;
    margin-bottom: 1rem;
  }

  .btn--gold-outline {
    border: 1px solid #C59B27;
    color: #F3D375;
    padding: 0.65rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.85rem;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn--gold-outline:hover {
    background: #C59B27;
    color: #090B20;
  }

  .btn--full {
    display: block;
    width: 100%;
  }

  /* How to Read Grid */
  .how-to-read-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .read-card {
    background: #111430;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.75rem;
  }

  .read-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .read-card__num {
    font-size: 1.5rem;
    font-weight: 800;
    color: rgba(243, 211, 117, 0.4);
  }

  .read-card__icon {
    font-size: 1.75rem;
