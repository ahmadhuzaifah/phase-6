---
import GuidePage from '@components/content/GuidePage.astro';
---
<GuidePage
  title="Utilities in DHA Phase 6 Lahore"
  description="A property-level checklist for electricity, gas, water, sewerage, drainage and internet checks in DHA Phase 6 Lahore."
  eyebrow="Homebuyer due diligence"
  sections={[
    { heading: 'Verify the exact property', paragraphs: ['Phase-wide statements do not prove that a particular plot or house has an active connection. Ask for recent bills, inspect meters and supply points, and confirm outstanding dues before agreeing terms.'] },
    { heading: 'Electricity and backup planning', paragraphs: ['Check the installed meter, sanctioned load, wiring condition and recent billing history for a house. For a plot, confirm the current connection and construction-power process with DHA Lahore and the relevant provider.'] },
    { heading: 'Gas and water', paragraphs: ['Confirm whether the exact property has a live gas connection and review recent bills. Inspect water storage, pumps, plumbing pressure and signs of leakage or dampness rather than relying on a seller summary.'] },
    { heading: 'Drainage and sewerage', paragraphs: ['Visit after rain where possible, inspect street levels, roof drainage, basement protection and sewer condition. A qualified building inspector can identify risks that are not visible in an advertisement.'] },
    { heading: 'Internet and mobile coverage', paragraphs: ['Provider availability can differ by street and building. Check current fibre or broadband serviceability using the exact address and test mobile reception inside the property.'] },
  ]}
  faqs={[
    { question: 'Are all utility connections guaranteed in Phase 6?', answer: 'No. Verify the connection and dues for the exact property.' },
    { question: 'What should I request for a house?', answer: 'Request recent bills, meter details and permission to inspect all relevant services.' },
  ]}
  sources={[{ label: 'DHA Lahore official website', href: 'https://dhalahore.org/' }]}
/>
