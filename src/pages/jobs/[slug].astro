---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { JOBS, type JobRecord } from '@data/jobs';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return JOBS.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

interface Props { job: JobRecord }
const { job } = Astro.props;
const breadcrumbs = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Jobs', item: `${SITE.url}/jobs` },
    { '@type': 'ListItem', position: 3, name: job.title, item: `${SITE.url}/jobs/${job.slug}` },
  ],
};
---

<PageLayout
  title={`${job.title} in DHA Phase 6 Lahore | ${job.company}`}
  description={`${job.summary} Check the original ${job.sourceLabel} source before applying.`}
  canonical={`${SITE.url}/jobs/${job.slug}`}
>
  <Schema type="BreadcrumbList" data={breadcrumbs} />

  <header class="detail-hero">
    <div class="container">
      <nav aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/jobs">Jobs</a><span>/</span><span>{job.title}</span></nav>
      <div class="detail-hero__meta"><span>{job.company}</span><span>{job.location}</span></div>
      <h1>{job.title}</h1>
      <p>{job.summary}</p>
    </div>
  </header>

  <section class="detail-section">
    <div class="container detail-layout">
      <article class="job-copy">
        <p class="kicker">Source-referenced opportunity</p>
        <h2>Role overview</h2>
        <p>{job.summary}</p>

        <h3>Responsibilities shown by the source</h3>
        <ul>{job.details.map((detail) => <li>{detail}</li>)}</ul>

        {job.qualifications && (
          <>
            <h3>Qualifications and checks</h3>
            <ul>{job.qualifications.map((item) => <li>{item}</li>)}</ul>
          </>
        )}

        <h3>Before applying</h3>
        <p>This page summarizes a public source checked on 2 September 2026. It does not guarantee that applications remain open or that every advertised term remains unchanged. Open the original source, verify the employer and use only the application method shown there.</p>
      </article>

      <aside class="job-sidebar">
        <div>
          <p class="kicker">Job details</p>
          <dl>
            <div><dt>Employer</dt><dd>{job.company}</dd></div>
            <div><dt>Location</dt><dd>{job.location}</dd></div>
            <div><dt>Category</dt><dd>{job.category}</dd></div>
            <div><dt>Type</dt><dd>{job.type.join(', ')}</dd></div>
            {job.compensation && <div><dt>Advertised pay</dt><dd>{job.compensation}</dd></div>}
            <div><dt>Source status</dt><dd>{job.officialDha ? 'Official DHA Lahore source' : 'External employer listing source'}</dd></div>
            <div><dt>Checked</dt><dd>{job.sourceChecked}</dd></div>
          </dl>
          <a class="apply-link" href={job.sourceUrl} target="_blank" rel="nofollow noopener noreferrer">Open original source</a>
          <a class="back-link" href="/jobs">Back to all jobs</a>
        </div>
        <div class="safety">
          <strong>Application safety</strong>
          <p>Never pay an application fee. Verify the employer domain and do not send original identity documents to an unconfirmed contact.</p>
        </div>
      </aside>
    </div>
  </section>
</PageLayout>

<style>
  .detail-hero{padding:clamp(4.5rem,9vw,7rem) 0 4rem;background:radial-gradient(circle at 82% 0,#315f55,#102e2d 38%,#071a24 78%);color:#fff}.detail-hero nav{display:flex;flex-wrap:wrap;gap:.55rem;margin-bottom:2.4rem;color:#94aaa4;font-size:.76rem}.detail-hero nav a{color:#e3c778}.detail-hero__meta{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:1rem}.detail-hero__meta span{padding:.35rem .55rem;border:1px solid rgba(215,175,87,.3);border-radius:999px;color:#e3c778;font-size:.7rem}.detail-hero h1{max-width:900px;margin:0;color:#fff;font-family:var(--font-display);font-size:clamp(2.6rem,6vw,5.2rem);line-height:1;letter-spacing:-.04em}.detail-hero>div>p{max-width:760px;color:#c3d2ce;font-size:1.08rem;line-height:1.7}
  .detail-section{padding:clamp(3rem,7vw,6rem) 0;background:#f4efe5}.detail-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:clamp(2rem,6vw,5rem);align-items:start}.job-copy{padding:clamp(1.5rem,4vw,3rem);background:#fff;border:1px solid #ddd5c7}.kicker{margin:0 0 .65rem;color:#957020;font-size:.68rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.job-copy h2{margin:0 0 1rem;color:#12352f;font-family:var(--font-display);font-size:2.3rem}.job-copy h3{margin:2.2rem 0 .8rem;color:#1a5a4e;font-size:1rem}.job-copy p,.job-copy li{color:#576661;line-height:1.78}.job-copy li+li{margin-top:.5rem}
  .job-sidebar{position:sticky;top:95px;display:grid;gap:1rem}.job-sidebar>div{padding:1.5rem;background:#0b292b;color:#fff;border-top:4px solid #d7af57}.job-sidebar dl{margin:0}.job-sidebar dl div{padding:.8rem 0;border-top:1px solid rgba(255,255,255,.1)}.job-sidebar dt{color:#829994;font-size:.65rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.job-sidebar dd{margin:.3rem 0 0;color:#fff;font-size:.85rem;line-height:1.45}.apply-link,.back-link{display:block;margin-top:1rem;padding:.8rem;text-align:center;text-decoration:none;font-size:.75rem;font-weight:900}.apply-link{background:#d7af57;color:#102421}.back-link{border:1px solid rgba(255,255,255,.2);color:#fff}.job-sidebar .safety{border-top-color:#b86b35;background:#2f241e}.safety strong{color:#f0c47a}.safety p{margin:.55rem 0 0;color:#d2c5ba;font-size:.76rem;line-height:1.55}
  @media(max-width:820px){.detail-layout{grid-template-columns:1fr}.job-sidebar{position:static}}
</style>
