---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { JOBS, type JobRecord } from '@data/jobs';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return JOBS.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

interface Props { job: JobRecord }
const { job } = Astro.props;
const relatedJobs = JOBS
  .filter((item) => item.slug !== job.slug && (item.category === job.category || item.company === job.company))
  .slice(0, 3);
const breadcrumbs = {
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Jobs', item: `${SITE.url}/jobs` },
    { '@type': 'ListItem', position: 3, name: job.title, item: `${SITE.url}/jobs/${job.slug}` },
  ],
};
---

<PageLayout
  title={`${job.title} in DHA Phase 6 Lahore | ${job.company}`}
  description={`${job.summary} Check the original ${job.sourceLabel} source before applying.`}
  canonical={`${SITE.url}/jobs/${job.slug}`}
  ogImage="/images/og/blog-og.svg"
>
  <Schema type="BreadcrumbList" data={breadcrumbs} />

  <header class="job-detail-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/jobs">Jobs</a><span>/</span><span aria-current="page">{job.title}</span>
      </nav>
      <div class="hero-flags">
        <span>{job.officialDha ? 'Official DHA source' : 'External source'}</span>
        <span>{job.category}</span>
      </div>
      <h1>{job.title}</h1>
      <p class="hero-company">{job.company} <span>/</span> {job.location}</p>
      <p class="hero-summary">{job.summary}</p>
    </div>
  </header>

  <section class="job-detail-section">
    <div class="container job-detail-layout">
      <article class="job-copy glass-card">
        <div class="copy-intro">
          <p class="eyebrow">Job description</p>
          <h2>About this opportunity</h2>
          <p>{job.summary}</p>
        </div>

        <section>
          <h3>Key responsibilities</h3>
          <ul>{job.details.map((detail) => <li>{detail}</li>)}</ul>
        </section>

        {job.qualifications && (
          <section>
            <h3>Qualifications and requirements</h3>
            <ul>{job.qualifications.map((item) => <li>{item}</li>)}</ul>
          </section>
        )}

        <section class="company-description">
          <p class="eyebrow">Employer and source</p>
          <h3>About {job.company}</h3>
          <p>
            This opportunity was identified through {job.sourceLabel} and is connected with {job.location}.
            The employer controls the role, selection process and employment terms. Open the original source
            for the latest company information and application instructions.
          </p>
        </section>

        <section class="source-caveat">
          <strong>Source status</strong>
          <p>This record was checked on 2 September 2026. A source check does not guarantee that applications remain open or that compensation, location and requirements are unchanged.</p>
        </section>
      </article>

      <aside class="job-sidebar">
        <div class="glass-card details-card">
          <p class="eyebrow">Job overview</p>
          <h2>Position details</h2>
          <dl>
            <div><dt>Employer</dt><dd>{job.company}</dd></div>
            <div><dt>Location</dt><dd>{job.location}</dd></div>
            <div><dt>Category</dt><dd>{job.category}</dd></div>
            <div><dt>Job type</dt><dd>{job.type.join(', ')}</dd></div>
            {job.compensation && <div><dt>Advertised pay</dt><dd>{job.compensation}</dd></div>}
            <div><dt>Original source</dt><dd>{job.sourceLabel}</dd></div>
            <div><dt>Last checked</dt><dd>{job.sourceChecked}</dd></div>
          </dl>
          <a class="apply-button" href={job.sourceUrl} target="_blank" rel="nofollow noopener noreferrer">
            Check status and apply
            <span aria-hidden="true">-&gt;</span>
          </a>
          <p class="apply-note">You will leave this website and open the original job source.</p>
        </div>

        <div class="glass-card safety-card">
          <span class="safety-icon" aria-hidden="true">!</span>
          <div>
            <h2>Apply safely</h2>
            <p>Verify the employer and application domain. Never pay an application fee or send original identity documents to an unconfirmed contact.</p>
          </div>
        </div>

        <a class="back-link" href="/jobs"><span aria-hidden="true">&lt;-</span> Back to all jobs</a>
      </aside>
    </div>

    {relatedJobs.length > 0 && (
      <div class="container related">
        <div class="related-heading">
          <div><p class="eyebrow">Continue searching</p><h2>Related opportunities</h2></div>
          <a href="/jobs">Browse all jobs</a>
        </div>
        <div class="related-grid">
          {relatedJobs.map((item) => (
            <a href={`/jobs/${item.slug}`}>
              <span>{item.category}</span>
              <h3>{item.title}</h3>
              <p>{item.company} / {item.location}</p>
              <strong>View details -&gt;</strong>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <aside class="publication-meta" aria-label="Page publication information">
    <div class="container"><span>{job.publishedLabel}</span><a href={job.sourceUrl} target="_blank" rel="nofollow noopener noreferrer">Original source: {job.sourceLabel}</a></div>
  </aside>
</PageLayout>

<style>
  .job-detail-hero{padding:clamp(5rem,10vw,8rem) 0 4.25rem;background:radial-gradient(circle at 80% 0,#315f55 0,#102e2d 35%,#071a24 76%);color:#fff}
  .breadcrumb{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2.4rem;color:#8fa49e;font-size:.76rem}.breadcrumb a{color:#e5c773;text-decoration:none}
  .hero-flags{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:1rem}.hero-flags span{padding:.35rem .62rem;border:1px solid rgba(215,175,87,.32);border-radius:999px;background:rgba(215,175,87,.07);color:#e7c771;font-size:.67rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
  .job-detail-hero h1{max-width:960px;margin:0;color:#fff;font-family:var(--font-display);font-size:clamp(2.65rem,6.2vw,5.5rem);line-height:.98;letter-spacing:-.04em}
  .hero-company{margin:1.25rem 0 .65rem;color:#e3bd61;font-size:clamp(.95rem,2vw,1.15rem);font-weight:800}.hero-company span{padding:0 .35rem;color:#6f8d86}
  .hero-summary{max-width:780px;margin:0;color:#bacdc8;font-size:1rem;line-height:1.7}
  .job-detail-section{padding:clamp(3rem,7vw,6rem) 0;background:#071821;color:#fff}
  .job-detail-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(285px,.82fr);align-items:start;gap:1.5rem}
  .glass-card{background:linear-gradient(145deg,rgba(18,49,49,.9),rgba(7,27,35,.95));border:1px solid rgba(215,175,87,.18);box-shadow:0 20px 48px -35px #000}
  .job-copy{padding:clamp(1.5rem,4vw,2.8rem)}.eyebrow{margin:0 0 .65rem;color:#d7af57;font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
  .job-copy h2{margin:0 0 1.1rem;color:#fff;font-family:var(--font-display);font-size:clamp(2rem,4vw,2.8rem)}
  .job-copy h3{margin:0 0 .85rem;color:#e3bd61;font-size:1.06rem}.job-copy section{margin-top:2.3rem}
  .job-copy p,.job-copy li{color:#afc0bc;line-height:1.76}.job-copy ul{margin:0;padding-left:1.3rem}.job-copy li+li{margin-top:.55rem}.job-copy li::marker{color:#d7af57}
  .copy-intro{margin:0!important}.company-description{padding-top:2rem;border-top:1px solid rgba(255,255,255,.1)}
  .source-caveat{padding:1.15rem 1.25rem;border-left:3px solid #d7af57;background:rgba(215,175,87,.07)}.source-caveat strong{color:#f0cf7c}.source-caveat p{margin:.45rem 0 0;font-size:.78rem}
  .job-sidebar{position:sticky;top:94px;display:grid;gap:1rem}.job-sidebar>.glass-card{padding:1.35rem}.details-card h2{margin:0 0 1rem;color:#fff;font-family:var(--font-display);font-size:1.6rem}
  .details-card dl{margin:0}.details-card dl div{padding:.75rem 0;border-top:1px solid rgba(255,255,255,.1)}.details-card dt{color:#718b84;font-size:.63rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.details-card dd{margin:.28rem 0 0;color:#f2f5f4;font-size:.82rem;line-height:1.45}
  .apply-button{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1rem;padding:.9rem 1rem;background:#d7af57;color:#102421;text-decoration:none;font-size:.76rem;font-weight:950;text-transform:uppercase}.apply-button:hover{background:#e6c36f}.apply-note{margin:.65rem 0 0!important;color:#718b84!important;font-size:.65rem!important;line-height:1.45!important}
  .safety-card{display:grid;grid-template-columns:34px 1fr;gap:.8rem;border-color:rgba(205,121,63,.32)}.safety-icon{display:grid;width:30px;height:30px;place-items:center;border-radius:50%;background:#ba6c38;color:#fff;font-weight:950}.safety-card h2{margin:0;color:#efc57e;font-size:.92rem}.safety-card p{margin:.4rem 0 0;color:#b9aaa0;font-size:.73rem;line-height:1.55}
  .back-link{display:block;padding:.75rem;color:#d8bd77;text-align:center;text-decoration:none;font-size:.76rem;font-weight:800}
  .related{margin-top:4rem}.related-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.25rem}.related-heading h2{margin:0;color:#fff;font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.8rem)}.related-heading>a{color:#e2c476;font-size:.78rem;font-weight:800}
  .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.related-grid>a{display:flex;min-height:210px;flex-direction:column;padding:1.3rem;border:1px solid rgba(215,175,87,.17);background:#0b282d;color:#fff;text-decoration:none}.related-grid>a>span{color:#d7af57;font-size:.66rem;font-weight:900;text-transform:uppercase}.related-grid h3{margin:1.2rem 0 .5rem;font-family:var(--font-display);font-size:1.25rem}.related-grid p{margin:0;color:#8fa49e;font-size:.74rem;line-height:1.5}.related-grid strong{margin-top:auto;padding-top:1rem;color:#e2c476;font-size:.72rem}
  .publication-meta{padding:1rem 0;background:#04131a;color:#748a84}.publication-meta .container{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem}.publication-meta span,.publication-meta a{color:inherit;font-size:.67rem}
  @media(max-width:900px){.job-detail-layout{grid-template-columns:1fr}.job-sidebar{position:static}.related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.related-heading{align-items:flex-start;flex-direction:column}.related-grid{grid-template-columns:1fr}.publication-meta .container{flex-direction:column}.job-detail-hero{padding-top:4.2rem}}
</style>
