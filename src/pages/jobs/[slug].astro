---
/**
 * DHA Phase 6 Lahore — Single Job Detail Page
 * Matching the exact structure, layout, aesthetic, and components requested.
 */
import { JOBS, type JobRecord } from '@data/jobs';

export function getStaticPaths() {
  return JOBS.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

interface Props {
  job: JobRecord;
}

const { job } = Astro.props;

// Related jobs in the same category or company
const relatedJobs = JOBS.filter(
  (item) => item.slug !== job.slug && (item.category === job.category || item.company === job.company)
).slice(0, 3);
---

<!DOCTYPE html>
<html lang="en-PK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a1a">

  <!-- SEO -->
  <title>{job.title} at {job.company} | DHA Phase 6 Lahore Jobs</title>
  <meta name="description" content={`${job.title} opportunity at ${job.company} in ${job.location}. ${job.summary}`}>
  <meta name="keywords" content={`${job.title}, ${job.company}, jobs in DHA Phase 6 Lahore, ${job.category}`}>
  <meta name="author" content="DHA Phase 6 Lahore Guide">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <link rel="canonical" href={`https://dhaphase6lahore.pk/jobs/${job.slug}/`}>
  <link rel="alternate" hreflang="en-PK" href={`https://dhaphase6lahore.pk/jobs/${job.slug}/`}>
  <link rel="alternate" hreflang="x-default" href={`https://dhaphase6lahore.pk/jobs/${job.slug}/`}>

  <!-- Open Graph -->
  <meta property="og:title" content={`${job.title} at ${job.company}`}>
  <meta property="og:description" content={job.summary}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={`https://dhaphase6lahore.pk/jobs/${job.slug}/`}>
  <meta property="og:site_name" content="DHA Phase 6 Lahore">
  <meta property="og:locale" content="en_PK">
  <meta property="og:image" content="/images/hero-bg.png">
  <meta property="og:image:width" content="1920">
  <meta property="og:image:height" content="1080">
  <meta property="og:image:alt" content={job.title}>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${job.title} at ${job.company}`}>
  <meta name="twitter:description" content={job.summary}>
  <meta name="twitter:image" content="/images/hero-bg.png">

  <!-- Structured Data: JobPosting -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "JobPosting",
    "title": job.title,
    "description": job.summary,
    "datePosted": job.sourceChecked,
    "employmentType": "FULL_TIME",
    "hiringOrganization": {
      "@type": "Organization",
      "name": job.company,
      "sameAs": job.companyUrl || "https://dhaphase6lahore.pk/jobs/"
    },
    "jobLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "addressCountry": "PK"
      }
    }
  })}></script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'&gt;&lt;rect width='100' height='100' rx='16' fill='%23d4a844'/&gt;&lt;text x='50' y='66' font-size='48' text-anchor='middle' font-family='serif' font-weight='bold' fill='%230a0a1a'&gt;D6&lt;/text&gt;&lt;/svg&gt;">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <!-- Header / Navigation -->
  <header class="site-header">
    <nav class="navbar" id="navbar" aria-label="Primary navigation">
      <div class="container">
        <a href="/" class="nav-logo" aria-label="DHA Phase 6 Lahore home">
          <div class="nav-logo-icon">D6</div>
          DHA Phase <span>6</span> Lahore
        </a>
        <div class="nav-links" id="navLinks">
          <a href="/">Home</a>
          <a href="/sectors/">Sectors</a>
          <a href="/properties/">Properties</a>
          <a href="/places/">Places</a>
          <a href="/plots/">Plots</a>
          <a href="/jobs/" class="active" aria-current="page">Jobs</a>
          <a href="/dealers/">Dealers</a>
          <a href="/dha-phase-6-lahore-map/">Map</a>
          <a href="/dha-phase-6-lahore-map/#map-pdf-downloads" class="nav-cta">Map PDFs</a>
        </div>
        <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation menu" aria-controls="navLinks" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <!-- Single Job Detail Hero -->
    <header class="job-detail-hero">
      <div class="container">
        <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/jobs/">Jobs</a>
          <span class="breadcrumb-sep">›</span>
          <span aria-current="page">{job.title}</span>
        </nav>
        <div class="job-hero-badges">
          <span class="job-badge">{job.officialDha ? 'Official DHA Source' : 'Easily Apply'}</span>
          <span class="job-badge-tag">{job.category}</span>
        </div>
        <h1>{job.title}</h1>
        <p class="job-hero-company">
          {job.companyUrl ? (
            <a class="job-company-search" href={job.companyUrl} target="_blank" rel="nofollow noopener noreferrer external" aria-label={`Search Google for ${job.company}`}>
              {job.company}
            </a>
          ) : (
            <span>{job.company}</span>
          )}
          <span class="company-sep">•</span> {job.location}
        </p>
        <p class="job-hero-summary">{job.summary}</p>
      </div>
    </header>

    <!-- Main Job Detail Layout Section -->
    <section class="content-section bg-primary">
      <div class="container job-detail-layout">
        <!-- Main Job Copy -->
        <article class="job-copy glass-card">
          <h2>About this position</h2>
          <p>{job.summary}</p>

          <h3>Key Responsibilities</h3>
          <ul>
            {job.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>

          {job.qualifications && job.qualifications.length > 0 && (
            <>
              <h3>Qualifications &amp; Requirements</h3>
              <ul>
                {job.qualifications.map((req) => (
                  <li>{req}</li>
                ))}
              </ul>
            </>
          )}

          <div class="company-description">
            <h3>About {job.company}</h3>
            <p>
              {job.company} operates in {job.location}. Teams handle operations, project planning, client service, and professional management.
            </p>
          </div>

          <aside class="job-notice glass-card" style="margin-top: 32px;">
            <h2>Before you apply</h2>
            <p>Confirm the role, pay, and work location with the employer. Do not pay a fee to apply for a job.</p>
          </aside>
        </article>

        <!-- Sidebar -->
        <aside class="job-sidebar">
          <div class="glass-card">
            <h2>Position Details</h2>
            <dl>
              <div>
                <dt>Employer</dt>
                <dd>{job.company}</dd>
              </div>
              <div>
                <dt>Location</dt>
                <dd>{job.location}</dd>
              </div>
              <div>
                <dt>Category</dt>
                <dd>{job.category}</dd>
              </div>
              <div>
                <dt>Job Type</dt>
                <dd>{job.type.join(', ')}</dd>
              </div>
              {job.compensation && (
                <div>
                  <dt>Salary / Pay</dt>
                  <dd>{job.compensation}</dd>
                </div>
              )}
              <div>
                <dt>Date Added</dt>
                <dd>{job.publishedLabel}</dd>
              </div>
            </dl>

            <div class="job-contact" style="margin-top: 24px;">
              <h3>Official Source Link</h3>
              <a href={job.sourceUrl} target="_blank" rel="nofollow noopener noreferrer" class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: 10px;">
                Apply on {job.sourceLabel} →
              </a>
            </div>
          </div>

          <a href="/jobs/" class="job-back-link">
            ← Back to all jobs
          </a>
        </aside>
      </div>

      <!-- Related Jobs -->
      {relatedJobs.length > 0 && (
        <div class="container" style="margin-top: 64px;">
          <div class="content-section-header reveal" style="text-align: left; margin-bottom: 28px;">
            <span class="section-label">Explore More</span>
            <h2 class="section-title">Related Job Openings</h2>
          </div>

          <div class="job-grid">
            {relatedJobs.map((item) => (
              <article class="job-card glass-card">
                <div class="job-card-topline">
                  <span>{item.location}</span>
                  <span class="job-badge">Easily apply</span>
                </div>
                <h2><a href={`/jobs/${item.slug}/`}>{item.title}</a></h2>
                <p class="job-company"><span>{item.company}</span></p>
                <p class="job-date">Added <time datetime="2026-08-22">{item.publishedLabel}</time></p>
                <div class="job-tags">
                  {item.type.map((t) => <span>{t}</span>)}
                </div>
                <p>{item.summary}</p>
                <a class="job-details-link" href={`/jobs/${item.slug}/`}>View job details →</a>
              </article>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- Publication Meta -->
    <aside class="page-publication-meta" aria-label="Page publication information">
      <div class="container">
        <span>Published <time datetime="2026-09-02T18:14:54+05:00">2 September 2026</time></span>
      </div>
    </aside>
  </main>

  <!-- Footer -->
  <footer class="footer" id="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="footer-logo">
            <div class="footer-logo-icon">D6</div>
            DHA Phase 6 Lahore
          </div>
          <p class="footer-brand-description">
            An independent local guide to sectors, properties, maps, places, services, and everyday life across DHA Phase 6 Lahore.
          </p>
          <div class="footer-socials" aria-label="Social media">
            <a href="#" aria-label="Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v2H6v4h3v7h4v-7h3.3l.7-4h-4V9c0-.7.3-1 1-1Z"></path></svg>
            </a>
            <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="DHA Phase 6 Lahore on LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.2A2.2 2.2 0 1 0 6.5 3.8a2.2 2.2 0 0 0 0 4.4ZM4.6 21h3.8V10H4.6v11ZM10.6 10h3.6v1.5h.1c.5-.9 1.7-2 3.6-2 3.8 0 4.5 2.5 4.5 5.8V21h-3.8v-5c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-3.8V10Z"></path></svg>
            </a>
          </div>
        </div>

        <nav aria-label="Footer pages">
          <h3 class="footer-heading">Pages</h3>
          <div class="footer-links">
            <a href="/">Home</a>
            <a href="/sectors/">Sectors</a>
            <a href="/properties/">Property Listings</a>
            <a href="/plots/">Plots</a>
            <a href="/houses/">Houses</a>
            <a href="/dealers/">Property Dealers</a>
            <a href="/dha-phase-6-lahore-map/">Map</a>
            <a href="/places/">Places &amp; Services</a>
            <a href="/helplines/">Helpline</a>
            <a href="/postal-code/">Postal Code</a>
            <a href="/weather/">Weather</a>
            <a href="/jobs/">Jobs</a>
            <a href="/development-updates/">Latest News</a>
            <a href="/location/">Directions</a>
            <a href="/utilities/">Utility Bill</a>
            <a href="/faq/">FAQ</a>
            <a href="/prayer-times/">Prayer Times</a>
            <a href="/dha-phase-6-lahore-prices/">Prices</a>
            <a href="/construction/">Construction Rate</a>
            <a href="/sitemap/">Sitemap</a>
            <a href="/sitemap/">HTML Sitemap</a>
          </div>
        </nav>

        <nav aria-label="Sector guides">
          <h3 class="footer-heading">Sectors</h3>
          <div class="footer-links">
            <a href="/sectors/sector-a/">Sector A</a>
            <a href="/sectors/sector-b/">Sector B</a>
            <a href="/sectors/sector-c/">Sector C</a>
            <a href="/sectors/sector-d/">Sector D</a>
            <a href="/sectors/sector-e/">Sector E</a>
            <a href="/sectors/sector-f/">Sector F</a>
            <a href="/sectors/sector-g/">Sector G</a>
            <a href="/sectors/sector-h/">Sector H</a>
            <a href="/sectors/sector-j/">Sector J</a>
            <a href="/sectors/sector-k/">Sector K</a>
            <a href="/sectors/sector-l/">Sector L</a>
            <a href="/sectors/sector-m/">Sector M</a>
            <a href="/sectors/sector-n/">Sector N</a>
          </div>
        </nav>

        <section class="footer-contact" aria-labelledby="footer-contact-heading">
          <h3 class="footer-heading" id="footer-contact-heading">Official DHA Contact</h3>
          <div class="footer-nap">
            <div class="footer-nap-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V9l7-6 7 6v12M9 21v-6h6v6M9 11h.01M12 11h.01M15 11h.01"></path></svg>
              <div>
                <span>Name</span>
                <strong>DHA Phase 6 Lahore</strong>
              </div>
            </div>
            <div class="footer-nap-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
              <div>
                <span>Official address</span>
                <address>Main Boulevard Phase 6 / Sector A, DHA Lahore, Punjab 54792, Pakistan</address>
              </div>
            </div>
            <div class="footer-nap-item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2.1Z"></path></svg>
              <div>
                <span>Official helpline</span>
                <a href="tel:+9242111342547">+92-42-111-342-547</a>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="footer-bottom">
        <div class="footer-copyright">&copy; 2026 DHA Phase 6 Lahore Guide. All rights reserved.</div>
      </div>
    </div>
  </footer>

  <!-- Back to top button -->
  <button class="back-to-top" id="backToTop" aria-label="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
  </button>

  <!-- Client-side Script -->
  <script is:inline>
    // Navbar Scrolled State & Back to Top
    const navbar = document.querySelector('#navbar');
    const backToTop = document.querySelector('#backToTop');
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      if (navbar) {
        if (scrollY > 50) navbar.classList.add('scrolled');
        else navbar.classList.remove('scrolled');
      }
      if (backToTop) {
        if (scrollY > 400) backToTop.classList.add('visible');
        else backToTop.classList.remove('visible');
      }
    }, { passive: true });

    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Mobile Menu Toggle
    const navToggle = document.querySelector('#navToggle');
    const navLinks = document.querySelector('#navLinks');
    navToggle?.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', String(!isExpanded));
      navToggle.classList.toggle('active');
      navLinks?.classList.toggle('active');
    });

    navLinks?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navToggle?.setAttribute('aria-expanded', 'false');
        navToggle?.classList.remove('active');
        navLinks?.classList.remove('active');
      });
    });
  </script>
</body>
</html>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════════
   * STYLES FOR SINGLE JOB DETAIL PAGE & GLOBAL THEME
   * ══════════════════════════════════════════════════════════════════════════ */
  :root {
    --clr-bg-primary: #0a0a1a;
    --clr-bg-secondary: #111128;
    --clr-bg-card: #161635;
    --clr-accent-gold: #d4a844;
    --clr-accent-gold-light: #f0c95c;
    --clr-accent-emerald: #2ecc71;
    --clr-text-primary: #f0f0f5;
    --clr-text-secondary: #9a9ab5;
    --clr-text-muted: #6a6a85;
    --clr-glass: rgba(255, 255, 255, 0.04);
    --clr-glass-border: rgba(255, 255, 255, 0.08);
    --clr-glass-hover: rgba(255, 255, 255, 0.07);
    --grad-gold: linear-gradient(135deg, #d4a844, #f0c95c);
    --ff-heading: 'Inter', ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --ff-body: 'Inter', ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --section-pad: 80px 0;
    --container-max: 1200px;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 16px;
    background-color: var(--clr-bg-primary);
  }

  body {
    font-family: var(--ff-body);
    background-color: var(--clr-bg-primary);
    color: var(--clr-text-primary);
    line-height: 1.7;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    transition: color 0.3s var(--ease-out);
    text-decoration: none;
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 20px;
    background: var(--clr-accent-gold);
    color: var(--clr-bg-primary);
    padding: 10px 16px;
    z-index: 9999;
    font-weight: 700;
    border-radius: var(--radius-sm);
  }
  .skip-link:focus {
    top: 20px;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .glass-card {
    background: var(--clr-glass);
    border: 1px solid var(--clr-glass-border);
    border-radius: var(--radius-md);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: all 0.4s var(--ease-out);
  }

  /* HEADER & NAVBAR */
  .site-header {
    position: relative;
    z-index: 1000;
  }
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 18px 0;
    transition: all 0.4s var(--ease-out);
  }
  .navbar.scrolled {
    background: rgba(10, 10, 26, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--clr-glass-border);
    padding: 12px 0;
  }
  .navbar .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--ff-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--clr-text-primary);
  }
  .nav-logo-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--grad-gold);
    color: var(--clr-bg-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    font-weight: 800;
  }
  .nav-logo span {
    color: var(--clr-accent-gold);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-links a {
    color: var(--clr-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 4px 0;
    position: relative;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--grad-gold);
    border-radius: 2px;
    transition: width 0.3s var(--ease-out);
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--clr-text-primary);
  }
  .nav-links a:hover::after,
  .nav-links a.active::after {
    width: 100%;
  }
  .nav-cta {
    background: var(--grad-gold) !important;
    color: var(--clr-bg-primary) !important;
    padding: 10px 22px !important;
    border-radius: var(--radius-sm);
    font-weight: 700 !important;
  }
  .nav-cta::after {
    display: none !important;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 1001;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--clr-text-primary);
    border-radius: 2px;
    transition: all 0.3s var(--ease-out);
  }

  /* JOB DETAIL HERO */
  .job-detail-hero {
    background: var(--clr-bg-secondary);
    padding: 150px 0 58px;
    border-bottom: 1px solid var(--clr-glass-border);
