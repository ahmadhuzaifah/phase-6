---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { SEO_ARTICLES } from '@data/articles';

export function getStaticPaths() {
  return SEO_ARTICLES.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const articleUrl = `${SITE.url}/blog/${article.slug}`;

const articleSchema = {
  headline: article.title,
  description: article.description,
  image: `${SITE.url}${article.image}`,
  datePublished: article.publishedDate,
  dateModified: article.updatedDate,
  author: { '@type': 'Organization', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: articleUrl,
};

const faqSchema = article.faqs && article.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': article.faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
  }))
} : null;
---

<PageLayout title={article.title} description={article.description} canonical={articleUrl} ogImage={article.image} ogType="article">
  <Schema type="Article" data={articleSchema} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

  <article class="article-page"><div class="container article-page__container">
    <p class="eyebrow">{article.category} / Updated {article.updatedDate}</p>
    <h1>{article.title}</h1>
    <p class="article-page__intro">{article.introduction}</p>
    <img class="article-page__image" src={article.image} alt={article.imageAlt} width="1200" height="630" />
    {article.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}

    {article.faqs && article.faqs.length > 0 && (
      <section class="article-faqs">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
          {article.faqs.map((faq, idx) => (
            <details class="faq-detail" id={`faq-${idx+1}`}>
              <summary><strong>{faq.question}</strong></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <aside class="article-page__links"><strong>Continue your research</strong><div>{article.relatedLinks.map((link) => <a href={link.href}>{link.label}</a>)}</div></aside>
    <p class="article-page__note">Information on this independent portal is for research and buyer guidance. Confirm current availability, prices, title, dues, and transfer requirements with the authorized management office before transacting.</p>
  </div></article>
</PageLayout>

<style>
  .article-page { padding: var(--space-16) 0; }
  .article-page__container { max-width: 820px; }
  .article-page h1 { max-width: 18ch; margin: var(--space-3) 0 var(--space-5); }
  .article-page__intro { font-size: var(--text-xl); color: var(--text-secondary); line-height: var(--leading-relaxed); }
  .article-page__image { display: block; width: 100%; height: auto; margin: var(--space-8) 0; border-radius: var(--radius-xl); }
  .article-page section { margin-top: var(--space-8); }
  .article-page section h2 { font-size: var(--text-2xl); }
  .article-page section p { color: var(--text-secondary); line-height: var(--leading-relaxed); }
  .article-page__links { margin-top: var(--space-10); padding: var(--space-5); border: 1px solid var(--border-gold); border-radius: var(--radius-lg); background: var(--color-primary-50); }
  .article-page__links div { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-3); }
  .article-page__links a { color: var(--color-primary-800); font-weight: var(--font-bold); }
  .article-faqs { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--border-light); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-4); }
  .faq-detail { background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: var(--space-4); }
  .faq-detail summary { cursor: pointer; color: var(--text-primary); font-size: var(--text-base); }
  .faq-detail p { margin-top: var(--space-3); margin-bottom: 0; color: var(--text-secondary); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .article-page__note { margin-top: var(--space-8); color: var(--text-muted); font-size: var(--text-sm); }
</style>
