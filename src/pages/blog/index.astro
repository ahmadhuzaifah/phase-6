---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { SEO_ARTICLES } from '@data/articles';

const description = 'Independent market updates, buying guides, map explainers, and property verification resources for Al Rehman Garden Phase 2 Lahore.';
const pageSchema = { name: `${SITE.name} Market & Buying Guides`, description, url: `${SITE.url}/blog` };
---

<PageLayout title={`Market & Buying Guides | ${SITE.name}`} description={description} canonical={`${SITE.url}/blog`}>
  <Schema type="WebSite" data={pageSchema} />
  <section class="blog-hero"><div class="container"><p class="eyebrow eyebrow--dark">Independent Research Desk</p><h1>Market notes for <span class="text-gradient-gold">better property decisions</span></h1><p class="lead">Practical guides covering prices, blocks, maps, due diligence, and investment research in Al Rehman Garden Phase 2 Lahore.</p></div></section>
  <section class="section"><div class="container"><div class="article-grid">
    {SEO_ARTICLES.map((article) => <article class="article-card"><img src={article.image} alt={article.imageAlt} width="1200" height="630" loading="lazy" /><div class="article-card__body"><span class="badge">{article.category}</span><p class="article-card__date">Updated {article.updatedDate}</p><h2><a href={`/blog/${article.slug}`}>{article.title}</a></h2><p>{article.description}</p><a class="btn btn--outline btn--sm" href={`/blog/${article.slug}`}>Read the guide</a></div></article>)}
  </div></div></section>
</PageLayout>

<style>
  .blog-hero { padding: var(--space-16) 0 var(--space-12); background: radial-gradient(circle at 80% 15%, #16244F, #0A1128 72%); color: #fff; }
  .blog-hero h1 { max-width: 18ch; color: #fff; margin: var(--space-3) 0; }
  .blog-hero .lead { max-width: 60ch; color: var(--color-neutral-300); }
  .section { padding: var(--space-16) 0; }
  .article-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); }
  .article-card { overflow: hidden; border: 1px solid var(--border-light); border-radius: var(--radius-xl); background: var(--bg-primary); box-shadow: var(--shadow-card); transition: transform var(--transition-fast), border-color var(--transition-fast); }
  .article-card:hover { transform: translateY(-4px); border-color: var(--border-gold); }
  .article-card img { display: block; width: 100%; aspect-ratio: 1.9; object-fit: cover; }
  .article-card__body { padding: var(--space-5); }
  .article-card__date { color: var(--text-muted); font-size: var(--text-xs); margin: var(--space-2) 0; }
  .article-card h2 { font-size: var(--text-xl); margin: 0 0 var(--space-2); }
  .article-card h2 a { color: var(--text-primary); text-decoration: none; }
  .article-card h2 a:hover { color: var(--color-primary-700); }
  .article-card p:not(.article-card__date) { color: var(--text-secondary); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
</style>
