  }

  .dha-weather-content > p b {
    color: var(--clr-text-primary);
    font-weight: 600;
  }

  .dha-weather-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .dha-weather-card {
    padding: 28px 24px;
    text-align: center;
  }

  .dha-weather-icon {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .dha-weather-card h3 {
    font-family: var(--ff-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--clr-accent-gold);
    margin-bottom: 10px;
  }

  .dha-weather-temp {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--clr-text-primary);
    margin-bottom: 4px;
  }

  .dha-weather-temp-alt {
    display: block;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--clr-text-muted);
    margin-bottom: 12px;
  }

  .dha-weather-card p {
    font-size: 0.88rem;
    color: var(--clr-text-secondary);
    line-height: 1.65;
    text-align: left;
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * CONTACT SECTION
   * ══════════════════════════════════════════════════════════════════════════ */
  .dha-contact-section {
    padding: var(--section-pad);
    background: var(--clr-bg-secondary);
    position: relative;
  }

  .dha-contact-header {
    text-align: left;
    margin-bottom: 36px;
  }

  .dha-contact-content > p {
    color: var(--clr-text-secondary);
    font-size: 1.05rem;
    line-height: 1.85;
    margin-bottom: 40px;
  }

  .dha-contact-content > p b {
    color: var(--clr-text-primary);
    font-weight: 600;
  }

  .dha-contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .dha-contact-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
  }

  .dha-contact-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: rgba(212, 168, 68, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dha-contact-icon svg {
    stroke: var(--clr-accent-gold);
  }

  .dha-contact-card h3 {
    font-family: var(--ff-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--clr-text-primary);
  }

  .dha-contact-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dha-contact-value {
    color: var(--clr-accent-gold);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .dha-contact-label {
    color: var(--clr-text-muted);
    font-size: 0.82rem;
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * SECTORS SECTION
   * ══════════════════════════════════════════════════════════════════════════ */
  .sectors {
    padding: var(--section-pad);
    background: var(--clr-bg-primary);
    position: relative;
  }

  .sectors-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .sectors-header .section-subtitle {
    margin: 0 auto;
  }

  .sectors-header .section-title a {
    color: inherit;
    text-decoration: none;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px;
  }

  .sector-card {
    text-align: center;
    padding: 32px 24px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .sector-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--grad-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }

  .sector-card:hover::before {
    transform: scaleX(1);
  }

  .sector-letter {
    font-family: var(--ff-heading);
    font-size: 2.4rem;
    font-weight: 800;
    background: var(--grad-gold);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
    transition: transform 0.3s var(--ease-spring);
  }

  .sector-card:hover .sector-letter {
    transform: scale(1.12);
  }

  .sector-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--clr-text-primary);
    margin-bottom: 10px;
  }

  .sector-desc {
    font-size: 0.85rem;
    color: var(--clr-text-secondary);
    line-height: 1.6;
  }

  .sector-tag {
    display: inline-block;
    margin-top: 14px;
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--clr-accent-emerald);
    background: rgba(46, 204, 113, 0.12);
    border: 1px solid rgba(46, 204, 113, 0.25);
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * PROPERTY PRICES SECTION
   * ══════════════════════════════════════════════════════════════════════════ */
  .property-prices {
    padding: var(--section-pad);
    background: var(--clr-bg-secondary);
    position: relative;
  }

  .prices-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .prices-header .section-subtitle {
    margin: 0 auto;
  }

  .price-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 44px;
  }

  .price-tab {
    padding: 12px 28px;
    border-radius: 50px;
    border: 1px solid var(--clr-glass-border);
    background: transparent;
    color: var(--clr-text-secondary);
    font-family: var(--ff-body);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
  }

  .price-tab:hover {
    color: var(--clr-text-primary);
    border-color: rgba(212, 168, 68, 0.3);
  }

  .price-tab.active {
    background: var(--grad-gold);
    color: var(--clr-bg-primary);
    border-color: transparent;
    font-weight: 700;
    box-shadow: 0 4px 18px rgba(212, 168, 68, 0.3);
  }

  .price-panels {
    min-height: 280px;
    position: relative;
  }

  .price-panel {
    display: none;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    animation: fadeIn 0.4s var(--ease-out);
  }

  .price-panel.active {
    display: grid;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .price-card {
    padding: 30px 22px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .price-card-size {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--clr-text-muted);
    margin-bottom: 8px;
  }

  .price-card-value {
    font-family: var(--ff-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--clr-accent-gold);
    margin-bottom: 4px;
  }

  .price-card-range {
    font-size: 0.82rem;
    color: var(--clr-text-secondary);
    margin-bottom: 18px;
  }

  .price-bar {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
  }

  .price-bar-fill {
    height: 100%;
    width: 0;
    background: var(--grad-gold);
    border-radius: 3px;
    transition: width 1s var(--ease-out);
  }

  .price-card:hover .price-bar-fill {
    box-shadow: 0 0 12px rgba(212, 168, 68, 0.5);
  }

  .price-disclaimer {
    text-align: center;
    color: var(--clr-text-muted);
    font-size: 0.84rem;
    font-style: italic;
    margin-top: 40px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * PLACES DIRECTORY / AMENITIES
   * ══════════════════════════════════════════════════════════════════════════ */
  .amenities {
    padding: var(--section-pad);
    background: var(--clr-bg-primary);
    position: relative;
    overflow: hidden;
  }

  .amenities-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .amenities-header .section-subtitle {
    margin: 0 auto;
  }

  .amenities-header .section-title a {
    color: inherit;
    text-decoration: none;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .amenity-card {
    padding: 32px 18px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .amenity-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background: rgba(212, 168, 68, 0.08);
    border: 1px solid rgba(212, 168, 68, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
    transition: all 0.3s var(--ease-spring);
  }

  .amenity-card:hover .amenity-icon {
    background: rgba(212, 168, 68, 0.18);
    transform: scale(1.1) rotate(-3deg);
  }

  .amenity-icon svg {
    stroke: var(--clr-accent-gold);
  }

  .amenity-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--clr-text-primary);
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * PUBLICATION META
   * ══════════════════════════════════════════════════════════════════════════ */
  .page-publication-meta {
    padding: 20px 0;
    background: var(--clr-bg-secondary);
    border-top: 1px solid var(--clr-glass-border);
    border-bottom: 1px solid var(--clr-glass-border);
    color: var(--clr-text-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * FOOTER
   * ══════════════════════════════════════════════════════════════════════════ */
  .footer {
    background: var(--clr-bg-secondary);
    border-top: 1px solid var(--clr-glass-border);
    padding: 64px 0 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1fr 1.4fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--ff-heading);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 18px;
  }

  .footer-logo-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--grad-gold);
    color: var(--clr-bg-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .footer-brand-description {
    color: var(--clr-text-secondary);
    font-size: 0.88rem;
    line-height: 1.7;
    margin: 0;
  }

  .footer-socials {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--clr-glass-border);
    color: var(--clr-text-secondary);
    transition: all 0.3s var(--ease-out);
  }

  .footer-socials a:hover {
    color: var(--clr-accent-gold);
    background: rgba(212, 168, 68, 0.12);
    border-color: rgba(212, 168, 68, 0.45);
    transform: translateY(-2px);
  }

  .footer-socials svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .footer-heading {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--clr-text-primary);
    margin-bottom: 20px;
  }

  .footer-links a {
    display: block;
    color: var(--clr-text-secondary);
    font-size: 0.88rem;
    padding: 5px 0;
    transition: all 0.3s var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--clr-accent-gold);
    transform: translateX(4px);
  }

  .footer-contact {
    min-width: 0;
  }

  .footer-nap {
    display: grid;
    gap: 18px;
  }

  .footer-nap-item {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 11px;
    align-items: start;
  }

  .footer-nap-item > svg {
    width: 20px;
    height: 20px;
    stroke: var(--clr-accent-gold);
    fill: none;
    stroke-width: 1.8px;
    margin-top: 2px;
  }

  .footer-nap-item div {
    display: grid;
    gap: 4px;
  }

  .footer-nap-item span {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-text-muted);
  }

  .footer-nap-item strong,
  .footer-nap-item address,
  .footer-nap-item a {
    color: var(--clr-text-secondary);
    font-size: 0.84rem;
    font-style: normal;
    font-weight: 500;
    line-height: 1.55;
    margin: 0;
  }

  .footer-nap-item a {
    color: var(--clr-accent-gold);
  }

  .footer-nap-item a:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--clr-glass-border);
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-copyright {
    color: var(--clr-text-muted);
    font-size: 0.82rem;
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * AGENT CONTACT POPUP WIDGET
   * ══════════════════════════════════════════════════════════════════════════ */
  .agent-contact-popup {
    box-sizing: border-box;
    position: fixed;
    bottom: 96px;
    right: 24px;
    z-index: 1000;
    width: min(360px, calc(100vw - 32px));
    padding: 20px;
    border-radius: 18px;
    background: rgba(17, 17, 37, 0.96);
    border: 1px solid rgba(212, 168, 68, 0.3);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    color: var(--clr-text-primary);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.42), 0 0 30px rgba(212, 168, 68, 0.1);
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }

  .agent-contact-popup[hidden] {
    display: none;
  }

  .agent-contact-popup.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .agent-popup-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    border-radius: 50%;
    color: var(--clr-text-muted);
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .agent-popup-close:hover {
    color: var(--clr-text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .agent-popup-profile {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-right: 28px;
  }

  .agent-popup-photo {
    position: relative;
    flex: none;
  }

  .agent-popup-photo img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid var(--clr-accent-gold);
    object-fit: cover;
  }

  .agent-popup-photo span {
    position: absolute;
    bottom: 3px;
    right: 1px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #25d366;
    border: 2px solid #111125;
  }

  .agent-popup-profile small {
    display: block;
    color: var(--clr-accent-gold);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .agent-popup-profile strong {
    display: block;
    font-family: var(--ff-heading);
    font-size: 1.05rem;
    margin: 2px 0;
  }

  .agent-popup-profile span {
    display: block;
    color: var(--clr-text-muted);
    font-size: 0.72rem;
  }

  .agent-contact-popup > p {
    font-size: 0.88rem;
    color: var(--clr-text-secondary);
    line-height: 1.6;
    margin: 16px 0;
  }

  .agent-contact-popup > p strong {
    color: var(--clr-text-primary);
  }

  .agent-popup-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 18px;
    border-radius: 10px;
    background: #20bd5a;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 800;
    transition: transform 0.2s, background 0.2s;
  }

  .agent-popup-whatsapp:hover {
    background: #16a34a;
    transform: translateY(-2px);
    color: #fff;
  }

  .agent-popup-whatsapp svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * BACK TO TOP
   * ══════════════════════════════════════════════════════════════════════════ */
  .back-to-top {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 999;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--grad-gold);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(212, 168, 68, 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    transition: all 0.3s var(--ease-out);
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(212, 168, 68, 0.55);
  }

  .back-to-top svg {
    width: 20px;
    height: 20px;
    stroke: var(--clr-bg-primary);
  }

  /* ══════════════════════════════════════════════════════════════════════════
   * RESPONSIVENESS
   * ══════════════════════════════════════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .dha-detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 768px) {
    :root {
      --section-pad: 72px 0;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      width: min(290px, 100%);
      height: 100vh;
      background: rgba(10, 10, 26, 0.97);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-left: 1px solid var(--clr-glass-border);
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 90px 32px 40px;
      transform: translateX(100%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
    }

    .nav-links.active {
      transform: translateX(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav-links a {
      font-size: 1.05rem;
      width: 100%;
    }

    .dha-detail-grid,
    .dha-amenity-list,
    .dha-map-info-grid,
    .dha-contact-grid {
      grid-template-columns: 1fr;
    }

    .dha-weather-grid {
      grid-template-columns: 1fr 1fr;
    }

    .hero-stats {
      gap: 20px;
    }

    .hero-stat {
      padding-right: 20px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }

    .agent-contact-popup {
      right: 16px;
      left: 16px;
      bottom: 84px;
      width: auto;
    }
  }

  @media (max-width: 480px) {
    .hero-stats {
      flex-direction: column;
      gap: 16px;
    }

    .hero-stat::after {
      display: none !important;
    }

    .dha-weather-grid {
      grid-template-columns: 1fr;
    }

    .amenities-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .amenity-card {
      padding: 22px 10px;
    }

    .amenity-icon {
      width: 50px;
      height: 50px;
      margin-bottom: 12px;
    }

    .sectors-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .sector-card {
