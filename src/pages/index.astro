---
/**
 * Homepage — Al Rehman Garden Phase 2 Lahore
 * Premium Real Estate Authority Website Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import Button from '@components/global/Button.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import BlockCard from '@components/blocks/BlockCard.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import { BLOCKS } from '@data/blocks';
import { AMENITIES } from '@data/amenities';

import propertiesData from '@data/properties-import.json';

const websiteSchema = {
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/properties?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

// Pull live verified featured listings from imported database
const featuredProperties = propertiesData.slice(0, 6);

// Connectivity Locations Matrix
const travelConnectivity = [
  { name: 'M-2 Motorway (Faizpur Interchange)', time: '2 Minutes', icon: '🛣️', note: 'Direct signal-free exit' },
  { name: 'Mall Road & Lower Mall Lahore', time: '10 Minutes', icon: '🏛️', note: 'Via Sagian Bridge / Ring Road' },
  { name: 'Thokar Niaz Baig Interchange', time: '12 Minutes', icon: '🚗', note: 'Via M-2 Motorway link' },
  { name: 'District Courts & Civil Lines', time: '12 Minutes', icon: '⚖️', note: 'Fast central artery commute' },
  { name: 'Lahore Ring Road Access', time: '5 Minutes', icon: '🔄', note: 'Connecting all Lahore sectors' },
  { name: 'Allama Iqbal International Airport', time: '25 Minutes', icon: '✈️', note: 'Direct via Ring Road expressway' },
];

// FAQs
const faqs = [
  {
    q: 'Is Al Rehman Garden Phase 2 approved by LDA?',
    a: 'Yes, Al Rehman Garden Phase 2 is an authorized and legally compliant master-planned housing society with sanctioned NOC status from Lahore Development Authority (LDA) and relevant regulatory bodies, ensuring clear ownership titles.',
  },
  {
    q: 'Where is Al Rehman Garden Phase 2 located in Lahore?',
    a: 'Al Rehman Garden Phase 2 is strategically located on Main Sharaqpur Road, just 2 minutes drive from the M-2 Motorway (Faizpur Interchange) and 10 minutes from Mall Road and Lower Mall Lahore.',
  },
  {
    q: 'Are plots available on cash and installment plans?',
    a: 'Yes! Developed sectors (Block A, B, C, D, E, F) offer instant possession on full cash payments, while upcoming sectors (Mirabel Block, Royal Block, Beverly Hills) offer convenient 3-to-5 year flexible monthly installment plans.',
  },
  {
    q: 'What amenities and underground utilities are operational?',
    a: 'The society features 100% operational underground electricity, dedicated Sui gas connections, RO water filtration plants, 24/7 security with CCTV monitoring, 150ft main boulevards, Al-Rehman Hospital, schools, grand mosques, and lush family parks.',
  },
  {
    q: 'How can I verify plot title and schedule a site visit?',
    a: 'You can directly contact our official property advisory helpline or click the WhatsApp Inquiry button to verify plot numbers, check map locations, and book a guided on-ground site visit.',
  },
];
---

<PageLayout
  title="Al Rehman Garden Phase 2 Lahore — Premium Real Estate & Property Authority"
  description="Discover Al Rehman Garden Phase 2 Lahore on Main Sharaqpur Road near M2 Motorway. Explore LDA approved residential and commercial plots, block maps, current market prices, and flexible installment plans."
>
  <Schema type="WebSite" data={websiteSchema} />

  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 1: HERO & PROPERTY QUICK FINDER
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="container hero__container">
      <div class="hero__content">
        <!-- Eyebrow Tag -->
        <div class="eyebrow eyebrow--dark">
          <span class="hero__pulse-dot"></span>
          <span>Official Information & Property Portal</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero__title">
          Al Rehman Garden <br />
          <span class="text-gradient-gold">Phase 2 Lahore</span>
        </h1>

        <!-- Value Proposition -->
        <p class="hero__lead lead">
          The premier master-planned housing community on <strong>Main Sharaqpur Road</strong>, just 2 minutes from <strong>M-2 Motorway Faizpur Interchange</strong>. Secure your dream home with 100% on-ground infrastructure, instant possession, and high-ROI investment potential.
        </p>

        <!-- CTA Buttons -->
        <div class="hero__actions">
          <Button href="#properties-preview" variant="primary" size="lg">
            Explore Plots & Properties
          </Button>
          <a
            href={CONTACTS.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--accent btn--lg"
          >
            <svg class="hero__btn-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
            </svg>
            <span>WhatsApp Advisory</span>
          </a>
        </div>

        <!-- Quick Society Highlights Badges -->
        <div class="hero__highlights">
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">🏛️</span>
            <span>LDA Approved</span>
          </div>
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">⚡</span>
            <span>Underground Grid</span>
          </div>
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">🔑</span>
            <span>Ready Possession</span>
          </div>
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">🛡️</span>
            <span>24/7 Gated Security</span>
          </div>
        </div>
      </div>

      <!-- Quick Property Finder Card -->
      <div class="hero__finder-card">
        <div class="finder-card__header">
          <h2 class="finder-card__title">Find Plots & Properties</h2>
          <p class="finder-card__subtitle">Instant search across all Phase 2 sectors</p>
        </div>

        <form class="finder-card__form" action="/properties" method="get">
          <!-- Property Purpose -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-purpose">Purpose</label>
            <select id="hero-purpose" name="purpose" class="finder-card__select">
              <option value="sale" selected>For Sale (Buy Plot / House)</option>
              <option value="rent">For Rent</option>
              <option value="lease">Commercial Lease</option>
            </select>
          </div>

          <!-- Property Type -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-type">Property Category</label>
            <select id="hero-type" name="type" class="finder-card__select">
              <option value="">All Categories</option>
              <option value="residential" selected>Residential Plots</option>
              <option value="commercial">Commercial Plots</option>
              <option value="luxury-villas">Villas & Houses</option>
            </select>
          </div>

          <!-- Plot Size -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-size">Plot Size</label>
            <select id="hero-size" name="size" class="finder-card__select">
              <option value="">Any Size</option>
              <option value="3-marla">3 Marla</option>
              <option value="5-marla" selected>5 Marla (Most Popular)</option>
              <option value="7-marla">7 Marla</option>
              <option value="10-marla">10 Marla</option>
              <option value="1-kanal">1 Kanal</option>
            </select>
          </div>

          <!-- Block -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-block">Block / Sector</label>
            <select id="hero-block" name="block" class="finder-card__select">
              <option value="">All Society Blocks</option>
              {BLOCKS.map((b) => (
                <option value={b.slug}>{b.name}</option>
              ))}
            </select>
          </div>

          <!-- Submit Action -->
          <button type="submit" class="btn btn--primary btn--full finder-card__submit">
            Search Available Plots →
          </button>
        </form>

        <div class="finder-card__footer">
          <span>Need custom assistance?</span>
          <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer">Ask Advisor on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 2: PROJECT OVERVIEW & AUTHORITY METRICS
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--overview" id="overview">
    <div class="container">
      <!-- Section Header -->
      <div class="section-header text-center">
        <span class="eyebrow">Master Development Vision</span>
        <h2 class="section-header__title">Why Al Rehman Garden Phase 2?</h2>
        <p class="section-header__desc lead">
          Setting the benchmark for secure, modern, and affordable luxury real estate in Lahore with complete civic amenities and unmatched connectivity.
        </p>
      </div>

      <!-- Key Metrics Counters -->
      <div class="metrics-grid">
        <div class="metric-card">
          <span class="stat-number">15+</span>
          <span class="stat-label">Master-Planned Blocks</span>
          <p class="metric-card__desc">From executive sectors to luxury villa enclaves</p>
        </div>
        <div class="metric-card">
          <span class="stat-number">5,000+</span>
          <span class="stat-label">Residing Families</span>
          <p class="metric-card__desc">Vibrant on-ground community with thriving lifestyle</p>
        </div>
        <div class="metric-card">
          <span class="stat-number">150ft</span>
          <span class="stat-label">Main Entrance Boulevard</span>
          <p class="metric-card__desc">Signal-free wide network of carpeted roads</p>
        </div>
        <div class="metric-card">
          <span class="stat-number">100%</span>
          <span class="stat-label">Live Utilities</span>
          <p class="metric-card__desc">Underground electricity, Sui gas & pure RO water</p>
        </div>
      </div>

      <!-- Feature Grid -->
      <div class="overview-features">
        <div class="overview-feature">
          <div class="overview-feature__icon">🏛️</div>
          <h3 class="overview-feature__title">Approved & Clear Legal Title</h3>
          <p class="overview-feature__text">
            Peace of mind with LDA approval, prompt on-ground registries, and transparent society transfer procedures.
          </p>
        </div>
        <div class="overview-feature">
          <div class="overview-feature__icon">📍</div>
          <h3 class="overview-feature__title">Unrivaled Strategic Location</h3>
          <p class="overview-feature__text">
            Directly connected to Main Sharaqpur Road and M2 Motorway, offering instant connectivity to all Lahore centers.
          </p>
        </div>
        <div class="overview-feature">
          <div class="overview-feature__icon">📈</div>
          <h3 class="overview-feature__title">Exponential Capital Growth</h3>
          <p class="overview-feature__text">
            Consistently delivering high capital appreciation and strong rental yields due to rapid western Lahore expansion.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 3: STRATEGIC LOCATION & CONNECTIVITY
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt section--location" id="location">
    <div class="container">
      <div class="location-layout">
        <!-- Location Info -->
        <div class="location-info">
          <span class="eyebrow">Prime Lahore Location</span>
          <h2 class="location-info__title">Connected to Everything That Matters</h2>
          <p class="location-info__text lead">
            Situated on <strong>Main Sharaqpur Road</strong>, Al Rehman Garden Phase 2 provides frictionless travel to downtown Lahore, Thokar Niaz Baig, civil courts, and the international airport via the M-2 Motorway and Lahore Ring Road.
          </p>

          <div class="location-matrix">
            {travelConnectivity.map((item) => (
              <div class="location-matrix__item">
                <span class="location-matrix__icon">{item.icon}</span>
                <div class="location-matrix__details">
                  <div class="location-matrix__name-row">
                    <strong class="location-matrix__name">{item.name}</strong>
                    <span class="location-matrix__time">{item.time}</span>
                  </div>
                  <span class="location-matrix__note">{item.note}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="location-actions">
            <Button href="/map" variant="primary" size="md">
              Explore Interactive Society Map
            </Button>
            <a
              href="https://maps.google.com/?q=Al+Rehman+Garden+Phase+2+Lahore"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--outline btn--md"
            >
              Get Google Maps Directions ↗
            </a>
          </div>
        </div>

        <!-- Location Map Visual Showcase -->
        <div class="location-visual">
          <div class="location-card">
            <div class="location-card__map-preview">
              <div class="location-card__pin-badge">
                <span class="location-card__pin-icon">📍</span>
                <div>
                  <strong>Al Rehman Garden Phase 2</strong>
                  <span>Main Sharaqpur Road, Lahore</span>
                </div>
              </div>
              <div class="location-card__coordinates">
                31.5768° N, 74.2254° E • Near M2 Faizpur Interchange
              </div>
            </div>
            <div class="location-card__info-strip">
              <div class="location-card__stat">
                <span class="location-card__stat-val">2 Min</span>
                <span class="location-card__stat-lbl">M2 Motorway</span>
              </div>
              <div class="location-card__stat">
                <span class="location-card__stat-val">10 Min</span>
                <span class="location-card__stat-lbl">Mall Road</span>
              </div>
              <div class="location-card__stat">
                <span class="location-card__stat-val">5 Min</span>
                <span class="location-card__stat-lbl">Ring Road</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 4: MASTER-PLANNED BLOCKS SHOWCASE
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" id="blocks">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Society Masterplan</span>
          <h2 class="section-header__title">Explore Society Blocks & Sectors</h2>
          <p class="section-header__desc">
            Discover developed blocks with ready possession and high-potential sectors under fast-track development.
          </p>
        </div>
        <Button href="/blocks" variant="outline" size="sm">
          View All Blocks →
        </Button>
      </div>

      <!-- Blocks Grid -->
      <div class="blocks-grid">
        {BLOCKS.slice(0, 6).map((block) => (
          <BlockCard
            name={block.name}
            slug={block.slug}
            category={block.category}
            status={block.status}
            possessionPercentage={block.possessionPercentage}
            description={block.description}
            plotSizes={block.plotSizes}
            features={block.features}
            locationHighlight={block.locationHighlight}
          />
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 5: FEATURED PROPERTIES & PLOTS PREVIEW
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt" id="properties-preview">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Verified Inventory</span>
          <h2 class="section-header__title">Latest Available Plots for Sale</h2>
          <p class="section-header__desc">
            Hand-picked residential & commercial options with verified status and competitive market pricing.
          </p>
        </div>
        <Button href="/properties" variant="primary" size="sm">
          Browse All Properties →
        </Button>
      </div>

      <!-- Property Cards Grid -->
      <div class="properties-grid">
        {featuredProperties.map((prop) => (
          <PropertyCard
            title={prop.title}
            slug={prop.slug}
            propertyType={prop.propertyType}
            purpose={prop.purpose}
            price={prop.price}
            size={prop.size}
            sizeUnit={prop.unit}
            block={prop.block}
            verificationStatus={prop.verificationStatus}
            availabilityStatus={prop.availabilityStatus}
            lastVerifiedDate={prop.lastVerifiedDate}
            isFeatured={prop.isFeatured}
          />
        ))}
      </div>

      <!-- Bottom Category Shortcut Pills -->
      <div class="plot-categories-strip">
        <span class="plot-categories__label">Quick Browse by Plot Size:</span>
        <div class="plot-categories__pills">
          <a href="/plots?size=3-marla" class="plot-cat-pill">3 Marla Plots</a>
          <a href="/plots?size=5-marla" class="plot-cat-pill plot-cat-pill--featured">5 Marla Plots</a>
          <a href="/plots?size=8-marla" class="plot-cat-pill">8 Marla Plots</a>
          <a href="/plots?size=10-marla" class="plot-cat-pill">10 Marla Plots</a>
          <a href="/plots?size=1-kanal" class="plot-cat-pill">1 Kanal Plots</a>
          <a href="/properties?type=commercial" class="plot-cat-pill plot-cat-pill--comm">Commercial Plots</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 6: INVESTMENT OPPORTUNITY & HIGH ROI
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--dark section--investment" id="investment">
    <div class="container">
      <div class="investment-grid">
        <div class="investment-content">
          <span class="eyebrow eyebrow--dark">High-ROI Real Estate</span>
          <h2 class="investment-title">Why Smart Investors Choose Al Rehman Garden Phase 2</h2>
          <p class="investment-lead lead">
            Lahore's urban growth is expanding aggressively toward the Western M2 corridor. Al Rehman Garden Phase 2 stands out as the highest-yielding asset class with guaranteed infrastructure, LDA compliance, and rapid population density.
          </p>

          <div class="investment-points">
            <div class="investment-point">
              <span class="investment-point__badge">01</span>
              <div>
                <h3 class="investment-point__title">High Capital Appreciation</h3>
                <p class="investment-point__desc">Historical values have appreciated over 35-45% across developed sectors over the last 36 months.</p>
              </div>
            </div>
            <div class="investment-point">
              <span class="investment-point__badge">02</span>
              <div>
                <h3 class="investment-point__title">Instant Rental Returns</h3>
                <p class="investment-point__desc">Ready-to-build possession lets you construct rental homes or commercial retail plazas immediately.</p>
              </div>
            </div>
            <div class="investment-point">
              <span class="investment-point__badge">03</span>
              <div>
                <h3 class="investment-point__title">Safe & Clear Registration</h3>
                <p class="investment-point__desc">Clear title allotment without litigation risks or delayed infrastructure promises.</p>
              </div>
            </div>
          </div>

          <div class="investment-cta">
            <Button href="/prices" variant="primary" size="md">
              View Plot Price Rate Lists
            </Button>
            <a
              href={CONTACTS.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--glass btn--md"
            >
              Get Investor Consultation ↗
            </a>
          </div>
        </div>

        <div class="investment-stat-box">
          <div class="stat-highlight-card">
            <div class="stat-highlight-card__badge">ARG Phase 2 ROI Index</div>
            <div class="stat-highlight-card__big-stat">+40%</div>
            <div class="stat-highlight-card__sub">Average 3-Year Capital Gain</div>
            <hr class="stat-highlight-card__hr" />
            <ul class="stat-highlight-card__list">
              <li><span>Plot Possession:</span> <strong>Immediate on Cash</strong></li>
              <li><span>Installment Duration:</span> <strong>3 to 5 Years</strong></li>
              <li><span>Commercial Returns:</span> <strong>8 - 12% Annual Yield</strong></li>
              <li><span>Transfer Office:</span> <strong>On-Site Verified</strong></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 7: WORLD-CLASS AMENITIES & INFRASTRUCTURE
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" id="amenities">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">Lifestyle & Infrastructure</span>
        <h2 class="section-header__title">Complete Modern Living Infrastructure</h2>
        <p class="section-header__desc lead">
          Everything your family needs for an upscale, secure, and serene living experience inside society gates.
        </p>
      </div>

      <div class="amenities-grid">
        {AMENITIES.map((item) => (
          <div class="amenity-card">
            <div class="amenity-card__icon-wrap">
              <span class="amenity-card__icon">{item.icon}</span>
            </div>
            <h3 class="amenity-card__title">{item.name}</h3>
            <span class="amenity-card__highlight">{item.highlight}</span>
            <p class="amenity-card__desc">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 8: PAYMENT PLANS & PRICING PREVIEW
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt" id="payment-plans">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">Transparent Pricing</span>
        <h2 class="section-header__title">Flexible Payment Plans & Plot Rates</h2>
        <p class="section-header__desc lead">
          Clear, upfront pricing with easy installment options tailored for homeowners and real estate investors.
        </p>
      </div>

      <div class="pricing-preview-grid">
        <!-- Plan 1: 3 Marla Residential -->
        <div class="plan-card">
          <div class="plan-card__header">
            <span class="plan-card__tag">Budget Starter</span>
            <h3 class="plan-card__size">3 Marla Plot</h3>
            <span class="plan-card__type">Residential Plot</span>
          </div>
          <div class="plan-card__price">
            <span class="plan-card__from">Starting From</span>
            <div class="price price-md">PKR 24 - 30 Lakh</div>
          </div>
          <ul class="plan-card__features">
            <li>✓ Ideal for small families</li>
            <li>✓ Possession ready in Block B, D, E</li>
            <li>✓ Underground electricity & gas</li>
            <li>✓ High rental demand zone</li>
          </ul>
          <div class="plan-card__action">
            <Button href="/prices" variant="secondary" size="sm" fullWidth>
              View Detailed Rates
            </Button>
          </div>
        </div>

        <!-- Plan 2: 5 Marla (Featured) -->
        <div class="plan-card plan-card--featured">
          <div class="plan-card__ribbon">Most Popular</div>
          <div class="plan-card__header">
            <span class="plan-card__tag">Prime Choice</span>
            <h3 class="plan-card__size">5 Marla Plot</h3>
            <span class="plan-card__type">Residential Plot</span>
          </div>
          <div class="plan-card__price">
            <span class="plan-card__from">Starting From</span>
            <div class="price price-lg text-gradient-gold">PKR 40 - 55 Lakh</div>
          </div>
          <ul class="plan-card__features">
            <li>✓ Standard luxury family house size</li>
            <li>✓ Available in Block A, B, C, D, Mirabel</li>
            <li>✓ Installment options available</li>
            <li>✓ Immediate construction approved</li>
          </ul>
          <div class="plan-card__action">
            <Button href="/prices" variant="primary" size="md" fullWidth>
              Get Payment Plan Details
            </Button>
          </div>
        </div>

        <!-- Plan 3: 10 Marla / 1 Kanal -->
        <div class="plan-card">
          <div class="plan-card__header">
            <span class="plan-card__tag">Executive Luxury</span>
            <h3 class="plan-card__size">10 Marla & 1 Kanal</h3>
            <span class="plan-card__type">Executive Villa Plots</span>
          </div>
          <div class="plan-card__price">
            <span class="plan-card__from">Starting From</span>
            <div class="price price-md">PKR 75 Lakh - 1.8 Cr</div>
          </div>
          <ul class="plan-card__features">
