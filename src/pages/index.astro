---
/**
 * Homepage — Al Rehman Garden Phase 2 Lahore
 * Premium Real Estate Authority Website Landing Page
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import Button from '@components/global/Button.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import BlockCard from '@components/blocks/BlockCard.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import { BLOCKS } from '@data/blocks';
import { AMENITIES } from '@data/amenities';
import { DEVELOPMENT_UPDATES } from '@data/developmentUpdates';

import propertiesData from '@data/properties-import.json';

const websiteSchema = {
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/properties?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

// Pull live verified featured listings from imported database
const featuredProperties = propertiesData.slice(0, 6);

// Connectivity Locations Matrix
const travelConnectivity = [
  { name: 'Lahore Ring Road (Phase 6 Interchange)', time: '2 Minutes', icon: '🛣️', note: 'Direct signal-free exit' },
  { name: 'Allama Iqbal International Airport', time: '10 Minutes', icon: '✈️', note: 'Fast expressway link' },
  { name: 'Defence Raya Golf & Country Club', time: '2 Minutes', icon: '⛳', note: 'Integrated in Phase 6' },
  { name: 'PKLI Medical Complex', time: '2 Minutes', icon: '🏥', note: 'Adjacent via Bedian Link' },
  { name: 'Gulberg Main Boulevard & MM Alam', time: '15 Minutes', icon: '🚗', note: 'Via Ring Road corridor' },
  { name: 'Lahore Cantt & Mall Road', time: '12 Minutes', icon: '🏛️', note: 'Direct arterial connection' },
];

// FAQs
const faqs = [
  {
    q: 'Is DHA Phase 6 Lahore fully developed and possession-ready?',
    a: 'Yes, DHA Phase 6 Lahore is 100% on-ground and fully developed across Sectors A to N, featuring high residential occupancy, designer luxury bungalows, underground electrification, Sui gas, and 24/7 DHA vigilance.',
  },
  {
    q: 'Where is DHA Phase 6 located in Lahore?',
    a: 'DHA Phase 6 is strategically located along Main Boulevard Phase 6, bounded by Bedian Road, Barki Road, and the Lahore Ring Road with direct interchange access, just 10 minutes from Allama Iqbal International Airport.',
  },
  {
    q: 'What plot categories are available in DHA Phase 6?',
    a: 'DHA Phase 6 features residential plots in 5 Marla, 10 Marla, 1 Kanal, and 2 Kanal, as well as 4 Marla and 8 Marla commercial plots in CCA-1, CCA-2, and Main Boulevard commercial broadways.',
  },
  {
    q: 'What makes Defence Raya in Phase 6 unique?',
    a: 'Defence Raya is an international 18-hole championship golf resort and gated luxury residential community with 1 & 2 Kanal fairway villas, golf-facing condominiums, and exclusive country club amenities.',
  },
  {
    q: 'How are property transfers and NDC handled in DHA Phase 6?',
    a: 'All property transfers, No Demand Certificates (NDC), and title verifications are officially executed directly through the DHA Lahore Main Office for absolute legal security.',
  },
];
---

<PageLayout
  title="DHA Phase 6 Lahore — Luxury Real Estate & Property Authority Portal"
  description="Explore DHA Phase 6 Lahore plots for sale, designer luxury houses, commercial broadways in CCA-1 & CCA-2, Defence Raya Golf Resort, and audited 2026 rates."
>
  <Schema type="WebSite" data={websiteSchema} />

  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 1: HERO & PROPERTY QUICK FINDER
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="container hero__container">
      <div class="hero__content">
        <!-- Eyebrow Tag -->
        <div class="eyebrow eyebrow--dark">
          <span class="hero__pulse-dot"></span>
          <span>DHA Phase 6 Specialist & Information Portal</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero__title">
          Explore DHA Phase 6 <br />
          <span class="text-gradient-gold">Lahore Luxury Properties</span>
        </h1>

        <!-- Value Proposition -->
        <p class="hero__lead lead">
          Explore verified properties, sectors (A to N), price index, master maps, and investment intelligence for Lahore's premier luxury community on <strong>Main Boulevard</strong>, featuring <strong>Defence Raya Golf Resort</strong> and direct Ring Road access.
        </p>

        <!-- CTA Buttons -->
        <div class="hero__actions">
          <Button href="#properties-preview" variant="primary" size="lg">
            Explore Plots & Properties
          </Button>
          <Button href="/map" variant="outline" size="lg">View Master Plan</Button>
          <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--lg">WhatsApp Advisory</a>
        </div>

        <!-- Quick Society Highlights Badges -->
        <div class="hero__highlights">
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">🏛️</span>
            <span>LDA Approved</span>
          </div>
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">⚡</span>
            <span>Underground Grid</span>
          </div>
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">🔑</span>
            <span>Ready Possession</span>
          </div>
          <div class="hero__highlight-pill">
            <span class="hero__highlight-icon">🛡️</span>
            <span>24/7 Gated Security</span>
          </div>
        </div>
      </div>

      <!-- Quick Property Finder Card -->
      <div class="hero__finder-card">
        <div class="finder-card__header">
          <h2 class="finder-card__title">Find Plots & Properties</h2>
          <p class="finder-card__subtitle">Instant search across all Phase 2 sectors</p>
        </div>

        <form class="finder-card__form" action="/properties" method="get">
          <!-- Property Purpose -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-purpose">Purpose</label>
            <select id="hero-purpose" name="purpose" class="finder-card__select">
              <option value="sale" selected>For Sale (Buy Plot / House)</option>
              <option value="rent">For Rent</option>
              <option value="lease">Commercial Lease</option>
            </select>
          </div>

          <!-- Property Type -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-type">Property Category</label>
            <select id="hero-type" name="type" class="finder-card__select">
              <option value="">All Categories</option>
              <option value="residential" selected>Residential Plots</option>
              <option value="commercial">Commercial Plots</option>
              <option value="luxury-villas">Villas & Houses</option>
            </select>
          </div>

          <!-- Plot Size -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-size">Plot Size</label>
            <select id="hero-size" name="size" class="finder-card__select">
              <option value="">Any Size</option>
              <option value="3-marla">3 Marla</option>
              <option value="5-marla" selected>5 Marla (Most Popular)</option>
              <option value="7-marla">7 Marla</option>
              <option value="10-marla">10 Marla</option>
              <option value="1-kanal">1 Kanal</option>
            </select>
          </div>

          <!-- Block -->
          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-block">Block / Sector</label>
            <select id="hero-block" name="block" class="finder-card__select">
              <option value="">All Society Blocks</option>
              {BLOCKS.map((b) => (
                <option value={b.slug}>{b.name}</option>
              ))}
            </select>
          </div>

          <div class="finder-card__group">
            <label class="finder-card__label" for="hero-price">Price Range</label>
            <select id="hero-price" name="price" class="finder-card__select">
              <option value="">Any Budget</option>
              <option value="under-30-lakh">Under PKR 30 Lakh</option>
              <option value="30-60-lakh">PKR 30 - 60 Lakh</option>
              <option value="60-lakh-1-crore">PKR 60 Lakh - 1 Crore</option>
              <option value="over-1-crore">Over PKR 1 Crore</option>
            </select>
          </div>

          <!-- Submit Action -->
          <button type="submit" class="btn btn--primary btn--full finder-card__submit">
            Search Property →
          </button>
        </form>

        <div class="finder-card__footer">
          <span>Need custom assistance?</span>
          <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer">Ask Advisor on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       DHA-STYLE SOCIETY QUICK FACTS & AUTHORITY DIRECTORY STRIP
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="trust-strip" aria-label="Portal trust indicators">
    <div class="container trust-strip__intro"><span class="eyebrow eyebrow--dark">Independent buyer guidance</span><strong>Why Use This Platform</strong></div>
    <div class="container trust-strip__grid">
      <div class="trust-strip__item"><span class="trust-strip__icon">✓</span><div><strong>Verified listings</strong><span>Reviewed property information</span></div></div>
      <div class="trust-strip__item"><span class="trust-strip__icon">↻</span><div><strong>Updated information</strong><span>Current prices and availability</span></div></div>
      <div class="trust-strip__item"><span class="trust-strip__icon">⌂</span><div><strong>Complete society guide</strong><span>Maps, blocks, places, and plans</span></div></div>
      <div class="trust-strip__item"><span class="trust-strip__icon">↗</span><div><strong>Property assistance</strong><span>Direct guidance for your visit</span></div></div>
    </div>
  </section>

  <section class="section section--quick-facts" hidden>
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-8);">
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(212,175,55,0.3); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); text-align: center;">
          <span style="font-size: 11px; color: #94A3B8; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px;">Established</span>
          <strong style="font-size: var(--text-lg); color: #F3D375;">2012+</strong>
          <span style="display: block; font-size: 11px; color: #CBD5E1; margin-top: 2px;">Over 14 Years of Trust</span>
        </div>
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(212,175,55,0.3); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); text-align: center;">
          <span style="font-size: 11px; color: #94A3B8; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px;">Masterplan Area</span>
          <strong style="font-size: var(--text-lg); color: #F3D375;">3,000+ Kanals</strong>
          <span style="display: block; font-size: 11px; color: #CBD5E1; margin-top: 2px;">Fully Demarcated Land</span>
        </div>
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(212,175,55,0.3); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); text-align: center;">
          <span style="font-size: 11px; color: #94A3B8; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px;">Sectors / Blocks</span>
          <strong style="font-size: var(--text-lg); color: #F3D375;">15+ Blocks</strong>
          <span style="display: block; font-size: 11px; color: #CBD5E1; margin-top: 2px;">Executive & Luxury Enclaves</span>
        </div>
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(212,175,55,0.3); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); text-align: center;">
          <span style="font-size: 11px; color: #94A3B8; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px;">Development</span>
          <strong style="font-size: var(--text-lg); color: #F3D375;">100% On-Ground</strong>
          <span style="display: block; font-size: 11px; color: #CBD5E1; margin-top: 2px;">Ready Possession Available</span>
        </div>
        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(212,175,55,0.3); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); text-align: center;">
          <span style="font-size: 11px; color: #94A3B8; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px;">Primary Location</span>
          <strong style="font-size: var(--text-lg); color: #F3D375;">Main Sharaqpur Rd</strong>
          <span style="display: block; font-size: 11px; color: #CBD5E1; margin-top: 2px;">2 Mins from M-2 Interchange</span>
        </div>
      </div>

      <!-- Quick Authority Hub Shortcuts -->
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2-5);">
        <a href="/property-prices" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">📊 2026 Price Index</a>
        <a href="/al-rehman-garden-phase-2-weather" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">⛅ Society Weather</a>
        <a href="/utilities" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">⚡ Utilities &amp; Grid</a>
        <a href="/places" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">📍 Places &amp; Schools</a>
        <a href="/development-updates" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">📈 Development Timeline</a>
        <a href="/gallery" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">🖼️ Society Gallery</a>
        <a href="/al-rehman-garden-phase-2-vs-dha-lahore" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">⚖️ Society Comparisons</a>
        <a href="/downloads" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">📥 Masterplan Downloads</a>
        <a href="/faq" class="btn btn--outline btn--sm" style="border-color: rgba(212,175,55,0.4); color: #F3D375; font-size: 12px;">❓ FAQ Knowledgebase</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 2: PROJECT OVERVIEW & AUTHORITY METRICS
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--overview" id="overview">
    <div class="container">
      <!-- Section Header -->
      <div class="section-header text-center">
        <span class="eyebrow">Master Development Vision</span>
        <h2 class="section-header__title">Why DHA Phase 6 Lahore?</h2>
        <p class="section-header__desc lead">
          The ultimate benchmark for luxury real estate in Pakistan with 18-hole championship golf living, commercial broadways, and unmatched Ring Road connectivity.
        </p>
      </div>

      <!-- Key Metrics Counters -->
      <div class="metrics-grid">
        <div class="metric-card">
          <span class="stat-number">13+</span>
          <span class="stat-label">Master-Planned Sectors</span>
          <p class="metric-card__desc">Sectors A through N plus Defence Raya Golf Resort</p>
        </div>
        <div class="metric-card">
          <span class="stat-number">18-Hole</span>
          <span class="stat-label">Championship Golf Course</span>
          <p class="metric-card__desc">Defence Raya international golf & country club</p>
        </div>
        <div class="metric-card">
          <span class="stat-number">150ft</span>
          <span class="stat-label">Main Boulevard Broadway</span>
          <p class="metric-card__desc">Signal-free wide network of landscaped avenues</p>
        </div>
        <div class="metric-card">
          <span class="stat-number">100%</span>
          <span class="stat-label">Underground Utilities</span>
          <p class="metric-card__desc">Concealed power grid, Sui gas & optical fiber</p>
        </div>
      </div>

      <!-- Feature Grid -->
      <div class="overview-features">
        <div class="overview-feature">
          <div class="overview-feature__icon">🏛️</div>
          <h3 class="overview-feature__title">Guaranteed Title & DHA Security</h3>
          <p class="overview-feature__text">
            Complete investment safety with transparent DHA Lahore transfer procedures, prompt NDC issuance, and verified ownership.
          </p>
        </div>
        <div class="overview-feature">
          <div class="overview-feature__icon">📍</div>
          <h3 class="overview-feature__title">Unrivaled Strategic Location</h3>
          <p class="overview-feature__text">
            Directly linked to Lahore Ring Road (Phase 6 Interchange), Bedian Road, and Barki Road — 10 minutes from the airport.
          </p>
        </div>
        <div class="overview-feature">
          <div class="overview-feature__icon">📈</div>
          <h3 class="overview-feature__title">Blue-Chip Capital Value</h3>
          <p class="overview-feature__text">
            Consistently leading Lahore’s elite luxury property market with top capital appreciation and lucrative commercial rental yields.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 3: STRATEGIC LOCATION & CONNECTIVITY
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt section--location" id="location">
    <div class="container">
      <div class="location-layout">
        <!-- Location Info -->
        <div class="location-info">
          <span class="eyebrow">Prime Lahore Location</span>
          <h2 class="location-info__title">Connected to Everything That Matters</h2>
          <p class="location-info__text lead">
            Situated on <strong>Main Boulevard</strong>, DHA Phase 6 provides frictionless travel to downtown Lahore, Allama Iqbal Airport, PKLI, and Gulberg via the Lahore Ring Road.
          </p>

          <div class="location-matrix">
            {travelConnectivity.map((item) => (
              <div class="location-matrix__item">
                <span class="location-matrix__icon">{item.icon}</span>
                <div class="location-matrix__details">
                  <div class="location-matrix__name-row">
                    <strong class="location-matrix__name">{item.name}</strong>
                    <span class="location-matrix__time">{item.time}</span>
                  </div>
                  <span class="location-matrix__note">{item.note}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="location-actions">
            <Button href="/map" variant="primary" size="md">
              Explore Interactive Sector Map
            </Button>
            <a
              href="https://maps.google.com/?q=DHA+Phase+6+Lahore"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--outline btn--md"
            >
              Get Google Maps Directions ↗
            </a>
          </div>
        </div>

        <!-- Location Map Visual Showcase -->
        <div class="location-visual">
          <div class="location-card">
            <div class="location-card__map-preview">
              <div class="location-card__pin-badge">
                <span class="location-card__pin-icon">📍</span>
                <div>
                  <strong>DHA Phase 6 Lahore</strong>
                  <span>Main Boulevard, Phase 6, DHA Lahore</span>
                </div>
              </div>
              <div class="location-card__coordinates">
                31.4682° N, 74.4354° E • Near Ring Road Interchange
              </div>
            </div>
            <div class="location-card__info-strip">
              <div class="location-card__stat">
                <span class="location-card__stat-val">2 Min</span>
                <span class="location-card__stat-lbl">Ring Road</span>
              </div>
              <div class="location-card__stat">
                <span class="location-card__stat-val">10 Min</span>
                <span class="location-card__stat-lbl">Airport</span>
              </div>
              <div class="location-card__stat">
                <span class="location-card__stat-val">2 Min</span>
                <span class="location-card__stat-lbl">Defence Raya</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 4: MASTER-PLANNED BLOCKS SHOWCASE
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section" id="blocks">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Society Masterplan</span>
          <h2 class="section-header__title">Explore Society Blocks & Sectors</h2>
          <p class="section-header__desc">
            Discover developed blocks with ready possession and high-potential sectors under fast-track development.
          </p>
        </div>
        <Button href="/blocks" variant="outline" size="sm">
          View All Blocks →
        </Button>
      </div>

      <!-- Blocks Grid -->
      <div class="blocks-grid">
        {BLOCKS.slice(0, 6).map((block) => (
          <BlockCard
            name={block.name}
            slug={block.slug}
            category={block.category}
            status={block.status}
            possessionPercentage={block.possessionPercentage}
            description={block.description}
            plotSizes={block.plotSizes}
            features={block.features}
            locationHighlight={block.locationHighlight}
          />
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 5: FEATURED PROPERTIES & PLOTS PREVIEW
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--alt" id="properties-preview">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">Verified Inventory</span>
          <h2 class="section-header__title">Latest Available Plots for Sale</h2>
          <p class="section-header__desc">
            Hand-picked residential & commercial options with verified status and competitive market pricing.
          </p>
        </div>
        <Button href="/properties" variant="primary" size="sm">
          Browse All Properties →
        </Button>
      </div>

      <!-- Property Cards Grid -->
      <div class="properties-grid">
        {featuredProperties.map((prop, index) => (
          <PropertyCard
            title={prop.title}
            slug={prop.slug}
            propertyType={prop.propertyType}
            purpose={prop.purpose}
            price={prop.price}
            size={prop.size}
            sizeUnit={prop.unit}
            block={prop.block}
            image={prop.images && prop.images.length > 0 ? prop.images[0] : undefined}
            verificationStatus={prop.verificationStatus}
            availabilityStatus={prop.availabilityStatus}
            lastVerifiedDate={prop.lastVerifiedDate}
            isFeatured={index === 0 || prop.isFeatured}
          />
        ))}
      </div>

      <!-- Bottom Category Shortcut Pills -->
      <div class="plot-categories-strip">
        <span class="plot-categories__label">Quick Browse by Plot Size:</span>
        <div class="plot-categories__pills">
          <a href="/plots?size=3-marla" class="plot-cat-pill">3 Marla Plots</a>
          <a href="/plots?size=5-marla" class="plot-cat-pill plot-cat-pill--featured">5 Marla Plots</a>
          <a href="/plots?size=8-marla" class="plot-cat-pill">8 Marla Plots</a>
          <a href="/plots?size=10-marla" class="plot-cat-pill">10 Marla Plots</a>
          <a href="/plots?size=1-kanal" class="plot-cat-pill">1 Kanal Plots</a>
          <a href="/properties?type=commercial" class="plot-cat-pill plot-cat-pill--comm">Commercial Plots</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════════
       SECTION 6: INVESTMENT OPPORTUNITY & HIGH ROI
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="section section--dark section--investment" id="investment">
    <div class="container">
      <div class="investment-grid">
        <div class="investment-content">
          <span class="eyebrow eyebrow--dark">High-Yield Real Estate</span>
          <h2 class="investment-title">Why Smart Investors Choose DHA Phase 6 Lahore</h2>
          <p class="investment-lead lead">
