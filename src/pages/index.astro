    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--color-neutral-400);
  }

  .finder-card__footer a {
    color: #34D399;
    font-weight: var(--font-bold);
    text-decoration: underline;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     GENERAL SECTIONS & HEADERS
     ══════════════════════════════════════════════════════════════════════════ */
  .section {
    padding: var(--space-20) 0;
  }

  .section--alt {
    background-color: var(--bg-secondary);
  }

  .section--dark {
    background-color: var(--color-secondary-950);
    color: var(--text-inverse);
  }

  .container--narrow {
    max-width: 860px;
  }

  .section-header {
    margin-bottom: var(--space-12);
  }

  .text-center {
    text-align: center;
  }

  .section-header__title {
    margin: var(--space-2) 0 var(--space-3);
  }

  .section-header__desc {
    max-width: 65ch;
    margin: 0 auto;
    color: var(--text-secondary);
  }

  .section-header-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .section-header-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 2: METRICS COUNTERS & OVERVIEW
     ══════════════════════════════════════════════════════════════════════════ */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-16);
  }

  @media (min-width: 1024px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    text-align: center;
    transition: all var(--transition-base);
  }

  .metric-card:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary-400);
    transform: translateY(-3px);
  }

  .metric-card__desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: var(--space-2) 0 0;
  }

  .overview-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .overview-features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .overview-feature {
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    transition: all var(--transition-base);
  }

  .overview-feature:hover {
    background: var(--bg-primary);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-300);
  }

  .overview-feature__icon {
    font-size: 36px;
    margin-bottom: var(--space-4);
  }

  .overview-feature__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .overview-feature__text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 3: LOCATION & CONNECTIVITY
     ══════════════════════════════════════════════════════════════════════════ */
  .location-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .location-layout {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-12);
    }
  }

  .location-info__title {
    margin: var(--space-2) 0 var(--space-4);
  }

  .location-info__text {
    margin-bottom: var(--space-6);
  }

  .location-matrix {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .location-matrix {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .location-matrix__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--bg-primary);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
  }

  .location-matrix__icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .location-matrix__details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .location-matrix__name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .location-matrix__name {
    font-size: var(--text-xs);
    color: var(--text-primary);
  }

  .location-matrix__time {
    font-size: 11px;
    font-weight: var(--font-extrabold);
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
  }

  .location-matrix__note {
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .location-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Location Card Visual */
  .location-card {
    background: var(--color-secondary-900);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: var(--shadow-xl);
  }

  .location-card__map-preview {
    aspect-ratio: 16 / 11;
    background: linear-gradient(135deg, #182F63 0%, #0A1128 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    text-align: center;
    position: relative;
  }

  .location-card__pin-badge {
    background: rgba(10, 17, 40, 0.9);
    border: 1.5px solid #D4AF37;
    border-radius: var(--radius-xl);
    padding: var(--space-3) var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: white;
    margin-bottom: var(--space-3);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .location-card__pin-icon {
    font-size: 24px;
  }

  .location-card__pin-badge strong {
    display: block;
    font-size: var(--text-sm);
    color: #FFFFFF;
  }

  .location-card__pin-badge span {
    font-size: var(--text-xs);
    color: #F3D375;
  }

  .location-card__coordinates {
    font-size: var(--text-xs);
    color: var(--color-neutral-400);
    font-family: var(--font-mono);
  }

  .location-card__info-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: #060B1C;
    padding: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .location-card__stat-val {
    display: block;
    font-size: var(--text-lg);
    font-weight: var(--font-extrabold);
    color: #D4AF37;
  }

  .location-card__stat-lbl {
    font-size: 11px;
    color: var(--color-neutral-400);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 4: BLOCKS & PROPERTIES GRIDS
     ══════════════════════════════════════════════════════════════════════════ */
  .blocks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .blocks-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .blocks-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .properties-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 640px) {
    .properties-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .properties-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Plot Categories Strip */
  .plot-categories-strip {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .plot-categories-strip {
      flex-direction: row;
    }
  }

  .plot-categories__label {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
  }

  .plot-categories__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .plot-cat-pill {
    padding: var(--space-1-5) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    background-color: var(--color-neutral-100);
    color: var(--color-secondary-900);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .plot-cat-pill:hover {
    background-color: var(--color-primary-500);
    color: white;
    transform: translateY(-1px);
  }

  .plot-cat-pill--featured {
    background-color: var(--color-primary-50);
    color: var(--color-primary-800);
    border: 1px solid var(--border-gold);
  }

  .plot-cat-pill--comm {
    background-color: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 6: INVESTMENT SECTION
     ══════════════════════════════════════════════════════════════════════════ */
  .section--investment {
    background: radial-gradient(circle at 20% 30%, #182F63 0%, #0A1128 75%);
    border-top: 1px solid rgba(212, 175, 55, 0.2);
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .investment-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .investment-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-12);
    }
  }

  .investment-title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-4);
  }

  .investment-lead {
    color: var(--color-neutral-300);
    margin-bottom: var(--space-8);
  }

  .investment-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .investment-point {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .investment-point__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: rgba(212, 175, 55, 0.15);
    color: #F3D375;
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    flex-shrink: 0;
    border: 1px solid rgba(212, 175, 55, 0.4);
  }

  .investment-point__title {
    font-size: var(--text-base);
    color: #FFFFFF;
    margin: 0 0 2px;
  }

  .investment-point__desc {
    font-size: var(--text-xs);
    color: var(--color-neutral-400);
    margin: 0;
  }

  .investment-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Stat Box */
  .stat-highlight-card {
    background: rgba(16, 31, 68, 0.9);
    backdrop-filter: blur(14px);
    border: 1.5px solid rgba(212, 175, 55, 0.45);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    text-align: center;
  }

  .stat-highlight-card__badge {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--font-bold);
    color: #F3D375;
    background: rgba(212, 175, 55, 0.12);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    letter-spacing: 0.5px;
    margin-bottom: var(--space-3);
  }

  .stat-highlight-card__big-stat {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: var(--font-black);
    color: #E5C158;
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  .stat-highlight-card__sub {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: #FFFFFF;
  }

  .stat-highlight-card__hr {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: var(--space-6) 0;
  }

  .stat-highlight-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-align: left;
    font-size: var(--text-xs);
  }

  .stat-highlight-card__list li {
    display: flex;
    justify-content: space-between;
    color: var(--color-neutral-300);
  }

  .stat-highlight-card__list strong {
    color: #F3D375;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 7: AMENITIES GRID
     ══════════════════════════════════════════════════════════════════════════ */
  .amenities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .amenities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .amenities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .amenity-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    transition: all var(--transition-base);
  }

  .amenity-card:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary-400);
    transform: translateY(-3px);
  }

  .amenity-card__icon-wrap {
    width: 50px;
    height: 50px;
    background: var(--color-primary-50);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .amenity-card__icon {
    font-size: 24px;
  }

  .amenity-card__title {
    font-size: var(--text-base);
    margin: 0 0 var(--space-1);
  }

  .amenity-card__highlight {
    display: block;
    font-size: 11px;
    font-weight: var(--font-bold);
    color: var(--color-primary-700);
    margin-bottom: var(--space-2);
  }

  .amenity-card__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-normal);
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 8: PAYMENT PLANS & PRICING
     ══════════════════════════════════════════════════════════════════════════ */
  .pricing-preview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .pricing-preview-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .plan-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all var(--transition-base);
  }

  .plan-card:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary-400);
    transform: translateY(-4px);
  }

  .plan-card--featured {
    border: 2px solid #D4AF37;
    background: linear-gradient(180deg, #FFFFFF 0%, #FCF9EE 100%);
    box-shadow: 0 12px 32px rgba(197, 155, 39, 0.2);
  }

  .plan-card__ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gradient-gold);
    color: var(--color-secondary-950);
    font-size: 11px;
    font-weight: var(--font-extrabold);
    padding: 3px 14px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .plan-card__tag {
    display: inline-block;
    font-size: 10px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-primary-700);
    margin-bottom: 2px;
  }

  .plan-card__size {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    margin: 0;
  }

  .plan-card__type {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .plan-card__price {
    margin: var(--space-6) 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .plan-card__from {
    display: block;
    font-size: 10px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
  }

  .plan-card__features {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .plan-card__action {
    margin-top: auto;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 9: FAQ ACCORDION
     ══════════════════════════════════════════════════════════════════════════ */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-primary-400);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-toggle-icon {
    font-size: 20px;
    font-weight: 300;
    color: var(--color-primary-600);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .faq-answer p {
    margin: 0;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SECTION 10: LEAD GENERATION CTA
     ══════════════════════════════════════════════════════════════════════════ */
  .cta-section {
    padding: var(--space-16) 0 var(--space-20);
  }

  .cta-banner {
    background: linear-gradient(135deg, #142147 0%, #0A1128 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-3xl);
    padding: var(--space-10);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
    box-shadow: var(--shadow-2xl);
  }

  @media (min-width: 1024px) {
    .cta-banner {
      grid-template-columns: 1.2fr 0.8fr;
      padding: var(--space-12);
    }
  }

  .cta-banner__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-4);
  }

  .cta-banner__text {
    color: var(--color-neutral-300);
    margin-bottom: var(--space-8);
  }

  .cta-banner__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .cta-contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cta-contact-icon {
    font-size: 24px;
  }

  .cta-contact-label {
    display: block;
    font-size: 10px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #F3D375;
  }

  .cta-contact-val {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: #FFFFFF;
    text-decoration: none;
  }

  /* Box */
  .cta-banner__box {
    background: rgba(10, 17, 40, 0.95);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    text-align: center;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
  }

