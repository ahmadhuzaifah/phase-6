  <!-- Client-side Interactive Script -->
  <script is:inline>
    // 1. WhatsApp Dynamic Message
    const agentWhatsapp = document.querySelector('[data-agent-whatsapp]');
    const updateWhatsappLink = () => {
      if (!agentWhatsapp) return;
      const phone = agentWhatsapp.dataset.whatsappPhone;
      const message = agentWhatsapp.dataset.whatsappMessage;
      if (!phone || !message) return;
      const fullMessage = `${message}\n\nSource: ${window.location.href}`;
      agentWhatsapp.href = `https://wa.me/${phone}?text=${encodeURIComponent(fullMessage)}`;
    };
    updateWhatsappLink();
    agentWhatsapp?.addEventListener('click', updateWhatsappLink);

    // 2. Agent Popup Display & Dismissal
    const popup = document.querySelector('#agentContactPopup');
    const popupClose = document.querySelector('#agentPopupClose');
    const dismissedKey = 'dha-agent-popup-dismissed';
    let isDismissed = false;
    try {
      isDismissed = sessionStorage.getItem(dismissedKey) === 'true';
    } catch {
      isDismissed = false;
    }

    if (popup && !isDismissed) {
      window.setTimeout(() => {
        popup.hidden = false;
        window.requestAnimationFrame(() => popup.classList.add('visible'));
      }, 2200);
    }

    popupClose?.addEventListener('click', () => {
      if (popup) {
        popup.classList.remove('visible');
        window.setTimeout(() => { popup.hidden = true; }, 250);
        try { sessionStorage.setItem(dismissedKey, 'true'); } catch {}
      }
    });

    // 3. Navbar Scrolled State & Back to Top
    const navbar = document.querySelector('#navbar');
    const backToTop = document.querySelector('#backToTop');
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      if (navbar) {
        if (scrollY > 50) navbar.classList.add('scrolled');
        else navbar.classList.remove('scrolled');
      }
      if (backToTop) {
        if (scrollY > 400) backToTop.classList.add('visible');
        else backToTop.classList.remove('visible');
      }
    }, { passive: true });

    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // 4. Mobile Menu Toggle
    const navToggle = document.querySelector('#navToggle');
    const navLinks = document.querySelector('#navLinks');
    navToggle?.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', String(!isExpanded));
      navToggle.classList.toggle('active');
      navLinks?.classList.toggle('active');
    });

    // Close mobile menu on click link
    navLinks?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navToggle?.setAttribute('aria-expanded', 'false');
        navToggle?.classList.remove('active');
        navLinks?.classList.remove('active');
      });
    });

    // 5. Price Tabs Switcher
    const priceTabs = document.querySelectorAll('.price-tab');
    const pricePanels = document.querySelectorAll('.price-panel');

    const triggerBarAnimation = (panel) => {
      const bars = panel.querySelectorAll('.price-bar-fill');
      bars.forEach(bar => {
        const targetWidth = bar.getAttribute('data-width') || '50';
        bar.style.width = '0%';
        setTimeout(() => {
          bar.style.width = targetWidth + '%';
        }, 100);
      });
    };

    priceTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        priceTabs.forEach(t => t.classList.remove('active'));
        pricePanels.forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        const targetPanel = document.getElementById(tab.getAttribute('data-tab'));
        if (targetPanel) {
          targetPanel.classList.add('active');
          triggerBarAnimation(targetPanel);
        }
      });
    });

    // Initial price bar animation for active panel
    const initialActivePanel = document.querySelector('.price-panel.active');
    if (initialActivePanel) {
      setTimeout(() => triggerBarAnimation(initialActivePanel), 500);
    }

    // 6. Hero Stats Counter Animation
    const stats = document.querySelectorAll('.hero-stat-value');
    let hasAnimatedStats = false;
    const animateStats = () => {
      if (hasAnimatedStats) return;
      hasAnimatedStats = true;
      stats.forEach(stat => {
        const target = parseInt(stat.getAttribute('data-count') || '0', 10);
        const duration = 1800;
        const start = 0;
        const startTime = performance.now();

        const updateCounter = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out expo
          const easeOut = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
          const currentVal = Math.floor(easeOut * (target - start) + start);
          stat.textContent = target > 1000 ? currentVal.toLocaleString() : currentVal.toString();
          if (progress < 1) {
            requestAnimationFrame(updateCounter);
          } else {
            stat.textContent = target.toLocaleString();
          }
        };
        requestAnimationFrame(updateCounter);
      });
    };

    // 7. Scroll Reveal Animation
    const revealElements = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          if (entry.target.closest('.hero')) {
            animateStats();
          }
        }
      });
    }, { threshold: 0.15 });

    revealElements.forEach(el => revealObserver.observe(el));
    // Trigger stats if hero is already in view
    setTimeout(animateStats, 300);

    // 8. Floating Particles in Hero
    const particlesContainer = document.getElementById('heroParticles');
    if (particlesContainer) {
      for (let i = 0; i < 28; i++) {
        const particle = document.createElement('div');
        particle.className = 'particle';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.animationDelay = (Math.random() * 8) + 's';
        particle.style.animationDuration = (8 + Math.random() * 12) + 's';
        particle.style.opacity = (0.2 + Math.random() * 0.6).toString();
        particlesContainer.appendChild(particle);
      }
    }
  </script>
</body>
</html>

