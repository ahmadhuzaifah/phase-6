---
import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import { BLOCKS } from '@data/blocks';
import { FAQS_DATA } from '@data/faqs';
import properties from '@data/properties-import.json';
import { SITE } from '@data/site';

const sectors = BLOCKS.filter((item) => item.slug.startsWith('sector-'));
const faqs = FAQS_DATA.flatMap((category) => category.questions).slice(0, 6);
const websiteSchema = {
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const faqSchema = {
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const priceRows = [
  ['1 Kanal residential plots', 'PKR 4.07 - 10.50 Cr', 'Public asking-price samples'],
  ['10 Marla houses', 'PKR 4.80 - 8.85 Cr', 'Public asking-price samples'],
  ['1 Kanal houses', 'PKR 7.25 - 23.50 Cr', 'Public asking-price samples'],
  ['8 Marla commercial plots', 'PKR 13.45 - 38.80 Cr', 'Public asking-price samples'],
];
const amenities = [
  ['Healthcare', 'DHA Lahore lists a Medical Centre in Phase 6 Sector E.'],
  ['Road network', 'Internal boulevards connect with approaches toward Bedian Road and Barki Road.'],
  ['Commercial areas', 'CCA destinations support retail, food, services and offices.'],
  ['Parks and mosques', 'Neighbourhood facilities are marked across the official phase plan.'],
  ['Utilities', 'Verify connection status, dues and availability for the exact property.'],
  ['Security', 'Confirm current access and security arrangements directly with DHA Lahore.'],
];
---

<PageLayout
  title="DHA Phase 6 Lahore | Properties, Prices, Map & Sector Guide"
  description="Independent DHA Phase 6 Lahore property portal with sector guides, current asking-price snapshots, houses and plots for sale, official map links, construction guidance and buyer verification resources."
  canonical={SITE.url}
  ogImage="/images/og/homepage-og.svg"
>
  <Schema type="WebSite" data={websiteSchema} />
  <Schema type="FAQPage" data={faqSchema} />

  <section class="hero">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Independent Lahore property intelligence</p>
        <h1>DHA Phase 6 Lahore, researched street by street.</h1>
        <p class="hero__lead">Explore sectors, compare public asking prices, open official map resources and follow a practical verification path before buying a plot, house or commercial property.</p>
        <div class="hero__actions">
          <a class="button button--gold" href="/properties">Browse market snapshots</a>
          <a class="button button--line" href="/dha-phase-6-lahore-map">Open map guide</a>
        </div>
        <p class="hero__notice">Independent portal. Not an official DHA Lahore website. Third-party listing photos are not copied or altered.</p>
      </div>
      <aside class="finder">
        <p>Property navigator</p>
        <h2>Start with the decision</h2>
        <div class="finder__links">
          <a href="/plots"><span>Residential land</span><strong>Explore plots</strong></a>
          <a href="/houses"><span>Ready and grey structure</span><strong>Explore houses</strong></a>
          <a href="/commercial"><span>CCA and boulevard context</span><strong>Explore commercial</strong></a>
          <a href="/verification-and-transfer"><span>Before token or payment</span><strong>Verification checklist</strong></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="signal-band" aria-label="Key information">
    <div class="container signal-band__grid">
      <div><small>Sectors mapped</small><strong>A-H and J-N</strong></div>
      <div><small>Primary map source</small><strong>DHA Lahore</strong></div>
      <div><small>Market data type</small><strong>Asking snapshots</strong></div>
      <div><small>Research checked</small><strong>2 Sep 2026</strong></div>
    </div>
  </section>

  <section class="section intro">
    <div class="container split">
      <div>
        <p class="eyebrow eyebrow--dark">DHA Phase 6 Lahore overview</p>
        <h2>A complete research base, without pretending advertisements are facts.</h2>
      </div>
      <div class="prose">
        <p>DHA Phase 6 is a large planned area in Lahore with residential sectors, commercial destinations and regional links toward Bedian Road and Barki Road. Exact value and suitability depend on the plot or building, not the phase name alone.</p>
        <p>This portal separates official map and process links from market advertising. Every external property snapshot links back to its public source and remains marked unverified until availability and documents are checked.</p>
        <a href="/about">How this website researches information</a>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="heading-row">
        <div><p class="eyebrow">Sector directory</p><h2>Read the phase by sector</h2></div>
        <a href="/sectors">View all sector guides</a>
      </div>
      <div class="sector-grid">
        {sectors.map((sector, index) => (
          <a href={`/sectors/${sector.slug}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{sector.name}</h3>
            <p>{sector.locationHighlight}</p>
            <strong>Open guide</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="heading-row heading-row--dark">
        <div><p class="eyebrow eyebrow--dark">Market watch</p><h2>Source-referenced property snapshots</h2></div>
        <a href="/properties">View all properties</a>
      </div>
      <div class="research-note"><strong>No copied listing photography.</strong><span>These records retain limited factual metadata and a direct source link. Availability, ownership and demand are not verified by this website.</span></div>
      <div class="property-grid">
        {properties.slice(0, 6).map((property) => (
          <PropertyCard
            title={property.title}
            slug={property.slug}
            propertyType={property.propertyType}
            purpose={property.purpose}
            price={property.price}
            priceUnit={property.priceUnit}
            size={property.size}
            sizeUnit={property.unit}
            block={property.block}
            location={property.location.address}
            image={property.images[0]}
            verificationStatus={property.verificationStatus}
            availabilityStatus={property.availabilityStatus}
            lastVerifiedDate={property.lastVerifiedDate}
            sourceName={property.source}
            sourceURL={property.sourceURL}
            isFeatured={property.isFeatured}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section prices">
    <div class="container split split--prices">
      <div>
        <p class="eyebrow eyebrow--dark">September 2026 research</p>
        <h2>DHA Phase 6 Lahore price signals</h2>
        <p>Ranges below summarize observed public asking prices. They are neither official rates nor evidence of completed transactions.</p>
        <a class="text-link" href="/dha-phase-6-lahore-prices">Read the methodology and price guide</a>
      </div>
      <div class="price-table">
        {priceRows.map((row) => <div><strong>{row[0]}</strong><span>{row[1]}</span><small>{row[2]}</small></div>)}
      </div>
    </div>
  </section>

  <section class="section map-callout">
    <div class="container map-callout__inner">
      <div>
        <p class="eyebrow">Official map first</p>
        <h2>Do not shortlist a plot from a title alone.</h2>
        <p>Locate the exact plot, inspect road hierarchy and nearby land use, then compare the seller’s documents with DHA Lahore records.</p>
      </div>
      <div class="map-callout__actions">
        <a class="button button--gold" href="/dha-phase-6-lahore-map">Use the map guide</a>
        <a class="button button--line" href="https://dhalahore.org/wp-content/uploads/2025/09/PHASE-VI.pdf" target="_blank" rel="noopener noreferrer">Official PDF</a>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="heading-row heading-row--dark">
        <div><p class="eyebrow eyebrow--dark">Daily living</p><h2>Amenities and infrastructure</h2></div>
        <a href="/dha-phase-6-lahore-amenities">Full amenities guide</a>
      </div>
      <div class="amenity-grid">
        {amenities.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section verify">
    <div class="container verify__grid">
      <div>
        <p class="eyebrow eyebrow--dark">Buyer workflow</p>
        <h2>Research. Visit. Verify. Transfer.</h2>
      </div>
      <ol>
        <li><span>01</span><div><strong>Compare</strong><p>Use several current asking-price sources, not a single advertisement.</p></div></li>
        <li><span>02</span><div><strong>Inspect</strong><p>Visit the exact street and assess access, surroundings and physical condition.</p></div></li>
        <li><span>03</span><div><strong>Verify</strong><p>Confirm seller authority, documents, dues and transfer eligibility.</p></div></li>
        <li><span>04</span><div><strong>Document</strong><p>Use written terms and appropriate professional advice before payment.</p></div></li>
      </ol>
      <a class="button button--ink" href="/verification-and-transfer">Open complete checklist</a>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container faq-layout">
      <div><p class="eyebrow">Clear answers</p><h2>DHA Phase 6 Lahore FAQs</h2><a href="/faq">Browse all questions</a></div>
      <div>
        {faqs.map((faq, index) => (
          <details open={index === 0}>
            <summary>{faq.question}<span>+</span></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-cta">
    <div class="container">
      <p>Need a shortlisting or site-visit conversation?</p>
      <h2>Bring the plot number. We’ll start with verification.</h2>
      <div><a class="button button--gold" href="https://wa.me/923257800001" target="_blank" rel="noopener noreferrer">WhatsApp 0325 7800001</a><a class="button button--line" href="/contact">Contact property desk</a></div>
    </div>
  </section>
</PageLayout>

<style>
  .hero{position:relative;overflow:hidden;padding:clamp(5rem,11vw,9rem) 0;background:radial-gradient(circle at 82% 18%,#32685d 0,#153d37 22%,#08232a 48%,#05151f 82%);color:#fff}
  .hero:after{content:'';position:absolute;right:-12rem;bottom:-18rem;width:46rem;height:46rem;border:1px solid rgba(215,175,87,.24);border-radius:50%;box-shadow:0 0 0 4rem rgba(215,175,87,.035),0 0 0 9rem rgba(215,175,87,.025)}
  .hero__grid{position:absolute;inset:0;opacity:.12;background-image:linear-gradient(rgba(255,255,255,.3) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.3) 1px,transparent 1px);background-size:74px 74px;transform:perspective(500px) rotateX(62deg) scale(1.5);transform-origin:center bottom}
  .hero__inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(290px,.65fr);gap:clamp(3rem,8vw,8rem);align-items:end}
  .eyebrow{margin:0 0 .9rem;color:#e0bb62;font-size:.72rem;font-weight:900;letter-spacing:.17em;text-transform:uppercase}.eyebrow--dark{color:#1b6c5c}
  .hero h1{max-width:900px;margin:0;color:#fff;font-family:var(--font-display);font-size:clamp(3rem,7.4vw,7rem);line-height:.91;letter-spacing:-.045em}
  .hero__lead{max-width:710px;margin:1.65rem 0 0;color:#d6e3df;font-size:clamp(1rem,2vw,1.23rem);line-height:1.72}
  .hero__actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.button{display:inline-flex;align-items:center;justify-content:center;padding:.9rem 1.15rem;border:1px solid transparent;text-decoration:none;font-size:.78rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.button--gold{background:#d7af57;color:#102421}.button--line{border-color:rgba(255,255,255,.38);color:#fff}.button--ink{background:#0d302d;color:#fff}
  .hero__notice{max-width:650px;margin:1.1rem 0 0;color:#94aaa5;font-size:.72rem}
  .finder{padding:1.8rem;background:rgba(4,19,25,.78);border:1px solid rgba(224,187,98,.3);backdrop-filter:blur(14px)}.finder>p{margin:0;color:#e0bb62;font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.finder h2{margin:.45rem 0 1.4rem;color:#fff;font-family:var(--font-display);font-size:1.8rem}.finder__links a{display:flex;justify-content:space-between;gap:1rem;padding:.9rem 0;border-top:1px solid rgba(255,255,255,.1);text-decoration:none}.finder__links span{color:#9db2ac;font-size:.72rem}.finder__links strong{color:#fff;font-size:.78rem;text-align:right}
  .signal-band{background:#d7af57;color:#102421}.signal-band__grid{display:grid;grid-template-columns:repeat(4,1fr)}.signal-band__grid div{padding:1.4rem 1rem;border-right:1px solid rgba(16,36,33,.15)}.signal-band small,.signal-band strong{display:block}.signal-band small{font-size:.64rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;opacity:.7}.signal-band strong{margin-top:.25rem;font-family:var(--font-display);font-size:1.08rem}
  .section{padding:clamp(4rem,8vw,7.2rem) 0}.section--ink{background:#071a24;color:#fff}.section--sand{background:#f4efe4}
  .split{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(3rem,8vw,8rem);align-items:start}.split h2,.heading-row h2,.prices h2,.map-callout h2,.verify h2,.faq-layout h2,.contact-cta h2{margin:0;font-family:var(--font-display);font-size:clamp(2.3rem,5vw,4.7rem);line-height:1;letter-spacing:-.035em}.intro h2,.prices h2,.verify h2{color:#102d2a}.prose p,.prices p{color:#50605b;line-height:1.8}.prose a,.text-link{color:#12604f;font-weight:900}
  .heading-row{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:2.2rem}.heading-row h2{color:#fff}.heading-row>a{color:#ebce83;font-weight:800}.heading-row--dark h2{color:#102d2a}.heading-row--dark>a{color:#146252}
  .sector-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.15);border-left:1px solid rgba(255,255,255,.15)}.sector-grid a{min-height:230px;padding:1.3rem;border-right:1px solid rgba(255,255,255,.15);border-bottom:1px solid rgba(255,255,255,.15);color:#fff;text-decoration:none;transition:background .25s}.sector-grid a:hover{background:#123831}.sector-grid span{color:#d7af57;font-size:.68rem}.sector-grid h3{margin:1.5rem 0 .5rem;font-family:var(--font-display);font-size:2rem}.sector-grid p{color:#9cb0ab;font-size:.8rem;line-height:1.5}.sector-grid strong{display:block;margin-top:1.3rem;color:#edcf84;font-size:.72rem;text-transform:uppercase}
  .research-note{display:grid;grid-template-columns:230px 1fr;gap:2rem;padding:1rem 1.2rem;margin-bottom:1.5rem;background:#d7af57;color:#102421}.research-note span{font-size:.85rem}.property-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
  .split--prices{align-items:center}.price-table{border-top:1px solid #d8d0c2}.price-table>div{display:grid;grid-template-columns:1.2fr .9fr .8fr;gap:1rem;padding:1.15rem .3rem;border-bottom:1px solid #d8d0c2;align-items:center}.price-table strong{color:#183b35}.price-table span{color:#a16c0e;font-weight:900}.price-table small{color:#78837f}
  .map-callout{background:radial-gradient(circle at 90% 10%,#306156,#0c312e 43%,#071a24 78%);color:#fff}.map-callout__inner{display:grid;grid-template-columns:1fr auto;gap:4rem;align-items:end}.map-callout h2{max-width:800px;color:#fff}.map-callout p:not(.eyebrow){max-width:700px;color:#b9ccc7;line-height:1.7}.map-callout__actions{display:flex;gap:.7rem}
  .amenity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#d8d0c2;border:1px solid #d8d0c2}.amenity-grid article{padding:2rem;background:#faf7f0}.amenity-grid span{color:#a27621;font-size:.68rem}.amenity-grid h3{margin:1.2rem 0 .5rem;color:#102d2a;font-family:var(--font-display);font-size:1.6rem}.amenity-grid p{margin:0;color:#596863;line-height:1.65}
  .verify__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:5rem;align-items:start}.verify ol{margin:0;padding:0;list-style:none}.verify li{display:grid;grid-template-columns:50px 1fr;gap:1rem;padding:1.2rem 0;border-top:1px solid #ddd5c7}.verify li>span{color:#a57c2d;font-weight:900}.verify li strong{color:#102d2a}.verify li p{margin:.3rem 0 0;color:#60706a}.verify .button{grid-column:2;width:max-content}
  .faq-layout{display:grid;grid-template-columns:.65fr 1.35fr;gap:5rem}.faq-layout h2{color:#fff}.faq-layout>div:first-child>a{display:inline-block;margin-top:1.4rem;color:#ebce83}.faq-layout details{padding:1.1rem 0;border-top:1px solid rgba(255,255,255,.16)}.faq-layout summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;color:#fff;font-weight:800}.faq-layout summary span{color:#d7af57}.faq-layout details p{color:#aebfba;line-height:1.7}
  .contact-cta{padding:clamp(4rem,9vw,8rem) 0;background:#123e37;color:#fff;text-align:center}.contact-cta p{color:#e0bb62;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.contact-cta h2{max-width:900px;margin:0 auto;color:#fff}.contact-cta>div>div{display:flex;justify-content:center;gap:.8rem;margin-top:2rem}
  @media(max-width:1000px){.hero__inner,.split,.faq-layout,.verify__grid{grid-template-columns:1fr}.sector-grid{grid-template-columns:repeat(3,1fr)}.property-grid,.amenity-grid{grid-template-columns:repeat(2,1fr)}.verify .button{grid-column:1}.map-callout__inner{grid-template-columns:1fr}.map-callout__actions{flex-wrap:wrap}}
  @media(max-width:680px){.signal-band__grid{grid-template-columns:repeat(2,1fr)}.heading-row{align-items:start;flex-direction:column}.sector-grid,.property-grid,.amenity-grid{grid-template-columns:1fr}.research-note,.price-table>div{grid-template-columns:1fr;gap:.35rem}.map-callout__actions,.contact-cta>div>div{align-items:stretch;flex-direction:column}.hero{padding-top:4.5rem}.finder{padding:1.2rem}}
</style>
