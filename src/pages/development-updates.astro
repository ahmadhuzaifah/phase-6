---
/**
 * Development Updates & Infrastructure Timeline — DHA Phase 6 Lahore
 */

import PageLayout from '@layouts/PageLayout.astro';
import Schema from '@components/seo/Schema.astro';
import { SITE } from '@data/site';
import { CONTACTS } from '@data/contacts';
import { DEVELOPMENT_UPDATES } from '@data/developmentUpdates';

const pageSchema = {
  name: `Development Updates & Milestone Timeline — ${SITE.name}`,
  description: 'Chronological timeline of infrastructure progress, on-ground possession handovers, road carpeting, and commercial expansions in DHA Phase 6 Lahore.',
  url: `${SITE.url}/development-updates`,
};
---

<PageLayout
  title={`Development Updates & Construction Timeline | DHA Phase 6 Lahore`}
  description="Track real-time infrastructure progress, on-ground possession milestones, asphalt road carpeting, and sector development in DHA Phase 6 Lahore."
>
  <Schema type="WebSite" data={pageSchema} />

  <!-- Hero Section -->
  <section class="dev-hero">
    <div class="container">
      <div class="eyebrow eyebrow--dark">Live On-Ground Progress</div>
      <h1 class="dev-hero__title">
        Development <span class="text-gradient-gold">Updates &amp; Timeline</span>
      </h1>
      <p class="dev-hero__lead lead">
        Explore verified on-ground construction milestones, road carpeting, electrical sub-station commissioning, and possession handovers across all sectors of DHA Phase 6 Lahore.
      </p>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="section section--alt">
    <div class="container">
      <div class="timeline-wrap">
        {DEVELOPMENT_UPDATES.map((item) => (
          <div class="timeline-item">
            <!-- Left Marker / Year Column -->
            <div class="timeline-item__badge-col">
              <div class="timeline-badge">
                <span class="timeline-badge__year">{item.year}</span>
                <span class="timeline-badge__quarter">{item.quarter}</span>
              </div>
              <div class="timeline-line"></div>
            </div>

            <!-- Right Content Card -->
            <div class="timeline-card">
              <div class="timeline-card__top">
                <div class="timeline-card__tags">
                  <span class="timeline-tag timeline-tag--cat">{item.category}</span>
                  <span class:list={['timeline-tag', `timeline-tag--${item.status.toLowerCase().replace(' ', '-')}`]}>
                    ● {item.status}
                  </span>
                </div>
                <h2 class="timeline-card__title">{item.title}</h2>
              </div>

              <p class="timeline-card__summary">{item.summary}</p>

              <div class="timeline-card__details">
                <strong>Key Milestone Achievements:</strong>
                <ul>
                  {item.details.map((d) => (
                    <li>✓ {d}</li>
                  ))}
                </ul>
              </div>

              <div class="timeline-card__media">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  loading="lazy"
                  class="timeline-card__img"
                />
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Advisory Banner -->
      <div class="dev-cta-box" style="margin-top: 60px;">
        <div>
          <h3 style="color: #FFFFFF; font-size: var(--text-2xl); margin: 0 0 8px;">Want to Inspect Current On-Ground Development?</h3>
          <p style="color: #CBD5E1; font-size: var(--text-sm); margin: 0;">
            Schedule an on-site visit with our official site engineering desk. We provide guided sector tours and plot demarcation inspections.
          </p>
        </div>
        <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--lg" style="flex-shrink: 0;">
          Book Guided Site Visit on WhatsApp
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .dev-hero {
    background: radial-gradient(circle at 80% 20%, #25254D 0%, #0A0A1A 75%);
    color: var(--text-inverse);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .dev-hero__title {
    color: #FFFFFF;
    margin: var(--space-2) 0 var(--space-3);
  }

  .dev-hero__lead {
    color: var(--color-neutral-300);
    max-width: 65ch;
    margin: 0;
  }

  .timeline-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 960px;
    margin: 0 auto;
  }

  .timeline-item {
    display: flex;
    gap: var(--space-6);
  }

  .timeline-item__badge-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 85px;
    flex-shrink: 0;
  }

  .timeline-badge {
    background: var(--color-secondary-950);
    border: 2px solid var(--border-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-2) var(--space-3);
    text-align: center;
    color: #FFFFFF;
    box-shadow: var(--shadow-md);
    width: 100%;
  }

  .timeline-badge__year {
    font-size: var(--text-base);
    font-weight: var(--font-extrabold);
    color: #F3D375;
    display: block;
    line-height: 1.1;
  }

  .timeline-badge__quarter {
    font-size: 10px;
    color: var(--color-neutral-300);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .timeline-line {
    flex-grow: 1;
    width: 2px;
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.5) 0%, rgba(212, 175, 55, 0.1) 100%);
    margin-top: var(--space-2);
  }

  .timeline-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .timeline-card__tags {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .timeline-tag {
    font-size: 11px;
    font-weight: var(--font-bold);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  .timeline-tag--cat {
    background: var(--color-primary-50);
    color: var(--color-primary-800);
    border: 1px solid var(--border-gold);
  }

  .timeline-tag--completed {
    background: #D1FAE5;
    color: #065F46;
  }

  .timeline-tag--in-progress {
    background: #FEF3C7;
    color: #92400E;
  }

  .timeline-card__title {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: 0;
  }

  .timeline-card__summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .timeline-card__details {
    background: var(--color-neutral-50);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-light);
  }

  .timeline-card__details strong {
    font-size: var(--text-xs);
    color: var(--text-primary);
    display: block;
    margin-bottom: var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .timeline-card__details ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .timeline-card__details li {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .timeline-card__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 21 / 9;
    background: #000;
  }

  .timeline-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dev-cta-box {
    background: linear-gradient(135deg, #161635 0%, #0A0A1A 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .dev-cta-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
