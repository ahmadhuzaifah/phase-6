---
/**
 * DHA Phase 6 Lahore — Interactive Property Market Dashboard
 * /dha-phase-6-property-market-dashboard/
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@data/site';
import properties from '@data/properties-import.json';

const title = "DHA Phase 6 Property Market Dashboard 2026 — Live Pricing, Sector Demand & Yield Analytics";
const description = "Interactive real-time property market dashboard for DHA Phase 6 Lahore. Explore live average prices for 1 Kanal, 10 Marla and 5 Marla plots and houses, sector-by-sector demand rankings, commercial yields, and trend charts.";
const canonical = `${SITE.url}/dha-phase-6-property-market-dashboard/`;

// Quantitative aggregation from properties dataset and market benchmarks
const totalListings = properties.length;
const oneKanalPlots = properties.filter(p => p.propertyType === 'residential-plot' && p.size === '1');
const avgOneKanalPlotPrice = oneKanalPlots.length > 0 
  ? Math.round(oneKanalPlots.reduce((acc, curr) => acc + curr.price, 0) / oneKanalPlots.length)
  : 54500000;

const formatCr = (num: number) => `PKR ${(num / 10000000).toFixed(2)} Cr`;

// Sector Comparison Matrix Data
const sectorMetrics = [
  { sector: "Sector A", avgPlot1K: 5.85, avgHouse1K: 12.20, demandRank: 4, yield: "4.6%", zone: "Executive Living" },
  { sector: "Sector B", avgPlot1K: 5.60, avgHouse1K: 11.80, demandRank: 5, yield: "4.7%", zone: "Education & Family" },
  { sector: "Sector C", avgPlot1K: 6.20, avgHouse1K: 13.50, demandRank: 1, yield: "4.5%", zone: "Prime Luxury" },
  { sector: "Sector D", avgPlot1K: 5.75, avgHouse1K: 12.00, demandRank: 2, yield: "4.8%", zone: "Commercial Proximity" },
  { sector: "Sector E", avgPlot1K: 5.30, avgHouse1K: 11.20, demandRank: 7, yield: "4.9%", zone: "Healthcare Hub" },
  { sector: "Sector F", avgPlot1K: 5.15, avgHouse1K: 10.90, demandRank: 8, yield: "4.8%", zone: "Quiet Residential" },
  { sector: "Sector G", avgPlot1K: 4.80, avgHouse1K: 10.40, demandRank: 6, yield: "5.1%", zone: "Value Growth" },
  { sector: "Sector H", avgPlot1K: 5.20, avgHouse1K: 11.00, demandRank: 9, yield: "5.0%", zone: "Mixed Format" },
  { sector: "Sector J", avgPlot1K: 5.40, avgHouse1K: 11.50, demandRank: 3, yield: "5.2%", zone: "10 Marla / School Fav" },
  { sector: "Sector K", avgPlot1K: 4.45, avgHouse1K: 9.80, demandRank: 10, yield: "5.3%", zone: "High ROI Potential" },
  { sector: "Sector L", avgPlot1K: 4.30, avgHouse1K: 9.50, demandRank: 11, yield: "5.4%", zone: "Ring Road Transit" },
  { sector: "Sector M", avgPlot1K: 6.80, avgHouse1K: 14.50, demandRank: 12, yield: "4.2%", zone: "Golf Resort Edge" },
  { sector: "Sector N", avgPlot1K: 5.25, avgHouse1K: 11.10, demandRank: 13, yield: "4.9%", zone: "Northern Gateway" }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonical}#dashboard`,
      "isPartOf": { "@type": "WebSite", "@id": `${SITE.url}/#website` },
      "name": "DHA Phase 6 Property Market Dashboard",
      "url": canonical,
      "description": description,
      "applicationCategory": "RealEstateApplication"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "Market Analysis", "item": `${SITE.url}/dha-phase-6-market-analysis/` },
        { "@type": "ListItem", "position": 3, "name": "Property Market Dashboard", "item": canonical }
      ]
    }
  ]
};
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <header class="dash-hero">
    <div class="container">
      <div class="hero-tag-row">
        <span class="live-pill"><span class="pulse-dot"></span> Live Intelligence Feed</span>
        <span class="date-pill">Q3 2026 Benchmarks</span>
      </div>
      <h1 class="dash-title">
        DHA Phase 6 <span class="text-gold">Property Market Dashboard</span>
      </h1>
      <p class="dash-lead">
        Quantitative real-time monitoring of average plot demand, house valuations, rental yields, sector liquidity rankings, and investment zones across DHA Phase 6 Lahore.
      </p>

      <!-- TOP METRIC KPI CARDS -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <span class="kpi-title">Avg 1 Kanal Plot</span>
          <strong class="kpi-val">{formatCr(avgOneKanalPlotPrice)}</strong>
          <span class="kpi-sub positive">▲ +4.2% YoY Stability</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">Avg 10 Marla Plot</span>
          <strong class="kpi-val">PKR 3.15 Cr</strong>
          <span class="kpi-sub positive">▲ +6.5% Strong Liquidity</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">Avg 1 Kanal Luxury House</span>
          <strong class="kpi-val">PKR 11.75 Cr</strong>
          <span class="kpi-sub neutral">■ Stable Construction Replacement Cost</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">CCA 1 Commercial Yield</span>
          <strong class="kpi-val">7.2% Gross</strong>
          <span class="kpi-sub positive">▲ 94% Retail Occupancy</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">Active Market Records</span>
          <strong class="kpi-val">{totalListings} Verified Snapshots</strong>
          <span class="kpi-sub">7-Stage Audit Verification</span>
        </div>
      </div>

    </div>
  </header>

  <main class="container dash-main">
    
    <!-- INTERACTIVE VISUAL CHARTS -->
    <section class="dash-section">
      <div class="section-title-bar">
        <div>
          <h2>1 Kanal Plot Price Comparison by Sector (PKR Crore)</h2>
          <p>Comparative baseline pricing across all residential sectors based on 2026 market observations.</p>
        </div>
        <span class="badge-audit">Independent Price Survey</span>
      </div>

      <!-- VISUAL SVG / CSS BAR CHART -->
      <div class="chart-container">
        <div class="bar-chart">
          {sectorMetrics.map(item => {
            const heightPercent = Math.min(100, Math.round((item.avgPlot1K / 7.0) * 100));
            return (
              <div class="bar-col">
                <div class="bar-val">{item.avgPlot1K.toFixed(2)} Cr</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`height: ${heightPercent}%;`}></div>
                </div>
                <div class="bar-label">{item.sector.replace('Sector ', '')}</div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- SECTOR METRIC INTELLIGENCE TABLE -->
    <section class="dash-section">
      <div class="section-title-bar">
        <div>
          <h2>Comprehensive Sector Matrix &amp; Demand Rankings</h2>
          <p>Analyze house valuation benchmarks, rental yields, and categorized investment zones.</p>
        </div>
        <a href="/dha-phase-6-sector-ranking/" class="btn-subtle">View In-Depth Ranking Methodology →</a>
      </div>

      <div class="table-responsive">
        <table class="dash-table">
          <thead>
            <tr>
              <th>Sector</th>
              <th>Demand Rank</th>
              <th>Avg 1 Kanal Plot</th>
              <th>Avg 1 Kanal House</th>
              <th>Gross Rental Yield</th>
              <th>Strategic Zone</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {sectorMetrics.sort((a,b) => a.demandRank - b.demandRank).map(item => (
              <tr>
                <td>
                  <strong>{item.sector}</strong>
                </td>
                <td>
                  <span class:list={['rank-pill', { 'rank-top': item.demandRank <= 3 }]}>
                    #{item.demandRank}
                  </span>
                </td>
                <td>PKR {item.avgPlot1K.toFixed(2)} Cr</td>
                <td>PKR {item.avgHouse1K.toFixed(2)} Cr</td>
                <td><strong class="yield-badge">{item.yield}</strong></td>
                <td><span class="zone-pill">{item.zone}</span></td>
                <td>
                  <a href={`/dha-phase-6-${item.sector.toLowerCase().replace(' ', '-')}-lahore/`} class="table-link">
                    Sector Details →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- POPULAR SIZES & LIQUIDITY ANALYSIS -->
    <section class="dash-grid-2">
      <div class="grid-card">
        <h3>Most In-Demand Property Sizes (2026)</h3>
        <ul class="size-list">
          <li>
            <div class="size-meta">
              <strong>1 Kanal Residential (500 sq yds)</strong>
              <span>52% Total Inquiries</span>
            </div>
            <div class="progress-bar"><div class="progress-fill" style="width: 52%;"></div></div>
            <small>Gold standard for prestige end-user living and elite villas in Sectors A, B, C, D.</small>
          </li>
          <li>
            <div class="size-meta">
              <strong>10 Marla Residential (250 sq yds)</strong>
              <span>31% Total Inquiries</span>
            </div>
            <div class="progress-bar"><div class="progress-fill" style="width: 31%;"></div></div>
            <small>Fastest transaction velocity; high family demand in Sectors J, G, and H near schools.</small>
          </li>
          <li>
            <div class="size-meta">
              <strong>4 &amp; 8 Marla Commercial Plazas</strong>
              <span>12% Total Inquiries</span>
            </div>
            <div class="progress-bar"><div class="progress-fill" style="width: 12%;"></div></div>
            <small>High cash-flow rental yields across CCA 1, CCA 2, and Main Boulevard frontage.</small>
          </li>
          <li>
            <div class="size-meta">
              <strong>2 Kanal Executive Mansions</strong>
              <span>5% Total Inquiries</span>
            </div>
            <div class="progress-bar"><div class="progress-fill" style="width: 5%;"></div></div>
            <small>Exclusive luxury estates in Sectors A, B, and Raya Golf View plots.</small>
          </li>
        </ul>
      </div>

      <div class="grid-card">
        <h3>Investment Zones &amp; Capital Strategies</h3>
        <div class="strategy-boxes">
          <div class="strat-box">
            <span class="strat-tag blue">Preservation &amp; Elite Living</span>
            <h4>Sectors C, D &amp; Defence Raya</h4>
            <p>Maximum lifestyle security, mature landscaping, immediate mosque and commercial access. Prime choice for overseas Pakistanis seeking turnkey mansions.</p>
          </div>
          <div class="strat-box">
            <span class="strat-tag green">High Capital Growth Target</span>
            <h4>Sectors K, L &amp; G</h4>
            <p>20% price discount against central sectors. Faster construction velocity and immediate Lahore Ring Road interchange commute make this the premier capital appreciation corridor.</p>
          </div>
          <div class="strat-box">
            <span class="strat-tag gold">Pure Cashflow &amp; Yield</span>
            <h4>CCA 1 &amp; CCA 2 Commercial</h4>
            <p>6.5% to 7.5% gross rental yields with blue-chip corporate bank, cafe, and medical tenants. Minimum vacancy risk.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- DASHBOARD ACTIONS & FUNNEL CTA -->
    <section class="dash-cta-banner">
      <div class="cta-content">
        <h2>Need Custom Due Diligence on a Specific Plot or House?</h2>
        <p>Consult with our independent property desk to verify title documentation, NDC status, and accurate market valuations before transferring funds.</p>
        <div class="cta-btn-row">
          <a href="/property-advisor/" class="btn-dash-primary">Launch Property Advisor Tool →</a>
          <a href="/dha-phase-6-property-calculator/" class="btn-dash-secondary">Calculate FBR &amp; Transfer Taxes</a>
        </div>
      </div>
    </section>

  </main>
</PageLayout>

<style>
  .dash-hero {
    background: linear-gradient(135deg, #0b131e 0%, #152232 100%);
    color: #ffffff;
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hero-tag-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pulse-dot {
    width: 7px;
    height: 7px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
  }
  .date-pill {
    background: rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }
  .dash-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .text-gold {
    background: linear-gradient(135deg, #e5b324 0%, #fef08a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .dash-lead {
    font-size: 1.15rem;
    color: #94a3b8;
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  .kpi-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .kpi-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }
  .kpi-val {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
  }
  .kpi-sub {
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
  }
  .kpi-sub.positive { color: #34d399; }
  .kpi-sub.neutral { color: #facc15; }

  .dash-main {
    padding: 3rem 0 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .dash-section {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .section-title-bar h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.5rem 0;
  }
  .section-title-bar p {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0;
  }
  .badge-audit {
    background: #f1f5f9;
    color: #475569;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .btn-subtle {
    color: #c8960c;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .btn-subtle:hover {
    text-decoration: underline;
  }

  /* BAR CHART STYLING */
  .chart-container {
    padding: 1.5rem 0 0.5rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }
  .bar-chart {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 240px;
    padding: 0 1.5rem;
    gap: 0.75rem;
  }
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    min-width: 32px;
  }
  .bar-val {
    font-size: 0.75rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.35rem;
    white-space: nowrap;
  }
  .bar-track {
    width: 100%;
    max-width: 44px;
    height: 180px;
    background: #e2e8f0;
    border-radius: 6px 6px 0 0;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .bar-fill {
    width: 100%;
    background: linear-gradient(180deg, #c8960c 0%, #d97706 100%);
    border-radius: 6px 6px 0 0;
    transition: height 0.6s ease;
  }
  .bar-col:hover .bar-fill {
    background: linear-gradient(180deg, #e5b324 0%, #b45309 100%);
  }
  .bar-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
    margin-top: 0.5rem;
  }

  /* TABLE STYLING */
  .table-responsive {
    overflow-x: auto;
  }
  .dash-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }
  .dash-table th {
    background: #f8fafc;
    color: #475569;
    padding: 1rem;
    font-weight: 700;
    border-bottom: 2px solid #e2e8f0;
  }
  .dash-table td {
    padding: 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
  }
  .dash-table tr:hover {
    background: #f8fafc;
  }
  .rank-pill {
    background: #e2e8f0;
    color: #475569;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }
  .rank-pill.rank-top {
    background: #fef3c7;
    color: #92400e;
  }
  .yield-badge {
    color: #15803d;
  }
  .zone-pill {
    background: #eff6ff;
    color: #1d4ed8;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .table-link {
    color: #c8960c;
    font-weight: 700;
    text-decoration: none;
  }
  .table-link:hover {
    text-decoration: underline;
  }

  /* GRID 2 COLUMNS */
  .dash-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
  }
  .grid-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .grid-card h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 1.5rem 0;
  }
  .size-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .size-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }
  .progress-bar {
    height: 8px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }
  .progress-fill {
    height: 100%;
    background: #c8960c;
    border-radius: 999px;
  }
  .size-list small {
    color: #64748b;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .strategy-boxes {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .strat-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.25rem;
  }
  .strat-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .strat-tag.blue { background: #dbeafe; color: #1e40af; }
  .strat-tag.green { background: #dcfce7; color: #166534; }
  .strat-tag.gold { background: #fef3c7; color: #92400e; }
  .strat-box h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.4rem 0;
  }
  .strat-box p {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  .dash-cta-banner {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-content {
    max-width: 720px;
    margin: 0 auto;
  }
  .cta-content h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .cta-content p {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .cta-btn-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn-dash-primary {
    background: #c8960c;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .btn-dash-primary:hover {
    background: #b08207;
  }
  .btn-dash-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: background 0.2s ease;
  }
  .btn-dash-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 768px) {
    .dash-section {
      padding: 1.25rem;
    }
    .chart-container {
      overflow-x: auto;
    }
    .bar-chart {
      min-width: 500px;
    }
  }
</style>
