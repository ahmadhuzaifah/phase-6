---
/**
 * DHA Phase 6 Lahore — Interactive Property Market Dashboard
 * /dha-phase-6-property-market-dashboard/
 */
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@data/site';
import properties from '@data/properties-import.json';
import priceHistory from '@data/property-price-history.json';
import { isPublishableProperty } from '@utils/propertyQualityScore';
import { isActiveProperty } from '@utils/propertyLifecycle';

const title = "DHA Phase 6 Property Market Dashboard 2026 — Live Pricing, Sector Demand & Yield Analytics";
const description = "Interactive real-time property market dashboard for DHA Phase 6 Lahore. Explore live average prices for 1 Kanal, 10 Marla and 5 Marla plots and houses, sector-by-sector demand rankings, commercial yields, and trend charts.";
const canonical = `${SITE.url}/dha-phase-6-property-market-dashboard/`;

const activeProperties = properties.filter(property => isPublishableProperty(property) && isActiveProperty(property));
const totalListings = activeProperties.length;
const saleCount = activeProperties.filter(property => property.purpose === 'sale').length;
const rentCount = activeProperties.filter(property => property.purpose === 'rent').length;
const houses = activeProperties.filter(property => ['house', 'villa'].includes(property.propertyType));
const plots = activeProperties.filter(property => property.propertyType === 'residential-plot');
const average = (records: typeof properties) => records.length ? Math.round(records.reduce((sum, record) => sum + record.price, 0) / records.length) : 0;
const avgHousePrice = average(houses);
const avgPlotPrice = average(plots);
const formatPrice = (num: number) => num ? `PKR ${(num / 10_000_000).toFixed(2)} Cr` : 'No records';
const ratio = rentCount ? `${(saleCount / rentCount).toFixed(1)}:1` : `${saleCount}:0`;

const sectors = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'J', 'K', 'L', 'M', 'N'];
const sectorRows = sectors.map(letter => {
  const sector = `Sector ${letter}`;
  const records = activeProperties.filter(property => property.block === sector || property.location.sector === sector);
  const oneKanalPlots = records.filter(property => property.propertyType === 'residential-plot' && property.size === '1' && property.unit === 'kanal');
  const oneKanalHouses = records.filter(property => ['house', 'villa'].includes(property.propertyType) && property.size === '1' && property.unit === 'kanal');
  return { sector, count: records.length, avgPlot1K: average(oneKanalPlots), avgHouse1K: average(oneKanalHouses) };
});
const ranked = [...sectorRows].sort((a, b) => b.count - a.count || a.sector.localeCompare(b.sector));
const sectorMetrics = sectorRows.map(row => ({ ...row, demandRank: ranked.findIndex(item => item.sector === row.sector) + 1 }));
const maxSectorCount = Math.max(1, ...sectorMetrics.map(item => item.count));

const sizeCounts = new Map<string, number>();
for (const property of activeProperties) {
  const label = `${property.size} ${property.unit} ${property.propertyType.replaceAll('-', ' ')}`;
  sizeCounts.set(label, (sizeCounts.get(label) || 0) + 1);
}
const sizeDemand = [...sizeCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([label, count]) => ({
  label,
  count,
  percent: Math.round(count / Math.max(1, totalListings) * 100),
}));
type PriceHistoryEntry = { date: string; price: number; previousPrice?: number | null; newPrice?: number };
const historyEntries = Object.values(priceHistory as Record<string, PriceHistoryEntry[]>).flat();
const priceChanges = historyEntries.filter(entry => entry.previousPrice && entry.previousPrice !== entry.newPrice).length;
const historyBuckets = new Map<string, number[]>();
for (const entry of historyEntries) {
  const month = entry.date?.slice(0, 7);
  if (month) historyBuckets.set(month, [...(historyBuckets.get(month) || []), entry.price]);
}
const priceTrend = [...historyBuckets.entries()].sort(([a], [b]) => a.localeCompare(b)).slice(-6).map(([month, prices]) => ({
  month,
  average: Math.round(prices.reduce((sum, price) => sum + price, 0) / prices.length),
}));
const maxTrendPrice = Math.max(1, ...priceTrend.map(item => item.average));

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonical}#dashboard`,
      "isPartOf": { "@type": "WebSite", "@id": `${SITE.url}/#website` },
      "name": "DHA Phase 6 Property Market Dashboard",
      "url": canonical,
      "description": description,
      "applicationCategory": "RealEstateApplication"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
        { "@type": "ListItem", "position": 2, "name": "Market Analysis", "item": `${SITE.url}/dha-phase-6-market-analysis/` },
        { "@type": "ListItem", "position": 3, "name": "Property Market Dashboard", "item": canonical }
      ]
    }
  ]
};
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <header class="dash-hero">
    <div class="container">
      <div class="hero-tag-row">
        <span class="live-pill"><span class="pulse-dot"></span> Live Intelligence Feed</span>
        <span class="date-pill">Q3 2026 Benchmarks</span>
      </div>
      <h1 class="dash-title">
        DHA Phase 6 <span class="text-gold">Property Market Dashboard</span>
      </h1>
      <p class="dash-lead">
        Quantitative real-time monitoring of average plot demand, house valuations, rental yields, sector liquidity rankings, and investment zones across DHA Phase 6 Lahore.
      </p>

      <!-- TOP METRIC KPI CARDS -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <span class="kpi-title">Average House Demand</span>
          <strong class="kpi-val">{formatPrice(avgHousePrice)}</strong>
          <span class="kpi-sub positive">From {houses.length} active records</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">Average Plot Demand</span>
          <strong class="kpi-val">{formatPrice(avgPlotPrice)}</strong>
          <span class="kpi-sub positive">From {plots.length} active records</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">Sale to Rent Ratio</span>
          <strong class="kpi-val">{ratio}</strong>
          <span class="kpi-sub neutral">{saleCount} sale / {rentCount} rent</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">Recorded Price Changes</span>
          <strong class="kpi-val">{priceChanges}</strong>
          <span class="kpi-sub positive">Across retained price history</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-title">Active Market Records</span>
          <strong class="kpi-val">{totalListings} Snapshots</strong>
          <span class="kpi-sub">Quality score 60 or higher</span>
        </div>
      </div>

    </div>
  </header>

  <main class="container dash-main">
    
    <!-- INTERACTIVE VISUAL CHARTS -->
    <section class="dash-section">
      <div class="section-title-bar">
        <div>
          <h2>Active Listing Coverage by Sector</h2>
          <p>Published source-referenced records in each residential sector.</p>
        </div>
        <span class="badge-audit">Independent Price Survey</span>
      </div>

      <!-- VISUAL SVG / CSS BAR CHART -->
      <div class="chart-container">
        <div class="bar-chart">
          {sectorMetrics.map(item => {
            const heightPercent = Math.max(2, Math.round((item.count / maxSectorCount) * 100));
            return (
              <div class="bar-col">
                <div class="bar-val">{item.count}</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`height: ${heightPercent}%;`}></div>
                </div>
                <div class="bar-label">{item.sector.replace('Sector ', '')}</div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="dash-section">
      <div class="section-title-bar">
        <div>
          <h2>Recorded Asking-Price Trend</h2>
          <p>Monthly average of retained listing snapshots in the local price-history dataset.</p>
        </div>
        <span class="badge-audit">Build-time static chart</span>
      </div>
      <div class="trend-chart">
        {priceTrend.map(item => (
          <div class="trend-row">
            <time datetime={item.month}>{item.month}</time>
            <div class="trend-track"><span style={`width: ${Math.max(2, Math.round(item.average / maxTrendPrice * 100))}%`}></span></div>
            <strong>{formatPrice(item.average)}</strong>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTOR METRIC INTELLIGENCE TABLE -->
    <section class="dash-section">
      <div class="section-title-bar">
        <div>
          <h2>Comprehensive Sector Matrix &amp; Demand Rankings</h2>
          <p>Analyze house valuation benchmarks, rental yields, and categorized investment zones.</p>
        </div>
        <a href="/dha-phase-6-sector-ranking/" class="btn-subtle">View In-Depth Ranking Methodology →</a>
      </div>

      <div class="table-responsive">
        <table class="dash-table">
          <thead>
            <tr>
              <th>Sector</th>
              <th>Demand Rank</th>
              <th>Avg 1 Kanal Plot</th>
              <th>Avg 1 Kanal House</th>
              <th>Active Records</th>
              <th>Coverage</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {sectorMetrics.sort((a,b) => a.demandRank - b.demandRank).map(item => (
              <tr>
                <td>
                  <strong>{item.sector}</strong>
                </td>
                <td>
                  <span class:list={['rank-pill', { 'rank-top': item.demandRank <= 3 }]}>
                    #{item.demandRank}
                  </span>
                </td>
                <td>{formatPrice(item.avgPlot1K)}</td>
                <td>{formatPrice(item.avgHouse1K)}</td>
                <td><strong class="yield-badge">{item.count}</strong></td>
                <td><span class="zone-pill">{item.count ? 'Covered' : 'Gap'}</span></td>
                <td>
                  <a href={`/dha-phase-6-${item.sector.toLowerCase().replace(' ', '-')}-lahore/`} class="table-link">
                    Sector Details →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- POPULAR SIZES & LIQUIDITY ANALYSIS -->
    <section class="dash-grid-2">
      <div class="grid-card">
        <h3>Most In-Demand Property Sizes (2026)</h3>
        <ul class="size-list">
          {sizeDemand.map(item => (
            <li>
              <div class="size-meta">
                <strong>{item.label}</strong>
                <span>{item.count} records ({item.percent}%)</span>
              </div>
              <div class="progress-bar"><div class="progress-fill" style={`width: ${Math.max(2, item.percent)}%;`}></div></div>
              <small>Share of current publishable source-referenced inventory.</small>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid-card">
        <h3>Investment Zones &amp; Capital Strategies</h3>
        <div class="strategy-boxes">
          <div class="strat-box">
            <span class="strat-tag blue">Preservation &amp; Elite Living</span>
            <h4>Sectors C, D &amp; Defence Raya</h4>
            <p>Maximum lifestyle security, mature landscaping, immediate mosque and commercial access. Prime choice for overseas Pakistanis seeking turnkey mansions.</p>
          </div>
          <div class="strat-box">
            <span class="strat-tag green">High Capital Growth Target</span>
            <h4>Sectors K, L &amp; G</h4>
            <p>20% price discount against central sectors. Faster construction velocity and immediate Lahore Ring Road interchange commute make this the premier capital appreciation corridor.</p>
          </div>
          <div class="strat-box">
            <span class="strat-tag gold">Pure Cashflow &amp; Yield</span>
            <h4>CCA 1 &amp; CCA 2 Commercial</h4>
            <p>6.5% to 7.5% gross rental yields with blue-chip corporate bank, cafe, and medical tenants. Minimum vacancy risk.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- DASHBOARD ACTIONS & FUNNEL CTA -->
    <section class="dash-cta-banner">
      <div class="cta-content">
        <h2>Need Custom Due Diligence on a Specific Plot or House?</h2>
        <p>Consult with our independent property desk to verify title documentation, NDC status, and accurate market valuations before transferring funds.</p>
        <div class="cta-btn-row">
          <a href="/property-advisor/" class="btn-dash-primary">Launch Property Advisor Tool →</a>
          <a href="/dha-phase-6-property-calculator/" class="btn-dash-secondary">Calculate FBR &amp; Transfer Taxes</a>
        </div>
      </div>
    </section>

  </main>
</PageLayout>

<style>
  .dash-hero {
    background: linear-gradient(135deg, #0b131e 0%, #152232 100%);
    color: #ffffff;
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hero-tag-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pulse-dot {
    width: 7px;
    height: 7px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
  }
  .date-pill {
    background: rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }
  .dash-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .text-gold {
    background: linear-gradient(135deg, #e5b324 0%, #fef08a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .dash-lead {
    font-size: 1.15rem;
    color: #94a3b8;
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  .kpi-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .kpi-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }
  .kpi-val {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
  }
  .kpi-sub {
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
  }
  .kpi-sub.positive { color: #34d399; }
  .kpi-sub.neutral { color: #facc15; }

  .dash-main {
    padding: 3rem 0 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .dash-section {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .section-title-bar h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.5rem 0;
  }
  .section-title-bar p {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0;
  }
  .badge-audit {
    background: #f1f5f9;
    color: #475569;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .btn-subtle {
    color: #c8960c;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .btn-subtle:hover {
    text-decoration: underline;
  }

  /* BAR CHART STYLING */
  .chart-container {
    padding: 1.5rem 0 0.5rem;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }
  .trend-chart { display: grid; gap: 0.8rem; }
  .trend-row { display: grid; grid-template-columns: 7rem minmax(8rem, 1fr) 9rem; align-items: center; gap: 1rem; }
  .trend-track { height: 12px; overflow: hidden; border-radius: 999px; background: #e2e8f0; }
  .trend-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #c8960c, #facc15); }
  .trend-row time { color: #64748b; }
  .trend-row strong { color: #0f172a; text-align: right; }
  .bar-chart {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 240px;
    padding: 0 1.5rem;
    gap: 0.75rem;
  }
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    min-width: 32px;
  }
  .bar-val {
    font-size: 0.75rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.35rem;
    white-space: nowrap;
  }
  .bar-track {
    width: 100%;
    max-width: 44px;
    height: 180px;
    background: #e2e8f0;
    border-radius: 6px 6px 0 0;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .bar-fill {
    width: 100%;
    background: linear-gradient(180deg, #c8960c 0%, #d97706 100%);
    border-radius: 6px 6px 0 0;
    transition: height 0.6s ease;
  }
  .bar-col:hover .bar-fill {
    background: linear-gradient(180deg, #e5b324 0%, #b45309 100%);
  }
  .bar-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
    margin-top: 0.5rem;
  }

  /* TABLE STYLING */
  .table-responsive {
    overflow-x: auto;
  }
  .dash-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }
  .dash-table th {
    background: #f8fafc;
    color: #475569;
    padding: 1rem;
    font-weight: 700;
    border-bottom: 2px solid #e2e8f0;
  }
  .dash-table td {
    padding: 1rem;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
  }
  .dash-table tr:hover {
    background: #f8fafc;
  }
  .rank-pill {
    background: #e2e8f0;
    color: #475569;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }
  .rank-pill.rank-top {
    background: #fef3c7;
    color: #92400e;
  }
  .yield-badge {
    color: #15803d;
  }
  .zone-pill {
    background: #eff6ff;
    color: #1d4ed8;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .table-link {
    color: #c8960c;
    font-weight: 700;
    text-decoration: none;
  }
  .table-link:hover {
    text-decoration: underline;
  }

  /* GRID 2 COLUMNS */
  .dash-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
  }
  .grid-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .grid-card h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 1.5rem 0;
  }
  .size-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .size-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }
  .progress-bar {
    height: 8px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }
  .progress-fill {
    height: 100%;
    background: #c8960c;
    border-radius: 999px;
  }
  .size-list small {
    color: #64748b;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .strategy-boxes {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .strat-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.25rem;
  }
  .strat-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .strat-tag.blue { background: #dbeafe; color: #1e40af; }
  .strat-tag.green { background: #dcfce7; color: #166534; }
  .strat-tag.gold { background: #fef3c7; color: #92400e; }
  .strat-box h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.4rem 0;
  }
  .strat-box p {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  .dash-cta-banner {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-content {
    max-width: 720px;
    margin: 0 auto;
  }
  .cta-content h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .cta-content p {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .cta-btn-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn-dash-primary {
    background: #c8960c;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .btn-dash-primary:hover {
    background: #b08207;
  }
  .btn-dash-secondary {
