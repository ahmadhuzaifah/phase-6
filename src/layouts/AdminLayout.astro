---
/**
 * Admin Layout — Al Rehman Garden Phase 2 Lahore
 * Dedicated administrative operations wrapper with sidebar navigation and metrics toolbar.
 */

import '../styles/variables.css';
import '../styles/typography.css';
import '../styles/global.css';
import { CURRENT_ADMIN_USER } from '../utils/auth';

interface Props {
  title: string;
  activeSection: 'overview' | 'properties' | 'leads' | 'dealers' | 'images' | 'content' | 'analytics';
}

const { title, activeSection } = Astro.props;

const navItems = [
  { id: 'overview', label: 'Overview Dashboard', href: '/admin', icon: '📊' },
  { id: 'properties', label: 'Property Inventory', href: '/admin/properties', icon: '🏡' },
  { id: 'leads', label: 'Leads CRM', href: '/admin/leads', icon: '👥' },
  { id: 'dealers', label: 'Dealers Network', href: '/admin/dealers', icon: '🤝' },
  { id: 'images', label: 'Image Inspector', href: '/admin/images', icon: '🖼️' },
  { id: 'content', label: 'Content & Guides', href: '/admin/content', icon: '📝' },
  { id: 'analytics', label: 'Conversion Analytics', href: '/admin/analytics', icon: '📈' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <title>{title} — ARG Phase 2 Admin Ops</title>
  </head>
  <body class="admin-body">
    <div class="admin-layout">
      <!-- Admin Sidebar -->
      <aside class="admin-sidebar">
        <div class="admin-sidebar__brand">
          <a href="/admin" class="admin-brand-link">
            <img src="/images/logo/logo-white.svg" alt="Al Rehman Garden" class="admin-brand-logo" />
            <span class="admin-brand-badge">Ops Portal</span>
          </a>
        </div>

        <nav class="admin-nav" aria-label="Admin Navigation">
          <div class="admin-nav__group-lbl">Operations Management</div>
          <ul class="admin-nav__list">
            {navItems.map((item) => (
              <li class="admin-nav__item">
                <a
                  href={item.href}
                  class:list={[
                    'admin-nav__link',
                    activeSection === item.id && 'admin-nav__link--active',
                  ]}
                >
                  <span class="admin-nav__icon">{item.icon}</span>
                  <span class="admin-nav__label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="admin-sidebar__footer">
          <div class="admin-user-card">
            <div class="admin-user-avatar">
              <span>{CURRENT_ADMIN_USER.name.charAt(0)}</span>
            </div>
            <div class="admin-user-info">
              <strong class="admin-user-name">{CURRENT_ADMIN_USER.name}</strong>
              <span class="admin-user-role" style="text-transform: uppercase;">{CURRENT_ADMIN_USER.role.replace('_', ' ')}</span>
            </div>
          </div>
          <a href="/" class="admin-view-site-link" target="_blank">
            <span>🌐 View Public Website ↗</span>
          </a>
        </div>
      </aside>

      <!-- Admin Main View Area -->
      <div class="admin-main">
        <!-- Top Toolbar -->
        <header class="admin-topbar">
          <div class="admin-topbar__title-area">
            <h1 class="admin-page-title">{title}</h1>
          </div>

          <div class="admin-topbar__actions">
            <div class="admin-live-badge">
              <span class="admin-pulse-dot"></span>
              <span>100 Properties Active • Build OK</span>
            </div>
            <a href="/find-my-property" target="_blank" class="btn btn--accent btn--xs">
              + Open Lead Form
            </a>
          </div>
        </header>

        <!-- Dynamic Content Slot -->
        <main class="admin-content-wrap">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  .admin-body {
    background-color: #0B1120;
    color: #F1F5F9;
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  .admin-layout {
    display: flex;
    min-height: 100vh;
  }

  /* ── Sidebar ───────────────────────────────────────────────────────── */
  .admin-sidebar {
    width: 260px;
    background: #070D19;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
  }

  .admin-sidebar__brand {
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .admin-brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .admin-brand-logo {
    height: 36px;
    width: auto;
  }

  .admin-brand-badge {
    font-size: 10px;
    font-weight: var(--font-extrabold);
    color: var(--color-secondary-950);
    background: var(--gradient-gold);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    text-transform: uppercase;
  }

  .admin-nav {
    flex: 1;
    padding: var(--space-6) var(--space-4);
    overflow-y: auto;
  }

  .admin-nav__group-lbl {
    font-size: 10px;
    font-weight: var(--font-bold);
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0 var(--space-3) var(--space-3);
  }

  .admin-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .admin-nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2-5) var(--space-3);
    border-radius: var(--radius-md);
    color: #94A3B8;
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all var(--transition-fast);
  }

  .admin-nav__link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
  }

  .admin-nav__link--active {
    background: rgba(212, 175, 55, 0.15);
    color: #F3D375;
    font-weight: var(--font-bold);
    border-left: 3px solid #D4AF37;
  }

  .admin-sidebar__footer {
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: #050914;
  }

  .admin-user-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .admin-user-avatar {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    background: var(--gradient-gold);
    color: #0A1128;
    font-weight: var(--font-bold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
  }

  .admin-user-info {
    display: flex;
    flex-direction: column;
  }

  .admin-user-name {
    font-size: var(--text-xs);
    color: #FFFFFF;
  }

  .admin-user-role {
    font-size: 10px;
    color: #10B981;
    font-weight: var(--font-bold);
  }

  .admin-view-site-link {
    font-size: 11px;
    color: #64748B;
    text-decoration: none;
    display: block;
  }

  .admin-view-site-link:hover {
    color: #F3D375;
  }

  /* ── Main View Area ────────────────────────────────────────────────── */
  .admin-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .admin-topbar {
    height: 64px;
    background: #0E1626;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0 var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .admin-page-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: #FFFFFF;
    margin: 0;
  }

  .admin-topbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .admin-live-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: #10B981;
    background: rgba(16, 185, 129, 0.1);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .admin-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .admin-content-wrap {
    flex: 1;
    padding: var(--space-8);
  }
</style>
