---
/**
 * PageLayout.astro — Standard Page Layout
 * Extends BaseLayout with Header, Footer, and main content area.
 */

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
}

import BaseLayout from './BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import WhatsAppButton from '@components/global/WhatsAppButton.astro';

const { title, description, canonical, ogImage, ogType, noindex } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
>
  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <WhatsAppButton />
</BaseLayout>
