# ===================================================================
# Al Rehman Garden Phase 2 Lahore — Production Environment Variables
# Copy this file to .env or configure in Vercel Project Settings
# ===================================================================

# Public Site Configuration
PUBLIC_SITE_URL=https://alrehmangarden.pk
PUBLIC_SITE_NAME="Al Rehman Garden Phase 2 Lahore"
PUBLIC_SITE_DESCRIPTION="The authoritative real estate directory, verified plot rates, and payment plans for Al Rehman Garden Phase 2 Lahore."

# Direct WhatsApp & Contact Configuration
PUBLIC_WHATSAPP_NUMBER=+923000000000
PUBLIC_PHONE_NUMBER=+923000000000
PUBLIC_CONTACT_EMAIL=info@alrehmangarden.pk

# Analytics & Tracking (GA4 / Meta Pixel)
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# Administrative Operations Security
ADMIN_SECRET_KEY=change_this_to_a_secure_64_char_secret_key_in_production
ADMIN_DEFAULT_ROLE=admin

# Storage & Optional Database (For scale > 1,000 properties)
DATABASE_URL=postgresql://user:password@localhost:5432/rahman_gardens?sslmode=require
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
