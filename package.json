{
  "name": "dha-phase-6-lahore-guide",
  "type": "module",
  "version": "1.0.0",
  "description": "Independent DHA Phase 6 Lahore property and neighbourhood information portal",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "places:import": "python scripts/import_google_maps_places.py --sector sector-a --category all --limit 3",
    "seo:audit": "node scripts/seo-audit.mjs",
    "link:audit": "node --experimental-strip-types scripts/internal-link-audit.ts",
    "properties:scrape:zameen": "python scripts/property_pipeline/scrapers/zameen_scraper.py",
    "properties:scrape:graana": "python scripts/property_pipeline/scrapers/graana_scraper.py",
    "properties:import": "python scripts/property_pipeline/exporters/astro_importer.py",
    "properties:update": "python scripts/update_properties.py",
    "properties:test": "python -m unittest discover scripts/property_pipeline/tests",
    "properties:images:fix": "python scripts/fix_property_images.py",
    "properties:images:validate": "python scripts/validate_property_images.py",
    "properties:quality:audit": "python scripts/property_quality_audit.py",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "^7.2.9",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/check": "^0.9.10",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "schema-dts": "^2.0.0",
    "dayjs": "^1.11.13",
    "slugify": "^1.6.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "eslint": "^10.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "eslint-plugin-astro": "^3.1.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
